      {
        "id": "ONE_MAM_PER_AXIS",
        "derived": true,
        "holds": true,
        "statement": "Each servo axis has exactly ONE main auto MAM, inside the single \"Axis Motion Command\" rung of its routine.",
        "evidence": [
          "S00_IndexerNoSP.L5X R04_IndexerServo: 1 main MAM rung(s)",
          "S00_IndexerSP.L5X R04_IndexerServo: 1 main MAM rung(s)",
