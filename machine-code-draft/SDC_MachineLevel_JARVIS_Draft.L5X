<AddOnInstructionDefinition Name="CPU_TimeDate_wJulian" Class="Standard" Revision="1.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" SoftwareRevision="v37.00">
<Description>
<![CDATA[Populates the global CPU_TimeDate tag plus Julian date. Logic transcribed from X:\...\AOI's\CPUDateTime\CPU_TimeDate_wJulian.L5X (evidence).]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="JulianDate" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Day of year 1-366]]>
</Description>
</Parameter>
<Parameter Name="TimeDateTag" TagType="Base" DataType="CPU_TimeDate" Usage="InOut" Required="true" Visible="true" Constant="false"></Parameter>
</Parameters>
<LocalTags></LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Read controller wall clock (evidence: X-drive CPU_TimeDate_wJulian.L5X)]]>
</Comment>
<Text>
<![CDATA[GSV(WallClockTime,,LocalDateTime,TimeDateArray[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CLR(JulianDate)MOVE(TimeDateArray[1],Month);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LIMIT(1,Month,12)ADD(LookUp[Month],TimeDateArray[2],JulianDate);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Leap year day]]>
</Comment>
<Text>
<![CDATA[GT(TimeDateArray[1],2)CMP(((TimeDateArray[0] MOD 4) = 0))[CMP(((TimeDateArray[0] MOD 100) > 0)) ,CMP(((TimeDateArray[0] MOD 400) = 0)) ]ADD(JulianDate,1,JulianDate);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Unpack into CPU_TimeDate]]>
</Comment>
<Text>
<![CDATA[[MOVE(TimeDateArray[0],TimeDateTag.Year) ,MOVE(TimeDateArray[1],TimeDateTag.Month) ,MOVE(TimeDateArray[2],TimeDateTag.Day) ,MOVE(TimeDateArray[3],TimeDateTag.Hour) ,MOVE(TimeDateArray[4],TimeDateTag.Minutes) ,MOVE(TimeDateArray[5],TimeDateTag.Seconds) ,DIV(TimeDateArray[6],1000,TimeDateTag.Milliseconds) ,MOVE(TimeDateArray[6],TimeDateTag.Microseconds) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[GSV(TimeSynchronize,,CurrentTimeMicroseconds,TimeDateTag.UTCMicroseconds);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="LightStackControl" Class="Standard" Revision="1.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" SoftwareRevision="v37.00">
<Description>
<![CDATA[JARVIS RECONSTRUCTION: no export exists. Interface inferred from Revision History V4.0 (Cycle Start Light, Green Stack Light, Alarm Horn, Amber Light states) and V4.1 (added HornOverride input). Logic below is JARVIS's proposal for the leads to correct.]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="MachineRunning" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="MachineFaulted" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="MachineWarning" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="ReadyToStart" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="ManualMode" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="SafetyOK" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="HornOverride" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Silences the alarm horn (added V4.1)]]>
</Description>
</Parameter>
<Parameter Name="FlashPulse" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Wire to g_MachineBasic.Flash500msPD]]>
</Description>
</Parameter>
<Parameter Name="GreenLight" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="AmberLight" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="RedLight" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="CycleStartLight" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
<Parameter Name="AlarmHorn" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"></Parameter>
</Parameters>
<LocalTags></LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[JARVIS RECONSTRUCTION: Green stack light - solid while the machine is running in auto.]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIO(MachineFaulted)OTE(GreenLight);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[JARVIS RECONSTRUCTION: Amber stack light - solid in manual mode, flashing on an active warning.]]>
</Comment>
<Text>
<![CDATA[[XIC(ManualMode) ,XIC(MachineWarning) XIC(FlashPulse) ]OTE(AmberLight);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[JARVIS RECONSTRUCTION: Red stack light - flashing while faulted, solid when safety is not OK.]]>
</Comment>
<Text>
<![CDATA[[XIC(MachineFaulted) XIC(FlashPulse) ,XIO(SafetyOK) ]OTE(RedLight);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[JARVIS RECONSTRUCTION: Cycle start light - flashing when the machine is ready to start, solid while running.]]>
</Comment>
<Text>
<![CDATA[[XIC(ReadyToStart) XIO(MachineRunning) XIC(FlashPulse) ,XIC(MachineRunning) ]OTE(CycleStartLight);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[JARVIS RECONSTRUCTION: Alarm horn - sounds on an active fault until overridden. HornOverride input added V4.1.]]>
</Comment>
<Text>
<![CDATA[XIC(MachineFaulted)XIO(HornOverride)OTE(AlarmHorn);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
