</Tag>
<Tag Name="ShiftData" TagType="Base" DataType="ProductionData" Dimensions="4" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Per-shift data - uses indexes 1,2,3]]>
</Description>
</Tag>
