</Description>
<Data Format="L5K">
<![CDATA[[[29,'Machine Safety Circuit Not OK'],[24,'Machine Air Pressure Low'],[52,'Machine Did Not Stop Within 30 Seconds Of Cycle Stop'],[8,'Not Used'],[8,'Not Used'],[8,'Not Used'],[8,'Not Used'],[8,'Not Used'],[8,'Not Used'],[8,'Not Used']]]]>
</Data>
