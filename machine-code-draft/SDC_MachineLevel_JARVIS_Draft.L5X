</Tag>
<Tag Name="ShiftDowntime" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Data Format="L5K">
<![CDATA[[0,1000,0]]]>
