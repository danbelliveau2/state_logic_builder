</Description>
<Data Format="L5K">
<![CDATA[[0,2000,0]]]>
</Data>
</Tag>
<Tag Name="HoldTimerB" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Data Format="L5K">
<![CDATA[[0,2000,0]]]>
</Data>
</Tag>
<Tag Name="HoldTimerC" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Data Format="L5K">
<![CDATA[[0,2000,0]]]>
</Data>
</Tag>
<Tag Name="ONS" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[One shot storage bits]]>
