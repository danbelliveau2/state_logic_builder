<Routines>

<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R05_Recovery,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Mapped Inputs from Supervisor]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(HMI_LocalManualOverride) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Initialization]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[124])OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 2: Auto Idle NOT Ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) XIO(ManualMode) ,XIC(Status.State[1]) XIO(ManualMode) ,XIC(Status.State[127]) XIC(FaultReset) ,XIC(Status.State[124]) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 3: Auto Idle Ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) XIC(Initialized) ,XIC(Status.State[31]) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 4: Wait for Index Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])XIC(CycleRunning)XIC(MAM_PNPXAxis.PC)XIC(MAM_PNPZAxis.PC)TON(PartGripperDisengageDelay,?,?)XIC(PartGripperDisengageDelay.DN)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 7: Move PNP_ZAxis to Pick]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 10: Engage Part_Gripper]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(MAM_PNPZAxis.PC)XIC(PNPZAxisPickRC.In_Range)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 13: Move PNP_ZAxis to Clear]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])TON(PartGripperEngageDelay,?,?)XIC(PartGripperEngageDelay.DN)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 16: Move PNP_XAxis to Place]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(MAM_PNPZAxis.PC)XIC(PNPZAxisClearRC.In_Range)MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 19: Move PNP_ZAxis to Place]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])XIC(MAM_PNPXAxis.PC)XIC(PNPXAxisPlaceRC.In_Range)MOVE(19,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 22: Disengage Part_Gripper]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])XIC(MAM_PNPZAxis.PC)XIC(PNPZAxisPlaceRC.In_Range)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 25: Move PNP_ZAxis to Clear]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[22])TON(PartGripperDisengageDelay,?,?)XIC(PartGripperDisengageDelay.DN)MOVE(25,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 28: Move PNP_XAxis to Pick]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])XIC(MAM_PNPZAxis.PC)XIC(PNPZAxisClearRC.In_Range)MOVE(28,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 31: Step 9]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[28])XIC(MAM_PNPXAxis.PC)XIC(PNPXAxisPickRC.In_Range)MOVE(31,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Cycle Time Accumulator]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ,XIC(Status.State[7]) ,XIC(Status.State[10]) ,XIC(Status.State[13]) ,XIC(Status.State[16]) ,XIC(Status.State[19]) ,XIC(Status.State[22]) ,XIC(Status.State[25]) ,XIC(Status.State[28]) ,XIC(Status.State[31])]RTO(CycleTimer,?,?);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Cycle Time Compute + Reset]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])XIC(CycleRunning)ONS(ONS.4)[DIV(CycleTimer.ACC,1000.0,p_CycleTime) ,MOVE(0,CycleTimer.ACC) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Fault Timer Enable]]>
</Comment>
<Text>
<![CDATA[LIMIT(4,Control.StateReg,59)XIO(SS)[MOVE(5000,Control.FaultTime) ,OTE(Control.EnaFaultDetect) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[State Engine]]>
</Comment>
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Part_Gripper Control]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) ,XIC(ManualMode) XIC(HMI_Button.0) ,XIC(q_EngagePartGripper) [XIO(ManualMode) XIO(Status.State[1]) XIO(Status.State[22]) ,XIC(ManualMode) XIO(HMI_Button.1)] ]OTE(q_EngagePartGripper);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(q_EngagePartGripper)OTE(q_DisengagePartGripper);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Part Tracking: Clear All at Cycle Start]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)ONS(ONS.5)OTU(PartTracking.StationResult);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Part Tracking: StationResult (Station Result)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[31])OTE(PartTracking.StationResult);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[PNP_ZAxis Position Selection]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) [MOVE(p_PNPZAxisPick,PNPZAxis_MotionParam.Position) ,MOVE(0,PNPZAxis_MotionParam.MoveType) ] ,XIC(Status.State[13]) [MOVE(p_PNPZAxisClear,PNPZAxis_MotionParam.Position) ,MOVE(0,PNPZAxis_MotionParam.MoveType) ] ,XIC(Status.State[19]) [MOVE(p_PNPZAxisPlace,PNPZAxis_MotionParam.Position) ,MOVE(0,PNPZAxis_MotionParam.MoveType) ] ,XIC(Status.State[25]) [MOVE(p_PNPZAxisClear,PNPZAxis_MotionParam.Position) ,MOVE(0,PNPZAxis_MotionParam.MoveType) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[PNP_ZAxis Motion Command]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) ,XIC(Status.State[13]) ,XIC(Status.State[19]) ,XIC(Status.State[25])]MAM(a01_PNPZAxis,MAM_PNPZAxis,PNPZAxis_MotionParam.MoveType,PNPZAxis_MotionParam.Position,PNPZAxis_MotionParam.Speed,Units per sec,PNPZAxis_MotionParam.Accel,Units per sec2,PNPZAxis_MotionParam.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[PNP_ZAxis Position Monitoring]]>
</Comment>
<Text>
<![CDATA[[AOI_RangeCheck(PNPZAxisClearRC,p_PNPZAxisClear,0.5,a01_PNPZAxis.ActualPosition) ,AOI_RangeCheck(PNPZAxisPickRC,p_PNPZAxisPick,0.5,a01_PNPZAxis.ActualPosition) ,AOI_RangeCheck(PNPZAxisPlaceRC,p_PNPZAxisPlace,0.5,a01_PNPZAxis.ActualPosition) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[PNP_XAxis Position Selection]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) [MOVE(p_PNPXAxisPlace,PNPXAxis_MotionParam.Position) ,MOVE(0,PNPXAxis_MotionParam.MoveType) ] ,XIC(Status.State[28]) [MOVE(p_PNPXAxisPick,PNPXAxis_MotionParam.Position) ,MOVE(0,PNPXAxis_MotionParam.MoveType) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[PNP_XAxis Motion Command]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) ,XIC(Status.State[28])]MAM(a01_PNPXAxis,MAM_PNPXAxis,PNPXAxis_MotionParam.MoveType,PNPXAxis_MotionParam.Position,PNPXAxis_MotionParam.Speed,Units per sec,PNPXAxis_MotionParam.Accel,Units per sec2,PNPXAxis_MotionParam.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[PNP_XAxis Position Monitoring]]>
</Comment>
<Text>
<![CDATA[[AOI_RangeCheck(PNPXAxisPickRC,p_PNPXAxisPick,0.5,a01_PNPXAxis.ActualPosition) ,AOI_RangeCheck(PNPXAxisPlaceRC,p_PNPXAxisPlace,0.5,a01_PNPXAxis.ActualPosition) ,AOI_RangeCheck(PNPXAxisRejectRC,p_PNPXAxisReject,0.5,a01_PNPXAxis.ActualPosition) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Station Start OK]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) ,XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(q_AlarmActive)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Auto Mode Status]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Auto Stopped Status]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R05_Recovery" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Recovery Entry: Fault (127) → State 100]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Recovery Step 1 → State 103]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(MAM_PNPZAxis.PC)XIC(PNPZAxisClearRC.In_Range)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[On → State 106]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[103])XIC(MAM_PNPXAxis.PC)XIC(PNPXAxisPlaceRC.In_Range)MOVE(106,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Recovery Step 4 → State 109]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[106])MOVE(109,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Off → State 2 (Auto Idle — recovery complete)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[109])XIC(MAM_PNPXAxis.PC)XIC(PNPXAxisPickRC.In_Range)MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[PNP_ZAxis Motion Timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7])TON(SensorTimer[0],?,?)XIC(SensorTimer[0].DN) ,XIC(Alarm[0].Active) XIO(FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Part_Gripper Engage Timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10])TON(SensorTimer[1],?,?)XIC(SensorTimer[1].DN) ,XIC(Alarm[1].Active) XIO(FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
