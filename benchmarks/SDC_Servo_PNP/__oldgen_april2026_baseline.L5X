</Comment>
<Text>
<![CDATA[[XIC(Status.State[13])TON(SensorTimer[2],?,?)XIC(SensorTimer[2].DN) ,XIC(Alarm[2].Active) XIO(FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[PNP_XAxis Motion Timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16])TON(SensorTimer[3],?,?)XIC(SensorTimer[3].DN) ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[PNP_ZAxis Motion Timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19])TON(SensorTimer[4],?,?)XIC(SensorTimer[4].DN) ,XIC(Alarm[4].Active) XIO(FaultReset) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Part_Gripper Disengage Timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[22])TON(SensorTimer[5],?,?)XIC(SensorTimer[5].DN) ,XIC(Alarm[5].Active) XIO(FaultReset) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[PNP_ZAxis Motion Timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[25])TON(SensorTimer[6],?,?)XIC(SensorTimer[6].DN) ,XIC(Alarm[6].Active) XIO(FaultReset) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[PNP_XAxis Motion Timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[28])TON(SensorTimer[7],?,?)XIC(SensorTimer[7].DN) ,XIC(Alarm[7].Active) XIO(FaultReset) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Program Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
