<Routines>

<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R04_DialServoServo,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R05_Recovery,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Mapped Inputs from Supervisor]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(HMI_LocalManualOverride) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Initialization]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[124])OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[HMI_Toggle Decode]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Toggle.0)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(HMI_Toggle.1)OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(HMI_Toggle.2)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[SS_OK]]>
</Comment>
<Text>
<![CDATA[[XIO(SS) ,XIC(SS) XIC(HMI_Momentary.StepAdvance) ONS(SS_ONS) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[HMI_Momentary Auto-Clear]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Momentary.StepAdvance)OTU(HMI_Momentary.StepAdvance);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(HMI_Momentary.FaultReset)OTU(HMI_Momentary.FaultReset);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(HMI_Momentary.CycleStart)OTU(HMI_Momentary.CycleStart);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Debounce Filters]]>
</Comment>
<Text>
<![CDATA[AOI_Debounce(StackCheckSensorDebounce,i_StackCheckSensor,100,100);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[CPU Time/Date]]>
</Comment>
<Text>
<![CDATA[CPU_TimeDate_wJulian(\g_CPUDateTime);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Legacy LocalSS Passthrough]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 2: Auto Idle NOT Ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) XIO(ManualMode) ,XIC(Status.State[1]) XIO(ManualMode) ,XIC(Status.State[127]) XIC(FaultReset) ,XIC(Status.State[124]) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 3: Auto Idle Ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) XIC(Initialized) ,XIC(Status.State[10]) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 99: Lockout (HMI_Toggle.0)]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Toggle.0)MOVE(99,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 4: Wait]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])XIC(CycleRunning)XIC(DialServo_MAM.PC)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 7: Index Magnet_Dial (10-pos)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 10: Index Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(DialServo_MAM.PC)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Cycle Time Accumulator]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ,XIC(Status.State[7]) ,XIC(Status.State[10])]RTO(CycleTimer,?,?);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Cycle Time Compute + Reset]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])XIC(CycleRunning)ONS(ONS.4)[DIV(CycleTimer.ACC,1000.0,p_CycleTime) ,MOVE(0,CycleTimer.ACC) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Fault Timer Enable]]>
</Comment>
<Text>
<![CDATA[LIMIT(4,Control.StateReg,59)XIO(SS)[MOVE(5000,Control.FaultTime) ,OTE(Control.EnaFaultDetect) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State Engine]]>
</Comment>
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Part Tracking: Clear All at Cycle Start]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)ONS(ONS.5)OTU(PartTracking.StationResult);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Part Tracking: StationResult (Station Result)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])OTE(PartTracking.StationResult);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Station Start OK]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) ,XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(q_AlarmActive)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Auto Mode Status]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Auto Stopped Status]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R04_DialServoServo" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Axis Is Ready For Operation]]>
</Comment>
<Text>
<![CDATA[XIC(MotionGroup.GroupSynced)XIO(iq_DialServo.SafeTorqueOffActiveInhibit)OTE(DialServoReady);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(SafetyOK)XIC(DialServoReady)TON(DialServoEnableDelay,?,?)XIC(DialServoEnableDelay.DN)ONS(DialServoONS.0)OTE(DialServoAutoEnable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Axis Motion Permissive (Add more conditions if necessary. Permissive should be based on the physical state of itself potentially interfering devices)]]>
</Comment>
<Text>
<![CDATA[OTE(DialServoPermissive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) XIC(HMI_DialServo.Control.Enable) XIC(DialServoReady) ,XIC(DialServoAutoEnable) ]XIO(iq_DialServo.ServoActionStatus)MSO(iq_DialServo,DialServo_MSO);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(HMI_DialServo.Control.Disable)MSF(iq_DialServo,DialServo_MSF);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fault Reset Axis]]>
</Comment>
<Text>
<![CDATA[NE(iq_DialServo.AxisFault,0)XIC(FaultReset)[XIO(iq_DialServo.ShutdownStatus) MAFR(iq_DialServo,DialServo_MAFR) ,XIC(iq_DialServo.ShutdownStatus) MASR(iq_DialServo,DialServo_MASR) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Jog Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(DialServoPermissive)XIC(iq_DialServo.ServoActionStatus)XIO(iq_DialServo.JogStatus)XIO(iq_DialServo.MoveStatus)[XIC(HMI_DialServo.Control.JogPositive) XIO(HMI_DialServo.Control.JogNegative) MOVE(0,DialServoJogDirection) ,XIC(HMI_DialServo.Control.JogNegative) XIO(HMI_DialServo.Control.JogPositive) MOVE(1,DialServoJogDirection) ]MAJ(iq_DialServo,DialServo_MAJ,DialServoJogDirection,HMI_DialServo.Parameters.JogSpeed,Units per sec,HMI_DialServo.Parameters.Accel[0],Units per sec2,HMI_DialServo.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per MasterUnit3,Disabled,0,0,None);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(DialServo_MAJ.IP)XIO(HMI_DialServo.Control.JogPositive)XIO(HMI_DialServo.Control.JogNegative)MAS(iq_DialServo,DialServo_MAS_Jog,Jog,Yes,HMI_DialServo.Parameters.Decel[0],Units per sec2,No,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Inch Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(DialServoPermissive)XIC(iq_DialServo.ServoActionStatus)XIO(iq_DialServo.JogStatus)XIO(iq_DialServo.MoveStatus)[XIC(HMI_DialServo.Control.InchPositive) ONS(DialServoONS.1) MOVE(HMI_DialServo.Parameters.InchAmount,DialServoInchAmount) ,XIC(HMI_DialServo.Control.InchNegative) ONS(DialServoONS.2) NEG(HMI_DialServo.Parameters.InchAmount,DialServoInchAmount) ]MAM(iq_DialServo,DialServo_Inch,1,DialServoInchAmount,HMI_DialServo.Parameters.ManualSpeed,Units per sec,HMI_DialServo.Parameters.Accel[0],Units per sec2,HMI_DialServo.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Home Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_DialServo.Control.HomeRequest) ONS(DialServoONS.3) XIO(DialServoTorqueHome.IP) ,XIC(DialServoHomeRequested) XIO(DialServoHomeConfirmDelay.DN) XIO(DialServoHomeConfimed) ]XIC(DialServoReady)[OTE(DialServoHomeRequested) ,TON(DialServoHomeConfirmDelay,?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_DialServo.Control.HomeConfirm) ONS(DialServoONS.4) ,XIC(DialServoHomeConfimed) XIC(DialServoHomeSelect) XIO(DialServoTorqueHome.PC) XIO(DialServoTorqueHome.Error) ]OTE(DialServoHomeConfimed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Home Select = 0 is for Immediate Home (Example, servo indexer)
Home Select = 1 is for Home To Torque (Example, PNP)

Homing Torque = Start at 25%, Increase In 5% Increments If Not Enough
Run Torque = Normal Running Torque Of Axis
Homing Speed = Homing Speed in units/s
Overtorque Limit = Set The Same As Homing Torque
Home Offset Distance = Distance Moved Off Of Hard Stop When Homing Complete
Home Direction = 0 Is Positive, 1 Is Negative]]>
</Comment>
<Text>
<![CDATA[XIC(DialServoHomeConfimed)[XIO(DialServoHomeSelect) MAH(iq_DialServo,DialServo_MAH) ,XIC(DialServoHomeSelect) AOI_TorqueHome(DialServoTorqueHome,iq_DialServo,25.0,100.0,5.0,25.0,0.5,1) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(DialServoHomeRequested) OTE(HMI_DialServo.Status.HomeRequested) ,[XIC(DialServoTorqueHome.IP) ,XIC(DialServo_MAH.IP) ] OTE(HMI_DialServo.Status.HomeInProcess) ,[XIC(DialServoTorqueHome.PC) ,XIC(DialServo_MAH.PC) ] OTE(HMI_DialServo.Status.HomeComplete) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIC(Status.State[1])[MOVE(HMI_DialServo.Parameters.ManualSpeed,DialServoMotionParameters.Speed) ,XIC(DialServoPermissive) [XIC(HMI_DialServo.Control.ManMoves.0) MOVE(HMI_DialServo.Parameters.Positions[0],DialServoMotionParameters.Position) ] OTE(DialServoManMoveTrig) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Auto Mode]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(Status.State[1])[MOVE(0,DialServoMotionParameters.MoveType) ,MOVE(HMI_DialServo.Parameters.AutoSpeed[0],DialServoMotionParameters.Speed) ,MOVE(HMI_DialServo.Parameters.Accel[0],DialServoMotionParameters.Accel) ,MOVE(HMI_DialServo.Parameters.Decel[0],DialServoMotionParameters.Decel) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Axis Motion Command]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)[XIC(Status.State[1]) XIC(DialServoManMoveTrig) ,XIO(Status.State[1]) ]XIC(iq_DialServo.ServoActionStatus)XIC(iq_DialServo.AxisHomedStatus)XIC(DialServoPermissive)MAM(iq_DialServo,DialServo_MAM,DialServoMotionParameters.MoveType,DialServoMotionParameters.Position,DialServoMotionParameters.Speed,Units per sec,DialServoMotionParameters.Accel,Units per sec2,DialServoMotionParameters.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Stop axis if permissive turns off while in motion and use max or close to max decel value]]>
</Comment>
<Text>
<![CDATA[XIO(iq_DialServo.MotionStatus.0)[XIO(DialServoPermissive) ,XIO(SafetyOK) ]MAS(iq_DialServo,DialServo_MAS_All,All,Yes,90,% of Maximum,Yes,90,% of Maximum);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Set torque]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_DialServo.Control.SetTorquePos)MOVE(HMI_DialServo.Parameters.TorquePos,iq_DialServo.TorqueLimitPositive);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(HMI_DialServo.Control.SetTorqueNeg)MOVE(HMI_DialServo.Parameters.TorqueNeg,iq_DialServo.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Retrieve values from axis]]>
</Comment>
<Text>
<![CDATA[MOVE(iq_DialServo.ActualPosition,HMI_DialServo.Status.ActualPosition)MOVE(iq_DialServo.ActualVelocity,HMI_DialServo.Status.ActualVelocity)MOVE(iq_DialServo.TorqueReferenceFiltered,HMI_DialServo.Status.ActualTorque);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Retrieve the max values from the drive and adjust them for your application if necessary with math instructions]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)GSV(Axis,iq_DialServo,MaximumAcceleration,HMI_DialServo.Status.MaxAccel)GSV(Axis,iq_DialServo,MaximumDeceleration,HMI_DialServo.Status.MaxDecel)GSV(Axis,iq_DialServo,MaximumSpeed,HMI_DialServo.Status.MaxVelocity);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Axis Position Monitor]]>
</Comment>
<Text>
<![CDATA[[AOI_RangeCheck(DialServoHome,HMI_DialServo.Parameters.Positions[0],0.5,HMI_DialServo.Status.ActualPosition,5) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R05_Recovery" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[No recovery sequence configured — manual FaultReset returns to State 2]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>

<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Magnet_Dial Motion Timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7])TON(SensorTimer[0],?,?)XIC(SensorTimer[0].DN) ,XIC(Alarm[0].Active) XIO(FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Program Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>