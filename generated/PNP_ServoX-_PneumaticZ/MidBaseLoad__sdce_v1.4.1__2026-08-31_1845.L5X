<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R04_XAxisServo,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Nest & Station Numbers]]>
</Comment>
<Text>
<![CDATA[[MOVE(1,StaNum) MOVE(0,StaNumPre) ,MOVE(\Tracking.p_Data.Station[StaNum].NestNum,NestNumCurrent) MOVE(\Tracking.p_Data.Station[StaNumPre].NestNum,NestNumIncoming) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Vertical Slide Retracted Sensor]]>
</Comment>
<Text>
<![CDATA[AOI_Debounce(VerticalSlideRetractedDebounce,i_VerticalSlideRetracted,100,100);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Vertical Slide Extended - the slide has no extend sensor, so the extend stroke is confirmed by delay timer with the extend output on, the retract output off and the retract sensor off]]>
</Comment>
<Text>
<![CDATA[XIC(q_ExtendVerticalSlide)XIO(q_RetractVerticalSlide)XIO(VerticalSlideRetractedDebounce.On)TON(VerticalSlideExtendDelay,?,?)XIC(VerticalSlideExtendDelay.DN)OTE(VerticalSlideExtended);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(q_OpenGripper)XIO(q_CloseGripper)TON(OpenGripperDelay,?,?)XIC(OpenGripperDelay.DN)OTE(GripperOpened);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(q_CloseGripper)XIO(q_OpenGripper)TON(CloseGripperDelay,?,?)XIC(CloseGripperDelay.DN)OTE(GripperClosed);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Initialized - vertical slide retracted, and either empty with the x axis at pick or carrying a part with the x axis at place]]>
</Comment>
<Text>
<![CDATA[XIC(VerticalSlideRetractedDebounce.On)[XIC(GripperOpened) XIC(XAxisPick.InPos) ,XIC(GripperClosed) XIC(XAxisPlace.InPos) ]OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)XIO(ManualMode)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Dry run logic (can add supervisor dry run condition if needed as parallel branch)]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.DryRun)OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Cycle Station]]>
</Comment>
<Text>
<![CDATA[[XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded) [XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNumPre].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNumPre].Lockout) ] ,XIC(DryRun) ][XIO(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStationA) ,OTE(CycleStationB) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[STATE MAP (generated - authoritative): 4=Home / Initial | 7=Extend Vertical_Slide | 10=Close PNP_Gripper | 13=Signal part gripped | 16=Retract Vertical_Slide | 19=Signal part clear | 22=Servo Move X_Axis - Place Position | 25=Extend Vertical_Slide | 28=Open PNP_Gripper | 31=Retract Vertical_Slide | 34=Servo Move X_Axis - Pick Position | 37=Signal Cycle Complete | 40=Cycle Complete]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[99]) XIO(CycleRunning) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[4]) ,XIC(Status.State[40]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Start of sequence, wait for part ready from the escapement]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[40]) XIC(SS_OK) ,[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ] XIC(GripperOpened) ]XIC(CycleRunning)XIO(Lockout)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Extend vertical slide to pick position

Wired to the escapement's p_PartReadyForPick (intra-station handshake).]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIC(p_PartReadyForPick) ,XIC(DryRun) ]XIC(SS_OK)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Engage gripper on part

*Reattach the CycleStationA gate to the part tracking Attempt latch when this station joins a machine.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(VerticalSlideExtended)XIC(SS_OK)MOVE(10,Control.StateReg)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: Signal part gripped]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(GripperClosed)XIC(SS_OK)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 16: Retract vertical slide carrying part

Wired to the escapement's p_ShuttleGripperOpen (intra-station handshake). Second branch resumes a stopped cycle with a part in the gripper.]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) [XIC(p_ShuttleGripperOpen) ,XIC(DryRun) ] XIC(SS_OK) ,XIC(Status.State[2]) XIO(Initialized) XIC(PartStarted) XIC(CycleRunning) XIC(q_CloseGripper) ]MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 19: Signal part clear]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])XIC(VerticalSlideRetractedDebounce.On)XIC(SS_OK)MOVE(19,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 22: Move x axis to place position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])XIC(SS_OK)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 25: Extend vertical slide to place position

*Replace the AlwaysOff bit with the dial's ready signal. Second branch re-enters the place side carrying a part after initialization.]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[22]) XIC(XAxis_MAM.PC) XIC(XAxisPlace.InPos) [XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ] ,[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ] XIC(q_CloseGripper) XIC(CycleRunning) ]XIC(SS_OK)MOVE(25,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 28: Disengage gripper to release part]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])XIC(VerticalSlideExtended)XIC(SS_OK)MOVE(28,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 31: Retract vertical slide]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[28])XIC(GripperOpened)XIC(SS_OK)MOVE(31,Control.StateReg)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 34: Move x axis to pick position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[31])XIC(VerticalSlideRetractedDebounce.On)XIC(SS_OK)MOVE(34,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 37: Signal cycle complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[34])XIC(XAxis_MAM.PC)XIC(XAxisPick.InPos)XIC(SS_OK)MOVE(37,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 40: Cycle complete, ready for next command]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[37])XIC(SS_OK)MOVE(40,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 99: Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(Lockout)MOVE(99,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 100: Start of initialization sequence, retract vertical slide]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIO(PartStarted)XIC(CycleRunning)XIC(SS_OK)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[State 103: Initialization move x axis to pick position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(VerticalSlideRetractedDebounce.On)XIC(GripperOpened)XIC(SS_OK)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 106: Initialization move x axis to place position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(VerticalSlideRetractedDebounce.On)XIC(GripperClosed)XIC(SS_OK)MOVE(106,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[103]) XIC(XAxisPick.InPos) ,XIC(Status.State[106]) XIC(XAxisPlace.InPos) ]XIC(XAxis_MAM.PC)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. No attempt made and no part in the gripper indicates initialization is in order; an attempt with no success may restart at the last state.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(g_MachineBasic.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,98) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[State Engine]]>
</Comment>
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Cycle Time

**Cycle time captured at state 40 cycle complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[40]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,98) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor]]>
</Comment>
<Text>
<![CDATA[XIC(iq_XAxis.ServoActionStatus)XIC(iq_XAxis.AxisHomedStatus)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Actuators Safe For Index - vertical slide retracted and not commanded to extend, x axis homed]]>
</Comment>
<Text>
<![CDATA[XIC(iq_XAxis.AxisHomedStatus)XIC(VerticalSlideRetractedDebounce.On)XIO(q_ExtendVerticalSlide)OTE(q_ActuatorsSafe);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Pause Request To Indexer - raised by the partner wait warnings]]>
</Comment>
<Text>
<![CDATA[[XIC(Alarm[4].Active) ,XIC(Alarm[5].Active) ,XIC(Alarm[6].Active) ]OTE(q_Pause);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Part started - set once the gripper commits to the part, cleared when the gripper is commanded open after the release]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) ,XIC(PartStarted) XIO(Status.State[31]) XIO(g_MachineBasic.PowerUpCP) XIO(q_OpenGripper) ]OTE(PartStarted);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Set Part Tracking If Station Is Locked Out

*Replace the AlwaysOff stub with the machine complete gate when this station joins a machine.]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)XIC(Status.State[99])XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Station Complete - template part tracking shape (stubbed) or the standalone cycle complete branch

*Replace the AlwaysOff stub with the machine complete gate when this station joins a machine.]]>
</Comment>
<Text>
<![CDATA[[XIC(g_MachineBasic.AlwaysOff) [XIC(CycleStationB) [XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout) ] ,XIO(CycleStationB) ] ,XIC(Status.State[37]) ,XIC(Status.State[40]) ]OTE(q_StationComplete);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Vertical Slide Control - extend (3 position centre blocked valve, both outputs off holds the slide)]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[7]) ,XIC(Status.State[25]) ,XIC(q_ExtendVerticalSlide) XIO(Status.State[16]) XIO(Status.State[31]) XIO(Status.State[100]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.2) ,XIC(q_ExtendVerticalSlide) XIO(HMI_Momentary.3) ] ]OTE(q_ExtendVerticalSlide);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Vertical Slide Control - retract]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[16]) ,XIC(Status.State[31]) ,XIC(Status.State[100]) ,XIC(q_RetractVerticalSlide) XIO(Status.State[7]) XIO(Status.State[25]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.3) ,XIC(q_RetractVerticalSlide) XIO(HMI_Momentary.2) ] ]OTE(q_RetractVerticalSlide);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Gripper Control - engage]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[10]) ,XIC(q_CloseGripper) XIO(Status.State[28]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.0) ,XIC(q_CloseGripper) XIO(HMI_Momentary.1) ] ]OTE(q_CloseGripper);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Gripper Control - disengage]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[28]) ,XIC(q_OpenGripper) XIO(Status.State[10]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.1) ,XIC(q_OpenGripper) XIO(HMI_Momentary.0) ] ]OTE(q_OpenGripper);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[SM Output Signal: Part Gripped - tells the escapement the pick and place holds the part and the shuttle gripper may open]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) ,XIC(p_PartGripped) XIO(Status.State[28]) ]OTE(p_PartGripped);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[SM Output Signal: Part Clear - tells the escapement the part is clear of the shuttle nest and it may re-arm]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) ,XIC(p_PartClear) XIO(Status.State[7]) ]OTE(p_PartClear);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Station Performance]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)StationPerformance(StationPerformance,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success,g_PresetStationPerformLow,g_PresetStationPerformHigh,\Tracking.p_Data.Station[StaNum].PerformData.Attempts,\Tracking.p_Data.Station[StaNum].PerformData.Successes,\Tracking.p_Data.Station[StaNum].PerformData.Failures,\Tracking.p_Data.Station[StaNum].PerformData.Efficiency,\Tracking.p_Data.Station[StaNum].PerformData.HMIColorStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R04_XAxisServo" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Axis Is Ready For Operation]]>
</Comment>
<Text>
<![CDATA[XIC(MotionGroup.GroupSynced)XIO(iq_XAxis.SafeTorqueOffActiveInhibit)OTE(XAxisReady);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(SafetyOK)XIC(XAxisReady)TON(XAxisEnableDelay,?,?)XIC(XAxisEnableDelay.DN)ONS(XAxisONS.0)OTE(XAxisAutoEnable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[X Axis Permissive - the vertical slide must be retracted and not commanded to extend before the x axis may traverse]]>
</Comment>
<Text>
<![CDATA[XIC(VerticalSlideRetractedDebounce.On)XIO(q_ExtendVerticalSlide)OTE(XAxisPermissive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) XIC(HMI_XAxis.Control.Enable) XIC(XAxisReady) ,XIC(XAxisAutoEnable) ]XIO(iq_XAxis.ServoActionStatus)MSO(iq_XAxis,XAxis_MSO);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(HMI_XAxis.Control.Disable)MSF(iq_XAxis,XAxis_MSF);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fault Reset Axis]]>
</Comment>
<Text>
<![CDATA[NE(iq_XAxis.AxisFault,0)XIC(FaultReset)[XIO(iq_XAxis.ShutdownStatus) MAFR(iq_XAxis,XAxis_MAFR) ,XIC(iq_XAxis.ShutdownStatus) MASR(iq_XAxis,XAxis_MASR) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Jog Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(XAxisPermissive)XIC(iq_XAxis.ServoActionStatus)XIO(iq_XAxis.JogStatus)XIO(iq_XAxis.MoveStatus)[XIC(HMI_XAxis.Control.JogPositive) XIO(HMI_XAxis.Control.JogNegative) MOVE(0,XAxisJogDirection) ,XIC(HMI_XAxis.Control.JogNegative) XIO(HMI_XAxis.Control.JogPositive) MOVE(1,XAxisJogDirection) ]MAJ(iq_XAxis,XAxis_MAJ,XAxisJogDirection,HMI_XAxis.Parameters.JogSpeed,Units per sec,HMI_XAxis.Parameters.Accel[0],Units per sec2,HMI_XAxis.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per MasterUnit3,Disabled,0,0,None);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(XAxis_MAJ.IP)XIO(HMI_XAxis.Control.JogPositive)XIO(HMI_XAxis.Control.JogNegative)MAS(iq_XAxis,XAxis_MAS_Jog,Jog,Yes,HMI_XAxis.Parameters.Decel[0],Units per sec2,No,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Inch Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_XAxis.Control.InchPositive) ONS(XAxisONS.1) MOVE(HMI_XAxis.Parameters.InchAmount,XAxisInchAmount) ,XIC(HMI_XAxis.Control.InchNegative) ONS(XAxisONS.2) NEG(HMI_XAxis.Parameters.InchAmount,XAxisInchAmount) ]XIC(XAxisPermissive)XIC(iq_XAxis.ServoActionStatus)XIO(iq_XAxis.JogStatus)XIO(iq_XAxis.MoveStatus)MAM(iq_XAxis,XAxis_Inch,1,XAxisInchAmount,HMI_XAxis.Parameters.ManualSpeed,Units per sec,HMI_XAxis.Parameters.Accel[0],Units per sec2,HMI_XAxis.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Home Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_XAxis.Control.HomeRequest) ONS(XAxisONS.3) XIO(XAxisTorqueHome.IP) ,XIC(XAxisHomeRequested) XIO(XAxisHomeConfirmDelay.DN) XIO(XAxisHomeConfimed) ]XIC(XAxisReady)[OTE(XAxisHomeRequested) ,TON(XAxisHomeConfirmDelay,?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_XAxis.Control.HomeConfirm) ONS(XAxisONS.4) ,XIC(XAxisHomeConfimed) XIC(XAxisHomeSelect) XIO(XAxisTorqueHome.PC) XIO(XAxisTorqueHome.Error) ]OTE(XAxisHomeConfimed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Home Select = 0 is for Immediate Home (Example, servo indexer)
Home Select = 1 is for Home To Torque (Example, PNP)

Homing Torque = Start at 25%, Increase In 5% Increments If Not Enough
Run Torque = Normal Running Torque Of Axis
Homing Speed = Homing Speed in units/s
Overtorque Limit = Set The Same As Homing Torque
Home Offset Distance = Distance Moved Off Of Hard Stop When Homing Complete
Home Direction = 0 Is Positive, 1 Is Negative]]>
</Comment>
<Text>
<![CDATA[XIC(XAxisHomeConfimed)[XIO(XAxisHomeSelect) MAH(iq_XAxis,XAxis_MAH) ,XIC(XAxisHomeSelect) AOI_TorqueHome(XAxisTorqueHome,iq_XAxis,25.0,100.0,5.0,25.0,0.5,1) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(XAxisHomeRequested) OTE(HMI_XAxis.Status.HomeRequested) ,[XIC(XAxisTorqueHome.IP) ,XIC(XAxis_MAH.IP) ] OTE(HMI_XAxis.Status.HomeInProcess) ,[XIC(XAxisTorqueHome.PC) ,XIC(XAxis_MAH.PC) ] OTE(HMI_XAxis.Status.HomeComplete) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIC(Status.State[1])[[MOVE(HMI_XAxis.Parameters.ManualSpeed,XAxisMotionParameters.Speed) ,MOVE(HMI_XAxis.Parameters.Accel[0],XAxisMotionParameters.Accel) ,MOVE(HMI_XAxis.Parameters.Decel[0],XAxisMotionParameters.Decel) ] ,XIC(XAxisPermissive) [XIC(HMI_XAxis.Control.ManMoves.0) MOVE(HMI_XAxis.Parameters.Positions[0],XAxisMotionParameters.Position) ,XIC(HMI_XAxis.Control.ManMoves.1) MOVE(HMI_XAxis.Parameters.Positions[1],XAxisMotionParameters.Position) ] OTE(XAxisManMoveTrig) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Auto Mode]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(Status.State[1])[MOVE(0,XAxisMotionParameters.MoveType) ,MOVE(HMI_XAxis.Parameters.AutoSpeed[0],XAxisMotionParameters.Speed) ,MOVE(HMI_XAxis.Parameters.Accel[0],XAxisMotionParameters.Accel) ,MOVE(HMI_XAxis.Parameters.Decel[0],XAxisMotionParameters.Decel) ,[XIC(Status.State[34]) ,XIC(Status.State[103]) ] MOVE(HMI_XAxis.Parameters.Positions[0],XAxisMotionParameters.Position) ,[XIC(Status.State[22]) ,XIC(Status.State[106]) ] MOVE(HMI_XAxis.Parameters.Positions[1],XAxisMotionParameters.Position) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Axis Motion Command]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)[XIC(Status.State[1]) XIC(XAxisManMoveTrig) ,XIO(Status.State[1]) [XIC(Status.State[22]) ,XIC(Status.State[34]) ,XIC(Status.State[103]) ,XIC(Status.State[106]) ] ]XIC(iq_XAxis.ServoActionStatus)XIC(iq_XAxis.AxisHomedStatus)XIC(XAxisPermissive)MAM(iq_XAxis,XAxis_MAM,XAxisMotionParameters.MoveType,XAxisMotionParameters.Position,XAxisMotionParameters.Speed,Units per sec,XAxisMotionParameters.Accel,Units per sec2,XAxisMotionParameters.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Stop axis if permissive turns off while in motion and use max or close to max decel value]]>
</Comment>
<Text>
<![CDATA[XIO(iq_XAxis.MotionStatus.0)[XIO(XAxisPermissive) ,XIO(SafetyOK) ]MAS(iq_XAxis,XAxis_MAS_All,All,Yes,HMI_XAxis.Status.MaxDecel,Units per sec2,Yes,10,% of Time);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Set torque]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_XAxis.Control.SetTorquePos)MOVE(HMI_XAxis.Parameters.TorquePos,iq_XAxis.TorqueLimitPositive);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(HMI_XAxis.Control.SetTorqueNeg)MOVE(HMI_XAxis.Parameters.TorqueNeg,iq_XAxis.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Retrieve values from axis]]>
</Comment>
<Text>
<![CDATA[MOVE(iq_XAxis.ActualPosition,HMI_XAxis.Status.ActualPosition)MOVE(iq_XAxis.ActualVelocity,HMI_XAxis.Status.ActualVelocity)MOVE(iq_XAxis.TorqueReferenceFiltered,HMI_XAxis.Status.ActualTorque);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Retrieve the maximum speed value from the axis and calculate max accel and decel.  The max velocity is 85% of full speed.  Equation is based upon 100% speed at a 30ms accel/decel time.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)GSV(Axis,iq_XAxis,MaximumSpeed,HMI_XAxis.Status.MaxVelocity)CPT(HMI_XAxis.Status.MaxAccel,(HMI_XAxis.Status.MaxVelocity/0.85)/0.03)MOVE(HMI_XAxis.Status.MaxAccel,HMI_XAxis.Status.MaxDecel);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Axis Position Monitor]]>
</Comment>
<Text>
<![CDATA[[AOI_RangeCheck(XAxisPick,HMI_XAxis.Parameters.Positions[0],0.5,HMI_XAxis.Status.ActualPosition,5) ,AOI_RangeCheck(XAxisPlace,HMI_XAxis.Parameters.Positions[1],0.5,HMI_XAxis.Status.ActualPosition,5) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[X Axis Servo Drive Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)NE(iq_XAxis.AxisFault,0)[OTE(ServoAlarm[0].Active) ,ONS(ONS.5) DTOS(iq_XAxis.AxisFault,XAxisFault) CONCAT(g_StationList[StaNum],ServoAlarmList[0],XAxisFaultMessage) CONCAT(XAxisFaultMessage,XAxisFault,ServoAlarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[X Axis Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)XIC(g_MachineBasic.PowerUpCP)XIO(iq_XAxis.AxisHomedStatus)[OTE(ServoAlarm[1].Active) ,ONS(ONS.6) CONCAT(g_StationList[StaNum],ServoAlarmList[1],ServoAlarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[X Axis quickstop warning]]>
</Comment>
<Text>
<![CDATA[[XIC(XAxis_MAS_All.EN) ONS(ONS.29) ,XIC(ServoAlarm[4].Active) XIO(FaultReset) ][OTE(ServoAlarm[4].Active) ,XIO(VerticalSlideRetractedDebounce.On) CONCAT(g_StationList[StaNum],XAxisQuickstopMessageA,XAxisQuickstopMessageB) CONCAT(XAxisQuickstopMessageB,XAxisQuickstopReason,ServoAlarm[4].Message) ,MOVE(1,ServoAlarm[4].Severity) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Reach Place Position]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[22]) XIO(XAxisPlace.InPos) ,XIC(Status.State[106]) ] MOVE(3000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset) ][OTE(Alarm[0].Active) ,ONS(ONS.9) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Reach Pick Position]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[34]) XIO(XAxisPick.InPos) ,XIC(Status.State[103]) ] MOVE(3000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset) ][OTE(Alarm[1].Active) ,ONS(ONS.10) CONCAT(g_StationList[StaNum],AlarmList[1],Alarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Vertical Slide To Extend]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[7]) ,XIC(Status.State[25]) ] MOVE(3000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,ONS(ONS.11) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For Vertical Slide To Retract]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[16]) ,XIC(Status.State[31]) ,XIC(Status.State[100]) ] MOVE(7000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset) ][OTE(Alarm[3].Active) ,ONS(ONS.12) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Escapement Shuttle Gripper To Open - warning, the station holds the part and waits]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) MOVE(10000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset) ][OTE(Alarm[4].Active) ,ONS(ONS.13) MOVE(1,Alarm[4].Severity) CONCAT(g_StationList[StaNum],AlarmList[4],Alarm[4].Message) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Part Ready From Escapement - warning, normal starvation]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(10000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[5].Active) ,ONS(ONS.14) MOVE(1,Alarm[5].Severity) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Ready Signal From Dial - warning, the station holds the part at place and waits]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[22]) XIC(XAxisPlace.InPos) MOVE(10000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset) ][OTE(Alarm[6].Active) ,ONS(ONS.15) MOVE(1,Alarm[6].Severity) CONCAT(g_StationList[StaNum],AlarmList[6],Alarm[6].Message) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Servo Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ServoFaultHandler,\Alarms.p_ProgramID,ServoAlarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,ServoAlarmActive,ServoWarningActive);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Station Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,AlarmActive,WarningActive);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Alarm/Warning Active Outputs]]>
</Comment>
<Text>
<![CDATA[[XIC(ServoAlarmActive) ,XIC(AlarmActive) ]OTE(q_AlarmActive);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(ServoWarningActive) ,XIC(WarningActive) ]OTE(q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
