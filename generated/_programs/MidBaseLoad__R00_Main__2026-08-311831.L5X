<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Nest & Station Numbers]]>
</Comment>
<Text>
<![CDATA[[MOVE(1,StaNum) MOVE(20,StaNumPre) ,MOVE(\Tracking.p_Data.Station[StaNum].NestNum,NestNumCurrent) MOVE(\Tracking.p_Data.Station[StaNumPre].NestNum,NestNumIncoming) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[XIO(i_EscapementFinger1Retracted)XIC(q_ExtendEscapementFinger1)XIO(q_RetractEscapementFinger1)TON(EscapementFinger1ExtendDelay,?,?)XIC(EscapementFinger1ExtendDelay.DN)OTE(EscapementFinger1Extended);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(i_EscapementFinger1Retracted)XIC(q_RetractEscapementFinger1)XIO(q_ExtendEscapementFinger1)OTE(EscapementFinger1Retracted);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(i_EscapementShuttleRetracted)XIC(q_ExtendEscapementShuttle)XIO(q_RetractEscapementShuttle)TON(EscapementShuttleExtendDelay,?,?)XIC(EscapementShuttleExtendDelay.DN)OTE(EscapementShuttleExtended);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(i_EscapementShuttleRetracted)XIC(q_RetractEscapementShuttle)XIO(q_ExtendEscapementShuttle)OTE(EscapementShuttleRetracted);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[AOI_Debounce(NestPartPresentDebounce,i_NestPartPresent,100,100);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(q_DisengageShuttleGripper)XIO(q_EngageShuttleGripper)XIO(i_ShuttleGripperClosed)TON(ShuttleGripperDisengageDelay,?,?)XIC(ShuttleGripperDisengageDelay.DN)OTE(ShuttleGripperOpened);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(i_ShuttleGripperClosed)XIC(q_EngageShuttleGripper)XIO(q_DisengageShuttleGripper)TON(ShuttleGripperEngageDelay,?,?)XIC(ShuttleGripperEngageDelay.DN)OTE(ShuttleGripperClosed);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Home posture - escapement finger 1 retracted, escapement shuttle retracted, shuttle gripper disengaged]]>
</Comment>
<Text>
<![CDATA[XIO(PartStarted)XIC(EscapementShuttleRetracted)XIC(EscapementFinger1Retracted)XIC(ShuttleGripperOpened)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)XIO(ManualMode)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Dry run logic (can add supervisor dry run condition if needed as parallel branch)]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.DryRun)OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Cycle Station]]>
</Comment>
<Text>
<![CDATA[XIO(\Tracking.p_Data.Nest[NestNumCurrent].OpStatus.Lockout)XIO(\HMI.q_CleanoutModeEnabled)[XIO(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStationA) ,OTE(CycleStationB) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[STATE MAP (generated - authoritative): 4=Home / Initial | 7=Retract Escapement_Finger_1 | 10=Engage Shuttle_Gripper | 13=Extend Escapement_Finger_1 | 16=Extend Escapement_Shuttle | 19=Signal part ready for pick to Mid-Base Pick and Place | 22=Disengage Shuttle_Gripper | 25=Signal shuttle gripper open to Mid-Base Pick and Place | 28=Retract Escapement_Shuttle | 31=Cycle Complete
Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[99]) XIO(CycleRunning) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[4]) ,XIC(Status.State[19]) ,XIC(Status.State[31]) XIC(EscapementShuttleRetracted) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Start of sequence]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ] XIC(ShuttleGripperOpened) ,XIC(Status.State[31]) XIC(EscapementShuttleRetracted) ]XIC(CycleRunning)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Retract escapement finger 1 to release a mid base into the nest]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(SS_OK)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Engage shuttle gripper on the mid base in the nest]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(EscapementFinger1Retracted)[XIC(NestPartPresentDebounce.On) ,XIC(DryRun) ]XIC(SS_OK)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: Extend escapement finger 1 to hold back the next mid base

Gripper confirmed closed on the part - latch part tracking Attempt for this station]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(ShuttleGripperClosed)XIC(SS_OK)MOVE(13,Control.StateReg)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 16: Extend escapement shuttle to the pick position

Initialization complete holding a part, and restart holding a part, re-enter the sequence here]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) XIC(EscapementFinger1Extended) XIC(SS_OK) ,XIC(Status.State[124]) XIC(ShuttleGripperClosed) XIC(CycleRunning) ,XIC(Status.State[2]) XIO(Initialized) XIC(PartStarted) XIC(ShuttleGripperClosed) XIC(CycleRunning) ]MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 19: Signal part ready for pick to mid base pick and place]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])XIC(EscapementShuttleExtended)XIC(SS_OK)MOVE(19,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 22: Disengage shuttle gripper

*Replace AlwaysOff bit with the mid base pick and place part gripped signal (\S02_MidBasePickAndPlace.p_PartGripped).]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])[XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ]XIC(SS_OK)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 25: Signal shuttle gripper open to mid base pick and place]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[22])XIC(ShuttleGripperOpened)XIC(SS_OK)MOVE(25,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 28: Retract escapement shuttle

*Replace AlwaysOff bit with the mid base pick and place part clear signal (\S02_MidBasePickAndPlace.p_PartClear).

Part handoff confirmed - latch part tracking Success for this station]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ]XIC(SS_OK)MOVE(28,Control.StateReg)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 31: Cycle complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[28])XIC(EscapementShuttleRetracted)XIC(SS_OK)MOVE(31,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 99: Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(Lockout)MOVE(99,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 100: Start of initialization sequence, retract escapement shuttle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIO(PartStarted)XIC(CycleRunning)XIC(SS_OK)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 103: Initialization retract escapement finger 1

Shuttle gripper closed sensor off - no part held, initialize to the home posture]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(EscapementShuttleRetracted)XIO(i_ShuttleGripperClosed)XIC(SS_OK)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 106: Initialization extend escapement finger 1

Shuttle gripper closed sensor on - a mid base is held, hold back the track and re-enter at the pick position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(EscapementShuttleRetracted)XIC(i_ShuttleGripperClosed)XIC(SS_OK)MOVE(106,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[103]) XIC(EscapementFinger1Retracted) XIC(ShuttleGripperOpened) ,XIC(Status.State[106]) XIC(EscapementFinger1Extended) XIC(ShuttleGripperClosed) ]MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here.

For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(g_MachineBasic.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,98) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,98) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Actuators Safe For Index]]>
</Comment>
<Text>
<![CDATA[XIC(EscapementShuttleRetracted)OTE(q_ActuatorsSafe);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Pause Request To Indexer]]>
</Comment>
<Text>
<![CDATA[[XIC(Alarm[0].Active) ,XIC(Alarm[9].Active) ]OTE(q_Pause);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Set the part started bit once the process gets to a point where if interrupted you want to resume or perform some other operation upon restart. Use states and/or part tracking to set this bit. Fill in additional conditions to clear this bit if necessary.]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) ,XIC(PartStarted) XIO(Status.State[28]) XIO(g_MachineBasic.PowerUpCP) XIC(ShuttleGripperClosed) ]OTE(PartStarted);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Set Part Tracking If Station Is Locked Out]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)XIC(Status.State[99])XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Station Complete]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)[XIC(CycleStationB) [XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout) ] ,XIO(CycleStationB) ]OTE(q_StationComplete);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Escapement Shuttle Control

Manual extend permissive - escapement finger 1 extended holds back the feeder track]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_Momentary.0) XIC(EscapementFinger1Extended) OTE(OkManExtendShuttle) ,XIC(HMI_Momentary.1) OTE(OkManRetractShuttle) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Extend Escapement Shuttle]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[16]) ,XIC(q_ExtendEscapementShuttle) XIO(Status.State[28]) XIO(Status.State[100]) ] ,XIC(Status.State[1]) [XIC(OkManExtendShuttle) ,XIC(q_ExtendEscapementShuttle) XIO(OkManRetractShuttle) ] ]OTE(q_ExtendEscapementShuttle);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Retract Escapement Shuttle]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[28]) ,XIC(Status.State[100]) ,XIC(q_RetractEscapementShuttle) XIO(Status.State[16]) ] ,XIC(Status.State[1]) [XIC(OkManRetractShuttle) ,XIC(q_RetractEscapementShuttle) XIO(OkManExtendShuttle) ] ]OTE(q_RetractEscapementShuttle);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Escapement Finger 1 Control]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[13]) ,XIC(Status.State[106]) ,XIC(q_ExtendEscapementFinger1) XIO(Status.State[7]) XIO(Status.State[103]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.2) ,XIC(q_ExtendEscapementFinger1) XIO(HMI_Momentary.3) ] ]OTE(q_ExtendEscapementFinger1);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[7]) ,XIC(Status.State[103]) ,XIC(q_RetractEscapementFinger1) XIO(Status.State[13]) XIO(Status.State[106]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.3) ,XIC(q_RetractEscapementFinger1) XIO(HMI_Momentary.2) ] ]OTE(q_RetractEscapementFinger1);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Shuttle Gripper Control]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[10]) ,XIC(Status.State[106]) ,XIC(q_EngageShuttleGripper) XIO(Status.State[22]) XIO(Status.State[103]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.4) ,XIC(q_EngageShuttleGripper) XIO(HMI_Momentary.5) ] ]OTE(q_EngageShuttleGripper);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[22]) ,XIC(Status.State[103]) ,XIC(q_DisengageShuttleGripper) XIO(Status.State[10]) XIO(Status.State[106]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.5) ,XIC(q_DisengageShuttleGripper) XIO(HMI_Momentary.4) ] ]OTE(q_DisengageShuttleGripper);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[SM Output Signal: Part Ready For Pick - set when the mid base is presented, cleared when pick and place has gripped it]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) ,XIC(p_PartReadyForPick) XIO(Status.State[22]) ]OTE(p_PartReadyForPick);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[SM Output Signal: Shuttle Gripper Open - set when the gripper releases, cleared when the shuttle retracts]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[25]) ,XIC(p_ShuttleGripperOpen) XIO(Status.State[28]) ]OTE(p_ShuttleGripperOpen);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Station Performance]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)StationPerformance(StationPerformance,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success,g_PresetStationPerformLow,g_PresetStationPerformHigh,\Tracking.p_Data.Station[StaNum].PerformData.Attempts,\Tracking.p_Data.Station[StaNum].PerformData.Successes,\Tracking.p_Data.Station[StaNum].PerformData.Failures,\Tracking.p_Data.Station[StaNum].PerformData.Efficiency,\Tracking.p_Data.Station[StaNum].PerformData.HMIColorStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Part Present At Nest]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])MOVE(10000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[0].Active) ,ONS(ONS.5) MOVE(1,Alarm[0].Severity) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Escapement Shuttle To Extend]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_ExtendEscapementShuttle) XIO(EscapementShuttleExtended) TON(AlarmTimerShuttleExtended,?,?) XIC(AlarmTimerShuttleExtended.DN) ,XIC(Alarm[1].Active) XIO(FaultReset) ][OTE(Alarm[1].Active) ,ONS(ONS.6) CONCAT(g_StationList[StaNum],AlarmList[1],Alarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Escapement Shuttle To Retract]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractEscapementShuttle) XIO(EscapementShuttleRetracted) TON(AlarmTimerShuttleRetracted,?,?) XIC(AlarmTimerShuttleRetracted.DN) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,ONS(ONS.7) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Escapement Shuttle Outputs Misconfigured]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractEscapementShuttle) XIC(q_ExtendEscapementShuttle) TON(AlarmTimerShuttleMisconfigured,?,?) XIC(AlarmTimerShuttleMisconfigured.DN) ,XIC(Alarm[3].Active) XIO(FaultReset) ][OTE(Alarm[3].Active) ,ONS(ONS.8) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Escapement Finger 1 To Extend]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_ExtendEscapementFinger1) XIO(EscapementFinger1Extended) TON(AlarmTimerFinger1Extended,?,?) XIC(AlarmTimerFinger1Extended.DN) ,XIC(Alarm[4].Active) XIO(FaultReset) ][OTE(Alarm[4].Active) ,ONS(ONS.9) CONCAT(g_StationList[StaNum],AlarmList[4],Alarm[4].Message) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Escapement Finger 1 To Retract]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractEscapementFinger1) XIO(EscapementFinger1Retracted) TON(AlarmTimerFinger1Retracted,?,?) XIC(AlarmTimerFinger1Retracted.DN) ,XIC(Alarm[5].Active) XIO(FaultReset) ][OTE(Alarm[5].Active) ,ONS(ONS.10) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Escapement Finger 1 Outputs Misconfigured]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractEscapementFinger1) XIC(q_ExtendEscapementFinger1) TON(AlarmTimerFinger1Misconfigured,?,?) XIC(AlarmTimerFinger1Misconfigured.DN) ,XIC(Alarm[6].Active) XIO(FaultReset) ][OTE(Alarm[6].Active) ,ONS(ONS.11) CONCAT(g_StationList[StaNum],AlarmList[6],Alarm[6].Message) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Shuttle Gripper To Engage]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_EngageShuttleGripper) XIO(ShuttleGripperClosed) TON(AlarmTimerGripperEngaged,?,?) XIC(AlarmTimerGripperEngaged.DN) ,XIC(Alarm[7].Active) XIO(FaultReset) ][OTE(Alarm[7].Active) ,ONS(ONS.12) CONCAT(g_StationList[StaNum],AlarmList[7],Alarm[7].Message) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Shuttle Gripper To Disengage]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_DisengageShuttleGripper) XIO(ShuttleGripperOpened) TON(AlarmTimerGripperDisengaged,?,?) XIC(AlarmTimerGripperDisengaged.DN) ,XIC(Alarm[8].Active) XIO(FaultReset) ][OTE(Alarm[8].Active) ,ONS(ONS.13) CONCAT(g_StationList[StaNum],AlarmList[8],Alarm[8].Message) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Mid Base Pick And Place To Take Part

Severity 1 warning - the station is holding a good part while the partner is late, so it pauses and holds instead of faulting]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) ,XIC(Status.State[25]) ]MOVE(5000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[9].Active) ,ONS(ONS.14) MOVE(1,Alarm[9].Severity) CONCAT(g_StationList[StaNum],AlarmList[9],Alarm[9].Message) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Use="Context" Name="Supervisor" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="q_CycleStartLatch">
</Tag>
<Tag Use="Reference" Name="q_CycleStopped">
</Tag>
<Tag Use="Reference" Name="q_FaultReset">
</Tag>
<Tag Use="Reference" Name="q_ManualMode">
</Tag>
<Tag Use="Reference" Name="q_SafetyOK">
</Tag>
</Tags>
</Program>
<Program Use="Context" Name="Tracking" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="p_Data">
</Tag>
</Tags>
</Program>
</Programs>
</Controller>
