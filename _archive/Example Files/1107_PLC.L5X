<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Drive Fault]]>
</Comment>
<Text>
<![CDATA[[XIC(in_Safety.OK) NE(Axis.AxisFault,0) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[MAM Error]]>
</Comment>
<Text>
<![CDATA[[XIC(Axis_MAM.ER) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Part Present Inhibiting Rotate]]>
</Comment>
<Text>
<![CDATA[[XIC(Outfeed_SM.Status.State[8]) XIC(Dial_Full) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Robot has a PCB Reject but Rack is Full]]>
</Comment>
<Text>
<![CDATA[[XIC(\Tracking.PCB_REJECT) NE(ID,0) XIC(Robot02_PCB_SM.Control.Bit[10]) ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning - Reject Rack is Full]]>
</Comment>
<Text>
<![CDATA[XIC(Robot02_PCB_SM.Control.Bit[10])CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Warning - Outfeed Dial is Full]]>
</Comment>
<Text>
<![CDATA[XIC(Dial_Full)CONCAT(StationName,WarningText[1],Warning[1].Message)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Warning - Reject Rack is Not Present]]>
</Comment>
<Text>
<![CDATA[XIO(RejectRack_PRESENT)CONCAT(StationName,WarningText[2],Warning[2].Message)OTE(Warning[2].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(IOBlock_Soldering:I.ProcessDataIn.Port_X7A)OTE(Dial_Full);]]>
