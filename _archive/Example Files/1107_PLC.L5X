</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[DIV(Axis.ActualPosition,1,CurrPOS_raw)TRUNC(CurrPOS_raw,CurrPOS_Trunc)SUB(CurrPOS_raw,CurrPOS_Trunc,CurrPOS_Temp);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[LT(CurrPOS_Temp,0.5) CPT(CurrPOS_Delta,CurrPOS_raw-CurrPOS_Trunc) MOVE(CurrPOS_Trunc,POSNearest) ,GE(CurrPOS_Temp,0.5) CPT(CurrPOS_Delta,1-(CurrPOS_raw-CurrPOS_Trunc)) ADD(CurrPOS_Trunc,1,POSNearest) ]EQ(POSNearest,30)MOVE(0,POSNearest);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(Outfeed_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,Outfeed_SM.Control.StateReg) ,XIC(Outfeed_SM.Status.State[62]) MOVE(StoppedState,Outfeed_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
