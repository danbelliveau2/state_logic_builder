<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Misc Logic]]>
</Comment>
<Text>
<![CDATA[EQ(SupervisorState,3)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Servo Axis Control]]>
</Comment>
<Text>
<![CDATA[XIC(MotionGroup.GroupSynced)XIO(Axis.SafeTorqueOffActiveInhibit)OTE(HMI_ServoData.Status.Ready);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(SafetyStatus)XIC(HMI_ServoData.Status.Ready)TON(AutoEnable_TMR,?,?)XIC(AutoEnable_TMR.DN)ONS(ONS_Word.0)OTE(Axis_AutoEnable);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[[XIC(ManualMode) XIC(HMI_ServoData.Control.Enable) XIC(HMI_ServoData.Status.Ready) ,XIC(Axis_AutoEnable) ]XIO(Axis.ServoActionStatus)MSO(Axis,Axis_MSO);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(HMI_ServoData.Status.Ready)XIC(Axis.ServoActionStatus)OTE(HMI_ServoData.Status.MotionEnable);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(HMI_ServoData.Control.Disable)MSF(Axis,Axis_MSF);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Home Axis]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)[XIC(HMI_ServoData.Control.HomeRequest) ONS(Home_ONS) XIO(AOI_TorqueHome.IP) ,XIC(HMI_ServoData.Status.HomeRequested) XIO(HomeConfirm_TMR.DN) XIO(HomeConfimed) ]XIC(HMI_ServoData.Status.Ready)[OTE(HMI_ServoData.Status.HomeRequested) ,TON(HomeConfirm_TMR,?,?) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(ManualMode)[XIC(HMI_ServoData.Control.HomeConfirm) ONS(Confirm_ONS) ,XIC(HomeConfimed) XIC(HomeSelect) XIO(AOI_TorqueHome.PC) XIO(AOI_TorqueHome.Error) ]OTE(HomeConfimed);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(HomeConfimed)[XIO(HomeSelect) MAH(Axis,Axis_MAH) ,XIC(HomeSelect) AOI_TorqueHome(AOI_TorqueHome,Axis,HomingTorque,RunTorque,HomingSpeed,OvertorqueLimit,HomeOffsetDist,HomeDirection) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(AOI_TorqueHome.Error) [OTE(HomeER) ,OTE(HMI_ServoData.Status.HomeError) ] ,XIC(AOI_TorqueHome.PC) [OTE(HomePC) ,OTE(HMI_ServoData.Status.HomePC) ] ,XIC(AOI_TorqueHome.IP) [OTE(HomeIP) ,OTE(HMI_ServoData.Status.HomeIP) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Axis Fault Reset]]>
</Comment>
<Text>
<![CDATA[NE(Axis.AxisFault,0)XIC(FaultReset)[XIO(Axis.ShutdownStatus) MAFR(Axis,Axis_MAFR) ,XIC(Axis.ShutdownStatus) MASR(Axis,Axis_MASR) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIO(SafetyStatus)[EQ(SpeedUnits,0) MAS(Axis,Axis_MASAll,All,Yes,HMI_ServoData.Control.Decel,Units per sec2,No,0.0,Units per sec3) ,EQ(SpeedUnits,1) MAS(Axis,Axis_MASAll,All,Yes,HMI_ServoData.Control.Decel,% of Maximum,No,0.0,Units per sec3) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Axis Jog Control]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(HMI_ServoData.Status.MotionEnable)XIO(Axis.MoveStatus)XIO(Axis.JogStatus)[XIC(HMI_ServoData.Control.JogPositive) XIO(HMI_ServoData.Control.JogNegative) MOVE(0,JogDirection) ,XIC(HMI_ServoData.Control.JogNegative) XIO(HMI_ServoData.Control.JogPositive) MOVE(1,JogDirection) ][EQ(SpeedUnits,0) MAJ(Axis,Axis_MAJ,JogDirection,HMI_ServoData.Control.JogSpeed,Units per sec,HMI_ServoData.Control.Accel,Units per sec2,HMI_ServoData.Control.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None) ,EQ(SpeedUnits,1) MAJ(Axis,Axis_MAJ,JogDirection,HMI_ServoData.Control.JogSpeed,% of Maximum,HMI_ServoData.Control.Accel,% of Maximum,HMI_ServoData.Control.Decel,% of Maximum,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Axis_MAJ.IP)XIO(HMI_ServoData.Control.JogPositive)XIO(HMI_ServoData.Control.JogNegative)[EQ(SpeedUnits,0) MAS(Axis,AxisJog_MAS,Jog,Yes,HMI_ServoData.Control.Decel,Units per sec2,No,0,Units per sec3) ,EQ(SpeedUnits,1) MAS(Axis,AxisJog_MAS,Jog,Yes,HMI_ServoData.Control.Decel,% of Maximum,No,0,Units per sec3) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Axis Continuous Jog Control]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(HMI_ServoData.Status.MotionEnable)XIO(Axis.MoveStatus)XIO(Axis.JogStatus)[XIC(HMI_ServoData.Control.CJogPositive) MOVE(0,JogDirection) ,XIC(HMI_ServoData.Control.CJogNegative) MOVE(1,JogDirection) ][EQ(SpeedUnits,0) MAJ(Axis,Axis_CMAJ,JogDirection,HMI_ServoData.Control.JogSpeed,Units per sec,HMI_ServoData.Control.Accel,Units per sec2,HMI_ServoData.Control.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None) ,EQ(SpeedUnits,1) MAJ(Axis,Axis_CMAJ,JogDirection,HMI_ServoData.Control.JogSpeed,% of Maximum,HMI_ServoData.Control.Accel,% of Maximum,HMI_ServoData.Control.Decel,% of Maximum,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Axis_CMAJ.IP)XIC(HMI_ServoData.Control.CJogStop)[EQ(SpeedUnits,0) MAS(Axis,AxisJog_CMAS,Jog,Yes,HMI_ServoData.Control.Decel,Units per sec2,No,0,Units per sec3) ,EQ(SpeedUnits,1) MAS(Axis,AxisJog_CMAS,Jog,Yes,HMI_ServoData.Control.Decel,% of Maximum,No,0,Units per sec3) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Inch Move]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(HMI_ServoData.Status.MotionEnable)[XIC(HMI_ServoData.Control.InchPos) ONS(ONS_Word.3) MOVE(HMI_ServoData.Control.InchAmount,InchAmount) ,XIC(HMI_ServoData.Control.InchNeg) ONS(ONS_Word.4) NEG(HMI_ServoData.Control.InchAmount,InchAmount) ]XIO(Axis.MoveStatus)XIO(Axis.JogStatus)[EQ(SpeedUnits,0) MAM(Axis,Axis_MAM,1,InchAmount,HMI_ServoData.Control.ManualSpeed,Units per sec,HMI_ServoData.Control.Accel,Units per sec2,HMI_ServoData.Control.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0) ,EQ(SpeedUnits,1) MAM(Axis,Axis_MAM,1,InchAmount,HMI_ServoData.Control.ManualSpeed,% of Maximum,HMI_ServoData.Control.Accel,% of Maximum,HMI_ServoData.Control.Decel,% of Maximum,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
