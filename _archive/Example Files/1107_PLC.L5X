<AddOnInstructionDefinition Name="State_Engine_64Max_v3_5" Class="Standard" Revision="3.5" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-06-25T13:55:13.933Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2024-08-20T18:47:27.016Z" EditedBy="STEVENDOUGLAS\msavina"
 SoftwareRevision="v35.00">
<Description>
<![CDATA[State Logic Engine For 64 States]]>
</Description>
<RevisionNote>
<![CDATA[Added separate fault timer]]>
</RevisionNote>
