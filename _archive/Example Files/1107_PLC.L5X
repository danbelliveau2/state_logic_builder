<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(5000,EpoxyCure_2_SM.Control.FaultTime)OTE(EpoxyCure_2_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
