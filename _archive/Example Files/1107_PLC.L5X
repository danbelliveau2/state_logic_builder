<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Dereeler: Wire Spool VFD Faulted]]>
</Comment>
<Text>
<![CDATA[[XIC(v01WireSpool_IN.Fault) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Tensioner Position Range = 80 - 550

Dereeler: Tensioner Too Low]]>
</Comment>
<Text>
<![CDATA[[GE(Tensioner_Dist,530) ,XIC(Latch_TensionerLOW) ]XIO(Alarm[1].Active)OTE(Latch_TensionerLOW);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Latch_TensionerLOW) XIO(WireFeed_SM.Control.Bit[9]) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)[OTE(Alarm[1].Active) ,OTE(out_ResetWireFeed_InitSeq) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Dereeler: Tensioner Too High]]>
</Comment>
<Text>
<![CDATA[[LE(Tensioner_Dist,80) ONS(Dereeler_SM.Control.OS[3]) ,XIC(Latch_TensionerHIGH) ]XIO(Alarm[2].Active)OTE(Latch_TensionerHIGH);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(Latch_TensionerHIGH) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fault]]>
</Comment>
<Text>
<![CDATA[[AFI() ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Warning]]>
</Comment>
<Text>
<![CDATA[AFI()OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(Lockout_Dereeler)ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INPUTS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(TensionerPosition:I.ProcessDataIn.Distance,Tensioner_Dist);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(WireReelRadius:I.ProcessDataIn.Distance,Wire_Dist);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GE(Wire_Dist,Dereeler_SM.Control.DINT[0])OTE(WireSupply_Low);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Auto Speed Calculations]]>
</Comment>
<Text>
<![CDATA[EQ(WireDist_EMPTY,0)EQ(Reel_Radius_EMPTY,0)EQ(WireFeed_SM.Control.REAL[1],0)NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CPT(WireCirc,((WireDist_EMPTY-Wire_Dist) + Reel_Radius_EMPTY)*2*3.14159)CPT(ReelRPM_Reqd,WireFeed_SM.Control.REAL[1]*60/WireCirc)CPT(AutoSpeed_Calc,ReelRPM_Reqd*20);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Auto Speed Limits]]>
</Comment>
<Text>
<![CDATA[MOVE(AutoSpeed_Calc,AutoSpeed)[LT(AutoSpeed,WireFeed_SM.Control.DINT[0]) MOVE(WireFeed_SM.Control.DINT[0],AutoSpeed) ,GT(AutoSpeed,WireFeed_SM.Control.DINT[1]) MOVE(WireFeed_SM.Control.DINT[1],AutoSpeed) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[GT(WireFeed_SM.Control.REAL[0],5)OTE(InfeedPuller_Moving);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[LIMIT(TensionerHome_LL,Tensioner_Dist,TensionerHome_HL)OTE(Tensioner_Home);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[GT(Tensioner_Dist,TensionerHome_HL)OTE(Tensioner_TooLow);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(Dereeler_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,Dereeler_SM.Control.StateReg) ,XIC(Dereeler_SM.Status.State[62]) MOVE(StoppedState,Dereeler_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Dereeler_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Dereeler_SM.Status.State[5]) ,XIC(Dereeler_SM.Status.State[61]) ][XIO(Lockout_Dereeler) XIC(CycleStartLatch) ,EQ(HMI_Data.Control.DINT_SP[10],1) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[[XIC(INIT) ,XIC(Dereeler_SM.Status.State[7]) XIC(WireFeed_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) ]MOVE(5,Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 6
DEREELER FORWARD (Reel Up Wire)]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Dereeler_SM.Status.State[4]) ,XIC(Dereeler_SM.Status.State[7]) ,XIC(Dereeler_SM.Status.State[8]) ]XIC(Tensioner_TooLow)XIC(Supervisor_SM.Control.Bit[4])MOVE(6,Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 7
STOP / MONITOR]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Dereeler_SM.Status.State[4]) ,XIC(Dereeler_SM.Status.State[6]) ,XIC(Dereeler_SM.Status.State[8]) XIO(InfeedPuller_Moving) ]XIC(Tensioner_Home)MOVE(7,Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 8
DEREELER REVERSE (Unspool Wire)]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(Dereeler_SM.Status.State[4]) ,XIC(Dereeler_SM.Status.State[6]) ,XIC(Dereeler_SM.Status.State[7]) ] XIO(Tensioner_TooLow) XIO(Tensioner_Home) ,XIC(Dereeler_SM.Status.State[7]) XIC(InfeedPuller_Moving) ]XIC(Supervisor_SM.Control.Bit[4])MOVE(8,Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Dereeler_SM.Status.State[5])XIC(Lockout_Dereeler)XIC(CycleStartLatch)MOVE(61,Dereeler_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Dereeler_SM.Status.State[7]) [XIC(Robot01_Wire_SM.Status.State[62]) ,XIC(Robot01_Wire_SM.Status.State[63]) ] ,XIC(Dereeler_SM.Status.State[61]) ]XIO(CycleStartLatch)XIO(HMI_Data.Status.MachineInSC)[ONS(Dereeler_SM.Control.OS[1]) MOVE(Dereeler_SM.Control.StateReg,StoppedState) ,MOVE(62,Dereeler_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(Dereeler_SM.Control.OS[0]) MOVE(Dereeler_SM.Control.StateReg,FaultedState) ,MOVE(63,Dereeler_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_Dereeler_SM,Dereeler_SM);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(Dereeler_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(500,Dereeler_SM.Control.TransitionTime)OTE(Dereeler_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(5000,Dereeler_SM.Control.FaultTime)OTE(Dereeler_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[
STATE LOGIC ACTIONS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Control Bits]]>
</Comment>
<Text>
<![CDATA[XIO(MachineBasic.AlwaysOn)OTE(Dereeler_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[VFD Drive Control]]>
</Comment>
<Text>
<![CDATA[OTE(DriveOutputs.NetControl)OTE(DriveOutputs.NetSetpoint);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Fault Reset]]>
</Comment>
<Text>
<![CDATA[[[[XIC(DriveInputs.Warning) ,XIC(DriveInputs.Fault) ] XIC(in_FaultReset) ,XIC(AUTO) ONS(Dereeler_SM.Control.OS[2]) ] ,XIC(TMR_ResetDriveFault.TT) XIO(TMR_ResetDriveFault.DN) ]MOVE(DriveFltRstPulseTime,TMR_ResetDriveFault.PRE)TON(TMR_ResetDriveFault,?,?);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[[XIC(TMR_ResetDriveFault.TT) ,XIC(Debug_FaultReset) ]OTE(DriveOutputs.Reset);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[Manual Jog Buttons]]>
</Comment>
<Text>
<![CDATA[XIO(AUTO)XIC(in_Safety.OK)[XIO(AlarmActive) ,GT(DriveInputs.Torque,0) ][XIC(HMI_Data.MOMButtons[0]) OTE(RunFWD_Manual) ,XIC(HMI_Data.MOMButtons[1]) OTE(RunREV_Manual) ];]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[Auto Run]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIO(AlarmActive)[XIC(Dereeler_SM.Status.State[6]) OTE(RunFWD_Auto) ,XIC(Dereeler_SM.Status.State[8]) OTE(RunREV_Auto) ];]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[Run Commands]]>
</Comment>
<Text>
<![CDATA[[[XIC(RunFWD_Manual) ,XIC(RunFWD_Auto) ] OTE(DriveOutputs.RunReverse) ,[XIC(RunREV_Manual) ,XIC(RunREV_Auto) ] OTE(DriveOutputs.RunForward) ];]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[Drive speed setpoints]]>
</Comment>
<Text>
<![CDATA[XIC(MAN)MOVE(ManualJogSpeed,DriveOutputs.Speed);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIC(AUTO)MOVE(AutoSpeed,DriveOutputs.Speed);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
