<![CDATA[XIC(MAN)XIC(WireFeed_SM.Control.Bit[4])[MUL(HMI_Axis.Control.ManualSpeed,VEL_Scaling,Axis_MAMParam.Speed) ,[XIC(HMI_Axis.Control.ManMoves.0) MOVE(Manual_Move,Axis_MAMParam.Position) ,XIC(HMI_Axis.Control.ManMoves.1) MOVE(TestLength_servo,Axis_MAMParam.Position) ,XIC(HMI_Axis.Control.ManMoves.2) MOVE(ProcessLength_servo,Axis_MAMParam.Position) ] OTE(WireFeed_SM.Control.Bit[5]) ];]]>
