<Text>
<![CDATA[XIC(MachineBasic.Flash250msPS)[MOVE(1,POS_Scaling) MOVE(1,VEL_Scaling) MUL(HMI_Axis.Control.Accel,VEL_Scaling,Axis_MAMParam.Accel) MUL(HMI_Axis.Control.Decel,VEL_Scaling,Axis_MAMParam.Decel) ,MUL(HMI_Axis.Control.AxisPositions[0],POS_Scaling,Manual_Move) ,MUL(HMI_Axis.Control.AxisPositions[1],POS_Scaling,TestLength_servo) ,MUL(HMI_Axis.Control.AxisPositions[2],POS_Scaling,ProcessLength_servo) ];]]>
