</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Outfeed_SM.Status.State[8])XIC(Outfeed_SM.Status.TransitionTimerDone)XIO(Robot02_PCB_SM.Control.Bit[14])XIO(Dial_Full)MOVE(9,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 61
