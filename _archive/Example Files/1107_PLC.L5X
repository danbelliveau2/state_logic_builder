</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.MOMButtons[21])XIC(AUTO)XIC(WireFeed_SM.Status.State[16])MOVE(17,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
