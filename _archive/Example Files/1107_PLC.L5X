<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calcs]]>
</Comment>
<Text>
<![CDATA[DIV(RunTime,60000,RunMinutes)MUL(PartsPerMinute,RunMinutes,TargetOutput);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Availability]]>
</Comment>
<Text>
<![CDATA[ADD(RunTime,DownTime,TotalTime)[NE(TotalTime,0) DIV(RunTime,TotalTime,RunTimePercent) ,EQ(TotalTime,0) MOVE(0.0,RunTimePercent) ,DIV(ShiftTotal,ShiftTime,AvailablePercent) ,DIV(RunTimePercent,AvailablePercent,Availability) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Performance]]>
</Comment>
<Text>
<![CDATA[[NE(TargetOutput,0.0) DIV(TotalParts,TargetOutput,Performance) ,EQ(TargetOutput,0.0) MOVE(0.0,Performance) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Quality]]>
</Comment>
<Text>
<![CDATA[[NE(TotalParts,0) DIV(GoodParts,TotalParts,Quality) ,EQ(TotalParts,0) MOVE(0.0,Quality) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[OEE]]>
</Comment>
<Text>
<![CDATA[CPT(OEE,Availability*Performance*Quality);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
