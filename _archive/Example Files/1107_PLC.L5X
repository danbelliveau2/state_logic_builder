<Tag Name="PCB_Inspection_SM" Class="Standard" TagType="Base" DataType="State_Logic_Data" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Comments>
<Comment Operand=".STATUS.STATE[0]">
<![CDATA[Frist Scan]]>
</Comment>
<Comment Operand=".STATUS.STATE[1]">
<![CDATA[Idle]]>
</Comment>
<Comment Operand=".STATUS.STATE[3]">
<![CDATA[Manual Mode]]>
</Comment>
<Comment Operand=".STATUS.STATE[4]">
<![CDATA[Auto Initialize]]>
</Comment>
<Comment Operand=".STATUS.STATE[5]">
<![CDATA[Auto Ready]]>
</Comment>
<Comment Operand=".STATUS.STATE[7]">
<![CDATA[Ready to Receive PCB]]>
</Comment>
<Comment Operand=".STATUS.STATE[8]">
<![CDATA[Close PCB Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[9]">
<![CDATA[Wait for Robot Retracted]]>
</Comment>
<Comment Operand=".STATUS.STATE[10]">
<![CDATA[Move to INSPECT Position]]>
</Comment>
<Comment Operand=".STATUS.STATE[11]">
<![CDATA[Trigger 3D Camera]]>
</Comment>
<Comment Operand=".STATUS.STATE[12]">
<![CDATA[Wait for Inspection Complete]]>
</Comment>
<Comment Operand=".STATUS.STATE[13]">
<![CDATA[MOVE to LOAD Position]]>
</Comment>
<Comment Operand=".STATUS.STATE[14]">
<![CDATA[Wait for Robot PCB Pick]]>
</Comment>
<Comment Operand=".STATUS.STATE[15]">
<![CDATA[Open PCB Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[16]">
<![CDATA[Wait for Robot Retract]]>
</Comment>
<Comment Operand=".STATUS.STATE[17]">
<![CDATA[PCB Inspection Seq Complete]]>
</Comment>
<Comment Operand=".STATUS.STATE[61]">
<![CDATA[Lockout]]>
</Comment>
<Comment Operand=".STATUS.STATE[62]">
<![CDATA[Cycle Stop]]>
</Comment>
<Comment Operand=".STATUS.STATE[63]">
<![CDATA[Faulted]]>
</Comment>
<Comment Operand=".CONTROL.COUNTER[0]">
<![CDATA[Inspection Retry CTR]]>
</Comment>
<Comment Operand=".CONTROL.OS[0]">
<![CDATA[Used OS]]>
</Comment>
<Comment Operand=".CONTROL.OS[1]">
<![CDATA[Used OS]]>
</Comment>
<Comment Operand=".CONTROL.BIT[0]">
<![CDATA[Initial Conditions Met]]>
</Comment>
<Comment Operand=".CONTROL.BIT[2]">
<![CDATA[Rotate to INSPECT POS]]>
</Comment>
<Comment Operand=".CONTROL.BIT[3]">
<![CDATA[CLOSE PCB Gripper]]>
</Comment>
<Comment Operand=".CONTROL.BIT[4]">
<![CDATA[Solder PCB Loaded]]>
</Comment>
<Comment Operand=".CONTROL.BIT[5]">
<![CDATA[Solder PCB Inspected]]>
</Comment>
<Comment Operand=".CONTROL.BIT[6]">
<![CDATA[Enable Valve Outputs]]>
</Comment>
<Comment Operand=".CONTROL.BIT[7]">
<![CDATA[Inspection Gripper CLOSED]]>
</Comment>
<Comment Operand=".CONTROL.BIT[8]">
<![CDATA[Epoxy PCB Loaded]]>
</Comment>
<Comment Operand=".CONTROL.BIT[9]">
<![CDATA[Epoxy PCB Inspected]]>
</Comment>
<Comment Operand=".CONTROL.BIT[11]">
<![CDATA[Solder Inspect Placed]]>
</Comment>
<Comment Operand=".CONTROL.BIT[12]">
<![CDATA[PCB Inpsect Picked]]>
</Comment>
</Comments>
