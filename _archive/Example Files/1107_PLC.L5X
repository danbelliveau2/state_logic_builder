<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Flux Tank Cover Not Open]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_FluxTankCover_Cyl.Fault_1) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Flux Tank Cover Not Closed]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_FluxTankCover_Cyl.Fault_2) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning - Flux Tank Low]]>
</Comment>
<Text>
<![CDATA[[XIO(Level_1) ,XIO(Level_2) XIO(MachineBasic.AlwaysOn) ]CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_FluxTankCover_Cyl.Confirm_1)OTE(Cover_EXTD);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(FluxPotLevel:I.ProcessDataIn.Switch_1_Output)OTE(Level_1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(FluxPotLevel:I.ProcessDataIn.Switch_2_Output)OTE(Level_2);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(FluxPotLevel:I.ProcessDataIn.Quality_Bit)OTE(LevelQuality_GOOD);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(LevelQuality_GOOD)[XIC(Level_1) [XIC(Level_2) ,XIC(MachineBasic.AlwaysOn) ] MOVE(-20,FluxTank_SM.Control.REAL[1]) ,[XIO(Level_1) ,XIO(Level_2) XIO(MachineBasic.AlwaysOn) ] MOVE(-5,FluxTank_SM.Control.REAL[1]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(LevelQuality_GOOD)MOVE(0,FluxTank_SM.Control.REAL[1]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(FluxTank_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,FluxTank_SM.Control.StateReg) ,XIC(FluxTank_SM.Status.State[62]) MOVE(StoppedState,FluxTank_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(FluxTank_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(FluxTank_SM.Status.State[5]) ,XIC(FluxTank_SM.Status.State[61]) ][XIO(Lockout_FluxTank) XIC(CycleStartLatch) ,[EQ(HMI_Data.Control.DINT_SP[10],3) ,EQ(HMI_Data.Control.DINT_SP[10],14) ] XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[[XIC(INIT) ,XIC(FluxTank_SM.Status.State[10]) XIC(HMI_Data.Status.MachineInSC) XIO(Cover_EXTD) ]MOVE(5,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 7
READY FOR FLUX DIP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(FluxTank_SM.Status.State[4]) ,XIC(FluxTank_SM.Status.State[10]) XIO(HMI_Data.Status.MachineInSC) ]XIC(FluxTank_SM.Control.Bit[0])MOVE(7,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 8
OPEN LID]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(FluxTank_SM.Status.State[7])[XIC(Robot01_Wire_SM.Status.State[27]) ,XIC(Robot01_Wire_SM.Status.State[28]) ,XIC(HMI_Data.Status.MachineInSC) ]XIC(Supervisor_SM.Control.Bit[4])MOVE(8,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR ROBOT SEQ COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(FluxTank_SM.Status.State[8])XIC(Cover_EXTD)MOVE(9,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 10
CLOSE LID]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(FluxTank_SM.Status.State[9])[XIC(Robot01_Wire_SM.Status.State[31]) ,XIC(Robot01_Wire_SM.Status.State[39]) ]XIC(Supervisor_SM.Control.Bit[4])MOVE(10,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(FluxTank_SM.Status.State[5])XIC(Lockout_FluxTank)XIC(CycleStartLatch)MOVE(61,FluxTank_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(FluxTank_SM.Status.State[7]) ,XIC(FluxTank_SM.Status.State[9]) ] [XIC(Robot01_Wire_SM.Status.State[62]) ,XIC(Robot01_Wire_SM.Status.State[63]) ] ,XIC(FluxTank_SM.Status.State[61]) ]XIO(HMI_Data.Status.MachineInSC)XIO(CycleStartLatch)[ONS(FluxTank_SM.Control.OS[1]) MOVE(FluxTank_SM.Control.StateReg,StoppedState) ,MOVE(62,FluxTank_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(FluxTank_SM.Control.OS[0]) MOVE(FluxTank_SM.Control.StateReg,FaultedState) ,MOVE(63,FluxTank_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_FluxTank_SM,FluxTank_SM);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(FluxTank_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(500,FluxTank_SM.Control.TransitionTime)OTE(FluxTank_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(5000,FluxTank_SM.Control.FaultTime)OTE(FluxTank_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[
STATE LOGIC ACTIONS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Control]]>
</Comment>
<Text>
<![CDATA[XIO(Cover_EXTD)[XIC(Level_1) XIC(LevelQuality_GOOD) ,XIC(Bypass_CleverLevelSens) ]OTE(FluxTank_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[[XIO(AUTO) XIC(FluxTank_SM.Control.Bit[3]) XIC(HMI_Data.Control.Button[28]) ,XIC(FluxTank_SM.Status.State[8]) ,XIC(FluxTank_SM.Control.Bit[2]) ][XIO(HMI_Data.Control.Button[29]) ,XIO(FluxTank_SM.Control.Bit[3]) ]XIO(FluxTank_SM.Status.State[4])XIO(FluxTank_SM.Status.State[10])OTE(FluxTank_SM.Control.Bit[2]);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Flux Tank Ready for Dipping]]>
</Comment>
<Text>
<![CDATA[XIC(FluxTank_SM.Status.State[9])XIC(Cover_EXTD)OTE(FluxTank_SM.Control.Bit[4]);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(in_Safety.EStopOK)OTE(FluxTank_SM.Control.Bit[3]);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Map Outputs]]>
</Comment>
<Text>
<![CDATA[AOI_DoubleSOL_Pulse_FB(AOI_FluxTankCover_Cyl,FluxTank_SM.Control.Bit[3],FluxTank_SM.Control.Bit[2],VB_WirePrep:O.ProcessDataOut.Output22,VB_WirePrep:O.ProcessDataOut.Output23,ValveOutput_PulseTime,IOBlock_WirePrep:I.ProcessDataIn.Port_X8B,0)NOP();]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Consumable Cycle Counter]]>
</Comment>
<Text>
<![CDATA[AFI()XIC(FluxTank_SM.Status.State[10])ONS(FluxTank_SM.Control.OS[2])MOVE(HMI_Data.Control.DINT_SP[12],FluxTank_SM.Control.Counter[0].PRE)CTU(FluxTank_SM.Control.Counter[0],?,?);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[AFI()XIC(HMI_Data.MOMButtons[25])RES(FluxTank_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="HeatShrink" TestEdits="false" MainRoutineName="StateLogic" Disabled="false" Class="Standard" UseAsFolder="false">
<Tags>
<Tag Name="Alarm" TagType="Base" DataType="AlarmData" Dimensions="15" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Data Format="L5K">
<![CDATA[[[8,0,0,[38,'Heat Shrink Station: Spool VFD Faulted$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[1491533836,409806,238396,0,0,0,0,0,0],1,6229,0],[8,1,0,[51,'Heat Shrink Station: Initialization - Timeout Fault$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
