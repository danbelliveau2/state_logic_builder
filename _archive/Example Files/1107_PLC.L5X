<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Vision System Not In RUN Mode]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout_Vision)XIO(c01VisionCtrl_IN.Data[3].3)CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Warning - Error 0 Active]]>
</Comment>
<Text>
<![CDATA[XIC(c01VisionCtrl_IN.Data[3].1)CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[[XIC(Warning[0].Active) ,XIC(c01VisionCtrl_OUT.Data[0].4) ] XIC(FaultReset) ,XIC(AutoReset) ]OTE(c01VisionCtrl_OUT.Data[0].4);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[COP(c01VisionCtrl_IN.Data[8],Error_0_Code,2);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Warning[0].Active)ONS(Vision_SM.Control.OS[8])COP(ERR0_Arch[0],ERROR_ArchTEMP[1],9)COP(ERROR_ArchTEMP[1],ERR0_Arch[1],9)MOVE(Error_0_Code,ERR0_Arch[0]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Warning - Error 0 Active]]>
</Comment>
<Text>
<![CDATA[XIC(c01VisionCtrl_IN.Data[3].2)CONCAT(StationName,WarningText[1],Warning[1].Message)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[[XIC(Warning[1].Active) ,XIC(c01VisionCtrl_OUT.Data[0].5) ] XIC(FaultReset) ,XIC(AutoReset) ]OTE(c01VisionCtrl_OUT.Data[0].5);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[COP(c01VisionCtrl_IN.Data[10],Error_1_Code,2);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Warning[1].Active)ONS(Vision_SM.Control.OS[9])COP(ERR1_Arch[0],ERROR_ArchTEMP[1],9)COP(ERROR_ArchTEMP[1],ERR1_Arch[1],9)MOVE(Error_1_Code,ERR1_Arch[0]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Errors - Auto Reset]]>
</Comment>
<Text>
<![CDATA[[XIC(Warning[0].Active) ,XIC(Warning[1].Active) ]XIO(FaultReset)TON(Vision_SM.Control.Timer[0],?,?)XIC(Vision_SM.Control.Timer[0].DN)OTE(AutoReset);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Warning - Error 0 Active]]>
</Comment>
<Text>
<![CDATA[XIO(Vision_SM.Status.AutoPreOK)XIO(MachineRunning)XIO(Alarm[0].Active)XIO(Warning[0].Active)XIO(Warning[1].Active)CONCAT(StationName,WarningText[2],Warning[2].Message)OTE(Warning[2].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="RawDataST" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[for i := 120 to 492 by 4 do]]>
</Line>
<Line Number="4">
<![CDATA[	COP(c01VisionCtrl_IN.Data[i],RawData[(i-120)/4],2);]]>
</Line>
<Line Number="5">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INSTRUCTIONS
Press CTRL+H: Replace all 'Vision' with desired name.
Then, this rung can be deleted.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Save Faulted State]]>
</Comment>
<Text>
<![CDATA[XIC(AlarmActive)XIO(Vision_SM.Status.State[0])XIO(Vision_SM.Status.State[63])ONS(Vision_SM.Control.OS[0])MOVE(Vision_SM.Control.StateReg,FaultedState);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Save State at Cycle Stop]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIO(CycleStartLatch)XIO(Vision_SM.Status.State[62])XIO(Vision_SM.Status.State[63])ONS(Vision_SM.Control.OS[1])MOVE(Vision_SM.Control.StateReg,StoppedState);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(Vision_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,Vision_SM.Control.StateReg) ,XIC(Vision_SM.Status.State[62]) MOVE(StoppedState,Vision_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[6])OTE(STOPPED);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(Vision_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Vision_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,Vision_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(MAN)MOVE(3,Vision_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Vision_SM.Status.State[5]) ,XIC(Vision_SM.Status.State[61]) ]XIO(Lockout_Vision)XIC(CycleStartLatch)MOVE(4,Vision_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,Vision_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 6 - unused
]]>
</Comment>
<Text>
<![CDATA[XIO(MachineBasic.AlwaysOn)MOVE(6,Vision_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 7 - WAIT FOR CAMERA TRIGGER]]>
</Comment>
<Text>
<![CDATA[[XIC(Vision_SM.Status.State[4]) ,XIC(Vision_SM.Status.State[14]) ,XIC(Vision_SM.Status.State[24]) ,XIC(Vision_SM.Status.State[34]) ,XIC(Vision_SM.Status.State[44]) ,XIC(Vision_SM.Status.State[54]) ]XIC(Vision_SM.Status.TransitionTimerDone)MOVE(7,Vision_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[*****
STATE 10 - TRIGGER CAMERA 3
BARE WIRE INSPECTION
*****]]>
</Comment>
<Text>
