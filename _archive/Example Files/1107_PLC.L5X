<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIC(RobotStatus.Fault)CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Timeout Fault

Means the robot was waiting too long for a signal
 or action from one of the stations]]>
</Comment>
<Text>
<![CDATA[[XIC(RobotStatus.UserIn4.5) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Part in Robot Gripper but No PCB ID]]>
</Comment>
<Text>
<![CDATA[[XIC(PART_inGripper) EQ(ID,0) TON(Robot02_PCB_SM.Control.Timer[12],?,?) XIC(Robot02_PCB_SM.Control.Timer[12].DN) ONS(Robot02_PCB_SM.Control.OS[22]) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Both Regrip Sensors ON]]>
</Comment>
<Text>
<![CDATA[[XIC(RobotStatus.UserIn3.4) ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning - Robot is finishing a move, cycle stop inhibited]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(Robot02_PCB_SM.Status.State[5])XIO(Robot02_PCB_SM.Status.State[61])XIO(Robot02_PCB_SM.Status.State[62])XIO(Robot02_PCB_SM.Status.State[63])XIO(CycleStartLatch)CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(DIN1_15_EpoxyDisp_CycDone)OTE(EpoxyDispCycle_DONE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(IOBlock_Soldering:I.ProcessDataIn.Port_X8A)OTE(Rack_PRESENT);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(IOBlock_Soldering:I.ProcessDataIn.Port_X8B)OTE(Rack_PCBsPresent);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CPS(r02Robot_PCBHandling:I2.Input[0],EDA.in,212);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(Robot02_PCB_SM.Status.State[63]) XIO(AlarmActive) MOVE(4,Robot02_PCB_SM.Control.StateReg) ,XIC(Robot02_PCB_SM.Status.State[62]) MOVE(StoppedState,Robot02_PCB_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[6])OTE(STOPPED);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Robot02_PCB_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Robot02_PCB_SM.Status.State[5]) ,XIC(Robot02_PCB_SM.Status.State[61]) ][XIO(Lockout_Robot02_PCB) XIC(CycleStartLatch) ,EQ(HMI_Data.Control.DINT_SP[10],12) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 6
START ROBOT PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot02_PCB_SM.Status.State[4])MOVE(6,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 7
ROBOT RUNNING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Robot02_PCB_SM.Status.State[4]) ,XIC(Robot02_PCB_SM.Status.State[6]) ]XIC(RobotStatus.Running)MOVE(7,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 8
START 20 RECOVERY PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot02_PCB_SM.Status.State[7])EQ(EDA.in.R60,0)XIC(RobotStatus.UserIn1.0)MOVE(8,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR 20 RECOVERY COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot02_PCB_SM.Status.State[8])EQ(EDA.in.R60,20)XIO(RobotStatus.UserIn1.0)MOVE(9,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 10
ROBOT READY]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot02_PCB_SM.Status.State[9])EQ(EDA.in.R60,0)XIC(RobotStatus.UserIn1.0)MOVE(10,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 11
unused]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)AFI()XIC(Robot02_PCB_SM.Status.State[7])EQ(EDA.in.R60,18)XIO(RobotStatus.UserIn1.0)MOVE(11,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[DDDDD          STATE 12          DDDDD
START 13,15,17 PICK CURE PROGRAM
(Open drawer first in State[12] before actually calling program)]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(CycleStartLatch)[XIC(Robot02_PCB_SM.Status.State[10]) XIO(PART_inGripper) [XIC(PCBGripper.WaitingSolder) ,XIO(Infeed_SM.Status.State[7]) ] XIO(PCBGripper.WaitingInspectSldr) XIO(PCBGripper.WaitingInspectEpxy) ,[XIC(Robot02_PCB_SM.Status.State[43]) ,[XIC(Robot02_PCB_SM.Status.State[21]) ,XIC(Robot02_PCB_SM.Status.State[23]) ] XIO(PCBGripper.WaitingSolder) XIO(PCBGripper.WaitingInspectSldr) XIO(PCBGripper.WaitingInspectEpxy) ] EQ(EDA.in.R60,0) XIC(RobotStatus.UserIn1.0) ]XIC(Robot02_PCB_SM.Control.Bit[12])[XIO(CurePLACE_Available) ,XIC(CLEANOUT) ,XIO(Infeed_SM.Status.State[7]) ]XIC(CurePICK_Available)XIC(Debug_Robot02_S12)MOVE(12,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 13
WAIT FOR 13,15,17 PICK CURE COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot02_PCB_SM.Status.State[12])[EQ(EDA.in.R60,13) ,EQ(EDA.in.R60,15) ,EQ(EDA.in.R60,17) ]XIO(RobotStatus.UserIn1.0)MOVE(13,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 14
START 9 PLACE CAM - EPOXY PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(CycleStartLatch)[XIC(Robot02_PCB_SM.Status.State[13]) EQ(EDA.in.R60,0) XIC(RobotStatus.UserIn1.0) ,XIC(Robot02_PCB_SM.Status.State[10]) XIC(PCBGripper.CuredPCB) ]XIC(PCB_Inspection_SM.Status.State[7])XIC(\Tracking.PCB_GOOD)XIC(Debug_Robot02_S14)MOVE(14,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 15
WAIT FOR 9 PLACE CAM - EPOXY COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot02_PCB_SM.Status.State[14])EQ(EDA.in.R60,9)XIO(RobotStatus.UserIn1.0)MOVE(15,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 16
unused]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)AFI()XIC(Robot02_PCB_SM.Status.State[15])MOVE(16,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE 17
WAIT FOR EPOXY INSPECTION COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Robot02_PCB_SM.Status.State[15]) EQ(EDA.in.R60,0) XIC(RobotStatus.UserIn1.0) ,XIC(Robot02_PCB_SM.Status.State[10]) XIC(Robot02_PCB_SM.Control.Bit[12]) XIC(PCBGripper.WaitingInspectEpxy) ]MOVE(17,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[STATE 18
START 10 PICK CAM - EPOXY PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(CycleStartLatch)XIC(Robot02_PCB_SM.Status.State[17])XIC(PCB_Inspection_SM.Status.State[14])XIC(Debug_Robot02_S18)MOVE(18,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[STATE 19
WAIT FOR 10 PICK CAM - EPOXY COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot02_PCB_SM.Status.State[18])EQ(EDA.in.R60,10)XIO(RobotStatus.UserIn1.0)MOVE(19,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[STATE 20
START 18 PLACE DIAL PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(CycleStartLatch)[XIC(Robot02_PCB_SM.Status.State[19]) EQ(EDA.in.R60,0) XIC(RobotStatus.UserIn1.0) ,XIC(Robot02_PCB_SM.Status.State[10]) XIC(PCBGripper.EpxyInspectedPCB) ]XIC(Outfeed_SM.Status.State[7])XIO(Robot02_PCB_SM.Control.Bit[9])XIC(\Tracking.PCB_GOOD)XIC(Debug_Robot02_S20)MOVE(20,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[STATE 21
WAIT FOR 18 PLACE DIAL COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot02_PCB_SM.Status.State[20])EQ(EDA.in.R60,18)XIO(RobotStatus.UserIn1.0)MOVE(21,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[STATE 22
START 19 PLACE REJECT PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(CycleStartLatch)[[XIC(Robot02_PCB_SM.Status.State[13]) ,XIC(Robot02_PCB_SM.Status.State[19]) ,XIC(Robot02_PCB_SM.Status.State[27]) XIC(in_PCBData[ID].Present_PASS) ,XIC(Robot02_PCB_SM.Status.State[31]) ,XIC(Robot02_PCB_SM.Status.State[33]) ,XIC(Robot02_PCB_SM.Status.State[39]) ,XIC(Robot02_PCB_SM.Status.State[41]) ] EQ(EDA.in.R60,0) XIC(RobotStatus.UserIn1.0) ,XIC(Robot02_PCB_SM.Status.State[10]) XIC(Supervisor_SM.Control.Bit[8]) XIC(PART_inGripper) ]XIC(\Tracking.PCB_REJECT)XIO(Robot02_PCB_SM.Control.Bit[10])XIC(Debug_Robot02_S22)MOVE(22,Robot02_PCB_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[STATE 23
WAIT FOR 19 PLACE REJECT COMPLETE]]>
