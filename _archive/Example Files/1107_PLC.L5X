</Member>
<Member Name="Virtual" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="bCmd" BitNumber="1" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 = Operate as Virtual Device.]]>
</Description>
</Member>
<Member Name="ResetWarn" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="bCmd" BitNumber="2" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 = Reset device warning.]]>
</Description>
</Member>
<Member Name="ResetFault" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="bCmd" BitNumber="3" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 = Reset device trip or fault.]]>
</Description>
</Member>
<Member Name="Activate" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="bCmd" BitNumber="4" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 = Activate Output Power Structure.]]>
</Description>
</Member>
<Member Name="Deactivate" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="bCmd" BitNumber="5" ExternalAccess="Read/Write">
<Description>
<![CDATA[1 = DeActivate Output Power Structure.]]>
</Description>
