<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Rotary Table Cylinder]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_RotaryTable_Cyl.Fault_1) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(AOI_RotaryTable_Cyl.Fault_2) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Faults]]>
</Comment>
<Text>
<![CDATA[[AFI() ,XIC(Alarm[2].Active) XIO(FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning]]>
</Comment>
<Text>
<![CDATA[AFI()OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_RotaryTable_Cyl.Confirm_1)OTE(INSPECT_POS);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AOI_RotaryTable_Cyl.Confirm_2)OTE(LOAD_POS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AOI_PCBGripper.Confirm_1)OTE(PCB_Gripper_CLSD);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AOI_PCBGripper.Confirm_2)OTE(PCB_Gripper_OPEN);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(PCB_Inspection_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,PCB_Inspection_SM.Control.StateReg) ,XIC(PCB_Inspection_SM.Status.State[62]) MOVE(StoppedState,PCB_Inspection_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(PCB_Inspection_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Inspection_SM.Status.State[5]) ,XIC(PCB_Inspection_SM.Status.State[61]) ][XIO(Lockout_PCB_Inspection) XIC(CycleStartLatch) ,EQ(HMI_Data.Control.DINT_SP[10],5) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 6
]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(6,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 7
READY TO RECEIVE PCB]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Inspection_SM.Status.State[4]) ,XIC(PCB_Inspection_SM.Status.State[17]) ]XIC(PCB_Inspection_SM.Control.Bit[0])MOVE(7,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 8
CLOSE PCB GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Inspection_SM.Status.State[7]) XIC(PCB_Inspection_SM.Control.Bit[11]) ,XIC(PCB_Inspection_SM.Status.State[4]) [XIC(PCB_Inspection_SM.Control.Bit[4]) XIO(PCB_Inspection_SM.Control.Bit[5]) ,XIC(PCB_Inspection_SM.Control.Bit[8]) XIO(PCB_Inspection_SM.Control.Bit[9]) ] ]MOVE(8,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR ROBOT RETRACTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Inspection_SM.Status.State[8])XIC(PCB_Gripper_CLSD)MOVE(9,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 10
MOVE TO INSPECT POSITION]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Inspection_SM.Status.State[9])XIO(Robot02_PCB_SM.Control.Bit[28])RES(PCB_Inspection_SM.Control.Counter[0])MOVE(10,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 11
TRIGGER 3D CAMERA]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Inspection_SM.Status.State[10]) XIC(INSPECT_POS) ,XIC(PCB_Inspection_SM.Status.State[12]) [XIC(PCB_Inspection_SM.Control.Bit[4]) XIO(in_PCBData[Camera_ID].SolderInspect_PASS) ,XIC(PCB_Inspection_SM.Control.Bit[8]) XIO(in_PCBData[Camera_ID].EpoxyInspect_PASS) ] XIO(PCB_Inspection_SM.Control.Counter[0].DN) ][XIC(Vision_SM.Status.State[7]) XIC(Vision_SM.Control.Bit[4]) ,XIC(Lockout_Vision) ]XIO(Robot01_Wire_SM.Control.Bit[14])XIO(Robot01_Wire_SM.Control.Bit[15])MOVE(11,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 12
WAIT FOR INSPECTION COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Inspection_SM.Status.State[11])XIO(Vision_SM.Status.State[7])MOVE(12,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 13
MOVE TO LOAD POSITION]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Inspection_SM.Status.State[12]) [XIC(Vision_SM.Status.State[7]) XIC(Vision_SM.Control.Bit[4]) ,XIC(Lockout_Vision) ] [XIC(Vision_SM.Control.Bit[2]) XIC(in_PCBData[Camera_ID].SolderInspect_PASS) ,XIC(Vision_SM.Control.Bit[3]) XIC(in_PCBData[Camera_ID].EpoxyInspect_PASS) ,XIC(PCB_Inspection_SM.Control.Counter[0].DN) ] ,XIC(PCB_Inspection_SM.Status.State[4]) [XIC(PCB_Inspection_SM.Control.Bit[4]) XIC(PCB_Inspection_SM.Control.Bit[5]) ,XIC(PCB_Inspection_SM.Control.Bit[8]) XIC(PCB_Inspection_SM.Control.Bit[9]) ,XIO(PCB_Inspection_SM.Control.Bit[4]) XIO(PCB_Inspection_SM.Control.Bit[8]) ] ]MOVE(13,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 14
WAIT FOR ROBOT PCB PICK]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Inspection_SM.Status.State[13])XIC(LOAD_POS)MOVE(14,PCB_Inspection_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 15
OPEN PCB GRIPPER]]>
</Comment>
<Text>
