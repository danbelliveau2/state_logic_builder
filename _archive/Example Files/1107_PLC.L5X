<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Misc. Logic]]>
</Comment>
<Text>
<![CDATA[EQ(SupervisorState,3)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[[DIV(Ref_Ctrl_Sts.ActualPosition,PosScaling,HMI_ServoData.Status.ActualPosition) ,DIV(Ref_Ctrl_Sts.ActualVelocity,VelScaling,HMI_ServoData.Status.ActualVelocity) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Control]]>
</Comment>
<Text>
<![CDATA[[MUL(HMI_ServoData.Control.Accel,VelScaling,Accel) ,MUL(HMI_ServoData.Control.Decel,VelScaling,Decel) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyStatus)XIC(Ref_Ctrl_Sts.Ready)TON(AutoEnable_TMR,?,?)XIC(AutoEnable_TMR.DN)ONS(AutoEnable_ONS)OTE(Axis_AutoEnable);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(ManualMode) XIC(HMI_ServoData.Control.Enable) XIC(Ref_Ctrl_Sts.Ready) ,XIC(Axis_AutoEnable) ]XIO(Ref_Ctrl_Sts.Active)raC_Opr_K5100_MSO(Axis_MSO,Ref_Ctrl_Set,Ref_Ctrl_Cmd,Ref_Ctrl_Sts);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Ref_Ctrl_Sts.Ready)XIC(Ref_Ctrl_Sts.Active)OTE(HMI_ServoData.Status.MotionEnable);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(HMI_ServoData.Control.Disable)XIC(Ref_Ctrl_Sts.Active)raC_Opr_K5100_MSF(Axis_MSF,Ref_Ctrl_Set,Ref_Ctrl_Cmd,Ref_Ctrl_Sts);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Home Axis]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(HomeOK)[XIC(HMI_ServoData.Control.HomeRequest) ,XIC(HMI_ServoData.Status.HomeRequested) ]XIC(Ref_Ctrl_Sts.Ready)XIO(HomeRequest_TMR.DN)OTE(HMI_ServoData.Status.HomeRequested);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(HMI_ServoData.Status.HomeRequested)[TON(HomeRequest_TMR,?,?) ,XIC(HMI_ServoData.Control.HomeConfirm) raC_Opr_K5100_MAH(Axis_MAH,Ref_Ctrl_Cfg,Ref_Ctrl_Set,Ref_Ctrl_Cmd,Ref_Ctrl_Sts,HomeMethod,HomePosRef,HomeSpeedStart,HomeSpeedFinish,Accel,Decel) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Axis_MAH.Sts_IP) OTE(HMI_ServoData.Status.HomeIP) ,XIC(Axis_MAH.Sts_PC) OTE(HMI_ServoData.Status.HomePC) ,XIC(Axis_MAH.Sts_ER) OTE(HMI_ServoData.Status.HomeError) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(Ref_Ctrl_Sts.Faulted)[XIC(FaultReset) ,XIC(SafetyResetTimer.TT) LIMIT(250,SafetyResetTimer.ACC,500) ]raC_Opr_K5100_MAFR(Axis_MAFR,Ref_Ctrl_Set,Ref_Ctrl_Cmd,Ref_Ctrl_Sts);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(SafetyStatus)MOVE(500,SafetyResetTimer.PRE)TON(SafetyResetTimer,?,?);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Jog]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(Ref_Ctrl_Sts.Active)[XIC(HMI_ServoData.Control.JogPositive) XIO(HMI_ServoData.Control.JogNegative) MUL(HMI_ServoData.Control.JogSpeed,VelScaling,JogSpeed) ,XIC(HMI_ServoData.Control.JogNegative) XIO(HMI_ServoData.Control.JogPositive) CPT(JogSpeed,HMI_ServoData.Control.JogSpeed*VelScaling*-1) ]raC_Opr_K5100_MAJ(Axis_MAJ,Ref_Ctrl_Cfg,Ref_Ctrl_Set,Ref_Ctrl_Cmd,Ref_Ctrl_Sts,JogSpeed,Accel,Decel);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(Axis_MAJ.Sts_IP) XIO(HMI_ServoData.Control.JogPositive) XIO(HMI_ServoData.Control.JogNegative) ,XIO(SafetyStatus) ]raC_Opr_K5100_MAS(Axis_MAS,Ref_Ctrl_Cfg,Ref_Ctrl_Set,Ref_Ctrl_Cmd,Ref_Ctrl_Sts,Decel);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Inch Move]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(Ref_Ctrl_Sts.Active)[XIC(HMI_ServoData.Control.InchPos) MUL(HMI_ServoData.Control.InchAmount,PosScaling,InchAmount) ,XIC(HMI_ServoData.Control.InchNeg) CPT(InchAmount,HMI_ServoData.Control.InchAmount*PosScaling*-1) ]MUL(HMI_ServoData.Control.ManualSpeed,VelScaling,ManSpeed)raC_Opr_K5100_MAM(Axis_MAM,Ref_Ctrl_Cfg,Ref_Ctrl_Set,Ref_Ctrl_Cmd,Ref_Ctrl_Sts,InchAmount,ManSpeed,Accel,Decel,1,0,0,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
