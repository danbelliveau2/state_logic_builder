</Comment>
<Text>
<![CDATA[XIC(SaveResults_C4A_PLS)[DIV(RawData[35],1000,TipLoc_X) DIV(RawData[36],1000,TipLoc_Y) ,DIV(RawData[37],1000,EdgeAngle) DIV(RawData[38],1000,WireEdge_X) DIV(RawData[39],1000,WireEdge_Y) ,DIV(RawData[40],1000,WireFinalLoc_X) ,EQ(RawData[41],1) OTL(WireFinalPresent_NOK) ,EQ(RawData[42],1) OTL(TipPresent_NOK) ];]]>
</Text>
</Rung>
<Rung Number="88" Type="N">
<Text>
<![CDATA[MOVE(HMI_Data.Control.REAL_SP[12],WireRad)CPT(WireEdge_Xc,WireEdge_X+(WireRad)*COS((90-EdgeAngle)*3.14159265/180))CPT(WireEdge_Yc,WireEdge_Y-(WireRad)*SIN((90-EdgeAngle)*3.14159265/180))CPT(a,TipLoc_X-WireEdge_Xc)CPT(b,TipLoc_Y-WireEdge_Yc)CPT(WireAngle,-ATAN(a/b)*180/3.14159265);]]>
</Text>
</Rung>
