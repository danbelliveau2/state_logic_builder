<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Brush Transfer Cylinder]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_BrushTransfer_Cyl.Fault_1) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(AOI_BrushTransfer_Cyl.Fault_2) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Spraying Too Long]]>
</Comment>
<Text>
<![CDATA[[XIC(PCB_Clean_SM.Control.Timer[0].DN) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Cleaning Fluid Level Low Alarm]]>
</Comment>
<Text>
<![CDATA[[XIO(Robot02_PCB_SM.Status.State[32]) XIO(Robot02_PCB_SM.Status.State[33]) LE(CleaningFluid_LEVEL,2) TON(PCB_Clean_SM.Control.Timer[7],?,?) XIC(PCB_Clean_SM.Control.Timer[7].DN) ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning: Cleaning Fluid Level is Low]]>
</Comment>
<Text>
<![CDATA[[XIC(PCB_Clean_SM.Control.Counter[1].DN) ,LE(CleaningFluid_LEVEL,HMI_Data.Control.DINT_SP[18]) ]CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_BrushTransfer_Cyl.Confirm_1)OTE(Brush_Transfer_ENGD);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AOI_BrushTransfer_Cyl.Confirm_2)OTE(Brush_Transfer_DISENGD);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(FluxOffLevel:I.ProcessDataIn.Level,CleaningFluid_LEVEL);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[RESTART
(Always reset and restart the process from the beginning)]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(PCB_Clean_SM.Status.State[63]) XIO(AlarmActive) MOVE(4,PCB_Clean_SM.Control.StateReg) ,XIC(PCB_Clean_SM.Status.State[62]) MOVE(4,PCB_Clean_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(PCB_Clean_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(MAN)MOVE(3,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Clean_SM.Status.State[5]) ,XIC(PCB_Clean_SM.Status.State[61]) ]XIO(Lockout_PCB_Clean)XIC(CycleStartLatch)MOVE(4,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 6
ENGAGE BRUSH TRANSFER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Clean_SM.Status.State[4]) ,XIC(PCB_Clean_SM.Status.State[14]) XIO(Robot02_PCB_SM.Control.Bit[27]) ]MOVE(6,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 7
READY FOR CLEANING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Clean_SM.Status.State[4]) ,XIC(PCB_Clean_SM.Status.State[6]) ]XIC(Brush_Transfer_ENGD)MOVE(7,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 8
SPRAY FLUID FOR BRUSHING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Clean_SM.Status.State[7])XIC(Robot02_PCB_SM.Control.Bit[21])MOVE(8,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR ROBOT BRUSH SEQUENCE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Clean_SM.Status.State[8])XIC(PCB_Clean_SM.Status.TransitionTimerDone)MOVE(9,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 10
DISENGAGE BRUSH TRANSFER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Clean_SM.Status.State[9])XIC(Robot02_PCB_SM.Control.Bit[20])MOVE(10,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 11
SPRAY FLUID ONLY FOR RINSING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Clean_SM.Status.State[20])EQ(Pointer,1)MOVE(11,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 12
SPRAY FLUID AND AIR FOR RINSING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Clean_SM.Status.State[20])EQ(Pointer,2)MOVE(12,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 13
SPRAY AIR FOR DRYING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Clean_SM.Status.State[20])EQ(Pointer,3)MOVE(13,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 14
WAIT FOR ROBOT RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Clean_SM.Status.State[20])[EQ(Pointer,0) ,XIC(PCB_Clean_SM.Control.Counter[0].DN) ]MOVE(14,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 20
SET POINTER AND TRANSITION TIME]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Clean_SM.Status.State[10]) XIC(Brush_Transfer_DISENGD) ,[XIC(PCB_Clean_SM.Status.State[11]) ,XIC(PCB_Clean_SM.Status.State[12]) ,XIC(PCB_Clean_SM.Status.State[13]) ] XIC(PCB_Clean_SM.Status.TransitionTimerDone) ]MOVE(20,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Clean_SM.Status.State[5])XIC(Lockout_PCB_Clean)XIC(CycleStartLatch)MOVE(61,PCB_Clean_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(PCB_Clean_SM.Status.State[7]) ,XIC(PCB_Clean_SM.Status.State[9]) ,XIC(PCB_Clean_SM.Status.State[10]) ,XIC(PCB_Clean_SM.Status.State[14]) ] [XIC(Robot02_PCB_SM.Status.State[62]) ,XIC(Robot02_PCB_SM.Status.State[63]) ] ,XIC(PCB_Clean_SM.Status.State[61]) ]XIO(CycleStartLatch)[ONS(PCB_Clean_SM.Control.OS[1]) MOVE(PCB_Clean_SM.Control.StateReg,StoppedState) ,MOVE(62,PCB_Clean_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(PCB_Clean_SM.Control.OS[0]) MOVE(PCB_Clean_SM.Control.StateReg,FaultedState) ,MOVE(63,PCB_Clean_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_PCB_Clean_SM,PCB_Clean_SM);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(PCB_Clean_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Clean_SM.Status.State[8]) MOVE(PCB_Clean_SM.Control.DINT[0],PCB_Clean_SM.Control.TransitionTime) ,XIC(PCB_Clean_SM.Status.State[10]) MOVE(PCB_Clean_SM.Control.DINT[1],PCB_Clean_SM.Control.TransitionTime) ,XIC(PCB_Clean_SM.Status.State[11]) ,XIC(PCB_Clean_SM.Status.State[12]) ,XIC(PCB_Clean_SM.Status.State[13]) ]OTE(PCB_Clean_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(5000,PCB_Clean_SM.Control.FaultTime)OTE(PCB_Clean_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[
STATE LOGIC ACTIONS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[POINTER CONTROL]]>
</Comment>
<Text>
<![CDATA[XIC(PCB_Clean_SM.Status.State[20])[CTU(PCB_Clean_SM.Control.Counter[0],?,?) ,MOVE(PCB_Clean_SM.Control.Counter[0].ACC,i) ,MOVE(Process[i,0],Pointer) MOVE(Process[i,1],PCB_Clean_SM.Control.TransitionTime) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(PCB_Clean_SM.Status.State[10])RES(PCB_Clean_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[Control]]>
</Comment>
<Text>
<![CDATA[XIO(MachineBasic.AlwaysOn)OTE(PCB_Clean_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[[XIC(MAN) XIC(HMI_Data.MOMButtons[13]) ,XIC(PCB_Clean_SM.Status.State[8]) ,XIC(PCB_Clean_SM.Status.State[11]) ,XIC(PCB_Clean_SM.Status.State[12]) ]OTE(PCB_Clean_SM.Control.Bit[2]);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[[XIC(MAN) XIC(HMI_Data.Control.Button[48]) ,XIC(OPEN_AirJetValve_MANUAL) ]XIO(HMI_Data.Control.Button[49])XIO(PCB_Clean_SM.Status.State[4])XIO(PCB_Clean_SM.Status.State[63])OTE(OPEN_AirJetValve_MANUAL);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[[XIC(OPEN_AirJetValve_MANUAL) ,XIC(PCB_Clean_SM.Status.State[12]) ,XIC(PCB_Clean_SM.Status.State[13]) ]OTE(PCB_Clean_SM.Control.Bit[3]);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[[XIC(MAN) XIC(HMI_Data.Control.Button[50]) ,XIC(PCB_Clean_SM.Status.State[6]) ,XIC(PCB_Clean_SM.Control.Bit[4]) ]XIO(HMI_Data.Control.Button[51])XIO(PCB_Clean_SM.Status.State[10])OTE(PCB_Clean_SM.Control.Bit[4]);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIC(Brush_Transfer_DISENGD)OTE(PCB_Clean_SM.Control.Bit[5]);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[XIC(in_Safety.EStopOK)OTE(PCB_Clean_SM.Control.Bit[6]);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[Map Outputs]]>
</Comment>
<Text>
<![CDATA[XIC(PCB_Clean_SM.Control.Bit[2])XIC(PCB_Clean_SM.Control.Bit[6])XIO(FaultReset)TON(PCB_Clean_SM.Control.Timer[0],?,?)XIO(PCB_Clean_SM.Control.Timer[0].DN)OTE(VB_Cleaning:O.ProcessDataOut.Output2);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[XIC(PCB_Clean_SM.Control.Bit[3])XIC(PCB_Clean_SM.Control.Bit[6])OTE(VB_Cleaning:O.ProcessDataOut.Output0);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[AOI_DoubleSOL_Pulse_FB(AOI_BrushTransfer_Cyl,PCB_Clean_SM.Control.Bit[6],PCB_Clean_SM.Control.Bit[4],VB_Solder_Epoxy:O.ProcessDataOut.Output1,VB_Solder_Epoxy:O.ProcessDataOut.Output0,ValveOutput_PulseTime,0,IOBlock_Soldering:I.ProcessDataIn.Port_X1A);]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Comment>
<![CDATA[Consumable Cycle Counter]]>
</Comment>
<Text>
<![CDATA[AFI()XIC(PCB_Clean_SM.Status.State[14])ONS(PCB_Clean_SM.Control.OS[8])MOVE(HMI_Data.Control.DINT_SP[16],PCB_Clean_SM.Control.Counter[1].PRE)CTU(PCB_Clean_SM.Control.Counter[1],?,?);]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.MOMButtons[29])RES(PCB_Clean_SM.Control.Counter[1]);]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
