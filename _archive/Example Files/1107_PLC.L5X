<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(Outfeed_SM.Control.OS[0]) MOVE(Outfeed_SM.Control.StateReg,FaultedState) ,MOVE(63,Outfeed_SM.Control.StateReg) ];]]>
