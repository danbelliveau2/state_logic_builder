<Text>
<![CDATA[XIC(AUTO)[[XIC(Outfeed_SM.Status.State[7]) ,XIC(Outfeed_SM.Status.State[8]) ] [XIC(Robot02_PCB_SM.Status.State[62]) ,XIC(Robot02_PCB_SM.Status.State[63]) ] ,XIC(Outfeed_SM.Status.State[61]) ]XIO(CycleStartLatch)[ONS(Outfeed_SM.Control.OS[1]) MOVE(Outfeed_SM.Control.StateReg,StoppedState) ,MOVE(62,Outfeed_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
