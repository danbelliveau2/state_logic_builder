<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(Epoxy_Dispense_SM.Status.State[9]) XIC(Epoxy_Dispense_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[1].Active) XIO(FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[2].Active) XIO(FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning]]>
</Comment>
<Text>
<![CDATA[AFI()OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INSTRUCTIONS
Press CTRL+H: Replace all 'Epoxy_Dispense' with desired name.
Then, this rung can be deleted.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(DIN1_15_EpoxyDisp_CycDone)OTE(Cycle_DONE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(Epoxy_Dispense_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,Epoxy_Dispense_SM.Control.StateReg) ,XIC(Epoxy_Dispense_SM.Status.State[62]) MOVE(StoppedState,Epoxy_Dispense_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Epoxy_Dispense_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(MAN)MOVE(3,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Epoxy_Dispense_SM.Status.State[5]) ,XIC(Epoxy_Dispense_SM.Status.State[61]) ]XIO(Lockout_Epoxy_Dispense)XIC(CycleStartLatch)MOVE(4,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 6
]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(6,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 7
READY TO DISPENSE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Epoxy_Dispense_SM.Status.State[4]) ,XIC(Epoxy_Dispense_SM.Status.State[10]) XIO(Robot02_PCB_SM.Status.State[41]) ]MOVE(7,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 8
START EPOXY DISPENSE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Epoxy_Dispense_SM.Status.State[7])XIC(Robot02_PCB_SM.Control.Bit[22])MOVE(8,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR DISPENSE COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Epoxy_Dispense_SM.Status.State[8])XIC(Epoxy_Dispense_SM.Status.TransitionTimerDone)MOVE(9,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 10
EPOXY DISPENSE COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Epoxy_Dispense_SM.Status.State[9])[XIC(Cycle_DONE) ,XIC(Epoxy_Dispense_SM.Status.TransitionTimerDone) ]MOVE(10,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Epoxy_Dispense_SM.Status.State[5])XIC(Lockout_Epoxy_Dispense)XIC(CycleStartLatch)MOVE(61,Epoxy_Dispense_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Epoxy_Dispense_SM.Status.State[7]) [XIC(Robot02_PCB_SM.Status.State[62]) ,XIC(Robot02_PCB_SM.Status.State[63]) ] ,XIC(Epoxy_Dispense_SM.Status.State[61]) ]XIO(CycleStartLatch)[ONS(Epoxy_Dispense_SM.Control.OS[1]) MOVE(Epoxy_Dispense_SM.Control.StateReg,StoppedState) ,MOVE(62,Epoxy_Dispense_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(Epoxy_Dispense_SM.Control.OS[0]) MOVE(Epoxy_Dispense_SM.Control.StateReg,FaultedState) ,MOVE(63,Epoxy_Dispense_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_Epoxy_Dispense_SM,Epoxy_Dispense_SM);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(Epoxy_Dispense_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Epoxy_Dispense_SM.Status.State[8]) MOVE(0500,Epoxy_Dispense_SM.Control.TransitionTime) ,XIC(Epoxy_Dispense_SM.Status.State[9]) MOVE(3000,Epoxy_Dispense_SM.Control.TransitionTime) ]OTE(Epoxy_Dispense_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Epoxy_Dispense_SM.Status.State[9])MOVE(5000,Epoxy_Dispense_SM.Control.FaultTime)OTE(Epoxy_Dispense_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[
STATE LOGIC ACTIONS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Control]]>
</Comment>
<Text>
<![CDATA[XIO(MachineBasic.AlwaysOn)OTE(Epoxy_Dispense_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[[XIO(AUTO) XIC(HMI_Data.MOMButtons[14]) ,XIC(Epoxy_Dispense_SM.Status.State[8]) ]OTE(Epoxy_Dispense_SM.Control.Bit[2]);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Map Outputs]]>
</Comment>
<Text>
<![CDATA[XIC(Epoxy_Dispense_SM.Control.Bit[2])XIO(Lockout_PCB_Solder)NOP();]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
