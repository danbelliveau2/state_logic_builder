<Rung Number="47" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)AOI_K5100Basic(AOI_Axis_Basic,Axis_Ref_Ctrl_Cfg,Axis_Ref_Ctrl_Set,Axis_Ref_Ctrl_Cmd,Axis_Ref_Ctrl_Sts,HMI_Axis,Supervisor_SM.Control.StateReg,in_Safety.OK,FaultReset,WireFeed_SM.Control.Bit[4],POS_Scaling,VEL_Scaling,0,5,4,34,1);]]>
