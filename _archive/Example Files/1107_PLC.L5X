<Routine Name="ManualButtonsReset" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[for i := 0 to 223 by 1 do]]>
</Line>
<Line Number="4">
<![CDATA[	if (HMI_Data.Control.Button[i]) then]]>
</Line>
<Line Number="5">
<![CDATA[		if (BE_BitOnPrevScan) then]]>
</Line>
<Line Number="6">
<![CDATA[			HMI_Data.Control.Button[i] := 0;]]>
</Line>
<Line Number="7">
<![CDATA[			BE_BitOnPrevScan := 0;]]>
</Line>
<Line Number="8">
<![CDATA[		else]]>
</Line>
<Line Number="9">
<![CDATA[			BE_BitOnPrevScan := 1;]]>
</Line>
<Line Number="10">
<![CDATA[			exit;]]>
</Line>
<Line Number="11">
<![CDATA[		end_if;]]>
</Line>
<Line Number="12">
<![CDATA[	end_if;]]>
</Line>
<Line Number="13">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
</Routines>
