<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[0].Active) XIO(FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[1].Active) XIO(FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[2].Active) XIO(FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning]]>
</Comment>
<Text>
<![CDATA[AFI()OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_PCBGripper.Confirm_1)OTE(Gripper_CLSD);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AOI_PCBGripper.Confirm_2)OTE(Gripper_OPEN);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(IOBlock_Soldering:I.ProcessDataIn.Port_X5A)OTE(PCB_Present_Inboard);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(IOBlock_Soldering:I.ProcessDataIn.Port_X5B)OTE(PCB_Present_Outboard);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(Regrip_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,Regrip_SM.Control.StateReg) ,XIC(Regrip_SM.Status.State[62]) MOVE(StoppedState,Regrip_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Regrip_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(MAN)MOVE(3,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Regrip_SM.Status.State[5]) ,XIC(Regrip_SM.Status.State[61]) ]XIO(Lockout_Regrip)XIC(CycleStartLatch)MOVE(4,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 6
OPEN GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Regrip_SM.Status.State[4]) ,XIC(Regrip_SM.Status.State[10]) XIC(Robot02_PCB_SM.Control.Bit[13]) XIC(Regrip_SM.Status.TransitionTimerDone) ]MOVE(6,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 7
READY FOR ROBOT PLACE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Regrip_SM.Status.State[4]) ,XIC(Regrip_SM.Status.State[6]) ]XIC(Gripper_OPEN)MOVE(7,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 8
CLOSE GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Regrip_SM.Status.State[7])XIC(Robot02_PCB_SM.Control.Bit[15])XIC(Robot02_PCB_SM.Status.State[27])MOVE(8,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR ROBOT GRIPPER OPEN]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Regrip_SM.Status.State[8])XIC(Gripper_CLSD)MOVE(9,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 10
WAIT FOR ROBOT GRIPPER CLOSED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Regrip_SM.Status.State[9])XIC(Robot02_PCB_SM.Control.Bit[12])MOVE(10,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Regrip_SM.Status.State[5])XIC(Lockout_Regrip)XIC(CycleStartLatch)MOVE(61,Regrip_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(Regrip_SM.Status.State[7]) ,XIC(Regrip_SM.Status.State[10]) ] [XIC(Robot02_PCB_SM.Status.State[62]) ,XIC(Robot02_PCB_SM.Status.State[63]) ] ,XIC(Regrip_SM.Status.State[61]) ]XIO(CycleStartLatch)[ONS(Regrip_SM.Control.OS[1]) MOVE(Regrip_SM.Control.StateReg,StoppedState) ,MOVE(62,Regrip_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(Regrip_SM.Control.OS[0]) MOVE(Regrip_SM.Control.StateReg,FaultedState) ,MOVE(63,Regrip_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_Regrip_SM,Regrip_SM);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(Regrip_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Regrip_SM.Status.State[10]) MOVE(200,Regrip_SM.Control.TransitionTime) ,XIC(Regrip_SM.Status.State[11]) MOVE(1000,Regrip_SM.Control.TransitionTime) ]OTE(Regrip_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(5000,Regrip_SM.Control.FaultTime)OTE(Regrip_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[
STATE LOGIC ACTIONS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Control]]>
</Comment>
<Text>
<![CDATA[XIO(MachineBasic.AlwaysOn)OTE(Regrip_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[[XIO(AUTO) XIC(Regrip_SM.Control.Bit[3]) XIC(HMI_Data.Control.Button[70]) ,XIC(Regrip_SM.Status.State[8]) ,XIC(Regrip_SM.Control.Bit[2]) ][XIO(HMI_Data.Control.Button[71]) ,XIO(Regrip_SM.Control.Bit[3]) ]XIO(Regrip_SM.Status.State[6])OTE(Regrip_SM.Control.Bit[2]);]]>
