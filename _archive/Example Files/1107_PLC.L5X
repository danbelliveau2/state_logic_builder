</Comment>
<Text>
<![CDATA[[XIC(EpoxyCure_2_SM.Status.State[11]) XIC(Robot02_PCB_SM.Control.Bit[12]) ONS(EpoxyCure_2_SM.Control.OS[2]) ,XIC(EpoxyCure_2_SM.Control.Bit[8]) ]XIO(Gripper_OPEN)OTE(EpoxyCure_2_SM.Control.Bit[8]);]]>
</Text>
</Rung>
<Rung Number="61" Type="N">
<Text>
<![CDATA[[XIC(EpoxyCure_2_SM.Control.Timer[0].DN) ,XIC(EpoxyCure_2_SM.Control.Bit[9]) ]XIC(EpoxyCure_2_SM.Control.Bit[8])OTE(EpoxyCure_2_SM.Control.Bit[9]);]]>
</Text>
</Rung>
<Rung Number="62" Type="N">
<Comment>
