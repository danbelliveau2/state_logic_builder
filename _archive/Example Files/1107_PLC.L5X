</Comment>
<Text>
<![CDATA[[XIO(AUTO) XIC(WireFeed_SM.Control.Bit[3]) XIC(HMI_Data.Control.Button[10]) ,XIC(WireFeed_SM.Status.State[9]) ,XIC(WireFeed_SM.Control.Bit[2]) ][XIO(HMI_Data.Control.Button[11]) ,XIO(WireFeed_SM.Control.Bit[3]) ]XIO(WireFeed_SM.Status.State[4])XIO(WireFeed_SM.Status.State[10])OTE(WireFeed_SM.Control.Bit[2]);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
