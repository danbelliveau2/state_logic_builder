<![CDATA[JSR(WireLength,0);]]>
</Text>
</Rung>
<Rung Number="58" Type="N">
<Comment>
<![CDATA[Kinetix 5100 Master Control AOI

Scaling including 10:1 gearbox
(1,000,000 Cnts/MtrRev)*(10 MtrRev/GearRev) / (3.132952756 * Pi inch/GearRev) = 1,016,006.9 Cnts/Inch
OR
(1,000,000 Cnts/MtrRev)*(10 MtrRev/GearRev) / (79.577 * Pi mm/GearRev) = 40,000.3

]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[MOVE(1,Axis_Ref_Ctrl_Cfg.OperatingUnits) ,MOVE(1000000,Axis_Ref_Ctrl_Cfg.MotionResolution) ,MOVE(40000.3,Axis_Ref_Ctrl_Cfg.ConversionConstant) ];]]>
</Text>
</Rung>
<Rung Number="59" Type="N">
<Text>
<![CDATA[raC_Dvc_K5100(AOI_K5100_s01WirePuller,Axis_Module,Axis_Ref_I,Axis_Ref_O,Axis_Ref_Ctrl_Inf,Axis_Ref_Ctrl_Cfg,Axis_Ref_Ctrl_Set,Axis_Ref_Ctrl_Cmd,Axis_Ref_Ctrl_Sts,Axis_Inf_Lookup)NOP();]]>
