<Text>
<![CDATA[[XIC(Robot01_Wire_SM.Status.State[22]) ,XIC(Robot01_Wire_SM.Status.State[32]) ,XIC(Robot01_Wire_SM.Control.Bit[14]) ]XIO(Robot01_Wire_SM.Status.State[26])XIO(Robot01_Wire_SM.Status.State[36])OTE(Robot01_Wire_SM.Control.Bit[14]);]]>
</Text>
</Rung>
<Rung Number="150" Type="N">
