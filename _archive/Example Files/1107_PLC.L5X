<Text>
<![CDATA[XIC(Vision_SM.Status.State[30])MOVE(0,TipLoc_X)MOVE(0,TipLoc_Y)MOVE(0,EdgeAngle)MOVE(0,WireEdge_X)MOVE(0,WireEdge_Y)MOVE(0,WireFinalLoc_X)OTU(WireFinalPresent_NOK)OTU(TipPresent_NOK);]]>
</Text>
