</Rung>
<Rung Number="56" Type="N">
<Comment>
<![CDATA[Cure Timer]]>
</Comment>
<Text>
<![CDATA[[XIC(EpoxyCure_2_SM.Status.State[15]) ,XIC(EpoxyCure_2_SM.Control.Bit[10]) ]XIO(EpoxyCure_2_SM.Control.Bit[9])XIO(Gripper_OPEN)[OTE(EpoxyCure_2_SM.Control.Bit[10]) ,MUL(HMI_Data.Control.DINT_SP[2],1000,EpoxyCure_2_SM.Control.Timer[0].PRE) RTO(EpoxyCure_2_SM.Control.Timer[0],?,?) ];]]>
