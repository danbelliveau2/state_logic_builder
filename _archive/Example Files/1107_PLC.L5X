<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[	StateDurationTimer.Reset := 1;]]>
</Line>
<Line Number="45">
<![CDATA[	StateDurationTimer.TimerEnable := 0;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[	FaultTimer.Reset := 1;]]>
</Line>
<Line Number="48">
<![CDATA[	FaultTimer.TimerEnable := 0;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[	StateLogicData.Status.TimeoutFlt := 0;]]>
</Line>
<Line Number="51">
<![CDATA[	StateLogicData.Status.TransitionTimerDone := 0;]]>
</Line>
<Line Number="52">
<![CDATA[END_IF;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[//Set the State Bit, clear all other bits.]]>
</Line>
<Line Number="56">
<![CDATA[FOR i := 0 TO (StateLogicData.Control.StateReg - 1) DO]]>
</Line>
<Line Number="57">
<![CDATA[	StateLogicData.Status.State[i] := 0;]]>
</Line>
<Line Number="58">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="59">
<![CDATA[StateLogicData.Status.State[i] := 1;]]>
</Line>
<Line Number="60">
<![CDATA[FOR i := (StateLogicData.Control.StateReg + 1) TO 127 DO]]>
</Line>
<Line Number="61">
<![CDATA[	StateLogicData.Status.State[i] := 0;]]>
</Line>
<Line Number="62">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
