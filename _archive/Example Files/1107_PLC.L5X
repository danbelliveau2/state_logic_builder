<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Instructions
1. Enable Outputs once function is verified.
2. When INPUT goes high, Out_1 will turn on.
When INPUT goes low, Out_2 will turn on.
3. PulseTime is how long Out_1 & Out_2 will 
stay on after a transition. If PulseTime is
zero, Out_1 & Out_2 will stay on.
4. For each Sens_1 & Sens_2, either add
a sensor tag or set Sens_x_Bypass to "1"
5. Add a value in [ms] each ConfirmTime & FaultTime
if desired to delay/debounce sensor feedback

- TOGGLE -]]>
</Comment>
<Text>
<![CDATA[XIC(INPUT)OTE(Prelim_Out_1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(INPUT)OTE(Prelim_Out_2);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[- OUTPUTS -

]]>
</Comment>
<Text>
<![CDATA[XIC(Prelim_Out_1)XIC(Enable_Outputs)[MOVE(PulseTime,PulseTMR_1.PRE) TON(PulseTMR_1,?,?) XIC(PulseTMR_1.TT) ,EQ(PulseTime,0) ]OTE(Out_1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Prelim_Out_2)XIC(Enable_Outputs)[MOVE(PulseTime,PulseTMR_2.PRE) TON(PulseTMR_2,?,?) XIC(PulseTMR_2.TT) ,EQ(PulseTime,0) ]OTE(Out_2);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[- FEEDBACK -]]>
</Comment>
<Text>
<![CDATA[XIC(Prelim_Out_1)[[[XIO(Sens_2) ,XIC(Sens_2_Bypass) ] [XIC(Sens_1) ,XIC(Sens_1_Bypass) ] MOVE(Out_1_ConfirmTime,Out_1_DLY.PRE) TON(Out_1_DLY,?,?) ,XIC(Out_1_DLY.DN) OTE(Confirm_1) ] ,[XIO(Sens_1) XIO(Sens_1_Bypass) ,XIC(Sens_2) XIO(Sens_2_Bypass) ] MOVE(Out_1_FaultTime,Out_1_FLT.PRE) TON(Out_1_FLT,?,?) ,XIC(Out_1_FLT.DN) OTE(Fault_1) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Prelim_Out_2)[[[XIO(Sens_1) ,XIC(Sens_1_Bypass) ] [XIC(Sens_2) ,XIC(Sens_2_Bypass) ] MOVE(Out_2_ConfirmTime,Out_2_DLY.PRE) TON(Out_2_DLY,?,?) ,XIC(Out_2_DLY.DN) OTE(Confirm_2) ] ,[XIO(Sens_2) XIO(Sens_2_Bypass) ,XIC(Sens_1) XIO(Sens_1_Bypass) ] MOVE(Out_2_FaultTime,Out_2_FLT.PRE) TON(Out_2_FLT,?,?) ,XIC(Out_2_FLT.DN) OTE(Fault_2) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
