<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Outfeed_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(MAN)MOVE(3,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Outfeed_SM.Status.State[5]) ,XIC(Outfeed_SM.Status.State[61]) ]XIO(Lockout_Outfeed)XIC(CycleStartLatch)MOVE(4,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 5
