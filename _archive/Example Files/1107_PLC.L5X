<![CDATA[XIC(Robot02_PCB_SM.Control.Bit[30])XIC(Robot02_PCB_SM.Control.Bit[13])TON(EpoxyCure_2_SM.Control.Timer[2],?,?)XIC(EpoxyCure_2_SM.Control.Timer[2].DN)OTE(EpoxyCure_2_SM.Control.Bit[11]);]]>
