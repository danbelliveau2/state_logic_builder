<![CDATA[[XIC(WireFeed_SM.Status.State[10]) ,XIC(WireFeed_SM.Control.Bit[7]) ]XIO(WireFeed_SM.Status.State[13])OTE(WireFeed_SM.Control.Bit[7]);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
