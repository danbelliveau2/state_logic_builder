</Comment>
<Comment Operand=".CONTROL.OS[0]">
<![CDATA[Used OS]]>
</Comment>
<Comment Operand=".CONTROL.OS[1]">
<![CDATA[Used OS]]>
</Comment>
<Comment Operand=".CONTROL.OS[2]">
<![CDATA[Used OS]]>
</Comment>
<Comment Operand=".CONTROL.BIT[0]">
<![CDATA[Initial Conditions OK]]>
</Comment>
<Comment Operand=".CONTROL.BIT[1]">
<![CDATA[INIT Seq Complete]]>
</Comment>
<Comment Operand=".CONTROL.BIT[2]">
<![CDATA[Extend (Cut) HS Cutter]]>
</Comment>
<Comment Operand=".CONTROL.BIT[3]">
<![CDATA[Extend HS Dynamic Gripper Slide]]>
</Comment>
<Comment Operand=".CONTROL.BIT[4]">
<![CDATA[Open HS Static Gripper]]>
</Comment>
<Comment Operand=".CONTROL.BIT[5]">
<![CDATA[Close HS Dynamic Gripper]]>
</Comment>
<Comment Operand=".CONTROL.BIT[6]">
<![CDATA[Move HS Shuttle RIGHT-WireFeed]]>
</Comment>
<Comment Operand=".CONTROL.BIT[7]">
<![CDATA[Close HS Shuttle Gripper]]>
</Comment>
<Comment Operand=".CONTROL.BIT[8]">
<![CDATA[Close Wire Guide Gripper]]>
</Comment>
<Comment Operand=".CONTROL.BIT[9]">
