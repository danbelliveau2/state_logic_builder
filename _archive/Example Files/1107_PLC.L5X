<AddOnInstructionDefinition Name="Banner_Q4X_PD_v4" Class="Standard" Revision="4.1" Vendor="Banner Engineering" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-06-20T14:25:31.364Z" CreatedBy="DUKE\2011324" EditedDate="2023-10-16T13:42:48.587Z" EditedBy="DUKE\jpreisen"
 SoftwareRevision="v33.00">
<Description>
<![CDATA[Takes the raw SINT information and converts that data into actual information.]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="SINT0" TagType="Base" DataType="SINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="SINT1" TagType="Base" DataType="SINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="PROCESS_DATA" TagType="Base" DataType="Banner_Q4X_PDI_v4" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Byte_Swap" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Swap the LSB and the MSB with each other.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Temp_Measurement" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Data_Byte" DataType="SINT" Dimensions="2" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Array DataType="SINT" Dimensions="2" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
</Array>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Convert two SINT Process Data elements into actual values stored in the UDT.]]>
</Comment>
<Text>
<![CDATA[XIC(Byte_Swap)MOVE(SINT0,Data_Byte[1])MOVE(SINT1,Data_Byte[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(Byte_Swap)MOVE(SINT0,Data_Byte[0])MOVE(SINT1,Data_Byte[1]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[BTD(Data_Byte[1],0,PROCESS_DATA.Channel_1_Output_State,0,1)BTD(Data_Byte[1],1,PROCESS_DATA.Channel_2_Output_State,0,1)BTD(Data_Byte[1],2,PROCESS_DATA.Sensor_Stability,0,1)BTD(Data_Byte[1],3,Temp_Measurement,0,5)BTD(Data_Byte[0],0,Temp_Measurement,5,8);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[DIV(Temp_Measurement,10,PROCESS_DATA.Measurement_Value);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="CPU_TimeDate_wJulian" Class="Standard" Revision="2.2" Vendor="SDC" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-05-01T14:06:05.139Z" CreatedBy="RA-INT\anabuto" EditedDate="2024-08-20T18:47:25.798Z" EditedBy="STEVENDOUGLAS\msavina"
 SoftwareRevision="v35.00">
<Description>
<![CDATA[Get CPU Time And Date. Calculates Day number from Jan 1 for Julian Day. Get UTC in microseconds.]]>
</Description>
<RevisionNote>
<![CDATA[2.0:  Added UTC functionality
2.1:  -Fixed non-functioning milliseconds
 -updated timedate UDT to add system clock microseconds
1-5-21 Dan Garr
v2.2 Cleaned up unused tags and optimized all data types for mem usage. 2021-05-11 D.E.S.]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="JulianDate" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[ordinal date]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="TimeDateTag" TagType="Base" DataType="CPU_TimeDate" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="Month" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="LookUp" DataType="INT" Dimensions="13" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,31,59,90,120,151,181,212,243,273,304,334]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Array DataType="INT" Dimensions="13" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
<Element Index="[2]" Value="31"/>
<Element Index="[3]" Value="59"/>
<Element Index="[4]" Value="90"/>
<Element Index="[5]" Value="120"/>
<Element Index="[6]" Value="151"/>
<Element Index="[7]" Value="181"/>
<Element Index="[8]" Value="212"/>
<Element Index="[9]" Value="243"/>
<Element Index="[10]" Value="273"/>
<Element Index="[11]" Value="304"/>
<Element Index="[12]" Value="334"/>
</Array>
</DefaultData>
</LocalTag>
<LocalTag Name="TimeDateArray" DataType="DINT" Dimensions="7" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0,0,0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Array DataType="DINT" Dimensions="7" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
<Element Index="[2]" Value="0"/>
<Element Index="[3]" Value="0"/>
<Element Index="[4]" Value="0"/>
<Element Index="[5]" Value="0"/>
<Element Index="[6]" Value="0"/>
</Array>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[GSV(WallClockTime,,LocalDateTime,TimeDateArray[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CLR(JulianDate)MOVE(TimeDateArray[1],Month);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LIMIT(1,Month,12)ADD(LookUp[Month],TimeDateArray[2],JulianDate);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GT(TimeDateArray[1],2)CMP(((TimeDateArray[0] MOD 4) = 0))[CMP(((TimeDateArray[0] MOD 100) > 0)) ,CMP(((TimeDateArray[0] MOD 400) = 0)) ]ADD(JulianDate,1,JulianDate);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOVE(TimeDateArray[0],TimeDateTag.Year)MOVE(TimeDateArray[1],TimeDateTag.Month)MOVE(TimeDateArray[2],TimeDateTag.Day)MOVE(TimeDateArray[3],TimeDateTag.Hour)MOVE(TimeDateArray[4],TimeDateTag.Minutes)MOVE(TimeDateArray[5],TimeDateTag.Seconds)DIV(TimeDateArray[6],1000,TimeDateTag.Milliseconds)MOVE(TimeDateArray[6],TimeDateTag.Microseconds);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[GSV(TimeSynchronize,,CurrentTimeMicroseconds,TimeDateTag.UTCmicroseconds);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Ethernet_Socket_TCP_Client" Class="Standard" Revision="1.0" Vendor="SDC" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2018-12-27T14:12:18.051Z" CreatedBy="STEVENDOUGLAS\msaggio" EditedDate="2020-04-06T16:02:25.002Z" EditedBy="EE-VM-001\Local Administrator"
 SoftwareRevision="v32.02">
<Description>
<![CDATA[Opens An Ethernet Socket then Activates a TCP Client To Connect To A Server Device. Once Connection Established, The User Can Read Or Write Data To Server.]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
