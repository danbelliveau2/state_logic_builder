<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Heat Shrink Spool: VFD Faulted]]>
</Comment>
<Text>
<![CDATA[[XIC(v02HeatShrinkSpool_IN.Fault) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Heat Shrink Station Initialization - Timeout Fault]]>
</Comment>
<Text>
<![CDATA[[[XIC(HeatShrink_SM.Status.State[2]) ,XIC(HeatShrink_SM.Status.State[6]) ] XIC(HeatShrink_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Heat Shrink Cutter Not Extended]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_HSCutter_Cyl.Fault_1) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Heat Shrink Cutter Not Retracted]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_HSCutter_Cyl.Fault_2) ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Dynamic Gripper SlideNot Extended]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_HSDynamicGripper_Slide.Fault_1) ,XIC(Alarm[4].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[4],Alarm[4].Message)OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Dynamic Gripper SlideNot Retracted]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_HSDynamicGripper_Slide.Fault_2) ,XIC(Alarm[5].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[5],Alarm[5].Message)OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Shuttle Cylinder Not Extended]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_HSShuttle_Cyl.Fault_1) ,XIC(Alarm[6].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[6],Alarm[6].Message)OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Shuttle Cylinder Not Retracted]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_HSShuttle_Cyl.Fault_2) ,XIC(Alarm[7].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[7],Alarm[7].Message)OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Wire Guide Gripper Not Closed]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_HSWireGuide_Gripper.Fault_1) ,XIC(Alarm[8].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[8],Alarm[8].Message)OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Wire Guide Gripper Not Open]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_HSWireGuide_Gripper.Fault_2) ,XIC(Alarm[9].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[9],Alarm[9].Message)OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Oven Over Max Temperature]]>
</Comment>
<Text>
<![CDATA[[XIC(Oven_OverTemp) ,XIC(Alarm[10].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[10],Alarm[10].Message)OTE(Alarm[10].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Oven Temperature Sensor Not Reading Properly]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_IOLM_HubsMaster_EIP.ComOK) XIO(Valid_TempReading) ,XIC(Alarm[11].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[11],Alarm[11].Message)OTE(Alarm[11].Active);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Idler Arm Unspooling Timeout - Heat Shrink May Be Empty]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(HS_IdlerArm_DOWN)XIC(RunFWD_Auto)TON(HeatShrink_SM.Control.Timer[1],?,?)XIC(HeatShrink_SM.Control.Timer[1].DN)CONCAT(StationName,AlarmText[12],Alarm[12].Message)OTE(Alarm[12].Active);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Heat Shrink Station: Idler Arm UP - Heat Shrink May Be Empty]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(HS_IdlerArm_UP)TON(HeatShrink_SM.Control.Timer[2],?,?)XIC(HeatShrink_SM.Control.Timer[2].DN)CONCAT(StationName,AlarmText[13],Alarm[13].Message)OTE(Alarm[13].Active);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Warning]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(HeatShrink_SM.Control.Bit[17])XIO(Lockout_HeatShrink)CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(Lockout_HeatShrink)ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INPUTS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(IOBlock_WirePrep:I.ProcessDataIn.Port_X7B) ,XIC(Debug_Fake_HS_Idler_UP) ]OTE(HS_IdlerArm_UP);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(IOBlock_WirePrep:I.ProcessDataIn.Port_X7A) ,XIC(Debug_Fake_HS_Idler_DOWN) ]OTE(HS_IdlerArm_DOWN);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AOI_HSCutter_Cyl.Confirm_1)OTE(HSCutter_EXTD);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(AOI_HSCutter_Cyl.Confirm_2)OTE(HSCutter_RETD);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(AOI_HSDynamicGripper_Slide.Confirm_1)OTE(HSDynGRP_Slide_EXTD);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(AOI_HSDynamicGripper_Slide.Confirm_2)OTE(HSDynGRP_Slide_RETD);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(AOI_HS_StaticGripper.Confirm_1)OTE(HS_StaticGripper_OPEN);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(AOI_HS_StaticGripper.Confirm_2)OTE(HS_StaticGripper_CLSD);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(AOI_HS_DynamicGripper.Confirm_1)OTE(HS_DynamicGripper_CLSD);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(AOI_HS_DynamicGripper.Confirm_2)OTE(HS_DynamicGripper_OPEN);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(AOI_HSShuttle_Cyl.Confirm_1)OTE(HSShuttle_RETD);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(AOI_HSShuttle_Cyl.Confirm_2)OTE(HSShuttle_EXTD);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(AOI_HSShuttle_Gripper.Confirm_1)OTE(HSShuttle_Gripper_CLSD);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(AOI_HSShuttle_Gripper.Confirm_2)OTE(HSShuttle_Gripper_OPEN);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(AOI_HSWireGuide_Gripper.Confirm_1)OTE(HSWireGuide_Gripper_CLSD);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(AOI_HSWireGuide_Gripper.Confirm_2)OTE(HSWireGuide_Gripper_OPEN);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[MOVE(IOBlock_Thermocouple:I.ProcessDataIn.Temperature_X1_0,Oven_TEMPERATURE);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[SUB(HMI_Data.Control.REAL_SP[0],HMI_Data.Control.REAL_SP[4],TemperatureTARGET)SUB(HMI_Data.Control.REAL_SP[0],5,TemperatureMIN)[GT(Oven_TEMPERATURE,TemperatureTARGET) OTE(HeatShrink_SM.Control.Bit[15]) ,GT(Oven_TEMPERATURE,TemperatureMIN) OTE(HeatShrink_SM.Control.Bit[17]) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(AOI_IOLM_HubsMaster_EIP.ComOK)LIMIT(0,Oven_TEMPERATURE,1000)OTE(Valid_TempReading);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[GE(Oven_TEMPERATURE,EpoxyCure_1_SM.Control.DINT[0])XIC(Valid_TempReading)OTE(Oven_OverTemp);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[MOVE(HeatShrinkReelRadius:I.ProcessDataIn.Distance,HS_Distance);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[GT(HS_Distance,HeatShrink_SM.Control.DINT[0])OTE(HSSupply_Low);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(HeatShrink_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,HeatShrink_SM.Control.StateReg) ,XIC(HeatShrink_SM.Status.State[62]) MOVE(StoppedState,HeatShrink_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[6])OTE(STOPPED);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(HeatShrink_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[STATE 2
INITIALIZE ACTUATORS STEP 1]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(HeatShrink_SM.Status.State[4])XIO(HeatShrink_SM.Control.Bit[1])XIO(HeatShrink_SM.Control.Bit[0])MOVE(2,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(HeatShrink_SM.Status.State[5]) ,XIC(HeatShrink_SM.Status.State[61]) ][XIO(Lockout_HeatShrink) XIC(CycleStartLatch) ,EQ(HMI_Data.Control.DINT_SP[10],2) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[[XIC(INIT) ,XIC(HMI_Data.Status.MachineInSC) [XIC(HeatShrink_SM.Status.State[19]) XIC(HSWireGuide_Gripper_CLSD) ,XIO(DIN1_2_CycleStopPB) ] ]MOVE(5,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[STATE 6
INITIALIZE ACTUATORS STEP 2]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(HeatShrink_SM.Status.State[2])XIC(HS_StaticGripper_CLSD)XIC(HSWireGuide_Gripper_CLSD)XIC(Supervisor_SM.Control.Bit[4])MOVE(6,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[STATE 7
READY TO FEED H.S.]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(HeatShrink_SM.Status.State[4]) XIO(HeatShrink_SM.Control.Bit[1]) ,XIC(HeatShrink_SM.Status.State[6]) ] XIC(HeatShrink_SM.Control.Bit[0]) ,XIC(HeatShrink_SM.Status.State[19]) XIC(HSWireGuide_Gripper_CLSD) XIO(HMI_Data.Status.MachineInSC) ]MOVE(7,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[STATE 8
CLOSE DYNAMIC GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(HeatShrink_SM.Status.State[7])XIC(Supervisor_SM.Control.Bit[4])MOVE(8,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[STATE 9
OPEN STATIC GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(HeatShrink_SM.Status.State[8])XIC(HS_DynamicGripper_CLSD)XIC(Supervisor_SM.Control.Bit[4])MOVE(9,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
<![CDATA[STATE 10
EXTEND DYNAMIC GRIPPER SLIDE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(HeatShrink_SM.Status.State[9])XIC(HS_StaticGripper_OPEN)XIC(Supervisor_SM.Control.Bit[4])MOVE(10,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[STATE 11
CLOSE SHUTTLE GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(HeatShrink_SM.Status.State[10])XIC(HSDynGRP_Slide_EXTD)XIC(Supervisor_SM.Control.Bit[4])MOVE(11,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[STATE 12
UNSPOOL HEAT SHRINK]]>
</Comment>
<Text>
<![CDATA[AFI()XIC(AUTO)XIC(HeatShrink_SM.Status.State[22])XIC(HSDynGRP_Slide_RETD)XIC(Supervisor_SM.Control.Bit[4])MOVE(12,HeatShrink_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Comment>
<![CDATA[STATE 13
CUT HEAT SHRINK (EXTEND)]]>
</Comment>
<Text>
