</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_PCBTransfer_Cyl.Confirm_1)OTE(Transfer_EXTD);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AOI_PCBTransfer_Cyl.Confirm_2)OTE(Transfer_RETD);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AOI_PCBGripper.Confirm_1)OTE(Gripper_CLSD);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AOI_PCBGripper.Confirm_2)OTE(Gripper_OPEN);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(AOI_Air_ON.Confirm_1)OTE(Air_ON);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(AOI_Air_ON.Confirm_2)OTE(Air_OFF);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[MOVE(IOBlock_Thermocouple:I.ProcessDataIn.Temperature_X1_2,Block_TEMPERATURE);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[SUB(HMI_Data.Control.REAL_SP[2],HMI_Data.Control.REAL_SP[4],TemperatureTARGET)SUB(HMI_Data.Control.REAL_SP[2],5,TemperatureMIN)[GE(Block_TEMPERATURE,TemperatureTARGET) OTE(Block_At_Temp) ,GE(Block_TEMPERATURE,TemperatureMIN) OTE(Block_At_TempMIN) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(AOI_IOLM_HubsMaster_EIP.ComOK)LIMIT(0,Block_TEMPERATURE,1000)OTE(Valid_TempReading);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[GE(Block_TEMPERATURE,EpoxyCure_2_SM.Control.DINT[0])XIC(Valid_TempReading)OTE(Cure_OverTemp);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(EpoxyCure_2_SM.Status.State[63]) XIO(AlarmActive) MOVE(4,EpoxyCure_2_SM.Control.StateReg) ,XIC(EpoxyCure_2_SM.Status.State[62]) MOVE(StoppedState,EpoxyCure_2_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(EpoxyCure_2_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(MAN)MOVE(3,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(EpoxyCure_2_SM.Status.State[5]) ,XIC(EpoxyCure_2_SM.Status.State[61]) ]XIO(Lockout_EpoxyCure_2)XIC(CycleStartLatch)MOVE(4,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 6
RETRACT AND OPEN GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(EpoxyCure_2_SM.Status.State[4]) XIO(EpoxyCure_2_SM.Control.Bit[8]) ,XIC(EpoxyCure_2_SM.Status.State[22]) ]MOVE(6,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 7
EMPTY - WAITING FOR PCB]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(EpoxyCure_2_SM.Status.State[4]) ,XIC(EpoxyCure_2_SM.Status.State[6]) ]XIC(Transfer_RETD)XIC(Gripper_OPEN)MOVE(7,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 8
EXTEND TRANSFER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[7])XIC(Robot02_PCB_SM.Control.Bit[6])MOVE(8,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR ROBOT PLACE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[8])XIC(Transfer_EXTD)XIC(Gripper_OPEN)MOVE(9,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 10
CLOSE GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[9])XIC(Robot02_PCB_SM.Control.Bit[30])XIC(Robot02_PCB_SM.Control.Bit[15])MOVE(10,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 11
WAIT FOR ROBOT RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[10])XIC(Gripper_CLSD)MOVE(11,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 12
RETRACT TRANSFER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(EpoxyCure_2_SM.Status.State[11]) ,XIC(EpoxyCure_2_SM.Status.State[4]) XIC(EpoxyCure_2_SM.Control.Bit[8]) XIO(EpoxyCure_2_SM.Control.Bit[9]) ]XIO(Robot02_PCB_SM.Control.Bit[30])MOVE(12,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 13
HEAT ON]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[12])XIC(Transfer_RETD)MOVE(13,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE 14
AIR ON]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[13])[XIC(Block_At_TempMIN) ,XIC(Debug_Heat2OFF) ]MOVE(14,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[STATE 15
CURE IP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[14])XIC(Air_ON)MOVE(15,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[STATE 16
AIR OFF]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(EpoxyCure_2_SM.Status.State[14]) ,XIC(EpoxyCure_2_SM.Status.State[15]) ]XIC(EpoxyCure_2_SM.Control.Bit[9])MOVE(16,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[STATE 17
FULL - CURE COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(EpoxyCure_2_SM.Status.State[16]) XIC(Air_OFF) XIC(EpoxyCure_2_SM.Status.TransitionTimerDone) ,XIC(EpoxyCure_2_SM.Status.State[4]) XIC(EpoxyCure_2_SM.Control.Bit[9]) ]MOVE(17,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[STATE 18
EXTEND TRANSFER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[17])XIC(Robot02_PCB_SM.Control.Bit[3])MOVE(18,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[STATE 19
WAIT FOR ROBOT PICK]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[18])XIC(Transfer_EXTD)MOVE(19,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[STATE 20
OPEN GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[19])XIC(EpoxyCure_2_SM.Control.Bit[11])MOVE(20,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[STATE 21
WAIT FOR ROBOT RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[20])XIC(Gripper_OPEN)MOVE(21,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[STATE 22
RETRACT TRANSFER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[21])XIO(Robot02_PCB_SM.Control.Bit[30])MOVE(22,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[5])XIC(Lockout_EpoxyCure_2)XIC(CycleStartLatch)MOVE(61,EpoxyCure_2_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(EpoxyCure_2_SM.Status.State[7]) ,XIC(EpoxyCure_2_SM.Status.State[11]) ,XIC(EpoxyCure_2_SM.Status.State[13]) ,XIC(EpoxyCure_2_SM.Status.State[15]) ,XIC(EpoxyCure_2_SM.Status.State[17]) ,XIC(EpoxyCure_2_SM.Status.State[19]) ] [XIC(Robot02_PCB_SM.Status.State[62]) ,XIC(Robot02_PCB_SM.Status.State[63]) ] ,XIC(EpoxyCure_2_SM.Status.State[61]) ]XIO(CycleStartLatch)[ONS(EpoxyCure_2_SM.Control.OS[1]) MOVE(EpoxyCure_2_SM.Control.StateReg,StoppedState) ,MOVE(62,EpoxyCure_2_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(EpoxyCure_2_SM.Control.OS[0]) MOVE(EpoxyCure_2_SM.Control.StateReg,FaultedState) ,MOVE(63,EpoxyCure_2_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_EpoxyCure_2_SM,EpoxyCure_2_SM);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(EpoxyCure_2_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(EpoxyCure_2_SM.Status.State[16])MOVE(1000,EpoxyCure_2_SM.Control.TransitionTime)OTE(EpoxyCure_2_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
