</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Outfeed_SM.Status.State[5])XIC(Lockout_Outfeed)XIC(CycleStartLatch)MOVE(61,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 62
