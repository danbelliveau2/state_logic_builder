<![CDATA[[XIC(Heater_ON_Manual) ,XIC(Heater_ON_Auto) ]OTE(EpoxyCure_2_SM.Control.Bit[5]);]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Comment>
<![CDATA[Air Control]]>
</Comment>
<Text>
<![CDATA[[XIO(AUTO) XIC(EpoxyCure_2_SM.Control.Bit[4]) XIC(HMI_Data.Control.Button[156]) ,XIC(HeaterAIR_ON_Manual) ][XIO(HMI_Data.Control.Button[157]) ,XIO(EpoxyCure_2_SM.Control.Bit[4]) ]XIO(CycleStartLatch)XIC(in_Safety.OK)OTE(HeaterAIR_ON_Manual);]]>
