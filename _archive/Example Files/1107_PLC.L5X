<Routine Name="WireLength" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
Encoder Wire Length Measurement

]]>
</Comment>
<Text>
<![CDATA[[XIC(WireFeed_SM.Control.Bit[5]) ,XIC(WireFeed_SM.Control.Bit[6]) ]ONS(WireFeed_SM.Control.OS[2])MOVE(EncoderCNT_Live,EncoderCNT_Start)MOVE(0,EncoderRollOverCNT)OTE(WireFeed_PLS);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(WireFeed_PLS) ,XIC(WireFeed_IP) ]XIO(WireFeed_SM.Status.State[8])XIO(WireFeed_SM.Status.State[15])OTE(WireFeed_IP);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(WireFeed_IP)[LT(EncoderCNT_Live,EncoderCNT_PREV) SUB(EncoderCNT_PREV,EncoderCNT_Live,EncoderCNT_DELTA) GT(EncoderCNT_DELTA,100) ADD(EncoderRollOverCNT,1,EncoderRollOverCNT) ,MOVE(EncoderCNT_Live,EncoderCNT_PREV) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[CPT(WireLen_Encoder,(((EncoderRollOverCNT-1)*1024)+(1024-EncoderCNT_Start)+EncoderCNT_Live)/130.048*25.4);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(debug_ManualLengthCheck) MOVE(HMI_Axis.Control.AxisPositions[0],WireLen_Target) ,XIC(WireFeed_SM.Status.State[8]) MOVE(HMI_Axis.Control.AxisPositions[1],WireLen_Target) ,XIC(WireFeed_SM.Status.State[15]) MOVE(HMI_Axis.Control.AxisPositions[2],WireLen_Target) ]ONS(WireFeed_SM.Control.OS[3])[DIV(Axis_Ref_Ctrl_Sts.ActualPosition,POS_Scaling,WireLen_Servo) AOI_RangeCheck(AOI_Slippage_RC,WireLen_Servo,Slippage_Deadband,WireLen_Encoder) ,AOI_RangeCheck(AOI_Length_RC,WireLen_Target,WireLen_Deadband,WireLen_Encoder) ,SUB(WireLen_Servo,WireLen_Encoder,DriveSlippage) MUL(DriveSlippage,100,DriveSlippage) TRUNC(DriveSlippage,DriveSlippage) DIV(DriveSlippage,100,DriveSlippage) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
