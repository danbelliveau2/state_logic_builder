<![CDATA[Initialize Actuators Step 1]]>
</Comment>
<Comment Operand=".STATUS.STATE[3]">
<![CDATA[Manual Mode]]>
</Comment>
<Comment Operand=".STATUS.STATE[4]">
<![CDATA[Auto Initialize]]>
</Comment>
<Comment Operand=".STATUS.STATE[5]">
<![CDATA[Auto Ready]]>
</Comment>
<Comment Operand=".STATUS.STATE[6]">
<![CDATA[Initialize Actuators Step 2]]>
</Comment>
<Comment Operand=".STATUS.STATE[7]">
<![CDATA[Ready to Feed H.S.]]>
</Comment>
<Comment Operand=".STATUS.STATE[8]">
<![CDATA[Close Dynamic Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[9]">
<![CDATA[Open Static Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[10]">
<![CDATA[Extend Dynamic Gripper Slide]]>
</Comment>
<Comment Operand=".STATUS.STATE[11]">
<![CDATA[Close Shuttle Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[12]">
<![CDATA[Unspool Heat Shrink]]>
</Comment>
<Comment Operand=".STATUS.STATE[13]">
<![CDATA[Cut Heat Shrink (Extend)]]>
</Comment>
<Comment Operand=".STATUS.STATE[14]">
<![CDATA[Retract Cutter]]>
</Comment>
<Comment Operand=".STATUS.STATE[15]">
<![CDATA[Retract Shuttle & Wait for Robot]]>
</Comment>
<Comment Operand=".STATUS.STATE[16]">
<![CDATA[Open H.S. Guide Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[17]">
<![CDATA[Open Shuttle Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[18]">
<![CDATA[Extend Shuttle]]>
</Comment>
<Comment Operand=".STATUS.STATE[19]">
<![CDATA[Close H.S. Guide Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[20]">
<![CDATA[Close Static Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[21]">
<![CDATA[Open Dynamic Gripper]]>
</Comment>
<Comment Operand=".STATUS.STATE[22]">
<![CDATA[Retract Dynamic Gripper Slide]]>
</Comment>
<Comment Operand=".STATUS.STATE[61]">
<![CDATA[Lockout]]>
</Comment>
<Comment Operand=".STATUS.STATE[62]">
<![CDATA[Cycle Stop]]>
</Comment>
<Comment Operand=".STATUS.STATE[63]">
<![CDATA[Faulted]]>
</Comment>
