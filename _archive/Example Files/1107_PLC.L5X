<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_SolderPotTOOL_Cyl.Confirm_1)OTE(WiperTOOL_EXTD);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AOI_SolderPotTOOL_Cyl.Confirm_2)OTE(WiperTOOL_RETD);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AOI_SolderPotLIFT_Cyl.Confirm_1)OTE(SkimmerLIFT_EXTD);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AOI_SolderPotLIFT_Cyl.Confirm_2)OTE(SkimmerLIFT_RETD);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(SolderPotLevel:I.ProcessDataIn.Channel_1_Output_State)OTE(SolderLevelOK);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[DIV(SolderPotLevel:I.ProcessDataIn.Measurement_Value,10,SolderPot_Level) ,GT(SolderPot_Level,SolderPot_LevelMAX) MOVE(SolderPot_Level,SolderPot_LevelMAX) ,LT(SolderPot_Level,SolderPot_LevelMIN) GT(SolderPot_Level,900) MOVE(SolderPot_Level,SolderPot_LevelMIN) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[LIMIT(SolderPot_SM.Control.REAL[3],SolderPot_Level,SolderPot_SM.Control.REAL[4]) SUB(SolderPot_SM.Control.REAL[0],SolderPot_Level,SolderPot_SM.Control.REAL[1]) ,LIMIT(SolderPot_SM.Control.REAL[4],SolderPot_Level,SolderPot_SM.Control.REAL[3]) MOVE(0,SolderPot_SM.Control.REAL[1]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(SolderPot_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,SolderPot_SM.Control.StateReg) ,XIC(SolderPot_SM.Status.State[62]) MOVE(StoppedState,SolderPot_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(SolderPot_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(SolderPot_SM.Status.State[5]) ,XIC(SolderPot_SM.Status.State[61]) ][XIO(Lockout_SolderPot) XIC(CycleStartLatch) ,EQ(HMI_Data.Control.DINT_SP[10],3) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[[XIC(INIT) ,XIC(SolderPot_SM.Status.State[13]) XIC(HMI_Data.Status.MachineInSC) ]MOVE(5,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 6
INITIALIZE ACTUATORS]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(SolderPot_SM.Status.State[4])XIO(SolderPot_SM.Control.Bit[0])MOVE(6,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 7
READY FOR TINNING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(SolderPot_SM.Status.State[4]) ,XIC(SolderPot_SM.Status.State[6]) ,XIC(SolderPot_SM.Status.State[13]) XIO(HMI_Data.Status.MachineInSC) ]XIC(SolderPot_SM.Control.Bit[0])MOVE(7,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 8
SKIMMER TOOL EXTEND]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(SolderPot_SM.Status.State[7])[XIC(Robot01_Wire_SM.Status.State[23]) XIC(Robot01_Wire_SM.Control.Bit[12]) ,XIC(Robot01_Wire_SM.Status.State[28]) ,XIC(HMI_Data.Status.MachineInSC) ]MOVE(8,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 9
SKIMMER LIFT EXTEND]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(SolderPot_SM.Status.State[8])XIO(WiperTOOL_RETD)XIC(SolderPot_SM.Status.TransitionTimerDone)XIC(Supervisor_SM.Control.Bit[4])MOVE(9,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 10
SKIMMER TOOL RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(SolderPot_SM.Status.State[9])XIO(SkimmerLIFT_RETD)XIC(SolderPot_SM.Status.TransitionTimerDone)XIC(Supervisor_SM.Control.Bit[4])MOVE(10,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 11
SKIMMER LIFT RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(SolderPot_SM.Status.State[10])XIC(WiperTOOL_RETD)XIC(Supervisor_SM.Control.Bit[4])MOVE(11,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 12
WAIT FOR ROBOT SEQ COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(SolderPot_SM.Status.State[11])XIC(SkimmerLIFT_RETD)MOVE(12,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 13
SOLDER POT SEQ COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(SolderPot_SM.Status.State[12])XIC(Robot01_Wire_SM.Status.State[31])MOVE(13,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(SolderPot_SM.Status.State[5])XIC(Lockout_SolderPot)XIC(CycleStartLatch)MOVE(61,SolderPot_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(SolderPot_SM.Status.State[7]) ,XIC(SolderPot_SM.Status.State[12]) ] [XIC(Robot01_Wire_SM.Status.State[62]) ,XIC(Robot01_Wire_SM.Status.State[63]) ] ,XIC(SolderPot_SM.Status.State[61]) ]XIO(HMI_Data.Status.MachineInSC)XIO(CycleStartLatch)[ONS(SolderPot_SM.Control.OS[1]) MOVE(SolderPot_SM.Control.StateReg,StoppedState) ,MOVE(62,SolderPot_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(SolderPot_SM.Control.OS[0]) MOVE(SolderPot_SM.Control.StateReg,FaultedState) ,MOVE(63,SolderPot_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_SolderPot_SM,SolderPot_SM);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(SolderPot_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(SolderPot_SM.Status.State[8]) MOVE(SolderPot_SM.Control.DINT[0],SolderPot_SM.Control.TransitionTime) ,XIC(SolderPot_SM.Status.State[9]) MOVE(SolderPot_SM.Control.DINT[1],SolderPot_SM.Control.TransitionTime) ]OTE(SolderPot_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(5000,SolderPot_SM.Control.FaultTime)OTE(SolderPot_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[
STATE LOGIC ACTIONS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Control]]>
</Comment>
<Text>
<![CDATA[XIC(WiperTOOL_RETD)XIC(SkimmerLIFT_RETD)[XIC(SolderLevelOK) ,XIC(Bypass_SolderLevelSens) ]OTE(SolderPot_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[[XIO(AUTO) XIC(SolderPot_SM.Control.Bit[4]) XIC(HMI_Data.Control.Button[30]) ,XIC(SolderPot_SM.Status.State[8]) ,XIC(SolderPot_SM.Control.Bit[2]) ][XIO(HMI_Data.Control.Button[31]) ,XIO(SolderPot_SM.Control.Bit[4]) ]XIO(SolderPot_SM.Status.State[6])XIO(SolderPot_SM.Status.State[10])OTE(SolderPot_SM.Control.Bit[2]);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[[XIO(AUTO) XIC(SolderPot_SM.Control.Bit[4]) XIC(HMI_Data.Control.Button[32]) ,XIC(SolderPot_SM.Status.State[9]) ,XIC(SolderPot_SM.Control.Bit[3]) ][XIO(HMI_Data.Control.Button[33]) ,XIO(SolderPot_SM.Control.Bit[4]) ]XIO(SolderPot_SM.Status.State[6])XIO(SolderPot_SM.Status.State[11])OTE(SolderPot_SM.Control.Bit[3]);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[Solder Pot Ready for Tinning]]>
</Comment>
<Text>
<![CDATA[XIC(WiperTOOL_RETD)OTE(SolderPot_SM.Control.Bit[5]);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIC(in_Safety.EStopOK)OTE(SolderPot_SM.Control.Bit[4]);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[Map Outputs]]>
</Comment>
<Text>
<![CDATA[AOI_DoubleSOL_Pulse_FB(AOI_SolderPotTOOL_Cyl,SolderPot_SM.Control.Bit[4],SolderPot_SM.Control.Bit[2],VB_WirePrep:O.ProcessDataOut.Output20,VB_WirePrep:O.ProcessDataOut.Output21,ValveOutput_PulseTime,0,IOBlock_WirePrep:I.ProcessDataIn.Port_X6B);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[AOI_DoubleSOL_Pulse_FB(AOI_SolderPotLIFT_Cyl,SolderPot_SM.Control.Bit[4],SolderPot_SM.Control.Bit[3],VB_WirePrep:O.ProcessDataOut.Output19,VB_WirePrep:O.ProcessDataOut.Output18,ValveOutput_PulseTime,IOBlock_WirePrep:I.ProcessDataIn.Port_X6A,0);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[Consumable Cycle Counter]]>
</Comment>
<Text>
<![CDATA[XIC(Robot01_Wire_SM.Status.State[29])ONS(SolderPot_SM.Control.OS[2])MOVE(HMI_Data.Control.DINT_SP[13],SolderPot_SM.Control.Counter[0].PRE)CTU(SolderPot_SM.Control.Counter[0],?,?);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.MOMButtons[26])RES(SolderPot_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
