<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIC(RobotStatus.Fault)CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Timeout Fault

Means the robot was waiting too long for a signal
 or action from one of the stations]]>
</Comment>
<Text>
<![CDATA[[XIC(RobotStatus.UserIn4.5) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(HMI_Data.MOMButtons[16]) XIO(StripperGuide_OPEN) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[R50 was not 0 when starting Robot program]]>
</Comment>
<Text>
<![CDATA[[XIC(RobotStatus.UserIn4.1) ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning - Robot Still Running, Cycle Stop Inhibited]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(Robot01_Wire_SM.Status.State[5])XIO(Robot01_Wire_SM.Status.State[61])XIO(Robot01_Wire_SM.Status.State[62])XIO(Robot01_Wire_SM.Status.State[63])XIO(CycleStartLatch)CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Warning - Wire Stripper Not In Place]]>
</Comment>
<Text>
<![CDATA[[XIC(AUTO) ,XIC(STOPPED) ]XIO(WireStripper_InPlace)CONCAT(StationName,WarningText[1],Warning[1].Message)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Warning - PCB Solder Station Not Clear for Wire Robot]]>
</Comment>
<Text>
<![CDATA[[XIC(Robot01_Wire_SM.Status.State[37]) ,XIC(Robot01_Wire_SM.Status.State[10]) XIC(WireGripper.TinInspected) ]XIC(\Tracking.WIRE_GOOD)XIO(PCB_Solder_SM.Control.Bit[18])CONCAT(StationName,WarningText[2],Warning[2].Message)OTE(Warning[2].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Warning - PCB Robot Not Clear of Solder Station for Wire Robot]]>
</Comment>
<Text>
<![CDATA[[XIC(Robot01_Wire_SM.Status.State[37]) ,XIC(Robot01_Wire_SM.Status.State[10]) XIC(WireGripper.TinInspected) ]XIC(\Tracking.WIRE_GOOD)XIO(Robot02_PCB_SM.Control.Bit[26])CONCAT(StationName,WarningText[3],Warning[3].Message)OTE(Warning[3].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[CPS(r01Robot_WireHandling:I2.Input[0],EDA.in,212);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(IOLM_WirePrepMaster:I.Pt14.Data)OTE(WireStripper_InPlace);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AOI_StripperGuide.Confirm_1)OTE(StripperGuide_OPEN);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(AOI_StripperGuide.Confirm_2)OTE(StripperGuide_CLOSED);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(Robot01_Wire_SM.Status.State[63]) XIO(AlarmActive) MOVE(4,Robot01_Wire_SM.Control.StateReg) ,XIC(Robot01_Wire_SM.Status.State[62]) MOVE(StoppedState,Robot01_Wire_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[6])OTE(STOPPED);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Robot01_Wire_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Robot01_Wire_SM.Status.State[5]) ,XIC(Robot01_Wire_SM.Status.State[61]) ][XIO(Lockout_Robot01_Wire) XIC(CycleStartLatch) ,EQ(HMI_Data.Control.DINT_SP[10],11) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 6
START ROBOT PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot01_Wire_SM.Status.State[4])MOVE(6,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 7
ROBOT RUNNING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Robot01_Wire_SM.Status.State[4]) ,XIC(Robot01_Wire_SM.Status.State[6]) ]XIC(RobotStatus.Running)MOVE(7,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 8
START 20 RECOVERY PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot01_Wire_SM.Status.State[7])EQ(EDA.in.R60,0)XIC(RobotStatus.UserIn1.0)MOVE(8,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR 20 RECOVERY COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot01_Wire_SM.Status.State[8])EQ(EDA.in.R60,20)XIO(RobotStatus.UserIn1.0)MOVE(9,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 10
ROBOT READY]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Robot01_Wire_SM.Status.State[9]) ,XIC(Robot01_Wire_SM.Status.State[39]) ,XIC(Robot01_Wire_SM.Status.State[51]) ]EQ(EDA.in.R60,0)XIC(RobotStatus.UserIn1.0)MOVE(10,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 11
unused]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)AFI()XIC(Robot01_Wire_SM.Status.State[10])EQ(EDA.in.R60,18)XIO(RobotStatus.UserIn1.0)MOVE(11,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 12
START 2 GET WIRE PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(CycleStartLatch)XIC(Robot01_Wire_SM.Status.State[10])XIC(Status_CLEAR)[XIO(CLEANOUT) XIC(Infeed_SM.Status.State[7]) ,XIC(PCB_Solder_SM.Control.Bit[24]) XIO(PCB_Solder_SM.Control.Bit[26]) ]XIC(Debug_Robot01_S12)MOVE(12,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 13
WAIT FOR 2 GET WIRE COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Robot01_Wire_SM.Status.State[12])EQ(EDA.in.R60,2)XIO(RobotStatus.UserIn1.0)MOVE(13,Robot01_Wire_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 14
START 5 GET HSTUBE PROGRAM]]>
</Comment>
<Text>
