<![CDATA[XIC(INIT)MOVE(5,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 6
MOVE TO NEAREST POSITION]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Outfeed_SM.Status.State[4])XIO(Rack_inPOS)XIO(Dial_Full)MOVE(6,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 7
READY TO ACCEPT PCB'S]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Outfeed_SM.Status.State[9]) EQ(POSNearest,POSNext) ,XIC(Outfeed_SM.Status.State[6]) ,XIC(Outfeed_SM.Status.State[4]) XIO(Robot02_PCB_SM.Control.Bit[9]) ]XIC(Rack_inPOS)MOVE(7,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 8
DIAL NEST IS FULL]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Outfeed_SM.Status.State[7]) ,XIC(Outfeed_SM.Status.State[4]) XIC(Rack_inPOS) ]XIC(Robot02_PCB_SM.Control.Bit[9])MOVE(8,Outfeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 9
