</Routine>
<Routine Name="WireTracking" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Archive Wire Data by shifting by 1 in the array and 
then reset all data in array index [0]]]>
</Comment>
<Text>
<![CDATA[XIC(Robot01_Wire_SM.Status.State[13])XIC(Robot01_Wire_SM.Control.Bit[2])ONS(OneShotW.0)CPS(out_WireData[0],WireDataTEMP[0],9)CPS(WireDataTEMP[0],out_WireData[1],9)CPS(NULL_WireData,out_WireData[0],1)OTE(WIRE_DataReset_PLS);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[A Wire is 'in Process' once it is picked by the robot until
the robot gripper opens and releases the wire]]>
</Comment>
<Text>
<![CDATA[[XIC(Robot01_Wire_SM.Status.State[13]) XIO(Robot01_Wire_SM.Control.Bit[2]) ONS(OneShotW.16) ,XIC(Supervisor_SM.Control.Bit[9]) ]XIO(Robot01_Wire_SM.Control.Bit[2])OTE(Supervisor_SM.Control.Bit[9]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(HMI_Data.Control.Button[74]) ,XIC(Robot01_Wire_SM.Control.Bit[2]) ONS(OneShotW.17) ,XIC(WireReject_Manual) ]XIC(Supervisor_SM.Control.Bit[9])XIO(Robot01_Wire_SM.Status.State[13])XIO(Robot01_Wire_SM.Status.State[39])OTE(WireReject_Manual);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[
Process Wire TRACKING Data

]]>
</Comment>
<Text>
<![CDATA[XIC(WireFeed_SM.Status.State[17])ONS(OneShotW.1)[OTL(out_WireData[0].Pulled_COMPLETE) ,MOVE(\WireFeed.WireLen_Encoder,out_WireData[0].Encoder_Length) ,MOVE(\WireFeed.DriveSlippage,out_WireData[0].Wire_Slippage) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(WireFeed_SM.Status.State[17])ONS(OneShotW.2)[XIC(\WireFeed.AOI_Slippage_RC.In_Range) XIC(\WireFeed.AOI_Length_RC.In_Range) OTL(out_WireData[0].Length_PASS) ,XIO(out_WireData[0].Length_PASS) OTL(out_WireData[0].Length_FAIL) XIO(Bypass_WireLengthCheck) CTU(TrackingCTR[0],?,?) ,XIC(out_WireData[0].Length_PASS) RES(TrackingCTR[0]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Alarm[0].Active)XIC(FaultReset)RES(TrackingCTR[0]);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Wire has been cut]]>
</Comment>
<Text>
<![CDATA[XIC(WireFeed_SM.Status.State[11])ONS(OneShotW.3)OTL(out_WireData[0].WireCut_COMPLETE);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Wire has been fully inserted into Heat Shrink]]>
</Comment>
<Text>
<![CDATA[XIC(Robot01_Wire_SM.Control.Bit[5])ONS(OneShotW.4)OTL(out_WireData[0].HS_Insert_COMPLETE);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Heat Shrink Oven Process Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Robot01_Wire_SM.Control.Timer[0].DN)ONS(OneShotW.5)OTL(out_WireData[0].HS_Oven_COMPLETE);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Wire has been stripped]]>
</Comment>
<Text>
<![CDATA[XIC(Robot01_Wire_SM.Control.Timer[6].DN)ONS(OneShotW.6)OTL(out_WireData[0].WireStrip_COMPLETE);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Stripped Wire Inspection]]>
</Comment>
<Text>
<![CDATA[[XIC(Vision_SM.Status.State[14]) ,XIC(Robot01_Wire_SM.Status.State[23]) XIC(Lockout_Vision) ]ONS(OneShotW.7)[MOVE(Robot01_Wire_SM.Control.Counter[0].ACC,n) CPS(NULL_BareWire,out_WireData[0].StripInspect_RESULTS[n],1) ,XIC(\Vision.BareWire_ALLOK) OTL(out_WireData[0].StripInspect_RESULTS[n].Inspect_PASS) ,XIO(\Vision.BareWire_ALLOK) OTL(out_WireData[0].StripInspect_RESULTS[n].Inspect_FAIL) ,XIC(\Vision.Diameters_OK) OTL(out_WireData[0].StripInspect_RESULTS[n].Diameters_OK) ,XIC(\Vision.Lengths_OK) OTL(out_WireData[0].StripInspect_RESULTS[n].Lengths_OK) ,XIC(\Vision.Bridging_OK) OTL(out_WireData[0].StripInspect_RESULTS[n].BridgeDetect_OK) ,XIC(\Vision.FlairOuts_OK) OTL(out_WireData[0].StripInspect_RESULTS[n].FlairDetect_OK) ,XIC(\Vision.FullStrip_OK) OTL(out_WireData[0].StripInspect_RESULTS[n].FullStrip_OK) ,XIC(Vision_SM.Status.State[14]) MOVE(111.1,out_WireData[0].StripInspect_RESULTS[n].X_WireEnd) ,XIC(Vision_SM.Status.State[14]) MOVE(222.2,out_WireData[0].StripInspect_RESULTS[n].Y_WireEnd) ,XIC(Vision_SM.Status.State[14]) MOVE(333.3,out_WireData[0].StripInspect_RESULTS[n].WireAngle) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Stripped Wire Inspection has been completed]]>
</Comment>
<Text>
<![CDATA[XIC(Robot01_Wire_SM.Status.State[26])ONS(OneShotW.8)[[XIC(out_WireData[0].StripInspect_RESULTS[1].Inspect_FAIL) ,XIC(out_WireData[0].StripInspect_RESULTS[2].Inspect_FAIL) ,XIC(out_WireData[0].StripInspect_RESULTS[3].Inspect_FAIL) ,XIC(out_WireData[0].StripInspect_RESULTS[4].Inspect_FAIL) ,XIC(out_WireData[0].StripInspect_RESULTS[5].Inspect_FAIL) ,XIC(out_WireData[0].StripInspect_RESULTS[6].Inspect_FAIL) ,XIC(out_WireData[0].StripInspect_RESULTS[7].Inspect_FAIL) ,XIC(out_WireData[0].StripInspect_RESULTS[8].Inspect_FAIL) ] OTL(out_WireData[0].StripInspect_FAIL) ,XIO(out_WireData[0].StripInspect_FAIL) OTL(out_WireData[0].StripInspect_PASS) ,OTL(out_WireData[0].StripInspect_COMPLETE) ,XIC(out_WireData[0].StripInspect_FAIL) XIO(Bypass_BareWireInspect) CTU(TrackingCTR[2],?,?) ,XIC(out_WireData[0].StripInspect_PASS) RES(TrackingCTR[2]) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Alarm[2].Active)XIC(FaultReset)RES(TrackingCTR[2]);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Wire has been tinned]]>
</Comment>
<Text>
<![CDATA[XIO(Robot01_Wire_SM.Status.State[29])XIO(s:FS)ONS(OneShotW.9)OTL(out_WireData[0].Tinning_COMPLETE);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Tinned Wire Inspection]]>
</Comment>
<Text>
<![CDATA[[XIC(Vision_SM.Status.State[24]) ,XIC(Robot01_Wire_SM.Status.State[33]) XIC(Lockout_Vision) ]ONS(OneShotW.10)[MOVE(Robot01_Wire_SM.Control.Counter[1].ACC,n) CPS(NULL_TinnedWire,out_WireData[0].TinningInspect_RESULTS[n],1) ,XIC(\Vision.TinnedWire_ALLOK) OTL(out_WireData[0].TinningInspect_RESULTS[n].Inspect_PASS) ,XIO(\Vision.TinnedWire_ALLOK) OTL(out_WireData[0].TinningInspect_RESULTS[n].Inspect_FAIL) ,XIC(\Vision.Bridging_OK) OTL(out_WireData[0].TinningInspect_RESULTS[n].BridgeDetect_OK) ,XIC(\Vision.FlairOuts_OK) OTL(out_WireData[0].TinningInspect_RESULTS[n].FlairDetect_OK) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Tinned Wire Inspection has been completed]]>
</Comment>
<Text>
<![CDATA[XIC(Robot01_Wire_SM.Status.State[36])ONS(OneShotW.11)[[XIC(out_WireData[0].TinningInspect_RESULTS[1].Inspect_FAIL) ,XIC(out_WireData[0].TinningInspect_RESULTS[2].Inspect_FAIL) ,XIC(out_WireData[0].TinningInspect_RESULTS[3].Inspect_FAIL) ,XIC(out_WireData[0].TinningInspect_RESULTS[4].Inspect_FAIL) ,XIC(out_WireData[0].TinningInspect_RESULTS[5].Inspect_FAIL) ,XIC(out_WireData[0].TinningInspect_RESULTS[6].Inspect_FAIL) ,XIC(out_WireData[0].TinningInspect_RESULTS[7].Inspect_FAIL) ,XIC(out_WireData[0].TinningInspect_RESULTS[8].Inspect_FAIL) ] OTL(out_WireData[0].TinningInspect_FAIL) ,XIO(out_WireData[0].TinningInspect_FAIL) OTL(out_WireData[0].TinningInspect_PASS) ,OTL(out_WireData[0].TinningInspect_COMPLETE) ,XIC(out_WireData[0].TinningInspect_FAIL) XIO(Bypass_TinnedWireInspect) CTU(TrackingCTR[3],?,?) ,XIC(out_WireData[0].TinningInspect_PASS) RES(TrackingCTR[3]) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Alarm[3].Active)XIC(FaultReset)RES(TrackingCTR[3]);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[OVERALL GOOD/REJECT]]>
</Comment>
<Text>
<![CDATA[[XIC(out_WireData[0].Length_PASS) ,XIC(WireFeed_SM.Status.State[17]) XIC(Bypass_WireLengthCheck) ]ONS(OneShotW.12)OTL(out_WireData[0].GOOD);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(WireReject_Manual) ,XIC(out_WireData[0].Length_FAIL) XIO(Bypass_WireLengthCheck) ONS(OneShotW.13) ,XIC(out_WireData[0].StripInspect_COMPLETE) XIC(out_WireData[0].StripInspect_FAIL) XIO(Bypass_BareWireInspect) ONS(OneShotW.14) ,XIC(out_WireData[0].TinningInspect_COMPLETE) XIC(out_WireData[0].TinningInspect_FAIL) XIO(Bypass_TinnedWireInspect) ONS(OneShotW.15) ,XIC(Robot01_Wire_SM.Control.Bit[17]) ]OTL(out_WireData[0].REJECT)OTU(out_WireData[0].GOOD);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(out_WireData[0].GOOD)XIO(out_WireData[0].REJECT)OTE(WIRE_GOOD);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIO(out_WireData[0].GOOD)XIC(out_WireData[0].REJECT)OTE(WIRE_REJECT);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[CALL SUBPROGRAMS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[JSR(PCBTracking,0);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
