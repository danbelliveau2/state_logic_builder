<Rung Number="36" Type="N">
<Text>
<![CDATA[[XIC(WireFeed_SM.Status.State[16]) ,XIC(WireFeed_SM.Control.Bit[1]) ]XIO(in_ResetWireFeed_InitSeq)XIO(ResetWireFeed)OTE(WireFeed_SM.Control.Bit[1]);]]>
