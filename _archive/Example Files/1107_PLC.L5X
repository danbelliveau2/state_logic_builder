<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Wire Puller Servo Drive Fault]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIC(Axis_Ref_Ctrl_Sts.Faulted)CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Wire Puller: Cutter Not Extended]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_WireCutter_Cyl.Fault_1) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Wire Puller: Cutter Not Retracted]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_WireCutter_Cyl.Fault_2) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Wire Puller Servo: Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_s01WirePuller2_EIP.ComOK) XIO(AOI_K5100_WirePuller_MAH.Sts_EN) TON(WireFeed_SM.Control.Timer[0],?,?) XIC(WireFeed_SM.Control.Timer[0].DN) XIO(Axis_Ref_Ctrl_Sts.Homed) ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[X Axis MAM Instruction Error]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_K5100_WirePuller_MAM.Sts_ER)ONS(WireFeed_SM.Control.OS[4])OTE(MAM_ERR_PLS);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(MAM_ERR_PLS) ,XIC(MAM_ERR_HOLD) ]XIO(FaultReset)XIC(AOI_K5100_WirePuller_MAM.Sts_ER)OTE(MAM_ERR_HOLD);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(MAM_ERR_HOLD)TON(WireFeed_SM.Control.Timer[2],?,?)XIC(WireFeed_SM.Control.Timer[2].DN)CONCAT(StationName,AlarmText[4],Alarm[4].Message)OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(MAM_ERR_HOLD)ONS(WireFeed_SM.Control.OS[5])[COP(MAM_ERR[0],ErrorCode_Temp[1],15) COP(ErrorCode_Temp[1],MAM_ERR[1],15) MOVE(AOI_K5100_WirePuller_MAM.Sts_ERR,MAM_ERR[0]) ,COP(MAM_ERR_State[0],ErrorCode_Temp[1],15) COP(ErrorCode_Temp[1],MAM_ERR_State[1],15) MOVE(WireFeed_SM.Control.StateReg,MAM_ERR_State[0]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Faults]]>
</Comment>
<Text>
<![CDATA[[AFI() ,XIC(Alarm[5].Active) XIO(FaultReset) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Faults]]>
</Comment>
<Text>
<![CDATA[[AFI() ,XIC(Alarm[6].Active) XIO(FaultReset) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[7].Active) XIO(FaultReset) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Warning]]>
</Comment>
<Text>
<![CDATA[AFI()OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(Lockout_WireFeed)ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INPUTS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_WireCutter_Cyl.Confirm_1)OTE(WireCutter_CLSD);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AOI_WireCutter_Cyl.Confirm_2)OTE(WireCutter_OPEN);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(WirePullerEncoder:I.ProcessDataIn.Counter,EncoderCNT_Live);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(WireFeed_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,WireFeed_SM.Control.StateReg) ,XIC(WireFeed_SM.Status.State[62]) [XIC(WireFeed_SM.Control.Bit[1]) MOVE(StoppedState,WireFeed_SM.Control.StateReg) ,XIO(WireFeed_SM.Control.Bit[1]) MOVE(4,WireFeed_SM.Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[6])OTE(STOPPED);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(WireFeed_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(WireFeed_SM.Status.State[5]) ,XIC(WireFeed_SM.Status.State[61]) ][XIO(Lockout_WireFeed) XIC(CycleStartLatch) ,EQ(HMI_Data.Control.DINT_SP[10],1) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[[XIC(INIT) ,XIC(WireFeed_SM.Status.State[11]) XIC(HMI_Data.Status.MachineInSC) ]MOVE(5,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 6
FEED TEST WIRE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[4])XIC(AOI_s01WirePuller_RC_Zero.In_Range)XIC(WireCutter_OPEN)XIO(WireFeed_SM.Control.Bit[1])XIC(Supervisor_SM.Control.Bit[4])MOVE(6,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 7
WAITING FOR SERVO MOVE COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[6])XIO(Axis_Ref_Ctrl_Sts.ZeroSpeed)MOVE(7,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 8
VERIFY TEST LENGTH]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[7])XIC(AOI_s01WirePuller_RC1.In_Range)XIC(Axis_Ref_Ctrl_Sts.ZeroSpeed)XIC(WireFeed_SM.Status.TransitionTimerDone)MOVE(8,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 9
CUT WIRE - EXTEND (Close)]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(WireFeed_SM.Status.State[8]) ,XIC(WireFeed_SM.Status.State[16]) XIC(CUTandREFEED) ,XIC(WireFeed_SM.Status.State[17]) ,XIC(WireFeed_SM.Status.State[15]) [XIO(AOI_Slippage_RC.In_Range) ,XIO(AOI_Length_RC.In_Range) ] ]XIC(WireFeed_SM.Status.TransitionTimerDone)XIC(Supervisor_SM.Control.Bit[4])MOVE(9,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 10
RETRACT CUTTER (Open)]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[9])XIC(WireCutter_CLSD)XIC(WireFeed_SM.Status.TransitionTimerDone)XIC(Supervisor_SM.Control.Bit[4])MOVE(10,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 11
WIRE CUT COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[10])XIC(WireCutter_OPEN)XIC(WireFeed_SM.Status.TransitionTimerDone)MOVE(11,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 12
READY TO FEED WIRE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[11])XIO(HMI_Data.Status.MachineInSC)XIC(WireFeed_SM.Status.TransitionTimerDone)XIC(AOI_s01WirePuller_RC_Zero.In_Range)MOVE(12,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 13
FEED PROCESS WIRE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[12])XIC(AOI_s01WirePuller_RC_Zero.In_Range)XIC(Supervisor_SM.Control.Bit[4])MOVE(13,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 14
WAITING FOR SERVO MOVE COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[13])XIO(Axis_Ref_Ctrl_Sts.ZeroSpeed)MOVE(14,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 15
VERIFY PROCESS LENGTH]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[14])XIC(AOI_s01WirePuller_RC2.In_Range)XIC(Axis_Ref_Ctrl_Sts.ZeroSpeed)XIC(WireFeed_SM.Status.TransitionTimerDone)MOVE(15,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 16
WAITING FOR ROBOT PICK]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(WireFeed_SM.Status.State[15]) XIC(AOI_Slippage_RC.In_Range) XIC(AOI_Length_RC.In_Range) XIC(WireFeed_SM.Status.TransitionTimerDone) ,XIC(WireFeed_SM.Status.State[4]) XIC(WireCutter_OPEN) XIC(WireFeed_SM.Control.Bit[1]) ]MOVE(16,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 17
WIRE HAS BEEN PICKED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[16])[XIC(Robot01_Wire_SM.Control.Bit[3]) ,XIC(HMI_Data.Status.MachineInSC) ]MOVE(17,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(WireFeed_SM.Status.State[5])XIC(Lockout_WireFeed)XIC(CycleStartLatch)MOVE(61,WireFeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(WireFeed_SM.Status.State[12]) ,XIC(WireFeed_SM.Status.State[14]) ,XIC(WireFeed_SM.Status.State[15]) ,XIC(WireFeed_SM.Status.State[16]) ] [XIC(Robot01_Wire_SM.Status.State[62]) ,XIC(Robot01_Wire_SM.Status.State[63]) ] ,XIC(WireFeed_SM.Status.State[61]) ]XIO(HMI_Data.Status.MachineInSC)XIO(CycleStartLatch)[ONS(WireFeed_SM.Control.OS[1]) MOVE(WireFeed_SM.Control.StateReg,StoppedState) ,MOVE(62,WireFeed_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(WireFeed_SM.Control.OS[0]) MOVE(WireFeed_SM.Control.StateReg,FaultedState) ,MOVE(63,WireFeed_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_WireFeed_SM,WireFeed_SM);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(WireFeed_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[[XIC(WireFeed_SM.Status.State[7]) ,XIC(WireFeed_SM.Status.State[11]) ,XIC(WireFeed_SM.Status.State[14]) ] MOVE(500,WireFeed_SM.Control.TransitionTime) ,[XIC(WireFeed_SM.Status.State[8]) ,XIC(WireFeed_SM.Status.State[9]) ,XIC(WireFeed_SM.Status.State[10]) ,XIC(WireFeed_SM.Status.State[15]) ,XIC(WireFeed_SM.Status.State[16]) ,XIC(WireFeed_SM.Status.State[17]) ] MOVE(100,WireFeed_SM.Control.TransitionTime) ]OTE(WireFeed_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(5000,WireFeed_SM.Control.FaultTime)OTE(WireFeed_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[
STATE LOGIC ACTIONS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[CONTROL BITS]]>
</Comment>
<Text>
<![CDATA[XIC(WireCutter_OPEN)XIC(Axis_Ref_Ctrl_Sts.Ready)OTE(WireFeed_SM.Control.Bit[0]);]]>
