<![CDATA[Device Interface - K5100]]>
</Description>
<Members>
<Member Name="bInhibit" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit overlay for external access restriction.]]>
</Description>
</Member>
