</Description>
</Member>
<Member Name="PositionCommandOverride" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZraC_UDT_It5" BitNumber="1" ExternalAccess="Read/Write">
<Description>
<![CDATA[Allows interruption of current movement; replacing it with a new movement.]]>
</Description>
</Member>
<Member Name="CapturedPositionSelect" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZraC_UDT_It5" BitNumber="2" ExternalAccess="Read/Write">
<Description>
<![CDATA[Capture position selection (First capture or second capture).]]>
</Description>
</Member>
<Member Name="Position" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Determines the command position.]]>
</Description>
</Member>
<Member Name="Velocity" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Determines the command speed.]]>
