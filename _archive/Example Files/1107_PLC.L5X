<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Skimmer]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_SolderPotTOOL_Cyl.Fault_1) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(AOI_SolderPotTOOL_Cyl.Fault_2) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Lift]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_SolderPotLIFT_Cyl.Fault_1) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(in_Safety.OK) XIC(AOI_SolderPotLIFT_Cyl.Fault_2) ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Solder Level]]>
</Comment>
<Text>
<![CDATA[[XIO(SolderLevelOK) AFI() ,XIC(Alarm[4].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[4],Alarm[4].Message)OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
