<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[3 Consecutive Wire Length Fails]]>
</Comment>
<Text>
<![CDATA[[XIC(TrackingCTR[0].DN) ,XIC(Alarm[0].Active) XIO(FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[3 Consecutive 'Missing PCB' at Regrip]]>
</Comment>
<Text>
<![CDATA[[XIC(TrackingCTR[1].DN) ,XIC(Alarm[1].Active) XIO(FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[3 Consecutive Bare Wire Inspection Fails]]>
</Comment>
<Text>
<![CDATA[[XIC(TrackingCTR[2].DN) ,XIC(Alarm[2].Active) XIO(FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[3 Consecutive Tinned Wire Inspection Fails]]>
</Comment>
<Text>
<![CDATA[[XIC(TrackingCTR[3].DN) ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[3 Consecutive PCB Solder Inspection Fails]]>
</Comment>
<Text>
<![CDATA[[XIC(TrackingCTR[4].DN) ,XIC(Alarm[4].Active) XIO(FaultReset) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[3 Consecutive PCB Epoxy Inspection Fails]]>
</Comment>
<Text>
<![CDATA[[XIC(TrackingCTR[5].DN) ,XIC(Alarm[5].Active) XIO(FaultReset) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Warning]]>
</Comment>
<Text>
<![CDATA[AFI()OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PCBTracking" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[The PCB 'ID' is a number from 1-48 based on it's position in the Infeed Tray

Upon picking a PCB from the Infeed Tray,
clear the data from the [ID] index of the data array.

]]>
</Comment>
<Text>
<![CDATA[XIC(Robot02_PCB_SM.Status.State[25])XIC(Robot02_PCB_SM.Control.Bit[13])ONS(OneShotP.0)CPS(NULL_PCBData,out_PCBData[ID],1)MOVE(ID,out_PCBData[ID].PCB_ID);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQ(ID,Cure1_ID)EQ(Cure2_ID,Cure3_ID)EQ(Camera_ID,PCB_Nest_ID)NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Archive the data for the currect PCB to a different array
once it is placed in the Outfeed Dial or the Reject Rack]]>
</Comment>
<Text>
<![CDATA[[XIC(Robot02_PCB_SM.Status.State[21]) ,XIC(Robot02_PCB_SM.Status.State[23]) ]XIC(Robot02_PCB_SM.Control.Bit[12])ONS(OneShotP.9)CPS(PCBData_Arch[0],PCBDataTEMP[0],47)CPS(out_PCBData[ID],PCBData_Arch[0],1)CPS(PCBDataTEMP[0],PCBData_Arch[1],47)OTE(PCB_DataReset_PLS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[A PCB is 'In Process' if it is breing held by the robot or
if it is in the PCB Solder nest or in the PCB Inspection station]]>
</Comment>
<Text>
<![CDATA[XIO(Robot02_PCB_SM.Status.State[26])XIO(Robot02_PCB_SM.Status.State[27])XIC(Robot02_PCB_SM.Control.Bit[12])ONS(OneShotP.15)OTE(PCB_DropOff);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[XIC(Robot02_PCB_SM.Status.State[31]) ,XIC(Robot02_PCB_SM.Status.State[13]) ,XIC(Robot02_PCB_SM.Status.State[25]) ,XIC(Robot02_PCB_SM.Status.State[19]) ,XIC(Robot02_PCB_SM.Status.State[39]) ] XIC(Robot02_PCB_SM.Control.Bit[13]) ONS(OneShotP.14) ,XIC(Supervisor_SM.Control.Bit[8]) ]XIO(PCB_DropOff)OTE(Supervisor_SM.Control.Bit[8]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(HMI_Data.Control.Button[75]) ,XIC(PCBReject_Manual) ]XIC(Supervisor_SM.Control.Bit[8])OTE(PCBReject_Manual);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[PARTS IN MACHINE
Used to keep machine running in Cleanout mode
until the machine is empty]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Control.Bit[8]) ,XIC(PCB_Solder_SM.Control.Bit[24]) ,XIC(PCB_Inspection_SM.Control.Bit[4]) ,XIC(PCB_Inspection_SM.Control.Bit[8]) ,XIC(EpoxyCure_1_SM.Control.Bit[8]) ,XIC(EpoxyCure_2_SM.Control.Bit[8]) ,XIC(EpoxyCure_3_SM.Control.Bit[8]) ]TOF(Supervisor_SM.Control.Timer[1],?,?);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Control.Timer[1].DN)OTE(Supervisor_SM.Control.Bit[6]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(EpoxyCure_1_SM.Control.Bit[9])XIC(EpoxyCure_2_SM.Control.Bit[9])XIC(EpoxyCure_3_SM.Control.Bit[9])NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Regrip]]>
</Comment>
<Text>
<![CDATA[XIC(Robot02_PCB_SM.Status.State[27])[[XIC(\Regrip.PCB_Present_Inboard) ,XIC(\Regrip.PCB_Present_Outboard) ] TON(Debounce[0],?,?) XIC(Debounce[0].DN) ONS(OneShotP.1) OTL(out_PCBData[ID].Present_PASS) RES(TrackingCTR[1]) ,XIC(Robot02_PCB_SM.Control.Bit[11]) ONS(OneShotP.2) OTL(out_PCBData[ID].Missing_FAIL) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Track consecutive missing PCB's at Regrip]]>
</Comment>
<Text>
<![CDATA[[XIC(Robot02_PCB_SM.Status.State[27]) ,XIC(Robot02_PCB_SM.Status.State[62]) ]XIC(out_PCBData[ID].Missing_FAIL)ONS(OneShotP.3)CTU(TrackingCTR[1],?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Alarm[1].Active)XIC(FaultReset)RES(TrackingCTR[1]);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Record PCB Orientation]]>
</Comment>
<Text>
<![CDATA[XIC(Robot02_PCB_SM.Status.State[27])XIC(Regrip_SM.Control.Bit[6])ONS(OneShotP.4)OTL(out_PCBData[ID].RevOrient);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[PCB Solder Inspection]]>
</Comment>
<Text>
<![CDATA[XIC(Vision_SM.Status.State[44])ONS(OneShotP.5)[XIC(\Vision.PCB_Solder_OK) OTL(out_PCBData[Camera_ID].SolderInspect_PASS) OTU(out_PCBData[Camera_ID].SolderInspect_FAIL) ,XIO(\Vision.PCB_Solder_OK) OTU(out_PCBData[Camera_ID].SolderInspect_PASS) OTL(out_PCBData[Camera_ID].SolderInspect_FAIL) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[PCB Solder Inspection has been completed]]>
</Comment>
<Text>
<![CDATA[XIC(PCB_Inspection_SM.Status.State[13])XIC(Robot02_PCB_SM.Status.State[37])ONS(OneShotP.6)[XIC(out_PCBData[Camera_ID].SolderInspect_FAIL) XIO(Bypass_PCBSolderInspect) CTU(TrackingCTR[4],?,?) ,XIC(out_PCBData[Camera_ID].SolderInspect_PASS) RES(TrackingCTR[4]) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Alarm[4].Active)XIC(FaultReset)RES(TrackingCTR[4]);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[PCB Epoxy Inspection]]>
</Comment>
<Text>
<![CDATA[XIC(Vision_SM.Status.State[54])ONS(OneShotP.7)[XIC(\Vision.Epoxy_OK) OTL(out_PCBData[Camera_ID].EpoxyInspect_PASS) OTU(out_PCBData[Camera_ID].EpoxyInspect_FAIL) ,XIO(\Vision.Epoxy_OK) OTU(out_PCBData[Camera_ID].EpoxyInspect_PASS) OTL(out_PCBData[Camera_ID].EpoxyInspect_FAIL) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[PCB Epoxy Inspection has been completed]]>
</Comment>
<Text>
<![CDATA[XIC(PCB_Inspection_SM.Status.State[13])XIC(Robot02_PCB_SM.Status.State[17])ONS(OneShotP.8)[XIC(out_PCBData[Camera_ID].EpoxyInspect_FAIL) XIO(Bypass_EpoxyInspect) CTU(TrackingCTR[5],?,?) ,XIC(out_PCBData[Camera_ID].EpoxyInspect_PASS) RES(TrackingCTR[5]) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Alarm[5].Active)XIC(FaultReset)RES(TrackingCTR[5]);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[OVERALL GOOD/REJECT]]>
</Comment>
<Text>
<![CDATA[XIC(Robot02_PCB_SM.Status.State[27])XIC(out_PCBData[ID].Present_PASS)ONS(OneShotP.10)OTL(out_PCBData[ID].GOOD);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[AFI() XIC(PCBReject_Manual) ,XIC(Robot02_PCB_SM.Status.State[27]) XIC(out_PCBData[Camera_ID].Missing_FAIL) ONS(OneShotP.11) ,XIC(PCB_Inspection_SM.Status.State[13]) XIC(PCB_Inspection_SM.Control.Bit[4]) XIC(out_PCBData[Camera_ID].SolderInspect_FAIL) XIO(Bypass_PCBSolderInspect) ONS(OneShotP.12) ,XIC(PCB_Inspection_SM.Status.State[13]) XIC(PCB_Inspection_SM.Control.Bit[8]) XIC(out_PCBData[Camera_ID].EpoxyInspect_FAIL) XIO(Bypass_EpoxyInspect) ONS(OneShotP.13) ]OTL(out_PCBData[Camera_ID].REJECT)OTU(out_PCBData[Camera_ID].GOOD);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(Robot02_PCB_SM.Status.State[31]) [LIMIT(HMI_Data.Control.REAL_SP[7],out_PCBData[PCB_Nest_ID].FinalWire_LOC,HMI_Data.Control.REAL_SP[8]) ,XIO(out_PCBData[PCB_Nest_ID].WireLocFind_PASS) ] ONS(OneShotP.16) ,AFI() XIC(PCB_Solder_SM.Control.Bit[20]) XIC(PCB_Solder_SM.Status.State[63]) ONS(OneShotP.17) ]OTL(out_PCBData[PCB_Nest_ID].REJECT)OTU(out_PCBData[PCB_Nest_ID].GOOD);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(out_PCBData[ID].GOOD)XIO(out_PCBData[ID].REJECT)OTE(PCB_GOOD);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIO(out_PCBData[ID].GOOD)XIC(out_PCBData[ID].REJECT)OTE(PCB_REJECT);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Manual Reject of PCB's in Cure Drawers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Data.Control.Button[76])XIC(EpoxyCure_1_SM.Control.Bit[8])OTL(out_PCBData[Cure1_ID].REJECT)OTU(out_PCBData[Cure1_ID].GOOD);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.Control.Button[77])XIC(EpoxyCure_2_SM.Control.Bit[8])OTL(out_PCBData[Cure2_ID].REJECT)OTU(out_PCBData[Cure2_ID].GOOD);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.Control.Button[78])XIC(EpoxyCure_3_SM.Control.Bit[8])OTL(out_PCBData[Cure3_ID].REJECT)OTU(out_PCBData[Cure3_ID].GOOD);]]>
</Text>
</Rung>
