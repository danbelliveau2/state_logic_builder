<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ESTOP Active]]>
</Comment>
<Text>
<![CDATA[XIO(in_Safety.EStopOK)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Servo STO Circuit]]>
</Comment>
<Text>
<![CDATA[XIO(in_Safety.GuardOK)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Loss Of EIP Communication Faults]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.PowerUpCP)[XIO(AOI_s01WirePuller2_EIP.ComOK) OTE(Alarm[2].Active) ,XIO(AOI_s02_X_axis_EIP.ComOK) OTE(Alarm[3].Active) ,XIO(AOI_s03_Y_axis_EIP.ComOK) OTE(Alarm[4].Active) ,XIO(AOI_s04_Z_axis_EIP.ComOK) OTE(Alarm[5].Active) ,XIO(AOI_s05OutfeedDial_EIP.ComOK) OTE(Alarm[6].Active) ,XIO(AOI_v01WireSpool_EIP.ComOK) OTE(Alarm[7].Active) ,XIO(AOI_v02HeatShrinkSpool_EIP.ComOK) OTE(Alarm[8].Active) ,XIO(AOI_r01Robot_WireHandling_EIP.ComOK) OTE(Alarm[9].Active) ,XIO(AOI_r02Robot_PCBHandling_EIP.ComOK) OTE(Alarm[10].Active) ,XIO(AOI_IOLM_HubsMaster_EIP.ComOK) OTE(Alarm[11].Active) ,XIO(AOI_IOLM_WirePrepMaster_EIP.ComOK) OTE(Alarm[12].Active) ,XIO(AOI_c01VisionCtrl_EIP.ComOK) XIO(Lockout_Vision) OTE(Alarm[13].Active) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Cycle Start Attmempt without Startup Conditions Met]]>
</Comment>
<Text>
<![CDATA[AFI()[XIC(DIN1_1_CycleStartPB) ,XIC(CycleStart_HMI) ][XIC(Supervisor_SM.Status.State[4]) XIO(Supervisor_SM.Control.Bit[0]) ,XIC(Supervisor_SM.Status.State[6]) ]OTE(Alarm[14].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Air Supply Pressure Too Low]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIO(DIN1_0_AirPressure_OK)OTE(Alarm[15].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Guard Door Open]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIO(in_Safety.GuardOK)OTE(Alarm[16].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Machine Basic - Flashers, Always On, ect.]]>
</Comment>
<Text>
<![CDATA[AOI_MachineBasic(AOI_MachineBasic,MachineRunning,MachineBasic);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Get Date & Time]]>
</Comment>
<Text>
<![CDATA[CPU_TimeDate_wJulian(AOI_CPUDateTime,CPUDateTime);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Fault Reset]]>
</Comment>
<Text>
<![CDATA[[XIC(DIN1_3_FaultResetPB) ,XIC(FaultReset_HMI) ]OTE(FaultReset)ONS(OneShot.0)OTE(out_FaultReset);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Reset All Machine Counts]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Data.MOMButtons[18])TON(CountHoldTimers[8],?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[LIGHTING]]>
</Comment>
<Text>
<![CDATA[XIC(TaskLight_ON)XIO(Supervisor_SM.Status.State[5])OTE(DOUT1_11_TaskLight);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Subroutines]]>
</Comment>
<Text>
<![CDATA[JSR(StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[JSR(ProductionData_SUB,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[JSR(ShiftData_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ProductionData_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Production Data - Uses Array Index 0

Good Counts]]>
</Comment>
<Text>
<![CDATA[XIO(Robot02_PCB_SM.Status.State[21])XIO(s:FS)ONS(Supervisor_SM.Control.OS[6])[ADD(ProductionData[0].Good,1,ProductionData[0].Good) ,ADD(HMI_Data.Status.BatchCount,1,HMI_Data.Status.BatchCount) ]OTE(GoodPart_PLS);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.Control.Button[105])MOVE(0,HMI_Data.Status.BatchCount);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Reject PCB Counts]]>
</Comment>
<Text>
<![CDATA[XIO(Robot02_PCB_SM.Status.State[23])XIO(s:FS)ONS(Supervisor_SM.Control.OS[7])ADD(ProductionData[0].Reject,1,ProductionData[0].Reject)OTE(RejectPart_PLS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Reject WIRE Counts]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.WIRE_REJECT)ONS(Supervisor_SM.Control.OS[12])ADD(RejectWIRE_Count,1,RejectWIRE_Count);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Total Counts]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ADD(ProductionData[0].Good,ProductionData[0].Reject,ProductionData[0].Total);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[0].GoodPercent,(ProductionData[0].Good/ProductionData[0].Total)*100);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[0].RejectPercent,(ProductionData[0].Reject/ProductionData[0].Total)*100);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)[RTO(CycleRuntime_TMR,?,?) ,XIC(CycleRuntime_TMR.DN) ADD(ProductionData[0].RuntimeSec,1,ProductionData[0].RuntimeSec) DIV(ProductionData[0].RuntimeSec,60,ProductionData[0].RuntimeMin) RES(CycleRuntime_TMR) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[MUL(ProductionData[0].RuntimeSec,1000,RuntimeSecScaledA);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(MachineRunning)[RTO(CycleDowntime_TMR,?,?) ,XIC(CycleDowntime_TMR.DN) ADD(ProductionData[0].DowntimeSec,1,ProductionData[0].DowntimeSec) DIV(ProductionData[0].DowntimeSec,60,ProductionData[0].DowntimeMin) RES(CycleDowntime_TMR) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MUL(ProductionData[0].DowntimeSec,1000,DowntimeSecScaledA);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ADD(ProductionData[0].RuntimeMin,ProductionData[0].DowntimeMin,ProductionData[0].ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[0].GoodRate,(ProductionData[0].Good/ProductionData[0].RuntimeMin));]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[OEE AOI]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[AOI_OEE(AOI_Production_OEE,0.3,ProductionData[0].Total,ProductionData[0].Good,480.0,480.0,RuntimeSecScaledA,DowntimeSecScaledA) ,MOVE(AOI_Production_OEE.Availability,ProductionData[0].RuntimeEff) ,MOVE(AOI_Production_OEE.Performance,ProductionData[0].CycleEff) ,MOVE(AOI_Production_OEE.OEE,ProductionData[0].OEE) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIC(MachineFaultActive)ONS(Supervisor_SM.Control.OS[8])ADD(ProductionData[0].TotalFaults,1,ProductionData[0].TotalFaults);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Reset Total Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.Control.ResetPartCounts) TON(CountHoldTimers[1],?,?) XIC(CountHoldTimers[1].DN) ,XIC(CountHoldTimers[8].DN) ][COP(EmptyProductionData,ProductionData[0],1) ,MOVE(0,RejectWIRE_Count) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ShiftData_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Shift Data - Uses Array Indexes 1,2,3

Calculate Shift Number]]>
</Comment>
<Text>
<![CDATA[[EQ(CPUDateTime.Hour,7) EQ(CPUDateTime.Minutes,0) ONS(Supervisor_SM.Control.OS[9]) MOVE(1,CurrentShift) MOVE(3,PreviousShift) ,EQ(CPUDateTime.Hour,15) EQ(CPUDateTime.Minutes,0) ONS(Supervisor_SM.Control.OS[10]) MOVE(2,CurrentShift) MOVE(1,PreviousShift) ,EQ(CPUDateTime.Hour,23) EQ(CPUDateTime.Minutes,0) ONS(Supervisor_SM.Control.OS[11]) MOVE(3,CurrentShift) MOVE(2,PreviousShift) ]OTE(ShiftChangedPulse);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(ShiftChangedPulse)COP(EmptyProductionData,ProductionData[CurrentShift],1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Good Counts]]>
</Comment>
<Text>
<![CDATA[XIC(GoodPart_PLS)ADD(ProductionData[CurrentShift].Good,1,ProductionData[CurrentShift].Good);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Reject Counts]]>
</Comment>
<Text>
<![CDATA[XIC(RejectPart_PLS)ADD(ProductionData[CurrentShift].Reject,1,ProductionData[CurrentShift].Reject);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Total Counts]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ADD(ProductionData[CurrentShift].Good,ProductionData[CurrentShift].Reject,ProductionData[CurrentShift].Total);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[CurrentShift].GoodPercent,(ProductionData[CurrentShift].Good/ProductionData[CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[CurrentShift].RejectPercent,(ProductionData[CurrentShift].Reject/ProductionData[CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)[RTO(ShiftRuntime_TMR,?,?) ,XIC(ShiftRuntime_TMR.DN) ADD(ProductionData[CurrentShift].RuntimeSec,1,ProductionData[CurrentShift].RuntimeSec) DIV(ProductionData[CurrentShift].RuntimeSec,60,ProductionData[CurrentShift].RuntimeMin) RES(ShiftRuntime_TMR) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[MUL(ProductionData[CurrentShift].RuntimeSec,1000,RunTimeSecScaled);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(MachineRunning)[RTO(ShiftDowntime_TMR,?,?) ,XIC(ShiftDowntime_TMR.DN) ADD(ProductionData[CurrentShift].DowntimeSec,1,ProductionData[CurrentShift].DowntimeSec) DIV(ProductionData[CurrentShift].DowntimeSec,60,ProductionData[CurrentShift].DowntimeMin) RES(ShiftDowntime_TMR) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MUL(ProductionData[CurrentShift].DowntimeSec,1000,DowntimeSecScaled);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ADD(ProductionData[CurrentShift].RuntimeMin,ProductionData[CurrentShift].DowntimeMin,ProductionData[CurrentShift].ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[CurrentShift].GoodRate,(ProductionData[CurrentShift].Good/ProductionData[CurrentShift].RuntimeMin));]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[OEE AOI]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[AOI_OEE(AOI_Shift_OEE,0.3,ProductionData[CurrentShift].Total,ProductionData[CurrentShift].Good,480.0,480.0,RunTimeSecScaled,DowntimeSecScaled) ,MOVE(AOI_Shift_OEE.Availability,ProductionData[CurrentShift].RuntimeEff) ,MOVE(AOI_Shift_OEE.Performance,ProductionData[CurrentShift].CycleEff) ,MOVE(AOI_Shift_OEE.OEE,ProductionData[CurrentShift].OEE) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIC(MachineFaultActive)ONS(Supervisor_SM.Control.OS[14])ADD(ProductionData[CurrentShift].TotalFaults,1,ProductionData[CurrentShift].TotalFaults);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Reset Current Shift Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.Control.ResetCurrentShift) TON(CountHoldTimers[6],?,?) XIC(CountHoldTimers[6].DN) ,XIC(CountHoldTimers[8].DN) ]COP(EmptyProductionData,ProductionData[CurrentShift],1);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Reset All Shift Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.Control.ResetAllShift) TON(CountHoldTimers[7],?,?) XIC(CountHoldTimers[7].DN) ,XIC(CountHoldTimers[8].DN) ]COP(EmptyProductionData,ProductionData[1],1)COP(EmptyProductionData,ProductionData[2],1)COP(EmptyProductionData,ProductionData[3],1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
SUPERVISOR - STATE MACHINE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Supervisor State Machine

]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(Supervisor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[STATE 0: FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIO(in_Safety.EStopOK)MOVE(0,Supervisor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[STATE 1: IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[0])XIC(in_Safety.EStopOK)MOVE(1,Supervisor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STATE 3: MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[1]) ,XIC(Supervisor_SM.Status.State[5]) XIC(Supervisor_SM.Control.Bit[0]) ,XIC(Supervisor_SM.Status.State[6]) ,XIC(Supervisor_SM.Status.State[7]) XIO(Supervisor_SM.Control.Bit[10]) ]XIO(HMI_Data.Control.Mode)MOVE(3,Supervisor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 4: AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[1]) ,XIC(Supervisor_SM.Status.State[3]) ,XIC(Supervisor_SM.Status.State[6]) XIC(CycleStartLatch) ,XIC(Supervisor_SM.Status.State[7]) XIO(Supervisor_SM.Control.Bit[10]) ]XIC(HMI_Data.Control.Mode)XIO(RESTART)MOVE(4,Supervisor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 5: AUTO READY]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) XIC(Supervisor_SM.Control.Bit[0]) ,XIC(Supervisor_SM.Status.State[6]) XIC(CycleStartLatch) XIC(RESTART) ]MOVE(5,Supervisor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 6: CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIO(CycleStartLatch)XIC(Supervisor_SM.Control.Bit[1])MOVE(6,Supervisor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 7: LEVEL 1 FAULT ACTIVE]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)XIC(in_Safety.OK)XIC(Supervisor_SM.Control.Bit[10])MOVE(7,Supervisor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_Supervisor_SM,Supervisor_SM);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Dereeler_SM.Status.State[5])XIC(WireFeed_SM.Status.State[5])XIC(HeatShrink_SM.Status.State[5])XIC(FluxTank_SM.Status.State[5])XIC(SolderPot_SM.Status.State[5])XIC(PCB_Solder_SM.Status.State[5])XIC(PCB_Clean_SM.Status.State[5])XIC(PCB_Inspection_SM.Status.State[5])XIC(Epoxy_Dispense_SM.Status.State[5])XIC(EpoxyCure_1_SM.Status.State[5])XIC(Infeed_SM.Status.State[5])XIC(Regrip_SM.Status.State[5])XIC(Outfeed_SM.Status.State[5])XIC(Robot01_Wire_SM.Status.State[5])XIC(Robot02_PCB_SM.Status.State[5])XIC(Vision_SM.Status.State[5])OTE(Supervisor_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(Dereeler_SM.Status.State[62]) ,XIC(Dereeler_SM.Status.State[63]) ][XIC(WireFeed_SM.Status.State[62]) ,XIC(WireFeed_SM.Status.State[63]) ][XIC(HeatShrink_SM.Status.State[62]) ,XIC(HeatShrink_SM.Status.State[63]) ][XIC(FluxTank_SM.Status.State[62]) ,XIC(FluxTank_SM.Status.State[63]) ][XIC(SolderPot_SM.Status.State[62]) ,XIC(SolderPot_SM.Status.State[63]) ][XIC(PCB_Solder_SM.Status.State[62]) ,XIC(PCB_Solder_SM.Status.State[63]) ][XIC(PCB_Clean_SM.Status.State[62]) ,XIC(PCB_Clean_SM.Status.State[63]) ][XIC(PCB_Inspection_SM.Status.State[62]) ,XIC(PCB_Inspection_SM.Status.State[63]) ][XIC(Epoxy_Dispense_SM.Status.State[62]) ,XIC(Epoxy_Dispense_SM.Status.State[63]) ][XIC(EpoxyCure_1_SM.Status.State[62]) ,XIC(EpoxyCure_1_SM.Status.State[63]) ][XIC(EpoxyCure_2_SM.Status.State[62]) ,XIC(EpoxyCure_2_SM.Status.State[63]) ][XIC(EpoxyCure_3_SM.Status.State[62]) ,XIC(EpoxyCure_3_SM.Status.State[63]) ][XIC(Infeed_SM.Status.State[62]) ,XIC(Infeed_SM.Status.State[63]) ][XIC(Regrip_SM.Status.State[62]) ,XIC(Regrip_SM.Status.State[63]) ][XIC(Outfeed_SM.Status.State[62]) ,XIC(Outfeed_SM.Status.State[63]) ][XIC(Robot01_Wire_SM.Status.State[62]) ,XIC(Robot01_Wire_SM.Status.State[63]) ][XIC(Robot02_PCB_SM.Status.State[62]) ,XIC(Robot02_PCB_SM.Status.State[63]) ][XIC(Vision_SM.Status.State[62]) ,XIC(Vision_SM.Status.State[63]) ]OTE(Supervisor_SM.Control.Bit[1]);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Single Cycle Control]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.Control.EnableSC) XIC(Supervisor_SM.Control.Bit[0]) ,XIC(HMI_Data.Status.MachineInSC) ]XIO(MachineRunning)XIO(CycleStartLatch)XIO(Supervisor_SM.Control.Bit[2])XIC(in_Safety.OK)OTE(HMI_Data.Status.MachineInSC);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(HMI_Data.Control.DisableSC) XIC(Supervisor_SM.Control.Bit[0]) ,XIO(Supervisor_SM.Status.State[5]) ]OTE(Supervisor_SM.Control.Bit[2]);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.Status.MachineInSC)[XIC(HMI_Data.Control.Button[100]) ,XIC(DIN1_1_CycleStartPB) XIC(HMI_Data.Status.MachineInSC) ]ONS(Supervisor_SM.Control.OS[1])OTE(Supervisor_SM.Control.Bit[3]);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(HMI_Data.Status.MachineInSC) [XIC(Supervisor_SM.Control.Bit[3]) ,XIC(SingleStep_ADVANCE) ] ,XIO(HMI_Data.Status.MachineInSC) ]OTE(Supervisor_SM.Control.Bit[4]);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Auto Pre-Conditions]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Data.Control.Mode)XIO(MachineFaultActive)[XIC(Dereeler_SM.Status.AutoPreOK) ,XIC(Lockout_Dereeler) ][XIC(WireFeed_SM.Status.AutoPreOK) ,XIC(Lockout_WireFeed) ][XIC(HeatShrink_SM.Status.AutoPreOK) ,XIC(Lockout_HeatShrink) ][XIC(FluxTank_SM.Status.AutoPreOK) ,XIC(Lockout_FluxTank) ][XIC(SolderPot_SM.Status.AutoPreOK) ,XIC(Lockout_SolderPot) ][XIC(PCB_Solder_SM.Status.AutoPreOK) ,XIC(Lockout_PCB_Solder) ][XIC(PCB_Clean_SM.Status.AutoPreOK) ,XIC(Lockout_PCB_Clean) ][XIC(PCB_Inspection_SM.Status.AutoPreOK) ,XIC(Lockout_PCB_Inspection) ][XIC(Epoxy_Dispense_SM.Status.AutoPreOK) ,XIC(Lockout_Epoxy_Dispense) ][XIC(EpoxyCure_1_SM.Status.AutoPreOK) ,XIC(Lockout_EpoxyCure_1) ][XIC(EpoxyCure_2_SM.Status.AutoPreOK) ,XIC(Lockout_EpoxyCure_2) ][XIC(EpoxyCure_3_SM.Status.AutoPreOK) ,XIC(Lockout_EpoxyCure_3) ][XIC(Infeed_SM.Status.AutoPreOK) ,XIC(Lockout_Infeed) ][XIC(Regrip_SM.Status.AutoPreOK) ,XIC(Lockout_Regrip) ][XIC(Outfeed_SM.Status.AutoPreOK) ,XIC(Lockout_Outfeed) ][XIC(Robot01_Wire_SM.Status.AutoPreOK) ,XIC(Lockout_Robot01_Wire) ][XIC(Robot02_PCB_SM.Status.AutoPreOK) ,XIC(Lockout_Robot02_PCB) ][XIC(Vision_SM.Status.AutoPreOK) ,XIC(Lockout_Vision) ]XIO(HMI_Data.Status.MachineInSC)[XIC(Supervisor_SM.Control.Bit[0]) ,XIC(Supervisor_SM.Control.Bit[1]) ][LT(HMI_Data.Status.BatchCount,HMI_Data.Control.BatchSetpoint) ,EQ(HMI_Data.Control.BatchSetpoint,0) ]OTE(AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Cycle Start Control]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) ,XIC(Supervisor_SM.Status.State[6]) ][[XIC(DIN1_1_CycleStartPB) ,XIC(CycleStart_HMI) ,XIC(FaultReset_HMI) AFI() ] XIO(MachineRunning) XIC(AutoPreOK) ,XIC(Supervisor_SM.Control.Timer[0].EN) ]XIC(DIN1_2_CycleStopPB)XIO(CycleStop_HMI)XIC(in_Safety.OK)XIO(MachineFaultActive)XIO(Supervisor_SM.Control.Bit[7])TON(Supervisor_SM.Control.Timer[0],?,?)XIC(Supervisor_SM.Control.Timer[0].DN)[OTE(CycleStartLatch) ,OTL(MachineRunning) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Stacklight HORN Control]]>
</Comment>
<Text>
<![CDATA[[XIC(MachineRunning) XIC(MachineFaultActive) ONS(Supervisor_SM.Control.OS[13]) ,XIC(Fault_HORN) ]XIO(Supervisor_SM.Control.Counter[0].DN)XIO(FaultReset)OTE(Fault_HORN);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[MACHINE RUNNING]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[6]) ,XIC(Supervisor_SM.Status.State[7]) ,XIO(in_Safety.OK) ]OTU(MachineRunning);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[6]) ONS(Supervisor_SM.Control.OS[4]) ,XIC(RESTART) ]XIC(HMI_Data.Control.Mode)XIO(HMI_Data.Control.Button[79])XIC(in_Safety.EStopOK)OTE(RESTART);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[CLEANOUT]]>
</Comment>
<Text>
<![CDATA[[[XIC(HMI_Data.Control.Button[42]) ,[XIC(Supervisor_SM.Control.Bit[13]) ,XIC(Supervisor_SM.Control.Bit[14]) ] XIC(CycleStartLatch) ] ONS(Supervisor_SM.Control.OS[5]) ,XIC(CLEANOUT) ][XIC(MachineRunning) ,XIC(Supervisor_SM.Control.Bit[6]) ]OTE(CLEANOUT);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIO(Supervisor_SM.Control.Bit[6])[XIC(CLEANOUT) ,XIC(Infeed_SM.Control.Bit[4]) ONS(Supervisor_SM.Control.OS[15]) ]OTE(Supervisor_SM.Control.Bit[7]);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[CYCLE STOP TIMEOUT
Automatically change to Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIO(MachineBasic.AlwaysOn)XIC(Supervisor_SM.Status.State[6])MUL(HMI_Data.Control.DINT_SP[0],60000,Supervisor_SM.Control.Timer[4].PRE)TON(Supervisor_SM.Control.Timer[4],?,?)XIC(Supervisor_SM.Control.Timer[4].DN)OTU(HMI_Data.Control.Mode);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Initialize Pulse]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Supervisor_SM.Control.Timer[0].EN)ONS(Supervisor_SM.Control.OS[0])OTE(InitializePulse);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Safety Reset Light Control]]>
</Comment>
<Text>
<![CDATA[[XIC(\Safety.ResetNeeded) XIO(in_Safety.EStopOK) XIC(MachineBasic.Flash500msPD) ,XIC(in_Safety.EStopOK) ]OTE(DOUT1_4_SafetyResetLight);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Stack Light Control]]>
</Comment>
<Text>
<![CDATA[[XIC(MachineRunning) ,XIC(Supervisor_SM.Control.Timer[0].TT) XIC(MachineBasic.Flash250msPD) ,XIC(Supervisor_SM.Status.State[6]) XIC(MachineBasic.Flash1sPD) ][OTE(DOUT1_2_Stacklight_GRN) ,OTE(DOUT1_5_CycleStartLight) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[[XIC(MachineWarningActive) ,XIC(Supervisor_SM.Status.State[3]) XIC(in_Safety.OK) ]XIC(MachineBasic.Flash500msPD)OTE(DOUT1_1_Stacklight_YEL);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[[XIO(in_Safety.OK) ,XIC(MachineFaultActive) XIC(MachineBasic.Flash500msPD) ]OTE(DOUT1_0_Stacklight_RED);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Stacklight HORN Control]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[[XIC(Fault_HORN) ,XIC(Debug_HORN) ] TON(Supervisor_SM.Control.Timer[2],?,?) XIC(Supervisor_SM.Control.Timer[2].DN) XIC(MachineBasic.Flash1sPD) CTU(Supervisor_SM.Control.Counter[0],?,?) XIO(Supervisor_SM.Control.Counter[0].DN) ,XIC(Supervisor_SM.Control.Timer[0].TT) ,XIC(DIN1_1_CycleStartPB) XIO(AutoPreOK) XIC(MachineBasic.Flash250msPD) ,XIO(Fault_HORN) XIO(DIN1_1_CycleStartPB) XIO(Supervisor_SM.Control.Timer[0].TT) XIC(MachineWarningActive) XIC(MachineBasic.Flash250msPD) CTU(Supervisor_SM.Control.Counter[1],?,?) XIO(Supervisor_SM.Control.Counter[1].DN) ]OTE(DOUT1_3_Stacklight_HORN);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIO(Fault_HORN)RES(Supervisor_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIO(MachineWarningActive)RES(Supervisor_SM.Control.Counter[1]);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[GUARD DOOR LOCK SIGNAL]]>
</Comment>
<Text>
<![CDATA[[XIC(MachineRunning) ,XIC(Debug_DoorLockSignal) ]OTE(DOUT1_12_GuardDoor_LockSignal);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Fault Handling]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)OTE(Supervisor_SM.Control.Bit[10]);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIO(\Alarms.NoMachineFaults)OTE(Supervisor_SM.Control.Bit[11]);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Control.Bit[10]) ,XIC(Supervisor_SM.Control.Bit[11]) ]OTE(MachineFaultActive);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)MOVE(1,HMI_Data.Status.OKMessages);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[Machine Warnings]]>
</Comment>
<Text>
<![CDATA[XIO(\Alarms.NoMachineWarnings)MOVE(1,HMI_Data.Status.Warnings)OTE(MachineWarningActive);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[Cycle Time]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)[XIC(Robot02_PCB_SM.Status.State[21]) ,XIC(Robot02_PCB_SM.Status.State[23]) ]XIC(Robot02_PCB_SM.Control.Bit[12])ONS(Supervisor_SM.Control.OS[2])[DIV(Supervisor_SM.Control.Timer[10].ACC,1000,HMI_Data.Status.CycleTime) ,[MOVE(HMI_Data.Status.CycleTime,CycleTimeArrayA[CycleTimeIndexA]) ADD(CycleTimeIndexA,1,CycleTimeIndexA) GT(CycleTimeIndexA,24) MOVE(0,CycleTimeIndexA) ,MOVE(HMI_Data.Status.CycleTime,CycleTimeArrayB[CycleTimeIndexB]) ADD(CycleTimeIndexB,1,CycleTimeIndexB) GT(CycleTimeIndexB,99) MOVE(0,CycleTimeIndexB) ] ,[AVE(CycleTimeArrayA[0],0,HMI_Data.Status.REAL_Disp[0],AverageTimeA_CTRL,?,?) ,AVE(CycleTimeArrayB[0],0,HMI_Data.Status.REAL_Disp[1],AverageTimeB_CTRL,?,?) ,RES(Supervisor_SM.Control.Timer[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[XIC(MachineRunning)XIC(MachineBasic.AlwaysOn)RTO(Supervisor_SM.Control.Timer[10],?,?);]]>
</Text>
</Rung>
