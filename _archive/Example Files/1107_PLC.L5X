<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(0,ProgramID);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[***MACHINE FAULTS***]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Check for any machine faults present.]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.AlarmActive)XIO(\Tracking.AlarmActive)[XIO(\Dereeler.AlarmActive) ,XIC(Lockout_Dereeler) ][XIO(\WireFeed.AlarmActive) ,XIC(Lockout_WireFeed) ][XIO(\HeatShrink.AlarmActive) ,XIC(Lockout_HeatShrink) ][XIO(\FluxTank.AlarmActive) ,XIC(Lockout_FluxTank) ][XIO(\SolderPot.AlarmActive) ,XIC(Lockout_SolderPot) ][XIO(\PCB_Solder.AlarmActive) ,XIC(Lockout_PCB_Solder) ][XIO(\PCB_Clean.AlarmActive) ,XIC(Lockout_PCB_Clean) ][XIO(\PCB_Inspection.AlarmActive) ,XIC(Lockout_PCB_Inspection) ][XIO(\Epoxy_Dispense.AlarmActive) ,XIC(Lockout_Epoxy_Dispense) ][XIO(\EpoxyCure_1.AlarmActive) ,XIC(Lockout_EpoxyCure_1) ][XIO(\EpoxyCure_2.AlarmActive) ,XIC(Lockout_EpoxyCure_2) ][XIO(\EpoxyCure_3.AlarmActive) ,XIC(Lockout_EpoxyCure_3) ][XIO(\Infeed.AlarmActive) ,XIC(Lockout_Infeed) ][XIO(\Regrip.AlarmActive) ,XIC(Lockout_Regrip) ][XIO(\Outfeed.AlarmActive) ,XIC(Lockout_Outfeed) ][XIO(\Robot01_Wire.AlarmActive) ,XIC(Lockout_Robot01_Wire) ][XIO(\Robot02_PCB.AlarmActive) ,XIC(Lockout_Robot02_PCB) ][XIO(\Vision.AlarmActive) ,XIC(Lockout_Vision) ]OTE(NoMachineFaults);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Robot HOLD Control]]>
</Comment>
<Text>
<![CDATA[XIO(\WireFeed.AlarmActive)XIO(\HeatShrink.AlarmActive)XIO(\FluxTank.AlarmActive)XIO(\SolderPot.AlarmActive)XIO(\PCB_Solder.AlarmActive)OTE(Robot01_RemoveHOLD);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(\PCB_Solder.AlarmActive)XIO(\PCB_Clean.AlarmActive)XIO(\PCB_Inspection.AlarmActive)XIO(\Epoxy_Dispense.AlarmActive)XIO(\EpoxyCure_1.AlarmActive)XIO(\EpoxyCure_2.AlarmActive)XIO(\EpoxyCure_3.AlarmActive)XIO(\Infeed.AlarmActive)XIO(\Regrip.AlarmActive)XIO(\Outfeed.AlarmActive)OTE(Robot02_RemoveHOLD);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[***MACHINE WARNINGS***]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Check For Any Machine Warnings Present]]>
</Comment>
<Text>
<![CDATA[XIO(\Tracking.WarningActive)XIO(\Dereeler.WarningActive)XIO(\WireFeed.WarningActive)XIO(\HeatShrink.WarningActive)XIO(\FluxTank.WarningActive)XIO(\SolderPot.WarningActive)XIO(\PCB_Solder.WarningActive)XIO(\PCB_Clean.WarningActive)XIO(\PCB_Inspection.WarningActive)XIO(\Epoxy_Dispense.WarningActive)XIO(\EpoxyCure_1.WarningActive)XIO(\EpoxyCure_2.WarningActive)XIO(\EpoxyCure_3.WarningActive)XIO(\Infeed.WarningActive)XIO(\Regrip.WarningActive)XIO(\Outfeed.WarningActive)XIO(\Robot01_Wire.WarningActive)XIO(\Robot02_PCB.WarningActive)XIO(\Vision.WarningActive)OTE(NoMachineWarnings);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Clear the Active Alarm list in case it has been corrupted via a PLC program download.]]>
</Comment>
<Text>
<![CDATA[[XIC(S:FS) ,XIC(NoMachineWarnings) XIC(NoMachineFaults) ONS(OneShot.5) ]COP(AlarmDataEmpty,Active[0],1)COP(Active[0],Active[1],15);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Alarm History Display]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(S:FS)[SIZE(History[0],0,HistSize) ,SIZE(HistoryDisplay[0],0,S_DispSize) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[ONS(OneShot.2) MOVE(0,DisplayListPointer) ,XIC(HistoryNav.PageUp) ONS(OneShot.3) [GE(DisplayListPointer,S_DispSize) CPT(DisplayListPointer,(DisplayListPointer+HistSize-S_DispSize-S_DispSize+1)MOD(HistSize-S_DispSize+1)) OTE(OneShot.8) ,XIO(OneShot.8) LT(DisplayListPointer,S_DispSize) MOVE(0,DisplayListPointer) ] ,XIC(HistoryNav.ScrollDown) ONS(OneShot.4) CPT(DisplayListPointer,(DisplayListPointer+1)MOD(HistSize-S_DispSize+1)) ,XIC(HistoryNav.ScrollUp) ONS(OneShot.6) CPT(DisplayListPointer,(DisplayListPointer+HistSize-S_DispSize)MOD(HistSize-S_DispSize+1)) ,XIC(HistoryNav.PageDown) ONS(OneShot.7) CPT(tempPtrCheck,HistSize-S_DispSize-S_DispSize) [LT(DisplayListPointer,tempPtrCheck) CPT(DisplayListPointer,(DisplayListPointer+S_DispSize)MOD(HistSize-S_DispSize+1)) OTE(OneShot.9) ,XIO(OneShot.9) GE(DisplayListPointer,tempPtrCheck) CPT(DisplayListPointer,HistSize-S_DispSize) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[LIMIT(0,DisplayListPointer,HistSize)CMP((HistSize - DisplayListPointer) > S_DispSize)COP(History[DisplayListPointer],HistoryDisplay[0],S_DispSize);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
