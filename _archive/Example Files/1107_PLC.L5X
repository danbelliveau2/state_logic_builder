<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Pallet Clamps]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_PalletClamps.Fault_1) ,XIC(Alarm[0].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(AOI_PalletClamps.Fault_2) ,XIC(Alarm[1].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Faults]]>
</Comment>
<Text>
<![CDATA[[XIC(Robot02_PCB_SM.Control.Bit[8]) XIO(Supervisor_SM.Control.Bit[6]) XIO(Supervisor_SM.Status.State[5]) ,XIC(Alarm[2].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[AFI() ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Warning - Need to Replace Tray]]>
</Comment>
<Text>
<![CDATA[XIC(Infeed_SM.Control.Bit[5])XIO(Alarm[2].Active)CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Warning - Pallet Not Present]]>
</Comment>
<Text>
<![CDATA[[XIC(AUTO) ,XIC(STOPPED) ]XIO(Pallet_PRESENT)CONCAT(StationName,WarningText[1],Warning[1].Message)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Warning - Pallet Not Seated]]>
</Comment>
<Text>
<![CDATA[[XIC(AUTO) ,XIC(STOPPED) ]XIC(Pallet_PRESENT)XIO(Pallet_SEATED)XIO(Robot02_PCB_SM.Status.State[25])CONCAT(StationName,WarningText[2],Warning[2].Message)OTE(Warning[2].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(IOBlock_InfeedOutfeed:I.ProcessDataIn.Port_X7A)XIC(IOBlock_InfeedOutfeed:I.ProcessDataIn.Port_X7B)XIC(IOBlock_InfeedOutfeed:I.ProcessDataIn.Port_X8A)XIC(IOBlock_InfeedOutfeed:I.ProcessDataIn.Port_X8B)OTE(AllClamps_RETD);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIO(IOBlock_InfeedOutfeed:I.ProcessDataIn.Port_X7A)XIO(IOBlock_InfeedOutfeed:I.ProcessDataIn.Port_X7B)XIO(IOBlock_InfeedOutfeed:I.ProcessDataIn.Port_X8A)XIO(IOBlock_InfeedOutfeed:I.ProcessDataIn.Port_X8B)OTE(AllClamps_EXTD);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AOI_PalletClamps.Confirm_1)OTE(Clamps_CLSD);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AOI_PalletClamps.Confirm_2)OTE(Clamps_OPEN);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(IOBlock_Soldering:I.ProcessDataIn.Port_X4A)OTE(Pallet_PRESENT);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(IOBlock_Soldering:I.ProcessDataIn.Port_X4B)OTE(Pallet_SEATED);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(Infeed_SM.Status.State[63]) XIO(AlarmActive) MOVE(FaultedState,Infeed_SM.Control.StateReg) ,XIC(Infeed_SM.Status.State[62]) MOVE(4,Infeed_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[6])OTE(STOPPED);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(Infeed_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(MAN)MOVE(3,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Infeed_SM.Status.State[5]) ,XIC(Infeed_SM.Status.State[61]) ,XIC(Infeed_SM.Status.State[62]) ]XIO(Lockout_Infeed)XIC(CycleStartLatch)MOVE(4,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[XIC(INIT)MOVE(5,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 6
CLOSE CLAMPS]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Infeed_SM.Status.State[4]) ,XIC(Infeed_SM.Status.State[10]) ]XIC(Infeed_SM.Control.Bit[0])XIO(Robot02_PCB_SM.Control.Bit[8])XIO(Infeed_SM.Control.Bit[5])MOVE(6,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 7
READY FOR ROBOT PICK]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Infeed_SM.Status.State[6])XIC(Clamps_CLSD)MOVE(7,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 8
PALLET EMPTY]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Infeed_SM.Status.State[7])XIC(Robot02_PCB_SM.Control.Bit[8])MOVE(8,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 9
OPEN CLAMPS]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(Infeed_SM.Status.State[4]) [XIO(Infeed_SM.Control.Bit[0]) ,XIC(Robot02_PCB_SM.Control.Bit[8]) ,XIC(Infeed_SM.Control.Bit[5]) ] ,XIC(Infeed_SM.Status.State[8]) XIO(Robot02_PCB_SM.Status.State[24]) XIO(Robot02_PCB_SM.Status.State[25]) ]MOVE(9,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 10
CLAMPS OPEN]]>
</Comment>
<Text>
<![CDATA[XIC(Infeed_SM.Status.State[9])XIC(Clamps_OPEN)MOVE(10,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 11
PALLET REMOVED]]>
</Comment>
<Text>
<![CDATA[AFI()XIC(Infeed_SM.Status.State[10])XIO(Pallet_PRESENT)MOVE(11,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 61
LOCKOUT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(Infeed_SM.Status.State[5])XIC(Lockout_Infeed)XIC(CycleStartLatch)MOVE(61,Infeed_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 62
CYCLE STOP]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[LIMIT(6,Infeed_SM.Control.StateReg,10) ,XIC(Infeed_SM.Status.State[61]) ]XIO(CycleStartLatch)[ONS(Infeed_SM.Control.OS[1]) MOVE(Infeed_SM.Control.StateReg,StoppedState) ,MOVE(62,Infeed_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 63
FAULTED]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(MachineRunning)XIC(AlarmActive)[ONS(Infeed_SM.Control.OS[0]) MOVE(Infeed_SM.Control.StateReg,FaultedState) ,MOVE(63,Infeed_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE LOGIC ENGINE]]>
</Comment>
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_Infeed_SM,Infeed_SM);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIO(AlarmActive)OTE(Infeed_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(500,Infeed_SM.Control.TransitionTime)OTE(Infeed_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(MachineBasic.AlwaysOn)MOVE(5000,Infeed_SM.Control.FaultTime)OTE(Infeed_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[
STATE LOGIC ACTIONS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Control]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIC(Pallet_PRESENT)XIC(Pallet_SEATED)OTE(Infeed_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[[XIO(AUTO) XIC(Infeed_SM.Control.Bit[3]) XIC(HMI_Data.Control.Button[68]) ,XIC(Infeed_SM.Status.State[6]) ,XIC(Infeed_SM.Control.Bit[2]) ][XIO(HMI_Data.Control.Button[69]) ,XIO(Infeed_SM.Control.Bit[3]) ]XIO(Infeed_SM.Status.State[9])OTE(Infeed_SM.Control.Bit[2]);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[XIC(Clamps_OPEN)OTE(Infeed_SM.Control.Bit[4]);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[[XIC(Robot02_PCB_SM.Control.Bit[8]) ONS(Infeed_SM.Control.OS[2]) ,XIC(Infeed_SM.Control.Bit[5]) ]XIC(Pallet_PRESENT)OTE(Infeed_SM.Control.Bit[5]);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIC(in_Safety.EStopOK)OTE(Infeed_SM.Control.Bit[3]);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[Map Outputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[AOI_DoubleSOL_Pulse_FB(AOI_PalletClamps,Infeed_SM.Control.Bit[3],Infeed_SM.Control.Bit[2],VB_Solder_Epoxy:O.ProcessDataOut.Output27,VB_Solder_Epoxy:O.ProcessDataOut.Output26,ValveOutput_PulseTime,AllClamps_RETD,AllClamps_EXTD);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
