<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[X Axis Servo Drive Fault]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIC(X_Axis_Ref_Ctrl_Sts.Faulted)CONCAT(StationName,AlarmText[0],Alarm[0].Message)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Y Axis Servo Drive Fault]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIC(Y_Axis_Ref_Ctrl_Sts.Faulted)CONCAT(StationName,AlarmText[1],Alarm[1].Message)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Z Axis Servo Drive Fault]]>
</Comment>
<Text>
<![CDATA[XIC(in_Safety.OK)XIC(Z_Axis_Ref_Ctrl_Sts.Faulted)CONCAT(StationName,AlarmText[2],Alarm[2].Message)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[PCB Cover]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_PCBCover_Cyl.Fault_1) ,XIC(Alarm[3].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[3],Alarm[3].Message)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(AOI_PCBCover_Cyl.Fault_2) ,XIC(Alarm[4].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[4],Alarm[4].Message)OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[X Axis Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_s02_X_axis_EIP.ComOK) XIO(X_Axis_Ref_Ctrl_Sts.Homed) ,XIC(Alarm[5].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[5],Alarm[5].Message)OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Y Axis Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_s03_Y_axis_EIP.ComOK) XIO(Y_Axis_Ref_Ctrl_Sts.Homed) ,XIC(Alarm[6].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[6],Alarm[6].Message)OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Z Axis Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[[XIC(AOI_s04_Z_axis_EIP.ComOK) XIO(Z_Axis_Ref_Ctrl_Sts.Homed) ,XIC(Alarm[7].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[7],Alarm[7].Message)OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Soldering Controller Not In AUTO Mode]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIO(IN_SolderControl[5])XIO(Lockout_PCB_Solder)CONCAT(StationName,AlarmText[8],Alarm[8].Message)OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Soldering Controller ALARM]]>
</Comment>
<Text>
<![CDATA[XIC(IN_SolderControl[2])CONCAT(StationName,AlarmText[9],Alarm[9].Message)OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Soldering In Progress Timeout - Waiting on Wire Robot]]>
</Comment>
<Text>
<![CDATA[[XIC(PCB_Solder_SM.Status.State[29]) XIC(PCB_Solder_SM.Status.TimeoutFlt) ,XIC(Alarm[10].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[10],Alarm[10].Message)OTE(Alarm[10].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Cycle Stop Timeout - Waiting on PCB Robot]]>
</Comment>
<Text>
<![CDATA[[[XIC(PCB_Solder_SM.Status.State[37]) ,XIC(PCB_Solder_SM.Status.State[39]) ] XIO(CycleStartLatch) TON(PCB_Solder_SM.Control.Timer[1],?,?) XIC(PCB_Solder_SM.Control.Timer[1].DN) ,XIC(Alarm[11].Active) XIO(FaultReset) ]CONCAT(StationName,AlarmText[11],Alarm[11].Message)OTE(Alarm[11].Active);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[X Axis MAM Instruction Error]]>
</Comment>
<Text>
<![CDATA[XIC(X_Axis_MAM.Sts_ER)ONS(PCB_Clean_SM.Control.OS[2])OTE(X_Axis_MAM_ERR_PLS);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(X_Axis_MAM_ERR_PLS) ,XIC(X_Axis_MAM_ERR_HOLD) ]XIO(FaultReset)XIC(X_Axis_MAM.Sts_ER)OTE(X_Axis_MAM_ERR_HOLD);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(X_Axis_MAM_ERR_HOLD)TON(PCB_Clean_SM.Control.Timer[2],?,?)XIC(PCB_Clean_SM.Control.Timer[2].DN)CONCAT(StationName,AlarmText[12],Alarm[12].Message)OTE(Alarm[12].Active);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(X_Axis_MAM_ERR_HOLD)ONS(PCB_Clean_SM.Control.OS[3])[COP(X_MAM_ERR[0],ErrorCode_Temp[1],15) COP(ErrorCode_Temp[1],X_MAM_ERR[1],15) MOVE(X_Axis_MAM.Sts_ERR,X_MAM_ERR[0]) ,COP(X_MAM_ERR_State[0],ErrorCode_Temp[1],15) COP(ErrorCode_Temp[1],X_MAM_ERR_State[1],15) MOVE(PCB_Clean_SM.Control.StateReg,X_MAM_ERR_State[0]) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Y Axis MAM Instruction Error]]>
</Comment>
<Text>
<![CDATA[XIC(Y_Axis_MAM.Sts_ER)ONS(PCB_Clean_SM.Control.OS[4])OTE(Y_Axis_MAM_ERR_PLS);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(Y_Axis_MAM_ERR_PLS) ,XIC(Y_Axis_MAM_ERR_HOLD) ]XIO(FaultReset)XIC(Y_Axis_MAM.Sts_ER)OTE(Y_Axis_MAM_ERR_HOLD);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Y_Axis_MAM_ERR_HOLD)TON(PCB_Clean_SM.Control.Timer[4],?,?)XIC(PCB_Clean_SM.Control.Timer[4].DN)CONCAT(StationName,AlarmText[13],Alarm[13].Message)OTE(Alarm[13].Active);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Y_Axis_MAM_ERR_HOLD)ONS(PCB_Clean_SM.Control.OS[5])[COP(Y_MAM_ERR[0],ErrorCode_Temp[1],15) COP(ErrorCode_Temp[1],Y_MAM_ERR[1],15) MOVE(Y_Axis_MAM.Sts_ERR,Y_MAM_ERR[0]) ,COP(Y_MAM_ERR_State[0],ErrorCode_Temp[1],15) COP(ErrorCode_Temp[1],Y_MAM_ERR_State[1],15) MOVE(PCB_Clean_SM.Control.StateReg,Y_MAM_ERR_State[0]) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Z Axis MAM Instruction Error]]>
</Comment>
<Text>
<![CDATA[XIC(Z_Axis_MAM.Sts_ER)ONS(PCB_Clean_SM.Control.OS[6])OTE(Z_Axis_MAM_ERR_PLS);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(Z_Axis_MAM_ERR_PLS) ,XIC(Z_Axis_MAM_ERR_HOLD) ]XIO(FaultReset)XIC(Z_Axis_MAM.Sts_ER)OTE(Z_Axis_MAM_ERR_HOLD);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(Z_Axis_MAM_ERR_HOLD)TON(PCB_Clean_SM.Control.Timer[6],?,?)XIC(PCB_Clean_SM.Control.Timer[6].DN)CONCAT(StationName,AlarmText[14],Alarm[14].Message)OTE(Alarm[14].Active);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(Z_Axis_MAM_ERR_HOLD)ONS(PCB_Clean_SM.Control.OS[7])[COP(Z_MAM_ERR[0],ErrorCode_Temp[1],15) COP(ErrorCode_Temp[1],Z_MAM_ERR[1],15) MOVE(Z_Axis_MAM.Sts_ERR,Z_MAM_ERR[0]) ,COP(Z_MAM_ERR_State[0],ErrorCode_Temp[1],15) COP(ErrorCode_Temp[1],Z_MAM_ERR_State[1],15) MOVE(PCB_Clean_SM.Control.StateReg,Z_MAM_ERR_State[0]) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Warning - Waiting for READY Signal]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIO(PCB_Solder_SM.Control.Bit[20])XIO(IN_SolderControl[1])CONCAT(StationName,WarningText[0],Warning[0].Message)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Warning - Consumables Low]]>
</Comment>
<Text>
<![CDATA[XIC(PCB_Solder_SM.Control.Counter[2].DN)CONCAT(StationName,WarningText[1],Warning[1].Message)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(PCB_Solder_SM.Control.Counter[3].DN)CONCAT(StationName,WarningText[2],Warning[2].Message)OTE(Warning[2].Active);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Warning - Cycle Stop Inhibited]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIO(CycleStartLatch)XIO(PCB_Solder_SM.Status.State[62])XIO(PCB_Solder_SM.Status.State[63])CONCAT(StationName,WarningText[3],Warning[3].Message)OTE(Warning[3].Active);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[
ALARM HANDLERS

Enter a unique MyProgramID number in every
ProgramAlarmHandler AOI in the program

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INSTRUCTIONS
Press CTRL+H: Replace all 'PCB_Solder' with desired name.
Then, this rung can be deleted.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
INPUTS

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_SolderGripper_Cyl.Confirm_1)OTE(Gripper_CLSD);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AOI_SolderGripper_Cyl.Confirm_2)OTE(Gripper_OPEN);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AOI_PCBCover_Cyl.Confirm_1)OTE(PCBCover_ENGD);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(AOI_PCBCover_Cyl.Confirm_2)OTE(PCBCover_DisENGD);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(DIN1_8_SolderCtrl_Running)OTE(IN_SolderControl[0]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(DIN1_9_SolderCtrl_Ready)OTE(IN_SolderControl[1]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(DIN1_10_SolderCtrl_SolderAlarm)OTE(IN_SolderControl[2]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(DIN1_11_SolderCtrl_HeaterAlarm)OTE(IN_SolderControl[3]);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(DIN1_12_SolderCtrl_ShiftOut)OTE(IN_SolderControl[4]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(DIN1_13_SolderCtrl_AutoMode)OTE(IN_SolderControl[5]);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(DIN1_14_SolderCtrl_IronDown)OTE(IN_SolderControl[6]);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(DIN1_7_FluxAuger_CycleDONE)OTE(FluxAuger_CycDONE);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[
STATE LOGIC

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[RESTART]]>
</Comment>
<Text>
<![CDATA[XIC(CycleStartLatch)XIC(RESTART)[XIC(PCB_Solder_SM.Status.State[63]) XIO(AlarmActive) [LIMIT(27,FaultedState,34) MOVE(36,FaultedState) ,MOVE(FaultedState,PCB_Solder_SM.Control.StateReg) ] ,XIC(PCB_Solder_SM.Status.State[62]) MOVE(4,PCB_Solder_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Supervisor MODES]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])OTE(MAN);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])OTE(INIT);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])OTE(AUTO);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[6])OTE(STOPPED);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(s:FS)CLR(PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 1
IDLE]]>
</Comment>
<Text>
<![CDATA[XIC(PCB_Solder_SM.Status.State[0])XIC(in_Safety.OK)MOVE(1,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 3
MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN) ,AFI() XIC(HMI_Data.Control.Mode) XIC(HMI_Data.Control.Button[100]) XIC(HMI_Data.Control.Button[101]) XIC(Supervisor_SM.Control.Bit[4]) ]MOVE(3,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 4
AUTO INITIALIZE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Solder_SM.Status.State[5]) ,XIC(PCB_Solder_SM.Status.State[61]) ][XIO(Lockout_PCB_Solder) XIC(CycleStartLatch) ,EQ(HMI_Data.Control.DINT_SP[10],4) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ]MOVE(4,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 5
AUTO READY]]>
</Comment>
<Text>
<![CDATA[[XIC(INIT) ,XIC(PCB_Solder_SM.Status.State[45]) XIC(PCB_Solder_SM.Control.Bit[0]) XIC(PCB_Solder_SM.Status.TransitionTimerDone) XIC(HMI_Data.Status.MachineInSC) ]MOVE(5,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 6
MOVE TO START POS
]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[4])XIO(Lockout_PCB_Solder)XIO(PCB_Solder_SM.Control.Bit[24])XIO(PCB_Solder_SM.Control.Bit[0])XIC(Supervisor_SM.Control.Bit[4])MOVE(6,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 7
READY FOR SOLDERING]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Solder_SM.Status.State[4]) XIO(Lockout_PCB_Solder) XIO(PCB_Solder_SM.Control.Bit[24]) ,XIC(PCB_Solder_SM.Status.State[6]) ,XIC(PCB_Solder_SM.Status.State[45]) XIO(HMI_Data.Status.MachineInSC) ]XIC(PCB_Solder_SM.Control.Bit[0])RES(PCB_Solder_SM.Control.Counter[1])MOVE(7,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 8
CLOSE GRIPPER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[7])[XIC(PCB_Solder_SM.Control.Bit[22]) ,XIC(HMI_Data.Status.MachineInSC) ,XIC(Lockout_Robot02_PCB) ]XIC(Supervisor_SM.Control.Bit[4])MOVE(8,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE 9
WAIT FOR ROBOT RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIC(PCB_Solder_SM.Status.State[8]) XIC(Gripper_CLSD) ,XIC(PCB_Solder_SM.Status.State[4]) XIO(Lockout_PCB_Solder) XIC(PCB_Solder_SM.Control.Bit[24]) XIO(PCB_Solder_SM.Control.Bit[25]) ]MOVE(9,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[STATE 10
ENGAGE COVER]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIO(Debug_FluxOnTop) XIC(PCB_Solder_SM.Status.State[9]) [XIO(Robot02_PCB_SM.Control.Bit[25]) ,XIC(HMI_Data.Status.MachineInSC) ] ,XIC(Debug_FluxOnTop) XIC(PCB_Solder_SM.Status.State[25]) [XIC(Robot01_Wire_SM.Control.Bit[8]) ,XIC(HMI_Data.Status.MachineInSC) ] ]XIC(Supervisor_SM.Control.Bit[4])MOVE(10,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[STATE 13
MOVE TO FLUX POS 1]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[10])[XIC(PCBCover_ENGD) ,XIC(Debug_PCBCoverOpen) ]XIC(Supervisor_SM.Control.Bit[4])MOVE(13,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[STATE 14
TRIGGER FLUX DISPENSE 1]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[13])XIC(AOI_s02_X_Axis_RC1.In_Range)XIC(AOI_s03_Y_Axis_RC1.In_Range)XIC(AOI_S04_Z_Axis_RC1.In_Range)XIC(Supervisor_SM.Control.Bit[4])MOVE(14,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[STATE 15
WAIT FOR FLUX CYCLE 1 DONE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[14])XIC(PCB_Solder_SM.Status.TransitionTimerDone)MOVE(15,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[STATE 16
MOVE TO FLUX POS 2]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[56])EQ(PCB_Solder_SM.Control.Counter[1].ACC,1)XIC(PCB_Solder_SM.Status.TransitionTimerDone)XIC(Supervisor_SM.Control.Bit[4])MOVE(16,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[STATE 17
TRIGGER FLUX DISPENSE 2]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[16])XIC(AOI_s02_X_Axis_RC2.In_Range)XIC(AOI_s03_Y_Axis_RC2.In_Range)XIC(AOI_S04_Z_Axis_RC2.In_Range)XIC(Supervisor_SM.Control.Bit[4])MOVE(17,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[STATE 18
WAIT FOR FLUX CYCLE 2 DONE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[17])XIC(PCB_Solder_SM.Status.TransitionTimerDone)MOVE(18,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[STATE 19
MOVE TO FLUX POS 3]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[56])EQ(PCB_Solder_SM.Control.Counter[1].ACC,2)XIC(PCB_Solder_SM.Status.TransitionTimerDone)XIC(Supervisor_SM.Control.Bit[4])MOVE(19,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[STATE 20
TRIGGER FLUX DISPENSE 3]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[19])XIC(AOI_s02_X_Axis_RC3.In_Range)XIC(AOI_s03_Y_Axis_RC3.In_Range)XIC(AOI_S04_Z_Axis_RC3.In_Range)XIC(Supervisor_SM.Control.Bit[4])MOVE(20,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[STATE 21
WAIT FOR FLUX CYCLE 3 DONE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[20])XIC(PCB_Solder_SM.Status.TransitionTimerDone)MOVE(21,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
<![CDATA[STATE 23
MOVE TO PRE-FLUX-SOLDER POS]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)[XIO(Debug_FluxOnTop) [XIC(PCB_Solder_SM.Status.State[56]) EQ(PCB_Solder_SM.Control.Counter[1].ACC,3) XIC(PCB_Solder_SM.Status.TransitionTimerDone) ,XIC(PCB_Solder_SM.Status.State[4]) XIO(Lockout_PCB_Solder) XIC(PCB_Solder_SM.Control.Bit[25]) XIO(PCB_Solder_SM.Control.Bit[29]) ] ,XIC(Debug_FluxOnTop) XIC(PCB_Solder_SM.Status.State[9]) XIO(Robot02_PCB_SM.Control.Bit[25]) ]XIC(Supervisor_SM.Control.Bit[4])MOVE(23,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[STATE 24
AT PRE-FLUX-SOLDER POS]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[23])[XIO(Debug_FluxOnTop) XIC(AOI_s02_X_Axis_RC10.In_Range) XIC(AOI_s03_Y_Axis_RC10.In_Range) XIC(AOI_S04_Z_Axis_RC10.In_Range) ,XIC(Debug_FluxOnTop) XIC(AOI_s02_X_Axis_RC15.In_Range) XIC(AOI_s03_Y_Axis_RC15.In_Range) XIC(AOI_S04_Z_Axis_RC15.In_Range) ]MOVE(24,PCB_Solder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[STATE 25
WAIT FOR WIRE PLACE]]>
</Comment>
<Text>
<![CDATA[XIC(AUTO)XIC(PCB_Solder_SM.Status.State[24])MOVE(25,PCB_Solder_SM.Control.StateReg);]]>
</Text>
