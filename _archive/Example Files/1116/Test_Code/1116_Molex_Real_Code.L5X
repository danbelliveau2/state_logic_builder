<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[PublicProgramIDTag := PublicProgramIDTag + 1;]]>
</Line>
<Line Number="1">
<![CDATA[MyProgramID := PublicProgramIDTag;]]>
</Line>
<Line Number="2">
<![CDATA[NumFound:=0;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[size(AlarmActiveArrayTag,0,AlarmsActive_size);]]>
</Line>
<Line Number="5">
<![CDATA[size(AlarmHistoryArrayTag,0,AlarmsHistory_size);]]>
</Line>
<Line Number="6">
<![CDATA[size(LocalAlarmsArrayTag,0,AlarmsLocal_size);]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[IF (ControllerTimeClockTag.Seconds <> prevSecond) THEN]]>
</Line>
<Line Number="9">
<![CDATA[	prevSecond := ControllerTimeClockTag.Seconds;]]>
</Line>
<Line Number="10">
<![CDATA[	OneSecond := 1;]]>
</Line>
<Line Number="11">
<![CDATA[Else]]>
</Line>
<Line Number="12">
<![CDATA[	OneSecond := 0;]]>
</Line>
<Line Number="13">
<![CDATA[End_If;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[For ActiveIndex := NumFound to AlarmsActive_size - 1 By 1 Do]]>
</Line>
<Line Number="16">
<![CDATA[	//Clear alarm if it's no longer active.]]>
</Line>
<Line Number="17">
<![CDATA[	If (AlarmActiveArrayTag[ActiveIndex].ProgramID = PublicProgramIDTag) Then]]>
</Line>
<Line Number="18">
<![CDATA[		//Alarm came from this AOI]]>
</Line>
<Line Number="19">
<![CDATA[		DataIndex := AlarmActiveArrayTag[ActiveIndex].AlarmID;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[		If ((DataIndex < 0) OR (DataIndex >= AlarmsLocal_size)) Then]]>
</Line>
<Line Number="22">
<![CDATA[			//This was bad data. Index out of range. So to prevent CPU fault,]]>
</Line>
<Line Number="23">
<![CDATA[			//erase the data just like below.]]>
</Line>
<Line Number="24">
<![CDATA[			//Shift the active list up to cover the inactive alarm]]>
</Line>
<Line Number="25">
<![CDATA[			tempLength := AlarmsActive_size - 1 - ActiveIndex;]]>
</Line>
<Line Number="26">
<![CDATA[			If (ActiveIndex < AlarmsActive_size - 1) Then]]>
</Line>
<Line Number="27">
<![CDATA[				//Skip the shift up if the last alarm in the list is no longer active]]>
</Line>
<Line Number="28">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex + 1], AlarmActiveArrayTag[ActiveIndex], tempLength);]]>
</Line>
<Line Number="29">
<![CDATA[			End_If;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[			//Clear the last record]]>
</Line>
<Line Number="32">
<![CDATA[			COP(EmptyAlarmData, AlarmActiveArrayTag[AlarmsActive_size - 1], 1);]]>
</Line>
<Line Number="33">
<![CDATA[			Exit; //This is an anomaly so exit this For loop and it'll fix itself next scan.]]>
</Line>
<Line Number="34">
<![CDATA[		End_if;]]>
</Line>
<Line Number="35">
<![CDATA[		]]>
</Line>
<Line Number="36">
<![CDATA[		If (OneSecond) Then]]>
</Line>
<Line Number="37">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Duration := LocalAlarmsArrayTag[DataIndex].Duration +1;]]>
</Line>
<Line Number="38">
<![CDATA[			AlarmActiveArrayTag[ActiveIndex].Duration := AlarmActiveArrayTag[ActiveIndex].Duration +1;]]>
</Line>
<Line Number="39">
<![CDATA[		End_If;]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[		If (NOT LocalAlarmsArrayTag[DataIndex].Active) Then]]>
</Line>
<Line Number="42">
<![CDATA[			//Alarm is no longer active so copy to history and clear from the active list.]]>
</Line>
<Line Number="43">
<![CDATA[			]]>
</Line>
<Line Number="44">
<![CDATA[			If (NOT LocalAlarmsArrayTag[DataIndex].DoNotSaveToHistory) Then]]>
</Line>
<Line Number="45">
<![CDATA[				//Shift the history down]]>
</Line>
<Line Number="46">
<![CDATA[				For ShiftIter := AlarmsHistory_size - 2 to 0 By -1 Do]]>
</Line>
<Line Number="47">
<![CDATA[					COP(AlarmHistoryArrayTag[ShiftIter], AlarmHistoryArrayTag[ShiftIter + 1], 1);]]>
</Line>
<Line Number="48">
<![CDATA[				End_For;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[				//Copy the data over]]>
</Line>
<Line Number="51">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex], AlarmHistoryArrayTag[0], 1);]]>
</Line>
<Line Number="52">
<![CDATA[			End_If;]]>
</Line>
<Line Number="53">
<![CDATA[			//Shift the active list up to cover the inactive alarm]]>
</Line>
<Line Number="54">
<![CDATA[			tempLength := AlarmsActive_size - 1 - ActiveIndex;]]>
</Line>
<Line Number="55">
<![CDATA[			If (ActiveIndex < AlarmsActive_size - 1) Then]]>
</Line>
<Line Number="56">
<![CDATA[				//Skip the shift up if the last alarm in the list is no longer active]]>
</Line>
<Line Number="57">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex + 1], AlarmActiveArrayTag[ActiveIndex], tempLength);]]>
</Line>
<Line Number="58">
<![CDATA[			End_If;]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[			//Clear the last record]]>
</Line>
<Line Number="61">
<![CDATA[			COP(EmptyAlarmData, AlarmActiveArrayTag[AlarmsActive_size - 1], 1);]]>
</Line>
<Line Number="62">
<![CDATA[		End_If;]]>
</Line>
<Line Number="63">
<![CDATA[]]>
</Line>
<Line Number="64">
<![CDATA[	End_If;]]>
</Line>
<Line Number="65">
<![CDATA[End_For;]]>
</Line>
<Line Number="66">
<![CDATA[]]>
</Line>
<Line Number="67">
<![CDATA[AlarmActiveTag := 0;]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[For DataIndex := 0 to AlarmsLocal_size - 1 By 1 Do]]>
</Line>
<Line Number="70">
<![CDATA[	//Loop through each alarm in the data array]]>
</Line>
<Line Number="71">
<![CDATA[	If (LocalAlarmsArrayTag[DataIndex].Active) Then]]>
</Line>
<Line Number="72">
<![CDATA[		//The alarm is active]]>
</Line>
<Line Number="73">
<![CDATA[		AlarmActiveTag := 1;]]>
</Line>
<Line Number="74">
<![CDATA[		//Update informational outputs]]>
</Line>
<Line Number="75">
<![CDATA[		ActiveAlarmArrayIndex := DataIndex;]]>
</Line>
<Line Number="76">
<![CDATA[		ActiveAlarmDuration := LocalAlarmsArrayTag[DataIndex].Duration;]]>
</Line>
<Line Number="77">
<![CDATA[]]>
</Line>
<Line Number="78">
<![CDATA[		For ActiveIndex := NumFound to AlarmsActive_size - 1 By 1 Do]]>
</Line>
<Line Number="79">
<![CDATA[			//Check if it's already in the active array]]>
</Line>
<Line Number="80">
<![CDATA[			If ((AlarmActiveArrayTag[ActiveIndex].ProgramID = PublicProgramIDTag) AND (AlarmActiveArrayTag[ActiveIndex].AlarmID = DataIndex)) Then]]>
</Line>
<Line Number="81">
<![CDATA[				//Found it! So exit the For loop]]>
</Line>
<Line Number="82">
<![CDATA[				Exit;]]>
</Line>
<Line Number="83">
<![CDATA[			End_If;]]>
</Line>
<Line Number="84">
<![CDATA[		End_For;]]>
</Line>
<Line Number="85">
<![CDATA[		If (ActiveIndex > AlarmsActive_size - 1) Then]]>
</Line>
<Line Number="86">
<![CDATA[			//Didn't find it! So add the new active alarm.]]>
</Line>
<Line Number="87">
<![CDATA[			//Shift the data down the stack]]>
</Line>
<Line Number="88">
<![CDATA[			For ShiftIter := AlarmsActive_size - 2 to 0 By -1 Do]]>
</Line>
<Line Number="89">
<![CDATA[				COP(AlarmActiveArrayTag[ShiftIter], AlarmActiveArrayTag[ShiftIter + 1], 1);]]>
</Line>
<Line Number="90">
<![CDATA[			End_For;]]>
</Line>
<Line Number="91">
<![CDATA[]]>
</Line>
<Line Number="92">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].ProgramID := PublicProgramIDTag;]]>
</Line>
<Line Number="93">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].AlarmID := DataIndex;]]>
</Line>
<Line Number="94">
<![CDATA[			COP(ControllerTimeClockTag, LocalAlarmsArrayTag[DataIndex].TimeStamp, 1);]]>
</Line>
<Line Number="95">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Duration := 0;]]>
</Line>
<Line Number="96">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Count := LocalAlarmsArrayTag[DataIndex].Count +1;]]>
</Line>
<Line Number="97">
<![CDATA[]]>
</Line>
<Line Number="98">
<![CDATA[			COP(LocalAlarmsArrayTag[DataIndex], AlarmActiveArrayTag[0], 1);]]>
</Line>
<Line Number="99">
<![CDATA[]]>
</Line>
<Line Number="100">
<![CDATA[		End_If;]]>
</Line>
<Line Number="101">
<![CDATA[	End_If;]]>
</Line>
<Line Number="102">
<![CDATA[End_For;]]>
</Line>
<Line Number="103">
<![CDATA[]]>
</Line>
<Line Number="104">
<![CDATA[If (AlarmActiveTag) Then]]>
</Line>
<Line Number="105">
<![CDATA[	//No active alarms found]]>
</Line>
<Line Number="106">
<![CDATA[	ActiveAlarmArrayIndex := 9999;]]>
</Line>
<Line Number="107">
<![CDATA[	ActiveAlarmDuration := 0;]]>
</Line>
<Line Number="108">
<![CDATA[End_If;]]>
</Line>
<Line Number="109">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Run_Robot_Seq" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" CreatedDate="2020-02-13T16:51:05.551Z" CreatedBy="STEVENDOUGLAS\dgarr" EditedDate="2023-01-11T03:48:55.418Z" EditedBy="STEVENDOUGLAS\dgarr" SoftwareRevision="v33.01"
>
<Description>
<![CDATA[Queues the specified robot sequence in the robot program manager]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Pending" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Latched when AOI is first called.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Requested" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Sequence has been requested]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Running" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Sequence is running]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Complete" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Robot has completed sequence]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Failed" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Sequence encountered error]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Timed_Out" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Sequence timed out before completion.  Robot may still be moving]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sequence_Number" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequence number to run]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Timeout_s" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Timeout in seconds
0 for no timeout]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Running_Sequence" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Currently running sequence tag from robot program manager]]>
</Description>
</Parameter>
<Parameter Name="Seq_Request" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Sequence request tag from robot program manager]]>
</Description>
</Parameter>
<Parameter Name="RIN_UDT" TagType="Base" DataType="FanucRobotRIN" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="Sequence_Timer" DataType="TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[Logic that stays active once enablein goes false to update status bits appropriately]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Enableinfalse routine used to update status bits and continue tracking the requested sequence after the rung goes false, as well as reset the instruction to run again after it completes]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ If another sequence is not queued in the robot program manager, queue this one]]>
</Comment>
<Text>
<![CDATA[EQ(Seq_Request,0)XIO(Complete)XIO(Failed)XIO(Timed_Out)XIO(Requested)XIC(Pending)NE(Running_Sequence,Sequence_Number)MOVE(Sequence_Number,Seq_Request)OTL(Requested);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[This sequence is now running, wait for completion and latch persistent status bits]]>
</Comment>
<Text>
<![CDATA[EQ(Running_Sequence,Sequence_Number)XIC(Requested)[MUL(Timeout_s,1000,Sequence_Timer.PRE) RTO(Sequence_Timer,?,?) OTE(Running) ,XIC(RIN_UDT.CMDComplete) XIO(RIN_UDT.CMDFailed) OTL(Complete) ,XIC(RIN_UDT.CMDFailed) OTL(Failed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Sequence_Timer.DN)OTE(Timed_Out);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Ready the instruction for its next call once it completes and rung-in has gone false]]>
</Comment>
<Text>
<![CDATA[[XIC(Complete) ,XIC(Failed) ,XIC(Timed_Out) ]OTU(Pending);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Reset the instruction status bits if program in the robot has been aborted]]>
</Comment>
<Text>
<![CDATA[XIO(RIN_UDT.Running)XIO(RIN_UDT.Paused)OTU(Complete)OTU(Failed)OTU(Pending)OTU(Requested)RES(Sequence_Timer);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Reset status bits when instruction is called and latch pending bit]]>
</Comment>
<Text>
<![CDATA[XIO(Pending)OTL(Pending)OTU(Complete)OTU(Failed)OTU(Requested)RES(Sequence_Timer);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ If another sequence is not queued in the robot program manager, queue this one]]>
</Comment>
<Text>
<![CDATA[EQ(Seq_Request,0)XIO(Complete)XIO(Failed)XIO(Timed_Out)XIO(Requested)XIC(Pending)NE(Running_Sequence,Sequence_Number)MOVE(Sequence_Number,Seq_Request)OTL(Requested);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[This sequence is now running, wait for completion and latch persistent status bits]]>
</Comment>
<Text>
<![CDATA[EQ(Running_Sequence,Sequence_Number)XIC(Requested)[MUL(Timeout_s,1000,Sequence_Timer.PRE) RTO(Sequence_Timer,?,?) OTE(Running) ,XIC(RIN_UDT.CMDComplete) XIO(RIN_UDT.CMDFailed) OTL(Complete) ,XIC(RIN_UDT.CMDFailed) OTL(Failed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Set the timed out bit if the sequence timer has expired]]>
</Comment>
<Text>
<![CDATA[XIC(Sequence_Timer.DN)OTE(Timed_Out);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Reset the instruction status bits if program in the robot has been aborted]]>
</Comment>
<Text>
<![CDATA[XIO(RIN_UDT.Running)XIO(RIN_UDT.Paused)OTU(Complete)OTU(Failed)OTU(Pending)OTU(Requested)RES(Sequence_Timer);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="State_Engine_128Max" Class="Standard" Revision="5.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-06-25T13:55:13.933Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2025-08-25T14:49:42.628Z" EditedBy="STEVENDOUGLAS\jperry"
 SoftwareRevision="v37.00">
<Description>
<![CDATA[State Logic Engine For 128 States]]>
</Description>
<RevisionNote>
<![CDATA[-Separated UDT into Control & Status Pieces For better use with standard "Progam" methods.
-Removed Timer,OS,Bit, Counter from Control UDT (Use local program tags instead)
-4.1 optimizations
-4.2 optimizations. Ena--Timer bits no longer needed.
-5.0 added integrated state history array (variable length) 1/14/23 D.G.]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
