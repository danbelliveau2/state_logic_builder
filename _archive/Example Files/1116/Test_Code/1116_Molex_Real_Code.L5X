<Routine Name="R01_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Map Ethernet IP Inputs Using CPS Instruction]]>
</Comment>
<Text>
<![CDATA[[CPS(cam01_S01FlexFeed:I,cam01_S01FlexFeed_IN,1) ,CPS(cam02_S06InspectLocation:I.Data[0],cam02_S06InspectLocation_IN,496) ,CPS(cam03_S17InspectBarrel:I.Data[0],cam03_S17InspectBarrel_IN,496) ,CPS(cam04_S55TempInspect:I,cam04_S55InspectTemp_IN,1) ,CPS(cam05_S61InspectFinal:I.Data[0],cam05_S61InspectFinal_IN,496) ,CPS(IOL_Master1:I,IOL_Master_IN,1) ,CPS(IOL_Master2:I,IOL_Master2_IN,1) ,CPS(IOBlock_01:I,IOBlock_01_IN,1) ,CPS(IOBlock_02:I,IOBlock_02_IN,1) ,CPS(IOBlock_03:I,IOBlock_03_IN,1) ,CPS(IOBlock_04:I,IOBlock_04_IN,1) ,CPS(HopperSpeed_AO:I,HopperSpeed_AO_IN,1) ,CPS(InlineFeederSpeed_AO:I,InlineFeederSpeed_AO_IN,1) ,CPS(BowlFeederSpeed_AO:I,BowlFeederSpeed_AO_IN,1) ,CPS(ToolChange_01:I,ToolChange_01_IN,1) ,CPS(ToolChange_02:I,ToolChange_02_IN,1) ,CPS(WireSpool:I,WireSpool_IN,1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
