</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.UploadAndCreate)MOVE(100,Timer[5].PRE)TON(Timer[5],?,?)XIC(Timer[5].DN)ONS(OneShot[15])JSR(Create,0);]]>
