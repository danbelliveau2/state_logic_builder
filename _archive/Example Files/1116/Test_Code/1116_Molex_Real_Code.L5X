<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(HMI_LocalManualOverride) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(AOI_Z_Axis_RC_1.In_Range)XIC(AOI_Support_Axis_RC_1.In_Range)[XIO(g_DryCycle_Enabled) [EQ(ActiveRecipe.WireFeedMoveType,1) ,EQ(ActiveRecipe.WireFeedMoveType,3) ] XIC(AOI_X_Axis_RC_3.In_Range) ,[EQ(ActiveRecipe.WireFeedMoveType,2) ,XIC(g_DryCycle_Enabled) ] XIC(AOI_X_Axis_RC_4.In_Range) ]OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Recipe Inputs and Calculations - Positions]]>
</Comment>
<Text>
<![CDATA[CPT(Support_Axis_ProcessPos,Support_Axis_ZeroHeight - ActiveRecipe.LipThickness + ActiveRecipe.WireFeedOffsetSupport)SUB(Support_Axis_ProcessPos,1,Support_Axis_IndexPermissive)SUB(Support_Axis_ProcessPos,2,Support_Axis_ClearPos);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[CPT(Z_Axis_ProcessPos,Z_Axis_NestBasePos - ActiveRecipe.BarrelDiameter + ActiveRecipe.WireFeedOffsetZ)SUB(Z_Axis_ProcessPos,3,Z_Axis_ClearPos)SUB(Z_Axis_ProcessPos,1,Z_Axis_IndexPermissive);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[CPT(X_Axis_SeamMovePos2,X_Axis_SeamMovePos1 - ActiveRecipe.SeamLength + ActiveRecipe.WireFeedOffsetXNear - ActiveRecipe.WireFeedOffsetXFar)CPT(X_Axis_SeamMovePos1,X_Axis_StartPos + StationStatus[56].WireFeedStartPosX + ActiveRecipe.WireFeedOffsetXFar)CPT(X_Axis_BarrelCenterPos,X_Axis_SeamMovePos1 - X_Axis_CenterOfSeam + ActiveRecipe.WireFeedOffsetXCenter - ActiveRecipe.WireFeedOffsetXFar)DIV(ActiveRecipe.SeamLength,2,X_Axis_CenterOfSeam);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Recipe Inputs and Calculations - Speeds]]>
</Comment>
<Text>
<![CDATA[MOVE(ActiveRecipe.WireFeedXAxisSpeed,HMI_X_Axis_ProcessSpeed)MOVE(ActiveRecipe.WireFeedDispenseSpeed,HMI_WireFeed_Axis.Control.AutoSpeed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[CPT(HMI_X_Axis_ProcessAccel,HMI_X_Axis_ProcessSpeed * HMI_X_Axis_ProcessSpeed)CPT(HMI_X_Axis_ProcessDecel,HMI_X_Axis_ProcessSpeed * HMI_X_Axis_ProcessSpeed)CPT(HMI_WireFeed_Axis.Control.Accel,HMI_WireFeed_Axis.Control.AutoSpeed * HMI_WireFeed_Axis.Control.AutoSpeed)CPT(HMI_WireFeed_Axis.Control.Decel,HMI_WireFeed_Axis.Control.AutoSpeed * HMI_WireFeed_Axis.Control.AutoSpeed);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[MOVE(ActiveRecipe.DwellTimeBeforeBraze,Timer[2].PRE);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[11]) ,XIC(Status.State[35]) ,XIC(Status.State[58]) ,XIC(Status.State[91]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Confirm Temperature Meets Threshold]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[11]) ,XIC(Status.State[35]) ,[XIC(Status.State[58]) ,XIC(Status.State[91]) ,XIC(Status.State[124]) ] ]XIC(CycleRunning)XIO(HMI_Data.StationData.Station56.Lockout)XIO(q_CleanoutReq)XIC(StationStatus[56].PartPresent)XIO(StationStatus[56].Reject)XIO(StationStatus[56].S56Attempt)XIO(HMI_Data.HeadControl[\IndexerDial.S56HeadNumber].Lockout)XIO(SS)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 10: Abort Station if Temperature Does Not Meet Threshold]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIO(g_DryCycle_Enabled)XIO(Debug_DINT.0)LT(StationStatus[56].PartTemperature,ActiveRecipe.PartTemperatureMin)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Abort Station if Temperature Does Not Meet Threshold]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(StationStatus[56].Reject)MOVE(11,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 15: Begin Wire Feed if Temperature Exceeds Threshold]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[GE(StationStatus[56].PartTemperature,ActiveRecipe.PartTemperatureMin) ,XIC(g_DryCycle_Enabled) ,XIC(Debug_DINT.0) ]MOVE(15,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 20: Move X Axis to New Center Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])XIO(g_DryCycle_Enabled)EQ(ActiveRecipe.WireFeedMoveType,1)MOVE(20,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 22: Move Z Axis Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])XIC(AOI_X_Axis_RC_3.In_Range)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 23: Wait X ms before Wire Feed]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[22])XIC(AOI_Support_Axis_RC_2.In_Range)XIC(AOI_Z_Axis_RC_2.In_Range)MOVE(23,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 24: Begin Wire Feed]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[23])XIC(Timer[2].DN)MOVE(24,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 26: Wait For Wire Feed Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[24])XIO(WireFeed_Axis_MAM.PC)MOVE(26,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 29: Retract Z Axis and Support Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[26])XIC(WireFeed_Axis_MAM.PC)MOVE(29,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 32: Retract Wire Feed During Index]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[29])XIC(AOI_Z_Axis_RC_1.In_Range)XIC(AOI_Support_Axis_RC_1.In_Range)MOVE(32,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 35: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[32])[XIC(WireFeed_Axis_MAM.PC) ,XIO(WireRetract_Enable) ]MOVE(35,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 40: Move X Axis to Calculated Start Pos]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[EQ(ActiveRecipe.WireFeedMoveType,2) ,XIC(g_DryCycle_Enabled) ]MOVE(40,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 41: Move Support Axis Up, Move Z Axis Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[40])XIC(AOI_X_Axis_RC_4.In_Range)MOVE(41,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 42: Start Retracted Wire Feed]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[41])XIC(AOI_Support_Axis_RC_2.In_Range)XIC(AOI_Z_Axis_RC_2.In_Range)MOVE(42,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[State 43: Wait for Wire Feed to Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[42])[XIO(WireFeed_Axis_MAM.PC) ,XIC(g_DryCycle_Enabled) ,XIO(WireRetract_Enable) ]MOVE(43,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 44: Debug Wait Xms Before Applying Wire]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[43])[XIC(WireFeed_Axis_MAM.PC) ,XIC(g_DryCycle_Enabled) ,XIO(WireRetract_Enable) ]MOVE(44,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[State 45: Debug Begin Wire Feed before X movement]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[44])XIC(Timer[2].DN)MOVE(46,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[State 49: Wait For Wire Feed and X Pos]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[46])XIO(X_Axis_MAM.PC)MOVE(49,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[State 52: Move Z Axis Up and Support Axis Down ]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[49])XIC(AOI_X_Axis_RC_5.In_Range)XIC(X_Axis_MAM.PC)MOVE(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[State 55: Retract Wire During Index]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[52])XIC(AOI_Z_Axis_RC_1.In_Range)XIC(AOI_Support_Axis_RC_1.In_Range)MOVE(55,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[State 58: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[55])XIC(AOI_X_Axis_RC_4.In_Range)MOVE(58,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[State 70: Move Support Axis Up and X Axis to Center Pos and Z axis down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])XIO(g_DryCycle_Enabled)EQ(ActiveRecipe.WireFeedMoveType,3)MOVE(70,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[State 71: Debug Feed Retracted Wire Len]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[70])XIC(AOI_Support_Axis_RC_2.In_Range)XIC(AOI_X_Axis_RC_3.In_Range)XIC(AOI_Z_Axis_RC_2.In_Range)MOVE(71,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[State 72: Wait for Wire Feed to Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[71])[XIO(WireFeed_Axis_MAM.PC) ,XIO(WireRetract_Enable) ]MOVE(72,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[State 74: Debug Wait Xms Before Applying Wire]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[72])[XIC(WireFeed_Axis_MAM.PC) ,XIO(WireRetract_Enable) ]MOVE(74,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[State 75: Debug Begin Wire Feed before X movement]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[74])XIC(Timer[2].DN)MOVE(76,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[State 79: Continue Wire Feed and X Pos Far]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[76])XIO(X_Axis_MAM.PC)MOVE(79,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[State 82: Continue Wire Feed and X Pos Near]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[79])XIC(AOI_X_Axis_RC_4.In_Range)XIC(X_Axis_MAM.PC)MOVE(82,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[State 85: Continue Wire Feed and X Pos Near
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[82])XIO(X_Axis_MAM.PC)MOVE(85,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[State 88: Move Z Axis Up and Support Axis Down and X Axis to Center Pos
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[85])XIC(AOI_X_Axis_RC_5.In_Range)XIC(X_Axis_MAM.PC)MOVE(88,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[State 91: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[88])XIC(AOI_Z_Axis_RC_1.In_Range)XIC(AOI_Support_Axis_RC_1.In_Range)XIC(AOI_X_Axis_RC_3.In_Range)MOVE(91,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[State 100: Start of initialization sequence
Move Z Axis and Support Axis to Clear Height]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)XIO(HMI_Data.StationData.Station56.Lockout)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[State 105: Move X Axis to Process Position Based on Recipe]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(AOI_Z_Axis_RC_1.In_Range)XIC(AOI_Support_Axis_RC_1.In_Range)MOVE(105,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[State 110: Initialization Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[105])[XIO(g_DryCycle_Enabled) [EQ(ActiveRecipe.WireFeedMoveType,1) ,EQ(ActiveRecipe.WireFeedMoveType,3) ] XIC(AOI_X_Axis_RC_3.In_Range) ,[EQ(ActiveRecipe.WireFeedMoveType,2) ,XIC(g_DryCycle_Enabled) ] XIC(AOI_X_Axis_RC_4.In_Range) ]MOVE(110,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[110])MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(MB.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_X_Axis.Status.MotionEnable) XIC(X_Axis.AxisHomedStatus) XIC(HMI_Z_Axis.Status.MotionEnable) XIC(Z_Axis.AxisHomedStatus) XIC(HMI_WireFeed_Axis.Status.MotionEnable) XIC(WireFeed_Axis.AxisHomedStatus) XIC(HMI_Support_Axis.Status.MotionEnable) XIC(Support_Axis.AxisHomedStatus) [LIMIT(WireFeed_LowLim,i_WireFeedTemp,WireFeed_HighLim) ,XIC(Debug_DINT.1) ] ,XIC(HMI_Data.StationData.Station56.Lockout) ]OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(StationStatus[56].PartPresent) ,XIC(StationStatus[56].PartPresent) [XIC(StationStatus[56].S56Success) ,XIC(StationStatus[56].Reject) ] ,XIC(HMI_Data.HeadControl[\IndexerDial.S56HeadNumber].Lockout) ,XIC(HMI_Data.StationData.Station56.Lockout) ]OTE(Status.OkToIndex);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[LT(Z_Axis.ActualPosition,Z_Axis_IndexPermissive)LT(Support_Axis.ActualPosition,Support_Axis_IndexPermissive)OTE(Status.SafeToIndex);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Status.State[4])OTL(StationStatus[56].S56Attempt);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])OTL(StationStatus[56].Reject);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[debug find how fast interval is]]>
</Comment>
<Text>
<![CDATA[XIC(Debug_DINT.17)XIC(MB.Flash100msPS)[MOVE(cam04_S55InspectTemp_IN.Measurement[0].SpotTemp,debug_array[j.ACC].PartTemperature) ,MOVE(g_CPUDateTime.Milliseconds,debug_array[j.ACC].Timestamp) ,CTU(j,?,?) XIC(j.DN) RES(j) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Debug: Catch if S06 Locate did not register a new offset]]>
</Comment>
<Text>
<![CDATA[XIC(StationStatus[55].PartPresent)XIO(StationStatus[55].Reject)XIO(g_DryCycle_Enabled)EQ(StationStatus[55].WireFeedStartPosX,0.0)OTL(StationStatus[55].Reject);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Status.State[32]) ,XIC(Status.State[52]) ,XIC(Status.State[88]) ]OTL(StationStatus[56].S56Success);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(Status.State[23]) ,XIC(Status.State[44]) ,XIC(Status.State[74]) ]TON(Timer[2],?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Calculate Dispensed Wire Amounts Per Part]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) MOVE(WireFeed_Axis.ActualPosition,WireFeedStartPosition) ,[XIC(Status.State[35]) ,XIC(Status.State[58]) ,XIC(Status.State[91]) ] MOVE(WireFeed_Axis.ActualPosition,WireFeedEndPosition) SUB(WireFeedEndPosition,WireFeedStartPosition,WireFeedAmount) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Wire Feed Temperature Control]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)[[XIC(Status.State[2]) ,XIC(Status.State[3]) ] ,XIC(ManualMode) XIC(HMI_Button.0) ,XIC(HeaterEnable) [XIO(ManualMode) ,XIC(ManualMode) XIO(HMI_Button.1) ] ]XIO(HeaterTurnOffDelay.DN)OTE(HeaterEnable);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[LT(i_WireFeedTemp,HMI_TemperatureSetpoint) ,XIC(HeaterOn) CMP(i_WireFeedTemp < (HMI_TemperatureSetpoint + 50)) ]OTE(HeaterOn);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(Debug_DINT.1)XIC(HeaterEnable)XIC(HeaterOn)OTE(q_TempProbe1)OTE(q_TempProbe2);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Automatically Disable Heaters After 30 Minutes of Idle]]>
</Comment>
<Text>
<![CDATA[[XIC(q_AutoStopped) ,XIC(ManualMode) ]XIO(HMI_Button.0)TON(HeaterTurnOffDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Wire Feed X Axis Motion Control]]>
</Comment>
<Text>
<![CDATA[XIC(\IndexerDial.q_IndexerInPosition)XIC(HMI_X_Axis.Status.MotionEnable)OTE(X_Axis_Permissive);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(MB.AlwaysOn)AOI_ServoAxis(AOI_X_Axis_Basic,X_Axis,MotionGroup,HMI_X_Axis,\Supervisor.Control.StateReg,SafetyOK,FaultReset,X_Axis_Permissive,0,25.0,100,5,100,0.1,1,0);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Should StartPos be dictated by part locate camera? Will start location be the same on every part type?]]>
</Comment>
<Text>
<![CDATA[XIC(MB.Flash250msPS)[MOVE(HMI_X_Axis.Control.AxisPositions[0],X_Axis_HomePos) ,MOVE(X_Axis_StartPos,HMI_X_Axis.Control.AxisPositions[1]) ,MOVE(HMI_X_Axis.Control.AxisPositions[2],X_Axis_NestBasePos) ,MOVE(X_Axis_BarrelCenterPos,HMI_X_Axis.Control.AxisPositions[3]) ,MOVE(X_Axis_SeamMovePos1,HMI_X_Axis.Control.AxisPositions[4]) ,MOVE(X_Axis_SeamMovePos2,HMI_X_Axis.Control.AxisPositions[5]) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[X Axis Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(X_Axis_Permissive)XIC(Status.State[1])[XIC(HMI_X_Axis.Control.ManMoves[0]) MOVE(X_Axis_HomePos,X_Axis_MAMParam.Position) ,XIC(HMI_X_Axis.Control.ManMoves[1]) MOVE(X_Axis_StartPos,X_Axis_MAMParam.Position) ,XIC(HMI_X_Axis.Control.ManMoves[2]) MOVE(X_Axis_NestBasePos,X_Axis_MAMParam.Position) ,XIC(HMI_X_Axis.Control.ManMoves[3]) MOVE(X_Axis_BarrelCenterPos,X_Axis_MAMParam.Position) ,XIC(HMI_X_Axis.Control.ManMoves[4]) MOVE(X_Axis_SeamMovePos1,X_Axis_MAMParam.Position) ,XIC(HMI_X_Axis.Control.ManMoves[5]) MOVE(X_Axis_SeamMovePos2,X_Axis_MAMParam.Position) ]MOVE(HMI_X_Axis.Control.ManualSpeed,X_Axis_MAMParam.Speed)OTE(X_PositionMoveLoaded_MAN);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[X Axis Auto Mode]]>
</Comment>
<Text>
<![CDATA[XIC(X_Axis_Permissive)[[XIC(Status.State[46]) MOVE(X_Axis_SeamMovePos2,X_Axis_MAMParam.Position) ,XIC(Status.State[76]) MOVE(X_Axis_SeamMovePos1,X_Axis_MAMParam.Position) ,XIC(Status.State[82]) MOVE(X_Axis_SeamMovePos2,X_Axis_MAMParam.Position) ] [MOVE(HMI_X_Axis_ProcessSpeed,X_Axis_MAMParam.Speed) ,MOVE(HMI_X_Axis_ProcessAccel,HMI_X_Axis.Control.Accel) ,MOVE(HMI_X_Axis_ProcessDecel,HMI_X_Axis.Control.Decel) ] ,[XIC(Status.State[40]) MOVE(X_Axis_SeamMovePos1,X_Axis_MAMParam.Position) ,XIC(Status.State[55]) MOVE(X_Axis_SeamMovePos1,X_Axis_MAMParam.Position) ,XIC(Status.State[70]) MOVE(X_Axis_BarrelCenterPos,X_Axis_MAMParam.Position) ,XIC(Status.State[88]) MOVE(X_Axis_BarrelCenterPos,X_Axis_MAMParam.Position) ,XIC(Status.State[20]) MOVE(X_Axis_BarrelCenterPos,X_Axis_MAMParam.Position) ] [MOVE(HMI_X_Axis_NonProcessSpeed,X_Axis_MAMParam.Speed) ,MOVE(HMI_X_Axis_NonProcessAccel,HMI_X_Axis.Control.Accel) ,MOVE(HMI_X_Axis_NonProcesDecel,HMI_X_Axis.Control.Decel) ] ,XIC(Status.State[105]) [XIO(g_DryCycle_Enabled) [EQ(ActiveRecipe.WireFeedMoveType,1) ,EQ(ActiveRecipe.WireFeedMoveType,3) ] MOVE(X_Axis_BarrelCenterPos,X_Axis_MAMParam.Position) ,[EQ(ActiveRecipe.WireFeedMoveType,2) ,XIC(g_DryCycle_Enabled) ] MOVE(X_Axis_SeamMovePos1,X_Axis_MAMParam.Position) ] [MOVE(HMI_X_Axis_NonProcessSpeed,X_Axis_MAMParam.Speed) ,MOVE(HMI_X_Axis_NonProcessAccel,HMI_X_Axis.Control.Accel) ,MOVE(HMI_X_Axis_NonProcesDecel,HMI_X_Axis.Control.Decel) ] ]OTE(X_PositionMoveLoaded_AUTO);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[X Axis Motion Command]]>
</Comment>
<Text>
<![CDATA[[XIC(X_PositionMoveLoaded_MAN) ,XIC(X_PositionMoveLoaded_AUTO) ]XIC(HMI_X_Axis.Status.MotionEnable)XIC(X_Axis.AxisHomedStatus)MAM(X_Axis,X_Axis_MAM,0,X_Axis_MAMParam.Position,X_Axis_MAMParam.Speed,Units per sec,HMI_X_Axis.Control.Accel,Units per sec2,HMI_X_Axis.Control.Decel,Units per sec2,S-Curve,50,50,% of Time,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[X Axis Position Monitor]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOn)[AOI_RangeCheck(AOI_X_Axis_RC_0,X_Axis_HomePos,0.2,X_Axis.ActualPosition) ,AOI_RangeCheck(AOI_X_Axis_RC_1,X_Axis_StartPos,0.2,X_Axis.ActualPosition) ,AOI_RangeCheck(AOI_X_Axis_RC_2,X_Axis_NestBasePos,0.2,X_Axis.ActualPosition) ,AOI_RangeCheck(AOI_X_Axis_RC_3,X_Axis_BarrelCenterPos,0.1,X_Axis.ActualPosition) ,AOI_RangeCheck(AOI_X_Axis_RC_4,X_Axis_SeamMovePos1,0.1,X_Axis.ActualPosition) ,AOI_RangeCheck(AOI_X_Axis_RC_5,X_Axis_SeamMovePos2,0.1,X_Axis.ActualPosition) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[ Z Axis Motion Control]]>
</Comment>
<Text>
<![CDATA[XIC(\IndexerDial.q_IndexerInPosition)XIC(HMI_Z_Axis.Status.MotionEnable)OTE(Z_Axis_Permissive);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(MB.AlwaysOn)AOI_ServoAxis(AOI_Z_Axis_Basic,Z_Axis,MotionGroup,HMI_Z_Axis,\Supervisor.Control.StateReg,SafetyOK,FaultReset,Z_Axis_Permissive,0,25.0,100,5,100,0.1,1,0);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(MB.Flash250msPS)[MOVE(HMI_Z_Axis.Control.AxisPositions[0],Z_Axis_HomePos) ,MOVE(Z_Axis_NestBasePos,HMI_Z_Axis.Control.AxisPositions[1]) ,MOVE(Z_Axis_ProcessPos,HMI_Z_Axis.Control.AxisPositions[2]) ,MOVE(Z_Axis_ClearPos,HMI_Z_Axis.Control.AxisPositions[3]) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Z Axis Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(Z_Axis_Permissive)XIC(Status.State[1])[XIC(HMI_Z_Axis.Control.ManMoves[0]) MOVE(Z_Axis_HomePos,Z_Axis_MAMParam.Position) ,XIC(HMI_Z_Axis.Control.ManMoves[1]) MOVE(Z_Axis_NestBasePos,Z_Axis_MAMParam.Position) ,XIC(HMI_Z_Axis.Control.ManMoves[2]) MOVE(Z_Axis_ProcessPos,Z_Axis_MAMParam.Position) ,XIC(HMI_Z_Axis.Control.ManMoves[3]) MOVE(Z_Axis_ClearPos,Z_Axis_MAMParam.Position) ]MOVE(HMI_Z_Axis.Control.ManualSpeed,Z_Axis_MAMParam.Speed)OTE(Z_PositionMoveLoaded_MAN);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Z Axis Auto Mode]]>
</Comment>
<Text>
<![CDATA[XIC(Z_Axis_Permissive)[[XIC(Status.State[22]) ,XIC(Status.State[41]) ,XIC(Status.State[70]) ] MOVE(Z_Axis_ProcessPos,Z_Axis_MAMParam.Position) ,[XIC(Status.State[29]) ,XIC(Status.State[52]) ,XIC(Status.State[88]) ,XIC(Status.State[100]) ] MOVE(Z_Axis_ClearPos,Z_Axis_MAMParam.Position) ]MOVE(HMI_Z_Axis.Control.AutoSpeed,Z_Axis_MAMParam.Speed)OTE(Z_PositionMoveLoaded_AUTO);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Z Axis Motion Command]]>
</Comment>
<Text>
<![CDATA[[XIC(Z_PositionMoveLoaded_MAN) ,XIC(Z_PositionMoveLoaded_AUTO) ]XIC(HMI_Z_Axis.Status.MotionEnable)XIC(Z_Axis.AxisHomedStatus)MAM(Z_Axis,Z_Axis_MAM,0,Z_Axis_MAMParam.Position,Z_Axis_MAMParam.Speed,Units per sec,HMI_Z_Axis.Control.Accel,Units per sec2,HMI_Z_Axis.Control.Decel,Units per sec2,S-Curve,50,50,% of Time,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Z Axis Position Monitor]]>
