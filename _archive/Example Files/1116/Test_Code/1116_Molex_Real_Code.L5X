</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(UpdateEditingRecipe)[OTU(UpdateEditingRecipe) ,GE(SavedPointer,0) LT(SavedPointer,SavedRecipeArrayLength) COP(HMIStatusRecipeTag.Saved[SavedPointer],HMIControlRecipeTag.Editing,1) ];]]>
</Text>
</Rung>
