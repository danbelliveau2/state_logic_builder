<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(MB.AlwaysOff) XIC(HMI_LocalManualOverride) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(in_Heater1Ready)XIC(in_Heater2Ready)XIO(in_Heater1Fault)XIO(in_Heater2Fault)XIC(in_ChillerRunning)XIC(Local:4:O00.Run)XIC(Local:4:O10.Run)EQ(Local:4:I00.Command06.Data308201,HMI_CurrentSetpoint)EQ(Local:4:I00.Command06.Data308202,\Recipe.q_StartPowerHeater01)EQ(Local:4:I10.Command06.Data308201,HMI_CurrentSetpoint)EQ(Local:4:I10.Command06.Data308202,\Recipe.q_StartPowerHeater02)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Move Original Start Values back into Setpoints if machine stops for any reason]]>
</Comment>
<Text>
<![CDATA[XIO(CycleRunning)MOVE(\Recipe.q_StartPowerHeater01,Heater01_Setpoint)MOVE(\Recipe.q_StartPowerHeater02,Heater02_Setpoint);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[CPT(Heater1SetpointLL,0.0316 * (Heater01_Setpoint - (Heater01_Setpoint * 0.1)))CPT(Heater1SetpointHL,0.0316 * (Heater01_Setpoint + (Heater01_Setpoint * 0.1)))CPT(Heater2SetpointLL,0.0316 * (Heater02_Setpoint - (Heater02_Setpoint * 0.1)))CPT(Heater2SetpointHL,0.0316 * (Heater02_Setpoint + (Heater02_Setpoint * 0.1)));]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[60]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Start of sequence, Turn On Heater]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,[XIC(Status.State[60]) ,XIC(Status.State[124]) ] ]XIC(CycleRunning)XIO(HMI_Data.StationData.Station28.Lockout)XIC(\IndexerDial.q_PartsInHeaters)XIO(g_DryCycle_Enabled)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 13: Check for Increase or Decrease Request]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 20: Increase or Decrease Heater 2 Setpoint]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])[XIC(\S55_TempInspect.q_RequestHeaterDecrease) ,XIC(\S55_TempInspect.q_RequestHeaterIncrease) ]MOVE(20,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 21: Clamp Setpoint to not Exceed 100% power]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])MOVE(21,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 23: Send New Setpoint to Heater 2]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[21])MOVE(23,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 60: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) XIO(\S55_TempInspect.q_RequestHeaterDecrease) XIO(\S55_TempInspect.q_RequestHeaterIncrease) ,XIC(Status.State[23]) ]MOVE(60,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 100:Start of initialization sequence - Send Heater Setpoints Based on Recipe]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 100:Start of initialization sequence - Send Heater Setpoints Based on Recipe]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])EQ(Local:4:I00.Command06.Data308201,HMI_CurrentSetpoint)EQ(Local:4:I00.Command06.Data308202,\Recipe.q_StartPowerHeater01)EQ(Local:4:I10.Command06.Data308201,HMI_CurrentSetpoint)EQ(Local:4:I10.Command06.Data308202,\Recipe.q_StartPowerHeater02)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(MB.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[LIMIT(4,Control.StateReg,59)XIO(SS)MOVE(3000,Control.FaultTime)OTE(Control.EnaFaultDetect);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.StationData.Station28.Lockout) ,XIC(in_Heater1Ready) XIC(in_Heater2Ready) ]OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)[OTE(q_AutoStopped) ,OTU(\S55_TempInspect.q_RequestHeaterDecrease) OTU(\S55_TempInspect.q_RequestHeaterIncrease) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(\IndexerDial.q_PartsInHeaters) XIC(in_Heater1Ready) XIC(in_Heater2Ready) ,XIC(\IndexerDial.q_PartsInHeater1) XIC(in_Heater1On) XIO(\IndexerDial.q_PartsInHeater2) XIC(in_Heater2Ready) ,XIC(\IndexerDial.q_PartsInHeater2) XIC(in_Heater2On) XIO(\IndexerDial.q_PartsInHeater1) XIC(in_Heater1Ready) ,XIC(\IndexerDial.q_PartsInHeater1) XIC(in_Heater1On) XIC(\IndexerDial.q_PartsInHeater2) XIC(in_Heater2On) ,XIC(HMI_Data.StationData.Station28.Lockout) ,XIC(g_DryCycle_Enabled) ]OTE(Status.OkToIndex);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[OTE(Status.SafeToIndex);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Heater On/Off Control]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(HMI_Data.StationData.Station28.Lockout)XIO(g_DryCycle_Enabled)XIC(Status.State[4])[XIC(in_Heater1Ready) XIC(\IndexerDial.q_PartsInHeater1) OTL(q_Heater1On) ,XIC(in_Heater2Ready) XIC(\IndexerDial.q_PartsInHeater2) OTL(q_Heater2On) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(in_Heater1Fault) ,XIO(\IndexerDial.q_PartsInHeater1) ,XIO(in_ChillerRunning) ,XIO(SafetyOK) ,XIO(CycleRunning) ,XIC(HMI_Data.StationData.Station28.Lockout) ,XIC(g_DryCycle_Enabled) ]OTU(q_Heater1On);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(in_Heater2Fault) ,XIO(\IndexerDial.q_PartsInHeater2) ,XIO(in_ChillerRunning) ,XIO(SafetyOK) ,XIO(CycleRunning) ,XIC(HMI_Data.StationData.Station28.Lockout) ,XIC(g_DryCycle_Enabled) ]OTU(q_Heater2On);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Chiller Control
Added WireFeed StartOK to Reset Fault on Heaters before Cycle Start]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(HMI_Data.StationData.Station28.Lockout)[XIC(CycleRunning) ,XIC(\S56_WireFeed.q_StartOK) ,XIO(CycleRunning) TON(Timer[4],?,?) XIO(Timer[4].DN) ,XIC(Debug_DINT.0) ]OTE(q_ChillerOn);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(SafetyOK) XIO(HMI_Data.StationData.Station28.Lockout) XIC(CycleRunning) ,XIC(Debug_DINT.7) ]OTE(Local:8:O.Pt08.Data);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Heater Comms]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)OTL(Local:4:O00.Run)OTL(Local:4:O10.Run);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.StationData.Station28.Lockout)OTU(Local:4:O00.Run)OTU(Local:4:O10.Run);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Heater Setpoints]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])[MOVE(10000,Local:4:O00.Command09.Data412294) MOVE(10000,Local:4:O10.Command09.Data412294) ,MOVE(\Recipe.q_StartPowerHeater01,Local:4:O00.Command09.Data412295) MOVE(\Recipe.q_StartPowerHeater02,Local:4:O10.Command09.Data412295) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Debug HMI purposes]]>
</Comment>
<Text>
<![CDATA[XIC(Debug_DINT.8)XIC(Status.State[13])[MOVE(Heater01_Setpoint,Local:4:O00.Command09.Data412295) ,MOVE(Heater02_Setpoint,Local:4:O10.Command09.Data412295) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Status.State[20])ONS(ONS.10)[XIC(\S55_TempInspect.q_RequestHeaterDecrease) GT(Heater02_Setpoint,2500) SUB(Heater02_Setpoint,500,Heater02_Setpoint) ,XIC(\S55_TempInspect.q_RequestHeaterIncrease) LT(Heater02_Setpoint,10000) ADD(Heater02_Setpoint,500,Heater02_Setpoint) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Status.State[21])GE(Heater02_Setpoint,10000)MOVE(10000,Heater02_Setpoint);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Status.State[23])MOVE(Heater02_Setpoint,Local:4:O10.Command09.Data412295)OTU(\S55_TempInspect.q_RequestHeaterDecrease)OTU(\S55_TempInspect.q_RequestHeaterIncrease);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Heater Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(FaultReset)[OTE(q_Heater1FaultReset) ,OTE(q_Heater2FaultReset) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[General Chiller Alarm]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)[XIC(q_ChillerOn) XIO(in_ChillerAlarm) TON(Timer[0],?,?) XIC(Timer[0].DN) ,XIC(Alarm[0].Active) XIO(FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Chiller Not Running]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)[XIC(q_ChillerOn) XIO(in_ChillerRunning) TON(Timer[1],?,?) XIC(Timer[1].DN) ,XIC(Alarm[1].Active) XIO(FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Heater Not On When Heating Required 
**Make sure this stays on while heater in operation**]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)XIO(g_DryCycle_Enabled)[XIC(CycleRunning) [XIO(in_Heater1On) XIC(\IndexerDial.q_PartsInHeater1) ,XIO(in_Heater2On) XIC(\IndexerDial.q_PartsInHeater2) ] TON(Timer[2],?,?) XIC(Timer[2].DN) ,XIC(Alarm[2].Active) XIO(FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[General Heater Fault]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)[XIC(in_Heater1Fault) ,XIC(in_Heater2Fault) ]TON(Timer[3],?,?)XIC(Timer[3].DN)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Setpoints not Confirmed With Heaters]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)[XIC(Local:4:O00.Run) NE(Local:4:I00.Command06.Data308202,Heater01_Setpoint) ,XIC(Local:4:O10.Run) NE(Local:4:I10.Command06.Data308202,Heater02_Setpoint) ]TON(Timer[5],?,?)XIC(Timer[5].DN)OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)XIC(Alarm[4].Active)MOVE(\Recipe.q_StartPowerHeater01,Local:4:O00.Command09.Data412295)MOVE(\Recipe.q_StartPowerHeater02,Local:4:O10.Command09.Data412295);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)[XIC(Status.State[100]) TON(Timer[6],?,?) XIC(Timer[6].DN) ,XIC(Alarm[5].Active) XIO(FaultReset) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)[XIC(Status.State[4]) [GT(Local:4:I00.Command06.Data308203,MaxWaterTemp) ,GT(Local:4:I00.Command06.Data308204,MaxWaterTemp) ,GT(Local:4:I10.Command06.Data308203,MaxWaterTemp) ,GT(Local:4:I10.Command06.Data308204,MaxWaterTemp) ] ,XIC(Alarm[6].Active) XIO(FaultReset) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station28.Lockout)XIC(\IndexerDial.q_PartsInHeaters)[LIMIT(4,Control.StateReg,60) [XIC(\IndexerDial.q_PartsInHeater1) XIC(in_Heater1On) LE(Local:4:I00.Command06.Data308209,Heater1SetpointLL) ,XIC(\IndexerDial.q_PartsInHeater1) XIC(in_Heater1On) GE(Local:4:I00.Command06.Data308209,Heater1SetpointHL) ,XIC(\IndexerDial.q_PartsInHeater2) XIC(in_Heater2On) LE(Local:4:I10.Command06.Data308209,Heater2SetpointLL) ,XIC(\IndexerDial.q_PartsInHeater2) XIC(in_Heater2On) GE(Local:4:I10.Command06.Data308209,Heater2SetpointHL) ] TON(Timer[7],?,?) XIC(Timer[7].DN) ,XIC(Alarm[7].Active) XIO(FaultReset) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
