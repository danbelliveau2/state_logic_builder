</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[NE(HMIControlRecipeTag.FilterPartNumber,FilterPartNumberPrev)[COP(HMIControlRecipeTag.FilterPartNumber,FilterPartNumberPrev,1) ,MOVE(0,FilterListStartPos) ,OTL(RefreshFilterList) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[NE(HMIStatusRecipeTag.IndexNumNavi,IndexNumNaviPrev)[MOVE(HMIStatusRecipeTag.IndexNumNavi,IndexNumNaviPrev) ,OTL(UpdateSavedPointer) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(in_PreventRecipeDownload)GE(SavedPointer,0)LT(SavedPointer,SavedRecipeArrayLength)[XIC(HMIControlRecipeTag.Download) MOVE(100,Timer[1].PRE) TON(Timer[1],?,?) XIC(Timer[1].DN) ONS(OneShot[10]) ,XIC(AlwaysOff) XIC(HMIAutoDownloadPart) EQ(HMIControlRecipeTag.FilterPartNumber,HMIStatusRecipeTag.Saved[SavedPointer].Name) TON(Timer[9],?,?) XIC(Timer[9].DN) ONS(OneShot[19]) ][COP(HMIStatusRecipeTag.Saved[SavedPointer],HMIStatusRecipeTag.Running,1) ,[MOVE(SavedPointer,HMIStatusRecipeTag.Running_ID) ,OTE(DownloadPulse) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[[LT(SavedPointer,0) ,GE(SavedPointer,SavedRecipeArrayLength) ] [XIC(HMIControlRecipeTag.Download) ,XIC(AlwaysOff) XIC(HMIAutoDownloadPart) ] ,XIC(AlwaysOff) GE(SavedPointer,0) LT(SavedPointer,SavedRecipeArrayLength) NE(HMIControlRecipeTag.FilterPartNumber,HMIStatusRecipeTag.Saved[SavedPointer].Name) XIC(HMIAutoDownloadPart) ]ONS(OneShot[21])[COP(EmptyRecipe,HMIStatusRecipeTag.Running,1) ,OTE(EmptyRecipeDownloaded) ]OTL(EmptyTestLatch);]]>
