</Tags>
<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R40_HeadData,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(HMI_LocalManualOverride) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(sd01_Indexer:SO.SafeTorqueOff)XIC(a01_Indexer.AxisHomedStatus)XIC(q_IndexerInPosition)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[4]) ,XIC(Status.State[16]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Indexer Control Check All Actuators In Position and Stations Completed]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,[XIC(Status.State[16]) ,XIC(Status.State[124]) ] ]XIC(CycleRunning)XIO(SS)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Start Index]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIO(HMI_Data.StationData.Station01.Lockout) XIO(g_DryCycle_Enabled) XIO(q_PartsInHeaters) XIC(AllStations_Complete) XIO(Cleanout_Enabled) ,[XIC(q_PartsInHeaters) ,XIC(HMI_Data.StationData.Station01.Lockout) ,[XIC(Cleanout_Enabled) XIO(IndexerEmpty) ,XIC(g_DryCycle_Enabled) ] ] XIC(q_AutoIndex_Initiate) XIC(AllCriticalStations_Complete) ]XIC(Actuators_Safe)XIO(SS)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Wait for Index Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIO(Axis_MAM.PC)XIO(q_IndexerInPosition)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 12: Set Not Safe Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(Actuators_NotSafeLatch)XIC(Axis_MAS.PC)MOVE(12,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 13: Index Completed, Shift Data. Check Bent Part Sensor]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIO(Actuators_NotSafeLatch)XIC(Axis_MAM.PC)XIC(q_IndexerInPosition)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 16: Index Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(BentPartSensorOK_PRS)MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 100: Move To Last Known Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)XIC(MB.AlwaysOff)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 105: Confirm Index Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(Axis_MAM_ShortestPath.PC)MOVE(105,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[105])XIC(q_IndexerInPosition)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOff)XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(7,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[LIMIT(4,Control.StateReg,59)XIO(SS)MOVE(500000,Control.FaultTime)OTE(Control.EnaFaultDetect);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(a01_Indexer.AxisHomedStatus)XIC(HMI_Data.s01_Indexer.Status.MotionEnable)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Shift All Tracking Data and Check for Parts in Heaters and In Dial]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[11]) ,XIC(Status.State[13]) ]ONS(ONS.9)MOVE(a01_Indexer.ActualPosition,LastKnownPosition)[EQ(LastKnownPosition,0) MOVE(90,LastKnownPosition) ,NE(LastKnownPosition,0) ][JSR(R30_ShiftData,0) ,JSR(R32_PartsInHeaters,0) ,JSR(R33_PartsInDial,0) ,JSR(R35_PartsInHeater1,0) ,JSR(R36_PartsInHeater2,0) ,JSR(R41_HeadColor,0) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Clear All Part Data in Dial]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ClearSingleHead) XIO(CycleRunning) TON(TimerButton[0],?,?) XIC(TimerButton[0].DN) ONS(ONS.13) MOVE(StationStatus[HMI_ClearHeadNum].HeadNumber,NestNumPrev) CPS(StationStatus[0],StationStatus[HMI_ClearHeadNum],1) MOVE(NestNumPrev,StationStatus[HMI_ClearHeadNum].HeadNumber) OTL(HMI_SingleHeadCleared) ,XIO(HMI_ClearSingleHead) OTU(HMI_SingleHeadCleared) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Auto Reject Parts in Heaters]]>
</Comment>
<Text>
<![CDATA[[XIC(CycleStopped) ,XIC(\Supervisor.q_MachineFaultActive) ,XIO(SafetyOK) ,XIC(CycleStopping) ,XIC(Debug_DINT.9) ]XIC(q_PartsInHeaters)ONS(ONS.11)[JSR(R34_PartsInHeatersReject,0) ,OTU(q_PartsInHeaters) ,OTU(q_PartsInHeater1) ,OTU(q_PartsInHeater2) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Clear All Part Data in Dial]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_ClearAllDial)XIO(CycleRunning)TON(Timer[3],?,?)XIC(Timer[3].DN)ONS(ONS.6)JSR(R31_ClearData,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Check if All Stations Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(\S01_Load.Status.OkToIndex)XIC(\S04_PartLocate.Status.OkToIndex)XIC(\S06_LocationInspect.Status.OkToIndex)XIC(\S07_LocationReject.Status.OkToIndex)XIC(\S56_WireFeed.Status.OkToIndex)XIC(\S17_BarrelInspect.Status.OkToIndex)XIC(\S21_BarrelReject.Status.OkToIndex)XIC(\S28_InductiveHeaters.Status.OkToIndex)XIC(\S55_TempInspect.Status.OkToIndex)XIC(\S56_WireFeed.Status.OkToIndex)XIC(\S61_FinalInspect.Status.OkToIndex)XIC(\S72_GoodPart.Status.OkToIndex)XIC(\S76_GoodPart.Status.OkToIndex)XIC(\S84_RejectPart.Status.OkToIndex)[XIC(i_EmptyNestPRS) ,XIC(Debug_DINT.10) ]OTE(AllStations_Complete);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Check if All Critical Stations Complete for Auto Index]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(\S01_Load.Status.OkToIndex)XIC(\S04_PartLocate.Status.OkToIndex)XIC(\S07_LocationReject.Status.OkToIndex)XIC(\S56_WireFeed.Status.OkToIndex)XIC(\S21_BarrelReject.Status.OkToIndex)XIC(\S28_InductiveHeaters.Status.OkToIndex)XIC(\S55_TempInspect.Status.OkToIndex)XIC(\S56_WireFeed.Status.OkToIndex)XIC(\S72_GoodPart.Status.OkToIndex)XIC(\S76_GoodPart.Status.OkToIndex)XIC(\S84_RejectPart.Status.OkToIndex)[XIC(i_EmptyNestPRS) ,XIC(Debug_DINT.10) ]OTE(AllCriticalStations_Complete);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Check if All Actuators in Safe Position for Index]]>
</Comment>
<Text>
<![CDATA[XIC(\S01_PickRobot.IsClearOfDial)XIC(\S04_PartLocate.Status.SafeToIndex)XIC(\S07_LocationReject.Status.SafeToIndex)XIC(\S21_BarrelReject.Status.SafeToIndex)XIC(\S56_WireFeed.Status.SafeToIndex)XIC(\S72_GoodPart.Status.SafeToIndex)XIC(\S76_GoodPart.Status.SafeToIndex)XIC(\S84_RejectPart.Status.SafeToIndex)XIC(i_HomingPinRet)OTE(Actuators_Safe);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Latch Part Present if Part Stuck in Nest When Indexer Completes Move]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(IOBlock_04_IN.ProcessDataIn.Port_X7A)OTL(StationStatus[83].PartPresent);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Determine If Indexer In Position & Next Head To Move To]]>
</Comment>
<Text>
<![CDATA[[AOI_TruncateReal(AOI_IndexerPosition,a01_Indexer.ActualPosition) ,XIO(a01_Indexer.MoveStatus) XIO(a01_Indexer.JogStatus) [GE(AOI_IndexerPosition.Fraction,0.995) ADD(AOI_IndexerPosition.Whole,1.0,HeadAtStation1) ,LIMIT(0.0,AOI_IndexerPosition.Fraction,0.995) MOVE(AOI_IndexerPosition.Whole,HeadAtStation1) ] ,XIO(a01_Indexer.MoveStatus) XIO(a01_Indexer.JogStatus) [GE(AOI_IndexerPosition.Fraction,0.995) ,LE(AOI_IndexerPosition.Fraction,0.005) ] XIC(a01_Indexer.AxisHomedStatus) OTE(q_IndexerInPosition) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station01.Lockout)XIO(g_DryCycle_Enabled)XIO(Cleanout_Enabled)XIC(a01_Indexer.AxisHomedStatus)[GE(AOI_IndexerPosition.Fraction,0.85) ,LE(AOI_IndexerPosition.Fraction,0.005) ]XIO(Status.State[7])[XIO(StationStatus[1].PartPresent) XIO(\S01_Load.q_RobotWaitToPlace) XIO(q_AutoIndexing) XIO(HMI_Data.HeadControl[S1HeadNumber].Lockout) ,[XIC(Status.State[10]) XIC(a01_Indexer.DecelStatus) XIO(HMI_Data.HeadControl[S90HeadNumber].Lockout) ,XIC(Status.State[13]) XIO(HMI_Data.HeadControl[S1HeadNumber].Lockout) ,XIC(Status.State[16]) XIO(HMI_Data.HeadControl[S1HeadNumber].Lockout) ] ]OTE(q_RobotOkToOpenNest);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Station Cleanout Requests On Alarm]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOff)[XIC(\S01_PickRobot.q_CleanoutReq) MOVE(1,Faulted_Station) ,XIC(\S01_Load.q_CleanoutReq) MOVE(1,Faulted_Station) ,XIC(\S04_PartLocate.q_CleanoutReq) MOVE(4,Faulted_Station) ,XIC(\S06_LocationInspect.q_CleanoutReq) MOVE(6,Faulted_Station) ,XIC(\S07_LocationReject.q_CleanoutReq) MOVE(7,Faulted_Station) ,XIC(\S17_BarrelInspect.q_CleanoutReq) MOVE(17,Faulted_Station) ,XIC(\S21_BarrelReject.q_CleanoutReq) MOVE(21,Faulted_Station) ,XIC(\S28_InductiveHeaters.q_CleanoutReq) MOVE(28,Faulted_Station) ,XIC(\S55_TempInspect.q_CleanoutReq) MOVE(44,Faulted_Station) ,XIC(\S56_WireFeed.q_CleanoutReq) MOVE(56,Faulted_Station) ,XIC(\S61_FinalInspect.q_CleanoutReq) MOVE(67,Faulted_Station) ,XIC(\S72_GoodPart.q_CleanoutReq) MOVE(72,Faulted_Station) ,XIC(\S76_GoodPart.q_CleanoutReq) MOVE(76,Faulted_Station) ,XIC(\S84_RejectPart.q_CleanoutReq) MOVE(84,Faulted_Station) ]OTE(Fault_Cleanout);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Cleanout Mode Control]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)[XIC(HMI_Button.1) ,XIC(Cleanout_Requested) ,XIC(Fault_Cleanout) ]OTE(Cleanout_Requested);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Cleanout_Requested)[XIC(Status.State[4]) ,XIC(Cleanout_Enabled) ]OTL(Cleanout_Enabled);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Attempt Auto Index If Maximum Cycle Timer Finishes]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIC(q_PartsInHeaters) ,XIC(Cleanout_Enabled) ,XIC(HMI_Data.StationData.Station01.Lockout) ,XIC(g_DryCycle_Enabled) ]TON(Timer[7],?,?)XIC(Timer[7].DN)[OTE(q_AutoIndex_Initiate) ,OTL(q_AutoIndexing) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(Status.State[3]) ,XIC(Status.State[16]) ,XIC(Status.State[127]) ]OTU(q_AutoIndexing);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[SUB(ActiveRecipe.MaximumCycleTime,HMI_FullIndexTime,Timer[7].PRE);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(q_PartsInHeaters)MovingAverage(MovingAverage,HMI_Data.Status.CycleTime,28);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(CycleRunning)XIC(Cleanout_Enabled)XIC(IndexerEmpty)TON(Timer[1],?,?)XIC(Timer[1].DN)ONS(ONS.5)OTL(Cleanout_Stop);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIO(CycleRunning)[[XIC(Cleanout_Enabled) TON(Timer[2],?,?) XIC(Timer[2].DN) ,XIC(Cleanout_Stop) ] OTU(Cleanout_Enabled) ,OTU(Cleanout_Stop) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Indexer Motion Control]]>
</Comment>
<Text>
<![CDATA[AOI_ServoAxis(AOI_Axis_Basic,Axis,MotionGroup,HMI_Axis,\Supervisor.Control.StateReg,SafetyOK,FaultReset,Actuators_Safe,0,25.0,150.0,5,150.0,0.1,1,0);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Manual Mode Indexer Motion Control]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[MOVE(HMI_Axis.Control.ManualSpeed,Axis_MAMParam.Speed) ,XIC(HMI_Button.0) ONS(ONS.7) [XIO(q_IndexerInPosition) SUB(1.0,AOI_IndexerPosition.Fraction,Axis_MAMParam.Position) ,XIC(q_IndexerInPosition) [GE(AOI_IndexerPosition.Fraction,0.995) CPT(Axis_MAMParam.Position,1.0 + (1.0-AOI_IndexerPosition.Fraction)) ,LE(AOI_IndexerPosition.Fraction,0.005) CPT(Axis_MAMParam.Position,1.0-AOI_IndexerPosition.Fraction) ] ] OTE(PositionMoveLoaded_MAN) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Auto Mode Indexer Motion Control]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])[MOVE(HMI_Axis.Control.AutoSpeed,Axis_MAMParam.Speed) ,ONS(ONS.12) [XIO(q_IndexerInPosition) SUB(1.0,AOI_IndexerPosition.Fraction,Axis_MAMParam.Position) ,XIC(q_IndexerInPosition) [GE(AOI_IndexerPosition.Fraction,0.995) CPT(Axis_MAMParam.Position,1.0 + (1.0-AOI_IndexerPosition.Fraction)) ,LE(AOI_IndexerPosition.Fraction,0.005) CPT(Axis_MAMParam.Position,1.0-AOI_IndexerPosition.Fraction) ] ] OTE(PositionMoveLoaded_AUTO) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Axis Motion Command]]>
</Comment>
<Text>
<![CDATA[[XIC(PositionMoveLoaded_MAN) XIO(a01_Indexer.MoveStatus) XIO(a01_Indexer.JogStatus) ,XIC(PositionMoveLoaded_AUTO) XIC(Status.State[7]) GT(Axis_MAMParam.Position,0.01) ]XIC(Actuators_Safe)XIC(HMI_Axis.Status.MotionEnable)XIC(Axis.AxisHomedStatus)MAM(Axis,Axis_MAM,1,Axis_MAMParam.Position,Axis_MAMParam.Speed,Units per sec,HMI_Axis.Control.Accel,Units per sec2,HMI_Axis.Control.Decel,Units per sec2,S-Curve,100,100,% of Time,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Move To Last Known Position After Cycle Start]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(Actuators_Safe)XIC(HMI_Data.s01_Indexer.Status.MotionEnable)XIC(a01_Indexer.AxisHomedStatus)MAM(a01_Indexer,Axis_MAM_ShortestPath,2,LastKnownPosition,0.5,Units per sec,1,Units per sec2,1,Units per sec2,S-Curve,100,100,% of Time,Disabled,Programmed,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Monitor Actuators In Position During Motion]]>
</Comment>
<Text>
<![CDATA[[XIC(Axis_MAM.IP) ,XIC(Axis_MAM_ShortestPath.IP) ]XIO(Actuators_Safe)TON(Timer[4],?,?);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(Timer[4].DN)MAS(a01_Indexer,Axis_MAS,All,No,0,Units per sec2,No,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Max Jog Detection]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOff)[XIC(HMI_Axis.Control.JogPositive) ,XIC(HMI_Axis.Control.JogNegative) ]TON(Timer[9],?,?)XIC(Timer[9].DN)OTU(HMI_Axis.Control.JogPositive)OTU(HMI_Axis.Control.JogNegative);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Overall Cycle Time]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[DIV(Timer[6].ACC,1000,HMI_Data.Status.CycleTime) ,GT(HMI_Data.Status.CycleTime,1.0) [MOVE(HMI_Data.Status.CycleTime,CycleTimeArrayA[CycleTimeIndexA]) ADD(CycleTimeIndexA,1,CycleTimeIndexA) GT(CycleTimeIndexA,24) MOVE(0,CycleTimeIndexA) ,MOVE(HMI_Data.Status.CycleTime,CycleTimeArrayB[CycleTimeIndexB]) ADD(CycleTimeIndexB,1,CycleTimeIndexB) GT(CycleTimeIndexB,99) MOVE(0,CycleTimeIndexB) ] ,[AVE(CycleTimeArrayA[0],0,HMI_Data.Status.AverageTimeA,AverageTimeA_CTRL,?,?) ,AVE(CycleTimeArrayB[0],0,HMI_Data.Status.AverageTimeB,AverageTimeB_CTRL,?,?) ] ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)XIO(Status.State[16])TON(Timer[6],?,?);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[[XIC(\S01_Load.Status.OkToIndex) ONS(CycleTimeONS[1]) MOVE(Timer[6].ACC,CycleTimeStorage[1]) ,XIC(\S04_PartLocate.Status.OkToIndex) ONS(CycleTimeONS[2]) MOVE(Timer[6].ACC,CycleTimeStorage[2]) ,XIC(\S06_LocationInspect.Status.OkToIndex) ONS(CycleTimeONS[3]) MOVE(Timer[6].ACC,CycleTimeStorage[3]) ,XIC(\S07_LocationReject.Status.OkToIndex) ONS(CycleTimeONS[4]) MOVE(Timer[6].ACC,CycleTimeStorage[4]) ,XIC(\S17_BarrelInspect.Status.OkToIndex) ONS(CycleTimeONS[6]) MOVE(Timer[6].ACC,CycleTimeStorage[6]) ,XIC(\S21_BarrelReject.Status.OkToIndex) ONS(CycleTimeONS[7]) MOVE(Timer[6].ACC,CycleTimeStorage[7]) ,XIC(\S28_InductiveHeaters.Status.OkToIndex) ONS(CycleTimeONS[8]) MOVE(Timer[6].ACC,CycleTimeStorage[8]) ,XIC(\S55_TempInspect.Status.OkToIndex) ONS(CycleTimeONS[9]) MOVE(Timer[6].ACC,CycleTimeStorage[9]) ,XIC(\S56_WireFeed.Status.OkToIndex) ONS(CycleTimeONS[10]) MOVE(Timer[6].ACC,CycleTimeStorage[10]) ,XIC(\S61_FinalInspect.Status.OkToIndex) ONS(CycleTimeONS[11]) MOVE(Timer[6].ACC,CycleTimeStorage[11]) ,XIC(\S72_GoodPart.Status.OkToIndex) ONS(CycleTimeONS[12]) MOVE(Timer[6].ACC,CycleTimeStorage[12]) ,XIC(\S76_GoodPart.Status.OkToIndex) ONS(CycleTimeONS[13]) MOVE(Timer[6].ACC,CycleTimeStorage[13]) ,XIC(\S84_RejectPart.Status.OkToIndex) ONS(CycleTimeONS[14]) MOVE(Timer[6].ACC,CycleTimeStorage[14]) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(ManButtonOnPrevScan)MOVE(0,HMI_Button);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[NE(HMI_Button,0)OTE(ManButtonOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Servo Drive Fault]]>
</Comment>
<Text>
<![CDATA[NE(a01_Indexer.AxisFault,0)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Index Move To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) TON(AlarmTimer[2],?,?) XIC(AlarmTimer[2].DN) ,XIC(Alarm[1].Active) XIO(FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Actuators NOT In Safe Position During Index]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) ,XIC(Status.State[10]) ,XIC(Status.State[105]) ]XIO(Actuators_Safe)XIC(Timer[4].DN)[OTL(Actuators_NotSafeLatch) ,MOVE(EmptyString,s_ActualtorFaultmsg) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Debug: Find Reason Why Index Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(Actuators_NotSafeLatch)ONS(ONS.8)[XIO(\S01_PickRobot.q_NestIsClosed) OTL(IndexerFault.0) MOVE(s_ActuatorFault[0],s_ActualtorFaultmsg) ,XIO(\S01_PickRobot.q_RobotIsClear) OTL(IndexerFault.1) MOVE(s_ActuatorFault[1],s_ActualtorFaultmsg) ,XIO(\S04_PartLocate.Status.SafeToIndex) OTL(IndexerFault.2) MOVE(s_ActuatorFault[2],s_ActualtorFaultmsg) ,XIO(\S07_LocationReject.Status.SafeToIndex) OTL(IndexerFault.3) MOVE(s_ActuatorFault[3],s_ActualtorFaultmsg) ,XIO(\S56_WireFeed.Status.SafeToIndex) OTL(IndexerFault.4) MOVE(s_ActuatorFault[4],s_ActualtorFaultmsg) ,XIO(\S21_BarrelReject.Status.SafeToIndex) OTL(IndexerFault.5) MOVE(s_ActuatorFault[5],s_ActualtorFaultmsg) ,XIO(\S72_GoodPart.Status.SafeToIndex) OTL(IndexerFault.6) MOVE(s_ActuatorFault[6],s_ActualtorFaultmsg) ,XIO(\S76_GoodPart.Status.SafeToIndex) OTL(IndexerFault.7) MOVE(s_ActuatorFault[7],s_ActualtorFaultmsg) ,XIO(\S84_RejectPart.Status.SafeToIndex) OTL(IndexerFault.8) MOVE(s_ActuatorFault[8],s_ActualtorFaultmsg) ,XIO(i_HomingPinRet) OTL(IndexerFault.9) MOVE(s_ActuatorFault[9],s_ActualtorFaultmsg) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(Status.State[11]) ,XIC(Status.State[12]) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,CONCAT(s_ActuatorFaultmsg_PRE,s_ActualtorFaultmsg,Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(Alarm[2].Active) ,XIO(CycleRunning) ]OTU(Actuators_NotSafeLatch);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Index Move To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) XIC(BentPartSensorOK_PRS) TON(AlarmTimer[0],?,?) XIC(AlarmTimer[0].DN) ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Bent Part Detected During Index]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) XIO(BentPartSensorOK_PRS) XIC(Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(BentPartSensorOK_PRS) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.AOI_s01_Indexer_EIP.ComOK)XIO(a01_Indexer.AxisHomedStatus)OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Part Detected in Empty Nest Verify]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) XIO(i_EmptyNestPRS) ,XIC(Alarm[6].Active) XIO(FaultReset) ]XIO(Debug_DINT.10)OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Waiting for Actuators Safe Before Index Start]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[4]) XIC(AllCriticalStations_Complete) ,XIC(Status.State[100]) ] XIO(Actuators_Safe) XIC(Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Indexer did not Index Automatically with Parts in Heaters]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) XIC(q_PartsInHeaters) TON(AlarmTimer[1],?,?) XIC(AlarmTimer[1].DN) ,XIC(Alarm[8].Active) XIO(FaultReset) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Indexer is NOT in Position After Index]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) XIC(Axis_MAM.PC) XIO(q_IndexerInPosition) TON(AlarmTimer[2],?,?) XIC(AlarmTimer[2].DN) ,XIC(Alarm[9].Active) XIO(FaultReset) ]OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R30_ShiftData" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Shift all station data after index complete]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[FOR i:=1 TO 89 DO]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[//start in descending order using j	to use FIFO method]]>
</Line>
<Line Number="5">
<![CDATA[	j:= 90-i;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[	COP(StationStatus[j],StationStatus[j+1],1);]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[//copy blank data into first station]]>
</Line>
<Line Number="12">
<![CDATA[COP(StationStatusEmpty,StationStatus[1],1);]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[//new head number logic]]>
</Line>
<Line Number="15">
<![CDATA[for i:=1 to 90 do]]>
</Line>
<Line Number="16">
<![CDATA[		StationStatus[i].HeadNumber := (HeadAtStation1 + 90 - i) MOD 90;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[end_for;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[//Update Head Number on each station]]>
</Line>
<Line Number="21">
<![CDATA[S1HeadNumber:=StationStatus[1].HeadNumber;]]>
</Line>
<Line Number="22">
<![CDATA[S2HeadNumber:=StationStatus[2].HeadNumber;]]>
