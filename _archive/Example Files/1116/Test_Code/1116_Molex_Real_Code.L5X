<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[This logic toggles between OutputATag and OutputBTag
(When A is On , B is Off)]]>
</Comment>
<Text>
<![CDATA[XIC(Trigger)XIO(Invisible)XIO(Inactive)ONS(OneShot)[[XIC(OutputATag) XIO(OutputBTag) ,XIO(OutputATag) [XIC(OutputBTag) ,XIC(UseOutputAOnly) ] ] [[XIO(OutputATag) [OTL(OutputATag) OTL(OutputAStatus) ,OTE(ToggleMemoryBit) ] ,XIC(OutputATag) XIO(ToggleMemoryBit) OTU(OutputATag) OTU(OutputAStatus) ] ,XIO(UseOutputAOnly) [XIC(OutputATag) OTU(OutputBTag) OTU(OutputBStatus) ,XIO(OutputATag) OTL(OutputBTag) OTL(OutputBStatus) ] ] ,XIO(OutputATag) XIO(OutputBTag) XIO(UseOutputAOnly) [XIC(OutputAPressed) OTL(OutputATag) OTL(OutputAStatus) ,XIC(OutputBPressed) OTL(OutputBTag) OTL(OutputBStatus) ] ,XIC(OutputATag) XIC(OutputBTag) [XIC(OutputAPressed) OTU(OutputBTag) OTU(OutputBStatus) ,XIC(OutputBPressed) OTU(OutputATag) OTU(OutputAStatus) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(Trigger)[XIC(OutputATag) OTL(OutputAStatus) ,XIO(OutputATag) OTU(OutputAStatus) ,XIC(OutputBTag) OTL(OutputBStatus) ,XIO(OutputBTag) OTU(OutputBStatus) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(InterlockActive) [LT(SecurityCurrentLevel,MinAccessLevel) ,XIC(GreyOutCondition) ] ,XIC(InterlockActive) ]OTE(Inactive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(VisibilityCondition)OTE(Invisible);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
