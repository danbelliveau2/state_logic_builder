<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Convert ASCII string of characters to ASCII representation of the hex equivalents.
The ASCII input string must be characters 0-9 A-F.
The ASCII output string will be half the size of the input string as we're converting bytes to nibbles.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Typical use is an input array of SINT.]]>
</Line>
<Line Number="1">
<![CDATA[//Treat each SINT as two hex values.]]>
</Line>
<Line Number="2">
<![CDATA[//Convert each hex value to a characted.]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[size(InputTag_SINT,0,InputArraySize);]]>
</Line>
<Line Number="5">
<![CDATA[size(OutputTag_DATA,0,OutputArraySize);]]>
</Line>
<Line Number="6">
<![CDATA[DN := 0;]]>
</Line>
<Line Number="7">
<![CDATA[ER := 0;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[//Initialize the output string by clearing it.]]>
</Line>
<Line Number="10">
<![CDATA[for outIter := 0 to OutputArraySize - 1 by 1 do]]>
</Line>
<Line Number="11">
<![CDATA[	OutputTag_DATA[outIter] := 0;]]>
</Line>
<Line Number="12">
<![CDATA[	OutputTag_LEN := 0;]]>
</Line>
<Line Number="13">
<![CDATA[end_for;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[//Populate the output string with numeric representation of the hex values.]]>
</Line>
<Line Number="16">
<![CDATA[for inIter := 0 to InputArraySize - 1 by 1 do]]>
</Line>
<Line Number="17">
<![CDATA[	ascHex := InputTag_SINT[inIter];]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[	//Output array index is twice the input iterator value because there are 2 Hex chars per input SINT.]]>
</Line>
<Line Number="20">
<![CDATA[	outIter := (InputArraySize - 1 - inIter) * 2;]]>
</Line>
<Line Number="21">
<![CDATA[	if (outIter < (OutputArraySize - 1)) then]]>
</Line>
<Line Number="22">
<![CDATA[		OutputTag_DATA[outIter + 1] := ascHex AND 16#0F; //low nibble.]]>
</Line>
<Line Number="23">
<![CDATA[		OutputTag_DATA[outIter] := (ascHex AND 16#F0) / 16; //high nibble.]]>
</Line>
<Line Number="24">
<![CDATA[	else]]>
</Line>
<Line Number="25">
<![CDATA[		//Output string size dicates how much data is retrieved.]]>
</Line>
<Line Number="26">
<![CDATA[		//Don't error out trying to convert too much data.]]>
</Line>
<Line Number="27">
<![CDATA[		exit; //Exit the for loop.]]>
</Line>
<Line Number="28">
<![CDATA[	end_if;]]>
</Line>
<Line Number="29">
<![CDATA[end_for;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[//Convert the numeric to ASCII.]]>
</Line>
<Line Number="32">
<![CDATA[for outIter := 0 to OutputArraySize - 1 by 1 do]]>
</Line>
<Line Number="33">
<![CDATA[	hexDec := OutputTag_DATA[outIter];]]>
</Line>
<Line Number="34">
<![CDATA[	if (outIter < inIter * 2) then]]>
</Line>
<Line Number="35">
<![CDATA[		if (hexDec >= 0 AND hexDec <= 9) then]]>
</Line>
<Line Number="36">
<![CDATA[			OutputTag_DATA[outIter] := hexDec + 48;]]>
</Line>
<Line Number="37">
<![CDATA[		elsif (hexDec >= 10 AND hexDec <= 15) then]]>
</Line>
<Line Number="38">
<![CDATA[			OutputTag_DATA[outIter] := hexDec + 55; //A-F]]>
</Line>
<Line Number="39">
<![CDATA[		end_if;]]>
</Line>
<Line Number="40">
<![CDATA[	else]]>
</Line>
<Line Number="41">
<![CDATA[		exit; //Exit the for loop]]>
</Line>
<Line Number="42">
<![CDATA[	end_if;]]>
</Line>
<Line Number="43">
<![CDATA[end_for;]]>
</Line>
<Line Number="44">
<![CDATA[OutputTag_LEN := outIter; //Setting the string LEN is necessary.]]>
</Line>
<Line Number="45">
<![CDATA[//Fill any remaining output string with NULL.]]>
</Line>
<Line Number="46">
<![CDATA[DN := 1;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="HMI_OutMom" Class="Standard" Revision="3.1" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-09-11T17:38:56.392Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2023-05-12T15:20:07.008Z" EditedBy="STEVENDOUGLAS\dgarr"
