<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[AOI_Debounce(i_ToteBackedUpDebounce,i_ToteBackedUp,3000,50);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[AOI_Debounce(i_TotePresentDebounce,i_TotePresent,1000,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)XIC(\SafetyProgram.Safe_q_Status_Unload)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(SafetyOK)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(i_ChuteDoorRet)XIO(i_ToteBackedUp)XIC(i_TotePresentDebounce.On)XIC(i_TotePusherRet)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Recipe Inputs]]>
</Comment>
<Text>
<![CDATA[MOVE(ActiveRecipe.PartsPerBin,d_MaxPartsPerTote);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[22]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Extend Chute Door]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,[XIC(Status.State[22]) ,XIC(Status.State[124]) ] ]XIC(CycleRunning)[GE(d_TotePartCount,d_MaxPartsPerTote) ,XIC(HMI_Button.9) ]XIC(i_ToteBackedUpDebounce.Off)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Reset Part Counts]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(SensorTimer[0].DN)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Extend Tote Pusher]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: Retract Tote Pusher]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(SensorTimer[1].DN)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 16: Confirm New Tote Present]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(i_TotePusherRet)MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 19: Retract Chute Door]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])XIC(i_TotePresentDebounce.On)MOVE(19,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 22: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])XIC(i_ChuteDoorRet)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 100: Retract Tote Pusher]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 105: Check New Tote Present]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(i_TotePusherRet)MOVE(105,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 110: Retract Chute Door]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[105])XIC(i_TotePresentDebounce.On)MOVE(110,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[110])XIC(i_ChuteDoorRet)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(MB.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOff)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(MB.AlwaysOff)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Ok to Drop Status to S72 and S76 Programs]]>
</Comment>
<Text>
<![CDATA[[XIC(i_TotePresentDebounce.On) ,XIC(SensorTimer[0].DN) ]OTE(q_DropPartsOk);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(Status.State[7]) ,XIC(HMI_Button.4) ]MOVE(0,d_TotePartCount);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Extend Tote Pusher]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) ,XIC(ManualMode) XIC(HMI_Button.0) ,XIC(q_TotePusherExtend) [XIO(ManualMode) XIO(Status.State[13]) XIO(Status.State[100]) ,XIC(ManualMode) XIO(HMI_Button.1) ] ]OTE(q_TotePusherExtend);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(q_TotePusherExtend)XIO(i_TotePusherRet)TON(SensorTimer[1],?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(SensorTimer[1].DN)MOVE(0,d_TotePartCount);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Retract Tote Pusher]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) ,XIC(Status.State[100]) ,XIC(ManualMode) XIC(HMI_Button.1) ,XIC(q_TotePusherRetract) [XIO(ManualMode) XIO(Status.State[10]) ,XIC(ManualMode) XIO(HMI_Button.0) ] ]OTE(q_TotePusherRetract);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Extend Chute Door]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ,XIC(ManualMode) XIC(HMI_Button.2) ,XIC(q_ChuteDoorExtend) [XIO(ManualMode) XIO(Status.State[19]) XIO(Status.State[110]) ,XIC(ManualMode) XIO(HMI_Button.3) ] ]OTE(q_ChuteDoorExtend);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(q_ChuteDoorExtend)XIO(i_ChuteDoorRet)TON(SensorTimer[0],?,?);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Retract Chute Door]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) ,XIC(Status.State[110]) ,XIC(ManualMode) XIC(HMI_Button.3) ,XIC(q_ChuteDoorRetract) [XIO(ManualMode) XIO(Status.State[4]) ,XIC(ManualMode) XIO(HMI_Button.2) ] ]OTE(q_ChuteDoorRetract);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(ManButtonOnPrevScan)MOVE(0,HMI_Button);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[NE(HMI_Button,0)OTE(ManButtonOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Tote Backup Detected]]>
</Comment>
<Text>
<![CDATA[XIC(i_ToteBackedUpDebounce.On)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[No Tote Present Warning]]>
</Comment>
<Text>
<![CDATA[XIO(i_TotePresentDebounce.On)[XIC(Status.State[16]) ,XIC(Status.State[105]) ]TON(Timer[1],?,?)XIC(Timer[1].DN)OTL(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(i_TotePresentDebounce.On)OTU(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[No Tote Present Alarm]]>
</Comment>
<Text>
<![CDATA[XIC(Alarm[1].Active)GE(d_TotePartCount,50)OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Failed To Initialize]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[100]) ,XIC(Status.State[105]) ,XIC(Status.State[110]) ] TON(Timer[2],?,?) XIC(Timer[2].DN) ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
<ScheduledPrograms>
<ScheduledProgram Name="MapInputs"/>
<ScheduledProgram Name="Supervisor"/>
<ScheduledProgram Name="IndexerDial"/>
