<Text>
<![CDATA[XIC(X_Axis_Permissive)[XIC(Status.State[8]) MOVE(Axis_ProcessPos,Axis_MAMParam.Position) MOVE(HMI_Axis.Control.AutoSpeed,Axis_MAMParam.Speed) ,[XIC(Status.State[10]) ,XIC(Status.State[115]) ] MOVE(Axis_WaitPos,Axis_MAMParam.Position) MOVE(HMI_Axis.Control.AutoSpeed,Axis_MAMParam.Speed) ]OTE(PositionMoveLoaded_AUTO);]]>
