<Text>
<![CDATA[[XIC(\S72_GoodPart.q_RejectPart) ,XIC(\S84_RejectPart.q_RejectPart) ]ONS(ONS.1)ADD(ProductionData.Reject,1,ProductionData.Reject);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Total Parts]]>
</Comment>
<Text>
<![CDATA[ADD(ProductionData.Good,ProductionData.Reject,ProductionData.Total);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.GoodPercent,(ProductionData.Good/ProductionData.Total)*100);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.RejectPercent,(ProductionData.Reject/ProductionData.Total)*100);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)[RTO(CycleRuntime,?,?) ,XIC(CycleRuntime.DN) ADD(ProductionData.RuntimeSec,1,ProductionData.RuntimeSec) DIV(ProductionData.RuntimeSec,60,ProductionData.RuntimeMin) RES(CycleRuntime) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)[RTO(CycleDowntime,?,?) ,XIC(CycleDowntime.DN) ADD(ProductionData.DowntimeSec,1,ProductionData.DowntimeSec) DIV(ProductionData.DowntimeSec,60,ProductionData.DowntimeMin) RES(CycleDowntime) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[ADD(ProductionData.RuntimeMin,ProductionData.DowntimeMin,ProductionData.ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.GoodRate,(ProductionData.Good/ProductionData.RuntimeMin));]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[OEE

***NOTE - PlannedProductionTime Input Must Equal Total Shift Time (480 Minutes) - Planned Downtime (Breaks, Lunches, ect.) In Minutes***
***NOTE - IdealCycleTime Input Must Equal Cycle Time Of Machine In Seconds***]]>
</Comment>
<Text>
<![CDATA[OEE(ProductionDataOEE,480,ProductionData.RuntimeSec,ProductionData.DowntimeSec,OEE_CycleTime,ProductionData.Total,ProductionData.Good,ProductionData.Availability,ProductionData.Performance,ProductionData.Quality,ProductionData.OEE);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)XIC(\Supervisor.q_MachineFaultActive)ONS(ONS.2)ADD(ProductionData.TotalFaults,1,ProductionData.TotalFaults);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Reset Total Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ResetPartCounts) ,XIC(HMI_ResetAllCounts) ]TON(HoldTimerA,?,?)XIC(HoldTimerA.DN)COP(EmptyData,ProductionData,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_ShiftData" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Shift Data - Uses Array Indexes 1,2,3

Calculate Shift Number]]>
</Comment>
<Text>
<![CDATA[[EQ(g_CPUDateTime.Hour,6) EQ(g_CPUDateTime.Minutes,30) ONS(ONS.3) MOVE(1,CurrentShift) MOVE(3,PreviousShift) ,EQ(g_CPUDateTime.Hour,18) EQ(g_CPUDateTime.Minutes,30) ONS(ONS.4) MOVE(2,CurrentShift) MOVE(1,PreviousShift) ,EQ(g_CPUDateTime.Hour,23) EQ(g_CPUDateTime.Minutes,30) ONS(ONS.5) MOVE(3,CurrentShift) MOVE(2,PreviousShift) ]OTE(ShiftChangedPulse);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(ShiftChangedPulse)COP(EmptyData,ShiftData[CurrentShift],1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Good Parts

***NOTE - Replace MachineBasic.AlwaysOff With Good Part Trigger***]]>
</Comment>
<Text>
<![CDATA[[XIC(\S72_GoodPart.q_GoodPart) ONS(ONS.6) ,XIC(\S76_GoodPart.q_GoodPart) ONS(ONS.11) ]ADD(ShiftData[CurrentShift].Good,1,ShiftData[CurrentShift].Good);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Reject Parts

***NOTE - Replace MachineBasic.AlwaysOff With Reject Part Trigger***]]>
</Comment>
<Text>
<![CDATA[[XIC(\S72_GoodPart.q_RejectPart) ,XIC(\S84_RejectPart.q_RejectPart) ]ONS(ONS.7)ADD(ShiftData[CurrentShift].Reject,1,ShiftData[CurrentShift].Reject);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Total Parts]]>
</Comment>
<Text>
<![CDATA[ADD(ShiftData[CurrentShift].Good,ShiftData[CurrentShift].Reject,ShiftData[CurrentShift].Total);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[CurrentShift].GoodPercent,(ShiftData[CurrentShift].Good/ShiftData[CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[CurrentShift].RejectPercent,(ShiftData[CurrentShift].Reject/ShiftData[CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)[RTO(ShiftRuntime,?,?) ,XIC(ShiftRuntime.DN) ADD(ShiftData[CurrentShift].RuntimeSec,1,ShiftData[CurrentShift].RuntimeSec) DIV(ShiftData[CurrentShift].RuntimeSec,60,ShiftData[CurrentShift].RuntimeMin) RES(ShiftRuntime) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)[RTO(ShiftDowntime,?,?) ,XIC(ShiftDowntime.DN) ADD(ShiftData[CurrentShift].DowntimeSec,1,ShiftData[CurrentShift].DowntimeSec) DIV(ShiftData[CurrentShift].DowntimeSec,60,ShiftData[CurrentShift].DowntimeMin) RES(ShiftDowntime) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[ADD(ShiftData[CurrentShift].RuntimeMin,ShiftData[CurrentShift].DowntimeMin,ShiftData[CurrentShift].ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[CurrentShift].GoodRate,(ShiftData[CurrentShift].Good/ShiftData[CurrentShift].RuntimeMin));]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[OEE

***NOTE - PlannedProductionTime Input Must Equal Total Shift Time (480 Minutes) - Planned Downtime (Breaks, Lunches, ect.) In Minutes***
***NOTE - IdealCycleTime Input Must Equal Cycle Time Of Machine In Seconds***]]>
</Comment>
<Text>
<![CDATA[OEE(ShiftDataOEE,480,ShiftData[CurrentShift].RuntimeSec,ShiftData[CurrentShift].DowntimeSec,OEE_CycleTime,ShiftData[CurrentShift].Total,ShiftData[CurrentShift].Good,ShiftData[CurrentShift].Availability,ShiftData[CurrentShift].Performance,ShiftData[CurrentShift].Quality,ShiftData[CurrentShift].OEE);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)XIC(\Supervisor.q_MachineFaultActive)ONS(ONS.8)ADD(ShiftData[CurrentShift].TotalFaults,1,ShiftData[CurrentShift].TotalFaults);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Reset Current Shift Count]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_ResetCurrentShift)TON(HoldTimerB,?,?)XIC(HoldTimerB.DN)COP(EmptyData,ShiftData[CurrentShift],1);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Reset All Shift Count]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ResetAllShift) ,XIC(HMI_ResetAllCounts) ]TON(HoldTimerC,?,?)XIC(HoldTimerC.DN)COP(EmptyData,ShiftData[1],1)COP(EmptyData,ShiftData[2],1)COP(EmptyData,ShiftData[3],1);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[CPT(OEE_CycleTime,ActiveRecipe.MaximumCycleTime / 1000);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
