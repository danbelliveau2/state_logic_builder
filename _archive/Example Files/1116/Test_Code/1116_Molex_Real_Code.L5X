<![CDATA[[[0,0,0,0,[39,'S21 Barrel Reject: Failed to Initialize$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],0,0,0,0],[13,1,0,0,[63,'S21 Barrel Reject: Failed to Retract Nest Opener During Process$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],1773255546732876,4,59,0],[13,2,1,0,[62,'S21 Barrel Reject: Reject Bin Not Present. Adjust or Add Tote.$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
