<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(HMI_LocalManualOverride) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(HMI_Axis.Status.MotionEnable)XIC(Axis.AxisHomedStatus)XIC(AOI_Axis_RC_1.In_Range)XIC(SensorTimer[2].DN)XIC(i_VertCylinderRet)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Recipe Inputs]]>
</Comment>
<Text>
<![CDATA[SUB(Axis_ProcessPos,5,Axis_MinimumIndexPos)SUB(Axis_ProcessPos,10,Axis_WaitPos);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[MOVE(PartLocateArray[ActiveRecipe.PartType],Axis_ProcessPos);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Use Amount of Part Sticking Out for Wirefeed Start Position Calculation]]>
</Comment>
<Text>
<![CDATA[SUB(Axis_BaseNestPos,Axis_ProcessPos,q_ExtrudedPartLength);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[60]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Extend Vertical Cylinder]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,[XIC(Status.State[60]) ,XIC(Status.State[124]) ] ]XIC(CycleRunning)XIO(HMI_Data.StationData.Station04.Lockout)XIO(q_CleanoutReq)XIC(StationStatus[4].PartPresent)XIO(StationStatus[4].S04Attempt)XIO(HMI_Data.HeadControl[\IndexerDial.S4HeadNumber].Lockout)XIO(SS)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Close Gripper]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIC(SensorTimer[0].DN) ,TON(Timer[0],?,?) XIC(Timer[0].DN) ]XIO(SS)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 8: Move Servo To Process Pos and Open Nest]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(SensorTimer[1].DN)XIO(SS)MOVE(8,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 9: Wait for Servo Completed]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])[XIC(AOI_Axis_RC_2.In_Range) XIC(Axis_MAM.PC) ,[TON(Timer[4],?,?) ,XIC(Timer[4].TT) MOVE(Timer[4].ACC,Debug_ServoMoveTimer) ] XIC(Timer[4].DN) ]XIC(SensorTimer[3].DN)XIO(SS)MOVE(9,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 10:  Close Nest and Move Servo To Wait Pos]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[9])XIO(SS)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 10: Open Gripper Cylinder]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(i_NestOpenRet)XIO(SS)MOVE(11,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 13: Retract Vertical Cylinder]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[11])XIC(SensorTimer[2].DN)XIO(SS)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 60: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(i_VertCylinderRet)XIC(AOI_Axis_RC_1.In_Range)XIO(SS)MOVE(60,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 100: Start of initialization sequence]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)XIO(HMI_Data.StationData.Station04.Lockout)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 105: Open Gripper]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])MOVE(105,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 110: Retract Vertical Cylinder]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[105])MOVE(110,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 115: Move Servo to Wait Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[110])XIC(i_VertCylinderRet)MOVE(115,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[115])XIC(AOI_Axis_RC_1.In_Range)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(MB.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,59) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[LIMIT(4,Control.StateReg,59)XIO(SS)MOVE(3000,Control.FaultTime)OTE(Control.EnaFaultDetect);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Axis.Status.MotionEnable)XIC(Axis.AxisHomedStatus)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(StationStatus[4].PartPresent) ,XIC(StationStatus[4].PartPresent) [XIC(StationStatus[4].S04Success) ,XIC(StationStatus[4].Reject) ] ,XIC(HMI_Data.HeadControl[\IndexerDial.S4HeadNumber].Lockout) ,XIC(HMI_Data.StationData.Station04.Lockout) ]OTE(Status.OkToIndex);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(i_NestOpenRet)XIC(i_VertCylinderRet)LT(Axis.ActualPosition,Axis_MinimumIndexPos)OTE(Status.SafeToIndex);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Status.State[4])OTL(StationStatus[4].S04Attempt);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Status.State[13])OTL(StationStatus[4].S04Success);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Status.State[8]) XIC(Timer[4].DN) ,XIC(Status.State[127]) ]OTL(StationStatus[4].Reject);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Debug: Change Axis Torque Settings]]>
</Comment>
<Text>
<![CDATA[XIC(Debug_DINT.5)MOVE(r_TorquePos,Axis.TorqueLimitPositive)MOVE(r_TorqueNeg,Axis.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Extend Vertical Cylinder]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ,XIC(ManualMode) XIC(HMI_Button.0) ,XIC(q_VerticalExtend) [XIO(ManualMode) XIO(Status.State[13]) XIO(Status.State[110]) ,XIC(ManualMode) XIO(HMI_Button.1) ] ]OTE(q_VerticalExtend);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(i_VertCylinderRet)XIC(q_VerticalExtend)TON(SensorTimer[0],?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Retract Vertical Cylinder]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) ,XIC(Status.State[110]) ,XIC(ManualMode) XIC(HMI_Button.1) ,XIC(q_VerticalRetract) [XIO(ManualMode) XIO(Status.State[4]) ,XIC(ManualMode) XIO(HMI_Button.0) ] ]OTE(q_VerticalRetract);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Close Gripper]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) ,XIC(ManualMode) XIC(HMI_Button.2) ,XIC(q_GripperClose) [XIO(ManualMode) XIO(Status.State[11]) XIO(Status.State[105]) ,XIC(ManualMode) XIO(HMI_Button.3) ] ]OTE(q_GripperClose);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(q_GripperClose)TON(SensorTimer[1],?,?);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Open Gripper]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[11]) ,XIC(Status.State[105]) ,XIC(ManualMode) XIC(HMI_Button.3) ,XIC(q_GripperOpen) [XIO(ManualMode) XIO(Status.State[7]) ,XIC(ManualMode) XIO(HMI_Button.2) ] ]OTE(q_GripperOpen);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(q_GripperOpen)TON(SensorTimer[2],?,?);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Extend Nest Opener]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[8]) ,XIC(ManualMode) XIC(HMI_Button.4) ,XIC(q_NestOpen) [XIO(ManualMode) XIO(Status.State[10]) XIO(Status.State[105]) ,XIC(ManualMode) XIO(HMI_Button.5) ] ]OTE(q_NestOpen);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(q_NestOpen)TON(SensorTimer[3],?,?);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Retract Nest Opener]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) ,XIC(Status.State[105]) ,XIC(ManualMode) XIC(HMI_Button.5) ,XIC(q_NestClose) [XIO(ManualMode) XIO(Status.State[8]) ,XIC(ManualMode) XIO(HMI_Button.4) ] ]OTE(q_NestClose);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
