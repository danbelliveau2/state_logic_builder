<![CDATA[XIC(Axis_CMAJ.IP)XIC(HMI_ServoData.Control.CJogStop)[EQ(SpeedUnits,0) MAS(Axis,AxisJog_CMAS,Jog,Yes,HMI_ServoData.Control.Decel,Units per sec2,No,0,Units per sec3) ,EQ(SpeedUnits,1) MAS(Axis,AxisJog_CMAS,Jog,Yes,HMI_ServoData.Control.Decel,% of Maximum,No,0,Units per sec3) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
