</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Save)MOVE(100,Timer[0].PRE)TON(Timer[0],?,?)XIC(Timer[0].DN)ONS(OneShot[12])[GE(SavedPointer,0) LT(SavedPointer,SavedRecipeArrayLength) COP(HMIControlRecipeTag.Editing,HMIStatusRecipeTag.Saved[SavedPointer],1) ,OTL(RefreshFilterList) ,OTL(Save_Recipe) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Sort)MOVE(2000,Timer[3].PRE)TON(Timer[3],?,?)XIC(Timer[3].DN)ONS(OneShot[13])[JSR(Sort,0) ,OTL(RefreshFilterList) ,OTL(Write_MirrorData) ,OTL(Write_SortData) ];]]>
</Text>
