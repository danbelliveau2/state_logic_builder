<Tag Name="AOI_FlexFeed_Recipe" TagType="Base" DataType="AOI_FanucRecipe" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Data Format="L5K">
<![CDATA[[136,2,2,2,5,32,[1867547,10000,0]]]]>
</Data>
<Data Format="Decorated">
