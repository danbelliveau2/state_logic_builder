</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(MB.Flash250msPS)[MOVE(HMI_Axis.Control.AxisPositions[0],Axis_HomePos) ,MOVE(Axis_WaitPos,HMI_Axis.Control.AxisPositions[1]) ,MOVE(Axis_ProcessPos,HMI_Axis.Control.AxisPositions[2]) ,MOVE(HMI_Axis.Control.AxisPositions[3],Axis_BaseNestPos) ];]]>
