<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(HMI_ServoData.Status.MotionEnable)XIO(Axis.MoveStatus)XIO(Axis.JogStatus)[XIC(HMI_ServoData.Control.CJogPositive) MOVE(0,JogDirection) ,XIC(HMI_ServoData.Control.CJogNegative) MOVE(1,JogDirection) ][EQ(SpeedUnits,0) MAJ(Axis,Axis_CMAJ,JogDirection,HMI_ServoData.Control.JogSpeed,Units per sec,HMI_ServoData.Control.Accel,Units per sec2,HMI_ServoData.Control.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None) ,EQ(SpeedUnits,1) MAJ(Axis,Axis_CMAJ,JogDirection,HMI_ServoData.Control.JogSpeed,% of Maximum,HMI_ServoData.Control.Accel,% of Maximum,HMI_ServoData.Control.Decel,% of Maximum,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None) ];]]>
