<Routines>
<Routine Name="Create" Type="ST">
<Description>
<![CDATA[Find the first available slot in the Saved list and use that for a new part.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Find the first empty Save slot]]>
</Line>
<Line Number="1">
<![CDATA[//IF NOT (out_HMIStatusReplaceScreenTag = NewRecipeScreenNum) THEN]]>
</Line>
<Line Number="2">
<![CDATA[	FOR SavedIter := 0 TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="3">
<![CDATA[		IF (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="4">
<![CDATA[			//Copy the editing Recipe to the found Saved slot]]>
</Line>
<Line Number="5">
<![CDATA[			COP(HMIControlRecipeTag.Editing, HMIStatusRecipeTag.Saved[SavedIter], 1);]]>
</Line>
<Line Number="6">
<![CDATA[			//Clear the PartNumber field]]>
</Line>
<Line Number="7">
<![CDATA[			COP(NewPartString30, HMIStatusRecipeTag.Saved[SavedIter].Name, 1);]]>
</Line>
<Line Number="8">
<![CDATA[			COP(NewPartString30, HMIControlRecipeTag.Editing.Name, 1);]]>
</Line>
<Line Number="9">
<![CDATA[			SavedPointer := SavedIter;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[			COP(NewPartString30, HMIControlRecipeTag.FilterPartNumber, 1);]]>
</Line>
<Line Number="12">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="13">
<![CDATA[			FilterListStartPos := SavedIter;]]>
</Line>
<Line Number="14">
<![CDATA[			RefreshFilterList := 1;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="17">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="18">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="19">
<![CDATA[	//out_HMIStatusReplaceScreenTag := NewRecipeScreenNum;]]>
</Line>
<Line Number="20">
<![CDATA[	//out_HMIStatusCloseScreenTag := 0;]]>
</Line>
<Line Number="21">
<![CDATA[//END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="FilterStartPos" Type="ST">
<Description>
<![CDATA[Manage initializing, Incrementing, and Decrementing the Filter List Start Position]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[IF (FilterListStartPos < 0 OR FilterListStartPos >= SavedRecipeArrayLength) THEN]]>
</Line>
<Line Number="1">
<![CDATA[	FilterListStartPos := 0;]]>
</Line>
<Line Number="2">
<![CDATA[END_IF;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[IF (FilterListQty = 0) THEN]]>
</Line>
<Line Number="5">
<![CDATA[	//No Results]]>
</Line>
<Line Number="6">
<![CDATA[	HMIStatusRecipeTag.IndexNumNavi := -1;]]>
</Line>
<Line Number="7">
<![CDATA[ELSE]]>
</Line>
<Line Number="8">
<![CDATA[	//HMI Scroll Home button]]>
</Line>
<Line Number="9">
<![CDATA[	IF (HMIControlRecipeTag.ScrollHome AND NOT OneShot[0]) THEN]]>
</Line>
<Line Number="10">
<![CDATA[		OneShot[0] := 1;]]>
</Line>
<Line Number="11">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="12">
<![CDATA[		FilterListStartPos := 0;]]>
</Line>
<Line Number="13">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="14">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollHome AND OneShot[0]) THEN]]>
</Line>
<Line Number="15">
<![CDATA[		OneShot[0] := 0;]]>
</Line>
<Line Number="16">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[	//HMI Page Up button]]>
</Line>
<Line Number="19">
<![CDATA[	IF (HMIControlRecipeTag.PageUp AND NOT OneShot[1]) THEN]]>
</Line>
<Line Number="20">
<![CDATA[		OneShot[1] := 1;]]>
</Line>
<Line Number="21">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - DisplayListSize;]]>
</Line>
<Line Number="22">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.PageUp AND OneShot[1]) THEN]]>
</Line>
<Line Number="23">
<![CDATA[		OneShot[1] := 0;]]>
</Line>
<Line Number="24">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[	//HMI Scroll Up button]]>
</Line>
<Line Number="27">
<![CDATA[	IF (HMIControlRecipeTag.ScrollUp AND NOT OneShot[2]) THEN]]>
</Line>
<Line Number="28">
<![CDATA[		OneShot[2] := 1;]]>
</Line>
<Line Number="29">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - 1;]]>
</Line>
<Line Number="30">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollUp AND OneShot[2]) THEN]]>
</Line>
<Line Number="31">
<![CDATA[		OneShot[2] := 0;]]>
</Line>
<Line Number="32">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	//HMI Scroll Down button]]>
</Line>
<Line Number="35">
<![CDATA[	IF (HMIControlRecipeTag.ScrollDown AND NOT OneShot[3]) THEN]]>
</Line>
<Line Number="36">
<![CDATA[		OneShot[3] := 1;]]>
</Line>
<Line Number="37">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi + 1;]]>
</Line>
<Line Number="38">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollDown AND OneShot[3]) THEN]]>
</Line>
<Line Number="39">
<![CDATA[		OneShot[3] := 0;]]>
</Line>
<Line Number="40">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[	//HMI Page Down button]]>
</Line>
<Line Number="43">
<![CDATA[	IF (HMIControlRecipeTag.PageDown AND NOT OneShot[4]) THEN]]>
</Line>
<Line Number="44">
<![CDATA[		OneShot[4] := 1;]]>
</Line>
<Line Number="45">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi + DisplayListSize;]]>
</Line>
<Line Number="46">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.PageDown AND OneShot[4]) THEN]]>
</Line>
<Line Number="47">
<![CDATA[		OneShot[4] := 0;]]>
</Line>
<Line Number="48">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[	//HMI Scroll End button]]>
</Line>
<Line Number="51">
<![CDATA[	IF (HMIControlRecipeTag.ScrollEnd AND NOT OneShot[5]) THEN]]>
</Line>
<Line Number="52">
<![CDATA[		OneShot[5] := 1;]]>
</Line>
<Line Number="53">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := SavedRecipeArrayLength - 1;]]>
</Line>
<Line Number="54">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollEnd AND OneShot[5]) THEN]]>
</Line>
<Line Number="55">
<![CDATA[		OneShot[5] := 0;]]>
</Line>
<Line Number="56">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[	IF (HMIStatusRecipeTag.IndexNumNavi >= DisplayListSize) THEN]]>
</Line>
<Line Number="60">
<![CDATA[			//Below the bottom of the Listbox]]>
</Line>
<Line Number="61">
<![CDATA[ 		IF (HMIStatusRecipeTag.IndexNumNavi < (FilterListQty - FilterListStartPos)) THEN]]>
</Line>
<Line Number="62">
<![CDATA[			//There are records to display below the navigation row]]>
</Line>
<Line Number="63">
<![CDATA[			FilterListStartPos := FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[			IF (FilterListStartPos >= FilterListQty) THEN]]>
</Line>
<Line Number="66">
<![CDATA[				//Start position is outside the Filter List]]>
</Line>
<Line Number="67">
<![CDATA[				IF (FilterListQty >= DisplayListSize) THEN]]>
</Line>
<Line Number="68">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := DisplayListSize - 1; //Navigation on the last row]]>
</Line>
<Line Number="69">
<![CDATA[					FilterListStartPos := FilterListQty - DisplayListSize;]]>
</Line>
<Line Number="70">
<![CDATA[				ELSE]]>
</Line>
<Line Number="71">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := FilterListQty - 1; //Navigation on the last row]]>
</Line>
<Line Number="72">
<![CDATA[					FilterListStartPos := 0;]]>
</Line>
<Line Number="73">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="74">
<![CDATA[			ELSE]]>
</Line>
<Line Number="75">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - DisplayListSize;]]>
</Line>
<Line Number="76">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="77">
<![CDATA[		ELSE]]>
</Line>
<Line Number="78">
<![CDATA[			//No more records below the navigation row]]>
</Line>
<Line Number="79">
<![CDATA[			IF (FilterListQty >= DisplayListSize) THEN]]>
</Line>
<Line Number="80">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := DisplayListSize - 1; //Navigation on the last row]]>
</Line>
<Line Number="81">
<![CDATA[				FilterListStartPos := FilterListQty - DisplayListSize;]]>
</Line>
<Line Number="82">
<![CDATA[			ELSE]]>
</Line>
<Line Number="83">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := FilterListQty - 1; //Navigation on the last row]]>
</Line>
<Line Number="84">
<![CDATA[				FilterListStartPos := 0;]]>
</Line>
<Line Number="85">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="87">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="88">
<![CDATA[	ElSIF (HMIStatusRecipeTag.IndexNumNavi >= (FilterListQty - FilterListStartPos)) THEN]]>
</Line>
<Line Number="89">
<![CDATA[		//Below the bottom of the filtered list but above the bottom of the Listbox]]>
</Line>
<Line Number="90">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="91">
<![CDATA[		FilterListStartPos := 0;]]>
</Line>
<Line Number="92">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="93">
<![CDATA[	ELSIF (HMIStatusRecipeTag.IndexNumNavi < 0) THEN]]>
</Line>
<Line Number="94">
<![CDATA[		//Above the Listbox]]>
</Line>
<Line Number="95">
<![CDATA[		IF ((FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi) >= 0) THEN]]>
</Line>
<Line Number="96">
<![CDATA[			//The first value is at or less than the first part in the Saved list]]>
</Line>
<Line Number="97">
<![CDATA[			FilterListStartPos := (FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi);]]>
</Line>
<Line Number="98">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="99">
<![CDATA[		ELSE]]>
</Line>
<Line Number="100">
<![CDATA[			FilterListStartPos := 0;]]>
</Line>
<Line Number="101">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="102">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="103">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="104">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="105">
<![CDATA[END_IF;]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
<![CDATA[]]>
</Line>
<Line Number="108">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<Description>
<![CDATA[Recipe HMI interactions]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Manage the up/down functionality]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(FilterStartPos,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Its amazing that it works, but it in fact does!
In order to compare two UDT's you have to copy the data to two DINT arrays so that you can compare them with the FSC instruction.

Compare the Editing Recipe to its corresponding Saved Recipe Array.
Blink the Save button on the HMI if they're different.]]>
</Comment>
<Text>
<![CDATA[[GT(FilterListQty,0) GE(SavedPointer,0) LT(SavedPointer,SavedRecipeArrayLength) DIV(RecipeStructureUDTSizeBytes,4,RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Saved[SavedPointer],Recipe_Structure_Array_Saved[0],RecipeStructureSizeDINTs) COP(HMIControlRecipeTag.Editing,Recipe_Structure_Array_Editing[0],RecipeStructureSizeDINTs) MOVE(RecipeStructureSizeDINTs,ArrayCompareEdit_C.LEN) [XIO(ArrayCompareEdit_C.EN) FSC(ArrayCompareEdit_C,?,?,INC,Recipe_Structure_Array_Saved[ArrayCompareEdit_C.POS]<>Recipe_Structure_Array_Editing[ArrayCompareEdit_C.POS]) ,[XIC(ArrayCompareEdit_C.DN) OTL(Editing_Equal_Array) ,XIC(ArrayCompareEdit_C.FD) OTU(Editing_Equal_Array) ,[XIC(ArrayCompareEdit_C.FD) ,XIC(ArrayCompareEdit_C.DN) ] OTU(ArrayCompareEdit_C.FD) OTU(ArrayCompareEdit_C.IN) RES(ArrayCompareEdit_C) MOVE(0,ArrayCompareEdit_C.POS) ] ] ,[LE(FilterListQty,0) ,LT(SavedPointer,0) ] OTL(Editing_Equal_Array) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Editing_Equal_Array)OTE(HMIIndicatorEditingEqualTag);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Compare the Running Recipe to its corresponding Saved Recipe Array.
Blink the Download button on the HMI if they're different.]]>
</Comment>
<Text>
<![CDATA[[GT(FilterListQty,0) GE(HMIStatusRecipeTag.Running_ID,0) LT(HMIStatusRecipeTag.Running_ID,SavedRecipeArrayLength) DIV(RecipeStructureUDTSizeBytes,4,RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Saved[HMIStatusRecipeTag.Running_ID],Recipe_Structure_Array_Saved[0],RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Running,Recipe_Structure_Array_Running[0],RecipeStructureSizeDINTs) MOVE(RecipeStructureSizeDINTs,ArrayCompareRun_C.LEN) [XIO(ArrayCompareRun_C.EN) FSC(ArrayCompareRun_C,?,?,INC,Recipe_Structure_Array_Saved[ArrayCompareRun_C.POS]<>Recipe_Structure_Array_Running[ArrayCompareRun_C.POS]) ,[XIC(ArrayCompareRun_C.DN) OTL(Running_Equal_Array) ,XIC(ArrayCompareRun_C.FD) OTU(Running_Equal_Array) ,[XIC(ArrayCompareRun_C.FD) ,XIC(ArrayCompareRun_C.DN) ] OTU(ArrayCompareRun_C.FD) OTU(ArrayCompareRun_C.IN) RES(ArrayCompareRun_C) MOVE(0,ArrayCompareRun_C.POS) ] ] ,[LE(FilterListQty,0) ,LT(HMIStatusRecipeTag.Running_ID,0) ] OTL(Running_Equal_Array) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Running_Equal_Array)OTE(HMIIndicatorSavedRunningEqualTag);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(UpdateSavedPointer)[OTU(UpdateSavedPointer) ,GE(HMIStatusRecipeTag.IndexNumNavi,0) LT(HMIStatusRecipeTag.IndexNumNavi,DisplayListSize) [MOVE(HMIStatusRecipeTag.PartID[HMIStatusRecipeTag.IndexNumNavi],SavedPointer) ,OTL(UpdateEditingRecipe) ] ,LT(HMIStatusRecipeTag.IndexNumNavi,0) [MOVE(-1,SavedPointer) ,COP(EmptyRecipe,HMIControlRecipeTag.Editing,1) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(RefreshFilterList)[OTU(RefreshFilterList) ,JSR(PopulateFilterList,0) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
