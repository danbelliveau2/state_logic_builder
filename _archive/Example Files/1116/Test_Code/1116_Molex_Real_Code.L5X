<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(HMI_LocalManualOverride) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(cam02_S06InspectLocation_IN.Status.RunStatus)EQ(cam02_S06InspectLocation_IN.Status.AssignableByteData2,ActiveRecipe.PartType)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[MOVE(HMI_CameraRejectsPreset,cnt_ConsecutiveRejects.PRE);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[60]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Send Ack]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,[XIC(Status.State[60]) ,XIC(Status.State[124]) ] ]XIC(CycleRunning)XIO(HMI_Data.StationData.Station06.Lockout)XIC(StationStatus[6].PartPresent)XIO(StationStatus[6].S06Attempt)XIO(HMI_Data.HeadControl[\IndexerDial.S6HeadNumber].Lockout)XIO(SS)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 6: Capture Inspection ID]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(cam02_S06InspectLocation_IN.Status.CommandReady)MOVE(6,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 7: Trigger Camera]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])XIC(cam02_S06InspectLocation_IN.Status.TriggerReady)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 10: Wait for Results]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(cam02_S06InspectLocation_IN.Status.TriggerAck)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 13: Store Results]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(cam02_S06InspectLocation_IN.Status.ResultReady)NE(cam02_S06InspectLocation_IN.Status.AssignableByteData3,Image_Count)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 16: Finished Storing Results]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 60: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])MOVE(60,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 100:Start of initialization sequence]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 105: Switch to Run Mode]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])MOVE(105,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 110: Change Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[105])XIC(cam02_S06InspectLocation_IN.Status.RunStatus)NE(cam02_S06InspectLocation_IN.Status.AssignableByteData2,ActiveRecipe.PartType)MOVE(110,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 115: Changing Program Done]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[110])XIO(cam02_S06InspectLocation_IN.Status.ProgramLoadComplete)MOVE(115,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[105]) XIC(cam02_S06InspectLocation_IN.Status.RunStatus) EQ(cam02_S06InspectLocation_IN.Status.AssignableByteData2,ActiveRecipe.PartType) ,XIC(Status.State[115]) XIC(cam02_S06InspectLocation_IN.Status.ProgramLoadComplete) ]MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(MB.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[LIMIT(4,Control.StateReg,59)XIO(SS)MOVE(3000,Control.FaultTime)OTE(Control.EnaFaultDetect);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOn)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(StationStatus[6].PartPresent) ,XIC(StationStatus[6].PartPresent) [XIC(StationStatus[6].S06Success) ,XIC(StationStatus[6].Reject) ] ,XIC(HMI_Data.HeadControl[\IndexerDial.S6HeadNumber].Lockout) ,XIC(HMI_Data.StationData.Station06.Lockout) ]OTE(Status.OkToIndex);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(MB.AlwaysOn)OTE(Status.SafeToIndex);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Status.State[13])MOVE(cam02_S06InspectLocation_IN.InspectionResults.ResultData000,StationStatus[6].WireFeedStartPosX);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Status.State[16])[[LIMIT(HMI_WireFeedStartPosLL,StationStatus[6].WireFeedStartPosX,HMI_WireFeedStartPosHL) XIC(cam02_S06InspectLocation_IN.Status.Pass) ,XIC(HMI_Data.StationData.Station06.Bypass) ,XIC(g_DryCycle_Enabled) ] [OTL(StationStatus[6].S06Success) ,RES(cnt_ConsecutiveRejects) ] ,[GT(StationStatus[6].WireFeedStartPosX,HMI_WireFeedStartPosHL) ,LT(StationStatus[6].WireFeedStartPosX,HMI_WireFeedStartPosLL) ,XIC(cam02_S06InspectLocation_IN.Status.Fail) ] XIO(g_DryCycle_Enabled) XIO(HMI_Data.StationData.Station06.Bypass) ONS(ONS.6) [OTL(StationStatus[6].Reject) ,CTU(cnt_ConsecutiveRejects,?,?) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Status.State[4]) ,XIC(Status.State[60]) ,XIC(Status.State[124]) ,XIC(Debug_DINT.0) ]OTE(cam02_S06InspectLocation_OUT.Control.ResultAck);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(q_AlarmActive)XIC(StationStatus[6].S06Attempt)XIO(StationStatus[6].S06Success)OTL(StationStatus[6].Reject);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(CycleRunning) ,XIC(Debug_DINT.1) ]OTE(Local:6:O.Pt06.Data);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Debug_DINT.3)ONS(ONS.7)OTE(cam02_S06InspectLocation_OUT.Control.Reset);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Capture Inspection ID Before Trigger]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])[OTL(StationStatus[6].S06Attempt) ,MOVE(cam02_S06InspectLocation_IN.Status.AssignableByteData3,Image_Count) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Trigger the Camera]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])OTE(cam02_S06InspectLocation_OUT.Control.Trigger);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Change to Run Mode]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[105])OTE(cam02_S06InspectLocation_OUT.Control.GoToRun);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Status.State[115])MOVE(ActiveRecipe.PartType,cam02_S06InspectLocation_OUT.Control.ProgramNumber)OTE(cam02_S06InspectLocation_OUT.Control.ProgramLoadExecute);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Too Many Rejects in a Row]]>
</Comment>
<Text>
<![CDATA[XIC(cnt_ConsecutiveRejects.DN)[XIC(\IndexerDial.q_PartsInHeaters) [OTE(Alarm[2].Active) ,OTE(q_CleanoutReq) ] ,XIO(\IndexerDial.q_PartsInHeaters) OTE(Alarm[3].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Alarm[2].Active) ,XIC(Alarm[3].Active) ]XIC(FaultReset)RES(cnt_ConsecutiveRejects);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Auto Clear ERR 10130 but still Latch warning]]>
</Comment>
<Text>
<![CDATA[[[NE(cam02_S06InspectLocation_IN.Status.AssignableByteData0,0) MOVE(cam02_S06InspectLocation_IN.Status.AssignableByteData0,d_ErrorCode) DTOS(d_ErrorCode,s_ErrorCode) ,NE(cam02_S06InspectLocation_IN.Status.AssignableByteData1,0) MOVE(cam02_S06InspectLocation_IN.Status.AssignableByteData1,d_ErrorCode) DTOS(d_ErrorCode,s_ErrorCode) ] CONCAT(s_BaseAlarmText,s_ErrorCode,Alarm[4].Message) ,XIC(Alarm[4].Active) XIO(FaultReset) OTE(cam02_S06InspectLocation_OUT.Control.Error0Clear) OTE(cam02_S06InspectLocation_OUT.Control.Error1Clear) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
