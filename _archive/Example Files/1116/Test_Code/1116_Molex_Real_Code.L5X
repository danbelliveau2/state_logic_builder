<Text>
<![CDATA[[XIC(HMIControlRecipeTag.RecoverMirror) MOVE(2000,Timer[6].PRE) TON(Timer[6],?,?) XIC(Timer[6].DN) ONS(OneShot[16]) OTL(Read_MirrorData) ,XIO(recover_mirror) ONS(OneShot[26]) OTL(RefreshFilterList) ];]]>
