<Routine Name="R31_ClearData" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Clear all data in indexer dial]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[FOR i:=1 TO 90 DO]]>
</Line>
<Line Number="3">
<![CDATA[	]]>
</Line>
<Line Number="4">
<![CDATA[//Retain Head Num and Color]]>
</Line>
<Line Number="5">
<![CDATA[j := StationStatus[i].HeadNumber;]]>
</Line>
<Line Number="6">
<![CDATA[k := StationStatus[i].HeadColor;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[COP(StationStatusEmpty,StationStatus[i],1);]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[StationStatus[i].HeadNumber := j;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[If (k = 3) then]]>
</Line>
<Line Number="13">
<![CDATA[	StationStatus[i].HeadColor := k;]]>
</Line>
<Line Number="14">
<![CDATA[end_if;]]>
</Line>
<Line Number="15">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R32_PartsInHeaters" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[FOR i := 27 TO 56 DO]]>
</Line>
<Line Number="2">
<![CDATA[	IF ((StationStatus[i].PartPresent) AND (NOT StationStatus[i].Reject)) THEN]]>
</Line>
<Line Number="3">
<![CDATA[		q_PartsInHeaters := 1;]]>
</Line>
<Line Number="4">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="5">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[	q_PartsInHeaters := 0;]]>
</Line>
<Line Number="7">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R33_PartsInDial" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FOR i := 1 TO 90 DO]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[	IF (StationStatus[i].PartPresent) THEN]]>
</Line>
<Line Number="3">
<![CDATA[		IndexerEmpty :=0;]]>
</Line>
<Line Number="4">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="5">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[	IndexerEmpty :=1;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R34_PartsInHeatersReject" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FOR i := 27 TO 56 DO]]>
</Line>
<Line Number="1">
<![CDATA[	IF (StationStatus[i].PartPresent) THEN]]>
</Line>
<Line Number="2">
<![CDATA[		StationStatus[i].Reject :=1;]]>
</Line>
<Line Number="3">
<![CDATA[		StationStatus[i].HeadColor :=2;]]>
</Line>
<Line Number="4">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R35_PartsInHeater1" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FOR i := 27 TO 40 DO]]>
</Line>
<Line Number="1">
<![CDATA[	IF ((StationStatus[i].PartPresent) AND (NOT StationStatus[i].Reject)) THEN]]>
</Line>
<Line Number="2">
<![CDATA[		q_PartsInHeater1 := 1;]]>
</Line>
<Line Number="3">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="4">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[	q_PartsInHeater1 := 0;]]>
</Line>
<Line Number="6">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R36_PartsInHeater2" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FOR i := 43 TO 56 DO]]>
</Line>
<Line Number="1">
<![CDATA[	IF ((StationStatus[i].PartPresent) AND (NOT StationStatus[i].Reject)) THEN]]>
</Line>
<Line Number="2">
<![CDATA[		q_PartsInHeater2 := 1;]]>
</Line>
<Line Number="3">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="4">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[	q_PartsInHeater2 := 0;]]>
</Line>
<Line Number="6">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R40_HeadData" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station 1 Empty Nest]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOff)XIC(Status.State[4])ONS(ONS.10)[XIO(HMI_Data.HeadControl[S1HeadNumber].Lockout) MOVE(0,StationStatus[1].HeadColor) ,XIC(HMI_Data.HeadControl[S1HeadNumber].Lockout) MOVE(3,StationStatus[1].HeadColor) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Station 2 Load]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOff)[XIC(StationStatus[2].S01Attempt) XIO(StationStatus[2].S01Success) MOVE(0,StationStatus[2].HeadColor) ,XIO(StationStatus[2].S01Attempt) XIO(StationStatus[2].S01Success) XIO(HMI_Data.HeadControl[S2HeadNumber].Lockout) MOVE(1,StationStatus[2].HeadColor) ,XIO(StationStatus[2].S01Attempt) XIO(StationStatus[2].S01Success) XIC(HMI_Data.HeadControl[S2HeadNumber].Lockout) MOVE(3,StationStatus[2].HeadColor) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Station 6 Location Inspect]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOff)[XIC(StationStatus[6].S06Attempt) XIC(StationStatus[6].S06Success) MOVE(1,StationStatus[2].HeadColor) ,XIC(StationStatus[6].S06Attempt) XIC(StationStatus[6].Reject) MOVE(2,StationStatus[2].HeadColor) ,XIC(HMI_Data.HeadControl[S6HeadNumber].Lockout) MOVE(3,StationStatus[2].HeadColor) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Status.State[4])XIC(StationStatus[2].PartPresent)ONS(ONS.14)ADD(HMI_Data.HeadControl[S2HeadNumber].Attempts,1,HMI_Data.HeadControl[S2HeadNumber].Attempts);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(StationStatus[72].S72Attempt)ONS(ONS.15)ADD(HMI_Data.HeadControl[S72HeadNumber].Successes,1,HMI_Data.HeadControl[S72HeadNumber].Successes);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(StationStatus[76].S76Attempt)ONS(ONS.16)ADD(HMI_Data.HeadControl[S76HeadNumber].Successes,1,HMI_Data.HeadControl[S76HeadNumber].Successes);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(HMI_ClearAllNestData)TON(TimerButton[1],?,?)XIC(TimerButton[1].DN)JSR(R42_ClearHeadData,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R41_HeadColor" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FOR i := 1 TO 90 DO]]>
</Line>
<Line Number="1">
<![CDATA[	IF (NOT StationStatus[i].PartPresent) THEN]]>
</Line>
<Line Number="2">
<![CDATA[		StationStatus[i].HeadColor := 0;]]>
</Line>
<Line Number="3">
<![CDATA[	ELSIF ((StationStatus[i].PartPresent) AND (NOT StationStatus[i].Reject)) THEN]]>
</Line>
<Line Number="4">
<![CDATA[		StationStatus[i].HeadColor := 1;]]>
</Line>
<Line Number="5">
<![CDATA[	ELSIF ((StationStatus[i].PartPresent) AND (StationStatus[i].Reject)) THEN]]>
</Line>
<Line Number="6">
<![CDATA[		StationStatus[i].HeadColor := 2;]]>
</Line>
<Line Number="7">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="8">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[for i := 1 TO 90 DO]]>
</Line>
<Line Number="11">
<![CDATA[	j := StationStatus[i].HeadNumber;]]>
</Line>
<Line Number="12">
<![CDATA[	if(HMI_Data.HeadControl[j].Lockout) THEN]]>
</Line>
<Line Number="13">
<![CDATA[		StationStatus[i].HeadColor := 3;]]>
</Line>
<Line Number="14">
<![CDATA[	end_if;]]>
</Line>
<Line Number="15">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R42_ClearHeadData" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FOR i:=0 TO 89 DO]]>
</Line>
<Line Number="1">
<![CDATA[	HMI_Data.HeadControl[i].Successes :=0;]]>
</Line>
<Line Number="2">
<![CDATA[	HMI_Data.HeadControl[i].Attempts :=0;]]>
</Line>
<Line Number="3">
<![CDATA[end_for;]]>
</Line>
<Line Number="4">
<![CDATA[	]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
