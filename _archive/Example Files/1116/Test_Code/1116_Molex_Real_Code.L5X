<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[[GT(i_ToolChangeDownstream,HMI_Tool1DSLL) LT(i_ToolChangeDownstream,HMI_Tool1DSHL) OTE(DownstreamTool.1) ,GT(i_ToolChangeDownstream,HMI_Tool2DSLL) LT(i_ToolChangeDownstream,HMI_Tool2DSHL) OTE(DownstreamTool.2) ,GT(i_ToolChangeDownstream,HMI_Tool3DSLL) LT(i_ToolChangeDownstream,HMI_Tool3DSHL) OTE(DownstreamTool.3) ,GT(i_ToolChangeDownstream,HMI_Tool4DSLL) LT(i_ToolChangeDownstream,HMI_Tool4DSHL) OTE(DownstreamTool.4) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[GT(i_ToolChangeUpstream,HMI_Tool1USLL) LT(i_ToolChangeUpstream,HMI_Tool1USHL) OTE(UpstreamTool.1) ,GT(i_ToolChangeUpstream,HMI_Tool2USLL) LT(i_ToolChangeUpstream,HMI_Tool2USHL) OTE(UpstreamTool.2) ,GT(i_ToolChangeUpstream,HMI_Tool3USLL) LT(i_ToolChangeUpstream,HMI_Tool3USHL) OTE(UpstreamTool.3) ,GT(i_ToolChangeUpstream,HMI_Tool4USLL) LT(i_ToolChangeUpstream,HMI_Tool4USHL) OTE(UpstreamTool.4) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(HMI_LocalManualOverride) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[End Effector Check
1 = smallest, 4 = largest]]>
</Comment>
<Text>
<![CDATA[EQ(ActiveRecipe.RobotEndEffector,RobotActiveTool)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[SUB(ActiveRecipe.MaximumCycleTime,\IndexerDial.HMI_FullIndexTime,RobotWindowTimerTotal)SUB(RobotWindowTimerTotal,TimeToPlace,RobotWindowTimer)MOVE(RobotWindowTimer,Timer[0].PRE);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(LocalSS)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[60]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Signal to Robot to begin Place]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,[XIC(Status.State[60]) ,XIC(Status.State[124]) ] ]XIC(CycleRunning)XIO(HMI_Data.StationData.Station01.Lockout)XIO(StationStatus[1].S01Attempt)XIO(HMI_Data.HeadControl[\IndexerDial.S1HeadNumber].Lockout)XIO(\IndexerDial.Cleanout_Enabled)XIO(g_DryCycle_Enabled)XIO(SS)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Receive Confirmation Robot is Placing]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(i_RobotPlacingPart)XIO(SS)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Robot Finished Place Sequence]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(i_RobotPartPlaced)XIO(SS)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 20: Robot Not Ready to Place, Index Dial To Maintain Cycle Time]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIC(\IndexerDial.q_PartsInHeaters) ,XIC(\IndexerDial.Cleanout_Enabled) ]TON(Timer[0],?,?)XIC(Timer[0].DN)XIO(\S01_PickRobot.q_RobotGripperClosed)XIO(SS)MOVE(20,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 60: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) ,XIC(Status.State[20]) ]XIC(\S01_PickRobot.IsClearOfDial)XIO(SS)MOVE(60,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 100:Start of initialization sequence]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)XIO(HMI_Data.StationData.Station01.Lockout)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 103: If End Effector is on, Check if Open Spot for Dropoff]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])GT(RobotActiveTool,0)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 106: Dropoff at First Empty Location. Clear End Effector Value]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[103])[EQ(DownstreamTool,0) ,EQ(UpstreamTool,0) ]MOVE(106,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 109: Check for Correct Tool.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[106])[XIC(i_RobotPlaceUpstreamSuccess) ,XIC(i_RobotPlaceDownstreamSuccess) ]MOVE(109,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 112: Pick Correct Tool]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[109]) ,XIC(Status.State[100]) EQ(RobotActiveTool,0) ]XIC(CorrectToolPresent)MOVE(112,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 115: Update End Effector Value]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[112])[XIC(i_RobotPickUpstreamSuccess) ,XIC(i_RobotPickDownstreamSuccess) ]MOVE(115,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[115])MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(MB.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[LIMIT(4,Control.StateReg,59)XIO(SS)MOVE(3000,Control.FaultTime)OTE(Control.EnaFaultDetect);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Status.State[3])XIO(StationStatus[1].S01Success)XIO(StationStatus[1].Reject)ONS(ONS.7)OTU(StationStatus[1].S01Attempt);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(StationStatus[1].S01Success) ,XIC(StationStatus[1].Reject) ,[XIC(Status.State[3]) ,XIC(Status.State[60]) ,XIC(Status.State[124]) ] XIC(\IndexerDial.Cleanout_Enabled) ,XIC(HMI_Data.HeadControl[\IndexerDial.S1HeadNumber].Lockout) ,XIC(HMI_Data.StationData.Station01.Lockout) ]OTE(Status.OkToIndex);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(g_DryCycle_Enabled)[XIC(Status.State[4]) ,XIC(Status.State[7]) ,XIC(Debug_DINT.0) ][OTL(StationStatus[1].S01Attempt) ,OTE(q_RobotPlacePartReq) ,OTU(q_RobotWaitToPlace) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Odd scenario where 1 part is placed but PartPresent is not latched, causing issues further down.]]>
</Comment>
<Text>
<![CDATA[[XIC(g_DryCycle_Enabled) XIO(\IndexerDial.Cleanout_Enabled) XIO(HMI_Data.HeadControl[\IndexerDial.S1HeadNumber].Lockout) ,XIC(Status.State[10]) ,[XIC(Status.State[20]) ,XIC(Status.State[60]) ] XIC(i_RobotPartPlaced) ][OTL(StationStatus[1].S01Success) ,OTL(StationStatus[1].PartPresent) ,RES(cnt_RobotPlaceFailure) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(StationStatus[1].S01Success)OTU(StationStatus[1].Reject);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(Status.State[20]) XIO(i_RobotPartPlaced) ,XIC(HMI_Data.HeadControl[\IndexerDial.S1HeadNumber].Lockout) ,XIC(g_DryCycle_Enabled) ][OTL(q_RobotWaitToPlace) ,XIO(g_DryCycle_Enabled) OTL(StationStatus[1].Reject) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Robot Tool Change State Logic]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[106])[EQ(DownstreamTool,0) OTE(q_PlaceDownstream) ,EQ(UpstreamTool,0) XIO(q_PlaceDownstream) OTE(q_PlaceUpstream) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[109])[MOVE(0,RobotActiveTool) ,MOVE(0,PickLocation) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Status.State[112])[EQ(PickLocation,1) OTE(q_PickDownstream) ,EQ(PickLocation,2) OTE(q_PickUpstream) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Status.State[115])[MOVE(ActiveRecipe.RobotEndEffector,RobotActiveTool) ,MOVE(0,PickLocation) ,OTE(q_ToolChangeComplete) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[MOVE(RobotActiveTool,q_RobotActiveTool);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[EQ(ActiveRecipe.RobotEndEffector,1) [EQ(DownstreamTool,2) MOVE(1,PickLocation) ,EQ(UpstreamTool,2) MOVE(2,PickLocation) ] ,EQ(ActiveRecipe.RobotEndEffector,2) [EQ(DownstreamTool,4) MOVE(1,PickLocation) ,EQ(UpstreamTool,4) MOVE(2,PickLocation) ] ,EQ(ActiveRecipe.RobotEndEffector,3) [EQ(DownstreamTool,8) MOVE(1,PickLocation) ,EQ(UpstreamTool,8) MOVE(2,PickLocation) ] ,EQ(ActiveRecipe.RobotEndEffector,4) [EQ(DownstreamTool,16) MOVE(1,PickLocation) ,EQ(UpstreamTool,16) MOVE(2,PickLocation) ] ]OTE(CorrectToolPresent);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Robot To Finish Place Warning]]>
</Comment>
<Text>
<![CDATA[[XIC(\IndexerDial.q_PartsInHeaters) XIC(Status.State[4]) XIC(Timer[0].DN) ONS(ONS.6) CTU(cnt_RobotPlaceFailure,?,?) XIC(cnt_RobotPlaceFailure.DN) ,XIC(Alarm[1].Active) XIC(Status.State[10]) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Failed to Initialize]]>
</Comment>
<Text>
<![CDATA[XIC(MB.AlwaysOff)[[XIC(Status.State[103]) MOVE(50000,Timer[1].PRE) MOVE(s_InitAlarmStrings[0],Alarm[2].Message) ,XIC(Status.State[106]) MOVE(50000,Timer[1].PRE) MOVE(s_InitAlarmStrings[1],Alarm[2].Message) ,[XIC(Status.State[100]) EQ(RobotActiveTool,0) ,XIC(Status.State[109]) ] MOVE(50000,Timer[1].PRE) MOVE(s_InitAlarmStrings[2],Alarm[2].Message) ,XIC(Status.State[112]) MOVE(50000,Timer[1].PRE) MOVE(s_InitAlarmStrings[3],Alarm[2].Message) ,XIC(Status.State[121]) MOVE(50000,Timer[1].PRE) MOVE(s_InitAlarmStrings[4],Alarm[2].Message) ] TON(Timer[1],?,?) XIC(Timer[1].DN) ,XIC(Alarm[2].Active) XIO(FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\S01_PickRobot.q_RecipeChangeError)OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(CorrectToolPresent)NE(ActiveRecipe.RobotEndEffector,RobotActiveTool)[EQ(ActiveRecipe.RobotEndEffector,1) MOVE(s_EndEffector[1],s_EndEffector[0]) ,EQ(ActiveRecipe.RobotEndEffector,2) MOVE(s_EndEffector[2],s_EndEffector[0]) ,EQ(ActiveRecipe.RobotEndEffector,3) MOVE(s_EndEffector[3],s_EndEffector[0]) ,EQ(ActiveRecipe.RobotEndEffector,4) MOVE(s_EndEffector[4],s_EndEffector[0]) ]CONCAT(s_EndEffectorBaseMsg,s_EndEffector[0],Alarm[4].Message)OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
