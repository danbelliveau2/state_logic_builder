<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(HMI_ServoData.Status.MotionEnable)XIO(Axis.MoveStatus)XIO(Axis.JogStatus)[XIC(HMI_ServoData.Control.JogPositive) XIO(HMI_ServoData.Control.JogNegative) MOVE(0,JogDirection) ,XIC(HMI_ServoData.Control.JogNegative) XIO(HMI_ServoData.Control.JogPositive) MOVE(1,JogDirection) ][EQ(SpeedUnits,0) MAJ(Axis,Axis_MAJ,JogDirection,HMI_ServoData.Control.JogSpeed,Units per sec,HMI_ServoData.Control.Accel,Units per sec2,HMI_ServoData.Control.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None) ,EQ(SpeedUnits,1) MAJ(Axis,Axis_MAJ,JogDirection,HMI_ServoData.Control.JogSpeed,% of Maximum,HMI_ServoData.Control.Accel,% of Maximum,HMI_ServoData.Control.Decel,% of Maximum,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Axis_MAJ.IP)XIO(HMI_ServoData.Control.JogPositive)XIO(HMI_ServoData.Control.JogNegative)[EQ(SpeedUnits,0) MAS(Axis,AxisJog_MAS,Jog,Yes,HMI_ServoData.Control.Decel,Units per sec2,No,0,Units per sec3) ,EQ(SpeedUnits,1) MAS(Axis,AxisJog_MAS,Jog,Yes,HMI_ServoData.Control.Decel,% of Maximum,No,0,Units per sec3) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
