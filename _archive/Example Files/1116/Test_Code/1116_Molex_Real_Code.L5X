<Text>
<![CDATA[XIC(Status.State[1])XIC(X_Axis_Permissive)[XIC(HMI_Axis.Control.ManMoves[0]) MOVE(Axis_HomePos,Axis_MAMParam.Position) ,XIC(HMI_Axis.Control.ManMoves[1]) MOVE(Axis_WaitPos,Axis_MAMParam.Position) ,XIC(HMI_Axis.Control.ManMoves[2]) MOVE(Axis_ProcessPos,Axis_MAMParam.Position) ,XIC(HMI_Axis.Control.ManMoves[3]) MOVE(Axis_BaseNestPos,Axis_MAMParam.Position) ]MOVE(HMI_Axis.Control.ManualSpeed,Axis_MAMParam.Speed)OTE(PositionMoveLoaded_MAN);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
