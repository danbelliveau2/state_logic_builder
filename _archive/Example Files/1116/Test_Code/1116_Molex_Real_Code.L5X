<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StackLight,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R10_Global,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R15_EIPMonitor,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[For small machines with no safety controller, replace MB.AlwaysOff with digital inputs tied to safety circuit status.

For machines using a non AB safety controller, replace MB.AlwaysOff with digital inputs tied to safety circuit status, or Ethernet IP safety circuit status, if available.

For machines using an AB safety PLC, replace MB.AlwaysOff with safety output parameters from the SafetyProgram.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SafetyResetReady must turn on when the safety circuit has not been energized and all safety devices are in their safe states.]]>
</Comment>
<Text>
<![CDATA[XIC(\SafetyProgram.q_SafetyResetOk)OTE(SafetyCircuitReady);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[q_SafetyOK must turn on when the safety circuit has been energized.

]]>
</Comment>
<Text>
<![CDATA[XIC(\SafetyProgram.Safe_q_Status)OTE(q_SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[All State Machines In Automatic Mode]]>
</Comment>
<Text>
<![CDATA[XIC(\IndexerDial.q_AutoMode)XIC(\S01_PickRobot.q_AutoMode)XIC(\S01_Load.q_AutoMode)XIC(\S04_PartLocate.q_AutoMode)XIC(\S06_LocationInspect.q_AutoMode)XIC(\S07_LocationReject.q_AutoMode)XIC(\S56_WireFeed.q_AutoMode)XIC(\S17_BarrelInspect.q_AutoMode)XIC(\S21_BarrelReject.q_AutoMode)XIC(\S28_InductiveHeaters.q_AutoMode)XIC(\S55_TempInspect.q_AutoMode)XIC(\S56_WireFeed.q_AutoMode)XIC(\S61_FinalInspect.q_AutoMode)XIC(\S72_GoodPart.q_AutoMode)XIC(\S76_GoodPart.q_AutoMode)XIC(\S84_RejectPart.q_AutoMode)OTE(AllSMInAuto);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[All State Machines In Cycle Stop]]>
</Comment>
<Text>
<![CDATA[XIC(\IndexerDial.q_AutoStopped)XIC(\S01_PickRobot.q_AutoStopped)XIC(\S01_Load.q_AutoStopped)XIC(\S04_PartLocate.q_AutoStopped)XIC(\S06_LocationInspect.q_AutoStopped)XIC(\S07_LocationReject.q_AutoStopped)XIC(\S17_BarrelInspect.q_AutoStopped)XIC(\S21_BarrelReject.q_AutoStopped)XIC(\S28_InductiveHeaters.q_AutoStopped)XIC(\S55_TempInspect.q_AutoStopped)XIC(\S56_WireFeed.q_AutoStopped)XIC(\S61_FinalInspect.q_AutoStopped)XIC(\S72_GoodPart.q_AutoStopped)XIC(\S76_GoodPart.q_AutoStopped)XIC(\S84_RejectPart.q_AutoStopped)OTE(MachineStopped);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Automatic Mode Start OK]]>
</Comment>
<Text>
<![CDATA[XIO(q_MachineFaultActive)XIC(i_AirPressure)XIC(\IndexerDial.q_StartOK)[XIC(\S01_PickRobot.q_StartOk) XIC(\S01_PickRobot.q_AutoOk) ,XIC(HMI_Data.StationData.Station01.Lockout) ]XIC(\S01_Load.q_StartOK)XIC(\S04_PartLocate.q_StartOK)XIC(\S06_LocationInspect.q_StartOK)XIC(\S07_LocationReject.q_StartOK)XIC(\S17_BarrelInspect.q_StartOK)XIC(\S21_BarrelReject.q_StartOK)XIC(\IndexerDial.BentPartSensorOK_PRS)XIC(\S28_InductiveHeaters.q_StartOK)XIC(\S55_TempInspect.q_StartOK)XIC(\S56_WireFeed.q_StartOK)XIC(\S61_FinalInspect.q_StartOK)XIC(\S72_GoodPart.q_StartOK)XIC(\S76_GoodPart.q_StartOK)XIC(\S84_RejectPart.q_StartOK)[GE(ActiveRecipe.PartType,4) XIC(IOBlock_01_IN.ProcessDataIn.Port_X1A) ,LE(ActiveRecipe.PartType,3) XIO(IOBlock_01_IN.ProcessDataIn.Port_X1A) ]OTE(StartOK);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[DG Aborting Logic]]>
</Comment>
<Text>
<![CDATA[XIC(i_CycleStop)ONS(ONS.0)ADD(1,CycleStopCount,CycleStopCount);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NE(CycleStopCount,0)TON(TMR_CycleStopAbort,?,?)XIC(TMR_CycleStopAbort.DN)MOVE(0,CycleStopCount);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[GE(CycleStopCount,3)OTE(\S01_PickRobot.in_Mode.Aborting);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Supervisor State Machine

State 1: Safety Resetting]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])XIC(q_SafetyOK)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 3: Manual Mode]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) ,XIC(Status.State[6]) ,XIC(Status.State[12]) XIC(MachineStopped) ]XIO(HMI_ModeSelect)MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 4: Auto Initialize]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) ,XIC(Status.State[3]) ,XIC(Status.State[12]) XIC(MachineStopped) XIO(q_MachineFaultActive) ]XIC(HMI_ModeSelect)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 6: Auto Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(AllSMInAuto)MOVE(6,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 8: Auto Running]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])XIC(q_CycleStartLatch)MOVE(8,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Cycle Stopping]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])XIO(q_CycleStartLatch)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 12: Cycle Stopped]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])[XIC(MachineStopped) ,MOVE(10000,Control.TransitionTime) XIC(Status.TransitionTimerDone) ]MOVE(12,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(S:FS) ,XIO(q_SafetyOK) ]MOVE(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Cycle Start]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])[XIC(i_CycleStart) XIC(i_CycleStop) XIC(StartOK) ,XIC(CycleStartDelay.EN) ]XIO(\IndexerDial.Cleanout_Stop)TON(CycleStartDelay,?,?)XIC(CycleStartDelay.DN)[OTL(q_CycleStartLatch) ,OTL(q_MachineRunning) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(CycleStartDelay.TT)OTE(CycleStarting);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Cycle Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) ,XIC(Status.State[8]) [XIO(i_CycleStop) ,XIC(q_MachineFaultActive) ,XIC(\IndexerDial.Cleanout_Stop) ] ]OTU(q_CycleStartLatch);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(Status.State[0]) ,XIC(Status.State[12]) ]OTU(q_MachineRunning);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Machine In Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])OTE(q_ManualMode);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Machine In Cycle Stopped]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[12])OTE(q_CycleStopped);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Machine Fault Active]]>
</Comment>
<Text>
<![CDATA[XIO(\Alarms.p_NoMachineFaults)OTE(q_MachineFaultActive);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Machine Warning Active]]>
</Comment>
<Text>
<![CDATA[XIO(\Alarms.p_NoMachineWarnings)OTE(MachineWarningActive);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(i_FaultReset)OTE(q_FaultReset);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(q_CycleStartLatch)OTE(Local:6:O.Pt08.Data);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StackLight" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Standard Light Control

Cycle Start Light, Machine Reset Light, Stack Light

***Must Set Parameter Connections For q_MachineResetLight, q_CycleStartLight, q_AlarmHorn, q_RedStackLight, q_AmberStackLight, q_GreenStackLight***]]>
</Comment>
<Text>
<![CDATA[LightControl(LightControl,Control.StateReg,SafetyCircuitReady,StartOK,CycleStarting,q_MachineFaultActive,MachineWarningActive,q_MachineResetLight,q_CycleStartLight,q_AlarmHorn,q_RedStackLight,q_AmberStackLight,q_GreenStackLight);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R10_Global" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Machine Basic - Flashers, Always On, ect.]]>
</Comment>
<Text>
<![CDATA[AOI_MachineBasic(MachineBasic,q_MachineRunning,MB);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Get Date & Time]]>
</Comment>
<Text>
<![CDATA[CPU_TimeDate_wJulian(CPUDateTime,g_CPUDateTime);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Dry Cycle Enable Logic]]>
</Comment>
<Text>
<![CDATA[XIO(q_CycleStartLatch)[XIC(HMI_Button.0) OTL(g_DryCycle_Enabled) ,XIC(HMI_Button.1) OTU(g_DryCycle_Enabled) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(ManButtonOnPrevScan)MOVE(0,HMI_Button);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[NE(HMI_Button,0)OTE(ManButtonOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R15_EIPMonitor" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[EIP Status Counter - Checks One EIP Node Status Every 100ms]]>
</Comment>
<Text>
<![CDATA[XIC(MB.Flash100msPS)ADD(EIPStatusCount,1,EIPStatusCount);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[***NOTE - Set Source B To EIP Node Quantity]]>
</Comment>
<Text>
<![CDATA[GE(EIPStatusCount,13)MOVE(0,EIPStatusCount);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Loss Of Indexer Servo EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(MB.PowerUpCP) EQ(EIPStatusCount,0) AOI_EIPStatus(AOI_s01_Indexer_EIP,sd01_Indexer) XIO(AOI_s01_Indexer_EIP.ComOK) ,XIC(Alarm[0].Active) XIO(q_FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Loss Of S56 X Axis Servo EIP]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station56.Lockout)[XIC(MB.PowerUpCP) EQ(EIPStatusCount,1) AOI_EIPStatus(AOI_s03_S56XAxis_EIP,sd03_S56XAxis) XIO(AOI_s03_S56XAxis_EIP.ComOK) ,XIC(Alarm[1].Active) XIO(q_FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Loss Of S56 Z Axis Servo EIP]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station56.Lockout)[XIC(MB.PowerUpCP) EQ(EIPStatusCount,2) AOI_EIPStatus(AOI_s04_S56ZAxis_EIP,sd04_S56ZAxis) XIO(AOI_s04_S56ZAxis_EIP.ComOK) ,XIC(Alarm[2].Active) XIO(q_FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Loss Of S01 Flex Feed Robot EIP]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Data.StationData.Station01.Lockout)[XIC(MB.PowerUpCP) EQ(EIPStatusCount,3) AOI_EIPStatus(AOI_r01_FFRobot_EIP,r01_FlexFeeder) XIO(AOI_r01_FFRobot_EIP.ComOK) ,XIC(Alarm[3].Active) XIO(q_FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Loss Of IO Link Master EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(MB.PowerUpCP) EQ(EIPStatusCount,4) AOI_EIPStatus(AOI_IOL_Master_EIP,IOL_Master1) XIO(AOI_IOL_Master_EIP.ComOK) ,XIC(Alarm[4].Active) XIO(q_FaultReset) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Loss Of S01 Flex Feed Camera EIP]]>
</Comment>
