<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_Logic,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_Outputs,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Status Monitoring - Kinetix 5500 Drive Using CIP Safety]]>
</Comment>
<Text>
<![CDATA[XIC(sd01_Indexer:SI.RunMode)XIO(sd01_Indexer:SI.ConnectionFaulted)XIO(sd01_Indexer:SI.SafetyFault)OTE(IndexerOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Status Monitoring - Local Safety Modules]]>
</Comment>
<Text>
<![CDATA[[XIC(Local:1:I.RunMode) XIO(Local:1:I.ConnectionFaulted) OTE(SIN1OK) ,XIC(Local:2:I.RunMode) XIO(Local:2:I.ConnectionFaulted) OTE(SIN2OK) ,XIC(Local:3:I.RunMode) XIO(Local:3:I.ConnectionFaulted) OTE(SOUT1OK) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Map Safety Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(SIN1OK)[XIC(Local:1:I.Pt00.Status) XIC(Local:1:I.Pt00.Data) XIC(Local:1:I.Pt01.Status) XIC(Local:1:I.Pt01.Data) OTE(EmergencyStopInput) ,XIC(Local:1:I.Pt02.Status) XIC(Local:1:I.Pt02.Data) XIC(Local:1:I.Pt03.Status) XIC(Local:1:I.Pt03.Data) OTE(RobotEmergencyStopInput) ,[XIC(Local:1:I.Pt04.Status) XIC(Local:1:I.Pt04.Data) XIC(Local:1:I.Pt05.Status) XIC(Local:1:I.Pt05.Data) ,XIC(Eng_GuardDoorBypass) ] OTE(GuardDoorInput) ,[XIC(Local:1:I.Pt06.Status) XIC(Local:1:I.Pt06.Data) XIC(Local:1:I.Pt07.Status) XIC(Local:1:I.Pt07.Data) ,XIC(Eng_GuardDoorBypass) ] OTE(GuardDoorUnloadInput) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(SIN2OK)[XIC(Local:2:I.Pt00.Status) XIC(Local:2:I.Pt00.Data) OTE(EmergencyStopEDM) ,XIC(Local:2:I.Pt01.Status) XIC(Local:2:I.Pt01.Data) OTE(GuardDoorEDM) ,XIC(Local:2:I.Pt03.Status) XIC(Local:2:I.Pt03.Data) OTE(RobotFenceEDM) ,XIC(Local:2:I.Pt02.Status) XIC(Local:2:I.Pt02.Data) OTE(MachineResetPB) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(GuardDoorEDM)XIC(RobotFenceEDM)OTE(AllGuardDoorEDM);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Emergency Stop Reset - Falling Edge]]>
</Comment>
<Text>
<![CDATA[XIC(MachineResetPB)OSF(MachineResetSB,MachineResetOB);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Emergency Stop - Manual Reset Required ]]>
</Comment>
<Text>
<![CDATA[[XIC(MachineResetOB) XIC(EmergencyStopEDM) XIC(GuardDoorEDM) XIC(RobotFenceEDM) ,XIC(EmergencyStopOutput) ]XIC(RobotEmergencyStopInput)XIC(EmergencyStopInput)OTE(EmergencyStopOutput);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Guard Door Debounce]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorInput)TOF(GuardDoorOffDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Guard Door - Automatic Restart

***NOTE - Risk Assessment May Determine That Manual Reset Is Required]]>
</Comment>
<Text>
<![CDATA[XIC(EmergencyStopOutput)XIC(GuardDoorOffDelay.DN)OTE(GuardDoorOutput);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Safety Status To Supervisor]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorOutput)OTE(Safe_q_Status);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Safety Status To DG Robot Program]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorOutput)OTE(q_GuardDoorOk);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(EmergencyStopOutput)OTE(q_EstopOk);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Unload Guard Door Debounce]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorUnloadInput)TOF(GuardDoorUnloadOffDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Unload Guard Door - Automatic Restart

***NOTE - Risk Assessment May Determine That Manual Reset Is Required]]>
</Comment>
<Text>
<![CDATA[XIC(EmergencyStopOutput)XIC(GuardDoorOffDelay.DN)XIC(GuardDoorUnloadOffDelay.DN)OTE(GuardDoorUnloadOutput);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Unload Guard Door Safety Status To Supervisor]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorUnloadOutput)OTE(Safe_q_Status_Unload);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Safety Output - Kinetix 5500 Drive Using CIP Safety]]>
</Comment>
<Text>
<![CDATA[XIC(sd01_Indexer:SO.SafeTorqueOff)XIC(sd01_Indexer:SI.TorqueDisabled)XIC(sd01_Indexer:SI.ResetRequired)OTE(sd01_Indexer:SO.Reset);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IndexerOK)XIC(GuardDoorOutput)OTE(sd01_Indexer:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Emergency Stop Output]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:3:I.Pt00.Status)XIC(Local:3:I.Pt02.Status)XIC(Local:3:I.Pt04.Status)OTE(EmergencyStopOutputStatus);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[CROUT(EmergencyStopCROUT,NEGATIVE,200,EmergencyStopOutput,EmergencyStopEDM,EmergencyStopEDM,Local:2:I.Pt00.Status,EmergencyStopOutputStatus,MachineResetOB) ,XIC(EmergencyStopCROUT.O1) XIC(EmergencyStopCROUT.O2) [OTE(Local:3:O.Pt00.Data) ,OTE(Local:3:O.Pt02.Data) ,OTE(Local:3:O.Pt04.Data) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Guard Door Output]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:3:I.Pt01.Status)XIC(Local:3:I.Pt03.Status)XIC(Local:3:I.Pt05.Status)XIC(Local:3:I.Pt06.Status)XIC(Local:3:I.Pt07.Status)OTE(GuardDoorOutputStatus);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[CROUT(GuardDoorCROUT,NEGATIVE,200,GuardDoorOutput,AllGuardDoorEDM,AllGuardDoorEDM,Local:2:I.Pt01.Status,GuardDoorOutputStatus,MachineResetOB) ,XIC(GuardDoorCROUT.O1) XIC(GuardDoorCROUT.O2) [OTE(Local:3:O.Pt01.Data) ,OTE(Local:3:O.Pt03.Data) ,OTE(Local:3:O.Pt05.Data) ,OTE(Local:3:O.Pt06.Data) ,OTE(Local:3:O.Pt07.Data) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(EmergencyStopInput)XIC(RobotEmergencyStopInput)XIC(GuardDoorInput)XIC(EmergencyStopEDM)XIC(GuardDoorEDM)XIC(RobotFenceEDM)OTE(q_SafetyResetOk);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
