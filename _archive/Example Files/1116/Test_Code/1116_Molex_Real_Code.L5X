<Tag Name="AOI_FlexFeedConvReady" TagType="Base" DataType="AOI_Debounce" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Data Format="L5K">
<![CDATA[[0,1000,1000,[2047219,1000,0],[2266360,1000,0]]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="AOI_Debounce">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="0"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="Input" DataType="BOOL" Value="0"/>
<DataValueMember Name="OnDelay" DataType="DINT" Radix="Decimal" Value="1000"/>
<DataValueMember Name="OffDelay" DataType="DINT" Radix="Decimal" Value="1000"/>
<DataValueMember Name="On" DataType="BOOL" Value="0"/>
<DataValueMember Name="Off" DataType="BOOL" Value="0"/>
</Structure>
