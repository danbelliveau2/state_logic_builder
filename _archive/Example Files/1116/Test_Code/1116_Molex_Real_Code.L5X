<Routine Name="ImportActiveRecipe" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="ImportFamilySettings" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Copy family parameters into active recipe for easier global changes among part families.]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[i:=HMIStatusRecipeTag.Running.PartType;]]>
</Line>
<Line Number="3">
<![CDATA[HMIStatusRecipeTag.Running.DwellTimeBeforeBraze:=Recipe_FamilySettings[i].DwellTimeBeforeBraze;]]>
</Line>
<Line Number="4">
<![CDATA[HMIStatusRecipeTag.Running.PartsPerBin:=Recipe_FamilySettings[i].PartsPerBin;]]>
</Line>
<Line Number="5">
<![CDATA[HMIStatusRecipeTag.Running.RobotEndEffector:=Recipe_FamilySettings[i].RobotEndEffector;]]>
</Line>
<Line Number="6">
<![CDATA[HMIStatusRecipeTag.Running.RobotPickOffsetZ:=Recipe_FamilySettings[i].RobotPickOffsetZ;]]>
</Line>
<Line Number="7">
<![CDATA[HMIStatusRecipeTag.Running.RobotPlaceOffsetX:=Recipe_FamilySettings[i].RobotPlaceOffsetX;]]>
</Line>
<Line Number="8">
<![CDATA[HMIStatusRecipeTag.Running.RobotPlaceOffsetY:=Recipe_FamilySettings[i].RobotPlaceOffsetY;]]>
</Line>
<Line Number="9">
<![CDATA[HMIStatusRecipeTag.Running.RobotPlaceOffsetZ:=Recipe_FamilySettings[i].RobotPlaceOffsetZ;]]>
</Line>
<Line Number="10">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedDispenseSpeed:=Recipe_FamilySettings[i].WireFeedDispenseSpeed;]]>
</Line>
<Line Number="11">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedLen:=Recipe_FamilySettings[i].WireFeedLen;]]>
</Line>
<Line Number="12">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedMoveType:=Recipe_FamilySettings[i].WireFeedMoveType;]]>
</Line>
<Line Number="13">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedOffsetSupport:=Recipe_FamilySettings[i].WireFeedOffsetSupport;]]>
</Line>
<Line Number="14">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedOffsetXCenter:=Recipe_FamilySettings[i].WireFeedOffsetXCenter;]]>
</Line>
<Line Number="15">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedOffsetXFar:=Recipe_FamilySettings[i].WireFeedOffsetXFar;]]>
</Line>
<Line Number="16">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedOffsetXNear:=Recipe_FamilySettings[i].WireFeedOffsetXNear;]]>
</Line>
<Line Number="17">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedOffsetZ:=Recipe_FamilySettings[i].WireFeedOffsetZ;]]>
</Line>
<Line Number="18">
<![CDATA[HMIStatusRecipeTag.Running.WireFeedXAxisSpeed:=Recipe_FamilySettings[i].WireFeedXAxisSpeed;]]>
</Line>
<Line Number="19">
<![CDATA[ActiveRobotRecipe.ConvSpeed:=Recipe_FamilySettings[i].RobotConveyorSpeed;]]>
</Line>
</STContent>
</Routine>
<Routine Name="PopulateDisplayList" Type="ST">
<Description>
<![CDATA[Filtered List Display on HMI]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Populate the Displayed Part Number List]]>
</Line>
<Line Number="1">
<![CDATA[FilteredIter := 0;]]>
</Line>
<Line Number="2">
<![CDATA[SavedIter := 0;]]>
</Line>
<Line Number="3">
<![CDATA[ResultCount := 0;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[FOR FilteredIter := FilterListStartPos TO FilterListQty - 1 DO]]>
</Line>
<Line Number="6">
<![CDATA[	IF ((FilteredIter < 0) OR (FilteredIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="7">
<![CDATA[		Fault.0 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="8">
<![CDATA[		EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="9">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[	IF (ResultCount < DisplayListSize) THEN]]>
</Line>
<Line Number="12">
<![CDATA[		//The HMI display list is not full so continue to populate it.]]>
</Line>
<Line Number="13">
<![CDATA[		SavedIter := HMIStatusRecipeTag.FilteredList[FilteredIter];]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="16">
<![CDATA[			IF (SavedIter = -1) THEN //No more records in the Filtered list]]>
</Line>
<Line Number="17">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="18">
<![CDATA[			ELSE]]>
</Line>
<Line Number="19">
<![CDATA[				Fault.1 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="20">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="21">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[		IF ((ResultCount < 0) OR (ResultCount >= DisplayListSize)) THEN]]>
</Line>
<Line Number="25">
<![CDATA[			Fault.2 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="26">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="27">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[		//Set the DisplayListID and DisplayListName.]]>
</Line>
<Line Number="30">
<![CDATA[		HMIStatusRecipeTag.PartID[ResultCount] := SavedIter;]]>
</Line>
<Line Number="31">
<![CDATA[		COP(HMIStatusRecipeTag.Saved[SavedIter].Name, HMIStatusRecipeTag.PartNumber[ResultCount], 1);]]>
</Line>
<Line Number="32">
<![CDATA[	ELSE]]>
</Line>
<Line Number="33">
<![CDATA[		//The HMI display list is full so this routine is done.]]>
</Line>
<Line Number="34">
<![CDATA[		EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="35">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="36">
<![CDATA[	ResultCount := ResultCount + 1;]]>
</Line>
<Line Number="37">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="38">
<![CDATA[DisplayResultsQty := ResultCount;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[//Clear the rest of the display list if it wasn't filled]]>
</Line>
<Line Number="41">
<![CDATA[FOR ResultCount := DisplayResultsQty TO DisplayListSize - 1 DO]]>
</Line>
<Line Number="42">
<![CDATA[	IF ((ResultCount < 0) OR (ResultCount >= DisplayListSize)) THEN]]>
</Line>
<Line Number="43">
<![CDATA[		Fault.3 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="44">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="45">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[	//Set the DisplayListID and DisplayListName to empty.]]>
</Line>
<Line Number="48">
<![CDATA[	HMIStatusRecipeTag.PartID[ResultCount] := -1;]]>
</Line>
<Line Number="49">
<![CDATA[	COP(EmptyString30,HMIStatusRecipeTag.PartNumber[ResultCount],1);]]>
</Line>
<Line Number="50">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="PopulateFilterList" Type="ST">
<Description>
<![CDATA[Create Filtered List]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Populate the Filtered Part Number List]]>
</Line>
<Line Number="1">
<![CDATA[FilteredIter := 0;]]>
</Line>
<Line Number="2">
<![CDATA[FilterListQty :=  0;]]>
</Line>
<Line Number="3">
<![CDATA[LOWER(HMIControlRecipeTag.FilterPartNumber, filter); //So the comparison is case in-sensitive]]>
</Line>
<Line Number="4">
<![CDATA[Size(HMIStatusRecipeTag.Saved,0,SavedRecipeArrayLength);]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[IF (HMIControlRecipeTag.FilterPartNumber = EmptyString30) THEN]]>
</Line>
<Line Number="7">
<![CDATA[	//There is no filter.]]>
</Line>
<Line Number="8">
<![CDATA[	//Filter string is empty so populate with all non-empty recipes]]>
</Line>
<Line Number="9">
<![CDATA[	]]>
</Line>
<Line Number="10">
<![CDATA[	FOR SavedIter := 0 TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="11">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="12">
<![CDATA[			Fault.4 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="13">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="14">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[		IF ((HMIStatusRecipeTag.Saved[SavedIter].Name.LEN < 0) OR (HMIStatusRecipeTag.Saved[SavedIter].Name.LEN >= 30)) THEN]]>
</Line>
<Line Number="17">
<![CDATA[			Fault.9 := 1; //failed string length sanity check]]>
</Line>
<Line Number="18">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="19">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[		//Only if Saved string is NOT empty]]>
</Line>
<Line Number="22">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="23">
<![CDATA[			IF ((FilteredIter < 0) OR (FilteredIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="24">
<![CDATA[				Fault.5 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="25">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="26">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[			HMIStatusRecipeTag.FilteredList[FilteredIter] := SavedIter;]]>
</Line>
<Line Number="29">
<![CDATA[			FilteredIter := FilteredIter + 1;]]>
</Line>
<Line Number="30">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="31">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="32">
<![CDATA[ELSE]]>
</Line>
<Line Number="33">
<![CDATA[	//There is a filter.]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[	FOR SavedIter := 0 TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="36">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="37">
<![CDATA[			Fault.6 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="38">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="39">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[		//Only if Saved string is NOT empty]]>
</Line>
<Line Number="42">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="43">
<![CDATA[			LOWER(HMIStatusRecipeTag.Saved[SavedIter].Name, saved); //So the comparison is case in-sensitive]]>
</Line>
<Line Number="44">
<![CDATA[				//Exact match! Move the start position here and place the "cursor" on this part.]]>
</Line>
<Line Number="45">
<![CDATA[				IF (saved = filter) THEN]]>
</Line>
<Line Number="46">
<![CDATA[					FilterListStartPos := FilteredIter;]]>
</Line>
<Line Number="47">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="48">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[				IF ((FilteredIter < 0) OR (FilteredIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="51">
<![CDATA[					Fault.7 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="52">
<![CDATA[					EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="53">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[				FIND(saved,filter,1,FindResult);]]>
</Line>
<Line Number="56">
<![CDATA[				IF (FindResult > 0) THEN]]>
</Line>
<Line Number="57">
<![CDATA[					//Exact or Partial Match! Add the matching saved array index to the FilterList]]>
</Line>
<Line Number="58">
<![CDATA[					HMIStatusRecipeTag.FilteredList[FilteredIter] := SavedIter;]]>
</Line>
<Line Number="59">
<![CDATA[					FilteredIter := FilteredIter + 1;]]>
</Line>
<Line Number="60">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="61">
<![CDATA[]]>
</Line>
<Line Number="62">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="63">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="64">
<![CDATA[END_IF;]]>
</Line>
<Line Number="65">
<![CDATA[FilterListQty := FilteredIter;]]>
</Line>
<Line Number="66">
<![CDATA[]]>
</Line>
<Line Number="67">
<![CDATA[//Clear the rest of the filtered list if it wasn't filled]]>
</Line>
<Line Number="68">
<![CDATA[FOR FilteredIter := FilterListQty TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="69">
<![CDATA[	IF ((FilteredIter < 0) OR (FilteredIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="70">
<![CDATA[		Fault.8 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="71">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="72">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="73">
<![CDATA[	HMIStatusRecipeTag.FilteredList[FilteredIter] := -1;]]>
</Line>
<Line Number="74">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="75">
<![CDATA[]]>
</Line>
<Line Number="76">
<![CDATA[RefreshDisplayList := 1;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Recipe_SaveLoad" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Save Edited/Deleted Recipe]]>
</Comment>
<Text>
<![CDATA[[XIC(Save_Recipe) ,XIC(Delete_Recipe) ]EQ(CF_RW_functions.command,0)ONS(Recipe_SaveLoad_ONS[0])[OTL(store_recipe) ,GE(SavedPointer,0) MOVE(SavedPointer,Recipe_SaveIndex) ,MOVE(0,Recipe_SD_Error) ,OTU(Save_Recipe) ,OTU(Delete_Recipe) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Backup All Recipes to Names Starting at 500]]>
</Comment>
<Text>
<![CDATA[XIC(backup_recipe)EQ(CF_RW_functions.command,0)XIO(store_recipe)ONS(Recipe_SaveLoad_ONS[2])[[ADD(1,Recipe_SaveIndex,Recipe_SaveIndex) ,ADD(1,Recipe_SaveIndex_Backup,Recipe_SaveIndex_Backup) ] ,OTL(store_recipe) ,ADD(Recipe_SaveIndex,1,Recipe_SaveIndexLength) GE(Recipe_SaveIndexLength,SavedRecipeArrayLength) OTU(backup_recipe) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Write_BackupData) ,XIC(Create_Files1) ]ONS(Recipe_SaveLoad_ONS[1])[OTL(backup_recipe) ,OTL(store_recipe) ,MOVE(0,Recipe_SaveIndex) ,MOVE(500,Recipe_SaveIndex_Backup) ,MOVE(0,Recipe_SD_Error) ,OTU(Write_BackupData) ,XIC(Create_Files1) [OTU(Create_Files1) ,OTL(Create_Files2) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Save All Recipes to Names Starting at 0]]>
</Comment>
<Text>
<![CDATA[XIC(mirror_recipe)EQ(CF_RW_functions.command,0)XIO(store_recipe)ONS(Recipe_SaveLoad_ONS[4])[ADD(1,Recipe_SaveIndex,Recipe_SaveIndex) ,OTL(store_recipe) ,ADD(Recipe_SaveIndex,1,Recipe_SaveIndexLength) GE(Recipe_SaveIndexLength,SavedRecipeArrayLength) [OTU(mirror_recipe) ,OTU(Create_Files3) ,OTU(Write_SortData) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[XIC(Write_MirrorData) ,XIC(HMIControlRecipeTag.Mirror) TON(Timer[12],?,?) XIC(Timer[12].DN) ] ,XIC(Create_Files2) XIO(backup_recipe) ]XIO(mirror_recipe)ONS(Recipe_SaveLoad_ONS[3])[OTL(mirror_recipe) ,OTL(store_recipe) ,MOVE(0,Recipe_SaveIndex) ,MOVE(0,Recipe_SD_Error) ,OTU(Write_MirrorData) ,XIC(Create_Files2) OTL(Create_Files3) ,OTU(Create_Files2) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Set values in the 'Saved' tag.
Then trigger this rung to store this to a file called the value of Recipe_SaveIndex on the CompactFlash card.]]>
</Comment>
<Text>
<![CDATA[XIC(store_recipe)EQ(CF_RW_functions.command,0)ONS(Recipe_SaveLoad_ONS[5])[COP(HMIStatusRecipeTag.Saved[Recipe_SaveIndex],CF_RW_functions.data[0],RecipeStructureUDTSizeBytes) [XIO(backup_recipe) DTOS(Recipe_SaveIndex,Recipe_SaveIndex_Str) COP(Recipe_SaveIndex_Str,CF_RW_functions.name.LEN,20) ,XIC(backup_recipe) DTOS(Recipe_SaveIndex_Backup,Recipe_SaveIndex_Str) COP(Recipe_SaveIndex_Str,CF_RW_functions.name.LEN,20) ] ,CLR(CF_RW_functions.offset) MOVE(RecipeStructureUDTSizeBytes,CF_RW_functions.REQ_length) ,MOVE(3,CF_RW_functions.command) [OTU(store_recipe) ,OTL(storing_recipe) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQ(CF_RW_functions.command,0)XIC(storing_recipe)XIO(Recipe_SaveLoad_ONS[5])[NE(CF_RW_functions.result,RecipeStructureUDTSizeBytes) [XIC(Recipe_SD_Error.0) OTL(Recipe_SD_Error.1) ,MOVE(Recipe_SaveIndex,StatusMessageNum) OTL(Recipe_SD_Error.0) ] ,OTU(storing_recipe) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Recover the mirror]]>
</Comment>
<Text>
<![CDATA[XIC(recover_mirror)EQ(CF_RW_functions.command,0)XIO(load_recipe)ONS(Recipe_SaveLoad_ONS[8])[ADD(1,Recipe_LoadIndex,Recipe_LoadIndex) ,OTL(load_recipe) ,ADD(Recipe_LoadIndex,1,Recipe_LoadIndexLength) GE(Recipe_LoadIndexLength,SavedRecipeArrayLength) OTU(recover_mirror) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Read_MirrorData)ONS(Recipe_SaveLoad_ONS[9])[OTL(recover_mirror) ,OTL(load_recipe) ,MOVE(0,Recipe_LoadIndex) ,MOVE(0,Recipe_SD_Error) ,OTU(Read_MirrorData) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Recover the backup]]>
</Comment>
<Text>
<![CDATA[XIC(recover_backup)EQ(CF_RW_functions.command,0)XIO(load_recipe)ONS(Recipe_SaveLoad_ONS[10])[[ADD(1,Recipe_LoadIndex,Recipe_LoadIndex) ,ADD(1,Recipe_LoadIndex_Backup,Recipe_LoadIndex_Backup) ] ,OTL(load_recipe) ,ADD(Recipe_LoadIndex,1,Recipe_LoadIndexLength) GE(Recipe_LoadIndexLength,SavedRecipeArrayLength) OTU(recover_backup) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Read_BackupData)ONS(Recipe_SaveLoad_ONS[11])[OTL(recover_backup) ,OTL(load_recipe) ,MOVE(0,Recipe_LoadIndex) ,MOVE(500,Recipe_LoadIndex_Backup) ,MOVE(0,Recipe_SD_Error) ,OTU(Read_BackupData) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Trigger this rung to load the data from the 'recipe1' file on the card to the 'active_recipe' tag.
Use the tag monitor to see the values.]]>
</Comment>
<Text>
<![CDATA[XIC(load_recipe)EQ(CF_RW_functions.command,0)[XIO(loading_recipe) ONS(Recipe_SaveLoad_ONS[12]) [[XIO(recover_backup) DTOS(Recipe_LoadIndex,Recipe_LoadIndex_Str) COP(Recipe_LoadIndex_Str,CF_RW_functions.name.LEN,20) ,XIC(recover_backup) DTOS(Recipe_LoadIndex_Backup,Recipe_LoadIndex_Str) COP(Recipe_LoadIndex_Str,CF_RW_functions.name.LEN,20) ] ,CLR(CF_RW_functions.offset) MOVE(RecipeStructureUDTSizeBytes,CF_RW_functions.REQ_length) ,MOVE(2,CF_RW_functions.command) OTL(loading_recipe) ] ,XIC(loading_recipe) XIO(Recipe_SaveLoad_ONS[12]) [OTU(loading_recipe) OTU(load_recipe) ,EQ(CF_RW_functions.result,0) COP(CF_RW_functions.data[0],HMIStatusRecipeTag.Saved[Recipe_LoadIndex],1) ,NE(CF_RW_functions.result,0) [XIC(Recipe_SD_Error.2) OTL(Recipe_SD_Error.3) ,MOVE(Recipe_LoadIndex,StatusMessageNum) OTL(Recipe_SD_Error.2) ] ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Set controller tags for HMI animations]]>
</Comment>
<Text>
<![CDATA[XIC(mirror_recipe)XIO(Write_SortData)OTE(RecipeBusy_mirror_recipe);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Write_SortData)OTE(RecipeBusy_sort_mirror);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(recover_mirror)OTE(RecipeBusy_recover_mirror);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(backup_recipe)OTE(RecipeBusy_backup_recipe);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(recover_backup)OTE(RecipeBusy_recover_backup);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(Create_Files1) ,XIC(Create_Files2) ,XIC(Create_Files3) ]OTE(RecipeBusy_create_files);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ShiftRecipes" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[COP(HMIStatusRecipeTag.Saved[s],HMIStatusRecipeTag.Saved[s+16],1)COP(EmptyRecipe,HMIStatusRecipeTag.Saved[s],1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Sort" Type="ST">
<Description>
<![CDATA[Sort the Saved Recipes List]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Selection Sort the Recipe Array]]>
</Line>
<Line Number="1">
<![CDATA[FOR SortPtr_Main := 0 TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="2">
<![CDATA[	SortPtr_Smallest := -1;]]>
</Line>
<Line Number="3">
<![CDATA[	FOR SortPtr_Remain := SortPtr_Main TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="4">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SortPtr_Remain].Name = EmptyString30) THEN]]>
</Line>
<Line Number="5">
<![CDATA[			IF (SortPtr_Smallest = -1) THEN]]>
</Line>
<Line Number="6">
<![CDATA[				SortPtr_Smallest := SortPtr_Remain;]]>
</Line>
<Line Number="7">
<![CDATA[			ELSE]]>
</Line>
<Line Number="8">
<![CDATA[				IF (HMIStatusRecipeTag.Saved[SortPtr_Remain].Name < HMIStatusRecipeTag.Saved[SortPtr_Smallest].Name) THEN]]>
</Line>
<Line Number="9">
<![CDATA[					SortPtr_Smallest := SortPtr_Remain;]]>
</Line>
<Line Number="10">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="11">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="12">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="13">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="14">
<![CDATA[	IF (SortPtr_Smallest = -1) THEN]]>
</Line>
<Line Number="15">
<![CDATA[		//Didn't find a non-empty value which means the rest of the array is empty, so we're done]]>
</Line>
<Line Number="16">
<![CDATA[		EXIT; //Quits the FOR loop only]]>
</Line>
<Line Number="17">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[	//Swap the Main with the smallest value found.]]>
</Line>
<Line Number="20">
<![CDATA[	COP(HMIStatusRecipeTag.Saved[SortPtr_Main], SortSwapRecipe, 1);]]>
</Line>
<Line Number="21">
<![CDATA[	COP(HMIStatusRecipeTag.Saved[SortPtr_Smallest], HMIStatusRecipeTag.Saved[SortPtr_Main], 1);]]>
</Line>
<Line Number="22">
<![CDATA[	COP(SortSwapRecipe, HMIStatusRecipeTag.Saved[SortPtr_Smallest], 1);]]>
</Line>
<Line Number="23">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
