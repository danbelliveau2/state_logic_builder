</Tag>
<Tag Name="q_RetractTopRetainer" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Output: Retract Top_Retainer solenoid]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="TopRetainerExtendDelay" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Sensorless Top_Retainer extend confirmation delay (300 ms)]]>
</Description>
<Data Format="L5K">
<![CDATA[[0,300,0]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="300"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
<Tag Name="TopRetainerExtended" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Conditioned: Top_Retainer confirmed extended]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="TopRetainerRetracted" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Conditioned: Top_Retainer confirmed retracted]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="HorizontalShuttleExtendDelay" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Sensorless Horizontal_Shuttle extend confirmation delay (500 ms)]]>
</Description>
<Data Format="L5K">
<![CDATA[[0,500,0]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="500"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
<Tag Name="MagnetCheckDelay" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Settle delay after Top_Retainer clears before reading Magnet_Present (250 ms)]]>
</Description>
<Data Format="L5K">
<![CDATA[[0,250,0]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="250"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
<Tag Name="MagnetRetryCount" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Re-present retry counter, 3 misses declares the stack exhausted]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="MagnetPresent" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[Conditioned: Magnet_Present sensor debounced ON]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="p_MagnetReady" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[SM Output Signal to Magnet_Pick: one magnet is presented and confirmed]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="p_RequestNextStack" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[SM Output Signal to Dial_Index: request an index for a fresh magnet stack]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="p_StackExhausted" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Description>
<![CDATA[SM Output Signal to Magnet_Pick: no magnet will be presented until a new stack indexes in]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Nest & Station Numbers]]>
</Comment>
<Text>
<![CDATA[[MOVE(1,StaNum) MOVE(20,StaNumPre) ,MOVE(\Tracking.p_Data.Station[StaNum].NestNum,NestNumCurrent) MOVE(\Tracking.p_Data.Station[StaNumPre].NestNum,NestNumIncoming) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[XIO(i_VerticalShuttleRetracted)XIC(q_ExtendVerticalShuttle)XIO(q_RetractVerticalShuttle)TON(VerticalShuttleExtendDelay,?,?)XIC(VerticalShuttleExtendDelay.DN)OTE(VerticalShuttleExtended);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(i_VerticalShuttleRetracted)XIC(q_RetractVerticalShuttle)XIO(q_ExtendVerticalShuttle)OTE(VerticalShuttleRetracted);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Horizontal_Shuttle extend is sensorless - confirmed by HorizontalShuttleExtendDelay (500 ms)]]>
</Comment>
<Text>
<![CDATA[XIO(i_HorizontalShuttleRetracted)XIC(q_ExtendHorizontalShuttle)XIO(q_RetractHorizontalShuttle)TON(HorizontalShuttleExtendDelay,?,?)XIC(HorizontalShuttleExtendDelay.DN)OTE(HorizontalShuttleExtended);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(i_HorizontalShuttleRetracted)XIC(q_RetractHorizontalShuttle)XIO(q_ExtendHorizontalShuttle)OTE(HorizontalShuttleRetracted);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[AOI_Debounce(MagnetSensorDebounce,i_MagnetSensor,100,100);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Hold_Down retract confirmed by i_HoldDownRetracted sensor]]>
</Comment>
<Text>
<![CDATA[XIC(i_HoldDownRetracted)XIC(q_RetractHoldDown)XIO(q_ExtendHoldDown)OTE(HoldDownRetracted);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(q_ExtendHoldDown)XIO(q_RetractHoldDown)TON(HoldDownExtendDelay,?,?)XIC(HoldDownExtendDelay.DN)OTE(HoldDownExtended);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Top_Retainer extend is sensorless - confirmed by TopRetainerExtendDelay (300 ms)]]>
</Comment>
<Text>
<![CDATA[XIC(q_ExtendTopRetainer)XIO(q_RetractTopRetainer)TON(TopRetainerExtendDelay,?,?)XIC(TopRetainerExtendDelay.DN)OTE(TopRetainerExtended);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Top_Retainer retract confirmed by i_TopRetainerRetracted sensor]]>
</Comment>
<Text>
<![CDATA[XIC(i_TopRetainerRetracted)XIC(q_RetractTopRetainer)XIO(q_ExtendTopRetainer)OTE(TopRetainerRetracted);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Magnet_Present settle delay - started once the shuttle is over and the retainer is clear, so a magnet still settling is not read as absent]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(HorizontalShuttleExtendDelay.DN)XIC(i_TopRetainerRetracted)TON(MagnetCheckDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Magnet_Present debounced result]]>
</Comment>
<Text>
<![CDATA[XIC(MagnetSensorDebounce.On)OTE(MagnetPresent);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Initialized - all four cylinders at their retract sensors]]>
</Comment>
<Text>
<![CDATA[XIO(PartStarted)XIC(i_VerticalShuttleRetracted)XIC(i_HorizontalShuttleRetracted)XIC(i_HoldDownRetracted)XIC(i_TopRetainerRetracted)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)XIO(ManualMode)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Dry run logic (can add supervisor dry run condition if needed as parallel branch)]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.DryRun)OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Cycle Station]]>
</Comment>
<Text>
<![CDATA[XIO(\Tracking.p_Data.Nest[NestNumCurrent].OpStatus.Lockout)XIO(\HMI.q_CleanoutModeEnabled)[XIO(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStationA) ,OTE(CycleStationB) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[99]) XIO(CycleRunning) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[4]) ,XIC(Status.State[31]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Wait for index complete - start of the feed cycle, station idles here with all cylinders home]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ] ,XIC(Status.State[31]) XIC(q_StationComplete) ]XIC(CycleRunning)XIC(SS_OK)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Clamp stack - Dial_Index reports a fresh stack in position, clear the stack requests and the retry counter

*Replace the [AlwaysOff,DryRun] placeholder with XIC(\Dial_Index.p_IndexComplete) once station 0 publishes the tag.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ]XIC(i_VerticalShuttleRetracted)XIC(i_HorizontalShuttleRetracted)XIC(i_HoldDownRetracted)XIC(i_TopRetainerRetracted)XIC(SS_OK)MOVE(7,Control.StateReg)[OTU(p_RequestNextStack) ,OTU(p_StackExhausted) ,CLR(MagnetRetryCount) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Raise vertical shuttle - hold down and top retainer confirmed clamped]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(HoldDownExtendDelay.DN)XIC(TopRetainerExtendDelay.DN)XIC(SS_OK)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: Present magnet - entered from 10 (shuttle raised) or from 16/22 (shuttle reloaded, retainer re-extended)

Station commits to presenting a magnet - latch part tracking Attempt]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) XIC(VerticalShuttleExtendDelay.DN) XIO(i_VerticalShuttleRetracted) XIC(TopRetainerExtendDelay.DN) ,[XIC(Status.State[16]) ,XIC(Status.State[22]) ] XIC(i_HorizontalShuttleRetracted) XIC(TopRetainerExtendDelay.DN) ]XIC(SS_OK)MOVE(13,Control.StateReg)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 19: Magnet ready - shuttle over, retainer clear, Magnet_Present made; clear the retry counter]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(HorizontalShuttleExtendDelay.DN)XIC(i_TopRetainerRetracted)XIC(MagnetPresent)XIC(SS_OK)MOVE(19,Control.StateReg)CLR(MagnetRetryCount);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 16: Reload shuttle retry - no magnet after the settle delay and fewer than 3 attempts made; increment and re-present]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(HorizontalShuttleExtendDelay.DN)XIC(i_TopRetainerRetracted)XIC(MagnetCheckDelay.DN)XIO(MagnetPresent)LES(MagnetRetryCount,3)XIC(SS_OK)ADD(MagnetRetryCount,1,MagnetRetryCount)MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 25: Wait new magnet request - state 19 is a single scan branch, fall through to the holding wait unless the pick already answered

*Replace the [XIO(AlwaysOff),DryRun] placeholder with XIO(\Magnet_Pick.p_MagnetTaken)XIO(\Magnet_Pick.p_PickGaveUp).]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])XIC(p_MagnetReady)[XIO(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ]XIC(SS_OK)MOVE(25,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 22: Reload shuttle - Magnet_Pick confirmed it took the magnet; latch Success and drop p_MagnetReady

*Replace the [AlwaysOff,DryRun] placeholder with XIC(\Magnet_Pick.p_MagnetTaken).]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) XIC(p_MagnetReady) ,XIC(Status.State[25]) ][XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ]XIC(SS_OK)MOVE(22,Control.StateReg)[OTU(p_MagnetReady) ,OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 22: Reload shuttle - Magnet_Pick lost the magnet and requests a fresh presentation (no Success latch)

*Replace the [AlwaysOff,DryRun] placeholder with XIC(\Magnet_Pick.p_RequestNewMagnet).]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ]XIC(SS_OK)MOVE(22,Control.StateReg)OTU(p_MagnetReady);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 28: Unload station - stack exhausted after 3 misses, or Magnet_Pick gave up; drop p_MagnetReady, flag the stack exhausted and request the next stack

*Replace the [AlwaysOff,DryRun] placeholder on the 19/25 branch with XIC(\Magnet_Pick.p_PickGaveUp).]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) XIC(HorizontalShuttleExtendDelay.DN) XIC(i_TopRetainerRetracted) XIC(MagnetCheckDelay.DN) XIO(MagnetPresent) GEQ(MagnetRetryCount,3) ,[XIC(Status.State[19]) ,XIC(Status.State[25]) ] [XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ] ]XIC(SS_OK)MOVE(28,Control.StateReg)[OTU(p_MagnetReady) ,OTL(p_StackExhausted) ,OTL(p_RequestNextStack) ,CLR(MagnetRetryCount) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 31: Station complete - all four cylinders confirmed home, report complete and actuators safe to the dial]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[28])XIC(i_HorizontalShuttleRetracted)XIC(i_HoldDownRetracted)XIC(i_VerticalShuttleRetracted)XIC(i_TopRetainerRetracted)XIC(SS_OK)MOVE(31,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 99: Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(Lockout)MOVE(99,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 100: Start of initialization sequence, retract horizontal shuttle first to clear the stack]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIO(PartStarted)XIC(CycleRunning)XIC(SS_OK)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 103: Initialization retract hold down, vertical shuttle and top retainer]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(i_HorizontalShuttleRetracted)XIC(SS_OK)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[103])XIC(i_HoldDownRetracted)XIC(i_VerticalShuttleRetracted)XIC(i_TopRetainerRetracted)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Restart Logic |  | *Use the part status at this station to determine a course of action here.  | For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order. | Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(g_MachineBasic.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,98) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[State Engine]]>
</Comment>
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Cycle Time |  | **Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running | **Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,98) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor |  | *Replace always on with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Auto Mode]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Auto Stopped]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Actuators Safe For Index - all four cylinders confirmed at their retract sensors]]>
</Comment>
<Text>
<![CDATA[XIC(VerticalShuttleRetracted)XIC(HorizontalShuttleRetracted)XIC(HoldDownRetracted)XIC(TopRetainerRetracted)OTE(q_ActuatorsSafe);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Pause Request To Indexer - partner handshake timeouts warn and pause, they never hard fault the dial]]>
</Comment>
<Text>
<![CDATA[[XIC(Alarm[0].Active) ,XIC(Alarm[5].Active) ]OTE(q_Pause);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Part started once the stack is clamped; cleared at station complete or on powerup]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) ,XIC(PartStarted) XIO(Status.State[31]) XIO(g_MachineBasic.PowerUpCP) ]OTE(PartStarted);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Set Part Tracking If Station Is Locked Out]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)XIC(Status.State[99])XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Station Complete - reported at state 31 and whenever the station is idle or locked out]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[31]) ,XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[99]) ]OTE(q_StationComplete);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Horizontal Shuttle Manual Permissives - top retainer must be extended before the shuttle may go over]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(TopRetainerExtended)[XIC(HMI_Momentary.0) OTE(OkManExtendHorizontalShuttle) ,XIC(HMI_Momentary.1) OTE(OkManRetractHorizontalShuttle) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Horizontal Shuttle Extend - state 13 presents the magnet]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[13]) ,XIC(q_ExtendHorizontalShuttle) XIO(Status.State[16]) XIO(Status.State[22]) XIO(Status.State[28]) XIO(Status.State[100]) XIO(Status.State[4]) ] ,XIC(Status.State[1]) [XIC(OkManExtendHorizontalShuttle) ,XIC(q_ExtendHorizontalShuttle) XIO(OkManRetractHorizontalShuttle) ] ]OTE(q_ExtendHorizontalShuttle);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Horizontal Shuttle Retract - reload states 16/22, unload state 28 and initialization state 100]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[16]) ,XIC(Status.State[22]) ,XIC(Status.State[28]) ,XIC(Status.State[100]) ,XIC(q_RetractHorizontalShuttle) XIO(Status.State[13]) ] ,XIC(Status.State[1]) [XIC(OkManRetractHorizontalShuttle) ,XIC(q_RetractHorizontalShuttle) XIO(OkManExtendHorizontalShuttle) ] ]OTE(q_RetractHorizontalShuttle);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Vertical Shuttle Extend - raised at state 10 and sealed through the present/pick cycle]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[10]) ,XIC(q_ExtendVerticalShuttle) XIO(Status.State[28]) XIO(Status.State[103]) XIO(Status.State[4]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.2) ,XIC(q_ExtendVerticalShuttle) XIO(HMI_Momentary.3) ] ]OTE(q_ExtendVerticalShuttle);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Vertical Shuttle Retract - only after the horizontal shuttle is confirmed clear of the stack]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[28]) XIC(i_HorizontalShuttleRetracted) ,XIC(Status.State[103]) ,XIC(q_RetractVerticalShuttle) XIO(Status.State[10]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.3) ,XIC(q_RetractVerticalShuttle) XIO(HMI_Momentary.2) ] ]OTE(q_RetractVerticalShuttle);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Hold Down Extend - clamps the stack at state 7]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[7]) ,XIC(q_ExtendHoldDown) XIO(Status.State[28]) XIO(Status.State[103]) XIO(Status.State[4]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.4) ,XIC(q_ExtendHoldDown) XIO(HMI_Momentary.5) ] ]OTE(q_ExtendHoldDown);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Hold Down Retract - only after the horizontal shuttle is confirmed clear of the stack]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[28]) XIC(i_HorizontalShuttleRetracted) ,XIC(Status.State[103]) ,XIC(q_RetractHoldDown) XIO(Status.State[7]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.5) ,XIC(q_RetractHoldDown) XIO(HMI_Momentary.4) ] ]OTE(q_RetractHoldDown);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Top Retainer Extend - retainer-before-shuttle rule: extended at state 7 and again at states 16/22 once the shuttle is home]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[7]) XIC(HoldDownExtendDelay.DN) ,[XIC(Status.State[16]) ,XIC(Status.State[22]) ] XIC(i_HorizontalShuttleRetracted) ,XIC(q_ExtendTopRetainer) XIO(Status.State[13]) XIO(Status.State[28]) XIO(Status.State[103]) XIO(Status.State[4]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.6) ,XIC(q_ExtendTopRetainer) XIO(HMI_Momentary.7) ] ]OTE(q_ExtendTopRetainer);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Top Retainer Retract - only after the horizontal shuttle is confirmed over the pick position at state 13]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[13]) XIC(HorizontalShuttleExtendDelay.DN) ,XIC(Status.State[28]) ,XIC(Status.State[103]) ,XIC(q_RetractTopRetainer) XIO(Status.State[7]) XIO(Status.State[16]) XIO(Status.State[22]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.7) ,XIC(q_RetractTopRetainer) XIO(HMI_Momentary.6) ] ]OTE(q_RetractTopRetainer);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[SM Output Signal: p_MagnetReady - latched at state 19 when a magnet is presented and confirmed, dropped on reload / unload / index wait]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) OTL(p_MagnetReady) ,[XIC(Status.State[22]) ,XIC(Status.State[28]) ,XIC(Status.State[4]) ] OTU(p_MagnetReady) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Station Performance]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)StationPerformance(StationPerformance,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success,g_PresetStationPerformLow,g_PresetStationPerformHigh,\Tracking.p_Data.Station[StaNum].PerformData.Attempts,\Tracking.p_Data.Station[StaNum].PerformData.Successes,\Tracking.p_Data.Station[StaNum].PerformData.Failures,\Tracking.p_Data.Station[StaNum].PerformData.Efficiency,\Tracking.p_Data.Station[StaNum].PerformData.HMIColorStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[State 4: Timeout waiting for Dial_Index index complete - warning plus q_Pause, station holds in state 4 and resumes on FaultReset]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(60000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[0].Active) ,ONS(ONS.5) MOVE(1,Alarm[0].Severity) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 7: Hold Down / Top Retainer failed to extend]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])MOVE(5000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[1].Active) ,ONS(ONS.6) CONCAT(g_StationList[StaNum],AlarmList[1],Alarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 10: Vertical Shuttle failed to raise (i_VerticalShuttleRetracted still made)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])MOVE(5000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[2].Active) ,ONS(ONS.7) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 13: Horizontal Shuttle extend / Top Retainer retract not confirmed - motion fault only, a missing magnet is handled by the retry branch and never by this timer]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])MOVE(5000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[3].Active) ,ONS(ONS.8) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[States 16 / 22: Horizontal Shuttle failed to retract or Top Retainer failed to re-extend for the next presentation]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) ,XIC(Status.State[22]) ]MOVE(5000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[4].Active) ,ONS(ONS.9) CONCAT(g_StationList[StaNum],AlarmList[4],Alarm[4].Message) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 25: Timeout waiting on Magnet_Pick (taken / new-magnet request / give-up) - warning plus q_Pause, magnet stays presented, resumes on FaultReset]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])MOVE(30000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[5].Active) ,ONS(ONS.10) MOVE(1,Alarm[5].Severity) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 28: Station failed to unload to home (check retract sensors)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[28])MOVE(5000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[6].Active) ,ONS(ONS.11) CONCAT(g_StationList[StaNum],AlarmList[6],Alarm[6].Message) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Use="Context" Name="Supervisor" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="q_CycleStartLatch">
</Tag>
<Tag Use="Reference" Name="q_CycleStopped">
</Tag>
<Tag Use="Reference" Name="q_FaultReset">
</Tag>
<Tag Use="Reference" Name="q_ManualMode">
</Tag>
<Tag Use="Reference" Name="q_SafetyOK">
</Tag>
</Tags>
</Program>
<Program Use="Context" Name="Tracking" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="p_Data">
</Tag>
</Tags>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
