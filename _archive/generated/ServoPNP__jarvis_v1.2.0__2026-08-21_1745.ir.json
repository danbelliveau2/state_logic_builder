  "machineSpec": {
    "purpose": "A two-axis SDC servo pick-and-place that picks a part at the pick position and places it at the place position, running standalone and looping back for the next pick.",
    "devicePurposes": [
      {
        "deviceName": "Horizontal_Axis",
        "purpose": "Horizontal axis — traverses the tooling between home, pick, and place, blending its move in as the vertical axis clears."
      },
      {
        "deviceName": "Vertical_Axis",
        "purpose": "Vertical axis — raises and lowers the tooling at pick and place, fast down to a transition point then slow into the part, slow back up to the transition point then fast to retract."
      },
      {
        "deviceName": "Part_Gripper",
        "purpose": "Gripper — holds the part between pick and place; no sensors, timer-based confirmation only (250 ms engage/disengage)."
      }
    ],
    "sequence": [],
    "outcomeRules": [
      {
        "trigger": "Any fault during the cycle",
        "response": "Recover the vertical (Z) axis to the safe/retract position first, then branch based on the state of the gripper.",
        "retryCount": null,
        "escalation": ""
      },
      {
        "trigger": "Recovery with the gripper commanded open (no part assumed held)",
        "response": "Resume at the pick sequence to go get a new part.",
        "retryCount": null,
        "escalation": ""
