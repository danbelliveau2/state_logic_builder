<Comments>
<Comment Operand=".STATE[40]">
<![CDATA[Z Fast To Retract, Round Corner Into X Return Home]]>
</Comment>
<Comment Operand=".STATE[37]">
<![CDATA[Z Slow Into Place Position]]>
</Comment>
<Comment Operand=".STATE[34]">
<![CDATA[Z Fast To Retract, Round Corner Into X Move To Place]]>
</Comment>
<Comment Operand=".STATE[0]">
<![CDATA[Emergency Stop]]>
</Comment>
<Comment Operand=".STATE[1]">
<![CDATA[Manual Mode]]>
</Comment>
<Comment Operand=".STATE[2]">
<![CDATA[Auto Mode Idle Not Ready]]>
</Comment>
<Comment Operand=".STATE[3]">
<![CDATA[Auto Mode Idle Ready]]>
</Comment>
<Comment Operand=".STATE[4]">
<![CDATA[Wait At Home For Start (Z Retracted, Actuators Safe)]]>
</Comment>
<Comment Operand=".STATE[7]">
<![CDATA[Clear Z To Retract And Traverse X Through In-Between (Fast, Blended)]]>
</Comment>
<Comment Operand=".STATE[10]">
<![CDATA[X Fast To Pick / Z Fast Down To Pick Transition]]>
</Comment>
<Comment Operand=".STATE[13]">
<![CDATA[Z Slow Down Into Pick Position]]>
</Comment>
<Comment Operand=".STATE[16]">
<![CDATA[Close Gripper On Part (Timer Only)]]>
</Comment>
<Comment Operand=".STATE[19]">
<![CDATA[Z Slow Up Out Of Pick To Pick Transition]]>
</Comment>
<Comment Operand=".STATE[22]">
<![CDATA[Z Fast Down To Place Transition]]>
</Comment>
<Comment Operand=".STATE[25]">
<![CDATA[Open Gripper To Release Part (Timer Only)]]>
</Comment>
<Comment Operand=".STATE[28]">
<![CDATA[Z Slow Up Out Of Place To Place Transition]]>
</Comment>
<Comment Operand=".STATE[31]">
<![CDATA[Cycle Complete - Report To Supervisor And Wait For Acknowledge]]>
</Comment>
<Comment Operand=".STATE[99]">
<![CDATA[Lockout]]>
</Comment>
<Comment Operand=".STATE[100]">
<![CDATA[Initialization Retract Z Axis]]>
</Comment>
<Comment Operand=".STATE[103]">
<![CDATA[Initialization Return X Axis To Home]]>
</Comment>
<Comment Operand=".STATE[124]">
<![CDATA[Initialization Complete]]>
</Comment>
<Comment Operand=".STATE[127]">
<![CDATA[Faulted]]>
</Comment>
</Comments>
