<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(Input) MOVE(OnDelay,OnTimer.PRE) TON(OnTimer,?,?) ,XIO(Input) MOVE(OffDelay,OffTimer.PRE) TON(OffTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(OnTimer.DN) OTE(On) ,XIC(OffTimer.DN) OTE(Off) ];]]>
</Text>
</Rung>
</RLLContent>
