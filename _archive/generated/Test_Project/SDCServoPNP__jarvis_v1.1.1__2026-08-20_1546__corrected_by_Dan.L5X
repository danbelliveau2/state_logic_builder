<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R04_XAxisServo,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R05_ZAxisServo,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Nest & Station Numbers]]>
</Comment>
<Text>
<![CDATA[[MOVE(5,StaNum) MOVE(4,StaNumPre) ,MOVE(\Tracking.p_Data.Station[StaNum].NestNum,NestNumCurrent) MOVE(\Tracking.p_Data.Station[StaNumPre].NestNum,NestNumIncoming) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[AOI_Debounce(PartPresentDebounce,i_PartPresent,100,100);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(q_PartGripperOpen)XIO(q_PartGripperClose)TON(PartGripperDisengageDelay,?,?)XIC(PartGripperDisengageDelay.DN)OTE(GripperOpened);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(q_PartGripperClose)XIO(q_PartGripperOpen)TON(PartGripperEngageDelay,?,?)XIC(PartGripperEngageDelay.DN)OTE(GripperClosed);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Initialized: both axes homed and VerticalAxis at Retract (dial-safe posture)]]>
</Comment>
<Text>
<![CDATA[XIC(VerticalAxisRetract.InPos)XIC(iq_ZAxis.AxisHomedStatus)XIC(iq_XAxis.AxisHomedStatus)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)XIO(ManualMode)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Dry run logic (can add supervisor dry run condition if needed as parallel branch)]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.DryRun)OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Cycle Station]]>
</Comment>
<Text>
<![CDATA[[XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded) [XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNumPre].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNumPre].Lockout) ] ,XIC(DryRun) ][XIO(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStationA) ,OTE(CycleStationB) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[STATE MAP (generated — authoritative): 4=Wait at Home for Start (Z retracted, actuators safe) | 7=Clear Z to Retract and traverse X through In-Between (fast, blended) | 10=X fast to Pick / Z fast down to Pick Transition | 13=Z slow down into Pick position | 16=Close gripper on part (timer only) | 19=Z slow up out of Pick to Pick Transition (blend into fast retract) | 22=Z fast down to Place Transition | 25=Open gripper to release part (timer only) | 28=Z slow up out of Place to Place Transition (blend into fast retract) | 31=Cycle Complete — report to supervisor and wait for acknowledge | 34=Z fast to Retract, round corner into X move to Place | 37=Z slow into Place position | 40=Z fast to Retract, round corner into X return Home
Start Of State Machine

State map: 4 idle/wait cycle start | 7 VerticalAxis clear + HorizontalAxis to In-Between (fast, blend) | 10 X fast to Pick + Z fast to Pick Transition | 13 Z slow into Pick | 16 close gripper | 19 Z slow up to Pick Transition | 34 Z fast Retract + X to Place | 22 Z fast to Place Transition | 37 Z slow into Place | 25 open gripper | 28 Z slow up to Place Transition | 40 Z fast Retract + X Home | 31 cycle complete | 99 lockout | 100-124 init/recovery | 127 fault]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[99]) XIO(CycleRunning) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[4]) ,XIC(Status.State[31]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Wait at Home for Start (Z retracted, actuators safe)

Entry from idle ready, from init complete (124) and from cycle complete (31) when the supervisor drops the start request.

*Replace AlwaysOff bit with XIO(\Supervisor.p_CycleStart) - supervisor acknowledge of station complete.]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) XIC(VerticalAxisRetract.InPos) XIC(iq_ZAxis.AxisHomedStatus) XIC(iq_XAxis.AxisHomedStatus) ] ,XIC(Status.State[31]) XIC(q_StationComplete) [XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ] XIC(SS_OK) ]XIC(CycleRunning)XIO(Lockout)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Clear VerticalAxis to Retract and traverse HorizontalAxis through In-Between (fast, blended)

No part held - normal pick path.

*Replace AlwaysOff bit with XIC(\Supervisor.p_CycleStart) - supervisor cycle start request.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ]XIC(iq_ZAxis.AxisHomedStatus)XIC(iq_XAxis.AxisHomedStatus)XIC(VerticalAxisRetract.InPos)XIO(PartHeld)XIC(SS_OK)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: HorizontalAxis fast to Pick / VerticalAxis fast down to Pick Transition

Wideband blend out of Z Retract and X In-Between - no dead stop at the corner.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])[XIC(VerticalAxis_MAM.PC) XIC(VerticalAxisRetract.InPos) ,XIC(VerticalAxis_MAM.IP) XIC(VerticalAxisRetract.InPosWide) ]XIC(HorizontalAxis_MAM.PC)XIC(HorizontalAxisInBetween.InPos)XIC(SS_OK)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: VerticalAxis slow down into Pick position

Strict in-position on both axes: the fast descent must be fully stopped at the transition point before the slow approach. LT(err,0.5) is the in-position band.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(HorizontalAxis_MAM.PC)LT(HorizontalAxisPickError,0.5)XIC(VerticalAxis_MAM.PC)LT(VerticalAxisPickTransError,0.5)XIC(SS_OK)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 16: Close gripper on part (timer only)

Process action - strict in-position only. Station commits to the part here: latch part tracking Attempt.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(VerticalAxis_MAM.PC)XIC(VerticalAxisPick.InPos)XIC(SS_OK)MOVE(16,Control.StateReg)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 19: VerticalAxis slow up out of Pick to Pick Transition

No grip sensing exists - part assumed gripped on the engage timer.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[XIC(PartGripperEngageDelay.DN) ,XIC(DryRun) ]XIC(SS_OK)MOVE(19,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 34: VerticalAxis fast to Retract, round corner into HorizontalAxis move to Place

Entered from 19 with a wideband blend out of the slow-up segment (LT(err,5) = wide band), or from state 4 as the part-held recovery branch.

*Replace AlwaysOff bit with XIC(\Supervisor.p_CycleStart) - supervisor cycle start request.]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) [XIC(g_MachineBasic.AlwaysOff) ,XIC(DryRun) ] XIC(iq_ZAxis.AxisHomedStatus) XIC(iq_XAxis.AxisHomedStatus) XIC(VerticalAxisRetract.InPos) XIC(PartHeld) ,XIC(Status.State[19]) [XIC(VerticalAxis_MAM.PC) LT(VerticalAxisPickTransError,0.5) ,XIC(VerticalAxis_MAM.IP) LT(VerticalAxisPickTransError,5) ] ]XIC(SS_OK)MOVE(34,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 22: VerticalAxis fast down to Place Transition

HorizontalAxis must be truly at Place; Z retract blends (wideband) into the descent.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[34])XIC(HorizontalAxis_MAM.PC)LT(HorizontalAxisPlaceError,0.5)[XIC(VerticalAxis_MAM.PC) XIC(VerticalAxisRetract.InPos) ,XIC(VerticalAxis_MAM.IP) XIC(VerticalAxisRetract.InPosWide) ]XIC(SS_OK)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 37: VerticalAxis slow into Place position

Strict: the fast descent must be stopped at the transition point before the slow approach into the nest.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[22])XIC(VerticalAxis_MAM.PC)LT(VerticalAxisPlaceTransError,0.5)XIC(SS_OK)MOVE(37,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 25: Open gripper to release part (timer only)

Release requires true in-position, never wideband.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[37])XIC(VerticalAxis_MAM.PC)XIC(VerticalAxisPlace.InPos)XIC(SS_OK)MOVE(25,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 28: VerticalAxis slow up out of Place to Place Transition

Place confirmed complete - latch part tracking Success.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[XIC(PartGripperDisengageDelay.DN) ,XIC(DryRun) ]XIC(SS_OK)MOVE(28,Control.StateReg)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 40: VerticalAxis fast to Retract, round corner into HorizontalAxis return Home

Wideband blend (LT(err,5)) replaces the drawn 150 ms corner delay.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[28])[XIC(VerticalAxis_MAM.PC) LT(VerticalAxisPlaceTransError,0.5) ,XIC(VerticalAxis_MAM.IP) LT(VerticalAxisPlaceTransError,5) ]XIC(SS_OK)MOVE(40,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 31: Cycle Complete - report to supervisor and wait for acknowledge

Strict on both axes: dial-safe posture must be truly reached before q_StationComplete.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[40])XIC(HorizontalAxis_MAM.PC)XIC(HorizontalAxisHome.InPos)XIC(VerticalAxis_MAM.PC)XIC(VerticalAxisRetract.InPos)XIC(SS_OK)MOVE(31,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 99: Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(Lockout)MOVE(99,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 100: Start of initialization/recovery sequence, retract VerticalAxis

Safety first - Z goes up before any horizontal motion. Also the fault recovery path: after FaultReset from state 127 the init block runs.]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[2]) XIO(Initialized) XIC(SS_OK) ,XIC(Status.State[127]) XIC(FaultReset) ]XIC(CycleRunning)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[State 103: Initialization return HorizontalAxis to Home]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(VerticalAxis_MAM.PC)XIC(VerticalAxisRetract.InPos)XIC(SS_OK)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete - hand the part-held decision to state 4]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[103])XIC(HorizontalAxis_MAM.PC)XIC(HorizontalAxisHome.InPos)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. PartHeld selects the place path at state 4.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(g_MachineBasic.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,98) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[State Engine]]>
</Comment>
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,98) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(iq_XAxis.ServoActionStatus)XIC(iq_XAxis.AxisHomedStatus)XIC(iq_ZAxis.ServoActionStatus)XIC(iq_ZAxis.AxisHomedStatus)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Actuators Safe For Index - both axes homed, VerticalAxis at Retract, no motion in process]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ,XIC(Status.State[31]) ,XIC(Status.State[3]) ]XIC(iq_XAxis.AxisHomedStatus)XIC(iq_ZAxis.AxisHomedStatus)XIC(VerticalAxisRetract.InPos)XIO(HorizontalAxis_MAM.IP)XIO(VerticalAxis_MAM.IP)OTE(q_ActuatorsSafe);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Pause Request To Supervisor - any active alarm/warning or timeout holds the machine, cleared by FaultReset]]>
</Comment>
<Text>
<![CDATA[[XIC(AlarmActive) ,XIC(WarningActive) ,XIC(Status.TimeoutFlt) ]XIO(FaultReset)OTE(q_Pause);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Part Held - latched on the gripper engage timer at state 16, retentive so it survives a fault or power cycle (drives the state 4 recovery branch)]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) XIC(PartGripperEngageDelay.DN) OTL(PartHeld) ,XIC(Status.State[25]) XIC(PartGripperDisengageDelay.DN) OTU(PartHeld) ,XIC(PartHeld) OTE(PartStarted) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Set Part Tracking If Station Is Locked Out]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)XIC(Status.State[99])XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Station Complete - latched at cycle complete (31), cleared on entry to idle (4)]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[31]) OTL(q_StationComplete) ,XIC(Status.State[4]) OTU(q_StationComplete) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Gripper Control - close at state 16]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[16]) ,XIC(q_PartGripperClose) XIO(Status.State[25]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.0) ,XIC(q_PartGripperClose) XIO(HMI_Momentary.1) ] ]OTE(q_PartGripperClose);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Gripper Control - open at state 25]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[25]) ,XIC(q_PartGripperOpen) XIO(Status.State[16]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.1) ,XIC(q_PartGripperOpen) XIO(HMI_Momentary.0) ] ]OTE(q_PartGripperOpen);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Station Performance]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)StationPerformance(StationPerformance,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success,g_PresetStationPerformLow,g_PresetStationPerformHigh,\Tracking.p_Data.Station[StaNum].PerformData.Attempts,\Tracking.p_Data.Station[StaNum].PerformData.Successes,\Tracking.p_Data.Station[StaNum].PerformData.Failures,\Tracking.p_Data.Station[StaNum].PerformData.Efficiency,\Tracking.p_Data.Station[StaNum].PerformData.HMIColorStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R04_XAxisServo" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Axis Is Ready For Operation]]>
</Comment>
<Text>
<![CDATA[XIC(MotionGroup.GroupSynced)XIO(iq_XAxis.SafeTorqueOffActiveInhibit)OTE(XAxisReady);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(SafetyOK)XIC(XAxisReady)TON(XAxisEnableDelay,?,?)XIC(XAxisEnableDelay.DN)ONS(XAxisONS.0)OTE(XAxisAutoEnable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[HorizontalAxis Permissive - VerticalAxis homed and at Retract (tight or wide band; the wide band is the clearance height that rounds the corner)]]>
</Comment>
<Text>
<![CDATA[XIC(iq_ZAxis.AxisHomedStatus)[XIC(VerticalAxisRetract.InPos) ,XIC(VerticalAxisRetract.InPosWide) ]OTE(XAxisPermissive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) XIC(HMI_XAxis.Control.Enable) XIC(XAxisReady) ,XIC(XAxisAutoEnable) ]XIO(iq_XAxis.ServoActionStatus)MSO(iq_XAxis,XAxis_MSO);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(HMI_XAxis.Control.Disable)MSF(iq_XAxis,XAxis_MSF);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fault Reset Axis]]>
</Comment>
<Text>
<![CDATA[NE(iq_XAxis.AxisFault,0)XIC(FaultReset)[XIO(iq_XAxis.ShutdownStatus) MAFR(iq_XAxis,XAxis_MAFR) ,XIC(iq_XAxis.ShutdownStatus) MASR(iq_XAxis,XAxis_MASR) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Jog Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(XAxisPermissive)XIC(iq_XAxis.ServoActionStatus)XIO(iq_XAxis.JogStatus)XIO(iq_XAxis.MoveStatus)[XIC(HMI_XAxis.Control.JogPositive) XIO(HMI_XAxis.Control.JogNegative) MOVE(0,XAxisJogDirection) ,XIC(HMI_XAxis.Control.JogNegative) XIO(HMI_XAxis.Control.JogPositive) MOVE(1,XAxisJogDirection) ]MAJ(iq_XAxis,XAxis_MAJ,XAxisJogDirection,HMI_XAxis.Parameters.JogSpeed,Units per sec,HMI_XAxis.Parameters.Accel[0],Units per sec2,HMI_XAxis.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per MasterUnit3,Disabled,0,0,None);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(XAxis_MAJ.IP)XIO(HMI_XAxis.Control.JogPositive)XIO(HMI_XAxis.Control.JogNegative)MAS(iq_XAxis,XAxis_MAS_Jog,Jog,Yes,HMI_XAxis.Parameters.Decel[0],Units per sec2,No,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Inch Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_XAxis.Control.InchPositive) ONS(XAxisONS.1) MOVE(HMI_XAxis.Parameters.InchAmount,XAxisInchAmount) ,XIC(HMI_XAxis.Control.InchNegative) ONS(XAxisONS.2) NEG(HMI_XAxis.Parameters.InchAmount,XAxisInchAmount) ]XIC(XAxisPermissive)XIC(iq_XAxis.ServoActionStatus)XIO(iq_XAxis.JogStatus)XIO(iq_XAxis.MoveStatus)MAM(iq_XAxis,XAxis_Inch,1,XAxisInchAmount,HMI_XAxis.Parameters.ManualSpeed,Units per sec,HMI_XAxis.Parameters.Accel[0],Units per sec2,HMI_XAxis.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Home Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_XAxis.Control.HomeRequest) ONS(XAxisONS.3) XIO(XAxisTorqueHome.IP) ,XIC(XAxisHomeRequested) XIO(XAxisHomeConfirmDelay.DN) XIO(XAxisHomeConfimed) ]XIC(XAxisReady)[OTE(XAxisHomeRequested) ,TON(XAxisHomeConfirmDelay,?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_XAxis.Control.HomeConfirm) ONS(XAxisONS.4) ,XIC(XAxisHomeConfimed) XIC(XAxisHomeSelect) XIO(XAxisTorqueHome.PC) XIO(XAxisTorqueHome.Error) ]OTE(XAxisHomeConfimed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Home Select = 0 is for Immediate Home (Example, servo indexer)
Home Select = 1 is for Home To Torque (Example, PNP)

Homing Torque = Start at 25%, Increase In 5% Increments If Not Enough
Run Torque = Normal Running Torque Of Axis
Homing Speed = Homing Speed in units/s
Overtorque Limit = Set The Same As Homing Torque
Home Offset Distance = Distance Moved Off Of Hard Stop When Homing Complete
Home Direction = 0 Is Positive, 1 Is Negative]]>
</Comment>
<Text>
<![CDATA[XIC(XAxisHomeConfimed)[XIO(XAxisHomeSelect) MAH(iq_XAxis,XAxis_MAH) ,XIC(XAxisHomeSelect) AOI_TorqueHome(XAxisTorqueHome,iq_XAxis,25.0,100.0,5.0,25.0,0.5,1) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(XAxisHomeRequested) OTE(HMI_XAxis.Status.HomeRequested) ,[XIC(XAxisTorqueHome.IP) ,XIC(XAxis_MAH.IP) ] OTE(HMI_XAxis.Status.HomeInProcess) ,[XIC(XAxisTorqueHome.PC) ,XIC(XAxis_MAH.PC) ] OTE(HMI_XAxis.Status.HomeComplete) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIC(Status.State[1])[[MOVE(HMI_XAxis.Parameters.ManualSpeed,HorizontalAxisMotionParameters.Speed) ,MOVE(HMI_XAxis.Parameters.Accel[0],HorizontalAxisMotionParameters.Accel) ,MOVE(HMI_XAxis.Parameters.Decel[0],HorizontalAxisMotionParameters.Decel) ] ,XIC(XAxisPermissive) [XIC(HMI_XAxis.Control.ManMoves.0) MOVE(HMI_XAxis.Parameters.Positions[0],HorizontalAxisMotionParameters.Position) ,XIC(HMI_XAxis.Control.ManMoves.1) MOVE(HMI_XAxis.Parameters.Positions[1],HorizontalAxisMotionParameters.Position) ] OTE(XAxisManMoveTrig) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Auto Mode - HorizontalAxis POSITION staging. Positions[0]=Home [1]=InBetween [2]=Pick [3]=Place. Speed profile staged on the following rung.]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(Status.State[1])[MOVE(0,HorizontalAxisMotionParameters.MoveType) ,XIC(Status.State[7]) MOVE(HMI_XAxis.Parameters.Positions[1],HorizontalAxisMotionParameters.Position) ,XIC(Status.State[10]) MOVE(HMI_XAxis.Parameters.Positions[2],HorizontalAxisMotionParameters.Position) ,XIC(Status.State[34]) MOVE(HMI_XAxis.Parameters.Positions[3],HorizontalAxisMotionParameters.Position) ,[XIC(Status.State[40]) ,XIC(Status.State[103]) ] MOVE(HMI_XAxis.Parameters.Positions[0],HorizontalAxisMotionParameters.Position) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[HorizontalAxis SPEED PROFILE - Fast = AutoSpeed[1]/Accel[1]/Decel[1], used in every HorizontalAxis auto move state (7,10,34,40,103). The horizontal axis has no declared transition point, so it runs one profile.]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(Status.State[1])[XIC(Status.State[7]) ,XIC(Status.State[10]) ,XIC(Status.State[34]) ,XIC(Status.State[40]) ,XIC(Status.State[103]) ][MOVE(HMI_XAxis.Parameters.AutoSpeed[1],HorizontalAxisMotionParameters.Speed) ,MOVE(HMI_XAxis.Parameters.Accel[1],HorizontalAxisMotionParameters.Accel) ,MOVE(HMI_XAxis.Parameters.Decel[1],HorizontalAxisMotionParameters.Decel) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[HorizontalAxis Auto Move Trigger - one shot per move state (7,10,34,40,103), unlatched once the MAM is in process/complete so the next state re-triggers the MAM]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) ONS(XAxisONS.5) ,XIC(Status.State[10]) ONS(XAxisONS.6) ,XIC(Status.State[34]) ONS(XAxisONS.7) ,XIC(Status.State[40]) ONS(XAxisONS.8) ,XIC(Status.State[103]) ONS(XAxisONS.9) ]OTL(HorizontalAxisAutoMoveTrig);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Clear HorizontalAxis Auto Move Trigger]]>
</Comment>
<Text>
<![CDATA[[XIC(HorizontalAxis_MAM.IP) ,XIC(HorizontalAxis_MAM.PC) ,XIO(SafetyOK) ,XIC(Status.State[1]) ]OTU(HorizontalAxisAutoMoveTrig);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[HorizontalAxis Motion Command - gated by the one-shot auto move trigger so consecutive move states re-execute the MAM (states 7,10,34,40,103)]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)[XIC(Status.State[1]) XIC(XAxisManMoveTrig) ,XIO(Status.State[1]) XIC(HorizontalAxisAutoMoveTrig) ]XIC(iq_XAxis.ServoActionStatus)XIC(iq_XAxis.AxisHomedStatus)XIC(XAxisPermissive)MAM(iq_XAxis,HorizontalAxis_MAM,HorizontalAxisMotionParameters.MoveType,HorizontalAxisMotionParameters.Position,HorizontalAxisMotionParameters.Speed,Units per sec,HorizontalAxisMotionParameters.Accel,Units per sec2,HorizontalAxisMotionParameters.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Stop axis if permissive turns off while in motion and use max or close to max decel value]]>
</Comment>
<Text>
<![CDATA[XIO(iq_XAxis.MotionStatus.0)[XIO(XAxisPermissive) ,XIO(SafetyOK) ]MAS(iq_XAxis,XAxis_MAS_All,All,Yes,HMI_XAxis.Status.MaxDecel,Units per sec2,Yes,10,% of Time);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Set torque]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_XAxis.Control.SetTorquePos)MOVE(HMI_XAxis.Parameters.TorquePos,iq_XAxis.TorqueLimitPositive);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(HMI_XAxis.Control.SetTorqueNeg)MOVE(HMI_XAxis.Parameters.TorqueNeg,iq_XAxis.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Retrieve values from axis]]>
</Comment>
<Text>
<![CDATA[MOVE(iq_XAxis.ActualPosition,HMI_XAxis.Status.ActualPosition)MOVE(iq_XAxis.ActualVelocity,HMI_XAxis.Status.ActualVelocity)MOVE(iq_XAxis.TorqueReferenceFiltered,HMI_XAxis.Status.ActualTorque);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Retrieve the maximum speed value from the axis and calculate max accel and decel.  The max velocity is 85% of full speed.  Equation is based upon 100% speed at a 30ms accel/decel time.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)GSV(Axis,iq_XAxis,MaximumSpeed,HMI_XAxis.Status.MaxVelocity)CPT(HMI_XAxis.Status.MaxAccel,(HMI_XAxis.Status.MaxVelocity/0.85)/0.03)MOVE(HMI_XAxis.Status.MaxAccel,HMI_XAxis.Status.MaxDecel);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[HorizontalAxis Position Monitor - Home/InBetween use AOI_RangeCheck; Pick/Place use an absolute position error (LT 0.5 = in position, LT 5 = wide band) because no further RangeCheck instances exist. Wide bands are placeholders - CE to set from real fixture clearance.]]>
</Comment>
<Text>
<![CDATA[[AOI_RangeCheck(HorizontalAxisHome,HMI_XAxis.Parameters.Positions[0],0.5,HMI_XAxis.Status.ActualPosition,5) ,AOI_RangeCheck(HorizontalAxisInBetween,HMI_XAxis.Parameters.Positions[1],0.5,HMI_XAxis.Status.ActualPosition,5) ,SUB(HMI_XAxis.Status.ActualPosition,HMI_XAxis.Parameters.Positions[2],HorizontalAxisPickError) ABS(HorizontalAxisPickError,HorizontalAxisPickError) ,SUB(HMI_XAxis.Status.ActualPosition,HMI_XAxis.Parameters.Positions[3],HorizontalAxisPlaceError) ABS(HorizontalAxisPlaceError,HorizontalAxisPlaceError) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R05_ZAxisServo" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Axis Is Ready For Operation]]>
</Comment>
<Text>
<![CDATA[XIC(MotionGroup.GroupSynced)XIO(iq_ZAxis.SafeTorqueOffActiveInhibit)OTE(ZAxisReady);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(SafetyOK)XIC(ZAxisReady)TON(ZAxisEnableDelay,?,?)XIC(ZAxisEnableDelay.DN)ONS(ZAxisONS.0)OTE(ZAxisAutoEnable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Axis Motion Permissive (Add more conditions if necessary. Permissive should be based on the physical state of itself potentially interfering devices)]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)OTE(ZAxisPermissive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) XIC(HMI_ZAxis.Control.Enable) XIC(ZAxisReady) ,XIC(ZAxisAutoEnable) ]XIO(iq_ZAxis.ServoActionStatus)MSO(iq_ZAxis,ZAxis_MSO);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(HMI_ZAxis.Control.Disable)MSF(iq_ZAxis,ZAxis_MSF);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fault Reset Axis]]>
</Comment>
<Text>
<![CDATA[NE(iq_ZAxis.AxisFault,0)XIC(FaultReset)[XIO(iq_ZAxis.ShutdownStatus) MAFR(iq_ZAxis,ZAxis_MAFR) ,XIC(iq_ZAxis.ShutdownStatus) MASR(iq_ZAxis,ZAxis_MASR) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Jog Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(ZAxisPermissive)XIC(iq_ZAxis.ServoActionStatus)XIO(iq_ZAxis.JogStatus)XIO(iq_ZAxis.MoveStatus)[XIC(HMI_ZAxis.Control.JogPositive) XIO(HMI_ZAxis.Control.JogNegative) MOVE(0,ZAxisJogDirection) ,XIC(HMI_ZAxis.Control.JogNegative) XIO(HMI_ZAxis.Control.JogPositive) MOVE(1,ZAxisJogDirection) ]MAJ(iq_ZAxis,ZAxis_MAJ,ZAxisJogDirection,HMI_ZAxis.Parameters.JogSpeed,Units per sec,HMI_ZAxis.Parameters.Accel[0],Units per sec2,HMI_ZAxis.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per MasterUnit3,Disabled,0,0,None);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(ZAxis_MAJ.IP)XIO(HMI_ZAxis.Control.JogPositive)XIO(HMI_ZAxis.Control.JogNegative)MAS(iq_ZAxis,ZAxis_MAS,Jog,Yes,HMI_ZAxis.Parameters.Decel[0],Units per sec2,No,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Inch Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_ZAxis.Control.InchPositive) ONS(ZAxisONS.1) MOVE(HMI_ZAxis.Parameters.InchAmount,ZAxisInchAmount) ,XIC(HMI_ZAxis.Control.InchNegative) ONS(ZAxisONS.2) NEG(HMI_ZAxis.Parameters.InchAmount,ZAxisInchAmount) ]XIC(ZAxisPermissive)XIC(iq_ZAxis.ServoActionStatus)XIO(iq_ZAxis.JogStatus)XIO(iq_ZAxis.MoveStatus)MAM(iq_ZAxis,ZAxis_Inch,1,ZAxisInchAmount,HMI_ZAxis.Parameters.ManualSpeed,Units per sec,HMI_ZAxis.Parameters.Accel[0],Units per sec2,HMI_ZAxis.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Home Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_ZAxis.Control.HomeRequest) ONS(ZAxisONS.3) XIO(ZAxisTorqueHome.IP) ,XIC(ZAxisHomeRequested) XIO(ZAxisHomeConfirmDelay.DN) XIO(ZAxisHomeConfimed) ]XIC(ZAxisReady)[OTE(ZAxisHomeRequested) ,TON(ZAxisHomeConfirmDelay,?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_ZAxis.Control.HomeConfirm) ONS(ZAxisONS.4) ,XIC(ZAxisHomeConfimed) XIC(ZAxisHomeSelect) XIO(ZAxisTorqueHome.PC) XIO(ZAxisTorqueHome.Error) ]OTE(ZAxisHomeConfimed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Home Select = 0 is for Immediate Home (Example, servo indexer)
Home Select = 1 is for Home To Torque (Example, PNP)

Homing Torque = Start at 25%, Increase In 5% Increments If Not Enough
Run Torque = Normal Running Torque Of Axis
Homing Speed = Homing Speed in units/s
Overtorque Limit = Set The Same As Homing Torque
Home Offset Distance = Distance Moved Off Of Hard Stop When Homing Complete
Home Direction = 0 Is Positive, 1 Is Negative]]>
</Comment>
<Text>
<![CDATA[XIC(ZAxisHomeConfimed)[XIO(ZAxisHomeSelect) MAH(iq_ZAxis,ZAxis_MAH) ,XIC(ZAxisHomeSelect) AOI_TorqueHome(ZAxisTorqueHome,iq_ZAxis,25.0,100.0,5.0,25.0,0.5,1) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(ZAxisHomeRequested) OTE(HMI_ZAxis.Status.HomeRequested) ,[XIC(ZAxisTorqueHome.IP) ,XIC(ZAxis_MAH.IP) ] OTE(HMI_ZAxis.Status.HomeInProcess) ,[XIC(ZAxisTorqueHome.PC) ,XIC(ZAxis_MAH.PC) ] OTE(HMI_ZAxis.Status.HomeComplete) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIC(Status.State[1])[[MOVE(HMI_ZAxis.Parameters.ManualSpeed,VerticalAxisMotionParameters.Speed) ,MOVE(HMI_ZAxis.Parameters.Accel[0],VerticalAxisMotionParameters.Accel) ,MOVE(HMI_ZAxis.Parameters.Decel[0],VerticalAxisMotionParameters.Decel) ] ,XIC(ZAxisPermissive) [XIC(HMI_ZAxis.Control.ManMoves.0) MOVE(HMI_ZAxis.Parameters.Positions[0],VerticalAxisMotionParameters.Position) ,XIC(HMI_ZAxis.Control.ManMoves.1) MOVE(HMI_ZAxis.Parameters.Positions[1],VerticalAxisMotionParameters.Position) ,XIC(HMI_ZAxis.Control.ManMoves.2) MOVE(HMI_ZAxis.Parameters.Positions[2],VerticalAxisMotionParameters.Position) ] OTE(ZAxisManMoveTrig) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Auto Mode - VerticalAxis POSITION staging. Positions[0]=Retract [1]=PickTransition [2]=Pick [3]=PlaceTransition [4]=Place. Speed profiles staged on the two following rungs (Slow / Fast).]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(Status.State[1])[MOVE(0,VerticalAxisMotionParameters.MoveType) ,[XIC(Status.State[7]) ,XIC(Status.State[34]) ,XIC(Status.State[40]) ,XIC(Status.State[100]) ] MOVE(HMI_ZAxis.Parameters.Positions[0],VerticalAxisMotionParameters.Position) ,[XIC(Status.State[10]) ,XIC(Status.State[19]) ] MOVE(HMI_ZAxis.Parameters.Positions[1],VerticalAxisMotionParameters.Position) ,XIC(Status.State[13]) MOVE(HMI_ZAxis.Parameters.Positions[2],VerticalAxisMotionParameters.Position) ,[XIC(Status.State[22]) ,XIC(Status.State[28]) ] MOVE(HMI_ZAxis.Parameters.Positions[3],VerticalAxisMotionParameters.Position) ,XIC(Status.State[37]) MOVE(HMI_ZAxis.Parameters.Positions[4],VerticalAxisMotionParameters.Position) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[VerticalAxis SPEED PROFILE 0 - SLOW: AutoSpeed[0]/Accel[0]/Decel[0] staged for the slow approach and slow departure segments (state 13 slow into Pick, 19 slow up out of Pick, 37 slow into Place, 28 slow up out of Place).]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(Status.State[1])[XIC(Status.State[13]) ,XIC(Status.State[19]) ,XIC(Status.State[28]) ,XIC(Status.State[37]) ][MOVE(HMI_ZAxis.Parameters.AutoSpeed[0],VerticalAxisMotionParameters.Speed) ,MOVE(HMI_ZAxis.Parameters.Accel[0],VerticalAxisMotionParameters.Accel) ,MOVE(HMI_ZAxis.Parameters.Decel[0],VerticalAxisMotionParameters.Decel) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[VerticalAxis SPEED PROFILE 1 - FAST: AutoSpeed[1]/Accel[1]/Decel[1] staged for the free-air travel segments (7 clear to Retract, 10 fast down to Pick Transition, 22 fast down to Place Transition, 34 and 40 fast to Retract, 100 init retract).]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(Status.State[1])[XIC(Status.State[7]) ,XIC(Status.State[10]) ,XIC(Status.State[22]) ,XIC(Status.State[34]) ,XIC(Status.State[40]) ,XIC(Status.State[100]) ][MOVE(HMI_ZAxis.Parameters.AutoSpeed[1],VerticalAxisMotionParameters.Speed) ,MOVE(HMI_ZAxis.Parameters.Accel[1],VerticalAxisMotionParameters.Accel) ,MOVE(HMI_ZAxis.Parameters.Decel[1],VerticalAxisMotionParameters.Decel) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[VerticalAxis Auto Move Trigger - one shot per move state, unlatched once the MAM is in process/complete so the next state re-triggers the MAM]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) ONS(ZAxisONS.5) ,XIC(Status.State[10]) ONS(ZAxisONS.6) ,XIC(Status.State[13]) ONS(ZAxisONS.7) ,XIC(Status.State[19]) ONS(ZAxisONS.8) ,XIC(Status.State[22]) ONS(ZAxisONS.9) ,XIC(Status.State[28]) ONS(ZAxisONS.10) ,XIC(Status.State[34]) ONS(ZAxisONS.11) ,XIC(Status.State[37]) ONS(ZAxisONS.12) ,XIC(Status.State[40]) ONS(ZAxisONS.13) ,XIC(Status.State[100]) ONS(ZAxisONS.14) ]OTL(VerticalAxisAutoMoveTrig);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Clear VerticalAxis Auto Move Trigger]]>
</Comment>
<Text>
<![CDATA[[XIC(VerticalAxis_MAM.IP) ,XIC(VerticalAxis_MAM.PC) ,XIO(SafetyOK) ,XIC(Status.State[1]) ]OTU(VerticalAxisAutoMoveTrig);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[VerticalAxis Motion Command - gated by the one-shot auto move trigger so consecutive move states re-execute the MAM (states 7,10,13,19,22,28,34,37,40,100)]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)[XIC(Status.State[1]) XIC(ZAxisManMoveTrig) ,XIO(Status.State[1]) XIC(VerticalAxisAutoMoveTrig) ]XIC(iq_ZAxis.ServoActionStatus)XIC(iq_ZAxis.AxisHomedStatus)XIC(ZAxisPermissive)MAM(iq_ZAxis,VerticalAxis_MAM,VerticalAxisMotionParameters.MoveType,VerticalAxisMotionParameters.Position,VerticalAxisMotionParameters.Speed,Units per sec,VerticalAxisMotionParameters.Accel,Units per sec2,VerticalAxisMotionParameters.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Stop axis if permissive turns off while in motion and use max or close to max decel value]]>
</Comment>
<Text>
<![CDATA[XIO(iq_ZAxis.MotionStatus.0)[XIO(ZAxisPermissive) ,XIO(SafetyOK) ]MAS(iq_ZAxis,ZAxis_MAS_All,All,Yes,HMI_ZAxis.Status.MaxDecel,Units per sec2,Yes,10,% of Time);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Set torque]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_ZAxis.Control.SetTorquePos)MOVE(HMI_ZAxis.Parameters.TorquePos,iq_ZAxis.TorqueLimitPositive);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(HMI_ZAxis.Control.SetTorqueNeg)MOVE(HMI_ZAxis.Parameters.TorqueNeg,iq_ZAxis.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Retrieve values from axis]]>
</Comment>
<Text>
<![CDATA[MOVE(iq_ZAxis.ActualPosition,HMI_ZAxis.Status.ActualPosition)MOVE(iq_ZAxis.ActualVelocity,HMI_ZAxis.Status.ActualVelocity)MOVE(iq_ZAxis.TorqueReferenceFiltered,HMI_ZAxis.Status.ActualTorque);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Retrieve the maximum speed value from the axis and calculate max accel and decel.  The max velocity is 85% of full speed.  Equation is based upon 100% speed at a 30ms accel/decel time.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)GSV(Axis,iq_ZAxis,MaximumSpeed,HMI_ZAxis.Status.MaxVelocity)CPT(HMI_ZAxis.Status.MaxAccel,(HMI_ZAxis.Status.MaxVelocity/0.85)/0.03)MOVE(HMI_ZAxis.Status.MaxAccel,HMI_ZAxis.Status.MaxDecel);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[VerticalAxis Position Monitor - Retract/Pick/Place use AOI_RangeCheck; PickTransition/PlaceTransition use an absolute position error (LT 0.5 = in position, LT 5 = wide band) because no further RangeCheck instances exist. Wide bands are placeholders - CE to set from real clearance.]]>
</Comment>
<Text>
<![CDATA[[AOI_RangeCheck(VerticalAxisRetract,HMI_ZAxis.Parameters.Positions[0],0.5,HMI_ZAxis.Status.ActualPosition,5) ,AOI_RangeCheck(VerticalAxisPick,HMI_ZAxis.Parameters.Positions[2],0.5,HMI_ZAxis.Status.ActualPosition,5) ,AOI_RangeCheck(VerticalAxisPlace,HMI_ZAxis.Parameters.Positions[4],0.5,HMI_ZAxis.Status.ActualPosition,5) ,SUB(HMI_ZAxis.Status.ActualPosition,HMI_ZAxis.Parameters.Positions[1],VerticalAxisPickTransError) ABS(VerticalAxisPickTransError,VerticalAxisPickTransError) ,SUB(HMI_ZAxis.Status.ActualPosition,HMI_ZAxis.Parameters.Positions[3],VerticalAxisPlaceTransError) ABS(VerticalAxisPlaceTransError,VerticalAxisPlaceTransError) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[X Axis Servo Drive Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)NE(iq_XAxis.AxisFault,0)[OTE(ServoAlarm[0].Active) ,ONS(ONS.5) DTOS(iq_XAxis.AxisFault,XAxisFault) CONCAT(g_StationList[StaNum],ServoAlarmList[0],XAxisFaultMessage) CONCAT(XAxisFaultMessage,XAxisFault,ServoAlarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[X Axis Absolute Position Reference Lost - Rehome Required]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)XIC(g_MachineBasic.PowerUpCP)XIO(iq_XAxis.AxisHomedStatus)[OTE(ServoAlarm[1].Active) ,ONS(ONS.6) CONCAT(g_StationList[StaNum],ServoAlarmList[1],ServoAlarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Z Axis Servo Drive Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)NE(iq_ZAxis.AxisFault,0)[OTE(ServoAlarm[2].Active) ,ONS(ONS.7) DTOS(iq_ZAxis.AxisFault,ZAxisFault) CONCAT(g_StationList[StaNum],ServoAlarmList[2],ZAxisFaultMessage) CONCAT(ZAxisFaultMessage,ZAxisFault,ServoAlarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Z Axis Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)XIC(g_MachineBasic.PowerUpCP)XIO(iq_ZAxis.AxisHomedStatus)[OTE(ServoAlarm[3].Active) ,ONS(ONS.8) CONCAT(g_StationList[StaNum],ServoAlarmList[3],ServoAlarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[X Axis quickstop warning]]>
</Comment>
<Text>
<![CDATA[[XIC(XAxis_MAS_All.EN) ONS(ONS.29) ,XIC(ServoAlarm[4].Active) XIO(FaultReset) ][OTE(ServoAlarm[4].Active) ,XIO(VerticalAxisRetract.InPos) XIO(VerticalAxisRetract.InPosWide) CONCAT(g_StationList[StaNum],ZAxisQuickstopMessageA,ZAxisQuickstopMessageB) CONCAT(ZAxisQuickstopMessageB,ZAxisQuickstopReason,ServoAlarm[4].Message) ,MOVE(1,ServoAlarm[4].Severity) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For VerticalAxis Retract And HorizontalAxis In-Between Move (states 7, 100, 103)]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[7]) ,XIC(Status.State[100]) ,XIC(Status.State[103]) ] MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset) ][OTE(Alarm[0].Active) ,ONS(ONS.9) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For HorizontalAxis Pick And VerticalAxis Pick Approach Moves (states 10, 13)]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[10]) ,XIC(Status.State[13]) ] MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset) ][OTE(Alarm[1].Active) ,ONS(ONS.10) CONCAT(g_StationList[StaNum],AlarmList[1],Alarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Gripper Close Delay To Complete (state 16)]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,ONS(ONS.11) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Place Path Moves To Complete (states 19, 34, 22, 37)]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[19]) ,XIC(Status.State[34]) ,XIC(Status.State[22]) ,XIC(Status.State[37]) ] MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset) ][OTE(Alarm[3].Active) ,ONS(ONS.12) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Gripper Open And Return Moves (states 25, 28, 40)]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[25]) ,XIC(Status.State[28]) ,XIC(Status.State[40]) ] MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset) ][OTE(Alarm[4].Active) ,ONS(ONS.13) CONCAT(g_StationList[StaNum],AlarmList[4],Alarm[4].Message) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Waiting For Supervisor Acknowledge Of Station Complete (state 31) - warning + q_Pause, not a hard fault]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[31]) MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[5].Active) XIO(FaultReset) ][OTE(Alarm[5].Active) ,ONS(ONS.14) MOVE(1,Alarm[5].Severity) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Idle/ready wait at state 4 has no fault timer]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(0,Control.FaultTime);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Servo Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ServoFaultHandler,\Alarms.p_ProgramID,ServoAlarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,ServoAlarmActive,ServoWarningActive);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Station Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,AlarmActive,WarningActive);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Alarm/Warning Active Outputs]]>
</Comment>
<Text>
<![CDATA[[XIC(ServoAlarmActive) ,XIC(AlarmActive) ]OTE(q_AlarmActive);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(ServoWarningActive) ,XIC(WarningActive) ]OTE(q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Use="Context" Name="Supervisor" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="q_CycleStartLatch">
</Tag>
<Tag Use="Reference" Name="q_CycleStopped">
</Tag>
<Tag Use="Reference" Name="q_FaultReset">
</Tag>
<Tag Use="Reference" Name="q_ManualMode">
</Tag>
<Tag Use="Reference" Name="q_SafetyOK">
</Tag>
</Tags>
</Program>
<Program Use="Context" Name="Tracking" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="p_Data">
</Tag>
</Tags>
</Program>
</Programs>
<ParameterConnections Use="Context">
<ParameterConnection EndPoint1="\S01_SDCServoPNP.iq_XAxis" EndPoint2="a03_S01PNPXAxis"/>
<ParameterConnection EndPoint1="\S01_SDCServoPNP.iq_ZAxis" EndPoint2="a04_S01PNPZAxis"/>
</ParameterConnections>
</Controller>
</RSLogix5000Content>
