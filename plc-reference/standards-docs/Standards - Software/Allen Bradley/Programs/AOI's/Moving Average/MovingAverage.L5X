<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(* Ensure WindowSize is within buffer range *)]]>
</Line>
<Line Number="1">
<![CDATA[IF WindowSize > 100 THEN]]>
</Line>
<Line Number="2">
<![CDATA[    WindowSize := 100;]]>
</Line>
<Line Number="3">
<![CDATA[ELSIF WindowSize < 1 THEN]]>
</Line>
<Line Number="4">
<![CDATA[    WindowSize := 1;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[(* Remove the oldest value *)]]>
</Line>
<Line Number="8">
<![CDATA[Sum := Sum - Buffer[Index];]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[(* Store new value in buffer *)]]>
</Line>
<Line Number="11">
<![CDATA[Buffer[Index] := Input;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[(* Add new value to sum *)]]>
</Line>
<Line Number="14">
<![CDATA[Sum := Sum + Input;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[(* Update sample count (until full) *)]]>
</Line>
<Line Number="17">
<![CDATA[IF Count < WindowSize THEN]]>
</Line>
<Line Number="18">
<![CDATA[    Count := Count + 1;]]>
</Line>
<Line Number="19">
<![CDATA[END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[(* Compute average *)]]>
</Line>
<Line Number="22">
<![CDATA[Average := Sum / Count;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[(* Increment and wrap buffer index *)]]>
</Line>
<Line Number="25">
<![CDATA[Index := (Index + 1) MOD WindowSize;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
