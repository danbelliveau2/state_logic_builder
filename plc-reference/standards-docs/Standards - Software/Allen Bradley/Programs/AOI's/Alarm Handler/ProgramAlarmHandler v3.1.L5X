<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[PublicProgramIDTag := PublicProgramIDTag + 1;]]>
</Line>
<Line Number="1">
<![CDATA[MyProgramID := PublicProgramIDTag;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[SIZE(AlarmActiveArrayTag, 0, AlarmsActive_size);]]>
</Line>
<Line Number="4">
<![CDATA[SIZE(AlarmHistoryArrayTag, 0, AlarmsHistory_size);]]>
</Line>
<Line Number="5">
<![CDATA[SIZE(LocalAlarmsArrayTag, 0, AlarmsLocal_size);]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[if (ControllerTimeClockTag.Seconds <> prevSecond) then]]>
</Line>
<Line Number="8">
<![CDATA[	prevSecond := ControllerTimeClockTag.Seconds;]]>
</Line>
<Line Number="9">
<![CDATA[	OneSecond := 1;]]>
</Line>
<Line Number="10">
<![CDATA[else]]>
</Line>
<Line Number="11">
<![CDATA[	OneSecond := 0;]]>
</Line>
<Line Number="12">
<![CDATA[end_if;]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[//Check the active alarm array for alarms from this AOI's AlarmData array]]>
</Line>
<Line Number="15">
<![CDATA[for ActiveIndex := 0 to AlarmsActive_size - 1 by 1 do]]>
</Line>
<Line Number="16">
<![CDATA[	if (AlarmActiveArrayTag[ActiveIndex].ProgramID = PublicProgramIDTag) then]]>
</Line>
<Line Number="17">
<![CDATA[		//Alarm came from this AOI's AlarmData array]]>
</Line>
<Line Number="18">
<![CDATA[		DataIndex := AlarmActiveArrayTag[ActiveIndex].AlarmID;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[		if ((DataIndex < 0) OR (DataIndex >= AlarmsLocal_size)) then]]>
</Line>
<Line Number="21">
<![CDATA[			//This was bad data. Index out of range. So to prevent CPU fault,]]>
</Line>
<Line Number="22">
<![CDATA[			//erase the data just like below.]]>
</Line>
<Line Number="23">
<![CDATA[			//Shift the active list up to cover the inactive alarm]]>
</Line>
<Line Number="24">
<![CDATA[			tempLength := AlarmsActive_size - 1 - ActiveIndex;]]>
</Line>
<Line Number="25">
<![CDATA[			if (tempLength > 0) then]]>
</Line>
<Line Number="26">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex + 1], AlarmActiveArrayTag[ActiveIndex], tempLength);]]>
</Line>
<Line Number="27">
<![CDATA[			end_if;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[			//Clear the last record]]>
</Line>
<Line Number="30">
<![CDATA[			COP(EmptyAlarmData, AlarmActiveArrayTag[AlarmsActive_size - 1], 1);]]>
</Line>
<Line Number="31">
<![CDATA[			exit; //This is an anomaly so exit this for loop and it'll fix itself next scan.]]>
</Line>
<Line Number="32">
<![CDATA[		end_if;]]>
</Line>
<Line Number="33">
<![CDATA[		]]>
</Line>
<Line Number="34">
<![CDATA[		if (OneSecond) then]]>
</Line>
<Line Number="35">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Duration := LocalAlarmsArrayTag[DataIndex].Duration +1;]]>
</Line>
<Line Number="36">
<![CDATA[			AlarmActiveArrayTag[ActiveIndex].Duration := AlarmActiveArrayTag[ActiveIndex].Duration +1;]]>
</Line>
<Line Number="37">
<![CDATA[		end_if;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[		if (NOT LocalAlarmsArrayTag[DataIndex].Active) then]]>
</Line>
<Line Number="40">
<![CDATA[			//Alarm is no longer active so copy to history and clear from the active list.]]>
</Line>
<Line Number="41">
<![CDATA[			]]>
</Line>
<Line Number="42">
<![CDATA[			if (NOT LocalAlarmsArrayTag[DataIndex].DoNotSaveToHistory) then]]>
</Line>
<Line Number="43">
<![CDATA[				//Shift the history down]]>
</Line>
<Line Number="44">
<![CDATA[				for ShiftIter := AlarmsHistory_size - 2 to 0 by -1 do]]>
</Line>
<Line Number="45">
<![CDATA[					COP(AlarmHistoryArrayTag[ShiftIter], AlarmHistoryArrayTag[ShiftIter + 1], 1);]]>
</Line>
<Line Number="46">
<![CDATA[				end_for;]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[				//Copy the data over]]>
</Line>
<Line Number="49">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex], AlarmHistoryArrayTag[0], 1);]]>
</Line>
<Line Number="50">
<![CDATA[			end_if;]]>
</Line>
<Line Number="51">
<![CDATA[			//Shift the active list up to cover the inactive alarm]]>
</Line>
<Line Number="52">
<![CDATA[			tempLength := AlarmsActive_size - 1 - ActiveIndex;]]>
</Line>
<Line Number="53">
<![CDATA[			if (ActiveIndex < (AlarmsActive_size - 1)) then]]>
</Line>
<Line Number="54">
<![CDATA[				//Skip the shift up if the last alarm in the list is no longer active]]>
</Line>
<Line Number="55">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex + 1], AlarmActiveArrayTag[ActiveIndex], tempLength);]]>
</Line>
<Line Number="56">
<![CDATA[			end_if;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[			//Clear the last record]]>
</Line>
<Line Number="59">
<![CDATA[			COP(EmptyAlarmData, AlarmActiveArrayTag[AlarmsActive_size - 1], 1);]]>
</Line>
<Line Number="60">
<![CDATA[		end_if;]]>
</Line>
<Line Number="61">
<![CDATA[]]>
</Line>
<Line Number="62">
<![CDATA[	end_if;]]>
</Line>
<Line Number="63">
<![CDATA[end_for;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[FaultActiveTag := 0;]]>
</Line>
<Line Number="66">
<![CDATA[WarningActiveTag := 0;]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[for DataIndex := 0 to AlarmsLocal_size - 1 by 1 do]]>
</Line>
<Line Number="69">
<![CDATA[	//Loop through each alarm in the data array]]>
</Line>
<Line Number="70">
<![CDATA[	if (LocalAlarmsArrayTag[DataIndex].Active) then]]>
</Line>
<Line Number="71">
<![CDATA[		]]>
</Line>
<Line Number="72">
<![CDATA[		//The alarm is active]]>
</Line>
<Line Number="73">
<![CDATA[		If (LocalAlarmsArrayTag[DataIndex].Severity MOD 0 = 0) Then]]>
</Line>
<Line Number="74">
<![CDATA[			FaultActiveTag := 1;]]>
</Line>
<Line Number="75">
<![CDATA[		End_If;]]>
</Line>
<Line Number="76">
<![CDATA[		If (LocalAlarmsArrayTag[DataIndex].Severity MOD 1 = 0) Then]]>
</Line>
<Line Number="77">
<![CDATA[			WarningActiveTag := 1;]]>
</Line>
<Line Number="78">
<![CDATA[		End_If;]]>
</Line>
<Line Number="79">
<![CDATA[		]]>
</Line>
<Line Number="80">
<![CDATA[		//Update informational outputs.]]>
</Line>
<Line Number="81">
<![CDATA[		//Only update if no previous alarm was found.]]>
</Line>
<Line Number="82">
<![CDATA[		//This will give priority to the first alarm triggered or the lower-indexed alarm if they're triggered within the same scan.]]>
</Line>
<Line Number="83">
<![CDATA[		if (ActiveAlarmArrayIndex = 9999) Then]]>
</Line>
<Line Number="84">
<![CDATA[			ActiveAlarmArrayIndex := DataIndex;]]>
</Line>
<Line Number="85">
<![CDATA[			ActiveAlarmDuration := LocalAlarmsArrayTag[DataIndex].Duration;]]>
</Line>
<Line Number="86">
<![CDATA[		End_If;]]>
</Line>
<Line Number="87">
<![CDATA[		]]>
</Line>
<Line Number="88">
<![CDATA[		for ActiveIndex := 0 to AlarmsActive_size - 1 by 1 do]]>
</Line>
<Line Number="89">
<![CDATA[			//Check if it's already in the active array]]>
</Line>
<Line Number="90">
<![CDATA[			if ((AlarmActiveArrayTag[ActiveIndex].ProgramID = PublicProgramIDTag) AND (AlarmActiveArrayTag[ActiveIndex].AlarmID = DataIndex)) then]]>
</Line>
<Line Number="91">
<![CDATA[				//Found it! So exit the for loop]]>
</Line>
<Line Number="92">
<![CDATA[				exit;]]>
</Line>
<Line Number="93">
<![CDATA[			end_if;]]>
</Line>
<Line Number="94">
<![CDATA[		end_for;]]>
</Line>
<Line Number="95">
<![CDATA[		if ((ActiveIndex > AlarmsActive_size - 1) AND NOT AlarmActiveArrayTag[AlarmsActive_size - 1].Active) then]]>
</Line>
<Line Number="96">
<![CDATA[			//Didn't find it! So add the new active alarm. (only if the active array is not already full)]]>
</Line>
<Line Number="97">
<![CDATA[			//(if the array is full the list will constantly cycle alarms, making it unreadable on the HMI)]]>
</Line>
<Line Number="98">
<![CDATA[]]>
</Line>
<Line Number="99">
<![CDATA[			//Update the local AlarmData information of the newly triggered alarm]]>
</Line>
<Line Number="100">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].ProgramID := PublicProgramIDTag;]]>
</Line>
<Line Number="101">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].AlarmID := DataIndex;]]>
</Line>
<Line Number="102">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].TimeStamp := ControllerTimeClockTag.UTCMicroseconds;]]>
</Line>
<Line Number="103">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Duration := 0;]]>
</Line>
<Line Number="104">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Count := LocalAlarmsArrayTag[DataIndex].Count +1;]]>
</Line>
<Line Number="105">
<![CDATA[]]>
</Line>
<Line Number="106">
<![CDATA[			for ActiveIndex := 0 to AlarmsActive_size - 2 by 1 do]]>
</Line>
<Line Number="107">
<![CDATA[				//Find the alarm's place in the list based on its severity (we already know the last slot is empty so don't need to check it)]]>
</Line>
<Line Number="108">
<![CDATA[				if ((NOT AlarmActiveArrayTag[ActiveIndex].Active) OR (AlarmActiveArrayTag[ActiveIndex].Severity MOD 200 >= LocalAlarmsArrayTag[DataIndex].Severity MOD 200)) then]]>
</Line>
<Line Number="109">
<![CDATA[					//Found an empty slot or "lower" severity alarm. "a" version of this AOI is for system using severity to separate sections of the machine.]]>
</Line>
<Line Number="110">
<![CDATA[					exit;]]>
</Line>
<Line Number="111">
<![CDATA[				end_if;]]>
</Line>
<Line Number="112">
<![CDATA[			end_for;]]>
</Line>
<Line Number="113">
<![CDATA[]]>
</Line>
<Line Number="114">
<![CDATA[			//Shift the "lower" severity alarms down the stack]]>
</Line>
<Line Number="115">
<![CDATA[			for ShiftIter := AlarmsActive_size - 2 to ActiveIndex by -1 do]]>
</Line>
<Line Number="116">
<![CDATA[				COP(AlarmActiveArrayTag[ShiftIter], AlarmActiveArrayTag[ShiftIter + 1], 1);]]>
</Line>
<Line Number="117">
<![CDATA[			end_for;]]>
</Line>
<Line Number="118">
<![CDATA[			//Copy the new data into the active list]]>
</Line>
<Line Number="119">
<![CDATA[			COP(LocalAlarmsArrayTag[DataIndex], AlarmActiveArrayTag[ActiveIndex], 1);]]>
</Line>
<Line Number="120">
<![CDATA[		end_if;]]>
</Line>
<Line Number="121">
<![CDATA[	end_if;]]>
</Line>
<Line Number="122">
<![CDATA[end_for;]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[if (NOT FaultActiveTag AND NOT WarningActiveTag) then]]>
</Line>
<Line Number="125">
<![CDATA[	//No active alarms found]]>
</Line>
<Line Number="126">
<![CDATA[	ActiveAlarmArrayIndex := 9999;]]>
</Line>
<Line Number="127">
<![CDATA[	ActiveAlarmDuration := 0;]]>
</Line>
<Line Number="128">
<![CDATA[end_if;]]>
</Line>
<Line Number="129">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="AlarmData"/>
<Dependency Type="DataType" Name="CPU_TimeDate"/>
</Dependencies>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
