<LocalTag Name="TotalShiftTime" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Total shift time in minutes]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[480]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="480"/>
</DefaultData>
