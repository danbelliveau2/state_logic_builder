<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// --- Availability Calculation ---]]>
</Line>
<Line Number="1">
<![CDATA[IF (RunTime + Downtime) > 0 THEN]]>
</Line>
<Line Number="2">
<![CDATA[    Availability := RunTime / (RunTime+Downtime);]]>
</Line>
<Line Number="3">
<![CDATA[	Availability := Availability / (PlannedProductionTime/TotalShiftTime);]]>
</Line>
<Line Number="4">
<![CDATA[ELSE]]>
</Line>
<Line Number="5">
<![CDATA[    Availability := 0.0;]]>
</Line>
<Line Number="6">
<![CDATA[END_IF;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[// --- Performance Calculation ---]]>
</Line>
<Line Number="9">
<![CDATA[IF (RunTime + Downtime) > 0 AND TotalCount > 0 THEN]]>
</Line>
<Line Number="10">
<![CDATA[    TotalIdealTime := IdealCycleTime * TotalCount;]]>
</Line>
<Line Number="11">
<![CDATA[    Performance := TotalIdealTime / RunTime;]]>
</Line>
<Line Number="12">
<![CDATA[ELSE]]>
</Line>
<Line Number="13">
<![CDATA[    Performance := 0.0;]]>
</Line>
<Line Number="14">
<![CDATA[END_IF;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[// --- Quality Calculation ---]]>
</Line>
<Line Number="17">
<![CDATA[IF TotalCount > 0 THEN]]>
</Line>
<Line Number="18">
<![CDATA[    Quality := GoodCount / TotalCount;]]>
</Line>
<Line Number="19">
<![CDATA[ELSE]]>
</Line>
<Line Number="20">
<![CDATA[    Quality := 0.0;]]>
</Line>
<Line Number="21">
<![CDATA[END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[// --- OEE Calculation ---]]>
</Line>
<Line Number="24">
<![CDATA[OEE := Availability * Performance * Quality;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
