<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R04_IndexerServo,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R10_CalcDialStationNestNums,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station Number]]>
</Comment>
<Text>
<![CDATA[MOVE(0,StaNum);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Dial On Station]]>
</Comment>
<Text>
<![CDATA[MOD(iq_IndexerAxis.ActualPosition,1.0,DialPosRmndr)[LE(DialPosRmndr,OnStationTolNests) ,SUB(1.0,OnStationTolNests,OnStaTol1Minus) GE(DialPosRmndr,OnStaTol1Minus) ]OTE(p_OnStation);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[All Stations Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])TON(StationsCompleteDelay,?,?)XIC(StationsCompleteDelay.DN)XIC(\S01_PartLoad.q_StationComplete)XIC(\S03_PartLoad.q_StationComplete)XIC(\S04_PartVerify.q_StationComplete)XIC(\S05_ServoPNP.q_StationComplete)XIC(\S18_RejectUnload.q_StationComplete)XIC(\S19_GoodUnload.q_StationComplete)ONS(ONS.6)OTE(StationsComplete);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[All Actuators Safe]]>
</Comment>
<Text>
<![CDATA[XIC(\S01_PartLoad.q_ActuatorsSafe)XIC(\S03_PartLoad.q_ActuatorsSafe)XIC(\S04_PartVerify.q_ActuatorsSafe)XIC(\S05_ServoPNP.q_ActuatorsSafe)XIC(\S18_RejectUnload.q_ActuatorsSafe)XIC(\S19_GoodUnload.q_ActuatorsSafe)OTE(ActuatorsSafe);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Move The Indexer Into Pause]]>
</Comment>
<Text>
<![CDATA[[XIC(\S01_PartLoad.q_Pause) MOVE(1,PauseReason) ,XIC(\S03_PartLoad.q_Pause) MOVE(2,PauseReason) ,XIC(\S05_ServoPNP.q_Pause) MOVE(3,PauseReason) ]OTE(Pause);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(p_OnStation)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[4]) ,XIC(Status.State[40]) ,XIC(Status.State[42]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Wait For All Stations Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[22]) ,XIC(Status.State[42]) MOVE(2000,Control.TransitionTime) XIC(Status.TransitionTimerDone) ]XIC(CycleRunning)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 10: Check Actuators In Safe Position]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) XIC(StationsComplete) ,XIC(Status.State[2]) XIO(Initialized) XIO(p_OnStation) XIC(CycleRunning) ]XIC(SS_OK)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 13: Trigger Index]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) XIC(ActuatorsSafe) ,XIC(Status.State[37]) ][XIC(i_EmptyNest) ,XIO(p_OnStation) ]XIC(SS_OK)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 16: Wait For Index Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(IndexerAxis_MAM.IP)XIO(p_OnStation)MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 22: Index Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) XIC(IndexerAxis_MAM.PC) ,XIC(Status.State[2]) XIO(Initialized) XIC(CycleRunning) ]XIC(p_OnStation)XIC(SS_OK)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 31: Actuators NOT Safe During Index - Wait For Indexer Motion Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) ,XIC(Status.State[16]) ]XIO(ActuatorsSafe)MOVE(31,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 34: Check If Actuators Safe After Stop]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[31])XIC(IndexerAxis_MAS_All.PC)XIO(IndexerAxis_MAM.IP)XIO(iq_IndexerAxis.MoveStatus)MOVE(34,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 37: Restart Ok]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[34])XIC(ActuatorsSafe)TON(State34Delay,?,?)XIC(State34Delay.DN)MOVE(37,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 40: Paused]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIO(StationsComplete)XIC(Pause)MOVE(40,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 42: Pause Restart]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[40])XIO(Pause)TON(State40Delay,?,?)XIC(State40Delay.DN)MOVE(42,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,98) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Last Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,98) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[25 Cycle Average]]>
</Comment>
<Text>
<![CDATA[MovingAverage(MovingAverageA,p_CycleTime,25);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[100 Cycle Average]]>
</Comment>
<Text>
<![CDATA[MovingAverage(MovingAverageB,p_CycleTime,100);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor]]>
</Comment>
<Text>
<![CDATA[XIC(iq_IndexerAxis.ServoActionStatus)XIC(iq_IndexerAxis.AxisHomedStatus)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Status.State[4])XIC(p_OnStation)OTE(q_WaitStationsComplete);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(Status.State[40]) ,XIC(Status.State[42]) ]OTE(q_Paused);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Status.State[42])OTE(q_PauseRestart);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Record Ok To Index For Each Station
***Used to Determine Stations With Longest Cycle Times***]]>
</Comment>
<Text>
<![CDATA[XIC(\S01_PartLoad.q_StationComplete)ONS(ONS.7)DIV(CycleTimer.ACC,1000,StationCompleteTimes[1]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(\S03_PartLoad.q_StationComplete)ONS(ONS.8)DIV(CycleTimer.ACC,1000,StationCompleteTimes[3]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(\S04_PartVerify.q_StationComplete)ONS(ONS.9)DIV(CycleTimer.ACC,1000,StationCompleteTimes[4]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(\S05_ServoPNP.q_StationComplete)ONS(ONS.24)DIV(CycleTimer.ACC,1000,StationCompleteTimes[5]);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(\S18_RejectUnload.q_StationComplete)ONS(ONS.25)DIV(CycleTimer.ACC,1000,StationCompleteTimes[18]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(\S19_GoodUnload.q_StationComplete)ONS(ONS.26)DIV(CycleTimer.ACC,1000,StationCompleteTimes[19]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R04_IndexerServo" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Axis Is Ready For Operation]]>
</Comment>
<Text>
<![CDATA[XIC(MotionGroup.GroupSynced)XIO(iq_IndexerAxis.SafeTorqueOffActiveInhibit)OTE(IndexerAxisReady);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(SafetyOK)XIC(IndexerAxisReady)TON(IndexerAxisEnableDelay,?,?)XIC(IndexerAxisEnableDelay.DN)ONS(IndexerAxisONS.0)OTE(IndexerAxisAutoEnable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Axis Motion Permissive (Add more conditions if necessary. Permissive should be based on the physical state of itself potentially interfering devices)]]>
</Comment>
<Text>
<![CDATA[XIC(ActuatorsSafe)OTE(IndexerAxisPermissive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) XIC(HMI_IndexerAxis.Control.Enable) XIC(IndexerAxisReady) ,XIC(IndexerAxisAutoEnable) ]XIO(iq_IndexerAxis.ServoActionStatus)MSO(iq_IndexerAxis,IndexerAxis_MSO);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(HMI_IndexerAxis.Control.Disable)MSF(iq_IndexerAxis,IndexerAxis_MSF);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fault Reset Axis]]>
</Comment>
<Text>
<![CDATA[NE(iq_IndexerAxis.AxisFault,0)XIC(FaultReset)[XIO(iq_IndexerAxis.ShutdownStatus) MAFR(iq_IndexerAxis,IndexerAxis_MAFR) ,XIC(iq_IndexerAxis.ShutdownStatus) MASR(iq_IndexerAxis,IndexerAxis_MASR) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Jog Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(IndexerAxisPermissive)XIC(iq_IndexerAxis.ServoActionStatus)XIO(iq_IndexerAxis.JogStatus)XIO(iq_IndexerAxis.MoveStatus)[XIC(HMI_IndexerAxis.Control.JogPositive) XIO(HMI_IndexerAxis.Control.JogNegative) MOVE(0,IndexerAxisJogDirection) ,XIC(HMI_IndexerAxis.Control.JogNegative) XIO(HMI_IndexerAxis.Control.JogPositive) MOVE(1,IndexerAxisJogDirection) ]MAJ(iq_IndexerAxis,IndexerAxis_MAJ,IndexerAxisJogDirection,HMI_IndexerAxis.Parameters.JogSpeed,Units per sec,HMI_IndexerAxis.Parameters.Accel[0],Units per sec2,HMI_IndexerAxis.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per MasterUnit3,Disabled,0,0,None);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(IndexerAxis_MAJ.IP)XIO(HMI_IndexerAxis.Control.JogPositive)XIO(HMI_IndexerAxis.Control.JogNegative)MAS(iq_IndexerAxis,IndexerAxis_MAS_Jog,Jog,Yes,HMI_IndexerAxis.Parameters.Decel[0],Units per sec2,No,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Inch Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_IndexerAxis.Control.InchPositive) ONS(IndexerAxisONS.1) MOVE(HMI_IndexerAxis.Parameters.InchAmount,IndexerAxisInchAmount) ,XIC(HMI_IndexerAxis.Control.InchNegative) ONS(IndexerAxisONS.2) NEG(HMI_IndexerAxis.Parameters.InchAmount,IndexerAxisInchAmount) ]XIC(IndexerAxisPermissive)XIC(iq_IndexerAxis.ServoActionStatus)XIO(iq_IndexerAxis.JogStatus)XIO(iq_IndexerAxis.MoveStatus)MAM(iq_IndexerAxis,IndexerAxis_Inch,1,IndexerAxisInchAmount,HMI_IndexerAxis.Parameters.ManualSpeed,Units per sec,HMI_IndexerAxis.Parameters.Accel[0],Units per sec2,HMI_IndexerAxis.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Home Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_IndexerAxis.Control.HomeRequest) ONS(IndexerAxisONS.3) XIO(IndexerAxisTorqueHome.IP) ,XIC(IndexerAxisHomeRequested) XIO(IndexerAxisHomeConfirmDelay.DN) XIO(IndexerAxisHomeConfimed) ]XIC(IndexerAxisReady)[OTE(IndexerAxisHomeRequested) ,TON(IndexerAxisHomeConfirmDelay,?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_IndexerAxis.Control.HomeConfirm) ONS(IndexerAxisONS.4) ,XIC(IndexerAxisHomeConfimed) XIC(IndexerAxisHomeSelect) XIO(IndexerAxisTorqueHome.PC) XIO(IndexerAxisTorqueHome.Error) ]OTE(IndexerAxisHomeConfimed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Home Select = 0 is for Immediate Home (Example, servo indexer)
Home Select = 1 is for Home To Torque (Example, PNP)

Homing Torque = Start at 25%, Increase In 5% Increments If Not Enough
Run Torque = Normal Running Torque Of Axis
Homing Speed = Homing Speed in units/s
Overtorque Limit = Set The Same As Homing Torque
Home Offset Distance = Distance Moved Off Of Hard Stop When Homing Complete
Home Direction = 0 Is Positive, 1 Is Negative]]>
</Comment>
<Text>
<![CDATA[XIC(IndexerAxisHomeConfimed)[XIO(IndexerAxisHomeSelect) MAH(iq_IndexerAxis,IndexerAxis_MAH) ,XIC(IndexerAxisHomeSelect) AOI_TorqueHome(IndexerAxisTorqueHome,iq_IndexerAxis,25.0,100.0,5.0,25.0,0.5,1) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(IndexerAxisHomeRequested) OTE(HMI_IndexerAxis.Status.HomeRequested) ,[XIC(IndexerAxisTorqueHome.IP) ,XIC(IndexerAxis_MAH.IP) ] OTE(HMI_IndexerAxis.Status.HomeInProcess) ,[XIC(IndexerAxisTorqueHome.PC) ,XIC(IndexerAxis_MAH.PC) ] OTE(HMI_IndexerAxis.Status.HomeComplete) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIC(Status.State[1])[[MOVE(HMI_IndexerAxis.Parameters.ManualSpeed,IndexerAxisMotionParameters.Speed) ,MOVE(HMI_IndexerAxis.Parameters.Accel[0],IndexerAxisMotionParameters.Accel) ,MOVE(HMI_IndexerAxis.Parameters.Decel[0],IndexerAxisMotionParameters.Decel) ] ,XIC(IndexerAxisPermissive) XIC(HMI_IndexerAxis.Control.ManMoves.0) ONS(ONS.5) [[XIO(p_OnStation) ,XIC(p_OnStation) LE(DialPosRmndr,OnStationTolNests) ] SUB(1.0,DialPosRmndr,IndexerAxisMotionParameters.Position) ,XIC(p_OnStation) GE(DialPosRmndr,OnStaTol1Minus) CPT(IndexerAxisMotionParameters.Position,1.0 + (1.0-DialPosRmndr)) ] OTE(IndexerAxisManMoveTrig) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Auto Mode]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)XIO(Status.State[1])[MOVE(1,IndexerAxisMotionParameters.MoveType) ,MOVE(HMI_IndexerAxis.Parameters.AutoSpeed[0],IndexerAxisMotionParameters.Speed) ,MOVE(HMI_IndexerAxis.Parameters.Accel[0],IndexerAxisMotionParameters.Accel) ,MOVE(HMI_IndexerAxis.Parameters.Decel[0],IndexerAxisMotionParameters.Decel) ,XIC(Status.State[13]) [[XIO(p_OnStation) ,XIC(p_OnStation) LE(DialPosRmndr,OnStationTolNests) ] SUB(1.0,DialPosRmndr,IndexerAxisMotionParameters.Position) ,XIC(p_OnStation) GE(DialPosRmndr,OnStaTol1Minus) CPT(IndexerAxisMotionParameters.Position,1.0 + (1.0-DialPosRmndr)) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Axis Motion Command]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)[XIC(Status.State[1]) XIC(IndexerAxisManMoveTrig) ,XIO(Status.State[1]) XIC(Status.State[13]) ]XIC(iq_IndexerAxis.ServoActionStatus)XIC(iq_IndexerAxis.AxisHomedStatus)XIC(IndexerAxisPermissive)MAM(iq_IndexerAxis,IndexerAxis_MAM,IndexerAxisMotionParameters.MoveType,IndexerAxisMotionParameters.Position,IndexerAxisMotionParameters.Speed,Units per sec,IndexerAxisMotionParameters.Accel,Units per sec2,IndexerAxisMotionParameters.Decel,Units per sec2,S-Curve,75,75,% of Time,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Stop axis if permissive turns off while in motion and use max or close to max decel value]]>
</Comment>
<Text>
<![CDATA[XIO(iq_IndexerAxis.MotionStatus.0)[XIO(IndexerAxisPermissive) ,XIO(SafetyOK) ]MAS(iq_IndexerAxis,IndexerAxis_MAS_All,All,Yes,HMI_IndexerAxis.Status.MaxDecel,Units per sec2,Yes,10,% of Time);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Set torque]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_IndexerAxis.Control.SetTorquePos)MOVE(HMI_IndexerAxis.Parameters.TorquePos,iq_IndexerAxis.TorqueLimitPositive);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(HMI_IndexerAxis.Control.SetTorqueNeg)MOVE(HMI_IndexerAxis.Parameters.TorqueNeg,iq_IndexerAxis.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Retrieve values from axis]]>
</Comment>
<Text>
<![CDATA[MOVE(iq_IndexerAxis.ActualPosition,HMI_IndexerAxis.Status.ActualPosition)MOVE(iq_IndexerAxis.ActualVelocity,HMI_IndexerAxis.Status.ActualVelocity)MOVE(iq_IndexerAxis.TorqueReferenceFiltered,HMI_IndexerAxis.Status.ActualTorque);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Retrieve the maximum speed value from the axis and calculate max accel and decel.  The max velocity is 85% of full speed.  Equation is based upon 100% speed at a 100ms accel/decel time.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)GSV(Axis,iq_IndexerAxis,MaximumSpeed,HMI_IndexerAxis.Status.MaxVelocity)CPT(HMI_IndexerAxis.Status.MaxAccel,(HMI_IndexerAxis.Status.MaxVelocity/0.85)/0.1)MOVE(HMI_IndexerAxis.Status.MaxAccel,HMI_IndexerAxis.Status.MaxDecel);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R10_CalcDialStationNestNums" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Set nest_Num for all the Stations]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[NewNestNum := ((TRUNC(iq_IndexerAxis.ActualPosition + OnStationTolNests) + (\Tracking.p_NestQty - 1)) MOD \Tracking.p_NestQty) + 1;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[IF (\Tracking.p_Data.Station[1].NestNum = NewNestNum) THEN]]>
</Line>
<Line Number="5">
<![CDATA[	NestsShiftedPulse := 0;]]>
</Line>
<Line Number="6">
<![CDATA[ELSE]]>
</Line>
<Line Number="7">
<![CDATA[	\Tracking.p_Data.Station[1].NestNum := NewNestNum;]]>
</Line>
<Line Number="8">
<![CDATA[	NestsShiftedPulse := 1;]]>
</Line>
<Line Number="9">
<![CDATA[END_IF;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[FOR StationNum := 1 TO \Tracking.p_NestQty by 1 DO]]>
</Line>
<Line Number="12">
<![CDATA[	\Tracking.p_Data.Station[StationNum].NestNum := (NewNestNum - StationNum + \Tracking.p_NestQty) MOD \Tracking.p_NestQty + 1;]]>
</Line>
<Line Number="13">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Indexer Axis Servo Drive Is Faulted]]>
</Comment>
<Text>
<![CDATA[NE(iq_IndexerAxis.AxisFault,0)[OTE(ServoAlarm[0].Active) ,ONS(ONS.10) DTOS(iq_IndexerAxis.AxisFault,IndexerAxisFault) CONCAT(g_StationList[StaNum],ServoAlarmList[0],IndexerAxisFaultMessage) CONCAT(IndexerAxisFaultMessage,IndexerAxisFault,ServoAlarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Indexer Axis Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.PowerUpCP)XIO(iq_IndexerAxis.AxisHomedStatus)[OTE(ServoAlarm[1].Active) ,ONS(ONS.11) CONCAT(g_StationList[StaNum],ServoAlarmList[1],ServoAlarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Not Used]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Actuators NOT In Safe Position For Index Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) XIO(ActuatorsSafe) ,XIC(Alarm[1].Active) XIO(FaultReset) ][OTE(Alarm[1].Active) ,ONS(ONS.15) CONCAT(g_StationList[StaNum],AlarmList[1],ActuatorsSafeMessageA) [XIO(\S01_PartLoad.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[1],Alarm[1].Message) ,XIO(\S03_PartLoad.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[2],Alarm[1].Message) ,XIO(\S04_PartVerify.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[3],Alarm[1].Message) ,XIO(\S05_ServoPNP.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[4],Alarm[1].Message) ,XIO(\S18_RejectUnload.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[5],Alarm[1].Message) ,XIO(\S19_GoodUnload.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[6],Alarm[1].Message) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Index To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,ONS(ONS.16) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Index To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset) ][OTE(Alarm[3].Active) ,ONS(ONS.17) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Not Used]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Last Station Empty Nest Sensor Blocked]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[10]) ,XIC(Status.State[37]) ] MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) XIC(p_OnStation) XIO(i_EmptyNest) ,XIC(Alarm[5].Active) XIO(FaultReset) ][OTE(Alarm[5].Active) ,ONS(ONS.19) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Indexer To Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[31]) MOVE(2000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset) ][OTE(Alarm[6].Active) ,ONS(ONS.20) CONCAT(g_StationList[StaNum],AlarmList[6],Alarm[6].Message) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Warning - Actuators NOT In Safe Position During Index]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[31]) ONS(ONS.21) ,XIC(Alarm[7].Active) XIO(FaultReset) XIO(Status.State[37]) ][OTE(Alarm[7].Active) ,ONS(ONS.22) CONCAT(g_StationList[StaNum],AlarmList[1],ActuatorsSafeMessageA) [XIO(\S01_PartLoad.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[1],Alarm[7].Message) ,XIO(\S03_PartLoad.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[2],Alarm[7].Message) ,XIO(\S04_PartVerify.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[3],Alarm[7].Message) ,XIO(\S05_ServoPNP.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[4],Alarm[7].Message) ,XIO(\S18_RejectUnload.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[5],Alarm[7].Message) ,XIO(\S19_GoodUnload.q_ActuatorsSafe) CONCAT(ActuatorsSafeMessageA,ActuatorsSafeList[6],Alarm[7].Message) ,MOVE(1,Alarm[7].Severity) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Fault - Actuators NOT In Safe Position During Index]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[34]) MOVE(3000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[8].Active) XIO(FaultReset) ][OTE(Alarm[8].Active) ,ONS(ONS.23) MOVE(Alarm[7].Message,Alarm[8].Message) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Servo Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ServoFaultHandler,\Alarms.p_ProgramID,ServoAlarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,ServoAlarmActive,ServoWarningActive);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Station Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,AlarmActive,WarningActive);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Alarm/Warning Active Outputs]]>
</Comment>
<Text>
<![CDATA[[XIC(ServoAlarmActive) ,XIC(AlarmActive) ]OTE(q_AlarmActive);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIC(ServoWarningActive) ,XIC(WarningActive) ]OTE(q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
