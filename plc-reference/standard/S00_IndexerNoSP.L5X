 TorqueLimitNegative="-243.19067" TorqueThreshold="218.8716" StoppingTorque="243.19067" StoppingTimeLimit="1.0" LoadInertiaRatio="0.0" RegistrationInputs="2" MaximumAccelerationJerk="205421.06" MaximumDecelerationJerk="205421.06" DynamicsConfigurationBits="7" AccelerationLimit="3775.4082" DecelerationLimit="3775.4082"
