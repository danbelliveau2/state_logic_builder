<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Attempt" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Success" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="PerformLow" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="PerformHigh" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Attempts" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Successes" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Failures" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Efficiency" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="HMIColorStatus" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="rEfficiencyTemp" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="AttemptPre" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="SuccessPre" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Attempts]]>
</Line>
<Line Number="1">
<![CDATA[IF Attempt AND NOT AttemptPre THEN]]>
</Line>
<Line Number="2">
<![CDATA[	Attempts:=Attempts + 1;]]>
</Line>
<Line Number="3">
<![CDATA[END_IF;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[//Successes]]>
</Line>
<Line Number="6">
<![CDATA[IF Success AND NOT SuccessPre THEN]]>
</Line>
<Line Number="7">
<![CDATA[	Successes:=Successes + 1;]]>
</Line>
<Line Number="8">
<![CDATA[END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[//Failures]]>
</Line>
<Line Number="11">
<![CDATA[	Failures:=Attempts - Successes;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[//Calculate Station Efficiency]]>
</Line>
<Line Number="14">
<![CDATA[IF (Attempts > 0) THEN]]>
</Line>
<Line Number="15">
<![CDATA[	rEfficiencyTemp := (Successes * 10000) / Attempts;]]>
</Line>
<Line Number="16">
<![CDATA[	Efficiency := rEfficiencyTemp / 100;]]>
</Line>
<Line Number="17">
<![CDATA[ELSE]]>
</Line>
<Line Number="18">
<![CDATA[	Efficiency := 0;]]>
</Line>
<Line Number="19">
<![CDATA[END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[//HMI Color]]>
</Line>
<Line Number="22">
<![CDATA[IF(Efficiency < PerformLow) THEN]]>
</Line>
<Line Number="23">
<![CDATA[	HMIColorStatus := 3;]]>
</Line>
<Line Number="24">
<![CDATA[ELSIF (Efficiency < PerformHigh) AND (Efficiency >= PerformLow)  THEN]]>
</Line>
<Line Number="25">
<![CDATA[	HMIColorStatus := 2;]]>
</Line>
<Line Number="26">
<![CDATA[ELSE]]>
</Line>
<Line Number="27">
<![CDATA[	HMIColorStatus := 1;]]>
</Line>
<Line Number="28">
<![CDATA[END_IF;]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[//One Shots]]>
</Line>
<Line Number="31">
<![CDATA[	AttemptPre:=Attempt;]]>
</Line>
<Line Number="32">
<![CDATA[	SuccessPre:=Success;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
