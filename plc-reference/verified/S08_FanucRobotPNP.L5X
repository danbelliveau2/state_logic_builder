<DataValueMember Name="Failure" DataType="BOOL" Value="0"/>
<DataValueMember Name="Lockout" DataType="BOOL" Value="0"/>
</Structure>
</Element>
</ArrayMember>
<DataValueMember Name="FailureType" DataType="INT" Radix="Decimal" Value="0"/>
<StructureMember Name="FailureMessage" DataType="STRING">
<DataValueMember Name="LEN" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="DATA" DataType="STRING" Radix="ASCII">
<![CDATA[]]>
</DataValueMember>
</StructureMember>
</Structure>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Nest & Station Numbers]]>
</Comment>
<Text>
<![CDATA[[MOVE(8,StaNum) MOVE(7,StaNumPre) ,MOVE(\Tracking.p_Data.Station[StaNum].NestNum,NestNumCurrent) MOVE(\Tracking.p_Data.Station[StaNumPre].NestNum,NestNumIncoming) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[AOI_Debounce(PartPresentDebounce,i_PartPresent,100,100);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Logic inputs]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_AutoIdle)OTE(AutoIdle);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(HMI_LocalManualOverride) ,XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep) ,XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleCycle) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)XIO(HMI_LocalManualOverride)XIO(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)XIO(\Tracking.p_Data.Station[StaNum].OpStatus.SingleCycle)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(i_RobotStatus.Running)EQ(i_RobotEDAIn.R60,0)XIC(i_RobotStatus.UserIn1.0)XIC(i_RobotStatus.UserIn1.3)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[At Pick Position

***Low & High Limits Must Be Populated At Startup***]]>
</Comment>
<Text>
<![CDATA[LIMIT(0,i_RobotEDAIn.CURPOS_G1.X,0)LIMIT(0,i_RobotEDAIn.CURPOS_G1.Y,0)LIMIT(0,i_RobotEDAIn.CURPOS_G1.Z,0)OTE(AtPick);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[At Place Position

***Low & High Limits Must Be Populated At Startup***]]>
</Comment>
<Text>
<![CDATA[LIMIT(0,i_RobotEDAIn.CURPOS_G1.X,0)LIMIT(0,i_RobotEDAIn.CURPOS_G1.Y,0)LIMIT(0,i_RobotEDAIn.CURPOS_G1.Z,0)OTE(AtPlace);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)XIO(ManualMode)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Dry run logic (can add supervisor dry run condition if needed as parallel branch)]]>
</Comment>
<Text>
<![CDATA[[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.DryRun) ,XIC(g_HMI_DryRun) ]OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[[XIC(AutoIdle) ,XIC(HMI_LocalManualOverride) ][XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep) ,XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleCycle) ]OTE(SS);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(SS)XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleDisableTracking)OTE(SingleDisableTracking);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)ONS(ONS.12)OTU(\Tracking.p_Data.Station[StaNum].OpStatus.SingleCycle);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleCycle)ONS(ONS.13)OTU(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(AutoIdle) ,XIC(HMI_LocalManualOverride) ]XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleCycle)XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleTrigger)ONS(ONS.14)OTL(SingleCycle);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(SingleCycle)[XIO(AutoIdle) XIO(HMI_LocalManualOverride) ,XIO(\Tracking.p_Data.Station[StaNum].OpStatus.SingleCycle) ,XIC(q_AlarmActive) ,XIC(Status.State[4]) ONS(ONS.15) ]OTU(SingleCycle);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIO(SS) ,[XIC(AutoIdle) ,XIC(HMI_LocalManualOverride) ] XIC(\S00_IndexerSP.p_OnStation) [[XIC(LocalSSONS) ,XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleTrigger) ] ONS(ONS.1) ,XIC(SingleCycle) ] ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(SS)XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleClearTracking)TON(SingleResetDelay,?,?)XIC(SingleResetDelay.DN)COP(ZeroPartAssyStat,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus,1);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Cycle Station]]>
</Comment>
<Text>
<![CDATA[[XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded) [XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNumPre].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNumPre].Lockout) ] ,XIC(DryRun) ][XIO(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStationA) ,OTE(CycleStationB) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIO(Status.State[1])NE(HMI_Hold,0)MOVE(0,HMI_Hold);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[99]) XIO(CycleRunning) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[22]) XIO(i_RobotStatus.Running) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Start of sequence, wait for part present]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ] XIO(i_RobotStatus.UserIn5.6) ,XIC(Status.State[19]) EQ(i_RobotEDAIn.R60,0) XIC(i_RobotStatus.UserIn1.0) ]XIC(CycleRunning)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Trigger Pick Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIC(PartPresentDebounce.On) ,XIC(DryRun) ]XIC(SS_OK)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Wait For Pick Program Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])EQ(i_RobotEDAIn.R60,2)XIO(i_RobotStatus.UserIn1.0)XIC(SS_OK)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: Wait For Index Complete]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ] XIC(i_RobotStatus.UserIn5.6) XIC(CycleRunning) ,XIC(Status.State[10]) EQ(i_RobotEDAIn.R60,0) XIC(i_RobotStatus.UserIn1.0) ]XIC(SS_OK)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 16: Trigger Place Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])[XIC(\S00_IndexerSP.q_WaitStationsComplete) XIC(CycleStationA) ,XIC(SS) ]XIC(SS_OK)MOVE(16,Control.StateReg)XIO(SingleDisableTracking)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 19: Wait For Place Program Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])EQ(i_RobotEDAIn.R60,3)XIO(i_RobotStatus.UserIn1.0)XIC(SS_OK)MOVE(19,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 22: Stop Robot Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])EQ(i_RobotEDAIn.R60,0)XIC(i_RobotStatus.UserIn1.0)XIO(CycleRunning)XIC(SS_OK)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[19])XIC(AtPlace)XIO(i_RobotStatus.UserIn5.6)XIO(SingleDisableTracking)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 99: Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(Lockout)MOVE(99,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 100: Initialize Start Robot Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 103: Initialize Trigger Safe Home Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(i_RobotStatus.Running)EQ(i_RobotEDAIn.R60,0)XIC(i_RobotStatus.UserIn1.0)XIO(i_RobotStatus.UserIn1.3)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 106: Wait For Safe Home Program Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[103])EQ(i_RobotEDAIn.R60,100)XIO(i_RobotStatus.UserIn1.0)MOVE(106,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 124: Initialization Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[100]) XIC(i_RobotStatus.Running) ,XIC(Status.State[106]) ]EQ(i_RobotEDAIn.R60,0)XIC(i_RobotStatus.UserIn1.0)XIC(i_RobotStatus.UserIn1.3)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIO(i_RobotStatus.UserIn5.6) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIO(i_RobotStatus.TP)XIC(i_RobotStatus.UserIn5.7)XIC(i_RobotStatus.Ready)XIO(i_RobotStatus.Fault)XIO(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)XIO(\Tracking.p_Data.Station[StaNum].OpStatus.SingleCycle)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Permissive
***Replace AlwaysOff With Required Station Permissives***]]>
</Comment>
<Text>
<![CDATA[XIC(i_RobotStatus.Running)XIO(i_RobotStatus.Fault)XIC(g_MachineBasic.AlwaysOff)OTE(Permissive);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Actuators Safe For Index - Robot Clear Of Indexer
***LOW AND HIGH LIMITS MUST BE SET AT STARTUP***]]>
</Comment>
<Text>
<![CDATA[LIMIT(0,i_RobotEDAIn.CURPOS_G1.X,0)LIMIT(0,i_RobotEDAIn.CURPOS_G1.Y,0)LIMIT(0,i_RobotEDAIn.CURPOS_G1.Z,0)OTE(q_ActuatorsSafe);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Pause Request To Indexer]]>
</Comment>
<Text>
<![CDATA[XIC(Alarm[1].Active)OTE(q_Pause);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Set Part Tracking If Station Is Locked Out]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)XIC(Status.State[99])XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Station Complete]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)[XIC(CycleStationB) [XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout) ] ,XIO(CycleStationB) ]OTE(q_StationComplete);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Safety OK To Robot]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)[OTE(q_RobotControl.IMSTP) ,OTE(q_RobotControl.Hold) ,OTE(q_RobotControl.SFSPD) ,OTE(q_RobotControl.Enable) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Abort Robot Program]]>
</Comment>
<Text>
<![CDATA[[[XIC(i_RobotStatus.Fault) ,XIO(i_RobotStatus.UserIn5.6) ] XIC(i_RobotStatus.Paused) ,XIC(i_RobotStatus.Running) XIO(Permissive) ,XIC(Status.State[127]) XIC(i_RobotStatus.Running) ]XIC(g_MachineBasic.Flash250msPD)OTE(q_RobotControl.CycleStop);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Start Signal To Robot]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) XIC(Status.State[100]) ,XIC(Status.State[1]) XIC(HMI_Hold.0) ]XIC(g_MachineBasic.Flash250msPD)[XIC(i_RobotStatus.Paused) OTE(q_RobotControl.RemoteStart) ,XIO(i_RobotStatus.Paused) OTE(q_RobotControl.Start) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Stop Signal To Robot]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) XIC(Status.State[22]) ,XIC(Status.State[1]) [XIC(HMI_Hold.1) ,XIC(i_RobotStatus.Running) EQ(i_RobotEDAIn.R60,0) TON(ManualStopDelay,?,?) XIC(ManualStopDelay.DN) ] ]OTE(q_RobotControl.UserOut5.7);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Manual Mode To Robot]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])OTE(q_RobotControl.UserOut5.4);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Auto Confirm]]>
</Comment>
<Text>
<![CDATA[XIO(i_RobotStatus.TP)XIC(i_RobotStatus.UserIn5.7)TON(AutoConfirmDelay,?,?)XIC(AutoConfirmDelay.TT)OTE(q_RobotControl.UserOut5.5);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Safety Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)TON(SafetyResetDelay,?,?)XIC(SafetyResetDelay.DN)ONS(ONS.5)OTL(SafetyResetLatch);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(SafetyResetLatch)XIO(i_RobotStatus.Fault)OTU(SafetyResetLatch);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Fault Reset Signal To Robot]]>
</Comment>
<Text>
<![CDATA[[[XIC(SafetyResetLatch) ,XIC(AutoConfirmDelay.TT) ] XIO(i_RobotStatus.TP) XIC(i_RobotStatus.UserIn5.7) ,XIC(FaultReset) ]XIC(i_RobotStatus.Fault)XIC(g_MachineBasic.Flash250msPD)OTE(q_RobotControl.FaultReset);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Trigger Pick Program]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) XIC(Status.State[7]) ,XIC(Status.State[1]) XIC(HMI_Momentary.0) ]XIC(Permissive)MOVE(2,q_RobotEDAOut.R50);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Trigger Place Program]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) XIC(Status.State[16]) ,XIC(Status.State[1]) XIC(\S00_IndexerSP.p_OnStation) XIC(HMI_Momentary.1) ]XIC(Permissive)MOVE(3,q_RobotEDAOut.R50);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Trigger Safe Home Program]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) XIC(Status.State[103]) ,XIC(Status.State[1]) XIC(HMI_Momentary.2) ]XIC(Permissive)MOVE(100,q_RobotEDAOut.R50);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Clear R50]]>
</Comment>
<Text>
<![CDATA[NE(i_RobotEDAIn.R60,0)MOVE(0,q_RobotEDAOut.R50);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Station Performance]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)StationPerformance(StationPerformance,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success,g_PresetStationPerformLow,g_PresetStationPerformHigh,\Tracking.p_Data.Station[StaNum].PerformData.Attempts,\Tracking.p_Data.Station[StaNum].PerformData.Successes,\Tracking.p_Data.Station[StaNum].PerformData.Failures,\Tracking.p_Data.Station[StaNum].PerformData.Efficiency,\Tracking.p_Data.Station[StaNum].PerformData.HMIColorStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[[XIC(i_RobotStatus.Fault) ,XIC(Alarm[0].Active) XIO(FaultReset) ][OTE(Alarm[0].Active) ,ONS(ONS.16) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Part Present]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(10000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[1].Active) ,ONS(ONS.17) MOVE(1,Alarm[1].Severity) CONCAT(g_StationList[StaNum],AlarmList[1],Alarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Robot Abort Issued]]>
</Comment>
<Text>
<![CDATA[[XIC(q_RobotControl.CycleStop) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,ONS(ONS.18) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Invalid Program Command]]>
</Comment>
<Text>
<![CDATA[[XIC(i_RobotStatus.UserIn1.1) ,XIC(Alarm[3].Active) XIO(FaultReset) ][OTE(Alarm[3].Active) ,ONS(ONS.19) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Robot Program Did Not Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[100]) XIO(i_RobotStatus.Running) TON(AlarmTimerProgramStart,?,?) XIC(AlarmTimerProgramStart.DN) ,XIC(Alarm[4].Active) XIO(FaultReset) ][OTE(Alarm[4].Active) ,ONS(ONS.20) CONCAT(g_StationList[StaNum],AlarmList[4],Alarm[4].Message) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Robot Handshakes Incorrect]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[100]) [NE(i_RobotEDAIn.R60,0) ,XIO(i_RobotStatus.UserIn1.0) ] TON(AlarmTimerHandshakes,?,?) XIC(AlarmTimerHandshakes.DN) ,XIC(Alarm[5].Active) XIO(FaultReset) ][OTE(Alarm[5].Active) ,ONS(ONS.21) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For Program To Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[22]) MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset) ][OTE(Alarm[6].Active) ,ONS(ONS.22) CONCAT(g_StationList[StaNum],AlarmList[6],Alarm[6].Message) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Safe Home Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[103]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset) ][OTE(Alarm[7].Active) ,ONS(ONS.23) CONCAT(g_StationList[StaNum],AlarmList[7],Alarm[7].Message) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Safe Home Program To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[106]) MOVE(10000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[8].Active) XIO(FaultReset) ][OTE(Alarm[8].Active) ,ONS(ONS.24) CONCAT(g_StationList[StaNum],AlarmList[8],Alarm[8].Message) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Pick Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[9].Active) XIO(FaultReset) ][OTE(Alarm[9].Active) ,ONS(ONS.25) CONCAT(g_StationList[StaNum],AlarmList[9],Alarm[9].Message) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Waiting For Pick Program To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) MOVE(10000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[10].Active) XIO(FaultReset) ][OTE(Alarm[10].Active) ,ONS(ONS.26) CONCAT(g_StationList[StaNum],AlarmList[10],Alarm[10].Message) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Waiting For Place Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[11].Active) XIO(FaultReset) ][OTE(Alarm[11].Active) ,ONS(ONS.27) CONCAT(g_StationList[StaNum],AlarmList[11],Alarm[11].Message) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Waiting For Place Program To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) MOVE(10000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[12].Active) XIO(FaultReset) ][OTE(Alarm[12].Active) ,ONS(ONS.28) CONCAT(g_StationList[StaNum],AlarmList[12],Alarm[12].Message) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Use="Context" Name="Supervisor" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="q_AutoIdle">
</Tag>
<Tag Use="Reference" Name="q_CycleStartLatch">
</Tag>
<Tag Use="Reference" Name="q_CycleStopped">
</Tag>
<Tag Use="Reference" Name="q_FaultReset">
</Tag>
<Tag Use="Reference" Name="q_ManualMode">
</Tag>
<Tag Use="Reference" Name="q_SafetyOK">
</Tag>
</Tags>
</Program>
<Program Use="Context" Name="Tracking" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="p_Data">
</Tag>
</Tags>
</Program>
</Programs>
<ParameterConnections Use="Context">
<ParameterConnection EndPoint1="\S08_FanucRobotPNP.q_RobotControl" EndPoint2="rob01_FlexFeederControl"/>
<ParameterConnection EndPoint1="\S08_FanucRobotPNP.q_RobotEDAOut" EndPoint2="rob01_FlexFeederEDAOut"/>
<ParameterConnection EndPoint1="rob01_FlexFeederEDAIn" EndPoint2="\S08_FanucRobotPNP.i_RobotEDAIn"/>
<ParameterConnection EndPoint1="rob01_FlexFeederStatus" EndPoint2="\S08_FanucRobotPNP.i_RobotStatus"/>
</ParameterConnections>
</Controller>
</RSLogix5000Content>
