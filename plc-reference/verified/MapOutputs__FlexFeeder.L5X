<Text>
<![CDATA[[MOVE(OutputTagA.UserWord1,Temp[12]) ,MOVE(OutputTagA.UserWord2,Temp[14]) ,MOVE(OutputTagA.UserWord3,Temp[16]) ,MOVE(OutputTagA.UserWord4,Temp[18]) ,MOVE(OutputTagA.UserWord5,Temp[20]) ,MOVE(OutputTagA.UserWord6,Temp[22]) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[CPS(Temp[0],ModuleTagA.Output[0],24);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Robot EDA Inputs]]>
</Comment>
<Text>
