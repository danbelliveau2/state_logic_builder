<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot User Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(OutputTagA.IMSTP)OTE(Temp[0].0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(OutputTagA.Hold)OTE(Temp[0].1);]]>
</Text>
</Rung>
