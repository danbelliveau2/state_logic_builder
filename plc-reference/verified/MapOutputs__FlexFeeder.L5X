</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Robot Digital Inputs]]>
</Comment>
<Text>
<![CDATA[[MOVE(OutputTagA.UserOut1,Temp[4]) ,MOVE(OutputTagA.UserOut2,Temp[5]) ,MOVE(OutputTagA.UserOut3,Temp[6]) ,MOVE(OutputTagA.UserOut4,Temp[7]) ,MOVE(OutputTagA.UserOut5,Temp[8]) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
