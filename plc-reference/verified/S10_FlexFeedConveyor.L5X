<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R04_ConveyorServo,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station Number]]>
</Comment>
<Text>
<![CDATA[MOVE(10,StaNum);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)OTE(MachineRunning);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(\S10_FlexFeedRobot.q_RobotRunning)OTE(RobotRunning);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(\S10_FlexFeedRobot.q_ProcessConveyorStop)OTE(ProcessConveyorStop);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)XIO(ManualMode)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Dry run logic (can add supervisor dry run condition if needed as parallel branch)]]>
</Comment>
<Text>
<![CDATA[[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.DryRun) ,XIC(g_HMI_DryRun) ]OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[99]) XIO(CycleRunning) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[4]) ,XIC(Status.State[22]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Start of sequence, wait for robot running and NOT pick tool stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[22]) ,XIC(Status.State[124]) ]XIC(CycleRunning)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Start Process Conveyor Jog]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(RobotRunning)XIO(ProcessConveyorStop)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Delay To Start Incline Conveyor]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(ProcessConveyorAuto_MAJ.IP)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: Start Incline Conveyor]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])MOVE(1000,Control.TransitionTime)XIC(Status.TransitionTimerDone)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 16: Running]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(i_InclineConveyor.RunningReverse)XIC(i_InclineConveyor.AtReference)MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 19: Stop Incline & Process Conveyor]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[XIO(CycleRunning) ,XIC(ProcessConveyorStop) ]MOVE(19,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 22: Cycle Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])XIO(i_InclineConveyor.RunningReverse)XIO(i_InclineConveyor.AtReference)XIO(ProcessConveyorAuto_MAJ.IP)XIC(ProcessConveyorAuto_MAS.PC)MOVE(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 99: Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(Lockout)MOVE(99,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 100:Start of initialization sequence, no action]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(iq_ProcessConveyor.ServoActionStatus)XIC(i_InclineConveyor.Ready)XIC(i_InclineConveyor.NetControl)XIC(i_InclineConveyor.NetSetpoint)XIC(i_ReturnConveyor.Ready)XIC(i_ReturnConveyor.NetControl)XIC(i_ReturnConveyor.NetSetpoint)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Incline Conveyor VFD Control]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)[OTE(q_InclineConveyor.NetControl) ,OTE(q_InclineConveyor.NetSetpoint) ,LIMIT(0,HMI_InclineConveyorSpeed,1800) MOVE(HMI_InclineConveyorSpeed,q_InclineConveyor.Speed) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(i_InclineConveyor.Fault)XIC(FaultReset)OTE(q_InclineConveyor.Reset);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Status.State[1])XIC(HMI_Momentary.0)OTL(InclineManLatch);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(InclineManLatch)[XIC(HMI_Momentary.1) ,XIO(Status.State[1]) ]OTU(InclineManLatch);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Status.State[1]) XIC(InclineManLatch) XIC(HMI_Mantained.0) ,XIO(Status.State[1]) [XIC(Status.State[13]) ,XIC(q_InclineConveyor.RunReverse) XIC(MachineRunning) XIO(Status.State[19]) ] ]OTE(q_InclineConveyor.RunReverse);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Return Conveyor VFD Control]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)[OTE(q_ReturnConveyor.NetControl) ,OTE(q_ReturnConveyor.NetSetpoint) ,LIMIT(0,HMI_ReturnConveyorSpeed,1800) MOVE(HMI_ReturnConveyorSpeed,q_ReturnConveyor.Speed) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(i_ReturnConveyor.Fault)XIC(FaultReset)OTE(q_ReturnConveyor.Reset);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[1])XIC(HMI_Momentary.6)OTL(ReturnManLatch);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(ReturnManLatch)[XIC(HMI_Momentary.7) ,XIO(Status.State[1]) ]OTU(ReturnManLatch);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(Status.State[1]) XIC(ReturnManLatch) XIC(HMI_Mantained.1) ,XIO(Status.State[1]) XIC(MachineRunning) ]OTE(q_ReturnConveyor.RunReverse);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Vision Lights]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) [XIC(HMI_Momentary.4) ,XIC(q_VisionLights) XIO(HMI_Momentary.5) ] ,XIO(Status.State[1]) XIC(MachineRunning) ]OTE(q_VisionLights);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Vibratory Feeder]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) [XIC(HMI_Momentary.8) ,XIC(q_VibratoryFeeder) XIO(HMI_Momentary.9) ] ,XIO(Status.State[1]) [XIC(Status.State[7]) ,XIC(Status.State[10]) ,XIC(Status.State[13]) ,XIC(Status.State[16]) ] ]OTE(q_VibratoryFeeder);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R04_ConveyorServo" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Axis Is Ready For Operation]]>
</Comment>
<Text>
<![CDATA[XIC(MotionGroup.GroupSynced)XIO(iq_ProcessConveyor.SafeTorqueOffActiveInhibit)OTE(ProcessConveyorReady);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(SafetyOK)XIC(ProcessConveyorReady)TON(ProcessConveyorEnableDelay,?,?)XIC(ProcessConveyorEnableDelay.DN)ONS(ProcessConveyorONS.0)OTE(ProcessConveyorAutoEnable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Axis Motion Permissive]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)OTE(ProcessConveyorPermissive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) XIC(HMI_ProcessConveyor.Control.Enable) XIC(ProcessConveyorReady) ,XIC(ProcessConveyorAutoEnable) ]XIO(iq_ProcessConveyor.ServoActionStatus)MSO(iq_ProcessConveyor,ProcessConveyor_MSO);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(HMI_ProcessConveyor.Control.Disable)MSF(iq_ProcessConveyor,ProcessConveyor_MSF);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fault Reset Axis]]>
</Comment>
<Text>
<![CDATA[NE(iq_ProcessConveyor.AxisFault,0)XIC(FaultReset)[XIO(iq_ProcessConveyor.ShutdownStatus) MAFR(iq_ProcessConveyor,ProcessConveyor_MAFR) ,XIC(iq_ProcessConveyor.ShutdownStatus) MASR(iq_ProcessConveyor,ProcessConveyor_MASR) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Manual Jog Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(ProcessConveyorPermissive)XIC(iq_ProcessConveyor.ServoActionStatus)XIO(iq_ProcessConveyor.JogStatus)XIO(iq_ProcessConveyor.MoveStatus)[XIC(HMI_ProcessConveyor.Control.JogPositive) XIO(HMI_ProcessConveyor.Control.JogNegative) MOVE(0,ProcessConveyorJogDirection) ,XIC(HMI_ProcessConveyor.Control.JogNegative) XIO(HMI_ProcessConveyor.Control.JogPositive) MOVE(1,ProcessConveyorJogDirection) ]MAJ(iq_ProcessConveyor,ProcessConveyorMan_MAJ,ProcessConveyorJogDirection,HMI_ProcessConveyor.Parameters.JogSpeed,Units per sec,HMI_ProcessConveyor.Parameters.Accel[0],Units per sec2,HMI_ProcessConveyor.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(ProcessConveyorMan_MAJ.IP)XIO(HMI_ProcessConveyor.Control.JogPositive)XIO(HMI_ProcessConveyor.Control.JogNegative)MAS(iq_ProcessConveyor,ProcessConveyorMan_MAS,Jog,Yes,HMI_ProcessConveyor.Parameters.Decel[0],Units per sec2,No,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Inch Axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(ProcessConveyorPermissive)XIC(iq_ProcessConveyor.ServoActionStatus)XIO(iq_ProcessConveyor.JogStatus)XIO(iq_ProcessConveyor.MoveStatus)[XIC(HMI_ProcessConveyor.Control.InchPositive) ONS(ProcessConveyorONS.1) MOVE(HMI_ProcessConveyor.Parameters.InchAmount,ProcessConveyorInchAmount) ,XIC(HMI_ProcessConveyor.Control.InchNegative) ONS(ProcessConveyorONS.2) NEG(HMI_ProcessConveyor.Parameters.InchAmount,ProcessConveyorInchAmount) ]MAM(iq_ProcessConveyor,ProcessConveyor_Inch,1,ProcessConveyorInchAmount,HMI_ProcessConveyor.Parameters.ManualSpeed,Units per sec,HMI_ProcessConveyor.Parameters.Accel[0],Units per sec2,HMI_ProcessConveyor.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Home Axis

***No Homing Required For Flex Feeder Process Conveyor.  Logic Left In For Standardization.***]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_ProcessConveyor.Control.HomeRequest) ONS(ProcessConveyorONS.3) XIO(ProcessConveyorTorqueHome.IP) ,XIC(ProcessConveyorHomeRequested) XIO(ProcessConveyorHomeConfirmDelay.DN) XIO(ProcessConveyorHomeConfimed) ]XIC(ProcessConveyorReady)[OTE(ProcessConveyorHomeRequested) ,TON(ProcessConveyorHomeConfirmDelay,?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[1])[XIC(HMI_ProcessConveyor.Control.HomeConfirm) ONS(ProcessConveyorONS.4) ,XIC(ProcessConveyorHomeConfimed) XIC(ProcessConveyorHomeSelect) XIO(ProcessConveyorTorqueHome.PC) XIO(ProcessConveyorTorqueHome.Error) ]OTE(ProcessConveyorHomeConfimed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Home Select = 0 is for Immediate Home (Example, servo indexer)
Home Select = 1 is for Home To Torque (Example, PNP)

Homing Torque = Start at 25%, Increase In 5% Increments If Not Enough
Run Torque = Normal Running Torque Of Axis
Homing Speed = Homing Speed in units/s
Overtorque Limit = Set The Same As Homing Torque
Home Offset Distance = Distance Moved Off Of Hard Stop When Homing Complete
Home Direction = 0 Is Positive, 1 Is Negative]]>
</Comment>
<Text>
<![CDATA[XIC(ProcessConveyorHomeConfimed)[XIO(ProcessConveyorHomeSelect) MAH(iq_ProcessConveyor,ProcessConveyor_MAH) ,XIC(ProcessConveyorHomeSelect) AOI_TorqueHome(ProcessConveyorTorqueHome,iq_ProcessConveyor,25.0,100.0,5.0,25.0,0.5,1) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(ProcessConveyorHomeRequested) OTE(HMI_ProcessConveyor.Status.HomeRequested) ,[XIC(ProcessConveyorTorqueHome.IP) ,XIC(ProcessConveyor_MAH.IP) ] OTE(HMI_ProcessConveyor.Status.HomeInProcess) ,[XIC(ProcessConveyorTorqueHome.PC) ,XIC(ProcessConveyor_MAH.PC) ] OTE(HMI_ProcessConveyor.Status.HomeComplete) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Manual Mode

***Not Required For Flex Feeder Process Conveyor.  Logic Left In For Standardization.***]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)XIC(SafetyOK)XIC(Status.State[1])[MOVE(HMI_ProcessConveyor.Parameters.ManualSpeed,ProcessConveyorMotionParameters.Speed) ,XIC(ProcessConveyorPermissive) [XIC(HMI_ProcessConveyor.Control.ManMoves.0) MOVE(HMI_ProcessConveyor.Parameters.Positions[0],ProcessConveyorMotionParameters.Position) ,XIC(HMI_ProcessConveyor.Control.ManMoves.1) MOVE(HMI_ProcessConveyor.Parameters.Positions[1],ProcessConveyorMotionParameters.Position) ] OTE(ProcessConveyorManMoveTrig) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Auto Mode

***Not Required For Flex Feeder Process Conveyor.  Logic Left In For Standardization.***]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)XIC(SafetyOK)XIO(Status.State[1])[MOVE(0,ProcessConveyorMotionParameters.MoveType) ,MOVE(HMI_ProcessConveyor.Parameters.AutoSpeed[0],ProcessConveyorMotionParameters.Speed) ,MOVE(HMI_ProcessConveyor.Parameters.Accel[0],ProcessConveyorMotionParameters.Accel) ,MOVE(HMI_ProcessConveyor.Parameters.Decel[0],ProcessConveyorMotionParameters.Decel) ,XIC(g_MachineBasic.AlwaysOff) MOVE(HMI_ProcessConveyor.Parameters.Positions[0],ProcessConveyorMotionParameters.Position) ,XIC(g_MachineBasic.AlwaysOff) MOVE(HMI_ProcessConveyor.Parameters.Positions[1],ProcessConveyorMotionParameters.Position) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Axis Motion Command

***Not Required For Flex Feeder Process Conveyor.  Logic Left In For Standardization.***]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)XIC(SafetyOK)[XIC(Status.State[1]) XIC(ProcessConveyorManMoveTrig) ,XIO(Status.State[1]) XIC(g_MachineBasic.AlwaysOff) ]XIC(iq_ProcessConveyor.ServoActionStatus)XIC(iq_ProcessConveyor.AxisHomedStatus)XIC(ProcessConveyorPermissive)MAM(iq_ProcessConveyor,ProcessConveyor_MAM,ProcessConveyorMotionParameters.MoveType,ProcessConveyorMotionParameters.Position,ProcessConveyorMotionParameters.Speed,Units per sec,ProcessConveyorMotionParameters.Accel,Units per sec2,ProcessConveyorMotionParameters.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Auto Jog Axis]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) XIC(Status.State[7]) ,XIC(Status.State[1]) XIC(HMI_Momentary.2) ]XIC(ProcessConveyorPermissive)XIC(iq_ProcessConveyor.ServoActionStatus)XIO(iq_ProcessConveyor.JogStatus)XIO(iq_ProcessConveyor.MoveStatus)MAJ(iq_ProcessConveyor,ProcessConveyorAuto_MAJ,0,HMI_ProcessConveyor.Parameters.AutoSpeed[0],Units per sec,HMI_ProcessConveyor.Parameters.Accel[0],Units per sec2,HMI_ProcessConveyor.Parameters.Decel[0],Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIO(Status.State[1]) XIC(Status.State[19]) ,XIC(Status.State[1]) XIC(HMI_Momentary.3) ]XIC(ProcessConveyorAuto_MAJ.IP)MAS(iq_ProcessConveyor,ProcessConveyorAuto_MAS,Jog,Yes,HMI_ProcessConveyor.Parameters.Decel[0],Units per sec2,No,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Stop axis if permissive turns off while in motion and use max or close to max decel value]]>
</Comment>
<Text>
<![CDATA[XIO(iq_ProcessConveyor.MotionStatus.0)[XIO(ProcessConveyorPermissive) ,XIO(SafetyOK) ]MAS(iq_ProcessConveyor,ProcessConveyor_MAS_All,All,Yes,90,% of Maximum,Yes,90,% of Maximum);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Set torque]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_ProcessConveyor.Control.SetTorquePos)MOVE(HMI_ProcessConveyor.Parameters.TorquePos,iq_ProcessConveyor.TorqueLimitPositive);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(HMI_ProcessConveyor.Control.SetTorqueNeg)MOVE(HMI_ProcessConveyor.Parameters.TorqueNeg,iq_ProcessConveyor.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Retrieve values from axis]]>
</Comment>
<Text>
<![CDATA[MOVE(iq_ProcessConveyor.ActualPosition,HMI_ProcessConveyor.Status.ActualPosition)MOVE(iq_ProcessConveyor.ActualVelocity,HMI_ProcessConveyor.Status.ActualVelocity)MOVE(iq_ProcessConveyor.TorqueReferenceLimited,HMI_ProcessConveyor.Status.ActualTorque);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Retrieve the maximum speed value from the axis and calculate max accel and decel.  The max velocity is 85% of full speed.  Equation is based upon 100% speed at a 30ms accel/decel time.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)GSV(Axis,iq_ProcessConveyor,MaximumSpeed,HMI_ProcessConveyor.Status.MaxVelocity)CPT(HMI_ProcessConveyor.Status.MaxAccel,(HMI_ProcessConveyor.Status.MaxVelocity/0.85)/0.03)MOVE(HMI_ProcessConveyor.Status.MaxAccel,HMI_ProcessConveyor.Status.MaxDecel);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Conveyor Servo Drive Is Faulted]]>
</Comment>
<Text>
<![CDATA[NE(iq_ProcessConveyor.AxisFault,0)[OTE(ServoAlarm[0].Active) ,ONS(ONS.5) DTOS(iq_ProcessConveyor.AxisFault,ProcessConveyorFault) CONCAT(g_StationList[StaNum],ServoAlarmList[0],ProcessConveyorFaultMessage) CONCAT(ProcessConveyorFaultMessage,ProcessConveyorFault,ServoAlarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Process Conveyor To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) MOVE(3000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset) ][OTE(Alarm[0].Active) ,ONS(ONS.6) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Incline Conveyor To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) MOVE(10000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset) ][OTE(Alarm[1].Active) ,ONS(ONS.7) CONCAT(g_StationList[StaNum],AlarmList[1],Alarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Incline Conveyor To Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) MOVE(10000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,ONS(ONS.8) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Process Conveyor To Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[19]) MOVE(3000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset) ][OTE(Alarm[3].Active) ,ONS(ONS.9) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Incline Conveyor Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(i_InclineConveyor.Fault)[OTE(Alarm[4].Active) ,ONS(ONS.10) CONCAT(g_StationList[StaNum],AlarmList[4],Alarm[4].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Return Conveyor Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(i_ReturnConveyor.Fault)[OTE(Alarm[5].Active) ,ONS(ONS.11) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Incline Conveyor Overload
]]>
</Comment>
<Text>
<![CDATA[[XIC(i_InclineConveyorOverload) TON(AlarmTimerOverload,?,?) XIC(AlarmTimerOverload.DN) ,XIC(Alarm[6].Active) XIO(FaultReset) ][OTE(Alarm[6].Active) ,ONS(ONS.12) CONCAT(g_StationList[StaNum],AlarmList[6],Alarm[6].Message) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Servo Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ServoAlarmHandler,\Alarms.p_ProgramID,ServoAlarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,ServoAlarmActive,ServoWarningActive);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Station Alarm Handler]]>
</Comment>
<Text>
<![CDATA[ProgramAlarmHandler(ProgramAlarmHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,AlarmActive,WarningActive);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Alarm/Warning Active Outputs]]>
</Comment>
<Text>
<![CDATA[[XIC(ServoAlarmActive) ,XIC(AlarmActive) ]OTE(q_AlarmActive);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(ServoWarningActive) ,XIC(WarningActive) ]OTE(q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Use="Context" Name="S10_FlexFeedRobot" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="q_ProcessConveyorStop">
</Tag>
<Tag Use="Reference" Name="q_RobotRunning">
</Tag>
</Tags>
</Program>
<Program Use="Context" Name="Supervisor" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="q_CycleStartLatch">
</Tag>
<Tag Use="Reference" Name="q_CycleStopped">
</Tag>
<Tag Use="Reference" Name="q_FaultReset">
</Tag>
<Tag Use="Reference" Name="q_MachineRunning">
</Tag>
<Tag Use="Reference" Name="q_ManualMode">
</Tag>
<Tag Use="Reference" Name="q_SafetyOK">
</Tag>
</Tags>
</Program>
<Program Use="Context" Name="Tracking" Class="Standard">
<Tags Use="Context">
<Tag Use="Reference" Name="p_Data">
</Tag>
</Tags>
</Program>
</Programs>
<ParameterConnections Use="Context">
<ParameterConnection EndPoint1="\S10_FlexFeedConveyor.iq_ProcessConveyor" EndPoint2="a05_ProcessConveyor"/>
<ParameterConnection EndPoint1="\S10_FlexFeedConveyor.q_InclineConveyor" EndPoint2="fd01_InclineConveyor_OUT"/>
<ParameterConnection EndPoint1="\S10_FlexFeedConveyor.q_ReturnConveyor" EndPoint2="fd02_ReturnConveyor_OUT"/>
<ParameterConnection EndPoint1="fd01_InclineConveyor_IN" EndPoint2="\S10_FlexFeedConveyor.i_InclineConveyor"/>
<ParameterConnection EndPoint1="fd02_ReturnConveyor_IN" EndPoint2="\S10_FlexFeedConveyor.i_ReturnConveyor"/>
</ParameterConnections>
</Controller>
</RSLogix5000Content>
