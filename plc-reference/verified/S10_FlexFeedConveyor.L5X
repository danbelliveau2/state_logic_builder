<Comments>
<Comment Operand=".0">
<![CDATA[Torque Home Control Not Running]]>
</Comment>
<Comment Operand=".1">
<![CDATA[Torque Home Control Disable Axis]]>
</Comment>
<Comment Operand=".2">
<![CDATA[Torque Home Control Set Homing Torque Level]]>
</Comment>
<Comment Operand=".3">
<![CDATA[Torque Home Control Enable Axis]]>
</Comment>
<Comment Operand=".4">
<![CDATA[Torque Home Control Jog To Hard Stop]]>
</Comment>
<Comment Operand=".5">
<![CDATA[Torque Home Control Wait For Axis Faulted]]>
</Comment>
<Comment Operand=".6">
<![CDATA[Torque Home Control Clear Axis Fault]]>
</Comment>
<Comment Operand=".7">
<![CDATA[Torque Home Control Re-Enable Axis]]>
</Comment>
<Comment Operand=".8">
<![CDATA[Torque Home Control Move Home Offset Distance]]>
</Comment>
<Comment Operand=".9">
<![CDATA[Torque Home Control DIsable Axis]]>
</Comment>
<Comment Operand=".10">
<![CDATA[Torque Home Control Set Home Position]]>
</Comment>
</Comments>
