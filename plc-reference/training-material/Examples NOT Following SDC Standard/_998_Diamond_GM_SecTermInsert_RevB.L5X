<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(TriggerForce)XIO(Invisible)XIO(Inactive)ONS(OneShot)[XIO(TrakOpStatTag.ForcedOn) [OTL(TrakOpStatTag.ForcedOn) ,OTE(ToggleMemoryBit) ] ,XIC(TrakOpStatTag.ForcedOn) XIO(ToggleMemoryBit) OTU(TrakOpStatTag.ForcedOn) ,XIC(TrakOpStatTag.Bypassed) OTU(TrakOpStatTag.Bypassed) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(TriggerBypass)XIO(Invisible)XIO(Inactive)ONS(OneShot2)[XIO(TrakOpStatTag.Bypassed) [OTL(TrakOpStatTag.Bypassed) ,OTE(ToggleMemoryBit2) ] ,XIC(TrakOpStatTag.Bypassed) XIO(ToggleMemoryBit2) OTU(TrakOpStatTag.Bypassed) ,XIC(TrakOpStatTag.ForcedOn) OTU(TrakOpStatTag.ForcedOn) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ButtonStatusForce is used to display different Text and Color on the button

When Button Status Equals:
0 - Not Forced On
1 - Forced On]]>
</Comment>
<Text>
<![CDATA[[XIC(TrakOpStatTag.ForcedOn) MOV(1,ButtonStatusForce) ,XIO(TrakOpStatTag.ForcedOn) MOV(0,ButtonStatusForce) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ButtonStatusBypass is used to display different Text and Color on the button

When Button Status Equals:
0 - Not Bypassed
1 - Bypassed]]>
</Comment>
<Text>
<![CDATA[[XIC(TrakOpStatTag.Bypassed) MOV(1,ButtonStatusBypass) ,XIO(TrakOpStatTag.Bypassed) MOV(0,ButtonStatusBypass) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[LES(SecurityCurrentLevel,MinAccessLevel)OTE(Inactive);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(VisibilityCondition)OTE(Invisible);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
