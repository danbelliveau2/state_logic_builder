<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(\HMI.TrayHandlingBypassed) XIC(SafeOK) [XIC(OUT_TrayPusherExt) XIO(IN_TrayPusherExtd) ,XIC(OUT_TrayPusherRet) XIO(IN_TrayPusherRetd) ] TON(TmrFlt_TrayPusher,?,?) XIC(TmrFlt_TrayPusher.DN) OTU(OUT_TrayPusherExt) OTU(OUT_TrayPusherRet) OTL(Fault[2].Active) ,XIC(Fault[2].Active) XIC(\Main.FaultReset) OTU(Fault[2].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(\HMI.TrayHandlingBypassed) XIC(SafeOK) [XIC(OUT_TrayStackerLiftDwn) XIO(IN_TrayStackerLiftDwn) ,XIC(OUT_TrayStackerLiftUp) XIO(IN_TrayStackerLiftUp) ] TON(TmrFlt_TrayStackerLift,?,?) XIC(TmrFlt_TrayStackerLift.DN) OTL(Fault[3].Active) ,XIC(Fault[3].Active) XIC(\Main.FaultReset) OTU(Fault[3].Active) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Fault[5].Active)XIC(\Main.FaultReset)OTU(Fault[5].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(\HMI.TrayHandlingBypassed)[XIC(\Mode.Auto) XIC(FullStackAtDoor) XIC(\TrayElevator.TrayLoadComplete) XIC(IN_TrayPusherExtd) XIC(IN_TrayStackerLiftDwn) XIC(StackFullMemory) ONS(OneShotFlt.6) OTL(Fault[6].Active) ,XIC(Fault[6].Active) XIO(FullStackAtDoor) XIC(\Main.FaultReset) OTU(Fault[6].Active) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(\HMI.TrayHandlingBypassed)XIC(FullStackAtDoor)XIO(Fault[6].Active)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManLift,0,OUT_TrayStackerLiftDwn,OUT_TrayStackerLiftUp,1,1,IN_TrayStackerLiftDwn,IN_TrayStackerLiftUp,\Mode.Manual,0,\Security.Level,0)[HMI_OutTog(HMI_ManPusher,0,OUT_TrayPusherRet,OUT_TrayPusherExt,1,1,IN_TrayPusherRetd,IN_TrayPusherExtd,\Mode.Manual,0,\Security.Level,0) ,XIC(OUT_TrayPusherExt) [XIO(\TrayElevator.IN_LeftTrayClampRetd) ,XIO(\TrayElevator.IN_RightTrayClampRetd) ,XIO(IN_TrayStackerLiftUp) ] OTE(HMI_ManPusher.InterlockActive) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[SensorDebouncer(AOI_SensorDebouncerFullStack,IN_TrayStackFull,250,100,TrayStackFull,0)SensorDebouncer(AOI_SensorDebouncerStackAtDoor,IN_FullStackAtDoor,250,100,FullStackAtDoor,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STATE 0
Power Off / Safety Circuit Opened]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])XIC(SafeOK)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 10
Ready / Idle

NOTE: The lift can be either up or down when pusher is extended, but it needs to be up when its retracted.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(\Mode.Auto)[XIC(IN_TrayStackerLiftUp) XIC(IN_TrayPusherRetd) XIC(\TrayElevator.TrayInPosition) XIO(\TrayElevator.OKRemoveFullTray) XIC(\TrayElevator.ClearOfTrayLoadArea) MOV(15,Control.StateReg) ,[XIC(IN_TrayStackerLiftUp) ,XIC(IN_TrayStackerLiftDwn) [XIC(TrayStackFull) ,XIC(StackFullMemory) ] XIO(FullStackAtDoor) ] XIC(IN_TrayPusherExtd) OTE(OKReleaseTray) ,[XIC(IN_TrayStackerLiftDwn) [XIC(TrayStackFull) ,XIC(StackFullMemory) ] XIO(FullStackAtDoor) ,XIC(IN_TrayStackerLiftUp) ] XIC(IN_TrayPusherExtd) XIC(\TrayElevator.OKRemoveFullTray) XIC(\TrayElevator.ClearOfTrayLoadArea) XIC(\RobotUnload.ClearOfTrayStacker) MOV(22,Control.StateReg) ,XIO(IN_TrayStackerLiftUp) XIO(TrayStackFull) XIO(StackFullMemory) MOV(26,Control.StateReg) ,XIC(IN_TrayStackerLiftUp) XIO(IN_TrayPusherRetd) XIO(IN_TrayPusherExtd) [XIC(\TrayElevator.TrayInPosition) MOV(41,Control.StateReg) ,XIC(\TrayElevator.OKRemoveFullTray) XIC(\TrayElevator.ClearOfTrayLoadArea) XIC(\RobotUnload.ClearOfTrayStacker) MOV(42,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 15
-Tray Pusher To Load Position
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTL(OUT_TrayPusherExt) OTU(OUT_TrayPusherRet) ,MOV(20,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_TrayPusherExtd) [XIC(TrayStackFull) OTL(StackFullMemory) MOV(16,Control.StateReg) ,XIO(TrayStackFull) MOV(10,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 16
Tray Stacker Lift Retract/Down (Stack is full)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[OTL(OUT_TrayStackerLiftDwn) OTU(OUT_TrayStackerLiftUp) ,MOV(200,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_TrayStackerLiftDwn) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 22
-Tray Pusher To Lift Position
-Reset Tray Load Position For Robot
-Reset Stack Full Memory When We Are Retracted]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[22])[OTL(OUT_TrayPusherRet) OTU(OUT_TrayPusherExt) ,ONS(OneShot.22) MOV(1,\TrayElevator.TrayPosIndex) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_TrayPusherRetd) OTU(StackFullMemory) MOV(25,Control.StateReg) ,XIO(\RobotUnload.ClearOfTrayStacker) OTL(Fault[5].Active) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 25
Tray Stacker Lift Retract/Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[OTL(OUT_TrayStackerLiftDwn) OTU(OUT_TrayStackerLiftUp) ,MOV(300,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_TrayStackerLiftDwn) MOV(26,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 26
Tray Stacker Lift Extend/Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[26])[OTL(OUT_TrayStackerLiftUp) OTU(OUT_TrayStackerLiftDwn) ,MOV(300,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_TrayStackerLiftUp) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 40
--Recovery--
Tray Stacker Lift Extend/Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[40])[OTL(OUT_TrayStackerLiftUp) OTU(OUT_TrayStackerLiftDwn) ,MOV(300,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_TrayStackerLiftUp) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 41
--Recovery--
-Tray Pusher Extend
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[41])[OTL(OUT_TrayPusherExt) OTU(OUT_TrayPusherRet) ,MOV(20,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_TrayPusherExtd) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 42
--Recovery--
-Tray Pusher Retract
-Reset Tray Load Position For Robot
-Reset Stack Full Memory When We Are Retracted]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[42])[OTL(OUT_TrayPusherRet) OTU(OUT_TrayPusherExt) ,ONS(OneShot.28) MOV(1,\TrayElevator.TrayPosIndex) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_TrayPusherRetd) OTU(StackFullMemory) MOV(10,Control.StateReg) ,XIO(\RobotUnload.ClearOfTrayStacker) OTL(Fault[5].Active) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 127
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])XIO(FaultActive)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(FaultActive)MOV(127,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
