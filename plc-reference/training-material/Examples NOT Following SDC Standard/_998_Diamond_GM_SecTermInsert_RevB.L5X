<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Visibility Condition For Status Indicator On Main Screen]]>
</Comment>
<Text>
<![CDATA[EQU(\HMI.CurrentScreenNum,31)OTE(Active)XIC(\Main.FlashSlow)OTE(HMI_PreOpStatusVisibility);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_CoilLead51Bend,1,CheckCmpltHVWire51Bend,DummyBOOL,0,0,0,0,\Mode.Manual,0,\Security.Level,0) ,XIC(EnableInterlock) XIO(CheckCmpltHVWire51Bend) OTE(HMI_CoilLead51Bend.InterlockActive) ][HMI_OutTog(HMI_TowerLead90Bend,1,CheckCmpltHVWire90Bend,DummyBOOL,0,0,0,0,\Mode.Manual,0,\Security.Level,0) ,XIC(EnableInterlock) XIO(CheckCmpltHVWire90Bend) OTE(HMI_TowerLead90Bend.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_Diode60Bend,1,CheckCmpltDiode60Bend,DummyBOOL,0,0,0,0,\Mode.Manual,0,\Security.Level,0) ,XIC(EnableInterlock) XIO(CheckCmpltDiode60Bend) OTE(HMI_Diode60Bend.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_TerminalDepth,1,CheckCmpltTerminalDepth,DummyBOOL,0,0,0,0,\Mode.Manual,0,\Security.Level,0) ,XIC(EnableInterlock) XIO(CheckCmpltTerminalDepth) OTE(HMI_TerminalDepth.InterlockActive) ][HMI_OutTog(HMI_TerminalXPos,1,CheckCmpltTerminalXPos,DummyBOOL,0,0,0,0,\Mode.Manual,0,\Security.Level,0) ,XIC(EnableInterlock) XIO(CheckCmpltTerminalXPos) OTE(HMI_TerminalXPos.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_Continuity,1,CheckCmpltContinuity,DummyBOOL,0,0,0,0,\Mode.Manual,0,\Security.Level,0) ,XIC(EnableInterlock) XIO(CheckCmpltContinuity) OTE(HMI_Continuity.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(CheckCmpltHVWire51Bend)XIC(CheckCmpltHVWire90Bend)XIC(CheckCmpltDiode60Bend)XIC(CheckCmpltTerminalDepth)XIC(CheckCmpltTerminalXPos)XIC(CheckCmpltContinuity)OTE(PreOpComplete);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(Active)XIC(PreOpComplete)ONS(OneShot.0)OTU(CheckCmpltHVWire51Bend)OTU(CheckCmpltHVWire90Bend)OTU(CheckCmpltDiode60Bend)OTU(CheckCmpltDiode90Bend)OTU(CheckCmpltTerminalDepth)OTU(CheckCmpltTerminalXPos)OTU(CheckCmpltContinuity);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
