<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[MOV(0,FileName.LEN) MOV(0,posSeparator) MOV(0,posJPG) ,SIZE(REAL_Array,0,ArraySize) [MUL(ArraySize,4,ArrayByteSize) ,CMP(ArrayByteSize - (FilePathArrayStartIndex * 4) > 82) CPT(ArrayByteSize,82 + (FilePathArrayStartIndex * 4)) ] ,CPT(FilePath.LEN,ArrayByteSize - (FilePathArrayStartIndex * 4)) COP(REAL_Array[FilePathArrayStartIndex],FilePath.DATA[0],FilePath.LEN) ,[FIND(FilePath,ascSeparator,10,posSeparator) ,[GRT(posSeparator,1) [FIND(FilePath,ascJPG_lc,posSeparator,posJPG) ,EQU(posJPG,0) FIND(FilePath,ascJPG_UC,posSeparator,posJPG) ] ,GRT(posJPG,posSeparator) CPT(FileName.LEN,posJPG - posSeparator + 2) COP(FilePath.DATA[posSeparator],FileName.DATA[0],FileName.LEN) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
