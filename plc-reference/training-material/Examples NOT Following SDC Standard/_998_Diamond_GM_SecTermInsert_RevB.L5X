<Rung Number="42" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive) ,ProgramAlarmHandler(AOI_ProgramFaultIndxPermHandler,\Alarms.ProgramID,FaultIndexPerm,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,IndexPermFaultActive) ,ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[[XIC(Status.ResyncRequired) ,XIC(Status.ResyncInProgress) ,XIC(Status.ReadyHandCrank) ,XIC(Status.Faulted) ,XIC(Control.AutoRunChassis) ] OTE(Greyout) ,[XIC(Control.ImmedStop) ,XIO(Control.DialIndexPermsOK) LIM(Setup_DialIndexStartCamPosDeg,Status.CamPosDeg,Setup_DialIndexEndCamPosDeg) ] OTE(HMI_ManJogChassis.InterlockActive) ,XIO(Greyout) XIO(HMI_ManJogChassis.InterlockActive) OTE(OKJog) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_ManJogChassis,0,0,0,AlwaysOff,\Mode.Manual,Greyout,\Security.Level,0,0) ,XIC(HMI_ManJogChassis.VisibilityCondition) XIC(OKJog) XIO(\Mode.IN_CycleStopPB) ]OTE(Control.JogChassis);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(Setup_SafetyCircuitOK) OTE(SafetyCircuitNOK) ,HMI_OpnPopup(HMI_OpenZeroPopupCam,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,50,SafetyCircuitNOK,\Security.Level,10) ,HMI_OpnPopup(HMI_OpenZeroPopupDial,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,51,SafetyCircuitNOK,\Security.Level,10) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[HMI_NumericDispEntry(HMI_JogVel,AlwaysOn,\Security.Level,0,0,DummyDINT,1,Control.Jog.Vel,1,Status.Jogging) ,HMI_NumericDispEntry(HMI_JogAcc,AlwaysOn,\Security.Level,0,0,DummyDINT,1,Control.Jog.Acc,1,Status.Jogging) ,HMI_NumericDispEntry(HMI_JogDec,AlwaysOn,\Security.Level,0,0,DummyDINT,1,Control.Jog.Dec,1,Status.Jogging) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[XIC(Status.Running) ,XIC(Status.Jogging) ,XIC(Status.Stopping) ] OTE(GreyoutRun) ,HMI_NumericDispEntry(HMI_RunVel,AlwaysOn,\Security.Level,10,0,DummyDINT,1,CycleTimeTempREAL,1,GreyoutRun) DIV(360,CycleTimeTempREAL,Control.Run.Vel) TRN(Control.Run.Vel,Control.Run.Vel) ,HMI_NumericDispEntry(HMI_RunAcc,AlwaysOn,\Security.Level,10,0,DummyDINT,1,Control.Run.Acc,1,GreyoutRun) ,HMI_NumericDispEntry(HMI_RunDec,AlwaysOn,\Security.Level,10,0,DummyDINT,1,Control.Run.Dec,1,GreyoutRun) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OilPump" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Status.Running)MOV(1800000,Tmr_Running.PRE)RTO(Tmr_Running,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Tmr_Running.DN) ,XIC(Tmr_OilPump.TT) ]MOV(30000,Tmr_OilPump.PRE)TON(Tmr_OilPump,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Tmr_OilPump.TT)OTE(Setup_OUT_OilPump);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Tmr_Running.DN)RES(Tmr_Running);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PositionCalcs" Type="RLL">
<Description>
<![CDATA[Calculates Cam And Dial Posiitons For Status And Dial Status Bits]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calculate Cam Position for Status
Note : The value is multiplied and divided to remove scientific notation and create a fixed number of decimal places. ]]>
</Comment>
<Text>
<![CDATA[MUL(Setup_CamAxisTag.ActualPosition,10000,CamAxisPosDegREALTemp)TRN(CamAxisPosDegREALTemp,CamAxisPosDegREALTemp)DIV(CamAxisPosDegREALTemp,10000,Status.CamPosDeg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Calculate Dial Position For Status (In Degrees)]]>
</Comment>
<Text>
<![CDATA[MUL(Setup_DialAxisTag.ActualPosition,10000,DialAxisPosDegREALTemp)TRN(DialAxisPosDegREALTemp,DialAxisPosDegREALTemp)DIV(DialAxisPosDegREALTemp,10000,Status.DialPosDeg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Calculate Dial Position For Status (Scaled To Nests)]]>
</Comment>
<Text>
<![CDATA[CPT(DialAxisPosNestsREALTemp,(Setup_DialAxisTag.ActualPosition*Setup_NestQty/360.0)+1)MUL(DialAxisPosNestsREALTemp,10000,DialAxisPosNestsREALTemp)TRN(DialAxisPosNestsREALTemp,DialAxisPosNestsREALTemp)DIV(DialAxisPosNestsREALTemp,10000,Status.DialPosNests);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Calculate The On Station Tolerance Scaled To Nests

Note 1 : On Station Tolerance is given to this Program in degrees. The OnStaTol must be converted to nests in order to find the compare window for being on a station. 

Note 2 : The OnStaTol gets multiplied and divided in order to remove scientific notation and to give the value a fixed number of decimal places.]]>
</Comment>
<Text>
<![CDATA[CPT(OnStaTolNstsREALTemp,Setup_OnStaTolDeg*Setup_NestQty/360.0)MUL(OnStaTolNstsREALTemp,10000,OnStaTolNstsREALTemp)TRN(OnStaTolNstsREALTemp,OnStaTolNstsREALTemp)DIV(OnStaTolNstsREALTemp,10000,OnStationTolNests);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Populate the tracking data with the nest numbers at all stations around the dial. This logic is placed here to prevent scan order issues. (It is closest to the servo position)]]>
</Comment>
<Text>
<![CDATA[JSR(CalcDialStationNestNums,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Calculate Cam Position For Forward/Reverse Resync When Dial is On Station

Calculate Cam Position For Forward/Reverse Resync When Dial Was Not On Station.
By the Time This is Used the Dial Has Already Been Synced to be On Station.]]>
</Comment>
<Text>
<![CDATA[[SUB(Setup_DialIndexEndCamPosDeg,Setup_DialIndexStartCamPosDeg,CamFwdRevPosDeg_Temp) ,LES(CamFwdRevPosDeg_Temp,0) ADD(CamFwdRevPosDeg_Temp,360,CamFwdRevPosDeg_Temp) ,MUL(CamFwdRevPosDeg_Temp,0.1,CamFwdRevPosDeg_Temp) ,SUB(Setup_DialIndexEndCamPosDeg,CamFwdRevPosDeg_Temp,DialOnStaCamFwdRevBndryPosDeg) ,LES(DialOnStaCamFwdRevBndryPosDeg,0) ADD(DialOnStaCamFwdRevBndryPosDeg,360,DialOnStaCamFwdRevBndryPosDeg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Finds the Cam position where the Dial will be unlocked by the shot pin. Assumed to be half way between start and end of Index.]]>
</Comment>
<Text>
<![CDATA[CPT(DialUnlockPos,Setup_DialIndexStartCamPosDeg + (Setup_DialIndexEndCamPosDeg-Setup_DialIndexStartCamPosDeg)*0.5);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[The Dial In Dwell and On Station Status Bits Are Used To Compute Dial in Sync Status : Dial must be located on a Station and main Cam cannot be in the zone where Dial Indexing Occurs.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[LIM(Setup_DialIndexEndCamPosDeg,Status.CamPosDeg,Setup_DialIndexStartCamPosDeg)OTE(Status.CamInDialDwell);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[MOD(Status.DialPosNests,1.0,DiaPosRmndr)[LEQ(DiaPosRmndr,OnStationTolNests) ,SUB(1.0,OnStationTolNests,OnStaTol1Minus) GEQ(DiaPosRmndr,OnStaTol1Minus) ]OTE(Status.DialOnStation);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[ADD(Setup_CamStartupPosDeg,CheckStartStopPosTol,StartupPosCheckHL)[GRT(StartupPosCheckHL,360) SUB(StartupPosCheckHL,360,StartupPosCheckHL) ,LEQ(StartupPosCheckHL,360) ]SUB(Setup_CamStartupPosDeg,8,StartupPosCheckLL)[LES(StartupPosCheckLL,0) ABS(StartupPosCheckLL,StartupPosCheckLL) SUB(360,StartupPosCheckLL,StartupPosCheckLL) ,GEQ(StartupPosCheckLL,0) ]LIM(StartupPosCheckLL,Status.CamPosDeg,StartupPosCheckHL)OTE(Status.AtStartStopPos);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="TorqueLimits" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Shows Utilization Percentages Of The Servo Motors
-For Reference Purposes-]]>
</Comment>
<Text>
<![CDATA[Servo_Capacity(AOI_ServoCapacity_Cam,Setup_CamAxisTag)Servo_Capacity(AOI_ServoCapacity_Dial,Setup_DialAxisTag);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Cam Torque Limit

Change the torque limt dynamically during running

NOTE: A value of 0 in the high torque limit zones will disable higher torque limit adjustments.]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)[[LIM(Setup_HighTorqueEndCamPosDeg1,Setup_CamAxisTag.ActualPosition,Setup_HighTorqueStartCamPosDeg2) ,LIM(Setup_HighTorqueEndCamPosDeg2,Setup_CamAxisTag.ActualPosition,360) ,LIM(0,Setup_CamAxisTag.ActualPosition,Setup_HighTorqueStartCamPosDeg1) ,EQU(Setup_HighTorqueStartCamPosDeg1,0) EQU(Setup_HighTorqueEndCamPosDeg1,0) EQU(Setup_HighTorqueStartCamPosDeg2,0) EQU(Setup_HighTorqueEndCamPosDeg2,0) ] MOV(Setup_ServoTorqueLimitCam_Base,Setup_CamAxisTag.TorqueLimitPositive) ,[NEQ(Setup_HighTorqueStartCamPosDeg1,0) NEQ(Setup_HighTorqueEndCamPosDeg1,0) LIM(Setup_HighTorqueStartCamPosDeg1,Setup_CamAxisTag.ActualPosition,Setup_HighTorqueEndCamPosDeg1) MOV(Setup_ServoTorqueLimitCam_Zone1,Setup_CamAxisTag.TorqueLimitPositive) ,NEQ(Setup_HighTorqueStartCamPosDeg2,0) NEQ(Setup_HighTorqueEndCamPosDeg2,0) LIM(Setup_HighTorqueStartCamPosDeg2,Setup_CamAxisTag.ActualPosition,Setup_HighTorqueEndCamPosDeg2) MOV(Setup_ServoTorqueLimitCam_Zone2,Setup_CamAxisTag.TorqueLimitPositive) ] ]MUL(Setup_CamAxisTag.TorqueLimitPositive,-1,Setup_CamAxisTag.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Dial Servo Motor Torque Limit]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)MOV(Setup_ServoTorqueLimitDial,Setup_DialAxisTag.TorqueLimitPositive)MUL(Setup_DialAxisTag.TorqueLimitPositive,-1,Setup_DialAxisTag.TorqueLimitNegative)MOV(Setup_ServoTorqueLimitDial,Setup_DialAxisTag.TorqueLimitPositive)MUL(Setup_DialAxisTag.TorqueLimitPositive,-1,Setup_DialAxisTag.TorqueLimitNegative)NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_Help_Info" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Tags labeled with " Setup_" are intended to be onetime setup tags.]]>
</Line>
<Line Number="1">
<![CDATA[//]]>
</Line>
<Line Number="2">
<![CDATA[//]]>
</Line>
<Line Number="3">
<![CDATA[//]]>
</Line>
<Line Number="4">
<![CDATA[//]]>
</Line>
<Line Number="5">
<![CDATA[//]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//]]>
</Line>
<Line Number="8">
<![CDATA[//]]>
</Line>
<Line Number="9">
<![CDATA[//]]>
</Line>
<Line Number="10">
<![CDATA[//]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[//]]>
</Line>
<Line Number="13">
<![CDATA[//]]>
</Line>
<Line Number="14">
<![CDATA[//attach inputs for dial index permissives. Top of State Logic Routine]]>
</Line>
<Line Number="15">
<![CDATA[//]]>
</Line>
<Line Number="16">
<![CDATA[//]]>
</Line>
<Line Number="17">
<![CDATA[// Map global fault reset to FaultResetPulse input parameter]]>
</Line>
<Line Number="18">
<![CDATA[// Connect (or Alias) OUT_OilPump to an actual output]]>
</Line>
<Line Number="19">
<![CDATA[// Connect (or Alias) IN_HandCrank to an actual input]]>
</Line>
