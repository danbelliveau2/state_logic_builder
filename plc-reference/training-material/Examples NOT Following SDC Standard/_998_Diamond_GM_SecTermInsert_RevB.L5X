</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Fault[2].Active)XIC(\Main.FaultReset)OTU(Fault[2].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Fault[3].Active)XIC(\Main.FaultReset)OTU(Fault[3].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Fault[4].Active)XIC(\Main.FaultReset)OTU(Fault[4].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="InspectionResults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Part Found]]>
</Comment>
<Text>
<![CDATA[[EQU(VisionInputs.InspectionResults[14],1) ,XIC(BypassCameraResults) ]OTE(PartFound);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Tower Lead
Tip Position And Bend Angle

-Send Vision System Bit to Enable the Short vs Long Tower Wire Length Group ---- NOTE: The changes to the camera input data will take effect after the vision system has been triggered]]>
</Comment>
<Text>
<![CDATA[[XIC(\Recipe.DownloadPulse) [EQU(\Recipe.Data.Running.MachineSetup.HVWire.PartID,1) MOV(1,VisionOutputs.UserData[0]) ,EQU(\Recipe.Data.Running.MachineSetup.HVWire.PartID,2) MOV(0,VisionOutputs.UserData[0]) ] OTL(VisionOutputs.Control.SetUserData) ,XIC(VisionOutputs.Control.SetUserData) TON(Tmr_WaitForAck,?,?) XIC(Tmr_WaitForAck.DN) XIC(VisionInputs.Status.SetUserDataAck) OTU(VisionOutputs.Control.SetUserData) ,[XIC(PartFound) EQU(VisionInputs.InspectionResults[16],1) [EQU(\Recipe.Data.Running.MachineSetup.HVWire.PartID,1) EQU(VisionInputs.InspectionResults[18],1) ,EQU(\Recipe.Data.Running.MachineSetup.HVWire.PartID,2) EQU(VisionInputs.InspectionResults[28],1) ] ,XIC(BypassCameraResults) ] OTE(TowerLeadTipOK) ,[XIC(PartFound) EQU(VisionInputs.InspectionResults[20],1) ,XIC(BypassCameraResults) ] OTE(TowerAngleOK) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Coil Lead
Tip Position]]>
</Comment>
<Text>
<![CDATA[[XIC(PartFound) EQU(VisionInputs.InspectionResults[22],1) EQU(VisionInputs.InspectionResults[24],1) ,XIC(BypassCameraResults) ]OTE(CoilLeadTipOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Optional Tools]]>
</Comment>
<Text>
<![CDATA[[XIC(PartFound) EQU(VisionInputs.InspectionResults[26],1) ,XIC(BypassCameraResults) ]OTE(OptionalOK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_TriggerInspect,0,2000,0,0,\Mode.Manual,0,\Security.Level,0,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManLight,1,OUT_LightSource,DummyTag,0,0,0,0,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_RetryCount,AlwaysOn,\Security.Level,5,1,Retry.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[OTE(VisionOutputs.Control.TriggerEnable);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(InspectionResults,0)JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[XIC(\Safety.EStopNOK) ONS(OneShot.6) OTU(OUT_LightSource) ,XIC(SafeOK) MOV(1,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 1
Ready / Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) [XIO(OUT_LightSource) MOV(2,Control.StateReg) ,XIC(OUT_LightSource) MOV(5,Control.StateReg) ] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) [XIC(OUT_LightSource) MOV(3,Control.StateReg) ,XIO(OUT_LightSource) MOV(4,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 2
Enable Light Source]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])OTL(OUT_LightSource)MOV(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 3
Disable Light Source]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])OTU(OUT_LightSource)MOV(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 4
Station Disabled]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass)XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)MOV(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 5
Ready / Check Camera Status]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(\Mode.Auto) [XIC(VisionInputs.Status.Online) [XIC(VisionInputs.Status.TriggerReady) OTE(ReadyToCycle) Chassis_CamPos_Check(AOI_CamPosChk1,185,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(CycleStation) MOV(6,Control.StateReg) ,XIO(VisionInputs.Status.TriggerReady) MOV(Preset_TriggerNotReady,TmrFlt_NotReady.PRE) TON(TmrFlt_NotReady,?,?) XIC(TmrFlt_NotReady.DN) OTL(Fault[2].Active) ] ,XIO(VisionInputs.Status.Online) [XIO(Fault[1].Active) OTE(Warning[0].Active) ,[XIC(\Mode.CycleStarting) ,XIC(\Mode.CycleRunning) ,XIC(\Mode.AutoJogging) ] OTL(Fault[1].Active) ] ] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(1,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Status.State[5])XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)XIC(\Mode.Manual)XIC(VisionInputs.Status.Online)XIC(VisionInputs.Status.TriggerReady)XIC(HMI_TriggerInspect.EnableOut)ONS(OneShot.2)MOV(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Status.State[5])XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)XIC(\Mode.Manual)XIC(VisionInputs.Status.Online)XIC(VisionInputs.Status.TriggerReady)MOV(Preset_HMIInspectStatusRdy,Tmr_InspectStat.PRE)TON(Tmr_InspectStat,?,?)XIC(Tmr_InspectStat.DN)ONS(OneShot.1)MOV(4,HMI_InspectStatus);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 6
Set Tracking Attempt Bit]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt)MOV(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 7
Capture Inspection ID Before Trigger]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])MOV(1,HMI_InspectStatus)MOV(VisionInputs.InspectionResults[1],VisionStartInspectionID)MOV(8,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 8
-Trigger Vision System
-Check Inspection Results

**Tower Angle Measurement is currently not being used as a pass credential]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])[MOV(2000,Control.FaultTime) OTE(VisionOutputs.Control.Trigger) ,NEQ(VisionInputs.InspectionResults[1],VisionStartInspectionID) [[XIC(PartFound) XIC(TowerLeadTipOK) XIC(TowerAngleOK) XIC(CoilLeadTipOK) XIC(OptionalOK) ,XIC(ProgrammerDebugMakeGood) ] MOV(2,HMI_InspectStatus) MOV(0,Retry.Count) [XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) MOV(0,ConsecFails.Count) XIO(\Mode.Manual) MOV(9,Control.StateReg) ,[XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,XIC(\Mode.Manual) ] MOV(5,Control.StateReg) ] ,XIO(ProgrammerDebugMakeGood) [XIO(PartFound) ,XIO(TowerLeadTipOK) ,XIO(TowerAngleOK) ,XIO(CoilLeadTipOK) ,XIO(OptionalOK) ] MOV(3,HMI_InspectStatus) [LES(Retry.Count,Retry.Setpoint) MOV(10,Control.StateReg) ,GEQ(Retry.Count,Retry.Setpoint) MOV(0,Retry.Count) [XIC(\PreOpCheck.Active) XIC(PartFound) [XIO(TowerLeadTipOK) OTL(\PreOpCheck.CheckCmpltHVWire90Bend) ,XIO(CoilLeadTipOK) OTL(\PreOpCheck.CheckCmpltHVWire51Bend) ] ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ] XIO(\Mode.Manual) MOV(9,Control.StateReg) ,[XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,XIC(\Mode.Manual) ] MOV(5,Control.StateReg) ] ] ] ,XIC(Status.TimeoutFlt) OTL(Fault[3].Active) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 9
Reconcile Tracking Data 

**Tower Angle Measurement is currently not being used as a pass credential]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[9])[[XIO(PartFound) MOV(51,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,XIC(PartFound) [XIO(TowerLeadTipOK) MOV(52,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,XIO(TowerAngleOK) MOV(53,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,XIO(CoilLeadTipOK) MOV(54,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,XIO(OptionalOK) MOV(55,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ] ] ,[GetFTPFilename(AOI_GetFTPFilename,VisionInputs.InspectionResults,2,FileName) MOV(FileName,\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireFilename) ,MOV(VisionInputs.InspectionResults[15],\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireBobbinFixtureScore) ,MOV(VisionInputs.InspectionResults[17],\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireTowerLeadTipPositionX) ,[EQU(\Recipe.Data.Running.MachineSetup.HVWire.PartID,1) MOV(VisionInputs.InspectionResults[19],\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireTowerLeadLength) ,EQU(\Recipe.Data.Running.MachineSetup.HVWire.PartID,2) MOV(VisionInputs.InspectionResults[29],\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireTowerLeadLength) ] ,MOV(VisionInputs.InspectionResults[21],\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireTowerLeadBendAngle) ,MOV(VisionInputs.InspectionResults[23],\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireCoilLeadTipPositionX) ,MOV(VisionInputs.InspectionResults[25],\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireCoilLeadTipPositionY) ,MOV(VisionInputs.InspectionResults[27],\Tracking.Data.Nest[NestNumCurrent].ProcessData.HVWireOptional) ] ,MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 10
*Retry After Failure**
Wait Before Retrigger]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])[MOV(80,Control.FaultTime) ,ONS(OneShot.3) ADD(Retry.Count,1,Retry.Count) ,XIC(Status.TimeoutFlt) MOV(7,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 127
Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])[MOV(3,HMI_InspectStatus) MOV(5,Control.StateReg) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ONS(OneShot.0) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(50,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ] ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(FaultActive)MOV(127,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
