<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<Description>
<![CDATA[Logic For Fault and Warning Messages]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(AlwaysOff)[[XIC(OUT_EscapeSlideExt) XIO(IN_EscapeExtd) ,XIC(OUT_EscapeSlideRet) XIO(IN_EscapeRetd) ] TON(TmrFlt_EscSlide,?,?) XIC(TmrFlt_EscSlide.DN) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) ]OTE(Fault[0].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(AlwaysOff)[[XIC(OUT_EscapeStopUp) XIO(IN_StopUp) ,XIC(OUT_EscapeStopDn) XIC(IN_StopUp) ] TON(TmrFlt_EscStop,?,?) XIC(TmrFlt_EscStop.DN) ,XIC(Fault[1].Active) XIO(\Main.FaultReset) ]OTE(Fault[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(AlwaysOff)XIC(Fault[2].Active)XIC(\Main.FaultReset)OTU(Fault[2].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Manual Control Logic]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManFeeder,1,OUT_FeederEnable,DummyTag,0,0,0,0,\Safety.EStopOK,0,\Security.Level,0)HMI_OutTog(HMI_ManEscapeStop,0,OUT_EscapeStopUp,OUT_EscapeStopDn,1,0,IN_StopUp,0,\Mode.Manual,0,\Security.Level,0)HMI_OutTog(HMI_ManEscapeSlide,0,OUT_EscapeSlideExt,OUT_EscapeSlideRet,1,1,IN_EscapeExtd,IN_EscapeRetd,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SensorDebouncer(AOI_SensorDebouncer,IN_PartPresent,500,100,PartInNest,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****

This State Engine controls the feeder bowl.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])OTU(OUT_FeederEnable)OTU(OUT_FeederAirEnable)[XIC(SafeOK) MOV(5,Control.StateReg) ,XIC(\Safety.EStopOK) XIO(\Safety.GuardOK) MOV(1,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 1
Guarding Open]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIC(\Main.GrdOpnShutOffFdrs) MOV(20,Control.StateReg) ,XIC(\Safety.EStopOK) XIC(\Safety.GuardOK) MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 5
Ready / Idle
Feeder NOT Enabled]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])[ONS(OneShot.5) OTU(OUT_FeederAirEnable) OTU(OUT_FeederEnable) ,[XIC(\Mode.Auto) ,XIC(debugBIT.4) ] XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) [XIC(IN_StopUp) ,XIC(IN_EscapeRetd) ] MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 10
Feeder Running w/ Machine Auto Mode
-OK To Pick (If Part In The Nest)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])[ONS(OneShot.10) OTL(OUT_FeederEnable) OTL(OUT_FeederAirEnable) ,XIC(IN_EscapeRetd) [XIC(PartInNest) [[XIC(\Mode.CycleRunning) ,XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ,XIC(\Mode.AutoJogging) ] OTE(\RobotBobbin.Outputs.UserOut[1].0) ,[XIO(IN_StopUp) XIC(OUT_EscapeStopDn) MOV(15,Control.StateReg) ,XIC(IN_StopUp) XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.Inputs.Insidebox4) XIC(\RobotBobbin.Inputs.UserIn[0].2) XIC(\RobotBobbin.Inputs.UserIn[1].0) MOV(16,Control.StateReg) ] ] ,XIO(PartInNest) [XIO(IN_StopUp) XIC(OUT_EscapeStopDn) [TON(TmrFlt_TrackEmpty,?,?) ,GRT(TmrFlt_TrackEmpty.ACC,TrackLowWarnTime) OTE(Warning[0].Active) ,XIC(TmrFlt_TrackEmpty.DN) OTL(Fault[2].Active) ] ,TON(Tmr_PartNotNest,?,?) XIC(Tmr_PartNotNest.DN) MOV(25,Control.StateReg) ] ] ,XIO(IN_EscapeRetd) [XIC(\RobotBobbin.ClearOfBobbinFeeder) ,XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.Inputs.Insidebox4) XIO(\RobotBobbin.Inputs.UserIn[0].2) XIO(\RobotBobbin.Inputs.UserIn[1].0) ] MOV(20,Control.StateReg) ,[XIC(\Mode.Manual) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) ] MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 15
Stop Finger Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTL(OUT_EscapeStopUp) OTU(OUT_EscapeStopDn) ,MOV(20,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_StopUp) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 16
Escapement Extend To Release Bobbin]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[OTL(OUT_EscapeSlideExt) OTU(OUT_EscapeSlideRet) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_EscapeExtd) MOV(17,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 17
Bobbin Released Signal To Robot

Set PartLoaded bit for the bobbin robot -- Tracking Nest 0  and Station 0 is used ]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[17])[OTE(\RobotBobbin.Outputs.UserOut[1].8) ,ONS(OneShot.17) OTL(\Tracking.Data.Nest[NestNumRobot].PartStatus.Good) OTL(\Tracking.Data.Nest[NestNumRobot].PartStatus.PartLoaded) ,XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.ClearOfBobbinFeeder) MOV(20,Control.StateReg) ,[XIC(\Mode.Manual) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) ] MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 20
Escapement Retract To Home]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])[OTL(OUT_EscapeSlideRet) OTU(OUT_EscapeSlideExt) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_EscapeRetd) MOV(25,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 25
Escapement Stop Finger Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[OTL(OUT_EscapeStopDn) OTU(OUT_EscapeStopUp) ,MOV(10,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIO(IN_StopUp) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 125
--Faulted--]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])[ONS(OneShot.31) OTU(OUT_FeederEnable) OTU(OUT_FeederAirEnable) ,XIO(FaultActive) MOV(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(FaultActive)MOV(125,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(\Safety.GuardOK)ONS(OneShot.11)MOV(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIO(\Safety.EStopOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
