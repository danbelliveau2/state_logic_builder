</StructureMember>
<StructureMember Name="IDCTerminal" DataType="Recipe_ComponentData">
<StructureMember Name="PartNum" DataType="STRING30">
<DataValueMember Name="LEN" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="DATA" DataType="STRING30" Radix="ASCII">
<![CDATA[]]>
</DataValueMember>
</StructureMember>
<DataValueMember Name="PartID" DataType="DINT" Radix="Decimal" Value="0"/>
</StructureMember>
<DataValueMember Name="TheoreticalRatePerMin" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="StandardCycleTimeSecs" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="HVWireFeedOsffsetDistForm" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="HVWireFeedOffsetDistShear" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="HVWireInsertOffsetDist" DataType="REAL" Radix="Float" Value="0.0"/>
</StructureMember>
</Structure>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[GEQ(ConsecutiveFailures,4) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) ]XIO(HMI_Bypass)[OTE(Fault[0].Active) ,MOV(0,ConsecutiveFailures) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(Handshake.HeartbeatTimeout) XIO(HMI_Bypass) OTE(Warning[0].Active) ,XIC(Warning[0].Active) [XIC(\Main.FaultReset) ,XIC(HMI_Bypass) ] [MOV(0,Handshake.HeartbeatRetryCount) ,OTU(Handshake.HeartbeatTimeout) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Handshake.ResultTimeout)XIO(HMI_Bypass)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Handshake.FailureResult)XIO(HMI_Bypass)OTE(Warning[2].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Handshake" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Logic,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Data logging handshaking with Ignition.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(HMI_Bypass)ONS(OneShot.0)[[MOV(0,ConsecutiveFailures) ,MOV(0,Handshake.HeartbeatRetryCount) ] ,[OTU(Handshake.ResultTimeout) ,OTU(Handshake.HeartbeatTimeout) ,OTU(Handshake.SuccessResult) ,OTU(Handshake.FailureResult) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[New trigger sets up timers, set the trigger for Ignition to see, and resets all results.

If the echo tag isn't on, something's wrong.
Ignition won't trigger logging without a false-to-true transition
so the trigger must be confirmed to be off before we turn in back on.]]>
</Comment>
<Text>
<![CDATA[XIC(Handshake.Trigger)ONS(OneShot.1)[MOV(Handshake.TransactionID,Handshake.TransactionIDSaved) ,MOV(Handshake.ResultTimeoutPreset,Handshake.ResultTimer.PRE) ,[OTU(Handshake.ResultTimeout) ,OTU(Handshake.HeartbeatTimeout) ,OTU(Handshake.SuccessResult) ,OTU(Handshake.FailureResult) ,OTL(Handshake.WaitingForResult) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
Heartbeat and timeouts]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(Handshake.HeartbeatIgnition)ONS(OneShot.3)[OTL(Handshake.HeartbeatPLC) ,MOV(0,Handshake.HeartbeatRetryCount) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Handshake.HeartbeatIgnition)ONS(OneShot.4)[OTU(Handshake.HeartbeatPLC) ,MOV(0,Handshake.HeartbeatRetryCount) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Handshake.HeartbeatPLC)[TON(Handshake.HeartbeatOnTImer,?,?) ,XIC(Handshake.HeartbeatOnTImer.DN) [XIO(Handshake.HeartbeatTimeout) ADD(Handshake.HeartbeatRetryCount,1,Handshake.HeartbeatRetryCount) ,[GEQ(Handshake.HeartbeatRetryCount,4) OTL(Handshake.HeartbeatTimeout) ,LES(Handshake.HeartbeatRetryCount,4) OTU(Handshake.HeartbeatPLC) ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(Handshake.HeartbeatPLC)[TON(Handshake.HeartbeatOffTimer,?,?) ,XIC(Handshake.HeartbeatOffTimer.DN) [XIO(Handshake.HeartbeatTimeout) ADD(Handshake.HeartbeatRetryCount,1,Handshake.HeartbeatRetryCount) ,[GEQ(Handshake.HeartbeatRetryCount,4) OTL(Handshake.HeartbeatTimeout) ,LES(Handshake.HeartbeatRetryCount,4) OTL(Handshake.HeartbeatPLC) ] ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Handshake.Trigger)[TON(Handshake.ResultTimer,?,?) ,XIC(Handshake.ResultTimer.DN) [OTL(Handshake.ResultTimeout) ,OTU(Handshake.Trigger) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Result or timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Handshake.SuccessResult) ,XIC(Handshake.FailureResult) ,XIC(Handshake.HeartbeatTimeout) ,XIC(Handshake.ResultTimeout) ]ONS(OneShot.2)OTU(Handshake.Trigger);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Busy signal can be stuck on if code faulted.]]>
</Comment>
<Text>
<![CDATA[XIC(Handshake.ResultTimeout)ONS(OneShot.5)OTU(Handshake.IgnitionBusy);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//This routine handles keeping a FIFO Buffer (Queue) of data if the network is down and logging is not occurring.]]>
</Line>
<Line Number="1">
<![CDATA[//The buffer also handles simultaneous data in the case of reject and good stations.]]>
</Line>
<Line Number="2">
<![CDATA[//In that case, good should write to NewData and a NewDataReject# tag should be created for each]]>
</Line>
<Line Number="3">
<![CDATA[//reject station to write to.]]>
</Line>
<Line Number="4">
<![CDATA[SIZE(Buffer,0,BufferArraySize);]]>
</Line>
<Line Number="5">
<![CDATA[ArraySizeMinusOne := BufferArraySize - 1; //COP instruction length parameter can't be an expression, so math is done here.]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[if (\Mode.AutoPulse OR \Main.FaultReset OR CalcDequeuePos) then]]>
</Line>
<Line Number="9">
<![CDATA[	//Handle initializing BufferDequeuPos and occasionally brute-force making sure it's accurate.]]>
</Line>
<Line Number="10">
<![CDATA[	//This is here striclty for special cases like code download.]]>
</Line>
<Line Number="11">
<![CDATA[	//Other code that adds or removes from Buffer[] must update BufferDequeuPos]]>
</Line>
<Line Number="12">
<![CDATA[	CalcDequeuePos := 0;]]>
</Line>
<Line Number="13">
<![CDATA[	BufferDequeuPos := ArraySizeMinusOne;]]>
</Line>
<Line Number="14">
<![CDATA[	for i := 0 to ArraySizeMinusOne by 1 do]]>
</Line>
<Line Number="15">
<![CDATA[		if (Buffer[i].PartStatus.PartLoaded) then]]>
</Line>
<Line Number="16">
<![CDATA[			exit; //exit for loop]]>
</Line>
<Line Number="17">
<![CDATA[		end_if;]]>
</Line>
<Line Number="18">
<![CDATA[	end_for;]]>
</Line>
<Line Number="19">
<![CDATA[	BufferDequeuPos := i; //Either position has data and i is 0 to ArraySizeMinusOne or no data and i is BufferArraySize.]]>
</Line>
<Line Number="20">
<![CDATA[end_if;]]>
</Line>
<Line Number="21">
<![CDATA[			]]>
</Line>
<Line Number="22">
<![CDATA[//Move new data into the Buffer.]]>
</Line>
<Line Number="23">
<![CDATA[//Add one of these code blocks for each NewData tag.]]>
</Line>
<Line Number="24">
<![CDATA[//i.e. NewDataReject1, NewDataReject2, etc.]]>
</Line>
<Line Number="25">
<![CDATA[NewData_Exists := (NewData.PartStatus.PartLoaded AND (NewData.PartStatus.FailureType > 0 OR NewData.ProcessData.HVWireFilename.LEN > 0 OR NewData.ProcessData.DiodeFilename.LEN > 0 OR NewData.ProcessData.IDCTerminalFilename.LEN > 0));]]>
</Line>
<Line Number="26">
<![CDATA[if (NewData_Exists) then]]>
</Line>
<Line Number="27">
<![CDATA[	//New data detected]]>
</Line>
<Line Number="28">
<![CDATA[	COP(Buffer[1],Buffer[0],ArraySizeMinusOne); //Shift]]>
</Line>
<Line Number="29">
<![CDATA[	COP(NewData,Buffer[ArraySizeMinusOne],1); //Enqueue]]>
</Line>
<Line Number="30">
<![CDATA[	COP(ZeroLoggingData,NewData,1);]]>
</Line>
<Line Number="31">
<![CDATA[	if (BufferDequeuPos > 0) then]]>
</Line>
<Line Number="32">
<![CDATA[		//Dequeue position moves if the queue isn't already full]]>
</Line>
<Line Number="33">
<![CDATA[		BufferDequeuPos := BufferDequeuPos - 1;]]>
</Line>
<Line Number="34">
<![CDATA[	end_if;]]>
</Line>
<Line Number="35">
<![CDATA[else]]>
</Line>
<Line Number="36">
<![CDATA[	//Data was empty ]]>
</Line>
<Line Number="37">
<![CDATA[	COP(ZeroLoggingData,NewData,1);]]>
</Line>
<Line Number="38">
<![CDATA[end_if;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[//Move new data into the Buffer.]]>
</Line>
<Line Number="41">
<![CDATA[//Add one of these code blocks for each NewData tag.]]>
</Line>
<Line Number="42">
<![CDATA[//i.e. NewDataReject1, NewDataReject2, etc.]]>
</Line>
<Line Number="43">
<![CDATA[NewDataReject1_Exists := (NewDataReject1.PartStatus.PartLoaded AND (NewDataReject1.PartStatus.FailureType > 0 OR NewDataReject1.ProcessData.HVWireFilename.LEN > 0 OR NewDataReject1.ProcessData.DiodeFilename.LEN > 0 OR NewDataReject1.ProcessData.IDCTerminalFilename.LEN > 0));]]>
</Line>
<Line Number="44">
<![CDATA[if (NewDataReject1_Exists) then]]>
</Line>
<Line Number="45">
<![CDATA[	//New data detected]]>
</Line>
<Line Number="46">
<![CDATA[	COP(Buffer[1],Buffer[0],ArraySizeMinusOne); //Shift]]>
</Line>
<Line Number="47">
<![CDATA[	COP(NewDataReject1,Buffer[ArraySizeMinusOne],1); //Enqueue]]>
</Line>
<Line Number="48">
<![CDATA[	COP(ZeroLoggingData,NewDataReject1,1);]]>
</Line>
<Line Number="49">
<![CDATA[	if (BufferDequeuPos > 0) then]]>
</Line>
<Line Number="50">
<![CDATA[		//Dequeue position moves if the queue isn't already full]]>
</Line>
<Line Number="51">
<![CDATA[		BufferDequeuPos := BufferDequeuPos - 1;]]>
</Line>
<Line Number="52">
<![CDATA[	end_if;]]>
</Line>
<Line Number="53">
<![CDATA[else]]>
</Line>
<Line Number="54">
<![CDATA[	//Data was empty ]]>
</Line>
<Line Number="55">
<![CDATA[	COP(ZeroLoggingData,NewDataReject1,1);]]>
</Line>
<Line Number="56">
<![CDATA[end_if;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[//Move data from the Buffer to the Data Logging UDT]]>
</Line>
<Line Number="59">
<![CDATA[Data_Exists := (Data.PartStatus.PartLoaded AND (Data.PartStatus.FailureType > 0 OR Data.ProcessData.HVWireFilename.LEN > 0 OR Data.ProcessData.DiodeFilename.LEN > 0 OR Data.ProcessData.IDCTerminalFilename.LEN > 0));]]>
</Line>
<Line Number="60">
<![CDATA[if (NOT Data_Exists AND Handshake.IgnitionReady AND NOT Handshake.IgnitionBusy AND NOT Handshake.HeartbeatTimeout AND NOT Fault[0].Active AND NOT HMI_Bypass) then]]>
</Line>
<Line Number="61">
<![CDATA[	//Data logging UDT is available and no faults.]]>
</Line>
<Line Number="62">
<![CDATA[	if ((BufferDequeuPos >= 0) AND (BufferDequeuPos < BufferArraySize)) then]]>
</Line>
<Line Number="63">
<![CDATA[		//There's something waiting in the buffer to log]]>
</Line>
<Line Number="64">
<![CDATA[		Buffer_Exists := (Buffer[BufferDequeuPos].PartStatus.PartLoaded AND (Buffer[BufferDequeuPos].PartStatus.FailureType > 0 OR Buffer[BufferDequeuPos].ProcessData.HVWireFilename.LEN > 0 OR Buffer[BufferDequeuPos].ProcessData.DiodeFilename.LEN > 0 OR Buffer[BufferDequeuPos].ProcessData.IDCTerminalFilename.LEN > 0));]]>
</Line>
<Line Number="65">
<![CDATA[		if (Buffer[BufferDequeuPos].PartStatus.PartLoaded) then]]>
</Line>
<Line Number="66">
<![CDATA[			Echo_IsEmpty := (Echo.PartStatus.FailureType = 0 AND Echo.ProcessData.HVWireFilename.LEN = 0 AND Echo.ProcessData.DiodeFilename.LEN = 0 AND Echo.ProcessData.IDCTerminalFilename.LEN = 0);]]>
</Line>
<Line Number="67">
<![CDATA[			if (Echo_IsEmpty) then]]>
</Line>
<Line Number="68">
<![CDATA[				//Ignition may be ready for new data if it's seen the Trigger turn off and echoes are clear.]]>
</Line>
<Line Number="69">
<![CDATA[				COP(Buffer[BufferDequeuPos],Data,1); //Dequeue]]>
</Line>
<Line Number="70">
<![CDATA[				COP(ZeroLoggingData,Buffer[BufferDequeuPos],1);]]>
</Line>
<Line Number="71">
<![CDATA[				BufferDequeuPos := BufferDequeuPos + 1;]]>
</Line>
<Line Number="72">
<![CDATA[			else]]>
</Line>
<Line Number="73">
<![CDATA[				//Trigger was left on?]]>
</Line>
<Line Number="74">
<![CDATA[				//because Ignition isn't running, network problem, it's broken, crap code, etc....]]>
</Line>
<Line Number="75">
<![CDATA[				Handshake.Trigger := 0;]]>
</Line>
<Line Number="76">
<![CDATA[				//TODO: Fault?]]>
</Line>
<Line Number="77">
<![CDATA[			end_if;]]>
</Line>
<Line Number="78">
<![CDATA[		else]]>
</Line>
<Line Number="79">
<![CDATA[			//TODO: Figure out why I'm dequeuing empty data when I shouldn't be.]]>
</Line>
<Line Number="80">
<![CDATA[			//Could be parts with a FailureType but no Filenames. <- added FailureType 2022-03-24]]>
</Line>
<Line Number="81">
<![CDATA[			CountEmptyDequeueAttempts := CountEmptyDequeueAttempts + 1;]]>
</Line>
<Line Number="82">
<![CDATA[			CalcDequeuePos := 1;]]>
</Line>
<Line Number="83">
<![CDATA[		end_if;]]>
</Line>
<Line Number="84">
<![CDATA[	end_if;]]>
</Line>
<Line Number="85">
<![CDATA[end_if;	]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[Data_Exists := (Data.PartStatus.PartLoaded AND (Data.PartStatus.FailureType > 0 OR Data.ProcessData.HVWireFilename.LEN > 0 OR Data.ProcessData.DiodeFilename.LEN > 0 OR Data.ProcessData.IDCTerminalFilename.LEN > 0));]]>
</Line>
<Line Number="88">
<![CDATA[if (Data_Exists AND Handshake.IgnitionReady AND NOT Handshake.IgnitionBusy AND NOT Handshake.HeartbeatTimeout AND NOT Handshake.Trigger) then]]>
</Line>
<Line Number="89">
<![CDATA[	//Waiting for echo confirmation that Ignition has up-to-date data.]]>
</Line>
<Line Number="90">
<![CDATA[	Echo_Updated := (Data.PartStatus.FailureType = Echo.PartStatus.FailureType AND Data.ProcessData.HVWireFilename = Echo.ProcessData.HVWireFilename AND Data.ProcessData.DiodeFilename = Echo.ProcessData.DiodeFilename AND Data.ProcessData.IDCTerminalFilename = Echo.ProcessData.IDCTerminalFilename);]]>
</Line>
<Line Number="91">
<![CDATA[	if (Echo_Updated) then]]>
</Line>
<Line Number="92">
<![CDATA[		//Confirmed Ignition has up-to-date data.]]>
</Line>
<Line Number="93">
<![CDATA[		Handshake.Trigger := 1; //Trigger Ignition data logging.]]>
</Line>
<Line Number="94">
<![CDATA[		Handshake.WaitingForResult := 0; //Handshake routine will set THIS. Resetting it here ensures the following "if" statement doesn't scan prematurely.]]>
</Line>
<Line Number="95">
<![CDATA[	else]]>
</Line>
<Line Number="96">
<![CDATA[		//TODO: Timeout fault?]]>
</Line>
<Line Number="97">
<![CDATA[		CountEchoDataNotSync := CountEchoDataNotSync + 1;]]>
</Line>
<Line Number="98">
<![CDATA[	end_if;]]>
</Line>
<Line Number="99">
<![CDATA[end_if;]]>
</Line>
<Line Number="100">
<![CDATA[]]>
</Line>
<Line Number="101">
<![CDATA[//Check results.]]>
</Line>
<Line Number="102">
<![CDATA[Data_Exists := (Data.PartStatus.PartLoaded AND (Data.PartStatus.FailureType > 0 OR Data.ProcessData.HVWireFilename.LEN > 0 OR Data.ProcessData.DiodeFilename.LEN > 0 OR Data.ProcessData.IDCTerminalFilename.LEN > 0));]]>
</Line>
<Line Number="103">
<![CDATA[if (Data_Exists AND Handshake.WaitingForResult) then]]>
</Line>
<Line Number="104">
<![CDATA[	if (Handshake.SuccessResult) then]]>
</Line>
<Line Number="105">
<![CDATA[		Handshake.WaitingForResult := 0;]]>
</Line>
<Line Number="106">
<![CDATA[		ConsecutiveFailures := 0;]]>
</Line>
<Line Number="107">
<![CDATA[		COP(ZeroLoggingData,Data,1);]]>
</Line>
<Line Number="108">
<![CDATA[	elsif (Handshake.HeartbeatTimeout OR Handshake.ResultTimeout OR Handshake.FailureResult) then]]>
</Line>
<Line Number="109">
<![CDATA[		//Data is returned to the buffer if the buffer isn't full.]]>
</Line>
<Line Number="110">
<![CDATA[		//ConsecutiveFailures is used to prevent retrying too many times.]]>
</Line>
<Line Number="111">
<![CDATA[		Handshake.WaitingForResult := 0;]]>
</Line>
<Line Number="112">
<![CDATA[		ConsecutiveFailures := ConsecutiveFailures + 1;]]>
</Line>
<Line Number="113">
<![CDATA[		if ((BufferDequeuPos > 0) AND (BufferDequeuPos <= BufferArraySize)) then]]>
</Line>
<Line Number="114">
<![CDATA[			//If dequeue position is 0, buffer is now full. This data is lost.]]>
</Line>
<Line Number="115">
<![CDATA[			BufferDequeuPos := BufferDequeuPos - 1;]]>
</Line>
<Line Number="116">
<![CDATA[			COP(Data,Buffer[BufferDequeuPos],1); //Put data back in the buffer]]>
</Line>
<Line Number="117">
<![CDATA[		end_if;]]>
</Line>
<Line Number="118">
<![CDATA[]]>
</Line>
<Line Number="119">
<![CDATA[		//Clear the Data tag. This will cause the next data to dequeue from the buffer and trigger logging again.]]>
</Line>
<Line Number="120">
<![CDATA[		COP(ZeroLoggingData,Data,1);]]>
</Line>
<Line Number="121">
<![CDATA[	end_if;]]>
</Line>
<Line Number="122">
<![CDATA[end_if;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
<Program Name="Main" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" Class="Standard" UseAsFolder="false">
