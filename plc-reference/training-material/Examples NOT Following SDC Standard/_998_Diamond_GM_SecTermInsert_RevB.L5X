<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC
NOTE: when a stop command is issued to the Epson controller, the Error status bit coming from the controller gets cleared]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Fault when the robot has a general error. (occurs when there is NOT a robot user defined error).
Robot User Faults are 8000 series numbers]]>
</Comment>
<Text>
<![CDATA[XIO(SafetyOpened)[XIC(\Mode.Auto) ,XIC(AlwaysOn) ]XIC(Inputs.AutoMode)XIC(Inputs.Error)[LES(Inputs.UserWord[0],8000) ,GRT(Inputs.UserWord[0],8999) ]ONS(OneShotFlt.0)OTL(Fault[0].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Fault[0].Active)XIC(\Main.FaultReset)OTU(Fault[0].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(AlwaysOn) [XIC(Outputs.SetMotorsOn) XIO(Inputs.MotorOn) ,XIC(StartCmdActive) XIO(Inputs.Running) ,XIC(Outputs.Reset) XIC(Inputs.Error) ,XIC(Outputs.StopCmd) XIO(Inputs.Paused) ] TON(TmrFlt_RbtStartUp,?,?) XIC(TmrFlt_RbtStartUp.DN) ,XIC(Fault[1].Active) XIO(\Main.FaultReset) ]OTE(Fault[1].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(AlwaysOn) XIC(SafeOK) XIC(\Mode.Auto) [XIO(Inputs.AutoMode) ,XIC(Inputs.AutoMode) XIC(RobotInit) [XIO(Inputs.Running) ,XIC(Inputs.Paused) ] XIO(Inputs.Error) TON(TmrFlt_RbtNotRdy,?,?) XIC(TmrFlt_RbtNotRdy.DN) ONS(OneShotFlt.2) ] ,XIC(Fault[2].Active) XIO(\Main.FaultReset) ]OTE(Fault[2].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fault when the robot has a general error. (occurs when there is NOT a robot user defined error).
Robot User Faults are 8000 series numbers]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[User errors not handled individually by other fault messages.]]>
</Comment>
<Text>
<![CDATA[[XIC(RobotInit) XIC(Inputs.Error) GRT(Inputs.UserWord[0],8000) LEQ(Inputs.UserWord[0],8999) ONS(OneShotFlt.4) ,XIC(Fault[3].Active) XIO(\Main.FaultReset) ]OTE(Fault[3].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(Outputs.SetMotorsOn) ,XIC(StartCmdActive) ]OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_Speed,AlwaysOn,\Security.Level,0,0,DummyDINT,0,DummyREAL,1,0)MOV(HMI_Speed.Value,Outputs.UserWord[0])[DIV(Inputs.UserWord[1],10,HMI_CurrentXPos) ,DIV(Inputs.UserWord[2],10,HMI_CurrentYPos) ,DIV(Inputs.UserWord[3],10,HMI_CurrentZPos) ,DIV(Inputs.UserWord[4],10,HMI_CurrentUPos) ,DIV(Inputs.UserWord[5],10,HMI_CurrentVPos) ,DIV(Inputs.UserWord[6],10,HMI_CurrentWPos) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[-Momentary Pushbutton Logic (These items are controlled by the State Logic).]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_DefineCoord,1,2000,1,0,1,0,\Security.Level,10,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_MoveHome,0,2000,1,Inputs.UserIn[2].4,1,0,\Security.Level,0,0)OTE(Outputs.UserOut[3].2);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_MovePick,0,2000,1,Inputs.UserIn[2].0,1,0,\Security.Level,0,0)OTE(Outputs.UserOut[3].4);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_MoveTray,0,2000,1,Inputs.UserIn[2].1,1,0,\Security.Level,0,0)OTE(Outputs.UserOut[3].5);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_MoveReject,0,2000,1,Inputs.UserIn[2].2,1,0,\Security.Level,0,0)OTE(Outputs.UserOut[3].6);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_MovePreOp,0,2000,1,Inputs.UserIn[2].3,1,0,\Security.Level,0,0)OTE(Outputs.UserOut[3].7);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManGripper,0,Outputs.UserOut[3].1,Outputs.UserOut[3].0,0,0,0,0,1,0,\Security.Level,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(Inputs.UserIn[2].0)XIO(Inputs.UserIn[2].1)XIO(Inputs.UserIn[2].2)XIO(Inputs.UserIn[2].3)XIO(Inputs.UserIn[2].4)OTE(Idle);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Comms.AOI_EIPCommStat15.ComOK)[XIC(Inputs.Ready) ,XIC(Inputs.Running) ,XIC(Inputs.Paused) ,XIC(Inputs.Error) ][[XIC(Inputs.InsideBox1) ,XIO(Inputs.InsideBox1) [XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ] ] OTE(ClearOfMainDial) ,XIC(Inputs.InsideBox2) OTE(ClearOfTrayStacker) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(\Mode.Auto) OTE(Outputs.UserOut[0].0) ,XIC(\Mode.Manual) OTE(Outputs.UserOut[0].1) ,[XIC(\Mode.CycleRunning) ,XIC(\Mode.CycleStopping) ,XIC(\Mode.CycleStarting) ,XIC(\Mode.AutoJogging) ,XIC(\Mode.CycleStopPauseImmed) ,XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ] OTE(Outputs.UserOut[0].2) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Inputs.UserIn[1].2)[OTE(Outputs.UserOut[2].2) ,OTE(\Production.RejectPart) ,ONS(OneShot.0) [COP(\Tracking.Data.Nest[NestNumRobot].PartStatus.FailureType,\Production.FailureType,1) ,COP(\Tracking.Data.Nest[NestNumRobot].PartStatus,\Logging.NewDataReject1.PartStatus,1) COP(\Tracking.Data.Nest[NestNumRobot].ProcessData,\Logging.NewDataReject1.ProcessData,1) ,COP(\Production.RejectHistory[1],\Production.RejectHistory[0],19) COP(\Tracking.Data.Nest[NestNumRobot],\Production.RejectHistory[19],1) ,COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[NestNumRobot].PartStatus,1) COP(\Tracking.ZeroProcessData,\Tracking.Data.Nest[NestNumRobot].ProcessData,1) COP(\Tracking.ZeroProductData,\Tracking.Data.Nest[NestNumRobot].ProductData,1) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[Robot_Epson(AOI_EpsonIOMapping,EpsonRobot_Unload:I,EpsonRobot_Unload:O,Inputs,Outputs);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 0
Power Off / Safety Circuit Opened]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])XIC(SafeOK)OTU(RobotInit)OTU(Outputs.StopCmd)OTU(HMI_DefineCoordComplete)MOV(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 2
Check Robot Status

NOTE: If Define Coordinate System Screen Is Open On The HMI, Start The Robot Program Riunning but leave the Motors Off.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Inputs.SafeguardOn)XIC(Inputs.AutoMode)[XIO(Inputs.EStopOn) XIO(Inputs.Error) XIO(Inputs.Paused) [OTU(SafetyOpened) ,XIC(Inputs.Ready) [XIO(Inputs.UserIn[3].15) [XIO(Inputs.MotorOn) MOV(3,Control.StateReg) ,XIC(Inputs.MotorOn) XIO(Inputs.Running) MOV(4,Control.StateReg) ] ,XIC(Inputs.UserIn[3].15) XIO(Inputs.Running) MOV(4,Control.StateReg) ] ,XIO(Inputs.Ready) XIC(Inputs.Running) [XIO(Inputs.UserIn[3].15) MOV(10,Control.StateReg) ,XIC(Inputs.UserIn[3].15) XIO(HMI_DefineCoordComplete) OTE(ReadyDefineCoord) XIC(HMI_DefineCoord.EnableOut) MOV(46,Control.StateReg) ] ] ,[XIC(Inputs.EStopOn) ,XIC(Inputs.Error) ,XIC(Inputs.Paused) ] MOV(58,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 3
Motors On Command]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])OTE(Outputs.SetMotorsOn)XIC(Inputs.MotorOn)MOV(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 4
Start Command
-Clear And Sequence Select Bit (In case they were left on)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[OTE(StartCmdActive) XIC(\Main.FlashSlow) OTE(Outputs.StartCmd) ,[XIC(Inputs.Running) [XIO(Inputs.UserIn[3].15) MOV(10,Control.StateReg) ,XIC(Inputs.UserIn[3].15) MOV(2,Control.StateReg) ] ,XIO(Inputs.AutoMode) MOV(2,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 10
-Robot Is Ready, Machine in Manual Mode
-Set Initialized Latch
-Clear Enable Conveyors Signal

**Removed requirement for machine to be in auto mode - W.E.H. 6/16/2021]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])[OTU(Outputs.UserOut[0].4) OTL(RobotInit) ,[XIC(\Mode.Auto) ,XIC(AlwaysOn) ] [XIC(Inputs.AutoMode) XIC(Inputs.Running) MOV(20,Control.StateReg) ,XIC(AlwaysOff) XIO(Inputs.AutoMode) MOV(2,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 20
Robot Running Pick-N-Place Operation

**Removed requirement for machine to be in auto mode - W.E.H. 6/16/2021]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])OTE(Operating)[XIC(\Mode.Manual) ,XIC(AlwaysOn) ]XIO(Inputs.Running)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 58
Robot Controller Stop Command]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[58])OTL(Outputs.StopCmd)XIO(Inputs.Paused)[OTU(SafetyOpened) ,MOV(59,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 59
Robot Controller Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[59])OTU(Outputs.StopCmd)XIO(Inputs.Error)MOV(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[XIC(Status.State[59]) ,XIC(\Main.FaultReset) XIC(Inputs.Error) ]OTE(Outputs.Reset);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 125
-Faulted
-Clear Robot Initialized Memory Bit
-Send Robot Stop Command

NOTE: when a stop command is issued to the Epson controller, the Error status bit coming from the controller gets cleared]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])[OTL(Outputs.StopCmd) ,OTU(RobotInit) MOV(100,Control.TransitionTime) XIC(Status.TransitionTimerDone) MOV(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 127
--Faulted--
-Clear Robot Stop Command]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])[ONS(OneShot.27) OTU(Outputs.StopCmd) ,XIO(FaultActive) MOV(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(FaultActive)XIO(Status.State[125])XIO(Status.State[126])XIO(Status.State[127])MOV(127,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIO(SafeOK)OTL(SafetyOpened)[XIO(\Safety.EStopOK) OTL(Outputs.UserOut[0].4) ,MOV(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
