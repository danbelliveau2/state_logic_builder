<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk1,100,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(CycleStation) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,OTL(OUT_BobbinHoldDn) OTU(OUT_BobbinHoldUp) ] ,Chassis_CamPos_Check(AOI_CamPosChk2,230,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_BobbinHoldDn) OTL(OUT_BobbinHoldUp) OTU(OUT_BobbinHoldDn) ];]]>
