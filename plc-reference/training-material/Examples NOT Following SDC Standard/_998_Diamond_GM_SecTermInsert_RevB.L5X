<![CDATA[XIC(AlwaysOn)[XIC(SafeOK) [XIC(MotionInstructions[0].MAM_Inst[0].EN) XIC(MotionInstructions[0].MAM_Inst[0].ER) ,XIC(MotionInstructions[0].MAM_Inst[1].EN) XIC(MotionInstructions[0].MAM_Inst[1].ER) ,XIC(MotionInstructions[0].MAM_Inst[2].EN) XIC(MotionInstructions[0].MAM_Inst[2].ER) ,XIC(MotionInstructions[0].MAM_Inst[3].EN) XIC(MotionInstructions[0].MAM_Inst[3].ER) ,XIC(MotionInstructions[0].MAM_Inst[4].EN) XIC(MotionInstructions[0].MAM_Inst[4].ER) ,XIC(MotionInstructions[0].MAM_Inst[5].EN) XIC(MotionInstructions[0].MAM_Inst[5].ER) ,XIC(MotionInstructions[0].MAM_Inst[6].EN) XIC(MotionInstructions[0].MAM_Inst[6].ER) ,XIC(MotionInstructions[0].MAM_Inst[7].EN) XIC(MotionInstructions[0].MAM_Inst[7].ER) ,XIC(MotionInstructions[0].MAM_Inst[8].EN) XIC(MotionInstructions[0].MAM_Inst[8].ER) ,XIC(MotionInstructions[0].MAM_Inst[9].EN) XIC(MotionInstructions[0].MAM_Inst[9].ER) ,[XIC(MotionInstructions[0].MAM_Inst[0].EN) XIO(MotionInstructions[0].MAM_Inst[0].DN) ,XIC(MotionInstructions[0].MAM_Inst[1].EN) XIO(MotionInstructions[1].MAM_Inst[1].DN) ,XIC(MotionInstructions[0].MAM_Inst[2].EN) XIO(MotionInstructions[1].MAM_Inst[2].DN) ,XIC(MotionInstructions[0].MAM_Inst[3].EN) XIO(MotionInstructions[1].MAM_Inst[3].DN) ,XIC(MotionInstructions[0].MAM_Inst[4].EN) XIO(MotionInstructions[1].MAM_Inst[4].DN) ,XIC(MotionInstructions[0].MAM_Inst[5].EN) XIO(MotionInstructions[1].MAM_Inst[5].DN) ,XIC(MotionInstructions[0].MAM_Inst[6].EN) XIO(MotionInstructions[1].MAM_Inst[6].DN) ,XIC(MotionInstructions[0].MAM_Inst[7].EN) XIO(MotionInstructions[1].MAM_Inst[7].DN) ,XIC(MotionInstructions[0].MAM_Inst[8].EN) XIO(MotionInstructions[1].MAM_Inst[8].DN) ,XIC(MotionInstructions[0].MAM_Inst[9].EN) XIO(MotionInstructions[1].MAM_Inst[9].DN) ] TON(TmrFlt_MoveInstFeed,?,?) XIC(TmrFlt_MoveInstFeed.DN) ] ONS(OneShotFlt.16) ,XIC(Fault[16].Active) XIO(\Main.FaultReset) ]OTE(Fault[16].Active);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(AlwaysOn)[XIC(SafeOK) [XIC(MotionInstructions[1].MAM_Inst[0].EN) XIC(MotionInstructions[1].MAM_Inst[0].ER) ,XIC(MotionInstructions[1].MAM_Inst[1].EN) XIC(MotionInstructions[1].MAM_Inst[1].ER) ,XIC(MotionInstructions[1].MAM_Inst[2].EN) XIC(MotionInstructions[1].MAM_Inst[2].ER) ,XIC(MotionInstructions[1].MAM_Inst[3].EN) XIC(MotionInstructions[1].MAM_Inst[3].ER) ,XIC(MotionInstructions[1].MAM_Inst[4].EN) XIC(MotionInstructions[1].MAM_Inst[4].ER) ,XIC(MotionInstructions[1].MAM_Inst[5].EN) XIC(MotionInstructions[1].MAM_Inst[5].ER) ,XIC(MotionInstructions[1].MAM_Inst[6].EN) XIC(MotionInstructions[1].MAM_Inst[6].ER) ,XIC(MotionInstructions[1].MAM_Inst[7].EN) XIC(MotionInstructions[1].MAM_Inst[7].ER) ,XIC(MotionInstructions[1].MAM_Inst[8].EN) XIC(MotionInstructions[1].MAM_Inst[8].ER) ,XIC(MotionInstructions[1].MAM_Inst[9].EN) XIC(MotionInstructions[1].MAM_Inst[9].ER) ,[XIC(MotionInstructions[1].MAM_Inst[0].EN) XIO(MotionInstructions[1].MAM_Inst[0].DN) ,XIC(MotionInstructions[1].MAM_Inst[1].EN) XIO(MotionInstructions[1].MAM_Inst[1].DN) ,XIC(MotionInstructions[1].MAM_Inst[2].EN) XIO(MotionInstructions[1].MAM_Inst[2].DN) ,XIC(MotionInstructions[1].MAM_Inst[3].EN) XIO(MotionInstructions[1].MAM_Inst[3].DN) ,XIC(MotionInstructions[1].MAM_Inst[4].EN) XIO(MotionInstructions[1].MAM_Inst[4].DN) ,XIC(MotionInstructions[1].MAM_Inst[5].EN) XIO(MotionInstructions[1].MAM_Inst[5].DN) ,XIC(MotionInstructions[1].MAM_Inst[6].EN) XIO(MotionInstructions[1].MAM_Inst[6].DN) ,XIC(MotionInstructions[1].MAM_Inst[7].EN) XIO(MotionInstructions[1].MAM_Inst[7].DN) ,XIC(MotionInstructions[1].MAM_Inst[8].EN) XIO(MotionInstructions[1].MAM_Inst[8].DN) ,XIC(MotionInstructions[1].MAM_Inst[9].EN) XIO(MotionInstructions[1].MAM_Inst[9].DN) ] TON(TmrFlt_MoveInstInsert,?,?) XIC(TmrFlt_MoveInstInsert.DN) ] ONS(OneShotFlt.17) ,XIC(Fault[17].Active) XIO(\Main.FaultReset) ]OTE(Fault[17].Active);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Fault[18].Active)XIC(\Main.FaultReset)OTU(Fault[18].Active);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Fault[19].Active)XIC(\Main.FaultReset)OTU(Fault[19].Active);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Fault[20].Active)XIC(\Main.FaultReset)OTU(Fault[20].Active);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Fault[21].Active)XIC(\Main.FaultReset)OTU(Fault[21].Active);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(Fault[22].Active)XIC(\Main.FaultReset)OTU(Fault[22].Active);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIO(AlwaysOff) GEQ(DieMaint.Count,DieMaint.Setpoint) OTE(Warning[0].Active) [XIC(\Main.FlashFast) MOV(2,DieMaint.HMIColorStatus) ,XIO(\Main.FlashFast) MOV(1,DieMaint.HMIColorStatus) ] ,LES(DieMaint.Count,DieMaint.Setpoint) MOV(4,DieMaint.HMIColorStatus) ,HMI_NumDispEntryCountGen(HMI_DieMaint,DieMaint,1,1,1,2000,\Security.Level,5) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Manual Control Logic]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManHitchFixedGrpr,0,OUT_HitchFixdGrprCls,OUT_HitchFixdGrprOpn,0,0,0,0,\Mode.Manual,0,\Security.Level,0)HMI_OutTog(HMI_ManHitchMoveGrpr,0,OUT_HitchMovGrprCls,OUT_HitchMovGrprOpn,0,0,0,0,\Mode.Manual,0,\Security.Level,0)HMI_OutTog(HMI_ManBobbinBackup,0,OUT_BobbinBackupUp,OUT_BobbinBackupDn,0,1,0,IN_BobbinBackupDn,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_ManWireForm,0,ManWireFormDn,ManWireFormUp,0,1,0,IN_WireForm1Up,\Mode.Manual,0,\Security.Level,0) ,XIC(AlwaysOff) XIO(IN_WireShearAtForm) OTE(HMI_ManWireForm.InterlockActive) ,XIC(ManWireFormDn) ONS(OneShot.1) OTL(OUT_WireFormTopDn) OTU(OUT_WireFormTopUp) OTL(OUT_WireFormBotUp) OTU(OUT_WireFormBotDwn) ,XIC(ManWireFormUp) ONS(OneShot.2) OTL(OUT_WireFormTopUp) OTU(OUT_WireFormTopDn) OTL(OUT_WireFormBotDwn) OTU(OUT_WireFormBotUp) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_ManShear,0,OUT_WireShearInsertPos,OUT_WireShearFormPos,1,1,IN_WireShearAtInsert,IN_WireShearAtForm,\Mode.Manual,0,\Security.Level,0) ,XIO(IN_WirePusherRetdXXXXXX) XIO(IN_WireForm1Up) XIO(IN_WireForm2Dn) OTE(HMI_ManShear.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_ManJogFwdFeed,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0) ,[XIO(IN_WireForm1Up) ,XIO(IN_WireForm2Dn) ] OTE(HMI_ManJogFwdFeed.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogRevFeed,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManMoveFeedGrip,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_ManMoveFeedForm,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0) ,[XIO(IN_WireForm1Up) ,XIO(IN_WireForm2Dn) ] OTE(HMI_ManMoveFeedForm.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_ManMoveFeedShear,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0) ,[XIO(IN_WireForm1Up) ,XIO(IN_WireForm2Dn) ] OTE(HMI_ManMoveFeedShear.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_ManJogFwdInsert,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0) ,XIO(IN_WireShearAtInsert) XIC(TravelLimitPosShearForm) OTE(HMI_ManJogFwdInsert.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogRevInsert,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManMoveInsertRetract,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_ManMoveInsertExtend,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0) ,XIO(IN_WireShearAtInsert) OTE(HMI_ManMoveInsertExtend.InterlockActive) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ZeroServoFeed,1,2000,0,AlwaysOff,Status.State[0],0,\Security.Level,10,1);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ZeroServoInsert,1,2000,0,AlwaysOff,Status.State[0],0,\Security.Level,10,1);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[HMI_OpnPopup(HMI_OpenZeroPopupFeed,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,48,\Safety.EStopNOK,\Security.Level,10);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[HMI_OpnPopup(HMI_OpenZeroPopupInsert,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,49,\Safety.EStopNOK,\Security.Level,10);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Position" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Wire Hitch Feed Servo]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Calculate Position For Status (In mm)
Note : The value is multiplied and divided to remove scientific notation and create a fixed number of decimal places. ]]>
</Comment>
<Text>
<![CDATA[MUL(ServoMotorFeed.ActualPosition,1000,ServoPosFeedREALTemp)TRN(ServoPosFeedREALTemp,ServoPosFeedREALTemp)DIV(ServoPosFeedREALTemp,1000,ServoPosFeed_mm);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Be mindful of the servo position lock tolerance. It should be slightly less than the InPosTol value chosen]]>
</Comment>
<Text>
<![CDATA[CMP(ServoPosFeed_mm < (MotionPositionFeed.Grip + MotionPositionFeed.InPosTol))CMP(ServoPosFeed_mm > (MotionPositionFeed.Grip - MotionPositionFeed.InPosTol))OTE(FeedAtGripPos);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[CMP(ServoPosFeed_mm < (MotionPositionFeed.Form + MotionPositionFeed.InPosTol))CMP(ServoPosFeed_mm > (MotionPositionFeed.Form - MotionPositionFeed.InPosTol))OTE(FeedAtFormPos);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CMP(ServoPosFeed_mm < (MotionPositionFeed.Shear + MotionPositionFeed.InPosTol))CMP(ServoPosFeed_mm > (MotionPositionFeed.Shear - MotionPositionFeed.InPosTol))OTE(FeedAtShearPos);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[LEQ(ServoPosFeed_mm,2) OTE(TravelLimitNegFeed) ,GEQ(ServoPosFeed_mm,PosTravelLimitFeed) OTE(TravelLimitPosFeed) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[HMI_NumericDispEntry(HMI_FeedFormDist,1,\Security.Level,5,0,DummyDINT,1,\Recipe.Data.Running.MachineSetup.HVWireFeedOsffsetDistForm,1,0) ,CMP((MotionPositionFeed.Form + \Recipe.Data.Running.MachineSetup.HVWireFeedOsffsetDistForm) < PosTravelLimitFeed) ADD(MotionPositionFeed.Grip,\Recipe.Data.Running.MachineSetup.HVWireFeedOsffsetDistForm,MotionPositionFeed.Form) ,XIC(\Recipe.DownloadPulse) MOV(\Recipe.Data.Running.MachineSetup.HVWireInsertOffsetDist,OldRecipeFormOffsetDist) ,XIO(\Recipe.DownloadPulse) EQU(\HMI.CurrentScreenNum,72) NEQ(\Recipe.Data.Running.MachineSetup.HVWireFeedOsffsetDistForm,OldRecipeFormOffsetDist) ONS(OneShot.8) MOV(\Recipe.Data.Running.MachineSetup.HVWireFeedOsffsetDistForm,\Recipe.Data.Saved[CurrentRecipeID].MachineSetup.HVWireFeedOsffsetDistForm) MOV(\Recipe.Data.Running.MachineSetup.HVWireFeedOsffsetDistForm,OldRecipeFormOffsetDist) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[HMI_NumericDispEntry(HMI_FeedShearDist,1,\Security.Level,5,0,DummyDINT,1,\Recipe.Data.Running.MachineSetup.HVWireFeedOffsetDistShear,1,0) ,CMP((MotionPositionFeed.Form + \Recipe.Data.Running.MachineSetup.HVWireFeedOffsetDistShear) < PosTravelLimitFeed) ADD(MotionPositionFeed.Form,\Recipe.Data.Running.MachineSetup.HVWireFeedOffsetDistShear,MotionPositionFeed.Shear) ,XIC(\Recipe.DownloadPulse) MOV(\Recipe.Data.Running.MachineSetup.HVWireFeedOffsetDistShear,OldRecipeShearOffsetDist) ,XIO(\Recipe.DownloadPulse) EQU(\HMI.CurrentScreenNum,72) NEQ(\Recipe.Data.Running.MachineSetup.HVWireFeedOffsetDistShear,OldRecipeShearOffsetDist) ONS(OneShot.9) MOV(\Recipe.Data.Running.MachineSetup.HVWireFeedOffsetDistShear,\Recipe.Data.Saved[CurrentRecipeID].MachineSetup.HVWireFeedOffsetDistShear) MOV(\Recipe.Data.Running.MachineSetup.HVWireFeedOffsetDistShear,OldRecipeShearOffsetDist) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Wire Insert Pusher Servo]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Calculate Position For Status (In mm)
Note : The value is multiplied and divided to remove scientific notation and create a fixed number of decimal places. ]]>
</Comment>
<Text>
<![CDATA[MUL(ServoMotorInsert.ActualPosition,1000,ServoPosInsertREALTemp)TRN(ServoPosInsertREALTemp,ServoPosInsertREALTemp)DIV(ServoPosInsertREALTemp,1000,ServoPosInsert_mm);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[LEQ(ServoPosInsert_mm,3)OTE(ClearOfShear);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Be mindful of the servo position lock tolerance. It should be slightly less than the InPosTol value chosen]]>
</Comment>
<Text>
<![CDATA[CMP(ServoPosInsert_mm < (MotionPositionInsert.Retract + MotionPositionInsert.InPosTol))CMP(ServoPosInsert_mm > (MotionPositionInsert.Retract - MotionPositionInsert.InPosTol))OTE(InsertAtRetractPos);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[CMP(ServoPosInsert_mm < (MotionPositionInsert.Insert + MotionPositionInsert.InPosTol))CMP(ServoPosInsert_mm > (MotionPositionInsert.Insert - MotionPositionInsert.InPosTol))OTE(InsertAtInsertPos);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[LEQ(ServoPosInsert_mm,4.0) OTE(TravelLimitNegInsert) ,GEQ(ServoPosInsert_mm,PosTravelLimitInsert) OTE(TravelLimitPosInsert) ,CMP(ServoPosInsert_mm > (MotionPositionInsert.Tip - 1)) OTE(TravelLimitPosShearForm) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[HMI_OpnPopup(HMI_OpenTeachTipPopup,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,59,1,\Security.Level,1) ,XIC(HMI_TeachRodTip) TON(Tmr_TeachTip,?,?) XIC(Tmr_TeachTip.DN) ONS(OneShot.28) MOV(ServoPosInsert_mm,MotionPositionInsert.Tip) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[HMI_NumericDispEntry(HMI_InsertOffsetDist,1,\Security.Level,5,0,DummyDINT,1,\Recipe.Data.Running.MachineSetup.HVWireInsertOffsetDist,1,0) ,CMP((MotionPositionInsert.Tip + \Recipe.Data.Running.MachineSetup.HVWireInsertOffsetDist) < PosTravelLimitInsert) ADD(MotionPositionInsert.Tip,\Recipe.Data.Running.MachineSetup.HVWireInsertOffsetDist,MotionPositionInsert.Insert) ,XIC(\Recipe.DownloadPulse) MOV(\Recipe.Data.Running.MachineSetup.HVWireInsertOffsetDist,OldRecipeInsertOffsetDist) ,XIO(\Recipe.DownloadPulse) EQU(\HMI.CurrentScreenNum,72) NEQ(\Recipe.Data.Running.MachineSetup.HVWireInsertOffsetDist,OldRecipeInsertOffsetDist) ONS(OneShot.7) MOV(\Recipe.Data.Running.MachineSetup.HVWireInsertOffsetDist,\Recipe.Data.Saved[CurrentRecipeID].MachineSetup.HVWireInsertOffsetDist) MOV(\Recipe.Data.Running.MachineSetup.HVWireInsertOffsetDist,OldRecipeInsertOffsetDist) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ReelChange" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[[XIC(Fault[0].Active) ,XIO(Fault[0].Active) EQU(\HMI.CurrentScreenNum,1) NEQ(\HMI.CurrentPopupNum,90) ] OTE(ButtonVisibility) ,HMI_OpnPopup(HMI_OpenReelChange,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,56,ButtonVisibility,\Security.Level,0) ,XIC(HMI_OpenReelChange.Trigger) ONS(OneShot.3) [OTL(ReelChangeActive) ,XIC(Fault[0].Active) OTU(Fault[0].Active) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(HMI_NewReelLoaded)ONS(OneShot.4)OTL(NewReelLoadedStatus);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[can only make wire if the reel change sequence is complete (not active)]]>
</Comment>
<Text>
<![CDATA[[HMI_OutMom(HMI_MakeWires,0,0,0,0,SafeOK,GreyoutMakeWires,\Security.Level,0,1) OTL(MakeWiresActive) ,[XIC(ReelChangeActive) ,XIC(NewReelLoadedStatus) ] OTE(GreyoutMakeWires) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines]]>
</Comment>
<Text>
<![CDATA[JSR(Position,0)JSR(ManualControl,0)JSR(FaultsWarnings,0)JSR(ReelChange,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[The backup cylinder must be down or the robot wrecks. Therefore , this rung was seperated out to guarantee the Complete bit (Ok to leave) doesn't turn on.unless its down.

NOTE: The complete bit needs to stay on until the robot gets rid of the part.]]>
</Comment>
<Text>
<![CDATA[XIC(\RobotBobbin.Operating)[XIC(\RobotBobbin.Inputs.UserIn[1].1) ,XIC(AlwaysOn) ]XIC(IN_BobbinBackupDn)[XIC(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Success) ,XIC(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Failure) ]OTE(\RobotBobbin.Outputs.UserOut[1].10);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[ONS(OneShot.6) OTU(MakeWiresActive) ,XIC(SafeOK) [XIC(ServoMotorFeed.AxisHomedStatus) XIC(ServoMotorInsert.AxisHomedStatus) MOV(1,Control.StateReg) ,XIO(ServoMotorFeed.AxisHomedStatus) ONS(OneShotFlt.18) OTL(Fault[18].Active) ,XIO(ServoMotorInsert.AxisHomedStatus) ONS(OneShotFlt.19) OTL(Fault[19].Active) ] ,XIO(SafeOK) XIC(HMI_ZeroServoFeed.EnableOut) MAH(Axis_HVWireFeed,MotionInstructions[0].MAH_Inst) ,XIO(SafeOK) XIC(HMI_ZeroServoInsert.EnableOut) MAH(Axis_HVWireInsert,MotionInstructions[1].MAH_Inst) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 1
Stop All Servo Drive Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIO(ServoMotorFeed.ShutdownStatus) MAS(ServoMotorFeed,MotionInstructions[0].MAS_Inst[0],All,No,0,Units per sec2,No,0,Units per sec3) ,XIC(ServoMotorFeed.ShutdownStatus) MASR(ServoMotorFeed,MotionInstructions[0].MASR_Inst[0]) XIC(MotionInstructions[0].MASR_Inst[0].DN) ][XIO(ServoMotorInsert.ShutdownStatus) MAS(ServoMotorInsert,MotionInstructions[1].MAS_Inst[0],All,No,0,Units per sec2,No,0,Units per sec3) ,XIC(ServoMotorInsert.ShutdownStatus) MASR(ServoMotorInsert,MotionInstructions[1].MASR_Inst[0]) XIC(MotionInstructions[1].MASR_Inst[0].DN) ]MOV(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 2
Fault Reset Servo Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])MAFR(ServoMotorFeed,MotionInstructions[0].MAFR_Inst[0])XIC(MotionInstructions[0].MAFR_Inst[0].DN)MAFR(ServoMotorInsert,MotionInstructions[1].MAFR_Inst[0])XIC(MotionInstructions[1].MAFR_Inst[0].DN)MOV(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 3
Enable Servo Drives]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])[MSO(ServoMotorFeed,MotionInstructions[0].MSO_Inst[0]) ,MSO(ServoMotorInsert,MotionInstructions[1].MSO_Inst[0]) ]XIC(MotionInstructions[0].MSO_Inst[0].DN)XIC(ServoMotorFeed.DriveEnableStatus)XIC(MotionInstructions[1].MSO_Inst[0].DN)XIC(ServoMotorInsert.DriveEnableStatus)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 10
Ready / Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIO(ReelChangeActive)[XIC(\Mode.Auto) ,XIC(MakeWiresActive) ][[XIC(\Mode.CycleRunning) ,XIC(AlwaysOn) ] XIC(FeedAtGripPos) XIC(OUT_HitchMovGrprCls) XIC(OUT_HitchFixdGrprOpn) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) [XIC(IN_WireShearAtForm) MOV(11,Control.StateReg) ,XIO(IN_WireShearAtForm) XIC(IN_WireShearAtInsert) XIC(InsertAtRetractPos) XIO(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Attempt) MOV(25,Control.StateReg) ] ,[XIO(IN_WireForm1Up) ,XIO(IN_WireForm2Dn) ,XIO(OUT_HitchFixdGrprOpn) ,XIO(OUT_HitchMovGrprCls) ,XIO(FeedAtGripPos) ] MOV(40,Control.StateReg) ,XIO(InsertAtRetractPos) MOV(47,Control.StateReg) ,XIO(WireInToolMemory) XIO(IN_WireShearAtForm) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) XIC(InsertAtRetractPos) [XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.ClearOfWireInsert) ,XIC(MakeWiresActive) ] MOV(48,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])XIC(\Mode.Manual)[XIC(HMI_ManJogFwdFeed.EnableOut) XIO(TravelLimitPosFeed) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) MOV(100,Control.StateReg) ,XIC(HMI_ManJogRevFeed.EnableOut) XIO(TravelLimitNegFeed) MOV(101,Control.StateReg) ,XIC(HMI_ManMoveFeedGrip.EnableOut) MOV(103,Control.StateReg) ,XIC(HMI_ManMoveFeedForm.EnableOut) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) MOV(104,Control.StateReg) ,XIC(HMI_ManMoveFeedShear.EnableOut) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) MOV(105,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])XIC(\Mode.Manual)[XIC(HMI_ManJogFwdInsert.EnableOut) XIO(TravelLimitPosInsert) [XIO(IN_WireShearAtInsert) XIO(TravelLimitPosShearForm) ,XIC(IN_WireShearAtInsert) ] MOV(110,Control.StateReg) ,XIC(HMI_ManJogRevInsert.EnableOut) XIO(TravelLimitNegInsert) MOV(111,Control.StateReg) ,XIC(HMI_ManMoveInsertRetract.EnableOut) MOV(113,Control.StateReg) ,XIC(HMI_ManMoveInsertExtend.EnableOut) XIC(IN_WireShearAtInsert) MOV(114,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])XIC(ReelChangeActive)[XIO(NewReelLoadedStatus) [XIO(OUT_HitchFixdGrprOpn) ,XIO(OUT_HitchMovGrprOpn) ] MOV(50,Control.StateReg) ,XIC(NewReelLoadedStatus) XIC(FeedAtGripPos) XIC(OUT_HitchMovGrprOpn) XIC(OUT_HitchFixdGrprOpn) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) XIC(IN_WireShearAtForm) MOV(53,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 11
Hitch Feed Extend
-Set Wire In Tool Memory Bit]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[11])[MAM(ServoMotorFeed,MotionInstructions[0].MAM_Inst[1],MotionConstants.Absolute,MotionPositionFeed.Form,MotionParametersFeed[2].Vel,Units per sec,MotionParametersFeed[2].Acc,Units per sec2,MotionParametersFeed[2].Dec,Units per sec2,Trapezoidal,MotionParametersFeed[2].Jerk,MotionParametersFeed[2].Jerk,Units per sec3,Disabled,Current,0,None,0,0) ,MOV(60,Control.TransitionTime) MOV(1000,Control.FaultTime) ,XIC(Status.TransitionTimerDone) OTL(WireInToolMemory) XIC(MotionInstructions[0].MAM_Inst[1].PC) XIC(FeedAtFormPos) MOV(12,Control.StateReg) ,XIC(Status.TimeoutFlt) ONS(OneShotFlt.21) OTL(Fault[20].Active) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 12
-Wire From Top Down & Bottom Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[12])[OTL(OUT_WireFormTopDn) OTU(OUT_WireFormTopUp) ,OTL(OUT_WireFormBotUp) OTU(OUT_WireFormBotDwn) ,MOV(250,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(13,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 13
-Wire From Top Up & Bottom Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])[OTL(OUT_WireFormTopUp) OTU(OUT_WireFormTopDn) ,OTL(OUT_WireFormBotDwn) OTU(OUT_WireFormBotUp) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) [XIO(FeedAtShearPos) MOV(14,Control.StateReg) ,XIC(FeedAtShearPos) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) XIC(InsertAtRetractPos) [XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.ClearOfWireInsert) ,XIC(debugBIT.30) ] MOV(15,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 14
Hitch Feed Move To Shear Position
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[14])[MAM(ServoMotorFeed,MotionInstructions[0].MAM_Inst[5],MotionConstants.Absolute,MotionPositionFeed.Shear,MotionParametersFeed[3].Vel,Units per sec,MotionParametersFeed[3].Acc,Units per sec2,MotionParametersFeed[3].Dec,Units per sec2,Trapezoidal,MotionParametersFeed[3].Jerk,MotionParametersFeed[3].Jerk,Units per sec3,Disabled,Current,0,None,0,0) ,MOV(40,Control.TransitionTime) MOV(1000,Control.FaultTime) ,XIC(Status.TransitionTimerDone) XIC(MotionInstructions[0].MAM_Inst[5].PC) XIC(FeedAtShearPos) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) XIC(InsertAtRetractPos) [XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.ClearOfWireInsert) ,XIC(debugBIT.30) ] MOV(15,Control.StateReg) ,XIC(Status.TimeoutFlt) ONS(OneShotFlt.29) OTL(Fault[20].Active) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 15
-Wire Shear To Insert Position (Shear The Wire)

Note: Move to next state quickly so motion can overlap]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTL(OUT_WireShearInsertPos) OTU(OUT_WireShearFormPos) ,ONS(OneShot.19) ADD(DieMaint.Count,1,DieMaint.Count) ,MOV(1,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_WireShearAtInsert) MOV(16,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 16
--Complete Hitch Feed While Shearing--
-Hitch Feed Fixed Gripper Close]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[OTL(OUT_HitchFixdGrprCls) OTU(OUT_HitchFixdGrprOpn) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(17,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 17
--Complete Hitch Feed While Shearing--
-Hitch Feed Moveable Gripper Open]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[17])[OTL(OUT_HitchMovGrprOpn) OTU(OUT_HitchMovGrprCls) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(18,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 18
--Complete Hitch Feed While Shearing--
-Hitch Feed Retract]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[18])[MAM(ServoMotorFeed,MotionInstructions[0].MAM_Inst[2],MotionConstants.Absolute,MotionPositionFeed.Grip,MotionParametersFeed[0].Vel,Units per sec,MotionParametersFeed[0].Acc,Units per sec2,MotionParametersFeed[0].Dec,Units per sec2,Trapezoidal,MotionParametersFeed[0].Jerk,MotionParametersFeed[0].Jerk,Units per sec3,Disabled,Current,0,None,0,0) ,MOV(40,Control.TransitionTime) MOV(1000,Control.FaultTime) ,XIC(Status.TransitionTimerDone) XIC(MotionInstructions[0].MAM_Inst[2].PC) XIC(FeedAtGripPos) MOV(19,Control.StateReg) ,XIC(Status.TimeoutFlt) ONS(OneShotFlt.20) OTL(Fault[20].Active) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 19
--Complete Hitch Feed While Shearing--
-Hitch Feed Moveable Gripper Close]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])[OTL(OUT_HitchMovGrprCls) OTU(OUT_HitchMovGrprOpn) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(20,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 20
--Complete Hitch Feed While Shearing--
-Hitch Feed Fixed Gripper Open
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])[OTL(OUT_HitchFixdGrprOpn) OTU(OUT_HitchFixdGrprCls) ,MOV(1,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) TON(Tmr_FormingFinish,?,?) XIC(Tmr_FormingFinish.DN) MOV(25,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 25
Ready To Insert]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[XIO(MakeWiresActive) XIO(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Attempt) OTE(\RobotBobbin.Outputs.UserOut[1].1) ,[XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.Inputs.UserIn[1].1) ,XIC(HMI_MakeWires.EnableOut) ,XIC(MakeWiresActive) ] [XIO(MakeWiresActive) MOV(31,Control.StateReg) ,XIC(MakeWiresActive) MOV(32,Control.StateReg) ] ,XIC(\RobotBobbin.Operating) XIO(\RobotBobbin.Inputs.UserIn[1].1) XIC(\Mode.CycleRunning) TON(Tmr_RobotStuck,?,?) XIC(Tmr_RobotStuck.DN) XIC(AlwaysOff) OTL(Fault[22].Active) ,XIC(\Mode.Manual) XIO(MakeWiresActive) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 31
-Bobbin Backup Cylinder Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[31])[OTL(OUT_BobbinBackupUp) OTU(OUT_BobbinBackupDn) ,MOV(60,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIO(IN_BobbinBackupDn) MOV(32,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 32
-Wire Pusher Extend]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[32])[MAM(ServoMotorInsert,MotionInstructions[1].MAM_Inst[0],MotionConstants.Absolute,MotionPositionInsert.Insert,MotionParametersInsert[2].Vel,Units per sec,MotionParametersInsert[2].Acc,Units per sec2,MotionParametersInsert[2].Acc,Units per sec2,Trapezoidal,MotionParametersInsert[2].Jerk,MotionParametersInsert[2].Jerk,Units per sec3,Disabled,Current,0,None,0,0) ,ONS(OneShot.22) OTL(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Attempt) ,MOV(110,Control.TransitionTime) ,MOV(500,Control.FaultTime) ,XIC(Status.TransitionTimerDone) [XIC(InsertAtInsertPos) XIC(MotionInstructions[1].MAM_Inst[0].PC) OTU(WireInToolMemory) [XIC(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Attempt) XIO(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Success) XIO(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Failure) [OTL(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Success) ,MOV(0,ConsecFails.Count) ] ,XIO(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Attempt) ,XIC(MakeWiresActive) ] MOV(33,Control.StateReg) ,[XIO(InsertAtInsertPos) ,XIO(MotionInstructions[1].MAM_Inst[0].PC) ] XIC(Status.TimeoutFlt) [ONS(OneShotFlt.7) OTL(Fault[7].Active) ,OTL(OUT_BobbinBackupDn) OTU(OUT_BobbinBackupUp) ,XIC(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Attempt) [OTL(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Failure) OTU(\Tracking.Data.Nest[NestNumRobot].PartStatus.Station[StaNumRobot].Success) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ,MOV(1,\Tracking.Data.Nest[NestNumRobot].PartStatus.FailureType) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 33
-Wire Pusher Retract
-Bobbin Backup Cylinder Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[33])[MAM(ServoMotorInsert,MotionInstructions[1].MAM_Inst[1],MotionConstants.Absolute,MotionPositionInsert.Retract,MotionParametersInsert[0].Vel,Units per sec,MotionParametersInsert[0].Acc,Units per sec2,MotionParametersInsert[0].Acc,Units per sec2,Trapezoidal,MotionParametersInsert[0].Jerk,MotionParametersInsert[0].Jerk,Units per sec3,Disabled,Current,0,None,0,0) ,OTL(OUT_BobbinBackupDn) OTU(OUT_BobbinBackupUp) ,MOV(80,Control.TransitionTime) MOV(1000,Control.FaultTime) ,XIC(Status.TransitionTimerDone) XIC(InsertAtRetractPos) XIC(MotionInstructions[1].MAM_Inst[1].PC) XIC(IN_BobbinBackupDn) [XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.ClearOfWireInsert) ,XIC(MakeWiresActive) ] MOV(34,Control.StateReg) ,XIC(Status.TimeoutFlt) [XIO(InsertAtRetractPos) ,XIO(MotionInstructions[1].MAM_Inst[1].PC) ] ONS(OneShotFlt.22) OTL(Fault[21].Active) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 34
-Wire Shear To Form Position
-Wire Insert Complete Signal To Robot]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[34])[OTL(OUT_WireShearFormPos) OTU(OUT_WireShearInsertPos) ,MOV(80,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_WireShearAtForm) OTU(MakeWiresActive) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 40
--Recovery--
-Wire From Top Up & Bottom Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[40])[OTL(OUT_WireFormTopUp) OTU(OUT_WireFormTopDn) ,OTL(OUT_WireFormBotDwn) OTU(OUT_WireFormBotUp) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) MOV(41,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 41
--Recovery--

-Hitch Feed Fixed Gripper Close]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[41])[OTL(OUT_HitchFixdGrprCls) OTU(OUT_HitchFixdGrprOpn) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(42,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE 42
--Recovery--

-Hitch Feed Moveable Gripper Open]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[42])[OTL(OUT_HitchMovGrprOpn) OTU(OUT_HitchMovGrprCls) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) [XIO(FeedAtGripPos) MOV(43,Control.StateReg) ,XIC(FeedAtGripPos) MOV(44,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[STATE 43
--Recovery--

-Hitch Feed Retract]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[43])[MAM(ServoMotorFeed,MotionInstructions[0].MAM_Inst[0],MotionConstants.Absolute,MotionPositionFeed.Grip,MotionParametersFeed[0].Vel,Units per sec,MotionParametersFeed[0].Acc,Units per sec2,MotionParametersFeed[0].Dec,Units per sec2,Trapezoidal,MotionParametersFeed[0].Jerk,MotionParametersFeed[0].Jerk,Units per sec3,Disabled,Current,0,None,0,0) ,MOV(80,Control.TransitionTime) MOV(1000,Control.FaultTime) ,XIC(Status.TransitionTimerDone) XIC(MotionInstructions[0].MAM_Inst[0].PC) XIC(FeedAtGripPos) MOV(44,Control.StateReg) ,XIC(Status.TimeoutFlt) ONS(OneShotFlt.23) OTL(Fault[20].Active) ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[STATE 44
--Recovery--

-Hitch Feed Moveable Gripper Close]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[44])[OTL(OUT_HitchMovGrprCls) OTU(OUT_HitchMovGrprOpn) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(45,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[STATE 45
--Recovery--

-Hitch Feed Fixed Gripper Open]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[45])[OTL(OUT_HitchFixdGrprOpn) OTU(OUT_HitchFixdGrprCls) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[STATE 47
--Recovery--
-Wire Pusher Retract
-Bobbin Backup Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[47])[MAM(ServoMotorInsert,MotionInstructions[1].MAM_Inst[4],MotionConstants.Absolute,MotionPositionInsert.Retract,MotionParametersInsert[0].Vel,Units per sec,MotionParametersInsert[0].Acc,Units per sec2,MotionParametersInsert[0].Acc,Units per sec2,Trapezoidal,MotionParametersInsert[0].Jerk,MotionParametersInsert[0].Jerk,Units per sec3,Disabled,Current,0,None,0,0) ,OTL(OUT_BobbinBackupDn) OTU(OUT_BobbinBackupUp) ,MOV(80,Control.TransitionTime) ,MOV(1000,Control.FaultTime) ,XIC(Status.TransitionTimerDone) XIC(MotionInstructions[1].MAM_Inst[4].PC) XIC(InsertAtRetractPos) MOV(10,Control.StateReg) ,XIC(Status.TimeoutFlt) ONS(OneShotFlt.24) OTL(Fault[21].Active) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[STATE 48
--Recovery--
Wire Shear To Form Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[48])[OTL(OUT_WireShearFormPos) OTU(OUT_WireShearInsertPos) ,MOV(80,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_WireShearAtForm) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[STATE 50
--Reel Change--

-Hitch Feed Both Grippers Open]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[50])[OTL(OUT_HitchMovGrprOpn) OTU(OUT_HitchMovGrprCls) ,OTL(OUT_HitchFixdGrprOpn) OTU(OUT_HitchFixdGrprCls) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[STATE 53
--Reel Change--

-Hitch Feed Moveable Gripper Close]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[53])[OTL(OUT_HitchMovGrprCls) OTU(OUT_HitchMovGrprOpn) ,MOV(GripperActuateTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(54,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[STATE 54
--Reel Change--

Hitch Feed Extend
- Set Wire In Tool Memory Bit]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[54])[MAM(ServoMotorFeed,MotionInstructions[0].MAM_Inst[3],MotionConstants.Absolute,MotionPositionFeed.Form,MotionParametersFeed[2].Vel,Units per sec,MotionParametersFeed[2].Acc,Units per sec2,MotionParametersFeed[2].Dec,Units per sec2,Trapezoidal,MotionParametersFeed[2].Jerk,MotionParametersFeed[2].Jerk,Units per sec3,Disabled,Current,0,None,0,0) ,MOV(70,Control.TransitionTime) MOV(1000,Control.FaultTime) ,XIC(Status.TransitionTimerDone) XIC(MotionInstructions[0].MAM_Inst[3].PC) XIC(FeedAtFormPos) XIC(IN_WireForm1Up) XIC(IN_WireForm2Dn) XIC(InsertAtRetractPos) XIC(\RobotBobbin.Operating) XIC(\RobotBobbin.ClearOfWireInsert) OTL(WireInToolMemory) MOV(55,Control.StateReg) ,XIC(Status.TimeoutFlt) [XIO(MotionInstructions[0].MAM_Inst[3].PC) ,XIO(FeedAtFormPos) ] ONS(OneShotFlt.25) OTL(Fault[20].Active) ];]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[STATE 55
--Reel Change--

-Wire Shear To Insert Position (Shear The Wire)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[55])[OTL(OUT_WireShearInsertPos) OTU(OUT_WireShearFormPos) ,ONS(OneShot.30) ADD(DieMaint.Count,1,DieMaint.Count) ,MOV(80,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_WireShearAtInsert) MOV(56,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[STATE 56
--Reel Change--

-Wire Pusher Extend
-Clear Wire In Tool Memory After Extended]]>
</Comment>
<Text>
