<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="OneShot2" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="OneShot3" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Hold" DataType="TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="HoldTimer" DataType="TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="OutputPulseOneShot" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[This logic toggles between OutputATag and OutputBTag
(When A is On , B is Off)]]>
</Comment>
<Text>
<![CDATA[XIC(Trigger)XIO(Invisible)XIO(Inactive)[XIO(UsePressHoldFeature) ,XIC(UsePressHoldFeature) MOV(PressHoldTimeMsec,HoldTimer.PRE) TON(HoldTimer,?,?) XIC(HoldTimer.DN) ][XIO(PulseOutput) ,XIC(PulseOutput) ONS(OutputPulseOneShot) ]OTE(EnableOut);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[IndicatorStatus is used to display the color and text on the indicator light on the button background (Title Background)

When Button Status Equals:
0 - Indicator Is Invisible, Not Used
1 - Hold (Button is pressed and Enable Out is OFF)
2 - Output Active (Button is pressed and Enable Out is ON)]]>
</Comment>
<Text>
<![CDATA[[XIO(Trigger) MOV(0,IndicatorStatus) ,XIC(Trigger) [XIC(UsePressHoldFeature) [XIO(HoldTimer.DN) MOV(1,IndicatorStatus) ,XIC(HoldTimer.DN) MOV(2,IndicatorStatus) ] ,XIO(UsePressHoldFeature) MOV(2,IndicatorStatus) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ButtonStatus is used to display the color and text on the indicator light ON THE BUTTON

When Indicator Status Equals:
0 - Indicator Is Invisible, Not Used
1 - Input Condition Off
2 - Input Condition ON]]>
</Comment>
<Text>
<![CDATA[[XIO(UseButtonIndicator) MOV(0,ButtonStatus) ,XIC(UseButtonIndicator) [XIO(IndicatorInput) MOV(1,ButtonStatus) ,XIC(IndicatorInput) MOV(2,ButtonStatus) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(InterlockActive) [LES(SecurityCurrentLevelTag,MinAccessLevel) ,XIC(GreyOutCondition) ] ,XIC(InterlockActive) ]OTE(Inactive);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(VisibilityCondition)OTE(Invisible);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Chassis_PartStatChk_V2_0" Class="Standard" Revision="2.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-01-27T15:48:40.133Z" CreatedBy="STEVENDOUGLAS\wehamby" EditedDate="2018-11-28T16:25:46.668Z" EditedBy="STEVENDOUGLAS\wehamby" SoftwareRevision="v31.00"
>
<Description>
<![CDATA[Check conditions for a station to cycle. Does recipe require this station and have previous stations (that were required) attempted successfully.]]>
</Description>
<RevisionNote>
<![CDATA[Added ResponsibleFailStationNum
Added Reject Station Functionality. Can now be located before the Good Unload Station]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="TrackingDataTag" TagType="Base" DataType="Tracking_Data" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="StaNumTag" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="CheckNestNumTag" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Nest at this station or previous station if before data shift.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="RejectStaNum" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[What is the Station Number of the Unload Reject?]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="ResponsibleFailStaNum" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Shows the station number that caused the enable out to NOT be set]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="dStationNum" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="bStationSuccess" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Written By Dave Shaner and Bill Hamby 1/27/2017]]>
</Line>
<Line Number="1">
<![CDATA[//]]>
</Line>
<Line Number="2">
<![CDATA[//Modified 11/25/2018 by Bill Hamby]]>
</Line>
<Line Number="3">
<![CDATA[//    Logic now allows for the case when the Unload Reject Station is located before the Unload Good station. (now either orientation doesn't matter) ]]>
</Line>
<Line Number="4">
<![CDATA[//    Also, this AOI can be used for the Unload Reject station. ]]>
</Line>
<Line Number="5">
<![CDATA[//]]>
</Line>
<Line Number="6">
<![CDATA[//]]>
</Line>
<Line Number="7">
<![CDATA[//This AOI was written with the intent of providing a containerized way to tell a station to cycle based on the following:]]>
</Line>
<Line Number="8">
<![CDATA[//			1. The recipe requires this station to operate. ]]>
</Line>
<Line Number="9">
<![CDATA[//			2. The previous stations that were required to operate were attempted and successfully processed. As long as they are not the reject station.]]>
</Line>
<Line Number="10">
<![CDATA[//			3. If the station is the reject station, any of the previous required stations did NOT successfully process. ]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[dStationNum := 1;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[//Check if the current station is required to operate by the recipe]]>
</Line>
<Line Number="16">
<![CDATA[If (TrackingDataTag.Nest[CheckNestNumTag].ProductData.StationRequired[StaNumTag]) Then   ]]>
</Line>
<Line Number="17">
<![CDATA[	//Check previous stations.]]>
</Line>
<Line Number="18">
<![CDATA[	//]]>
</Line>
<Line Number="19">
<![CDATA[	//Inverted logic was used to make the code structure simpler]]>
</Line>
<Line Number="20">
<![CDATA[	bStationSuccess := 1;]]>
</Line>
<Line Number="21">
<![CDATA[	ResponsibleFailStaNum := 0;]]>
</Line>
<Line Number="22">
<![CDATA[	For dStationNum := 1 to  StaNumTag - 1 By 1 Do]]>
</Line>
<Line Number="23">
<![CDATA[		//Check if previous stations were required by the recipe. Except for the reject station.]]>
</Line>
<Line Number="24">
<![CDATA[		If (TrackingDataTag.Nest[CheckNestNumTag].ProductData.StationRequired[dStationNum] AND (dStationNum <> RejectStaNum)) then]]>
</Line>
<Line Number="25">
<![CDATA[			//Check if the station didn't set the success bit and it also wasn't bypassed. If so, don't allow the current station to cycle]]>
</Line>
<Line Number="26">
<![CDATA[			If (NOT TrackingDataTag.Nest[CheckNestNumTag].PartStatus.Station[dStationNum].Success AND NOT TrackingDataTag.Nest[CheckNestNumTag].PartStatus.Station[dStationNum].Bypass) Then]]>
</Line>
<Line Number="27">
<![CDATA[					bStationSuccess := 0;]]>
</Line>
<Line Number="28">
<![CDATA[					ResponsibleFailStaNum := dStationNum;]]>
</Line>
<Line Number="29">
<![CDATA[					Exit; //Exit the for loop. We don't need to keep checking.]]>
</Line>
<Line Number="30">
<![CDATA[			End_if;]]>
</Line>
<Line Number="31">
<![CDATA[		End_if;]]>
</Line>
<Line Number="32">
<![CDATA[	End_for;]]>
</Line>
<Line Number="33">
<![CDATA[Else]]>
</Line>
<Line Number="34">
<![CDATA[	//The current Station is not required to operate by the recipe]]>
</Line>
<Line Number="35">
<![CDATA[	ResponsibleFailStaNum := 0;]]>
</Line>
<Line Number="36">
<![CDATA[	bStationSuccess := 0;]]>
</Line>
<Line Number="37">
<![CDATA[End_if;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[If (bStationSuccess XOR (StaNumTag = RejectStaNum)) Then  //Success and not reject OR not success and reject]]>
</Line>
<Line Number="40">
<![CDATA[	EnableOut := 1;	]]>
</Line>
<Line Number="41">
<![CDATA[ELSE]]>
</Line>
<Line Number="42">
<![CDATA[	EnableOut := 0;]]>
</Line>
<Line Number="43">
<![CDATA[End_if;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Chassis_State_Engine" Class="Standard" Revision="1.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-10-08T21:04:17.611Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2017-01-18T22:04:36.460Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v29.00">
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="StateTag" TagType="Base" DataType="BOOL" Dimensions="64" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="StateRegTag" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="i" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Set the State Bit, clear all other bits.]]>
</Line>
<Line Number="1">
<![CDATA[FOR i := 0 TO (StateRegTag - 1) DO]]>
</Line>
<Line Number="2">
<![CDATA[	StateTag[i] := 0;]]>
</Line>
<Line Number="3">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="4">
<![CDATA[StateTag[i] := 1;]]>
</Line>
<Line Number="5">
<![CDATA[FOR i := (StateRegTag + 1) TO 63 DO]]>
</Line>
<Line Number="6">
<![CDATA[	StateTag[i] := 0;]]>
</Line>
<Line Number="7">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="CPU_TimeDate_wJulian" Class="Standard" Revision="2.2" Vendor="SDC" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-05-01T14:06:05.139Z" CreatedBy="RA-INT\anabuto" EditedDate="2021-05-12T13:16:59.894Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.02">
<Description>
<![CDATA[Get CPU Time And Date. Calculates Day number from Jan 1 for Julian Day. Get UTC in microseconds.]]>
</Description>
<RevisionNote>
<![CDATA[2.0:  Added UTC functionality
2.1:  -Fixed non-functioning milliseconds
 -updated timedate UDT to add system clock microseconds
1-5-21 Dan Garr
v2.2 Cleaned up unused tags and optimized all data types for mem usage. 2021-05-11 D.E.S.]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="JulianDate" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[ordinal date]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="TimeDateTag" TagType="Base" DataType="CPU_TimeDate" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="Month" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="LookUp" DataType="INT" Dimensions="13" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,31,59,90,120,151,181,212,243,273,304,334]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Array DataType="INT" Dimensions="13" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
<Element Index="[2]" Value="31"/>
<Element Index="[3]" Value="59"/>
<Element Index="[4]" Value="90"/>
<Element Index="[5]" Value="120"/>
<Element Index="[6]" Value="151"/>
<Element Index="[7]" Value="181"/>
<Element Index="[8]" Value="212"/>
<Element Index="[9]" Value="243"/>
<Element Index="[10]" Value="273"/>
<Element Index="[11]" Value="304"/>
<Element Index="[12]" Value="334"/>
</Array>
</DefaultData>
</LocalTag>
<LocalTag Name="TimeDateArray" DataType="DINT" Dimensions="7" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0,0,0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Array DataType="DINT" Dimensions="7" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
<Element Index="[2]" Value="0"/>
<Element Index="[3]" Value="0"/>
<Element Index="[4]" Value="0"/>
<Element Index="[5]" Value="0"/>
<Element Index="[6]" Value="0"/>
</Array>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[GSV(WallClockTime,,LocalDateTime,TimeDateArray[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CLR(JulianDate)MOV(TimeDateArray[1],Month);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LIM(1,Month,12)ADD(LookUp[Month],TimeDateArray[2],JulianDate);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GRT(TimeDateArray[1],2)CMP(((TimeDateArray[0] MOD 4) = 0))[CMP(((TimeDateArray[0] MOD 100) > 0)) ,CMP(((TimeDateArray[0] MOD 400) = 0)) ]ADD(JulianDate,1,JulianDate);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOV(TimeDateArray[0],TimeDateTag.Year)MOV(TimeDateArray[1],TimeDateTag.Month)MOV(TimeDateArray[2],TimeDateTag.Day)MOV(TimeDateArray[3],TimeDateTag.Hour)MOV(TimeDateArray[4],TimeDateTag.Minutes)MOV(TimeDateArray[5],TimeDateTag.Seconds)DIV(TimeDateArray[6],1000,TimeDateTag.Milliseconds)MOV(TimeDateArray[6],TimeDateTag.Microseconds);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[GSV(TimeSynchronize,,CurrentTimeMicroseconds,TimeDateTag.UTCMicroseconds);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="DriveFreq_Lenze_i550" Class="Standard" Revision="1.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2018-07-09T12:46:46.278Z" CreatedBy="STEVENDOUGLAS\wehamby" EditedDate="2021-06-08T18:23:24.300Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.02">
<Description>
<![CDATA[Drive I/O Mapping to Local Tags For Ease Of Communications.]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
