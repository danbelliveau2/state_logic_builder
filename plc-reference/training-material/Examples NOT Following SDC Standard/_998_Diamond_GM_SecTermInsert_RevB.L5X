<Routines>
<Routine Name="BatchLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Batch (Order) Control
-Quantity Entered on HMI]]>
</Comment>
<Text>
<![CDATA[[HMI_OutMom(HMI_BatchStart,1,2000,1,BatchInProgress,1,0,\Security.Level,0,1) ,HMI_OutMom(HMI_BatchCancel,1,2000,1,BatchInProgress,1,0,\Security.Level,0,1) ,XIO(BatchInProgress) MOV(0,HMI_BatchStatusColor) ,[XIC(HMI_BatchStart.EnableOut) ,XIC(AlwaysOn) ] XIO(BatchInProgress) COP(ZeroProductionStructure,Data.Batch,1) OTL(BatchInProgress) OTE(BatchStartedPulse) ,XIC(BatchInProgress) [LES(Data.Batch.Good,HMI_BatchSetpoint) MOV(1,HMI_BatchStatusColor) ,GEQ(Data.Batch.Good,HMI_BatchSetpoint) [XIC(\Main.FlashFast) MOV(1,HMI_BatchStatusColor) ,XIO(\Main.FlashFast) MOV(2,HMI_BatchStatusColor) ] ONS(OneShot.3) OTE(BatchCompletePulse) ] ,[XIC(HMI_BatchCancel.EnableOut) ,XIC(BatchCompletePulse) ] XIC(BatchInProgress) OTU(BatchInProgress) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[**** BATCH COUNTER LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Copy calculated cycle time to current batch data

The cycle time calculation is performed in the production shift logic area]]>
</Comment>
<Text>
<![CDATA[MOV(CycleTimeSecs,Data.Batch.CycleTimeSecs)DIV(Data.Batch.CycleTimeSecs,60,Data.Batch.CycleTimeMins)DIV(Data.Batch.CycleTimeMins,60,Data.Batch.CycleTimeHours)MOV(CycleTimeAveSecs,Data.Batch.AveCycleTimeSecs)DIV(Data.Batch.AveCycleTimeSecs,60,Data.Batch.AveCycleTimeMins)DIV(Data.Batch.AveCycleTimeMins,60,Data.Batch.AveCycleTimeHours);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Cycle Rate
(Cycles Per Sec)

This is the inverse of actual cycle time]]>
</Comment>
<Text>
<![CDATA[DIV(1,CycleTimeSecs,Data.Batch.CycleRatePerSec)DIV(Data.Batch.CycleRatePerSec,60,Data.Batch.CycleRatePerMin)DIV(Data.Batch.CycleRatePerMin,60,Data.Batch.CycleRatePerHour);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Total Good]]>
</Comment>
<Text>
<![CDATA[XIC(GoodPartPulse)XIC(BatchInProgress)ADD(Data.Batch.Good,1,Data.Batch.Good);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Total Reject 
-Increment Total Reject Count
-Increment Reject Type Counts
]]>
</Comment>
<Text>
<![CDATA[XIC(RejectPartPulse)XIC(BatchInProgress)ADD(Data.Batch.Reject,1,Data.Batch.Reject)ADD(Data.Batch.RejectType[FailureType].Count,1,Data.Batch.RejectType[FailureType].Count);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Total
(Good Parts + Reject Parts)]]>
</Comment>
<Text>
<![CDATA[XIC(BatchInProgress)ADD(Data.Batch.Good,Data.Batch.Reject,Data.Batch.Total);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Good Efficiency (Also Called Quality)]]>
</Comment>
<Text>
<![CDATA[GRT(Data.Batch.Total,0)CPT(Data.Batch.GoodEff,Data.Batch.Good/Data.Batch.Total*100);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Reject Efficiency]]>
</Comment>
<Text>
<![CDATA[GRT(Data.Batch.Reject,0)CPT(Data.Batch.RejectEff,Data.Batch.Reject/Data.Batch.Total*100);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Cycle Runtime]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(\Mode.CycleRunning) ,XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ,XIC(\Mode.CycleStarting) ][MOV(1000,Tmr_BatchRuntime.PRE) RTO(Tmr_BatchRuntime,?,?) ,XIC(Tmr_BatchRuntime.DN) XIC(BatchInProgress) ADD(Data.Batch.RuntimeSecs,1,Data.Batch.RuntimeSecs) RES(Tmr_BatchRuntime) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(BatchInProgress)DIV(Data.Batch.RuntimeSecs,60,Data.Batch.RuntimeMins)DIV(Data.Batch.RuntimeMins,60,Data.Batch.RuntimeHours);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Cycle Downtime]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(\Mode.CycleRunning)[MOV(1000,Tmr_BatchDownTime.PRE) RTO(Tmr_BatchDownTime,?,?) ,XIC(Tmr_BatchDownTime.DN) XIC(BatchInProgress) ADD(Data.Batch.DowntimeSecs,1,Data.Batch.DowntimeSecs) RES(Tmr_BatchDownTime) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(BatchInProgress)DIV(Data.Batch.DowntimeSecs,60,Data.Batch.DowntimeMins)DIV(Data.Batch.DowntimeMins,60,Data.Batch.DowntimeHours);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Elapsed Time - 
Accumulated Time Since Last Reset]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(BatchStartedPulse)[MOV(1000,Tmr_ElapsedBatchTime.PRE) RTO(Tmr_ElapsedBatchTime,?,?) ,XIC(Tmr_ElapsedBatchTime.DN) XIC(BatchInProgress) ADD(Data.Batch.ElapsedTimeSecs,1,Data.Batch.ElapsedTimeSecs) RES(Tmr_ElapsedBatchTime) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(BatchInProgress)DIV(Data.Batch.ElapsedTimeSecs,60,Data.Batch.ElapsedTimeMins)DIV(Data.Batch.ElapsedTimeMins,60,Data.Batch.ElapsedTimeHours);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Good Rate (Parts Per Sec) -
Total Good / Runtime

This takes into account the good parts made during the time running]]>
</Comment>
<Text>
<![CDATA[DIV(Data.Batch.Good,Data.Batch.RuntimeSecs,Data.Batch.GoodRatePerSec)MUL(Data.Batch.GoodRatePerSec,60,Data.Batch.GoodRatePerMin)MUL(Data.Batch.GoodRatePerMin,60,Data.Batch.GoodRatePerHour);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Cycles (Indexes)]]>
</Comment>
<Text>
<![CDATA[XIC(CycleTimeStartPulse)ADD(Data.Batch.Cycles,1,Data.Batch.Cycles);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Runtime Efficiency (Also Called Availibility) (%) -
Runtime / Elapsed Time * 100%
Times are accumulated since last data reset.

NOTE: Not to be confused with Shift Availibility which is linked to the CPU clock.]]>
</Comment>
<Text>
<![CDATA[GRT(Data.Batch.ElapsedTimeSecs,0)CPT(Data.Batch.RuntimeEff,Data.Batch.RuntimeSecs / Data.Batch.ElapsedTimeSecs * 100)GRT(Data.Batch.RuntimeEff,100)MOV(100,Data.Batch.RuntimeEff);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Cycle Efficiency (Also Called Performance) (%) -
Standard (Designed/Quoted) Cycle Time / CalculatedCycleTime

CalculatedCycleTime = Runtime/Cycles(Indexes)
NOTE: The calculated cycle time is used so the Cycle Efficiency is calculated based on the accumulated data from the start of the data collection period]]>
</Comment>
<Text>
<![CDATA[MOV(StandardCycleTime,Data.Batch.StandardCycleTimeSecs)[GRT(Data.Batch.RuntimeSecs,0) GRT(Data.Batch.Cycles,0) CPT(Data.Batch.CycleEff,Data.Batch.StandardCycleTimeSecs / (Data.Batch.RuntimeSecs / Data.Batch.Cycles) * 100) ,[EQU(Data.Batch.RuntimeSecs,0) ,EQU(Data.Batch.Cycles,0) ] MOV(0,Data.Batch.CycleEff) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[O.E.E. (%) -
Runtime Efficiency * Cycle Efficiency * Good Efficiency
Also Known by industry standards as  Availability * Performance * Quality

NOTE: The end result is divided because the individual multipliers are in percentages instead of decimal numbers.]]>
</Comment>
<Text>
<![CDATA[CPT(Data.Batch.OEE,(Data.Batch.RuntimeEff * Data.Batch.CycleEff * Data.Batch.GoodEff) / 10000)GRT(Data.Batch.OEE,100)MOV(100,Data.Batch.OEE);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(BatchCompletePulse) OTL(Fault[1].Active) ,XIC(Fault[1].Active) XIC(\Main.FaultReset) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AlwaysOff)GRT(Data.Batch.Good,HMI_BatchSetpoint)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ShiftLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines Within The Current Program]]>
</Comment>
<Text>
<![CDATA[JSR(BatchLogic,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(GoodPart)ONS(OneShot.4)OTE(GoodPartPulse);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(RejectPart)ONS(OneShot.5)OTE(RejectPartPulse);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Calculate Shift Number]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[EQU(\Main.CPUTimeDate.Hour,ShiftBoundary[1].Start.Hours) EQU(\Main.CPUTimeDate.Minutes,ShiftBoundary[1].Start.Minutes) ONS(OneShot.0) MOV(1,ShiftNum) MOV(3,PrevShiftNum) ,EQU(\Main.CPUTimeDate.Hour,ShiftBoundary[2].Start.Hours) EQU(\Main.CPUTimeDate.Minutes,ShiftBoundary[2].Start.Minutes) ONS(OneShot.1) MOV(2,ShiftNum) MOV(1,PrevShiftNum) ,EQU(\Main.CPUTimeDate.Hour,ShiftBoundary[3].Start.Hours) EQU(\Main.CPUTimeDate.Minutes,ShiftBoundary[3].Start.Minutes) ONS(OneShot.2) MOV(3,ShiftNum) MOV(2,PrevShiftNum) ]OTE(ShiftChangedPulse);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[COP(Data.Shift[ShiftNum],HMI_CurrentShiftData,1);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[At Shift change copy the current shift to the historical shift data table (first shift the table UP).
***Bottom of the Table Is Most Recent***]]>
</Comment>
<Text>
<![CDATA[XIC(ShiftChangedPulse)COP(Data.HistoricalShift[1],Data.HistoricalShift[0],9)COP(Data.Shift[PrevShiftNum],Data.HistoricalShift[9],1);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Clear Shift Counters]]>
</Comment>
<Text>
<![CDATA[[XIC(ShiftChangedPulse) ,HMI_OutMom(HMI_ClearShift,1,2000,0,AlwaysOff,\Mode.Manual,0,\Security.Level,5,1) ]COP(ZeroProductionStructure,Data.Shift[ShiftNum],1);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Clear All Shift Counters]]>
</Comment>
<Text>
<![CDATA[HMI_OutMom(HMI_ClearAllShifts,1,2000,0,AlwaysOff,\Mode.Manual,0,\Security.Level,5,1)COP(ZeroProductionStructure,Data.Shift[1],1)COP(ZeroProductionStructure,Data.Shift[2],1)COP(ZeroProductionStructure,Data.Shift[3],1);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Clear Reject History]]>
</Comment>
<Text>
<![CDATA[HMI_OutMom(HMI_ClearRejectHistory,1,2000,0,AlwaysOff,AlwaysOn,0,\Security.Level,0,1)COP(\Tracking.ZeroTrackingNest,RejectHistory[0],1)COP(RejectHistory[0],RejectHistory[1],49);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[****PRODUCTION COUNTER LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Actual Cycle Time
(Seconds Per Cycle)

Average Cycle Time
(Seconds Per Cycle)

This calculation is used for both Shift and Batch data]]>
</Comment>
<Text>
<![CDATA[XIC(\Mode.Auto)[XIC(\Mode.CycleRunning) ,XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ,XIC(\Mode.CycleStarting) ][Chassis_CamPos_Check(AOI_CamPosChk1,20,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) OTE(CycleTimeStartPulse) ,XIC(CycleTimeStartPulse) LES(Tmr_CycleTime.ACC,35000) MOV(Tmr_CycleTime.ACC,CycleTimeTempDINT) DIV(CycleTimeTempDINT,1000,CycleTimeSecs) COP(CycleTimeArray[0],CycleTimeArray[25],20) COP(CycleTimeArray[25],CycleTimeArray[1],20) MOV(Tmr_CycleTime.ACC,CycleTimeArray[0]) AVE(CycleTimeArray[0],0,CycleTimeAveTempDINT,CycleTime_Inst,?,?) DIV(CycleTimeAveTempDINT,1000,CycleTimeAveSecs) ,XIO(CycleTimeStartPulse) MOV(999999,Tmr_CycleTime.PRE) TON(Tmr_CycleTime,?,?) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Copy calculated cycle time to current shift data]]>
</Comment>
<Text>
<![CDATA[MOV(CycleTimeSecs,Data.Shift[ShiftNum].CycleTimeSecs)DIV(Data.Shift[ShiftNum].CycleTimeSecs,60,Data.Shift[ShiftNum].CycleTimeMins)DIV(Data.Shift[ShiftNum].CycleTimeMins,60,Data.Shift[ShiftNum].CycleTimeHours)MOV(CycleTimeAveSecs,Data.Shift[ShiftNum].AveCycleTimeSecs)DIV(Data.Shift[ShiftNum].AveCycleTimeSecs,60,Data.Shift[ShiftNum].AveCycleTimeMins)DIV(Data.Shift[ShiftNum].AveCycleTimeMins,60,Data.Shift[ShiftNum].AveCycleTimeHours);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Cycle Rate
(Cycles Per Sec)

This is the inverse of actual cycle time]]>
</Comment>
<Text>
<![CDATA[DIV(1,CycleTimeSecs,Data.Shift[ShiftNum].CycleRatePerSec)DIV(Data.Shift[ShiftNum].CycleRatePerSec,60,Data.Shift[ShiftNum].CycleRatePerMin)DIV(Data.Shift[ShiftNum].CycleRatePerMin,60,Data.Shift[ShiftNum].CycleRatePerHour);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Total Good]]>
</Comment>
<Text>
<![CDATA[XIC(GoodPartPulse)ADD(Data.Shift[ShiftNum].Good,1,Data.Shift[ShiftNum].Good);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Total Reject 
-Increment Total Reject Count
-Increment Reject Type Counts
-Save Part Nest Tracking Data To Reject History Array (After shifting data)

NOTE: Reject history is not specific to Production or Shift Data. AND it is only used for the reject bin]]>
</Comment>
<Text>
<![CDATA[XIC(RejectPartPulse)[ADD(Data.Shift[ShiftNum].Reject,1,Data.Shift[ShiftNum].Reject) ,ADD(Data.Shift[ShiftNum].RejectType[FailureType].Count,1,Data.Shift[ShiftNum].RejectType[FailureType].Count) ,JSR(ShiftRejectHistory,0) COP(PartDataSavedRejectShelf,RejectHistory[1],1) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Total
(Good Parts + Reject Parts)]]>
</Comment>
<Text>
<![CDATA[ADD(Data.Shift[ShiftNum].Good,Data.Shift[ShiftNum].Reject,Data.Shift[ShiftNum].Total);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Good Efficiency (Also Called Quality)]]>
</Comment>
<Text>
<![CDATA[GRT(Data.Shift[ShiftNum].Total,0)CPT(Data.Shift[ShiftNum].GoodEff,Data.Shift[ShiftNum].Good/Data.Shift[ShiftNum].Total*100);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Reject Efficiency]]>
</Comment>
<Text>
<![CDATA[GRT(Data.Shift[ShiftNum].Reject,0)CPT(Data.Shift[ShiftNum].RejectEff,Data.Shift[ShiftNum].Reject/Data.Shift[ShiftNum].Total*100);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Cycle Runtime]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(\Mode.CycleRunning) ,XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ,XIC(\Mode.CycleStarting) ][MOV(1000,Tmr_Runtime.PRE) RTO(Tmr_Runtime,?,?) ,XIC(Tmr_Runtime.DN) ADD(Data.Shift[ShiftNum].RuntimeSecs,1,Data.Shift[ShiftNum].RuntimeSecs) RES(Tmr_Runtime) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[DIV(Data.Shift[ShiftNum].RuntimeSecs,60,Data.Shift[ShiftNum].RuntimeMins)DIV(Data.Shift[ShiftNum].RuntimeMins,60,Data.Shift[ShiftNum].RuntimeHours);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Cycle Downtime]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIO(\Mode.CycleRunning)XIO(\Mode.CycleStoppingPauseStartup)XIO(\Mode.CyclePaused)XIO(\Mode.CycleStarting)[MOV(1000,Tmr_DownTime.PRE) RTO(Tmr_DownTime,?,?) ,XIC(Tmr_DownTime.DN) ADD(Data.Shift[ShiftNum].DowntimeSecs,1,Data.Shift[ShiftNum].DowntimeSecs) RES(Tmr_DownTime) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[DIV(Data.Shift[ShiftNum].DowntimeSecs,60,Data.Shift[ShiftNum].DowntimeMins)DIV(Data.Shift[ShiftNum].DowntimeMins,60,Data.Shift[ShiftNum].DowntimeHours);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Elapsed Time - 
Accumulated Time Since Last Reset]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIO(ShiftChangedPulse)[MOV(1000,Tmr_ElapsedTime.PRE) RTO(Tmr_ElapsedTime,?,?) ,XIC(Tmr_ElapsedTime.DN) ADD(Data.Shift[ShiftNum].ElapsedTimeSecs,1,Data.Shift[ShiftNum].ElapsedTimeSecs) RES(Tmr_ElapsedTime) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Good Rate (Parts Per Sec) -
Total Good / Runtime

This takes into account the good parts made during the time running]]>
</Comment>
<Text>
<![CDATA[DIV(Data.Shift[ShiftNum].Good,Data.Shift[ShiftNum].RuntimeSecs,Data.Shift[ShiftNum].GoodRatePerSec)MUL(Data.Shift[ShiftNum].GoodRatePerSec,60,Data.Shift[ShiftNum].GoodRatePerMin)MUL(Data.Shift[ShiftNum].GoodRatePerMin,60,Data.Shift[ShiftNum].GoodRatePerHour);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Cycles (Indexes)]]>
</Comment>
<Text>
<![CDATA[XIC(CycleTimeStartPulse)ADD(Data.Shift[ShiftNum].Cycles,1,Data.Shift[ShiftNum].Cycles);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[DIV(Data.Shift[ShiftNum].ElapsedTimeSecs,60,Data.Shift[ShiftNum].ElapsedTimeMins)DIV(Data.Shift[ShiftNum].ElapsedTimeMins,60,Data.Shift[ShiftNum].ElapsedTimeHours);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Runtime Efficiency (Also Called Availibility) (%) -
Runtime / Elapsed Time * 100%
Times are accumulated since last data reset.

NOTE: Not to be confused with Shift Availibility which is linked to the CPU clock.]]>
</Comment>
<Text>
<![CDATA[GRT(Data.Shift[ShiftNum].ElapsedTimeSecs,0)CPT(Data.Shift[ShiftNum].RuntimeEff,Data.Shift[ShiftNum].RuntimeSecs / Data.Shift[ShiftNum].ElapsedTimeSecs * 100)GRT(Data.Shift[ShiftNum].RuntimeEff,100)MOV(100,Data.Shift[ShiftNum].RuntimeEff);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Cycle Efficiency (Also Called Performance) (%) -
Standard (Designed/Quoted) Cycle Time / CalculatedCycleTime

CalculatedCycleTime = Runtime/Cycles(Indexes)
NOTE: The calculated cycle time is used so the Cycle Efficiency is calculated based on the accumulated data from the start of the data collection period]]>
</Comment>
<Text>
<![CDATA[MOV(StandardCycleTime,Data.Shift[ShiftNum].StandardCycleTimeSecs)[GRT(Data.Shift[ShiftNum].RuntimeSecs,0) GRT(Data.Shift[ShiftNum].Cycles,0) CPT(Data.Shift[ShiftNum].CycleEff,Data.Shift[ShiftNum].StandardCycleTimeSecs / (Data.Shift[ShiftNum].RuntimeSecs / Data.Shift[ShiftNum].Cycles) * 100) ,[EQU(Data.Shift[ShiftNum].RuntimeSecs,0) ,EQU(Data.Shift[ShiftNum].Cycles,0) ] MOV(0,Data.Shift[ShiftNum].CycleEff) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[O.E.E. (%) -
Runtime Efficiency * Cycle Efficiency * Good Efficiency
Also Known by industry standards as  Availability * Performance * Quality

NOTE: The end result is divided because the individual multipliers are in percentages instead of decimal numbers.]]>
</Comment>
<Text>
<![CDATA[CPT(Data.Shift[ShiftNum].OEE,(Data.Shift[ShiftNum].RuntimeEff * Data.Shift[ShiftNum].CycleEff * Data.Shift[ShiftNum].GoodEff) / 10000)GRT(Data.Shift[ShiftNum].OEE,100)MOV(100,Data.Shift[ShiftNum].OEE);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ShiftRejectHistory" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[SIZE(RejectHistory,0,ArraySize);]]>
</Line>
<Line Number="1">
<![CDATA[for ArrayIndex := (ArraySize - 1) to 2 by -1 do]]>
</Line>
<Line Number="2">
<![CDATA[	COP(RejectHistory[ArrayIndex-1],RejectHistory[ArrayIndex],1);]]>
</Line>
<Line Number="3">
<![CDATA[end_for;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
