<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<Description>
<![CDATA[Logic For Fault and Warning Messages]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(MotionInstructions.MSO_Inst[0].EN) [XIC(MotionInstructions.MSO_Inst[0].ER) ,XIO(MotionInstructions.MSO_Inst[0].DN) MOV(1500,TmrFlt_ServoEnable.PRE) TON(TmrFlt_ServoEnable,?,?) XIC(TmrFlt_ServoEnable.DN) ] ONS(OneShotFlt.0) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) ]OTE(Fault[0].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(SafeOK) [XIC(ServoMotor.PhysicalAxisFault) ,XIC(ServoMotor.ModuleFault) ,XIC(ServoMotor.ConfigFault) ,XIC(ServoMotor.GroupFault) ,XIC(ServoMotor.MotionFault) ] XIO(MotionInstructions.MASR_Inst[0].EN) XIO(MotionInstructions.MAFR_Inst[0].EN) ONS(OneShotFlt.1) ,XIC(Fault[1].Active) XIO(\Main.FaultReset) ]OTE(Fault[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(SafeOK) [XIC(MotionInstructions.MAJ_Inst[0].EN) XIC(MotionInstructions.MAJ_Inst[0].ER) ,XIC(MotionInstructions.MAJ_Inst[1].EN) XIC(MotionInstructions.MAJ_Inst[1].ER) ,XIC(MotionInstructions.MAJ_Inst[2].EN) XIC(MotionInstructions.MAJ_Inst[2].ER) ,XIC(MotionInstructions.MAJ_Inst[3].EN) XIC(MotionInstructions.MAJ_Inst[3].ER) ,XIC(MotionInstructions.MAJ_Inst[4].EN) XIC(MotionInstructions.MAJ_Inst[4].ER) ,XIC(MotionInstructions.MAJ_Inst[5].EN) XIC(MotionInstructions.MAJ_Inst[5].ER) ,XIC(MotionInstructions.MAJ_Inst[6].EN) XIC(MotionInstructions.MAJ_Inst[6].ER) ,XIC(MotionInstructions.MAJ_Inst[7].EN) XIC(MotionInstructions.MAJ_Inst[7].ER) ,XIC(MotionInstructions.MAJ_Inst[8].EN) XIC(MotionInstructions.MAJ_Inst[8].ER) ,XIC(MotionInstructions.MAJ_Inst[9].EN) XIC(MotionInstructions.MAJ_Inst[9].ER) ,XIC(MotionInstructions.MAS_Inst[0].EN) XIC(MotionInstructions.MAS_Inst[0].ER) ,XIC(MotionInstructions.MAS_Inst[1].EN) XIC(MotionInstructions.MAS_Inst[1].ER) ,XIC(MotionInstructions.MAS_Inst[2].EN) XIC(MotionInstructions.MAS_Inst[2].ER) ,XIC(MotionInstructions.MAS_Inst[3].EN) XIC(MotionInstructions.MAS_Inst[3].ER) ,XIC(MotionInstructions.MAS_Inst[4].EN) XIC(MotionInstructions.MAS_Inst[4].ER) ,XIC(MotionInstructions.MAFR_Inst[0].EN) XIC(MotionInstructions.MAFR_Inst[0].ER) ,XIC(MotionInstructions.MAFR_Inst[1].EN) XIC(MotionInstructions.MAFR_Inst[1].ER) ,XIC(MotionInstructions.MCD_Inst[0].ER) ,XIC(MotionInstructions.MCD_Inst[1].ER) ,XIC(MotionInstructions.MRP_Inst[0].ER) ,XIC(MotionInstructions.MRP_Inst[1].ER) ,XIC(MotionInstructions.MAH_Inst.ER) ,[XIC(MotionInstructions.MAS_Inst[0].EN) [XIO(MotionInstructions.MAS_Inst[0].DN) ,XIO(MotionInstructions.MAS_Inst[0].PC) ] ,XIC(MotionInstructions.MAS_Inst[1].EN) [XIO(MotionInstructions.MAS_Inst[1].DN) ,XIO(MotionInstructions.MAS_Inst[1].PC) ] ,XIC(MotionInstructions.MAS_Inst[2].EN) [XIO(MotionInstructions.MAS_Inst[2].DN) ,XIO(MotionInstructions.MAS_Inst[2].PC) ] ,XIC(MotionInstructions.MAS_Inst[3].EN) [XIO(MotionInstructions.MAS_Inst[3].DN) ,XIO(MotionInstructions.MAS_Inst[3].PC) ] ,XIC(MotionInstructions.MAS_Inst[4].EN) [XIO(MotionInstructions.MAS_Inst[4].DN) ,XIO(MotionInstructions.MAS_Inst[4].PC) ] ,XIC(MotionInstructions.MAH_Inst.EN) [XIO(MotionInstructions.MAH_Inst.DN) ,XIO(MotionInstructions.MAH_Inst.PC) ] ] MOV(3000,TmrFlt_MotionInst.PRE) TON(TmrFlt_MotionInst,?,?) XIC(TmrFlt_MotionInst.DN) ] ONS(OneShotFlt.2) ,XIC(Fault[2].Active) XIO(\Main.FaultReset) ]OTE(Fault[2].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(SafeOK) [XIC(MotionInstructions.MAM_Inst[0].EN) XIC(MotionInstructions.MAM_Inst[0].ER) ,XIC(MotionInstructions.MAM_Inst[1].EN) XIC(MotionInstructions.MAM_Inst[1].ER) ,XIC(MotionInstructions.MAM_Inst[2].EN) XIC(MotionInstructions.MAM_Inst[2].ER) ,XIC(MotionInstructions.MAM_Inst[3].EN) XIC(MotionInstructions.MAM_Inst[3].ER) ,XIC(MotionInstructions.MAM_Inst[4].EN) XIC(MotionInstructions.MAM_Inst[4].ER) ,XIC(MotionInstructions.MAM_Inst[5].EN) XIC(MotionInstructions.MAM_Inst[5].ER) ,XIC(MotionInstructions.MAM_Inst[6].EN) XIC(MotionInstructions.MAM_Inst[6].ER) ,XIC(MotionInstructions.MAM_Inst[7].EN) XIC(MotionInstructions.MAM_Inst[7].ER) ,XIC(MotionInstructions.MAM_Inst[8].EN) XIC(MotionInstructions.MAM_Inst[8].ER) ,XIC(MotionInstructions.MAM_Inst[9].EN) XIC(MotionInstructions.MAM_Inst[9].ER) ,[XIC(MotionInstructions.MAM_Inst[0].EN) XIO(MotionInstructions.MAM_Inst[0].DN) ,XIC(MotionInstructions.MAM_Inst[1].EN) XIO(MotionInstructions.MAM_Inst[1].DN) ,XIC(MotionInstructions.MAM_Inst[2].EN) XIO(MotionInstructions.MAM_Inst[2].DN) ,XIC(MotionInstructions.MAM_Inst[3].EN) XIO(MotionInstructions.MAM_Inst[3].DN) ,XIC(MotionInstructions.MAM_Inst[4].EN) XIO(MotionInstructions.MAM_Inst[4].DN) ,XIC(MotionInstructions.MAM_Inst[5].EN) XIO(MotionInstructions.MAM_Inst[5].DN) ,XIC(MotionInstructions.MAM_Inst[6].EN) XIO(MotionInstructions.MAM_Inst[6].DN) ,XIC(MotionInstructions.MAM_Inst[7].EN) XIO(MotionInstructions.MAM_Inst[7].DN) ,XIC(MotionInstructions.MAM_Inst[8].EN) XIO(MotionInstructions.MAM_Inst[8].DN) ,XIC(MotionInstructions.MAM_Inst[9].EN) XIO(MotionInstructions.MAM_Inst[9].DN) ] MOV(4000,TmrFlt_MoveInst.PRE) TON(TmrFlt_MoveInst,?,?) XIC(TmrFlt_MoveInst.DN) ] ONS(OneShotFlt.3) ,XIC(Fault[3].Active) XIO(\Main.FaultReset) ]OTE(Fault[3].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(SafeOK) XIC(ServoMotor.DriveEnableStatus) XIC(ServoMotor.TorqueLimitStatus) ONS(OneShotFlt.4) OTL(Fault[4].Active) ,XIC(Fault[4].Active) XIC(\Main.FaultReset) OTU(Fault[4].Active) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Fault[5].Active)XIC(\Main.FaultReset)OTU(Fault[5].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_ManGripper,0,OUT_GripperClose,OUT_GripperOpen,0,0,0,0,\Mode.Manual,0,\Security.Level,0) ,XIC(OUT_GripperOpen) XIO(OUT_GripperClose) ONS(OneShot.0) OTU(DiodeGrippedMemory) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManGripperUpDn,0,OUT_GripperUp,OUT_GripperDn,0,0,0,0,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogFwd,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogRev,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManMoveHandoff,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManMoveCut,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ZeroServo,1,2000,0,AlwaysOff,Status.State[0],0,\Security.Level,10,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[HMI_OpnPopup(HMI_OpenZeroPopupSwingArm,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,52,\Safety.EStopNOK,\Security.Level,10);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Position" Type="RLL">
<Description>
<![CDATA[Calculations For Servo Motor Position]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calculate Position For Status (In mm)
Note : The value is multiplied and divided to remove scientific notation and create a fixed number of decimal places. ]]>
</Comment>
<Text>
<![CDATA[MUL(ServoMotor.ActualPosition,1000,ServoPosDegREALTemp)TRN(ServoPosDegREALTemp,ServoPosDegREALTemp)DIV(ServoPosDegREALTemp,1000,ServoPosDeg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(OUT_GripperDn)TON(Tmr_GrprDwn,?,?)XIC(Tmr_GrprDwn.DN)OTE(GripperDown);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[CMP(ServoPosDeg <= (MotionPosition.Handoff - MotionPosition.InPosTol)) ,XIC(GripperDown) ]OTE(ClearOfInserter);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[CMP(ServoPosDeg >= (MotionPosition.Cut + MotionPosition.InPosTol)) ,XIC(GripperDown) ]OTE(ClearOfICutter);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CMP(ServoPosDeg < (MotionPosition.Cut + MotionPosition.InPosTol))CMP(ServoPosDeg > (MotionPosition.Cut - MotionPosition.InPosTol))OTE(AtCutPos);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CMP(ServoPosDeg < (MotionPosition.Handoff + MotionPosition.InPosTol))CMP(ServoPosDeg > (MotionPosition.Handoff - MotionPosition.InPosTol))OTE(AtHandoffPos);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[LEQ(ServoPosDeg,4.0) OTE(LimitPos) ,GEQ(ServoPosDeg,722) OTE(LimitNeg) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(Position,0)JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[Servo_Capacity(AOI_MotorCapacity,ServoMotor)MOV(500,ServoMotor.TorqueLimitPositive)MOV(-500,ServoMotor.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[XIC(SafeOK) [XIC(ServoMotor.AxisHomedStatus) MOV(1,Control.StateReg) ,XIO(ServoMotor.AxisHomedStatus) ONS(OneShotFlt.5) OTL(Fault[5].Active) ] ,XIO(SafeOK) XIC(HMI_ZeroServo.EnableOut) MAH(ServoMotor,MotionInstructions.MAH_Inst) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 1
Stop All Servo Drive Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIO(ServoMotor.ShutdownStatus) MAS(ServoMotor,MotionInstructions.MAS_Inst[0],All,Yes,60,% of Maximum,No,0,Units per sec3) XIC(MotionInstructions.MAS_Inst[0].DN) ,XIC(ServoMotor.ShutdownStatus) MASR(ServoMotor,MotionInstructions.MASR_Inst[0]) XIC(MotionInstructions.MASR_Inst[0].DN) ]MOV(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 2
Fault Reset Servo Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])MAFR(ServoMotor,MotionInstructions.MAFR_Inst[0])XIC(MotionInstructions.MAFR_Inst[0].DN)MOV(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 3
Enable Lift Servo Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])MSO(ServoMotor,MotionInstructions.MSO_Inst[0])XIC(MotionInstructions.MSO_Inst[0].DN)XIC(ServoMotor.DriveEnableStatus)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 10
Ready / Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(\Mode.Auto)XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIO(DiodeGrippedMemory) [XIC(AtCutPos) XIC(OUT_GripperDn) XIC(OUT_GripperOpen) XIC(\DiodeFeedCut.ReadyToCut) MOV(11,Control.StateReg) ,[XIO(AtCutPos) ,XIO(OUT_GripperDn) ,XIO(OUT_GripperOpen) ] MOV(25,Control.StateReg) ] ,XIC(DiodeGrippedMemory) [XIC(OUT_GripperClose) [XIC(AtHandoffPos) XIC(OUT_GripperDn) MOV(20,Control.StateReg) ,[XIO(AtHandoffPos) ,XIO(OUT_GripperDn) ] MOV(16,Control.StateReg) ] ,XIO(OUT_GripperClose) MOV(25,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])[XIC(\Mode.Manual) [XIC(HMI_ManJogFwd.EnableOut) XIO(LimitPos) MOV(50,Control.StateReg) ,XIC(HMI_ManJogRev.EnableOut) XIO(LimitNeg) MOV(51,Control.StateReg) ,XIC(OUT_GripperDn) [XIC(HMI_ManMoveCut.EnableOut) MOV(53,Control.StateReg) ,XIC(HMI_ManMoveHandoff.EnableOut) MOV(54,Control.StateReg) ] ] ,XIC(\DiodeFeedCut.MakeDiodesActive) XIO(ClearOfICutter) MOV(55,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 11
Gripper Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[11])[OTL(OUT_GripperUp) OTU(OUT_GripperDn) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(12,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 12
Gripper Close]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[12])[OTL(OUT_GripperClose) OTU(OUT_GripperOpen) ,OTL(DiodeGrippedMemory) ,MOV(20,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(15,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 15
Gripped At Cut Signal]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTE(GrippedAtCut) ,XIC(\DiodeFeedCut.DiodeCutFromStrip) MOV(16,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 16
Gripper Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[OTL(OUT_GripperDn) OTU(OUT_GripperUp) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(17,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 17
Move To Inserter Handoff Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[17])[MAM(ServoMotor,MotionInstructions.MAM_Inst[2],MotionConstants.Absolute,MotionPosition.Handoff,MotionParameters[3].Vel,Units per sec,MotionParameters[3].Acc,Units per sec2,MotionParameters[3].Dec,Units per sec2,Trapezoidal,MotionParameters[3].Jerk,MotionParameters[3].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[2].PC) ,XIC(AtHandoffPos) ] MOV(20,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 20
Diode Ready For Handoff To Inserter]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])[OTE(ReadyForHandoff) ,XIC(\DiodeInsert.ReadyForDiode) MOV(21,Control.StateReg) ,XIC(\Mode.Manual) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 21
Gripper Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[21])[OTL(OUT_GripperUp) OTU(OUT_GripperDn) ,MOV(200,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(22,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 22
OK To Handoff]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[22])[OTE(OkToHandoff) ,XIC(\DiodeInsert.GrippedAtHandoff) MOV(25,Control.StateReg) ,XIC(\Mode.Manual) AFI() MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 25
Gripper Open]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[OTL(OUT_GripperOpen) OTU(OUT_GripperClose) ,OTU(DiodeGrippedMemory) ,MOV(50,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(26,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 26
Gripper Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[26])[OTL(OUT_GripperDn) OTU(OUT_GripperUp) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(27,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 27
Move To Cut Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[27])[MAM(ServoMotor,MotionInstructions.MAM_Inst[3],MotionConstants.Absolute,MotionPosition.Cut,MotionParameters[2].Vel,Units per sec,MotionParameters[2].Acc,Units per sec2,MotionParameters[2].Dec,Units per sec2,Trapezoidal,MotionParameters[2].Jerk,MotionParameters[2].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,XIC(MotionInstructions.MAM_Inst[3].PC) XIC(AtCutPos) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 50
Jog Forward]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[50])MAJ(ServoMotor,MotionInstructions.MAJ_Inst[0],0,MotionParameters[1].Vel,Units per sec,MotionParameters[1].Acc,Units per sec2,MotionParameters[1].Dec,Units per sec2,Trapezoidal,MotionParameters[1].Jerk,MotionParameters[1].Jerk,% of Time,Disabled,Programmed,0,None)[XIO(HMI_ManJogFwd.EnableOut) ,XIC(LimitPos) ]MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 51
Jog Reverse]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[51])MAJ(ServoMotor,MotionInstructions.MAJ_Inst[1],1,MotionParameters[1].Vel,Units per sec,MotionParameters[1].Acc,Units per sec2,MotionParameters[1].Dec,Units per sec2,Trapezoidal,MotionParameters[1].Jerk,MotionParameters[1].Jerk,% of Time,Disabled,Programmed,0,None)[XIO(HMI_ManJogRev.EnableOut) ,XIC(LimitNeg) ]MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 52
Stop Jog
MAS]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[52])MAS(ServoMotor,MotionInstructions.MAS_Inst[2],Jog,No,MotionParameters[0].Dec,Units per sec2,No,80,% of Time)XIC(MotionInstructions.MAS_Inst[2].DN)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 53
Manual Move To Cut Diode Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[53])[MAM(ServoMotor,MotionInstructions.MAM_Inst[0],MotionConstants.Absolute,MotionPosition.Cut,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[0].PC) ,XIC(AtCutPos) ] MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 54
Manual Move To Inserter Handoff Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[54])[MAM(ServoMotor,MotionInstructions.MAM_Inst[1],MotionConstants.Absolute,MotionPosition.Handoff,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[1].PC) ,XIC(AtHandoffPos) ] MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 55
--Move for Manual Diode Cut Sequence--
-Gripper Open
-Gripper Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[55])[OTL(OUT_GripperOpen) OTU(OUT_GripperClose) ,OTU(DiodeGrippedMemory) ,MOV(120,Control.TransitionTime) ,TON(Tmr_DlyGrprDwn,?,?) XIC(Tmr_DlyGrprDwn.DN) OTL(OUT_GripperDn) OTU(OUT_GripperUp) ,XIC(Status.TransitionTimerDone) MOV(56,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 56
--Move for Manual Diode Cut Sequence--
Manual Move To Be Clear Of Cutter]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[56])[MAM(ServoMotor,MotionInstructions.MAM_Inst[4],MotionConstants.Absolute,50,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,XIC(MotionInstructions.MAM_Inst[4].PC) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 125
--Faulted--
Stop All Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])[MAS(ServoMotor,MotionInstructions.MAS_Inst[1],All,Yes,80,% of Maximum,No,0,Units per sec3) ,[XIC(MotionInstructions.MAS_Inst[1].ER) ,XIC(MotionInstructions.MAS_Inst[1].PC) ,XIC(MotionInstructions.MAS_Inst[1].DN) ] XIO(ServoMotor.MoveStatus) MOV(126,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE 126
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[126])[XIC(ServoMotor.DriveEnableStatus) MSF(ServoMotor,MotionInstructions.MSF_Inst[0]) ,[XIC(MotionInstructions.MSF_Inst[0].DN) ,XIC(MotionInstructions.MSF_Inst[0].ER) ,XIC(AlwaysOn) ] XIO(ServoMotor.DriveEnableStatus) MOV(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[STATE 127
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])XIO(FaultActive)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(FaultActive)XIO(Status.State[125])XIO(Status.State[126])XIO(Status.State[127])MOV(125,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
