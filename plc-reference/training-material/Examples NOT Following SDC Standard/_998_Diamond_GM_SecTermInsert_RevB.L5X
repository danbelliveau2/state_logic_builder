<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="ControllerModuleTag_Inputs" TagType="Base" DataType="_024B:2017_03_07_i550_76270E88:I:0" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Use Ethernet Module Tag Name : I (Inputs) from controller tags]]>
</Description>
</Parameter>
<Parameter Name="ControllerModuleTag_Outputs" TagType="Base" DataType="_024B:2017_03_07_i550_7377BDB4:O:0" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Use Ethernet Module Tag Name : O (Outputs) from controller tags]]>
</Description>
</Parameter>
<Parameter Name="DriveInputsTag" TagType="Base" DataType="Lenze_i550Drive_Status" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="DriveOutputsTag" TagType="Base" DataType="Lenze_i550Drive_Control" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="ErrorCodeMask" DataType="INT" Radix="Binary" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[32767]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Binary" Value="2#0111_1111_1111_1111"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Map The Input Bits.
Drive Outputs To PLC Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].0)OTE(DriveInputsTag.Fault);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].1)OTE(DriveInputsTag.Warning);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].2)OTE(DriveInputsTag.RunningForward);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].3)OTE(DriveInputsTag.RunningReverse);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].4)OTE(DriveInputsTag.Ready);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].5)OTE(DriveInputsTag.NetControl);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].6)OTE(DriveInputsTag.NetSetpoint);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].7)OTE(DriveInputsTag.AtReference);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].8)OTE(DriveInputsTag.StateBit0);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].9)OTE(DriveInputsTag.StateBit1);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].10)OTE(DriveInputsTag.StateBit2);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].11)OTE(DriveInputsTag.StateBit3);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].12)OTE(DriveInputsTag.ProcessCTRLActive);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].13)OTE(DriveInputsTag.TorqueActive);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].14)OTE(DriveInputsTag.CurrentLimit);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].15)OTE(DriveInputsTag.DCBrake);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[COP(ControllerModuleTag_Inputs.Data[1],DriveInputsTag.Speed,1);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Map The Output Bits.
PLC Outputs To Drive Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.RunForward)OTE(ControllerModuleTag_Outputs.Data[0].0);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.RunReverse)OTE(ControllerModuleTag_Outputs.Data[0].1);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Reset)OTE(ControllerModuleTag_Outputs.Data[0].2);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Bit3)OTE(ControllerModuleTag_Outputs.Data[0].3);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Bit4)OTE(ControllerModuleTag_Outputs.Data[0].4);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.NetControl)OTE(ControllerModuleTag_Outputs.Data[0].5);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.NetSetpoint)OTE(ControllerModuleTag_Outputs.Data[0].6);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Bit7)OTE(ControllerModuleTag_Outputs.Data[0].7);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Bit8)OTE(ControllerModuleTag_Outputs.Data[0].8);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Bit9)OTE(ControllerModuleTag_Outputs.Data[0].9);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Bit10)OTE(ControllerModuleTag_Outputs.Data[0].10);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Bit11)OTE(ControllerModuleTag_Outputs.Data[0].11);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.Disable)OTE(ControllerModuleTag_Outputs.Data[0].12);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.QuickStop)OTE(ControllerModuleTag_Outputs.Data[0].13);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.DeactivatePID)OTE(ControllerModuleTag_Outputs.Data[0].14);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(DriveOutputsTag.DCBrake)OTE(ControllerModuleTag_Outputs.Data[0].15);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[COP(DriveOutputsTag.Speed,ControllerModuleTag_Outputs.Data[1],1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="EIPCommStatus" Class="Standard" Revision="2.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-10-23T14:38:53.974Z" CreatedBy="Jason-PC\Jason" EditedDate="2021-01-20T21:55:59.207Z" EditedBy="STEVENDOUGLAS\wehamby" SoftwareRevision="v32.02"
>
<Description>
<![CDATA[V2.0 - Added PowerUpComplete FaultReset & FltRst Inputs : W.E.H. 2020-02-29]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="NodeName" TagType="Base" DataType="MODULE" Usage="InOut" Required="true" Visible="true"/>
<Parameter Name="ComOK" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Inhibited" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="PowerUpCmpltTag" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Machine Power Up Complete (Start Checking Comms)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="FaultResetTag" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Fault Reset]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="UseWarning" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[0- Ignore, 1-Use Warning Tag For Module Inhibited]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="FaultActiveTag" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Fault Active Tag For Comm Fault]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="WarningActiveTag" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Warning Tag for Module Inhibited (If Used)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="DeviceNumTag" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Tag which counts through device numbers.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="PublicProgramIDTag" TagType="Base" DataType="INT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Master Program ID tag used for all handler instances to obtain a unique ID]]>
</Description>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="NodeStatusMask" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="NodeStatus" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ProgramID" DataType="INT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Local Program ID]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="OneShot" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[ADD(PublicProgramIDTag,1,PublicProgramIDTag)MOV(PublicProgramIDTag,ProgramID);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ANDing the NodeStatus with 61440 Strips the first four binary digits out of the status dint

Note: 24576 is 16#6000 in Hex. This means the module is Inhibited]]>
</Comment>
<Text>
<![CDATA[XIC(PowerUpCmpltTag)[EQU(DeviceNumTag,ProgramID) ONS(OneShot) GSV(Module,NodeName,EntryStatus,NodeStatus) ,[AND(NodeStatus,61440,NodeStatusMask) EQU(NodeStatusMask,16384) OTE(ComOK) ,AND(NodeStatus,61440,NodeStatusMask) EQU(NodeStatusMask,24576) OTE(Inhibited) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(PowerUpCmpltTag)[XIO(ComOK) XIO(Inhibited) ,XIC(FaultActiveTag) XIO(FaultResetTag) ]OTE(FaultActiveTag);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(PowerUpCmpltTag)XIC(UseWarning)XIO(FaultActiveTag)XIC(Inhibited)OTE(WarningActiveTag);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="GetFTPFilename" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2021-04-26T20:17:42.883Z" CreatedBy="EE-VM-001\Local Administrator" EditedDate="2021-04-27T13:17:59.097Z" EditedBy="EE-VM-001\Local Administrator" SoftwareRevision="v32.02"
>
<Description>
<![CDATA[Get the FTP filename from the FTP path sent to the PLC by a Cognex camera via an array of REAL.]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
