</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_Select130,1,2000,0,0,1,0,\Security.Level,0,1) ,HMI_OutMom(HMI_Select116,1,2000,0,0,1,0,\Security.Level,0,1) ,[XIC(HMI_Select130.EnableOut) MOV(0,SavedPointer) ,XIC(HMI_Select116.EnableOut) MOV(1,SavedPointer) ] OTE(Control.Download) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(PreventRecipeDownload)GEQ(SavedPointer,0)LES(SavedPointer,Setup_SavedRecipeArrayLength)XIC(Control.Download)ONS(OneShot.10)[COP(Data.Saved[SavedPointer],Data.Running,1) ,[MOV(SavedPointer,Data.Running_ID) ,OTE(DownloadPulse) ] ];]]>
</Text>
</Rung>
