<Routines>
<Routine Name="Estop" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Tags from the normal controller logic can be mapped to the Safetyprogram with the Safety Tag Mapping feature. (LOGIC > Map Safety Tags...)]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[OTE(AlwaysOn)XIO(AlwaysOn)OTE(AlwaysOff);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AlwaysOn)[TON(Tmr_PwrUpDlyPLC,?,?) XIC(Tmr_PwrUpDlyPLC.DN) OTE(PowerUpComplete) ,TON(Tmr_PwrUpDlyMotn,?,?) XIC(Tmr_PwrUpDlyMotn.DN) OTE(MotionUpComplete) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(FaultResetPB_s)ONS(OneShot.0)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(FlashTimer.DN)TON(FlashTimer,?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Calls To Input Routine Within The Current Program]]>
</Comment>
<Text>
<![CDATA[JSR(Guarding,0)JSR(IOModules,0)JSR(SafetyZones,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Check Status Of All Estop Buttons
NOTE: This does not check the status of the module that the button is wired to. This is monitored seperately. (See Safety/Rack Module OK Status Bits) 

NOTE: The backing tags for the Safe_EstopPB AOI's have useage set as an "Output Parameter" so the Pressed status can be used in the Main Task for fault messages]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[Safe_EstopPB(EstopPBs,Local:1:I.Pt00.Data,Local:1:I.Pt01.Data,Local:1:I.Pt00.Status,Local:1:I.Pt01.Status,FaultReset) ,XIC(BypassEstopPB.0) OTE(EstopPBs.Bypass) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(EstopPBs.Released)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)OTE(AllEstopsReleased);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Check Status Of All Robot Estop Buttons]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)OTE(AllRobotEstopsOK);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Estop Safety Circuit Reset
("Safety Reset" Pushbutton)

NOTE: The Safety Reset pushbutton is wired to standard inputs, so it has been mapped from the Main Task to the Safety Task then back for the indicator light.]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyResetPBL_s)XIC(DeviceMonitorOK)OTE(SafetyReset)OSF(EstopReset_SB,EstopReset_OSF);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(AlwaysOn)XIC(AlwaysOn)OTE(DeviceMonitorOK);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Input Conditions For Estop Circuit]]>
</Comment>
<Text>
<![CDATA[XIC(PowerUpComplete)TON(Tmr_PwrUpDlyEstop,?,?)XIC(Tmr_PwrUpDlyEstop.DN)XIC(AllRackModulesOK)XIC(AllSafetyIOModulesOK)XIC(AllEstopsReleased)XIC(AllRobotEstopsOK)[XIC(AlwaysOn) OTE(EstopInputsChAOK) ,XIC(AlwaysOn) OTE(EstopInputsChBOK) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[ESTOP(Estop,MANUAL,EstopInputsChAOK,EstopInputsChBOK,EstopReset_OSF,FaultReset) [XIC(Estop.O1) OTE(EStopOK) ,XIO(Estop.O1) OTE(EStopNOK) ] ,[XIC(EStopOK) ,XIO(EStopOK) XIC(EstopInputsChAOK) CMP((FlashTimer.ACC MOD 1600) < 200) ] OTE(EstopResetIndicator) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(EstopPBs.IMF) ,XIC(EstopPBs.OPF) ,XIC(Estop.FP) ]OTE(EstopSafetyInstructionFaulted);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[All Safety Circuits OK]]>
</Comment>
<Text>
<![CDATA[[XIC(EStopOK) XIC(GuardOK) OTE(OK) ,XIO(OK) OTE(NOK) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Estop Auxiliary Relays , Main Air Dump Valve, Terminal Dereeler]]>
</Comment>
<Text>
<![CDATA[XIC(EStopOK)[OTE(Local:4:O.Pt00.Data) ,OTE(Local:4:O.Pt01.Data) ,OTE(Local:4:O.Pt07.Data) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Guarding" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Check Status Of All Guard Doors
NOTE: This does not check the status of the module that the device is wired to. This is monitored seperately. (See Safety/Rack Module OK Status Bits) ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[The Tray Stacker is part of a different safety zone. Therefore, it is not part of the GuardOK logic]]>
</Comment>
<Text>
<![CDATA[[[Safe_GuardDevice(GuardDoors,Local:1:I.Pt04.Data,Local:1:I.Pt05.Data,Local:1:I.Pt04.Status,Local:1:I.Pt05.Status,FaultReset) ,XIC(BypassGuard.0) OTE(GuardDoors.Bypass) ] ,[Safe_ScannerKeyenceSZV_CIPSafe(AreaScanner,SafetyScanner:SI,SafetyScanner:SO,1,FaultReset) ,XIC(BypassGuard.1) OTE(AreaScanner.Bypass) ] ,[Safe_GuardDevice(TrayStacker,Local:1:I.Pt06.Data,Local:1:I.Pt07.Data,Local:1:I.Pt06.Status,Local:1:I.Pt07.Status,FaultReset) ,XIC(BypassGuard.2) OTE(TrayStacker.Bypass) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(GuardDoors.Closed)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)OTE(AllGuardDoorsClosed);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AllGuardDoorsClosed)XIC(AreaScanner.ZoneAOK)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)XIC(AlwaysOn)OTE(AllGuardDevicesOK);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Input Conditions For Guard Circuit
]]>
</Comment>
<Text>
<![CDATA[XIC(PowerUpComplete)TON(Tmr_PwrUpDlyGrdDr,?,?)XIC(Tmr_PwrUpDlyGrdDr.DN)XIC(EStopOK)XIC(AllGuardDevicesOK)[XIC(AlwaysOn) OTE(GuardInputsChAOK) ,XIC(AlwaysOn) OTE(GuardInputsChBOK) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[DCS(Guard,SAFETY GATE,EQUIVALENT - ACTIVE HIGH,30,AUTOMATIC,AUTOMATIC,GuardInputsChAOK,GuardInputsChBOK,1,FaultReset)[XIC(Guard.O1) OTE(GuardOK) ,XIO(Guard.O1) OTE(GuardNOK) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(GuardDoors.IMF) ,XIC(GuardDoors.OPF) ,XIC(TrayStacker.IMF) ,XIC(TrayStacker.OPF) ,XIC(Guard.FP) ]OTE(GuardingSafetyInstructionFaulted);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
