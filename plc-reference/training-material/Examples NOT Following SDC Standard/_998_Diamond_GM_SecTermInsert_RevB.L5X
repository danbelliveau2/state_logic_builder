<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[\BobbinLoad.StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_CamDwn) XIO(IN_CamExtd) ,XIC(OUT_CamUp) XIO(IN_CamRetd) ] TON(TmrFlt_Cam,?,?) XIC(TmrFlt_Cam.DN) OTL(Fault[1].Active) ,XIC(Fault[1].Active) XIC(\Main.FaultReset) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[\BobbinLoad.StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_BobbinHoldDn) XIC(IN_BobbinHoldUp) ,XIC(OUT_BobbinHoldUp) XIO(IN_BobbinHoldUp) ] TON(TmrFlt_BobbinHold,?,?) XIC(TmrFlt_BobbinHold.DN) OTL(Fault[2].Active) ,XIC(Fault[2].Active) XIC(\Main.FaultReset) OTU(Fault[2].Active) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0)JSR(ManualControl,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
