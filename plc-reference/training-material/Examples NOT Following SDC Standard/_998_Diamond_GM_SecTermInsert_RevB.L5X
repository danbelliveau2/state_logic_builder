<Routines>
<Routine Name="EthernetCommStatus" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines Within The Current Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Monitor Ethernet IP device comms.

*********************************************************************************************************

From Rockwell Knowledgebase 47624 (created 12/19/2007 so info may no longer apply?):
"It is strongly suggested to avoid flooding the controller with status requests from GSV instructions. [This] code should be in a periodic task with a time base as long as your application can tolerate; ideally 1,000 ms or greater."]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(\Main.FlashSlow) ONS(OneShot.0) ,XIO(\Main.FlashSlow) ONS(OneShot.1) ]CPT(DeviceNum,(DeviceNum + 1) MOD 40);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOV(0,ProgramID);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EIPCommStatus(AOI_EIPCommStat0,DriveServo_Cam,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[0].Active,Warning[0].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat1,DriveServo_Dial,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[1].Active,Warning[1].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat2,DriveServo_TerminalPunch,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[2].Active,Warning[2].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat3,DriveServo_TerminalFeed,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[3].Active,Warning[3].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat4,DriveServo_TrayElevator,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[4].Active,Warning[4].Active,DeviceNum,ProgramID);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EIPCommStatus(AOI_EIPCommStat5,DriveServo_DiodeSwingArm,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[5].Active,Warning[5].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat6,DriveServo_DiodeInsert,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[6].Active,Warning[6].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat7,Vision_DiodeInspect,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[7].Active,Warning[7].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat8,Vision_HVWireInspect,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[8].Active,Warning[8].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat9,Vision_TerminalInspect,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[9].Active,Warning[9].Active,DeviceNum,ProgramID);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EIPCommStatus(AOI_EIPCommStat10,ValveManifold_Table,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[10].Active,Warning[10].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat11,ValveManifold_Top,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[11].Active,Warning[11].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat12,ValveManifold_WireCutInsert,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[12].Active,Warning[12].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat13,ValveManifold_TrayStacker,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[13].Active,Warning[13].Active,DeviceNum,ProgramID)EIPCommStatus(AOI_EIPCommStat14,EpsonRobot_WireInsert,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[14].Active,Warning[14].Active,DeviceNum,ProgramID);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EIPCommStatus(AOI_EIPCommStat15,EpsonRobot_Unload,\Safety.PowerUpComplete,\Main.FaultReset,0,Fault[15].Active,Warning[15].Active,DeviceNum,ProgramID);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
