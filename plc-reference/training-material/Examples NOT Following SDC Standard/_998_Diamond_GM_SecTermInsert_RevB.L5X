</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[This logic toggles between OutputATag and OutputBTag
(When A is On , B is Off)]]>
</Comment>
<Text>
<![CDATA[XIC(Trigger)XIO(Invisible)XIO(Inactive)NEQ(HMICurrentPopupNumTag,PopupScreenNum)ONS(OneShot)MOV(PopupScreenNum,HMIReplaceScreenNumTag);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQU(HMICurrentPopupNumTag,PopupScreenNum)ONS(OneShot2)MOV(0,HMIReplaceScreenNumTag);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LES(SecurityCurrentLevelTag,MinAccessLevel)OTE(Inactive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(VisibilityCondition)OTE(Invisible);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="HMI_OutTog" Class="Standard" Revision="2.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-09-11T17:38:56.392Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2020-01-17T14:26:38.813Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.01">
<Description>
<![CDATA[Button Toggle For Device with 1 or 2 Outputs
(Use For PanelView 5000)]]>
</Description>
<RevisionNote>
<![CDATA[2_0 Added Greyout feature and output energized status : W.E.H. 2020-01-14]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
