</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(MAM_STOP_CamInst.EN) ,XIC(MAS_CamInstImmed.EN) ,XIC(MAS_CamInstPause.EN) ,XIC(MAS_CamJogInst.EN) ]ONS(OneShotFault.11)MOV(Setup_CamAxisTag.ActualVelocity,ActualVelocityBeforeStop);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[[XIC(MAJ_CamInst.EN) XIC(MAJ_CamInst.ER) ,XIC(MAJ_CamSlaveInst.EN) XIC(MAJ_CamSlaveInst.ER) ,XIC(MAM_STOP_CamInst.ER) ,XIC(MAJ_CamJogInst.EN) XIC(MAJ_CamJogInst.ER) ,XIC(MAS_CamInstImmed.EN) XIC(MAS_CamInstImmed.ER) ,XIC(MAS_CamInstPause.EN) XIC(MAS_CamInstPause.ER) ,XIC(MAS_CamJogInst.EN) XIC(MAS_CamJogInst.ER) OTL(DebugLatch.1) ,[[XIC(MAJ_CamInst.EN) XIO(MAS_CamInstImmed.EN) XIO(MAJ_CamInst.IP) ,XIC(MAJ_CamSlaveInst.EN) XIO(MAS_CamInstImmed.EN) XIO(MAJ_CamSlaveInst.IP) ,XIC(MAJ_CamJogInst.EN) XIO(MAS_CamJogInst.EN) XIO(MAJ_CamJogInst.IP) ] MOV(500,TmrFlt_CamMove1.PRE) TON(TmrFlt_CamMove1,?,?) XIC(TmrFlt_CamMove1.DN) OTL(DebugLatch.0) ,[XIC(MAM_STOP_CamInst.EN) XIO(MAM_STOP_CamInst.PC) ,XIC(MAS_CamInstImmed.EN) XIO(MAS_CamInstImmed.PC) ,XIC(MAS_CamInstPause.EN) XIO(MAS_CamInstPause.PC) ,XIC(MAS_CamJogInst.EN) XIO(MAS_CamJogInst.PC) ] [GRT(ActualVelocityBeforeStop,0) CPT(TmrFlt_CamMove2.PRE,360/ActualVelocityBeforeStop*1000+1000) TON(TmrFlt_CamMove2,?,?) XIC(TmrFlt_CamMove2.DN) ,LEQ(ActualVelocityBeforeStop,0) OTL(DebugLatch.3) ] OTL(DebugLatch.2) ] ] ONS(OneShotFault.4) ,XIC(Fault[4].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[4].Active);]]>
</Text>
</Rung>
