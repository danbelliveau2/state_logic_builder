<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(\Safety.EStopOK)[[XIO(\Safety.AllRackModulesOK) ,XIO(\Safety.AllSafetyIOModulesOK) ] OTE(Fault[0].Active) ,XIC(\Safety.AllRackModulesOK) XIC(\Safety.AllSafetyIOModulesOK) [[XIO(\Safety.AllEstopsReleased) ,XIO(\Safety.AllRobotEstopsOK) ] OTE(Fault[1].Active) ,XIC(\Safety.AllEstopsReleased) XIC(\Safety.AllRobotEstopsOK) OTE(Fault[2].Active) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Safety.EstopSafetyInstructionFaulted)OTE(Fault[3].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Safety.GuardingSafetyInstructionFaulted)OTE(Fault[4].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(\Safety.EStopOK)XIO(\Safety.GuardOK)[XIO(\Safety.AllGuardDoorsClosed) OTE(Fault[5].Active) ,XIC(\Safety.AllGuardDoorsClosed) OTE(Fault[6].Active) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Main Air OK Fault]]>
</Comment>
<Text>
<![CDATA[XIC(\Safety.EStopOK)TON(Tmr_MainAirOKTmr,?,?)XIC(Tmr_MainAirOKTmr.DN)[XIO(IN_MainAirOK) TON(Tmr_AirNotOK,?,?) XIC(Tmr_AirNotOK.DN) OTE(Fault[10].Active) ,XIC(IN_MainAirOK) OTE(AirOK) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Valve Manifold Faults]]>
</Comment>
<Text>
<![CDATA[XIC(\Safety.OK)TON(Tmr_VlvPowerUp,?,?)XIC(Tmr_VlvPowerUp.DN)[[XIO(ValveManifold_Table:I.InputPwr_Diag) ,XIO(ValveManifold_Table:I.OutputPwr_Diag) ] OTE(Fault[11].Active) ,[XIO(ValveManifold_Top:I.InputPwr_Diag) ,XIO(ValveManifold_Top:I.OutputPwr_Diag) ] OTE(Fault[12].Active) ,[XIO(ValveManifold_WireCutInsert:I.InputPwr_Diag) ,XIO(ValveManifold_WireCutInsert:I.OutputPwr_Diag) ] OTE(Fault[13].Active) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Tray Stacker Valve Manifold Faults]]>
</Comment>
<Text>
<![CDATA[XIC(\Safety.Zone2EstopGuardOK)TON(Tmr_VlvPowerUp,?,?)XIC(Tmr_VlvPowerUp.DN)[XIO(ValveManifold_TrayStacker:I.InputPwr_Diag) ,XIO(ValveManifold_TrayStacker:I.OutputPwr_Diag) ]OTE(Fault[14].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Flashers" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Flash TImer]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(Tmr_Flasher.DN)TON(Tmr_Flasher,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[CMP((Tmr_Flasher.ACC MOD 250) < 125)OTE(Flash125_On);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[CMP((Tmr_Flasher.ACC MOD 500) < 250)OTE(Flash250_On);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CMP((Tmr_Flasher.ACC MOD 1000) < 500)OTE(Flash500_On);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CMP((Tmr_Flasher.ACC MOD 2000) < 1000)OTE(Flash1000_On);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CMP((Tmr_Flasher.ACC MOD 5000) < 2500)OTE(Flash2500_On);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[CMP((Tmr_Flasher.ACC MOD 10000) < 5000)OTE(Flash5000_On);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Flasher TImer]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(Tmr_FlasherVeryFastOff.DN)MOV(80,Tmr_FlasherVeryFastOn.PRE)TON(Tmr_FlasherVeryFastOn,?,?);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Tmr_FlasherVeryFastOn.DN)MOV(100,Tmr_FlasherVeryFastOff.PRE)TON(Tmr_FlasherVeryFastOff,?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIO(Tmr_FlasherFastOff.DN)MOV(100,Tmr_FlasherFastOn.PRE)TON(Tmr_FlasherFastOn,?,?);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Tmr_FlasherFastOn.DN)MOV(300,Tmr_FlasherFastOff.PRE)TON(Tmr_FlasherFastOff,?,?);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(Tmr_FlasherSlowOff.DN)MOV(300,Tmr_FlasherSlowOn.PRE)TON(Tmr_FlasherSlowOn,?,?);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Tmr_FlasherSlowOn.DN)MOV(800,Tmr_FlasherSlowOff.PRE)TON(Tmr_FlasherSlowOff,?,?);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIO(Tmr_FlasherVerySlowOff.DN)MOV(100,Tmr_FlasherVerySlowOn.PRE)TON(Tmr_FlasherVerySlowOn,?,?);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Tmr_FlasherVerySlowOn.DN)MOV(1500,Tmr_FlasherVerySlowOff.PRE)TON(Tmr_FlasherVerySlowOff,?,?);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Tmr_FlasherVeryFastOff.TT)OTE(FlashVeryFast);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Tmr_FlasherFastOff.TT)OTE(FlashFast);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Tmr_FlasherSlowOff.TT)OTE(FlashSlow);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(Tmr_FlasherVerySlowOff.TT)OTE(FlashVerySlow);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Fault Reset Logic

NOTE: FaultResetPB tag was created as a controller scoped tag to be mapped to the Safety task (see LOGIC > Map Safety tags...). Only controller scoped tags can be used to map to the safety logic.]]>
</Comment>
<Text>
<![CDATA[[XIC(IN_FaultResetPB) ,XIC(HMI_FaultReset) ]OTE(FaultResetPB_c)ONS(OneShots.0)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IN_SafetyResetPBL)OTE(SafetyResetPBL_c);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(\Safety.OK) ,XIC(\Safety.EstopResetIndicator) ]OTE(OUT_SafetyResetPBL);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Safety.EStopOK)XIO(\Safety.GuardOK)TON(Tmr_GrdOpn,?,?)XIC(Tmr_GrdOpn.DN)OTE(GrdOpnShutOffFdrs);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Get Current Time And Date From PLC CPU 
Also, Julian Date]]>
</Comment>
<Text>
<![CDATA[CPU_TimeDate_wJulian(AOI_CPUTimeDate,CPUTimeDate);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Task Light Logic]]>
</Comment>
<Text>
<![CDATA[[[XIC(\Mode.Auto) XIO(OUT_TaskLights) ,XIC(\Mode.SwitchManOS) XIC(\Mode.Manual) XIC(OUT_TaskLights) ] ONS(OneShots.1) ,XIC(HMI_TaskLights) ONS(OneShots.2) ][XIO(OUT_TaskLights) [OTL(OUT_TaskLights) OTL(HMI_TaskLightStatus) ,OTE(TaskLightMemory) ] ,XIC(OUT_TaskLights) XIO(TaskLightMemory) OTU(OUT_TaskLights) OTU(HMI_TaskLightStatus) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ClearAllScrap,1,2000,0,0,AlwaysOn,0,\Security.Level,0,1)OTE(ClearAllScrapCounts);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Calls To Other Routines Within The Current Program]]>
</Comment>
<Text>
<![CDATA[JSR(Flashers,0)JSR(StackLight,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StackLight" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Stack Light Logic]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(\Safety.EStopOK) ,XIO(\Alarms.NoMachineFaults) XIC(FlashFast) ]OTE(OUT_StackLtRed);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(\Alarms.NoMachineWarnings)XIC(FlashFast)OTE(OUT_StackLtYel);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[[XIC(\Mode.CycleRunning) ,XIC(\Mode.CycleStopPauseImmed) ,XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ] ,XIC(\Mode.CycleStarting) XIC(FlashFast) ]OTE(OUT_StackLtGrn);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[XIO(\Alarms.NoMachineFaults) XIO(Fault[1].Active) XIO(Fault[2].Active) XIO(Fault[5].Active) XIO(Fault[6].Active) ,XIC(\Mode.CycleStarting) ] XIC(FlashFast) XIC(AlwaysOn) XIO(SilenceAlarmReq) ,[XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ] EQU(\Mode.HMI_PausedStatus,2) XIC(FlashVerySlow) ]OTE(OUT_StackLtHrn);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIO(\Mode.IN_CycleStopPB) ,XIC(HMI_SilenceHorn) ]OTL(SilenceAlarmReq);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(FaultReset) ,XIC(\Alarms.NoMachineFaults) ]OTU(SilenceAlarmReq);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
