<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[This logic toggles between OutputATag and OutputBTag
(When A is On , B is Off)]]>
</Comment>
<Text>
<![CDATA[XIC(Trigger)XIO(Invisible)XIO(Inactive)ONS(OneShot)[XIO(OutputTag) [OTL(OutputTag) ,OTE(ToggleMemoryBit) ] ,XIC(OutputTag) XIO(ToggleMemoryBit) OTU(OutputTag) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ButtonStatus is used to display different Text and Color on the button

When Button Status Equals:
0 - Not Bypassed
1 - Bypassed]]>
</Comment>
<Text>
<![CDATA[[XIC(OutputTag) MOV(1,ButtonStatus) ,XIO(OutputTag) MOV(0,ButtonStatus) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LES(SecurityCurrentLevel,MinAccessLevel)OTE(Inactive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(VisibilityCondition)OTE(Invisible);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
