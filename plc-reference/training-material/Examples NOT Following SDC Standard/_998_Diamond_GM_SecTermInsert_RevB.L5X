<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(SensorInputTag)MOV(OnDelayMsec,OnDelayTimer.PRE)TON(OnDelayTimer,?,?)XIC(OnDelayTimer.DN)OTE(SensorDelayedOn);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(SensorDelayedOn) MOV(OffDelayMsec,OffDelayTimer.PRE) TOF(OffDelayTimer,?,?) ,XIC(OffDelayTimer.DN) OTE(SensorDelayedOff) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(SensorDelayedOn) ,XIC(SensorDelayedOff) ]OTE(OutputRaw);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(InvertOutput) XIC(OutputRaw) ,XIC(InvertOutput) XIO(OutputRaw) ]OTE(OutputTag);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
