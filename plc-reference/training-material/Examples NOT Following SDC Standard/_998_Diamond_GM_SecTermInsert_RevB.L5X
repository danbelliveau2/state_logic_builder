<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[LIM(160,\Chassis.Status.CamPosDeg,290) OTE(ChassisPosOkToTest) ,XIO(\Chassis.Status.DialOnStation) [OTE(HMI_TriggerTest.InterlockActive) ,XIC(AlwaysOff) OTE(HMI_ManPogos.InterlockActive) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_TriggerTest,0,2000,0,0,\Mode.Manual,0,\Security.Level,0,1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManPogos,0,OUT_PogosExt,OUT_PogosRet,0,1,0,IN_PogosRetd,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManBobbinHold,0,OUT_BobbinHoldExt,OUT_BobbinHoldRet,0,1,0,IN_BobbinHoldRetd,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_RetryCount,AlwaysOn,\Security.Level,5,1,Retry.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])XIC(SafeOK)MOV(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 1
Ready / Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(5,Control.StateReg) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(4,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 4
Station Disabled]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass)XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)MOV(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 5
Ready]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])MOV(0,Retry.Count)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) [XIC(\Mode.Auto) OTE(ReadyToCycle) Chassis_CamPos_Check(AOI_CamPosChk,125,\Chassis.Status.CamPosDeg,0,\Chassis.Status.ActualVelocity) XIC(CycleStation) MOV(6,Control.StateReg) ,[[XIC(\Chassis.Status.ResyncInProgress) ,XIC(\Chassis.Status.ResyncRequired) ] XIC(OUT_PogosExt) ,XIC(\Mode.Auto) [XIO(IN_BobbinHoldRetd) ,XIO(IN_PogosRetd) ,XIC(OUT_ContEna) ] ] MOV(20,Control.StateReg) ] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(1,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Status.State[5])XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)XIC(\Mode.Manual)XIC(HMI_TriggerTest.EnableOut)XIC(\Chassis.Status.DialOnStation)ONS(OneShot.2)MOV(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Status.State[5])XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)XIC(\Mode.Manual)MOV(Preset_HMIInspectStatusRdy,Tmr_InspectStat.PRE)TON(Tmr_InspectStat,?,?)XIC(Tmr_InspectStat.DN)ONS(OneShot.5)MOV(0,HMI_TestStatus);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 6
Set Tracking Attempt Bit]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt)MOV(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 7
Extend Bobbin Hold Cylinder]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])[MOV(1,HMI_TestStatus) ,OTL(OUT_BobbinHoldExt) OTU(OUT_BobbinHoldRet) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(8,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 8
Extend Probes]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])[OTL(OUT_PogosExt) OTU(OUT_PogosRet) ,MOV(150,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(9,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 9
Enable Output (Start Test)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[9])[ONS(OneShot.8) OTL(OUT_ContEna) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) [XIC(IN_ContOK) MOV(2,HMI_TestStatus) MOV(0,Retry.Count) [XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,MOV(0,ConsecFails.Count) ] ,XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ] MOV(20,Control.StateReg) ,XIO(IN_ContOK) TON(Tmr_ContFail,?,?) XIC(Tmr_ContFail.DN) [LES(Retry.Count,Retry.Setpoint) MOV(15,Control.StateReg) ,GEQ(Retry.Count,Retry.Setpoint) MOV(3,HMI_TestStatus) MOV(0,Retry.Count) [XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(141,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ] ,XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ] [XIC(\PreOpCheck.Active) OTL(\PreOpCheck.CheckCmpltContinuity) ,XIO(\PreOpCheck.Active) ] MOV(20,Control.StateReg) ] ] OTU(OUT_ContEna) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 15
**Retry After Test Failure**
Retrct Probes
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTL(OUT_PogosRet) OTU(OUT_PogosExt) OTU(OUT_ContEna) ,MOV(50,Control.TransitionTime) ,ONS(OneShot.11) ADD(Retry.Count,1,Retry.Count) ,XIC(Status.TransitionTimerDone) XIC(IN_PogosRetd) MOV(8,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 20
Retract Probes After Successful Test Or Failure After Retry Strikeout]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])[OTL(OUT_PogosRet) OTU(OUT_PogosExt) OTU(OUT_ContEna) ,MOV(50,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(21,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 21
Retract Bobbin Hold Cylinder]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[21])[OTL(OUT_BobbinHoldRet) OTU(OUT_BobbinHoldExt) ,MOV(50,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_PogosRetd) XIC(IN_BobbinHoldRetd) MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 125
Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])[ONS(OneShot.10) OTL(OUT_BobbinHoldRet) OTU(OUT_BobbinHoldExt) OTL(OUT_PogosRet) OTU(OUT_PogosExt) OTU(OUT_ContEna) ,MOV(3,HMI_InspectStatus) MOV(5,Control.StateReg) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ONS(OneShot.0) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(140,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ] ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(FaultActive)MOV(125,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
