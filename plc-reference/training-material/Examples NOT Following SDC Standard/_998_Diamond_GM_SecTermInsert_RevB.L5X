<Tag Name="MotionInstructions" TagType="Base" DataType="Motion_Instructions" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Servo Motor Motion Instruction Backing Tags]]>
</Description>
<Comments>
<Comment Operand=".MAM_INST[0]">
<![CDATA[Move To Top Position]]>
</Comment>
<Comment Operand=".MAM_INST[1]">
<![CDATA[Move to Tray Dropoff]]>
</Comment>
<Comment Operand=".MAM_INST[2]">
<![CDATA[Move Clear of Tray Being Loaded]]>
</Comment>
<Comment Operand=".MAM_INST[3]">
<![CDATA[Move All The Way down]]>
</Comment>
<Comment Operand=".MAM_INST[4]">
<![CDATA[Manual Move Down]]>
</Comment>
<Comment Operand=".MAS_INST[0]">
<![CDATA[Stop During Initialize]]>
</Comment>
<Comment Operand=".MAS_INST[1]">
<![CDATA[Stop During Fault]]>
</Comment>
<Comment Operand=".MAS_INST[2]">
<![CDATA[Stop During Manual Jog]]>
</Comment>
<Comment Operand=".MAS_INST[3]">
<![CDATA[Stop During Top Position]]>
</Comment>
</Comments>
