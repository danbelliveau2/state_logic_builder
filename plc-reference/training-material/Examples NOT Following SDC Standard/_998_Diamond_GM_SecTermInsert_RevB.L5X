<Tag Name="AOI_ProgramFaultHandler" TagType="Base" DataType="ProgramAlarmHandler" Constant="false" ExternalAccess="None">
<Data Format="L5K">
<![CDATA[[7,9999,0,5,0,0,16,15,-1,6,16,[0,0,0,[0,'$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],0,0,0,0],50,16]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="ProgramAlarmHandler">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="1"/>
<DataValueMember Name="AlarmActiveTag" DataType="BOOL" Value="1"/>
<DataValueMember Name="ActiveAlarmArrayIndex" DataType="INT" Radix="Decimal" Value="9999"/>
<DataValueMember Name="ActiveAlarmDuration" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="MyProgramID" DataType="INT" Radix="Decimal" Value="5"/>
</Structure>
</Data>
</Tag>
<Tag Name="AOI_ProgramWarningHandler" TagType="Base" DataType="ProgramAlarmHandler" Constant="false" ExternalAccess="None">
<Data Format="L5K">
<![CDATA[[3,0,0,6,0,16,1,14,-1,6,16,[0,0,0,[0,'$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],0,0,0,0],50,1]]]>
</Data>
