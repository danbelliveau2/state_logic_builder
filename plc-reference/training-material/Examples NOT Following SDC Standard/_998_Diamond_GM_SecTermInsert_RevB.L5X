<AddOnInstructionDefinition Name="Safe_ScannerKeyenceSZV_CIPSafe" Class="Safety" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2021-09-23T18:21:38.659Z" CreatedBy="STEVENDOUGLAS\dgarr" EditedDate="2021-11-05T15:55:53.744Z" EditedBy="STEVENDOUGLAS\wehamby" SoftwareRevision="v33.00"
>
<Description>
