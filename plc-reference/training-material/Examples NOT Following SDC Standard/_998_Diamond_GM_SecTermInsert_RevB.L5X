<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AlwaysOff)OTE(FaultActive)OTE(WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines Within The Current Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0)JSR(NestIndicator,0)JSR(NestControl,0)JSR(StationControl,0)JSR(PurgeDial,0)JSR(RejectTypeData,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Screen Change]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[NEQ(CurrentScreenNum,PreviousScreenNum)[MOV(CurrentScreenNum,PreviousScreenNum) ,OTE(ScreenChangedOneShot) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GRT(ReplaceScreenNum,-1)TON(Tmr_Replace,?,?)XIC(Tmr_Replace.DN)MOV(-1,ReplaceScreenNum);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
