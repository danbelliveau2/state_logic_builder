<LocalTags>
<LocalTag Name="posJPG" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="posSeparator" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ascJPG_lc" DataType="STRING3" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[3,'jpg']]]>
</DefaultData>
<DefaultData Format="String" Length="3">
<![CDATA['jpg']]>
</DefaultData>
</LocalTag>
<LocalTag Name="ascJPG_UC" DataType="STRING3" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[3,'JPG']]]>
</DefaultData>
<DefaultData Format="String" Length="3">
<![CDATA['JPG']]>
</DefaultData>
