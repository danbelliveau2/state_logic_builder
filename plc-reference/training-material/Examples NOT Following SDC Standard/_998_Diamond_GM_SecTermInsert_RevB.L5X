<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(HMIControlButtonTag)ONS(OneShot)[XIO(BrakeReleasedStatus) [XIO(AxisTag.DriveEnableStatus) MOV(1,BrakeControl) SSV(Axis,AxisTag,MechanicalBrakeControl,BrakeControl) OTL(BrakeReleasedStatus) ,OTE(ToggleMemoryBit) ] ,XIC(BrakeReleasedStatus) XIO(ToggleMemoryBit) MOV(0,BrakeControl) SSV(Axis,AxisTag,MechanicalBrakeControl,BrakeControl) OTU(BrakeReleasedStatus) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BrakeReleasedStatus)OTE(HMIStatusButtonTag.State);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
