</Routine>
<Routine Name="NestIndicator" Type="ST">
<Description>
<![CDATA[Used for nest status color on HMI. The HMI cannot reference indirect addresses.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//This is used to display the status color for all the nests displayed on the HMI main screen display.]]>
</Line>
<Line Number="1">
<![CDATA[//Additionally, this logic will copy the part status station bits (Att,succ, fail) for a given nest to the Nest_Indicator UDT. This is for use on the Nest Tracking Data Status display when showing]]>
</Line>
<Line Number="2">
<![CDATA[//the status of individual station result bits.]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[//Loop through each station and set status bits for the MAIN hmi display]]>
</Line>
<Line Number="5">
<![CDATA[dNestNum := 1;]]>
</Line>
<Line Number="6">
<![CDATA[For dNestNum := 1 to Setup_NestQty By 1 Do]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[	//Highest priority is LockedOut, Sample, Recycle, Bad, Good]]>
</Line>
<Line Number="9">
<![CDATA[	myNestStatus := 0;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[	IF (\Tracking.Data.Nest[dNestNum].OpStatus.LockedOut) THEN]]>
</Line>
<Line Number="13">
<![CDATA[		myNestStatus := 1;]]>
</Line>
<Line Number="14">
<![CDATA[	ELSIF (\Tracking.Data.Nest[dNestNum].PartStatus.Sample) THEN]]>
</Line>
<Line Number="15">
<![CDATA[		myNestStatus := 6;]]>
</Line>
<Line Number="16">
<![CDATA[	ELSIF (\Tracking.Data.Nest[dNestNum].PartStatus.Recycled) THEN]]>
</Line>
<Line Number="17">
<![CDATA[		myNestStatus := 2;]]>
</Line>
<Line Number="18">
<![CDATA[	ELSIF (\Tracking.Data.Nest[dNestNum].PartStatus.Bad) THEN]]>
</Line>
<Line Number="19">
<![CDATA[		myNestStatus := 3;]]>
</Line>
<Line Number="20">
<![CDATA[	ELSIF (\Tracking.Data.Nest[dNestNum].PartStatus.Good) THEN]]>
</Line>
<Line Number="21">
<![CDATA[		myNestStatus := 4;]]>
</Line>
<Line Number="22">
<![CDATA[	ELSE]]>
</Line>
<Line Number="23">
<![CDATA[		myNestStatus := 5;  // Nest Is Empty (Greyed Out)]]>
</Line>
<Line Number="24">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[	HMI_NestIndicator[dNestNum] := myNestStatus;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[	//Set the Status color and copy the tracking data for the selected nest on the Tracking Status Screen On the HMI]]>
</Line>
<Line Number="29">
<![CDATA[	IF (HMI_NestTrackingStatus.NestNum = dNestNum) THEN]]>
</Line>
<Line Number="30">
<![CDATA[		HMI_NestTrackingStatus.NestStatus := myNestStatus;]]>
</Line>
<Line Number="31">
<![CDATA[		cop (\Tracking.Data.Nest[dNestNum],HMI_NestTrackingStatus.Tracking,1);]]>
</Line>
<Line Number="32">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[End_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="PurgeDial" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(PurgeEnable) [ONS(OneShot.0) OTU(ProductionEnable) ,XIC(\Main.FlashFast) MOV(2,HMI_PurgeDialStatus) ,XIO(\Main.FlashFast) MOV(1,HMI_PurgeDialStatus) ] ,XIO(PurgeEnable) XIC(\Main.FlashFast) MOV(0,HMI_PurgeDialStatus) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[This will enable production if the purge is cancelled before it completes]]>
</Comment>
<Text>
<![CDATA[XIO(PurgeEnable)ONS(OneShot.2)[XIC(AlwaysOn) ,XIO(ProductionEnable) ]OTL(ProductionEnable);]]>
</Text>
</Rung>
