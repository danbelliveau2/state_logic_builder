<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(\Safety.EStopOK) XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(TmrFlt_DrlrMtrRun.DN) ONS(OneShotFlt.0) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIC(\Main.FaultReset) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(\Safety.EStopOK) XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(TmrFlt_DrlrTangle.DN) ONS(OneShotFlt.1) OTL(Fault[1].Active) ,XIC(Fault[1].Active) XIC(\Main.FaultReset) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SensorDebouncer(AOI_SensorDebouncer,IN_DereelerLowLimit,200,2000,DereelerLowLimit,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Mode.Auto)OTE(OUT_PaperWinderRun)XIO(DereelerLowLimit)XIO(Fault[0].Active)XIO(Fault[1].Active)XIO(TmrFlt_DrlrMtrRun.DN)XIO(\TerminalInsert.Fault[15].Active)OTE(OUT_DereelerMotor)TON(TmrFlt_DrlrMtrRun,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Safety.EStopOK)XIC(\Mode.Auto)XIC(\Mode.CycleRunning)XIO(IN_DereelerHighLim)TON(TmrFlt_DrlrTangle,?,?);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL"/>
</Routines>
