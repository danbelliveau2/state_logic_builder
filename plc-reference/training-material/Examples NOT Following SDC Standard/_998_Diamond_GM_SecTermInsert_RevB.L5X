</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="OutputATag" TagType="Base" DataType="BOOL" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="OutputBTag" TagType="Base" DataType="BOOL" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="UseSensorAForIndicator" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Do You Want To Use The Indicator For Sensor Status (1=Yes 0=No)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="UseSensorBForIndicator" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Do You Want To Use The Indicator For Sensor Status (1=Yes 0=No)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="PositionAInput" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Sensor Used For Position Of Output A]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="PositionBInput" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Sensor Used For Position Of Output B]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="VisibilityCondition" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Condition To Make The Button Visible
(Usually Manual Mode)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="GreyOutCondition" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Condition To Make The Button GeryedOut
(In conjunction with Access Level)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="SecurityCurrentLevel" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Current Security Level Of The Logged In User]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="MinAccessLevel" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Minimum Security Acess Level For Button Operation]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Invisible" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Used By HMI to make Button Invisible]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Inactive" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Used By The HMI To Make The Button Active/Inactive
(50% Opacity)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="ButtonStatus" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Used By HMI For The Button Text]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="IndicatorStatus" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Used By HMI For The Indicator Color/Text]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="InterlockActive" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[User To Make The Button Inactive For Interferences]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="OutAOn" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Output A Energized Staus]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="OutBOn" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Output B Energized Status]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="OutAOnPulse" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Output A Was Set To On Pulse (OneShot)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="OutBOnPulse" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Output B Was Set To On Pulse (OneShot)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="OneShot" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ToggleMemoryBit" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="OneShot2" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="OneShot3" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[This logic toggles between OutputATag and OutputBTag
(When A is On , B is Off)]]>
</Comment>
<Text>
<![CDATA[XIC(Trigger)XIO(Invisible)XIO(Inactive)ONS(OneShot)[[XIO(OutputATag) [OTL(OutputATag) ,OTE(ToggleMemoryBit) ] ,XIC(OutputATag) XIO(ToggleMemoryBit) OTU(OutputATag) ] ,XIO(UseOutputAOnly) [XIC(OutputATag) ONS(OneShot2) OTU(OutputBTag) ,XIO(OutputATag) ONS(OneShot3) OTL(OutputBTag) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(OutputATag) OTE(OutAOn) ,XIC(OutputBTag) OTE(OutBOn) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ButtonStatus is used to display different text on the button

When Button Status Equals:
0 - Error text/state
1 - Button text A (Output A is On)
2 - Button text B (Output B is On)]]>
</Comment>
<Text>
<![CDATA[[XIC(OutputATag) MOV(1,ButtonStatus) ,[XIO(UseOutputAOnly) XIC(OutputBTag) ,XIC(UseOutputAOnly) XIO(OutputATag) ] MOV(2,ButtonStatus) ,XIO(UseOutputAOnly) XIO(OutputATag) XIO(OutputBTag) MOV(0,ButtonStatus) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[IndicatorStatus is used to display the color and text on the indicator light on the button

When Indicator Status Equals:
0 - Indicator Is Invisible, Not Used
1 - Moving To Position A (Output A is ON and Input for A is OFF)
2 - At Position A (Output A is ON and Input for A is ON)
3 - Moving To Position A (Output B is ON and Input for B is OFF) 
4 - At Position A (Output B is ON and Input for B is ON)]]>
</Comment>
<Text>
<![CDATA[[XIO(UseOutputAOnly) XIO(OutputATag) XIO(OutputBTag) MOV(0,IndicatorStatus) ,XIC(OutputATag) [XIC(UseSensorAForIndicator) [XIO(PositionAInput) MOV(1,IndicatorStatus) ,XIC(PositionAInput) MOV(2,IndicatorStatus) ] ,XIO(UseSensorAForIndicator) MOV(0,IndicatorStatus) ] ,[XIO(UseOutputAOnly) XIC(OutputBTag) ,XIC(UseOutputAOnly) XIO(OutputATag) ] [XIC(UseSensorBForIndicator) [XIO(PositionBInput) MOV(3,IndicatorStatus) ,XIC(PositionBInput) MOV(4,IndicatorStatus) ] ,XIO(UseSensorBForIndicator) MOV(0,IndicatorStatus) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIO(InterlockActive) [LES(SecurityCurrentLevel,MinAccessLevel) ,XIC(GreyOutCondition) ] ,XIC(InterlockActive) ]OTE(Inactive);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(VisibilityCondition)OTE(Invisible);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="ProgramAlarmHandler" Class="Standard" Revision="2.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-08-23T18:02:02.410Z" CreatedBy="STEVENDOUGLAS\dshaner" EditedDate="2021-05-12T13:22:18.068Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.02">
<Description>
<![CDATA[Creates a shared Alarm History array and a shared Active Alarms array.]]>
</Description>
<RevisionNote>
<![CDATA[v1.0 : 2017-08-24 D.E.S.
v1.1:2017-09-12 W.E.H.
v1.2 : 2018-06-03 W.E.H.- Changed NoFault to Faulted
v2.0 : 2019-12-12 D.E.S. variable array lengths!
v2.1 : 2021-05-11 D.E.S. Use UTC for date.]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This AOI works in conjuction with the Alarms Porgram. This AOI then uses that tag to uniquely identify each instance of the AOI in your project. ControllerProgramIDTag needs to be the exact same tag for all instances of this AOI in your project.

LocalAlarmsArrayTag is where you define each alarm for this AOI. Type in your Message and set the Severity when you create a new alarm. Severity is used on the HMI for coloring. If you set DoNotSaveToHistory it will prevent the alarm from being put in the Alarm History array.
Use output coils or latches on the Active bit to trigger the alarm.

HMIActiveArrayTag and HMIHistoryArrayTag are arrays of the AlarmData UDT. They are shared by all instances of this AOI.

Alarm History is updated when an alarm becomes inactive so the Duration can be saved.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="PublicProgramIDTag" TagType="Base" DataType="INT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Master Program ID tag used for all handler instances to obtain a unique ID]]>
</Description>
</Parameter>
<Parameter Name="LocalAlarmsArrayTag" TagType="Base" DataType="AlarmData" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Local array tag.
Faults,
Warnings]]>
</Description>
</Parameter>
<Parameter Name="AlarmActiveArrayTag" TagType="Base" DataType="AlarmData" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Active array tag. \Alarms.Active]]>
</Description>
</Parameter>
<Parameter Name="AlarmHistoryArrayTag" TagType="Base" DataType="AlarmData" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[History array tag. \Alarms.History]]>
</Description>
</Parameter>
<Parameter Name="ControllerTimeClockTag" TagType="Base" DataType="CPU_TimeDate" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="AlarmActiveTag" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="ActiveAlarmArrayIndex" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="ActiveAlarmDuration" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="MyProgramID" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[This alarm handler's Program ID]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="NumFound" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ActiveIndex" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="DataIndex" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="tempLength" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ShiftIter" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="prevSecond" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="AlarmsActive_size" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="OneSecond" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="EmptyAlarmData" DataType="AlarmData" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0,[0,'$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'],0,0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="AlarmData">
<DataValueMember Name="ProgramID" DataType="INT" Radix="Decimal" Value="0"/>
<DataValueMember Name="AlarmID" DataType="INT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Severity" DataType="INT" Radix="Decimal" Value="0"/>
<StructureMember Name="Message" DataType="STR0100">
<DataValueMember Name="LEN" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="DATA" DataType="STR0100" Radix="ASCII">
<![CDATA[]]>
</DataValueMember>
</StructureMember>
<DataValueMember Name="TimeStamp" DataType="LINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Count" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Duration" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Active" DataType="BOOL" Value="0"/>
<DataValueMember Name="DoNotSaveToHistory" DataType="BOOL" Value="0"/>
<DataValueMember Name="DispSecLang" DataType="BOOL" Value="0"/>
<DataValueMember Name="HMI_ResetCount" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="AlarmsHistory_size" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="AlarmsLocal_size" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[PublicProgramIDTag := PublicProgramIDTag + 1;]]>
</Line>
<Line Number="1">
<![CDATA[MyProgramID := PublicProgramIDTag;]]>
</Line>
<Line Number="2">
<![CDATA[NumFound := 0;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[SIZE(AlarmActiveArrayTag, 0, AlarmsActive_size);]]>
</Line>
<Line Number="5">
<![CDATA[SIZE(AlarmHistoryArrayTag, 0, AlarmsHistory_size);]]>
</Line>
<Line Number="6">
<![CDATA[SIZE(LocalAlarmsArrayTag, 0, AlarmsLocal_size);]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[if (ControllerTimeClockTag.Seconds <> prevSecond) then]]>
</Line>
<Line Number="9">
<![CDATA[	prevSecond := ControllerTimeClockTag.Seconds;]]>
</Line>
<Line Number="10">
<![CDATA[	OneSecond := 1;]]>
</Line>
<Line Number="11">
<![CDATA[else]]>
</Line>
<Line Number="12">
<![CDATA[	OneSecond := 0;]]>
</Line>
<Line Number="13">
<![CDATA[end_if;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[for ActiveIndex := NumFound to AlarmsActive_size - 1 by 1 do]]>
</Line>
<Line Number="16">
<![CDATA[	//Clear alarm if it's no longer active.]]>
</Line>
<Line Number="17">
<![CDATA[	if (AlarmActiveArrayTag[ActiveIndex].ProgramID = PublicProgramIDTag) then]]>
</Line>
<Line Number="18">
<![CDATA[		//Alarm came from this AOI]]>
</Line>
<Line Number="19">
<![CDATA[		DataIndex := AlarmActiveArrayTag[ActiveIndex].AlarmID;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[		if ((DataIndex < 0) OR (DataIndex >= AlarmsLocal_size)) then]]>
</Line>
<Line Number="22">
<![CDATA[			//This was bad data. Index out of range. So to prevent CPU fault,]]>
</Line>
<Line Number="23">
<![CDATA[			//erase the data just like below.]]>
</Line>
<Line Number="24">
<![CDATA[			//Shift the active list up to cover the inactive alarm]]>
</Line>
<Line Number="25">
<![CDATA[			tempLength := AlarmsActive_size - 1 - ActiveIndex;]]>
</Line>
<Line Number="26">
<![CDATA[			if (ActiveIndex < AlarmsActive_size - 1) then]]>
</Line>
<Line Number="27">
<![CDATA[				//Skip the shift up if the last alarm in the list is no longer active]]>
</Line>
<Line Number="28">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex + 1], AlarmActiveArrayTag[ActiveIndex], tempLength);]]>
</Line>
<Line Number="29">
<![CDATA[			end_if;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[			//Clear the last record]]>
</Line>
<Line Number="32">
<![CDATA[			COP(EmptyAlarmData, AlarmActiveArrayTag[AlarmsActive_size - 1], 1);]]>
</Line>
<Line Number="33">
<![CDATA[			exit; //This is an anomaly so exit this for loop and it'll fix itself next scan.]]>
</Line>
<Line Number="34">
<![CDATA[		end_if;]]>
</Line>
<Line Number="35">
<![CDATA[		]]>
</Line>
<Line Number="36">
<![CDATA[		if (OneSecond) then]]>
</Line>
<Line Number="37">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Duration := LocalAlarmsArrayTag[DataIndex].Duration +1;]]>
</Line>
<Line Number="38">
<![CDATA[			AlarmActiveArrayTag[ActiveIndex].Duration := AlarmActiveArrayTag[ActiveIndex].Duration +1;]]>
</Line>
<Line Number="39">
<![CDATA[		end_if;]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[		if (NOT LocalAlarmsArrayTag[DataIndex].Active) then]]>
</Line>
<Line Number="42">
<![CDATA[			//Alarm is no longer active so copy to history and clear from the active list.]]>
</Line>
<Line Number="43">
<![CDATA[			]]>
</Line>
<Line Number="44">
<![CDATA[			if (NOT LocalAlarmsArrayTag[DataIndex].DoNotSaveToHistory) then]]>
</Line>
<Line Number="45">
<![CDATA[				//Shift the history down]]>
</Line>
<Line Number="46">
<![CDATA[				for ShiftIter := AlarmsHistory_size - 2 to 0 by -1 do]]>
</Line>
<Line Number="47">
<![CDATA[					COP(AlarmHistoryArrayTag[ShiftIter], AlarmHistoryArrayTag[ShiftIter + 1], 1);]]>
</Line>
<Line Number="48">
<![CDATA[				end_for;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[				//Copy the data over]]>
</Line>
<Line Number="51">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex], AlarmHistoryArrayTag[0], 1);]]>
</Line>
<Line Number="52">
<![CDATA[			end_if;]]>
</Line>
<Line Number="53">
<![CDATA[			//Shift the active list up to cover the inactive alarm]]>
</Line>
<Line Number="54">
<![CDATA[			tempLength := AlarmsActive_size - 1 - ActiveIndex;]]>
</Line>
<Line Number="55">
<![CDATA[			if (ActiveIndex < (AlarmsActive_size - 1)) then]]>
</Line>
<Line Number="56">
<![CDATA[				//Skip the shift up if the last alarm in the list is no longer active]]>
</Line>
<Line Number="57">
<![CDATA[				COP(AlarmActiveArrayTag[ActiveIndex + 1], AlarmActiveArrayTag[ActiveIndex], tempLength);]]>
</Line>
<Line Number="58">
<![CDATA[			end_if;]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[			//Clear the last record]]>
</Line>
<Line Number="61">
<![CDATA[			COP(EmptyAlarmData, AlarmActiveArrayTag[AlarmsActive_size - 1], 1);]]>
</Line>
<Line Number="62">
<![CDATA[		end_if;]]>
</Line>
<Line Number="63">
<![CDATA[]]>
</Line>
<Line Number="64">
<![CDATA[	end_if;]]>
</Line>
<Line Number="65">
<![CDATA[end_for;]]>
</Line>
<Line Number="66">
<![CDATA[]]>
</Line>
<Line Number="67">
<![CDATA[AlarmActiveTag := 0;]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[for DataIndex := 0 to AlarmsLocal_size - 1 by 1 do]]>
</Line>
<Line Number="70">
<![CDATA[	//Loop through each alarm in the data array]]>
</Line>
<Line Number="71">
<![CDATA[	if (LocalAlarmsArrayTag[DataIndex].Active) then]]>
</Line>
<Line Number="72">
<![CDATA[		//The alarm is active]]>
</Line>
<Line Number="73">
<![CDATA[		AlarmActiveTag := 1;]]>
</Line>
<Line Number="74">
<![CDATA[		//Update informational outputs]]>
</Line>
<Line Number="75">
<![CDATA[		ActiveAlarmArrayIndex := DataIndex;]]>
</Line>
<Line Number="76">
<![CDATA[		ActiveAlarmDuration := LocalAlarmsArrayTag[DataIndex].Duration;]]>
</Line>
<Line Number="77">
<![CDATA[]]>
</Line>
<Line Number="78">
<![CDATA[		for ActiveIndex := NumFound to AlarmsActive_size - 1 by 1 do]]>
</Line>
<Line Number="79">
<![CDATA[			//Check if it's already in the active array]]>
</Line>
<Line Number="80">
<![CDATA[			if ((AlarmActiveArrayTag[ActiveIndex].ProgramID = PublicProgramIDTag) AND (AlarmActiveArrayTag[ActiveIndex].AlarmID = DataIndex)) then]]>
</Line>
<Line Number="81">
<![CDATA[				//Found it! So exit the for loop]]>
</Line>
<Line Number="82">
<![CDATA[				exit;]]>
</Line>
<Line Number="83">
<![CDATA[			end_if;]]>
</Line>
<Line Number="84">
<![CDATA[		end_for;]]>
</Line>
<Line Number="85">
<![CDATA[		if (ActiveIndex > AlarmsActive_size - 1) then]]>
</Line>
<Line Number="86">
<![CDATA[			//Didn't find it! So add the new active alarm.]]>
</Line>
<Line Number="87">
<![CDATA[			//Shift the data down the stack]]>
</Line>
<Line Number="88">
<![CDATA[			for ShiftIter := AlarmsActive_size - 2 to 0 by -1 do]]>
</Line>
<Line Number="89">
<![CDATA[				COP(AlarmActiveArrayTag[ShiftIter], AlarmActiveArrayTag[ShiftIter + 1], 1);]]>
</Line>
<Line Number="90">
<![CDATA[			end_for;]]>
</Line>
<Line Number="91">
<![CDATA[]]>
</Line>
<Line Number="92">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].ProgramID := PublicProgramIDTag;]]>
</Line>
<Line Number="93">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].AlarmID := DataIndex;]]>
</Line>
<Line Number="94">
<![CDATA[			COP(ControllerTimeClockTag.UTCMicroseconds, LocalAlarmsArrayTag[DataIndex].TimeStamp, 1);]]>
</Line>
<Line Number="95">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Duration := 0;]]>
</Line>
<Line Number="96">
<![CDATA[			LocalAlarmsArrayTag[DataIndex].Count := LocalAlarmsArrayTag[DataIndex].Count +1;]]>
</Line>
<Line Number="97">
<![CDATA[]]>
</Line>
<Line Number="98">
<![CDATA[			COP(LocalAlarmsArrayTag[DataIndex], AlarmActiveArrayTag[0], 1);]]>
</Line>
<Line Number="99">
<![CDATA[]]>
</Line>
<Line Number="100">
<![CDATA[		end_if;]]>
</Line>
<Line Number="101">
<![CDATA[	end_if;]]>
</Line>
<Line Number="102">
<![CDATA[end_for;]]>
</Line>
<Line Number="103">
<![CDATA[]]>
</Line>
<Line Number="104">
<![CDATA[if (AlarmActiveTag) then]]>
</Line>
<Line Number="105">
<![CDATA[	//No active alarms found]]>
</Line>
<Line Number="106">
<![CDATA[	ActiveAlarmArrayIndex := 9999;]]>
</Line>
<Line Number="107">
<![CDATA[	ActiveAlarmDuration := 0;]]>
</Line>
<Line Number="108">
<![CDATA[end_if;]]>
</Line>
<Line Number="109">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Robot_Epson" Class="Standard" Revision="2.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2018-07-09T12:46:46.278Z" CreatedBy="STEVENDOUGLAS\wehamby" EditedDate="2021-03-29T19:23:08.989Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.02">
<Description>
<![CDATA[Epson Robot I/O Mapping to Local Tags For Ease Of Communications.]]>
</Description>
<RevisionNote>
<![CDATA[Changed Data size to 64 bytes]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="ControllerModuleTag_Inputs" TagType="Base" DataType="AB:ETHERNET_MODULE_INT_64Bytes:I:0" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Use Ethernet Module Tag Name : I (Inputs) from controller tags]]>
</Description>
</Parameter>
<Parameter Name="ControllerModuleTag_Outputs" TagType="Base" DataType="AB:ETHERNET_MODULE_INT_64Bytes:O:0" Usage="InOut" Required="true" Visible="true" Constant="false">
