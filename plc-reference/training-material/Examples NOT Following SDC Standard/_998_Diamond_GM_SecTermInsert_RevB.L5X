<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIC(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Fault[1].Active)XIC(\Main.FaultReset)OTU(Fault[1].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [XIC(\HMI.ProductionEnable) [Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Permissive For Robot To Place Part In The Dial Nest

NOTE: Low limit doesn't really matter since the attempt bit need set by the CamPosChk1, but it should at least be when the dial is approx on station  at 155 Deg.

NOTE2: The Attempt bit gets overwritten when we copy the data from the robot to the dial nest so it needs set again after the transfer]]>
</Comment>
<Text>
<![CDATA[[[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk1,165,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(CycleStation) AFI() OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,XIC(\Mode.Auto) [AFI() XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,XIC(CycleStation) ] [LIM(155,\Chassis.Status.CamPosDeg,300) ,[XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ] [LIM(155,\Chassis.Status.CamPosDeg,360) ,LIM(0,\Chassis.Status.CamPosDeg,9) ] ] OTE(\RobotBobbin.Outputs.UserOut[1].2) ] ,XIC(\RobotBobbin.Inputs.UserIn[1].2) [OTE(\RobotBobbin.Outputs.UserOut[2].2) ,ONS(OneShot.0) [MOV(0,ConsecFails.Count) ,XIC(CycleStation) [COP(\Tracking.Data.Nest[NestNumRobot].PartStatus,\Tracking.Data.Nest[NestNumCurrent].PartStatus,1) COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[NestNumRobot].PartStatus,1) ,OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ] ,MOV(\Chassis.Status.CamPosDeg,SavedCamPosAtPlace) ] ] ] ,Chassis_CamPos_Check(AOI_CamPosChk2,8,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(CycleStation) [AFI() [XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(11,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ] ,ADD(ConsecFails.Count,1,ConsecFails.Count) ,XIC(AlwaysOff) OTL(Fault[1].Active) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
