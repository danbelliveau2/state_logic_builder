<Text>
<![CDATA[[[XIC(MAM_DialPhaseCorrect.ER) ,XIC(MAM_DialPhaseCorrect.EN) XIO(MAM_DialPhaseCorrect.PC) MOV(2000,TmrFlt_DialMove.PRE) TON(TmrFlt_DialMove,?,?) XIC(TmrFlt_DialMove.DN) ] ONS(OneShotFault.5) ,XIC(Fault[5].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[5].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[[XIC(Setup_CamAxisTag.ExcessivePositionErrorFault) ,XIC(Setup_CamAxisTag.TorqueLimitStatus) ] MOV(300,TmrFlt_CamTorq.PRE) TON(TmrFlt_CamTorq,?,?) XIC(TmrFlt_CamTorq.DN) ONS(OneShotFault.6) ,XIC(Fault[6].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[6].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[[XIC(Setup_DialAxisTag.ExcessivePositionErrorFault) ,XIC(Setup_DialAxisTag.TorqueLimitStatus) ] MOV(300,TmrFlt_DialTorq.PRE) TON(TmrFlt_DialTorq,?,?) XIC(TmrFlt_DialTorq.DN) ONS(OneShotFault.7) ,XIC(Fault[7].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[7].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[[XIC(MAPC_CamDialInst.ER) ,XIC(MCCP_Inst.ER) ,[XIC(MAPC_CamDialInst.EN) XIO(MAPC_CamDialInst.PC) ,XIC(MCCP_Inst.EN) XIO(MCCP_Inst.DN) ] MOV(500,TmrFlt_PosCam.PRE) TON(TmrFlt_PosCam,?,?) XIC(TmrFlt_PosCam.DN) ] ONS(OneShotFault.8) ,XIC(Fault[8].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[8].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[[XIC(Setup_CamAxisTag.PhysicalAxisFault) ,XIC(Setup_CamAxisTag.ModuleFault) ,XIC(Setup_CamAxisTag.ConfigFault) ,XIC(Setup_CamAxisTag.GroupFault) ,XIC(Setup_CamAxisTag.MotionFault) ] XIO(MASR_CamInst.EN) XIO(MAFR_CamInst.EN) ONS(OneShotFault.9) ,XIC(Fault[9].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[9].Active);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[[XIC(Setup_DialAxisTag.PhysicalAxisFault) ,XIC(Setup_DialAxisTag.ModuleFault) ,XIC(Setup_DialAxisTag.ConfigFault) ,XIC(Setup_DialAxisTag.GroupFault) ,XIC(Setup_DialAxisTag.MotionFault) ] XIO(MASR_DialInst.EN) XIO(MAFR_DialInst.EN) ONS(OneShotFault.10) ,XIC(Fault[10].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[10].Active);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[This is a special fault and should be used in conjunction with the fast stop deceleration value and the Check Index Permissives Cam Position (Setup_IndexPermsStartPosDeg) value. 
The basic concept is that the index permissives want to be checked at a Cam position that is a little bit before the cam position where index will occur. This is so that when an index permissive fault occurs that the cam will be able to stop rapidly enough so that it stops just before the position
when indexing occurs. If it does not, then when an index permissive fault occurs, the chassis will need to be resynced because the dial is past the dwell and should have started movement.
Set the fast stop deceleration to be fast, and find out how many degrees it takes the cam axis to stop. This value is how much before the start of index that the index permissives start check position should be set to.

NOTE: This fault will typically occur because one of the stations did not finish in time for the dail to index.]]>
</Comment>
<Text>
<![CDATA[[XIO(Control.DialIndexPermsOK) [XIC(Setup_DialAxisTag.PositionCamStatus) [XIC(Setup_CamAxisTag.MoveStatus) ,XIC(Setup_CamAxisTag.JogStatus) ] [LES(Setup_IndexPermsStartCheckPosDeg,Setup_DialIndexEndCamPosDeg) LIM(Setup_IndexPermsStartCheckPosDeg,Setup_CamAxisTag.ActualPosition,Setup_DialIndexEndCamPosDeg) ,GEQ(Setup_IndexPermsStartCheckPosDeg,Setup_DialIndexEndCamPosDeg) [LIM(Setup_IndexPermsStartCheckPosDeg,Setup_CamAxisTag.ActualPosition,360) ,LIM(0,Setup_CamAxisTag.ActualPosition,Setup_DialIndexEndCamPosDeg) ] ] ,[XIC(Setup_DialAxisTag.MoveStatus) ,XIC(Setup_DialAxisTag.JogStatus) ,XIC(MAM_DialNearstInst.EN) ] ,XIO(Setup_DialAxisTag.PositionCamStatus) [XIO(Status.DialOnStation) ,XIO(Status.CamInDialDwell) ] ] ,XIC(Fault[11].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[11].Active);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[[XIC(Status.Running) ,XIC(Status.Stopping) ,XIC(Status.Jogging) ] XIC(Status.CamInDialDwell) XIO(Status.DialOnStation) ,XIC(Fault[12].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[12].Active);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[[XIC(MAS_AllCamInst.EN) XIC(MAS_AllCamInst.ER) ,XIC(MAS_AllDialInst.EN) XIC(MAS_AllDialInst.ER) ,XIC(MAFR_CamInst.EN) XIC(MAFR_CamInst.ER) ,XIC(MASR_CamInst.EN) XIC(MASR_CamInst.ER) ,XIC(MAFR_DialInst.EN) XIC(MAFR_DialInst.ER) ,XIC(MASR_DialInst.EN) XIC(MASR_DialInst.ER) ,[XIC(MAS_AllCamInst.EN) XIO(MAS_AllCamInst.DN) ,XIC(MAS_AllDialInst.EN) XIO(MAS_AllDialInst.DN) ,XIC(MAFR_CamInst.EN) XIO(MAFR_CamInst.DN) ,XIC(MASR_CamInst.EN) XIO(MASR_CamInst.DN) ,XIC(MAFR_DialInst.EN) XIO(MAFR_DialInst.DN) ,XIC(MASR_DialInst.EN) XIO(MASR_DialInst.DN) ] MOV(500,TmrFlt_MotInst.PRE) TON(TmrFlt_MotInst,?,?) XIC(TmrFlt_MotInst.DN) ] ONS(OneShotFault.13) ,XIC(Fault[13].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[13].Active);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[NOTE: The Permissives OK Start Check Position cannot be between the Index Start Position and Index End Position. It should be set slightly before the Index Start Position.]]>
</Comment>
<Text>
<![CDATA[[LIM(0,Setup_DialIndexStartCamPosDeg,Setup_DialIndexEndCamPosDeg) LIM(Setup_DialIndexStartCamPosDeg,Setup_IndexPermsStartCheckPosDeg,Setup_DialIndexEndCamPosDeg) ,LIM(Setup_DialIndexEndCamPosDeg,Setup_DialIndexStartCamPosDeg,360) [LIM(Setup_DialIndexStartCamPosDeg,Setup_IndexPermsStartCheckPosDeg,360) ,LIM(0,Setup_IndexPermsStartCheckPosDeg,Setup_DialIndexEndCamPosDeg) ] ]OTE(Fault[14].Active);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Fault[15].Active)XIC(Setup_FaultResetPulse)OTU(Fault[15].Active);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Fault[16].Active)XIC(Setup_FaultResetPulse)OTU(Fault[16].Active);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[The following fault messages are used to help determine why the index permissives fault occurred. These messages are for devices that haven't completed their motion/cycle
by the time the dial needs to index. They typically are not faulted, but just slow to operate such that they interfere with the index point. ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIO(IndexPermissiveStatus.0) ,XIC(FaultIndexPerm[0].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[0].Active);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.0) XIO(IndexPermissiveStatus.1) ,XIC(FaultIndexPerm[1].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[1].Active);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.1) XIO(IndexPermissiveStatus.2) ,XIC(FaultIndexPerm[2].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[2].Active);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.2) XIO(IndexPermissiveStatus.3) ,XIC(FaultIndexPerm[3].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[3].Active);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.3) XIO(IndexPermissiveStatus.4) ,XIC(FaultIndexPerm[4].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[4].Active);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.4) XIO(IndexPermissiveStatus.5) ,XIC(FaultIndexPerm[5].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[5].Active);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.5) XIO(IndexPermissiveStatus.6) ,XIC(FaultIndexPerm[6].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[6].Active);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.6) XIO(IndexPermissiveStatus.7) ,XIC(FaultIndexPerm[7].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[7].Active);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.7) XIO(IndexPermissiveStatus.8) ,XIC(FaultIndexPerm[8].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[8].Active);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.8) XIO(IndexPermissiveStatus.9) ,XIC(FaultIndexPerm[9].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[9].Active);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.9) XIO(IndexPermissiveStatus.10) ,XIC(FaultIndexPerm[10].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[10].Active);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.10) XIO(IndexPermissiveStatus.11) ,XIC(FaultIndexPerm[11].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[11].Active);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.11) XIO(IndexPermissiveStatus.12) ,XIC(FaultIndexPerm[12].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[12].Active);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.12) XIO(IndexPermissiveStatus.13) ,XIC(FaultIndexPerm[13].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[13].Active);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.13) XIO(IndexPermissiveStatus.14) ,XIC(FaultIndexPerm[14].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[14].Active);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[[XIC(Fault[11].Active) XIC(IndexPermissiveStatus.14) XIO(IndexPermissiveStatus.15) ,XIC(FaultIndexPerm[15].Active) XIO(Setup_FaultResetPulse) ]OTE(FaultIndexPerm[15].Active);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[****WARNING LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIC(Setup_IN_HandCrank)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIC(Setup_SafetyCircuitOK)XIC(Control.ImmedStop)OTE(Warning[2].Active);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[[XIC(Setup_OUT_OilPump) XIO(Setup_IN_OilFlow) MOV(15000,Tmr_OilFlowFlt.PRE) TON(Tmr_OilFlowFlt,?,?) XIC(Tmr_OilFlowFlt.DN) ,XIC(Warning[3].Active) XIO(Setup_FaultResetPulse) ]OTE(Warning[3].Active);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIC(Status.ResyncRequired)OTE(Warning[4].Active);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
