<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[5].Active) ,XIC(Fault[5].Active) XIC(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[5].Active) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_BobbinHoldDwn) XIC(IN_BobbinHoldCylUp) ,XIC(OUT_BobbinHoldUp) XIO(IN_BobbinHoldCylUp) ] TON(TmrFlt_BobbinHold,?,?) XIC(TmrFlt_BobbinHold.DN) OTL(Fault[6].Active) ,XIC(Fault[6].Active) XIC(\Main.FaultReset) OTU(Fault[6].Active) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[7].Active) ,XIC(Fault[7].Active) XIO(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[7].Active) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Fault[8].Active)XIC(\Main.FaultReset)OTU(Fault[8].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Manual Control Logic]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_ManGripper,0,OUT_GripperClose,OUT_GripperOpen,0,0,0,0,\Mode.Manual,0,\Security.Level,0) ,XIC(OUT_GripperOpen) XIO(OUT_GripperClose) ONS(OneShot.10) OTU(DiodeGrippedMemory) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManHold,0,OUT_BobbinHoldDwn,OUT_BobbinHoldUp,0,1,0,IN_BobbinHoldCylUp,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogFwd,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogRev,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManMoveHandoff,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManMoveInsert,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManMoveHome,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManDiodeHold,0,OUT_BobbinHoldDwn,OUT_BobbinHoldUp,0,1,0,IN_BobbinHoldCylUp,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ZeroServo,1,2000,0,AlwaysOff,Status.State[0],0,\Security.Level,10,0);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[HMI_OpnPopup(HMI_OpenZeroPopupInsert,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,53,\Safety.EStopNOK,\Security.Level,10);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Position" Type="RLL">
<Description>
<![CDATA[Calculations For Servo Motor Position]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calculate Position For Status (In mm)
Note : The value is multiplied and divided to remove scientific notation and create a fixed number of decimal places. ]]>
</Comment>
<Text>
<![CDATA[MUL(ServoMotor.ActualPosition,1000,ServoPosDegREALTemp)TRN(ServoPosDegREALTemp,ServoPosDegREALTemp)DIV(ServoPosDegREALTemp,1000,ServoPos_mm);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[LEQ(ServoPos_mm,43)OTE(ClearOfDial);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[CMP(ServoPos_mm < (MotionPosition.Insert + MotionPosition.InPosTol))CMP(ServoPos_mm > (MotionPosition.Insert - MotionPosition.InPosTol))OTE(AtInsertPos);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[CMP(ServoPos_mm < (MotionPosition.Handoff + MotionPosition.InPosTol))CMP(ServoPos_mm > (MotionPosition.Handoff - MotionPosition.InPosTol))OTE(AtHandoffPos);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CMP(ServoPos_mm < (MotionPosition.Home + MotionPosition.InPosTol))CMP(ServoPos_mm > (MotionPosition.Home - MotionPosition.InPosTol))OTE(AtHome);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[LEQ(ServoPos_mm,4.0) OTE(LimitPos) ,GEQ(ServoPos_mm,722) OTE(LimitNeg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_InsertPos,1,\Security.Level,5,0,DummyDINT,1,MotionPosition.Insert,1,0)HMI_NumericDispEntry(HMI_HandoffPos,1,\Security.Level,5,0,DummyDINT,1,MotionPosition.Handoff,1,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(Position,0)JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[Servo_Capacity(AOI_MotorCapacity,ServoMotor)MOV(500,ServoMotor.TorqueLimitPositive)MOV(-500,ServoMotor.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut)[[Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,[Chassis_PartStatChk_V2_0(AOI_PartStatChkInc,\Tracking.Data,StaNum,NestNumIncoming,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Attempt) OTE(CycleStationIncoming) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[XIC(SafeOK) [XIC(ServoMotor.AxisHomedStatus) [XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(1,Control.StateReg) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(4,Control.StateReg) ] ,XIO(ServoMotor.AxisHomedStatus) ONS(OneShotFlt.8) OTL(Fault[8].Active) ] ,XIO(SafeOK) XIC(HMI_ZeroServo.EnableOut) MAH(ServoMotor,MotionInstructions.MAH_Inst) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 1
Stop All Servo Drive Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIO(ServoMotor.ShutdownStatus) MAS(ServoMotor,MotionInstructions.MAS_Inst[0],All,Yes,60,% of Maximum,No,0,Units per sec3) XIC(MotionInstructions.MAS_Inst[0].DN) ,XIC(ServoMotor.ShutdownStatus) MASR(ServoMotor,MotionInstructions.MASR_Inst[0]) XIC(MotionInstructions.MASR_Inst[0].DN) ]MOV(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 2
Fault Reset Servo Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])MAFR(ServoMotor,MotionInstructions.MAFR_Inst[0])XIC(MotionInstructions.MAFR_Inst[0].DN)MOV(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 3
Enable Lift Servo Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])MSO(ServoMotor,MotionInstructions.MSO_Inst[0])XIC(MotionInstructions.MSO_Inst[0].DN)XIC(ServoMotor.DriveEnableStatus)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 4
Station Disabled]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass)XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)MOV(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 10
Ready / Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(\Mode.Auto) [XIC(IN_BobbinHoldCylUp) [XIO(DiodeGrippedMemory) [XIC(AtHome) XIC(OUT_GripperOpen) [XIC(CycleStationIncoming) XIC(\Chassis.Status.DialOnStation) LIM(100,\Chassis.Status.DialPosDeg,150) ,] OTE(ReadyForDiode) XIC(\DiodeTransfer.OkToHandoff) MOV(11,Control.StateReg) ,[XIO(AtHome) ,XIO(OUT_GripperOpen) ,XIO(IN_BobbinHoldCylUp) ] XIC(\DiodeTransfer.ClearOfInserter) MOV(25,Control.StateReg) ] ,XIC(DiodeGrippedMemory) [AFI() XIC(\DiodeTransfer.ClearOfInserter) MOV(80,Control.StateReg) ,XIC(OUT_GripperClose) [XIC(AtHandoffPos) MOV(15,Control.StateReg) ,XIO(AtHandoffPos) XIC(\DiodeTransfer.ClearOfInserter) MOV(11,Control.StateReg) ] ,XIO(OUT_GripperClose) MOV(25,Control.StateReg) ] ] ,XIO(IN_BobbinHoldCylUp) MOV(40,Control.StateReg) ] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(4,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])XIC(\Mode.Manual)[XIC(HMI_ManJogFwd.EnableOut) XIO(LimitPos) MOV(50,Control.StateReg) ,XIC(HMI_ManJogRev.EnableOut) XIO(LimitNeg) MOV(51,Control.StateReg) ,XIC(HMI_ManMoveHandoff.EnableOut) MOV(53,Control.StateReg) ,XIC(HMI_ManMoveInsert.EnableOut) MOV(54,Control.StateReg) ,XIC(HMI_ManMoveHome.EnableOut) MOV(55,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 11
Move To Transfer Handoff Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[11])[MAM(ServoMotor,MotionInstructions.MAM_Inst[3],MotionConstants.Absolute,MotionPosition.Handoff,MotionParameters[2].Vel,Units per sec,MotionParameters[2].Acc,Units per sec2,MotionParameters[2].Dec,Units per sec2,Trapezoidal,MotionParameters[2].Jerk,MotionParameters[2].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,XIC(MotionInstructions.MAM_Inst[3].PC) XIC(AtHandoffPos) MOV(12,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 12
Gripper Close]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[12])[OTL(OUT_GripperClose) OTU(OUT_GripperOpen) ,OTL(DiodeGrippedMemory) ,MOV(30,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(15,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 15
Gripped At Handoff Signal]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTE(GrippedAtHandoff) ,XIC(\DiodeTransfer.ClearOfInserter) XIC(CycleStation) XIC(\Chassis.Status.DialOnStation) LIM(168,\Chassis.Status.CamPosDeg,250) MOV(20,Control.StateReg) ,XIC(\Mode.Manual) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 20
Bobbin Hold Cylinder Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])[XIC(CycleStation) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,OTL(OUT_BobbinHoldDwn) OTU(OUT_BobbinHoldUp) ,MOV(50,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(21,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 21
Move To Insert Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[21])[MAM(ServoMotor,MotionInstructions.MAM_Inst[4],MotionConstants.Absolute,MotionPosition.Insert,MotionParameters[3].Vel,Units per sec,MotionParameters[3].Acc,Units per sec2,MotionParameters[3].Dec,Units per sec2,Trapezoidal,MotionParameters[3].Jerk,MotionParameters[3].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[4].PC) ,XIC(AtInsertPos) ] XIC(debugBIT.3) MOV(25,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 25
Gripper Open]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[OTL(OUT_GripperOpen) OTU(OUT_GripperClose) ,OTU(DiodeGrippedMemory) ,MOV(20,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) [XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,MOV(27,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 27
-Move To Home Position
- Bobbin Hold Cylinder Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[27])[MAM(ServoMotor,MotionInstructions.MAM_Inst[5],MotionConstants.Absolute,MotionPosition.Home,MotionParameters[4].Vel,Units per sec,MotionParameters[4].Acc,Units per sec2,MotionParameters[4].Dec,Units per sec2,Trapezoidal,MotionParameters[4].Jerk,MotionParameters[4].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,MOV(50,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) OTL(OUT_BobbinHoldUp) OTU(OUT_BobbinHoldDwn) ,XIC(Status.TransitionTimerDone) [XIC(MotionInstructions.MAM_Inst[5].PC) ,XIC(AtHome) ] MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 40
--Recovery--
- Bobbin Hold Cylinder Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[40])[OTL(OUT_BobbinHoldUp) OTU(OUT_BobbinHoldDwn) ,MOV(20,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_BobbinHoldCylUp) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 50
Jog Forward]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[50])MAJ(ServoMotor,MotionInstructions.MAJ_Inst[0],0,MotionParameters[1].Vel,Units per sec,MotionParameters[1].Acc,Units per sec2,MotionParameters[1].Dec,Units per sec2,Trapezoidal,MotionParameters[1].Jerk,MotionParameters[1].Jerk,% of Time,Disabled,Programmed,0,None)[XIO(HMI_ManJogFwd.EnableOut) ,XIC(LimitPos) ]MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 51
Jog Reverse]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[51])MAJ(ServoMotor,MotionInstructions.MAJ_Inst[1],1,MotionParameters[1].Vel,Units per sec,MotionParameters[1].Acc,Units per sec2,MotionParameters[1].Dec,Units per sec2,Trapezoidal,MotionParameters[1].Jerk,MotionParameters[1].Jerk,% of Time,Disabled,Programmed,0,None)[XIO(HMI_ManJogRev.EnableOut) ,XIC(LimitNeg) ]MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 52
Stop Jog
MAS]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[52])MAS(ServoMotor,MotionInstructions.MAS_Inst[2],Jog,No,MotionParameters[0].Dec,Units per sec2,No,80,% of Time)XIC(MotionInstructions.MAS_Inst[2].DN)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 53
Manual Move To Handoff Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[53])[MAM(ServoMotor,MotionInstructions.MAM_Inst[0],MotionConstants.Absolute,MotionPosition.Handoff,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[0].PC) ,XIC(AtHandoffPos) ] MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 54
Manual Move To Insert Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[54])[MAM(ServoMotor,MotionInstructions.MAM_Inst[1],MotionConstants.Absolute,MotionPosition.Insert,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[1].PC) ,XIC(AtInsertPos) ] MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 55
Manual Move To Home Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[55])[MAM(ServoMotor,MotionInstructions.MAM_Inst[2],MotionConstants.Absolute,MotionPosition.Home,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[2].PC) ,XIC(AtHandoffPos) ] MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 125
--Faulted--
Stop All Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])[MAS(ServoMotor,MotionInstructions.MAS_Inst[1],All,Yes,80,% of Maximum,No,0,Units per sec3) ,[XIC(MotionInstructions.MAS_Inst[1].ER) ,XIC(MotionInstructions.MAS_Inst[1].PC) ,XIC(MotionInstructions.MAS_Inst[1].DN) ] XIO(ServoMotor.MoveStatus) MOV(126,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 126
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[126])[XIC(ServoMotor.DriveEnableStatus) MSF(ServoMotor,MotionInstructions.MSF_Inst[0]) ,[XIC(MotionInstructions.MSF_Inst[0].DN) ,XIC(MotionInstructions.MSF_Inst[0].ER) ,XIC(AlwaysOn) ] XIO(ServoMotor.DriveEnableStatus) MOV(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 127
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])[XIO(FaultActive) MOV(0,Control.StateReg) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ONS(OneShot.0) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(70,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ] ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(FaultActive)XIO(Status.State[125])XIO(Status.State[126])XIO(Status.State[127])MOV(125,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
