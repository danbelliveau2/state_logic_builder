<Parameter Name="RobotInputsTag" TagType="Base" DataType="Epson_Robot_Status" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="RobotOutputsTag" TagType="Base" DataType="Epson_Robot_Control" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="ErrorCodeMask" DataType="INT" Radix="Binary" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[32767]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Binary" Value="2#0111_1111_1111_1111"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Map The Input Bits.
Robot Controller Outputs To PLC Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].0)OTE(RobotInputsTag.Ready);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].1)OTE(RobotInputsTag.Running);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].2)OTE(RobotInputsTag.Paused);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].3)OTE(RobotInputsTag.Error);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].4)OTE(RobotInputsTag.EStopOn);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].5)OTE(RobotInputsTag.SafeguardOn);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].6)OTE(RobotInputsTag.SafeError);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].7)OTE(RobotInputsTag.Warning);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].8)OTE(RobotInputsTag.MotorOn);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].9)OTE(RobotInputsTag.AtHome);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(ControllerModuleTag_Inputs.Data[0].10) OTE(RobotInputsTag.ErrorCode.0) ,XIC(ControllerModuleTag_Inputs.Data[0].11) OTE(RobotInputsTag.ErrorCode.1) ,XIC(ControllerModuleTag_Inputs.Data[0].12) OTE(RobotInputsTag.ErrorCode.2) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].13)OTE(RobotInputsTag.AutoMode);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].14)OTE(RobotInputsTag.TeachMode);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].15)OTE(RobotInputsTag.PowerHigh);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[AND(ControllerModuleTag_Inputs.Data[1],ErrorCodeMask,RobotInputsTag.ErrorCode);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[1].15)OTE(RobotInputsTag.InsideBox1);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].0)OTE(RobotInputsTag.InsideBox2);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].1)OTE(RobotInputsTag.InsideBox3);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].2)OTE(RobotInputsTag.Insidebox4);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].3)OTE(RobotInputsTag.InsideBox5);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].4)OTE(RobotInputsTag.InsideBox6);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].5)OTE(RobotInputsTag.InsideBox7);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].6)OTE(RobotInputsTag.InsideBox8);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].14)OTE(RobotInputsTag.InsidePlane1);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[2].15)OTE(RobotInputsTag.InsidePlane2);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[3].0)OTE(RobotInputsTag.InsidePlane3);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[3].1)OTE(RobotInputsTag.InsidePlane4);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[3].2)OTE(RobotInputsTag.InsidePlane5);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[3].3)OTE(RobotInputsTag.InsidePlane6);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[3].4)OTE(RobotInputsTag.InsidePlane7);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[3].5)OTE(RobotInputsTag.InsidePlane8);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[3].14)OTE(RobotInputsTag.ExtCmdGet);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[3].15)OTE(RobotInputsTag.ExtRespSet);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[4].0)OTE(RobotInputsTag.ExtCmdResult);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[4].1)OTE(RobotInputsTag.ExtError);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[COP(ControllerModuleTag_Inputs.Data[5],RobotInputsTag.UserIn[0],4)COP(ControllerModuleTag_Inputs.Data[9],RobotInputsTag.UserWord[0],23);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[Map The Output Bits.
Robot Controller Inputs To PLC Outputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.StartCmd)OTE(ControllerModuleTag_Outputs.Data[0].0);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[[XIC(RobotOutputsTag.SelectProgram.0) OTE(ControllerModuleTag_Outputs.Data[0].1) ,XIC(RobotOutputsTag.SelectProgram.1) OTE(ControllerModuleTag_Outputs.Data[0].2) ,XIC(RobotOutputsTag.SelectProgram.2) OTE(ControllerModuleTag_Outputs.Data[0].3) ];]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.StopCmd)OTE(ControllerModuleTag_Outputs.Data[0].4);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.PauseCmd)OTE(ControllerModuleTag_Outputs.Data[0].5);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.ContinueCmd)OTE(ControllerModuleTag_Outputs.Data[0].6);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.Reset)OTE(ControllerModuleTag_Outputs.Data[0].7);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.SetMotorsOn)OTE(ControllerModuleTag_Outputs.Data[0].8);]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.SetMotorsOff)OTE(ControllerModuleTag_Outputs.Data[0].9);]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.Home)OTE(ControllerModuleTag_Outputs.Data[0].10);]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.ForcePwrLow)OTE(ControllerModuleTag_Outputs.Data[0].11);]]>
</Text>
</Rung>
<Rung Number="48" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.ExtCmdSet)OTE(ControllerModuleTag_Outputs.Data[0].12);]]>
</Text>
</Rung>
<Rung Number="49" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.ExtRespGet)OTE(ControllerModuleTag_Outputs.Data[0].13);]]>
</Text>
</Rung>
<Rung Number="50" Type="N">
<Text>
<![CDATA[XIC(RobotOutputsTag.ExtCmdReset)OTE(ControllerModuleTag_Outputs.Data[0].14);]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Text>
<![CDATA[COP(RobotOutputsTag.UserOut[0],ControllerModuleTag_Outputs.Data[5],4)COP(RobotOutputsTag.UserWord[0],ControllerModuleTag_Outputs.Data[9],10)COP(RobotOutputsTag.DebugSeqNum,ControllerModuleTag_Outputs.Data[19],1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Rotary_Pos_Check" Class="Standard" Revision="1.1" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-09-12T13:59:25.453Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2021-04-10T16:00:44.644Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.02">
<Description>
<![CDATA[Check if RotaryPos is within a window.
For a 360 degree device.
User specifies a window +/- tolerance]]>
</Description>
<RevisionNote>
<![CDATA[Added Check For Target Position <= 360 and Tol >0]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="CurrentPositionTag" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Motor Current Position]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="TargetPosition" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Targeted Position]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="InPosTol" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[In Position Tolerence +/-]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="TargetPosLow" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="TargetPosHigh" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[GRT(InPosTol,0)GEQ(TargetPosition,0)LEQ(TargetPosition,360.0)SUB(TargetPosition,InPosTol,TargetPosLow)ADD(TargetPosition,InPosTol,TargetPosHigh)[LEQ(TargetPosHigh,360.0) GEQ(TargetPosLow,0.0) LIM(TargetPosLow,CurrentPositionTag,TargetPosHigh) ,[GRT(TargetPosHigh,360.0) SUB(TargetPosHigh,360.0,TargetPosHigh) ,LES(TargetPosLow,0.0) ADD(360.0,TargetPosLow,TargetPosLow) ] [LIM(TargetPosLow,CurrentPositionTag,360.0) ,LIM(0,CurrentPositionTag,TargetPosHigh) ] ]OTE(EnableOut);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Safe_DriveCIPSafe" Class="Safety" Revision="1.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2020-01-03T20:33:15.947Z" CreatedBy="STEVENDOUGLAS\wehamby" EditedDate="2021-03-29T19:23:16.118Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.02">
<Description>
<![CDATA[Safety Input and Output instruction that manages the STO circuit for a PowerFlex 527 frequency or Kinetix 5500 drive with CIP Safe enabled.]]>
</Description>
<RevisionNote>
<![CDATA[v1.0 : 2020-01-03 W.E.H]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="ModuleSIData" TagType="Base" DataType="AB:CIP_Drive_Safety1:SI:0" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Safety Input Tag From Module Definition]]>
</Description>
</Parameter>
<Parameter Name="ModuleSOData" TagType="Base" DataType="AB:CIP_Drive_Safety1:SO:0" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Safety Output Tag From Module Definition]]>
