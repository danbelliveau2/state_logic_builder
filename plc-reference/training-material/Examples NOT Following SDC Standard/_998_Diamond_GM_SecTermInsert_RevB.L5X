<Tag Name="WarningActive" TagType="Alias" Radix="Decimal" AliasFor="\Tracking.Data.Station[9].OpStatus.Warning" ExternalAccess="Read/Write"/>
</Tags>
<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[\BobbinLoad.StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_DiodeUpperHoldDwn) XIC(IN_UpperHoldUp) ,XIC(OUT_DiodeUpperHoldUp) XIO(IN_UpperHoldUp) ] TON(TmrFlt_WireHold,?,?) XIC(TmrFlt_WireHold.DN) OTL(Fault[1].Active) ,XIC(Fault[1].Active) XIC(\Main.FaultReset) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0)JSR(ManualControl,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Diode Wire Hold Down Cylinder]]>
</Comment>
<Text>
<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk1,175,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(CycleStation) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,OTL(OUT_DiodeUpperHoldDwn) OTU(OUT_DiodeUpperHoldUp) ] ,Chassis_CamPos_Check(AOI_CamPosChk2,300,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_DiodeUpperHoldDwn) OTL(OUT_DiodeUpperHoldUp) OTU(OUT_DiodeUpperHoldDwn) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Wire Lift cylinder]]>
</Comment>
<Text>
<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk3,210,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIC(OUT_DiodeUpperHoldDwn) OTL(OUT_DiodeWireLiftUp) OTU(OUT_DiodeWireLiftDwn) ,Chassis_CamPos_Check(AOI_CamPosChk4,260,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_DiodeWireLiftUp) [OTL(OUT_DiodeWireLiftDwn) OTU(OUT_DiodeWireLiftUp) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,MOV(0,ConsecFails.Count) ] ,AFI() [XIC(IN_LiftUp) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,MOV(0,ConsecFails.Count) ] ,XIO(IN_LiftUp) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) [OTU(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(91,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ] ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManDiodeHold,0,OUT_DiodeUpperHoldDwn,OUT_DiodeUpperHoldUp,0,1,0,IN_UpperHoldUp,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManLift,0,OUT_DiodeWireLiftUp,OUT_DiodeWireLiftDwn,0,0,0,0,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
