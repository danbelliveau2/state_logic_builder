<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<Description>
<![CDATA[Logic For Fault and Warning Messages]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[\BobbinLoad.StaNum].OpStatus.Bypassed) XIC(SafeOK) XIC(DriveInputs.Fault) ONS(OneShot.0) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIC(\Main.FaultReset) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(AlwaysOff)XIC(Fault[1].Active)XIC(\Main.FaultReset)OTU(Fault[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(AlwaysOff)[XIO(\Tracking.Data.Station[\BobbinLoad.StaNum].OpStatus.Bypassed) XIC(SafeOK) XIC(\Mode.Auto) XIC(DancerArmUp) OTL(Fault[2].Active) ,XIC(Fault[2].Active) XIC(\Main.FaultReset) OTU(Fault[2].Active) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Manual Control Logic]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogFwd,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogRev,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[[OTE(DriveOutputs.NetControl) ,OTE(DriveOutputs.NetSetpoint) ] ,DriveFreq_Lenze_i550(AOI_LenzeIOMapping,DriveFreq_WireDereeler:I1,DriveFreq_WireDereeler:O1,DriveInputs,DriveOutputs) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[SensorDebouncer(AOI_SensorDebouncerArmDwn,IN_DancerArmDown,100,3000,DancerArmDown,0)SensorDebouncer(AOI_SensorDebouncerArmUp,IN_DancerArmUp,100,50,DancerArmUp,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])OTU(DriveOutputs.RunForward)OTU(DriveOutputs.RunReverse)OTU(Running)XIC(SafeOK)[XIC(DriveInputs.Fault) MOV(2,Control.StateReg) ,XIO(DriveInputs.Fault) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 2
Reset Drive Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])[OTE(DriveOutputs.Reset) ,XIO(DriveInputs.Fault) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 10
Ready / Idle


NOTE: Speed setpoints for the drive are in RPM, NOT frequency.

NOTE:Material Present is declared in the WireFeedCut program since logic is needed to load new wire.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])OTU(Running)OTU(DriveOutputs.RunForward)OTU(DriveOutputs.RunReverse)XIC(\Mode.Auto)XIO(\WireFeedCut.FaultActive)XIO(DancerArmDown)MOV(15,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])XIC(\Mode.Manual)[XIC(HMI_ManJogFwd.EnableOut) MOV(50,Control.StateReg) ,XIC(HMI_ManJogRev.EnableOut) MOV(51,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 15
Unwind Wire Spool
-Wait For Dancer Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[MOV(SpeedSetpoints.Run,DriveOutputs.Speed) OTL(DriveOutputs.RunForward) ,MOV(30000,Control.FaultTime) ,[XIC(DancerArmDown) ,XIC(\WireFeedCut.FaultActive) ] MOV(16,Control.StateReg) ,XIC(Status.TimeoutFlt) OTL(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 16
-Stop Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[OTU(DriveOutputs.RunForward) ,MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 50
Jog Forward]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[50])OTL(DriveOutputs.RunForward)MOV(SpeedSetpoints.JogFwd,DriveOutputs.Speed)XIO(HMI_ManJogFwd.EnableOut)MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 51
Jog Reverse]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[51])OTL(DriveOutputs.RunReverse)MOV(SpeedSetpoints.JogRev,DriveOutputs.Speed)XIO(HMI_ManJogRev.EnableOut)MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 52
Stop Jog]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[52])OTU(DriveOutputs.RunForward)OTU(DriveOutputs.RunReverse)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 125
--Faulted--
Stop All Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])[OTU(DriveOutputs.RunForward) OTU(DriveOutputs.RunReverse) OTL(DriveOutputs.QuickStop) ,XIO(DriveInputs.RunningForward) XIO(DriveInputs.RunningReverse) MOV(126,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 126
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[126])XIC(AlwaysOn)MOV(127,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 127
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])[OTU(DriveOutputs.RunForward) OTU(DriveOutputs.RunReverse) OTU(Running) ,XIO(FaultActive) MOV(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(FaultActive)XIO(Status.State[125])XIO(Status.State[126])XIO(Status.State[127])MOV(125,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
</RLLContent>
