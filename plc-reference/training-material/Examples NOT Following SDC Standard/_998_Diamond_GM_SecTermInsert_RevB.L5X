<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[\BobbinLoad.StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_BobbinHoldDn) XIC(IN_BobbinHoldUp) ,XIC(OUT_BobbinHoldUp) XIO(IN_BobbinHoldUp) ] TON(TmrFlt_Bobbin,?,?) XIC(TmrFlt_Bobbin.DN) OTL(Fault[1].Active) ,XIC(Fault[1].Active) XIC(\Main.FaultReset) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0)JSR(ManualControl,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Bobbin Wire Hold Down Cylinder]]>
</Comment>
<Text>
<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk1,110,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(CycleStation) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,OTL(OUT_BobbinHoldDn) OTU(OUT_BobbinHoldUp) ] ,Chassis_CamPos_Check(AOI_CamPosChk2,250,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_BobbinHoldDn) OTL(OUT_BobbinHoldUp) OTU(OUT_BobbinHoldDn) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Wire Lift cylinder]]>
</Comment>
<Text>
<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk3,140,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTL(OUT_WireLiftUp) OTU(OUT_WireLiftDwn) ,Chassis_CamPos_Check(AOI_CamPosChk4,230,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_WireLiftUp) [OTL(OUT_WireLiftDwn) OTU(OUT_WireLiftUp) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManBobbinHold,0,OUT_BobbinHoldDn,OUT_BobbinHoldUp,0,0,0,0,\Mode.Manual,0,\Security.Level,0)HMI_OutTog(HMI_ManWireLift,0,OUT_WireLiftUp,OUT_WireLiftDwn,0,0,0,0,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
