<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIC(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_PogosExt) XIC(IN_PogosRetd) ,XIC(OUT_PogosRet) XIO(IN_PogosRetd) ] TON(TmrFlt_Pogos,?,?) XIC(TmrFlt_Pogos.DN) OTL(Fault[1].Active) ,XIC(Fault[1].Active) XIC(\Main.FaultReset) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_BobbinHoldExt) XIC(IN_BobbinHoldRetd) ,XIC(OUT_BobbinHoldRet) XIO(IN_BobbinHoldRetd) ] TON(TmrFlt_BobbinHold,?,?) XIC(TmrFlt_BobbinHold.DN) OTL(Fault[2].Active) ,XIC(Fault[2].Active) XIC(\Main.FaultReset) OTU(Fault[2].Active) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
