<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Manual Control Logic]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ZeroServoFeed,1,2000,0,AlwaysOff,\Safety.NOK,0,\Security.Level,10,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ZeroServoPunch,1,2000,0,AlwaysOff,\Safety.NOK,0,\Security.Level,10,1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[HMI_OpnPopup(HMI_OpenZeroPopupPunch,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,54,\Safety.EStopNOK,\Security.Level,10);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_EnableMasterControl,1,MasterControlEnabled,DummyBOOL,0,0,0,0,ManualBtnVis,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)XIC(\Mode.Manual)OTE(ManualBtnVis)[XIO(MasterControlEnabled) OTE(ManualControlVis) ,XIC(MasterControlEnabled) OTE(MasterControlVis) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[-The Feed Release and Insert Pusher outputs (See State Logic) are controlled by the State Logic because they are controlled with momentary pushbuttons]]>
</Comment>
<Text>
<![CDATA[HMI_OutTog(HMI_StartOfReel,1,StartOfReelEnabled,DummyBOOL,1,0,StartOfReelEnabled,0,HMI_StartOfReelPBVisible,0,\Security.Level,0)HMI_OutTog(HMI_ManInsert,0,OutputCamArray.0,OutputCamArray.1,1,1,IN_PusherExtd,IN_PusherRetd,\Mode.Manual,0,\Security.Level,0)HMI_OutTog(HMI_ManBobbinHold,0,OutputCamArray.2,OutputCamArray.3,0,0,0,0,ManualControlVis,0,\Security.Level,0)HMI_OutTog(HMI_ManFeedRolls,1,OutputCamArray.11,DummyBOOL,0,0,0,0,ManualControlVis,0,\Security.Level,0)HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,0,1,ConsecFails.Count,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[If the machine is in manual mode when Start Of Reel is enabled, the Master Control Mode needs turned on so the feed system can cycle.]]>
</Comment>
<Text>
<![CDATA[XIC(\Mode.Manual)XIC(StartOfReelEnabled)ONS(OneShot.28)OTL(MasterControlEnabled);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(AlwaysOn)OTE(HMI_StartOfReelPBVisible);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Fault[14].Active) ,EQU(\HMI.CurrentScreenNum,1) NEQ(\HMI.CurrentPopupNum,90) ]OTE(HMI_StripRunoutPBVisible);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(StripRunoutEnabled)ONS(OneShot.4)MOV(0,StripRunout.Count);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogFeedIn,0,0,0,AlwaysOff,ManualControlVis,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogFeedOut,0,0,0,AlwaysOff,ManualControlVis,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogPunchFwd,0,0,0,AlwaysOff,ManualControlVis,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogPunchRev,0,0,0,AlwaysOff,ManualControlVis,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogMaster,0,0,0,AlwaysOff,MasterControlVis,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManExeCycle,0,0,0,AlwaysOff,MasterControlVis,0,\Security.Level,0,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OilSpray" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManSprayOil,0,1,1,OUT_OilSpray,\Mode.Manual,0,\Security.Level,0,1)[HMI_NumericDispEntry(HMI_OilSprayTime,1,\Security.Level,0,0,DummyDINT,1,SprayTimeSec,1,0) ,MUL(SprayTimeSec,1000,SprayTime) MOV(SprayTime,Tmr_OilSpray.PRE) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[[XIC(HMI_OilEnable) GEQ(OilSpray.Count,OilSpray.Setpoint) ,XIC(HMI_ManSprayOil.EnableOut) ] ONS(OneShot.12) MOV(0,OilSpray.Count) TOF(Tmr_OilSpray,?,?) ,XIC(Tmr_OilSpray.TT) OTE(OUT_OilSpray) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Position" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calculate Position For Status (In Degrees)
Note : The value is multiplied and divided to remove scientific notation and create a fixed number of decimal places. ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MUL(MasterServo.ActualPosition,10000,MasterServoPosDegREALTemp)TRN(MasterServoPosDegREALTemp,MasterServoPosDegREALTemp)DIV(MasterServoPosDegREALTemp,10000,VirtualMasterPosDeg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MUL(FeedServoMotor.ActualPosition,10000,FeedServoPosDegREALTemp)TRN(FeedServoPosDegREALTemp,FeedServoPosDegREALTemp)DIV(FeedServoPosDegREALTemp,10000,FeedRollPos);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MUL(PunchServoMotor.ActualPosition,10000,PunchServoPosDegREALTemp)TRN(PunchServoPosDegREALTemp,PunchServoPosDegREALTemp)DIV(PunchServoPosDegREALTemp,10000,PunchPosDeg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[HMI_NumericDispEntry(HMI_PunchAngle,AngleVisibility,\Security.Level,5,0,DummyDINT,1,CamPos_PunchCamFullPunch,1,Greyout) ,XIO(AlwaysOff) OTE(AngleVisibility) ,XIC(ReadyToCycle) OTE(Greyout) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[LIM(CamPos_PunchCamPinFullEng,PunchPosDeg,CamPos_PunchCamFullPunch)OTE(PunchInserted);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Setup Cam Table Segment Values For Feed Cam Profile

NOTE: This Cam profile will lock on to the master at MasterLockPos  (1.0 degree), the cam profile array values are incremental changes of the slave and master.
For Example: If feeding motion needed start at an absolute master position of 5.0 degrees, the slave will lock on at MasterLockPos (1.0) plus incremental profile segment valve of 4.0.

NOTE:Do not enter values in that are less than the MasterLockPos. This will result in a negative segment value!!!!]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[MOV(0,CamArray_Feed[0].Master) ,MOV(0,CamArray_Feed[0].Slave) ,MOV(0,CamArray_Feed[0].SegmentType) ][SUB(CamPos_FeedStartMstr,CamPos_MasterLockPos,CamArray_Feed[1].Master) ,MOV(0,CamArray_Feed[1].Slave) ,MOV(1,CamArray_Feed[1].SegmentType) ][SUB(CamPos_FeedEndMstr,CamPos_MasterLockPos,CamArray_Feed[2].Master) ,MOV(FeedStripLength,CamArray_Feed[2].Slave) ,MOV(0,CamArray_Feed[2].SegmentType) ][MOV(360.0,CamArray_Feed[3].Master) ,MOV(FeedStripLength,CamArray_Feed[3].Slave) ,MOV(0,CamArray_Feed[3].SegmentType) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Setup Cam Table Segment Values For Punch Cam Profile

NOTE: This Cam profile will lock on to the master at MasterLockPos  (1.0 degree), the cam profile array values are incremental changes of the slave and master.
For Example: If feeding motion needed start at an absolute master position of 5.0 degrees, the slave will lock on at MasterLockPos (1.0) plus incremental profile segment valve of 4.0.

NOTE: Do not enter values in that are less than the MasterLockPos. This will result in a negative segment value!!!!

NOTE2: Added dwell at bottom of stroke capability - W.E.H. 2021-04-28]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[MOV(0,CamArray_Punch[0].Master) ,MOV(0,CamArray_Punch[0].Slave) ,MOV(0,CamArray_Punch[0].SegmentType) ][SUB(CamPos_PunchCamStartMstr,CamPos_MasterLockPos,CamArray_Punch[1].Master) ,MOV(0,CamArray_Punch[1].Slave) ,MOV(1,CamArray_Punch[1].SegmentType) ][SUB(CamPos_PunchCamPinTipMstr,CamPos_MasterLockPos,CamArray_Punch[2].Master) ,MOV(CamPos_PunchCamPinTip,CamArray_Punch[2].Slave) ,MOV(1,CamArray_Punch[2].SegmentType) ][SUB(CamPos_PunchCamPinFullEngMstr,CamPos_MasterLockPos,CamArray_Punch[3].Master) ,MOV(CamPos_PunchCamPinFullEng,CamArray_Punch[3].Slave) ,MOV(1,CamArray_Punch[3].SegmentType) ][SUB(CamPos_PunchCamFullPunchMstr,CamPos_MasterLockPos,CamArray_Punch[4].Master) ,MOV(CamPos_PunchCamFullPunch,CamArray_Punch[4].Slave) ,MOV(0,CamArray_Punch[4].SegmentType) ][SUB(CamPos_PunchDwellEndMstr,CamPos_MasterLockPos,CamArray_Punch[5].Master) ,MOV(CamPos_PunchCamFullPunch,CamArray_Punch[5].Slave) ,MOV(1,CamArray_Punch[5].SegmentType) ][SUB(CamPos_PunchCamEndMstr,CamPos_MasterLockPos,CamArray_Punch[6].Master) ,MOV(0,CamArray_Punch[6].Slave) ,MOV(0,CamArray_Punch[6].SegmentType) ][MOV(360,CamArray_Punch[7].Master) ,MOV(0,CamArray_Punch[7].Slave) ,MOV(0,CamArray_Punch[7].SegmentType) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Setup Cam Table Latch/Unlatch Values For Output Cam Profile
-Output 0 - insert pusher extend
-Output 1- insert pusher retract
-Output 2 - bobbin hold cyl down
-Output 3 - bobbin hold cyl up
-Output 4 - spare
-Output 5 - spare
-Output 6 - feed rolls release
-Output 7 - spare
-Output 8 - EnableStripDetect
-Output 9 - Tracking Insert Success Status]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Insert pusher

Extend When Punch Cam Full Punch
NOTE: The sequence needs to stop at a friendly place if the chassis dial is not yet in position. The stop needs to be when the punch is at the bottom of stroke, but yet the pusher is not quite yet told to extend. a 2 degree buffer was inserted to handle any over shoot of the master position and not trigger the insert]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)ADD(CamPos_PunchCamFullPunchMstr,2,CamPos_PusherExtMstr)ADD(CamPos_PusherExtMstr,20,CamPos_PusherRetMstr)[MOV(3,OutputCamProfile[0].LatchType) MOV(4,OutputCamProfile[0].UnlatchType) SUB(CamPos_PusherExtMstr,CamPos_MasterLockPos,OutputCamProfile[0].Left) SUB(CamPos_PusherRetMstr,CamPos_MasterLockPos,OutputCamProfile[0].Right) ,MOV(3,OutputCamProfile[1].LatchType) MOV(4,OutputCamProfile[1].UnlatchType) MOV(OutputCamProfile[0].Right,OutputCamProfile[1].Left) MOV(OutputCamProfile[0].Left,OutputCamProfile[1].Right) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[bobbin hold cylinder]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)[MOV(3,OutputCamProfile[2].LatchType) MOV(4,OutputCamProfile[2].UnlatchType) SUB(CamPos_BobbinHoldDwnMstr,CamPos_MasterLockPos,OutputCamProfile[2].Left) SUB(CamPos_BobbinHoldUpMstr,CamPos_MasterLockPos,OutputCamProfile[2].Right) ,MOV(3,OutputCamProfile[3].LatchType) MOV(4,OutputCamProfile[3].UnlatchType) SUB(OutputCamProfile[2].Right,CamPos_MasterLockPos,OutputCamProfile[3].Left) SUB(OutputCamProfile[2].Left,CamPos_MasterLockPos,OutputCamProfile[3].Right) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Spare]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)MOV(3,OutputCamProfile[4].LatchType)MOV(4,OutputCamProfile[4].UnlatchType)SUB(99,CamPos_MasterLockPos,OutputCamProfile[4].Left)SUB(99,CamPos_MasterLockPos,OutputCamProfile[4].Right);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Spare]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)MOV(3,OutputCamProfile[5].LatchType)MOV(4,OutputCamProfile[5].UnlatchType)MOV(99,OutputCamProfile[5].Left)MOV(99,OutputCamProfile[5].Right);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Feed Rolls]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)MOV(3,OutputCamProfile[6].LatchType)MOV(4,OutputCamProfile[6].UnlatchType)SUB(CamPos_RollRelMstr,CamPos_MasterLockPos,OutputCamProfile[6].Left)SUB(CamPos_RollClampMstr,CamPos_MasterLockPos,OutputCamProfile[6].Right);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[spare]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)MOV(3,OutputCamProfile[7].LatchType)MOV(4,OutputCamProfile[7].UnlatchType)SUB(99,CamPos_MasterLockPos,OutputCamProfile[7].Left)SUB(99,CamPos_MasterLockPos,OutputCamProfile[7].Right);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Check Feed Location]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)MOV(3,OutputCamProfile[8].LatchType)MOV(4,OutputCamProfile[8].UnlatchType)SUB(CamPos_FeedStartMstr,CamPos_MasterLockPos,OutputCamProfile[8].Left)SUB(CamPos_FeedEndMstr,CamPos_MasterLockPos,OutputCamProfile[8].Right);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Tracking Insert Success]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOn)MOV(3,OutputCamProfile[9].LatchType)MOV(4,OutputCamProfile[9].UnlatchType)SUB(CamPos_FeedEndMstr,CamPos_MasterLockPos,OutputCamProfile[9].Left)SUB(305,CamPos_MasterLockPos,OutputCamProfile[9].Right);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ReelChange" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[[[XIC(Fault[14].Active) ,XIC(Fault[15].Active) ] ,XIO(Fault[14].Active) XIO(Fault[15].Active) EQU(\HMI.CurrentScreenNum,1) NEQ(\HMI.CurrentPopupNum,90) ] OTE(ButtonVisibility) ,HMI_OpnPopup(HMI_OpenReelChange,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,58,ButtonVisibility,\Security.Level,0) ,XIC(HMI_OpenReelChange.Trigger) ONS(OneShot.11) [OTL(ReelChangeActive) OTU(MasterControlEnabled) ,XIC(Fault[14].Active) OTU(Fault[14].Active) ,XIC(Fault[15].Active) OTU(Fault[15].Active) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[The clearing of the current popup number is for when someone touches off the popup and it get hidden without the close button being pressed. This allows them to be able to press the button on the main screen to reopen the reel change popup.(because current popup num is now 0 and NEQ 58)]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_NewReelLoaded)ONS(OneShot.13)OTU(ReelChangeActive)OTL(MasterControlEnabled)MOV(0,\HMI.CurrentPopupNum);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_MakeTerminals,0,1,0,0,\Mode.Manual,GreyoutMakeTerms,\Security.Level,0,1) OTL(MakeTerminalsActive) ,[XIC(ReelChangeActive) ,XIC(NewReelLoadedStatus) ,XIO(MasterControlEnabled) ] OTE(GreyoutMakeTerms) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines Within This Program

These Routines need scanned before the State Logic.
NOTE: There are other calls to Routines at the bottom of this routine]]>
</Comment>
<Text>
<![CDATA[JSR(Position,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Mode.Auto)OTE(OUT_ScrapVacOn);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Shows Utilization Percentages Of The Cam Servo Motor
-For Reference Purposes-]]>
</Comment>
<Text>
<![CDATA[Servo_Capacity(AOI_ServoCapFeed,FeedServoMotor)Servo_Capacity(AOI_ServoCapPunch,PunchServoMotor);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOV(PunchTorqueLimit,PunchServoMotor.TorqueLimitPositive)MUL(PunchServoMotor.TorqueLimitPositive,-1,PunchServoMotor.TorqueLimitNegative)MOV(FeedTorqueLimit,FeedServoMotor.TorqueLimitPositive)MUL(FeedServoMotor.TorqueLimitPositive,-1,FeedServoMotor.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [[Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,[Chassis_PartStatChk_V2_0(AOI_PartStatChkInc,\Tracking.Data,StaNum,NestNumIncoming,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Attempt) OTE(CycleStationIncoming) ] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[XIC(SafeOK) [XIC(FeedServoMotor.AxisHomedStatus) XIC(PunchServoMotor.AxisHomedStatus) [ONS(OneShot.2) XIC(AlwaysOff) [XIC(\Chassis.Status.DialOnStation) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) OTU(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,XIO(\Chassis.Status.DialOnStation) XIC(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Failure) OTL(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Failure) OTU(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Success) ] ,XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(1,Control.StateReg) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(4,Control.StateReg) ] ,XIO(FeedServoMotor.AxisHomedStatus) ONS(OneShotFlt.18) OTL(Fault[18].Active) ,XIO(PunchServoMotor.AxisHomedStatus) ONS(OneShotFlt.19) OTL(Fault[19].Active) ] ,XIO(SafeOK) XIC(HMI_ZeroServoFeed.EnableOut) MAH(FeedServoMotor,MotionInstructions[1].MAH_Inst) ,XIO(SafeOK) XIC(HMI_ZeroServoPunch.EnableOut) MAH(PunchServoMotor,MotionInstructions[2].MAH_Inst) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 1
Stop All Servo Drive Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])MAS(MasterServo,MotionInstructions[0].MAS_Inst[0],All,No,0,Units per sec2,No,0,Units per sec3)XIC(MotionInstructions[0].MAS_Inst[0].DN)[XIO(FeedServoMotor.ShutdownStatus) MAS(FeedServoMotor,MotionInstructions[1].MAS_Inst[0],All,No,0,Units per sec2,No,0,Units per sec3) XIC(MotionInstructions[1].MAS_Inst[0].DN) ,XIC(FeedServoMotor.ShutdownStatus) MASR(FeedServoMotor,MotionInstructions[1].MASR_Inst[0]) XIC(MotionInstructions[1].MASR_Inst[0].DN) ][XIO(PunchServoMotor.ShutdownStatus) MAS(PunchServoMotor,MotionInstructions[2].MAS_Inst[0],All,No,0,Units per sec2,No,0,Units per sec3) XIC(MotionInstructions[2].MAS_Inst[0].DN) ,XIC(PunchServoMotor.ShutdownStatus) MASR(PunchServoMotor,MotionInstructions[2].MASR_Inst[0]) XIC(MotionInstructions[2].MASR_Inst[0].DN) ]MDOC(MasterServo,0,MotionInstructions[0].MDOC_Inst[0],All)XIC(MotionInstructions[0].MDOC_Inst[0].DN)MOV(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 2
Fault Reset Servo Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])MAFR(MasterServo,MotionInstructions[0].MAFR_Inst[0])XIC(MotionInstructions[0].MAFR_Inst[0].DN)MAFR(FeedServoMotor,MotionInstructions[1].MAFR_Inst[0])XIC(MotionInstructions[1].MAFR_Inst[0].DN)MAFR(PunchServoMotor,MotionInstructions[2].MAFR_Inst[0])XIC(MotionInstructions[2].MAFR_Inst[0].DN)MOV(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 3
Enable Servo]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])[MSO(FeedServoMotor,MotionInstructions[1].MSO_Inst[0]) ,MSO(PunchServoMotor,MotionInstructions[2].MSO_Inst[0]) ]XIC(MotionInstructions[1].MSO_Inst[0].DN)XIC(FeedServoMotor.DriveEnableStatus)XIC(MotionInstructions[2].MSO_Inst[0].DN)XIC(PunchServoMotor.DriveEnableStatus)MOV(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 4
Station Disabled]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass)XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)MOV(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 5
Check Status]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])[[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(\Mode.Auto) ,XIC(\Mode.Manual) XIC(MasterControlEnabled) ] XIO(ReelChangeActive) [Rotary_Pos_Check(AOI_RotaryPosChk_Punch,PunchPosDeg,PunchCamStartPos,0.1) OTE(PunchServoHome) ,XIO(PunchServoHome) MOV(8,Control.StateReg) ,XIC(PunchServoHome) [ONS(OneShot.5) OTU(OutputCamArray.0) OTL(OutputCamArray.1) OTU(OutputCamArray.2) OTL(OutputCamArray.3) OTU(OutputCamArray.4) OTU(OutputCamArray.5) OTU(OutputCamArray.6) OTU(OutputCamArray.7) OTU(OutputCamArray.8) OTU(OutputCamArray.9) ,MOV(19,Control.StateReg) ] ] ,XIC(ReelChangeActive) [[XIO(IN_BobbinHoldCylUp) ,XIO(IN_PusherRetd) ] ONS(OneShot.6) OTU(OutputCamArray.0) OTL(OutputCamArray.1) OTU(OutputCamArray.2) OTL(OutputCamArray.3) ,XIO(PunchInserted) XIO(NewReelLoadedStatus) MOV(40,Control.StateReg) ] ] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(125,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 5
Manual Control String
-See "ManualControl" routine for control of discrete output devices that are controlled by toggle pushbuttons]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])XIC(\Mode.Manual)XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)XIO(MasterControlEnabled)XIO(ReelChangeActive)[XIC(HMI_ManJogFeedIn.EnableOut) MOV(50,Control.StateReg) ,XIC(HMI_ManJogFeedOut.EnableOut) MOV(51,Control.StateReg) ,XIC(HMI_ManJogPunchFwd.EnableOut) MOV(53,Control.StateReg) ,XIC(HMI_ManJogPunchRev.EnableOut) MOV(54,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 8
Move Punch To Start Position
(Moves to an absolute position shortest path)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])[MAM(PunchServoMotor,MotionInstructions[2].MAM_Inst[0],MotionConstants.RotaryShortest,PunchCamStartPos,MotionParameters[2].Vel,Units per sec,MotionParameters[2].Acc,Units per sec2,MotionParameters[2].Dec,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,Programmed,0,None,0,0) ,XIC(MotionInstructions[2].MAM_Inst[0].PC) MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 19
-Set Master Servo Position To Zero
 -Set Feed Servo Position To Zero
-Enable Feed Servo Position Cam
-Enable Punch Servo Cam

NOTE: The Cam Table values are incremental. Don't confuse the values to be absolute positions of the motors.
The Master Lock Positon of the MACP Inst. is an absolute position.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])[ONS(OneShot.21) OTU(MotionInstructions[0].MRP_Inst[0].EN) OTU(MotionInstructions[1].MRP_Inst[0].EN) OTU(MotionInstructions[0].MRP_Inst[0].DN) OTU(MotionInstructions[1].MRP_Inst[0].DN) OTU(MotionInstructions[1].MCCP_Inst[0].DN) OTU(MotionInstructions[1].MAPC_Inst[0].DN) OTU(MotionInstructions[2].MCCP_Inst[0].DN) OTU(MotionInstructions[2].MAPC_Inst[0].DN) OTU(MotionInstructions[0].MAOC_Inst[0].ER) MRP(MasterServo,MotionInstructions[0].MRP_Inst[0],Absolute,Actual,0.0) ,XIC(MotionInstructions[0].MRP_Inst[0].DN) ONS(OneShot.20) MRP(FeedServoMotor,MotionInstructions[1].MRP_Inst[0],Absolute,Actual,0.0) ,XIC(MotionInstructions[1].MRP_Inst[0].DN) EQU(VirtualMasterPosDeg,0) MCCP(MotionInstructions[1].MCCP_Inst[0],CamArray_Feed[0],4,0,0,CamProfile_Feed[0]) ,XIC(MotionInstructions[1].MCCP_Inst[0].DN) MAPC(FeedServoMotor,MasterServo,MotionInstructions[1].MAPC_Inst[0],0,CamProfile_Feed[0],1,1,Continuous,Immediate,CamPos_MasterLockPos,0,New Cam,Actual,Forward Only) ,XIC(MotionInstructions[1].MAPC_Inst[0].DN) MCCP(MotionInstructions[2].MCCP_Inst[0],CamArray_Punch[0],8,0,0,CamProfile_Punch[0]) ,XIC(MotionInstructions[2].MCCP_Inst[0].DN) MAPC(PunchServoMotor,MasterServo,MotionInstructions[2].MAPC_Inst[0],0,CamProfile_Punch[0],1,1,Continuous,Immediate,CamPos_MasterLockPos,0,New Cam,Actual,Forward Only) ,OTL(OutputCamEnableInputArray.0) OTL(OutputCamEnableInputArray.1) OTL(OutputCamEnableInputArray.2) OTL(OutputCamEnableInputArray.3) OTL(OutputCamEnableInputArray.4) OTL(OutputCamEnableInputArray.5) OTL(OutputCamEnableInputArray.6) OTL(OutputCamEnableInputArray.7) OTL(OutputCamEnableInputArray.8) OTL(OutputCamEnableInputArray.9) ,XIO(MotionInstructions[0].MAOC_Inst[0].IP) XIC(MotionInstructions[1].MAPC_Inst[0].IP) XIC(MotionInstructions[2].MAPC_Inst[0].IP) MAOC(MasterServo,0,MotionInstructions[0].MAOC_Inst[0],OutputCamArray,OutputCamEnableInputArray,OutputCamProfile[0],0,360,OutputCamComp[0],Continuous,Immediate,CamPos_MasterLockPos,0,Actual) ,XIC(MotionInstructions[1].MAPC_Inst[0].IP) XIC(FeedServoMotor.PositionCamStatus) XIC(MotionInstructions[2].MAPC_Inst[0].IP) XIC(PunchServoMotor.PositionCamStatus) XIC(MotionInstructions[0].MAOC_Inst[0].IP) MOV(20,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 20
Ready To Operate
Camming Enabled, All Motors In Their Proper Positions]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(\Mode.Auto) [XIC(IN_EndOfStripDetect) XIO(ReelChangeActive) OTE(ReadyToCycle) [XIC(\Mode.CycleRunning) ,XIC(\Mode.AutoJogging) ,XIC(AlwaysOn) ] [XIO(PartFeedComplete) ,XIC(AlwaysOn) ] [XIC(\Chassis.Status.DialOnStation) ,XIC(AlwaysOn) ] XIC(IN_PusherRetd) XIC(IN_BobbinHoldCylUp) [XIC(CycleStation) Chassis_CamPos_Check(AOI_CamPosChk1,165,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) ,XIC(AlwaysOff) XIC(CycleStationIncoming) Chassis_CamPos_Check(AOI_CamPosChk2,180,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) ] MOV(21,Control.StateReg) ,XIO(IN_EndOfStripDetect) [XIC(\Mode.CycleStarting) ,XIC(\Mode.CycleRunning) ] OTL(Fault[15].Active) ] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) MOV(125,Control.StateReg) ,XIO(ReelChangeActive) XIC(\Mode.Manual) [XIO(MasterControlEnabled) MOV(30,Control.StateReg) ,XIC(MasterControlEnabled) [XIC(IN_PusherRetd) LIM(0,PunchPosDeg,150) ,GRT(PunchPosDeg,150) ] [[XIC(HMI_ManExeCycle.EnableOut) ,XIC(StartOfReelEnabled) LEQ(FeedCount,FeedsToShearQty) ,XIC(HMI_MakeTerminals.EnableOut) ] MOV(21,Control.StateReg) ,XIC(HMI_ManJogMaster.EnableOut) MOV(35,Control.StateReg) ] ] ,XIC(ReelChangeActive) MOV(30,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 21
Cycle Station,
Virtual Master Move First Part Of Full Revolution (360 Degrees)
NOTE: The position was chosen so that if the dial is not on station by the time the punch is ready to chop and the pusher is ready to insert, the master will stop in a position so the process will not interfere with the dial.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[21])OTU(PartFeedComplete)MOV(CamPos_PunchCamFullPunchMstr,Pos_MstrWaitDial)MAM(MasterServo,MotionInstructions[0].MAM_Inst[0],MotionConstants.RotaryPositive,Pos_MstrWaitDial,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,Units per sec3,Disabled,Current,0,None,0,0)XIC(MotionInstructions[0].MAM_Inst[0].DN)[XIO(\Mode.Manual) [XIC(AlwaysOff) XIC(CycleStationIncoming) OTL(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Attempt) ,XIC(CycleStation) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ] ,XIC(\Mode.Manual) ]ADD(DieMaint.Count,1,DieMaint.Count)ADD(OilSpray.Count,1,OilSpray.Count)MOV(22,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 22
Virtual master is moving
-Wait for conditions to trigger second move]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[22])[XIC(MotionInstructions[0].MAM_Inst[0].IP) ,XIC(MotionInstructions[0].MAM_Inst[0].PC) ]GRT(MasterServo.ActualPosition,10)LEQ(MasterServo.ActualPosition,Pos_MstrWaitDial)[XIO(\Mode.Manual) XIC(\Chassis.Status.DialOnStation) GEQ(\Chassis.Status.CamPosDeg,165) ,XIC(\Mode.Manual) ]MOV(23,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 23

Execute Virtual Master Move Second Part Of Full Revolution (360 Degrees)
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[23])MAM(MasterServo,MotionInstructions[0].MAM_Inst[1],MotionConstants.RotaryPositive,360,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,Units per sec3,Enabled,Programmed,0,None,0,0)XIC(MotionInstructions[0].MAM_Inst[1].DN)MOV(24,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 24

Virtual Master Is Completing Second Part Of Full Revolution (360 Degrees)

NOTE:Strip Feed Fault causes the machine to have an indexpermissives fault if we don't retract the pusher and the hold down. ]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[24])[[XIC(OutputCamArray.1) ,XIC(MotionInstructions[0].MAM_Inst[1].PC) ] XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ONS(OneShot.24) [XIC(AlwaysOff) XIO(IN_PusherExtd) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ,MOV(131,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ] ,[XIC(IN_PusherExtd) ,XIC(AlwaysOn) ] [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,MOV(0,ConsecFails.Count) ] ] ,[XIC(OutputCamArray.9) ,XIC(MotionInstructions[0].MAM_Inst[1].PC) ] XIO(\Mode.Manual) ONS(OneShot.10) OTL(PartFeedComplete) [XIC(IN_EndOfStripDetect) [XIC(ChangedDuringFeed) MOV(0,ConsecFails.Count) ADD(FeedCount,1,FeedCount) GRT(FeedCount,FeedsToShearQty) OTU(StartOfReelEnabled) ,XIO(ChangedDuringFeed) ADD(ConsecFails.Count,1,ConsecFails.Count) GEQ(ConsecFails.Count,ConsecFails.Setpoint) MOV(0,ConsecFails.Count) [OTL(Fault[14].Active) ,OTU(OutputCamArray.0) OTL(OutputCamArray.1) OTU(OutputCamArray.2) OTL(OutputCamArray.3) ] ] ,XIO(IN_EndOfStripDetect) OTL(Fault[15].Active) ] ,XIC(MotionInstructions[0].MAM_Inst[1].PC) [XIO(Fault[15].Active) MOV(20,Control.StateReg) ,XIC(Fault[15].Active) MOV(30,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 30
Stop All Servo Drive Motion And Disable Output Cams
(Switching To Manual Mode)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[30])MAS(MasterServo,MotionInstructions[0].MAS_Inst[3],All,No,0,Units per sec2,No,0,Units per sec3)XIC(MotionInstructions[0].MAS_Inst[3].DN)XIC(MotionInstructions[0].MAS_Inst[3].PC)MAS(FeedServoMotor,MotionInstructions[1].MAS_Inst[3],All,No,0,Units per sec2,No,0,Units per sec3)XIC(MotionInstructions[1].MAS_Inst[3].DN)XIC(MotionInstructions[1].MAS_Inst[3].PC)MAS(PunchServoMotor,MotionInstructions[2].MAS_Inst[3],All,No,0,Units per sec2,No,0,Units per sec3)XIC(MotionInstructions[2].MAS_Inst[3].DN)XIC(MotionInstructions[2].MAS_Inst[3].PC)MDOC(MasterServo,0,MotionInstructions[0].MDOC_Inst[2],All)XIC(MotionInstructions[0].MDOC_Inst[2].DN)MOV(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 35
Master Servo Manual Jog Forward
(All Servos Cammed Together)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[35])MAJ(MasterServo,MotionInstructions[0].MAJ_Inst[0],0,MotionParameters[7].Vel,Units per sec,MotionParameters[7].Acc,Units per sec2,MotionParameters[7].Dec,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,Programmed,0,None)XIO(HMI_ManJogMaster.EnableOut)MOV(36,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 36
Master Servo Manual Jog Stop]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[36])MAS(MasterServo,MotionInstructions[0].MAS_Inst[2],Jog,No,MotionParameters[7].Dec,Units per sec2,No,0,Units per sec3)XIC(MotionInstructions[0].MAS_Inst[2].DN)MOV(20,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 40
--Reel Change--

Retract remaining strip so it doesn't get stuck in the punch]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[40])MAM(FeedServoMotor,MotionInstructions[1].MAM_Inst[0],MotionConstants.Incremental,-10,MotionParameters[1].Vel,Units per sec,MotionParameters[1].Acc,Units per sec2,MotionParameters[1].Dec,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,Programmed,0,None,0,0)XIC(MotionInstructions[1].MAM_Inst[0].PC)MOV(41,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 41
--Reel Change--

Move Punch Past Full Engaged In 
Strip Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[41])MAM(PunchServoMotor,MotionInstructions[2].MAM_Inst[2],MotionConstants.RotaryShortest,140,MotionParameters[3].Vel,Units per sec,MotionParameters[3].Acc,Units per sec2,MotionParameters[3].Dec,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,Programmed,0,None,0,0)XIC(MotionInstructions[2].MAM_Inst[2].PC)MOV(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 50
Feed Servo Manual Jog In]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[50])MAJ(FeedServoMotor,MotionInstructions[1].MAJ_Inst[0],0,MotionParameters[4].Vel,Units per sec,MotionParameters[4].Acc,Units per sec2,MotionParameters[4].Dec,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,Programmed,0,None)XIO(HMI_ManJogFeedIn.EnableOut)MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 51
Feed Servo Manual Jog Out]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[51])MAJ(FeedServoMotor,MotionInstructions[1].MAJ_Inst[1],1,MotionParameters[4].Vel,Units per sec,MotionParameters[4].Acc,Units per sec2,MotionParameters[4].Dec,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,Programmed,0,None)XIO(HMI_ManJogFeedOut.EnableOut)MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 52
Feed Servo Manual Jog Stop]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[52])MAS(FeedServoMotor,MotionInstructions[1].MAS_Inst[2],Jog,No,MotionParameters[4].Dec,Units per sec2,No,0,Units per sec3)XIC(MotionInstructions[1].MAS_Inst[2].DN)MOV(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE 53
Punch Servo Manual Jog Fwd]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[53])MAJ(PunchServoMotor,MotionInstructions[2].MAJ_Inst[0],0,MotionParameters[5].Vel,Units per sec,MotionParameters[5].Acc,Units per sec2,MotionParameters[5].Dec,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,Programmed,0,None)XIO(HMI_ManJogPunchFwd.EnableOut)MOV(55,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[STATE 54
Punch Servo Manual Jog Rev]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[54])MAJ(PunchServoMotor,MotionInstructions[2].MAJ_Inst[1],1,MotionParameters[5].Vel,Units per sec,MotionParameters[5].Acc,Units per sec2,MotionParameters[5].Dec,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,Programmed,0,None)XIO(HMI_ManJogPunchRev.EnableOut)MOV(55,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[STATE 55
Punch Servo Manual Jog Stop]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[55])MAS(PunchServoMotor,MotionInstructions[2].MAS_Inst[2],Jog,No,MotionParameters[5].Dec,Units per sec2,No,0,Units per sec3)XIC(MotionInstructions[2].MAS_Inst[2].DN)MOV(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[STATE 125
--Faulted--
Stop All Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])[MAS(MasterServo,MotionInstructions[0].MAS_Inst[1],All,Yes,80,% of Maximum,No,0,Units per sec3) ,MAS(FeedServoMotor,MotionInstructions[1].MAS_Inst[1],All,Yes,80,% of Maximum,No,0,Units per sec3) ,XIC(PunchServoMotor.MoveStatus) MAS(PunchServoMotor,MotionInstructions[2].MAS_Inst[1],All,Yes,80,% of Maximum,No,0,Units per sec3) ,[XIC(MotionInstructions[0].MAS_Inst[1].ER) ,XIC(MotionInstructions[0].MAS_Inst[1].PC) ,XIC(MotionInstructions[0].MAS_Inst[1].DN) ] [XIC(MotionInstructions[1].MAS_Inst[1].ER) ,XIC(MotionInstructions[1].MAS_Inst[1].PC) ,XIC(MotionInstructions[1].MAS_Inst[1].DN) ] [XIC(MotionInstructions[2].MAS_Inst[1].ER) ,XIC(MotionInstructions[2].MAS_Inst[1].PC) ,XIO(PunchServoMotor.MoveStatus) ] MDOC(MasterServo,0,MotionInstructions[0].MDOC_Inst[1],All) [XIC(MotionInstructions[0].MDOC_Inst[1].DN) ,XIC(MotionInstructions[0].MDOC_Inst[1].ER) ] XIO(FeedServoMotor.MoveStatus) MOV(126,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[STATE 126
--Faulted--
Servo Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[126])[XIC(FeedServoMotor.DriveEnableStatus) MSF(FeedServoMotor,MotionInstructions[1].MSF_Inst[0]) ,XIC(PunchServoMotor.DriveEnableStatus) MSF(PunchServoMotor,MotionInstructions[2].MSF_Inst[0]) ,[XIC(MotionInstructions[1].MSF_Inst[0].DN) ,XIC(MotionInstructions[1].MSF_Inst[0].ER) ,XIC(AlwaysOn) ] [XIC(MotionInstructions[2].MSF_Inst[0].DN) ,XIC(MotionInstructions[2].MSF_Inst[0].ER) ,XIC(AlwaysOn) ] XIO(FeedServoMotor.DriveEnableStatus) XIO(PunchServoMotor.DriveEnableStatus) MOV(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[STATE 127
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])[ONS(OneShot.27) XIC(AlwaysOff) [XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,XIC(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Success) XIO(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Failure) OTL(\Tracking.Data.Nest[NestNumIncoming].PartStatus.Station[StaNum].Failure) ,MOV(130,\Tracking.Data.Nest[NestNumIncoming].PartStatus.FailureType) ] ,XIO(FaultActive) MOV(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[XIC(FaultActive)XIO(Status.State[125])XIO(Status.State[126])XIO(Status.State[127])MOV(125,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
