<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ALARM LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Tray handling system: Possible tray jam on the conveyor]]>
</Comment>
<Text>
<![CDATA[[XIO(\HMI.TrayHandlingBypassed) XIC(SafeOK) XIC(\Mode.Auto) XIC(OUT_StopsDwn) XIC(\Safety.OUTS_TrayStackerConvRun) XIO(\TrayElevator.TraysAtElevator) TON(tmr_TraysNotAtElevFlt,?,?) XIC(tmr_TraysNotAtElevFlt.DN) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIC(\Main.FaultReset) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManStops,0,OUT_StopsDwn,OUT_StopsUp,0,0,0,0,\Mode.Manual,0,\Security.Level,0)[HMI_OutTog(HMI_ManConveyor,1,ManConvRun,DummyBOOL,1,0,\Safety.OUTS_TrayStackerConvRun,0,\Mode.Manual,0,\Security.Level,0) ,XIC(\Mode.AutoPulse) OTU(ManConvRun) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SensorDebouncer(AOI_SensorDebouncerTraysAtStop,IN_TraysAtQueue,500,500,TraysAtStop,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STATE 0
Power Off / Safety Circuit Opened]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])XIC(SafeOK)MOV(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 5
Init - Machine started
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])XIC(\Mode.Auto)[XIO(OUT_StopsUp) XIO(TraysAtStop) MOV(7,Control.StateReg) ,XIC(OUT_StopsUp) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 7
Init - Raise the tray stops]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])[OTL(OUT_StopsUp) OTU(OUT_StopsDwn) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 8
Init - Lower the tray stops]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])[OTL(OUT_StopsDwn) OTU(OUT_StopsUp) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 10
---Stops Up And check trays Are Present---
Wait for next position to need trays]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])[XIC(\Mode.Auto) XIO(\HMI.TrayHandlingBypassed) [XIC(OUT_StopsUp) XIC(TraysAtStop) XIC(OUT_StopsUp) XIO(\TrayElevator.TraysAtElevator) XIC(\TrayElevator.AtDownPos) MOV(17,Control.StateReg) ,XIC(OUT_StopsDwn) XIC(\TrayElevator.TraysAtElevator) XIC(\TrayElevator.AtDownPos) MOV(21,Control.StateReg) ] ,XIO(\Mode.Auto) MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 17
Lower the stop cylinders
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[17])[OTL(OUT_StopsDwn) OTU(OUT_StopsUp) ,MOV(10,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) MOV(19,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 19
Release Trays To Next Stop
(Start the conveyor)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])[XIC(\Mode.Auto) OTE(ReleaseTraysToNextStop) XIC(\Safety.OUTS_TrayStackerConvRun) XIO(TraysAtStop) XIC(\TrayElevator.TraysAtElevator) MOV(21,Control.StateReg) ,XIO(\Mode.Auto) MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 21
Raise the stop cylinders]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[21])[OTL(OUT_StopsUp) OTU(OUT_StopsDwn) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) [XIC(\Mode.Auto) MOV(10,Control.StateReg) ,XIO(\Mode.Auto) MOV(5,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 127
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])XIO(FaultActive)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(FaultActive)MOV(127,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Run the conveyor]]>
</Comment>
<Text>
<![CDATA[XIC(\Mode.Auto)[XIC(ReleaseTraysToNextStop) ,XIC(\TrayInfeed.ReleaseTraysToNextStop) ,XIC(ManConvRun) ]OTE(out_TrayStackerConvRunCmd_c);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
