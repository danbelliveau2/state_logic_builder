<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[\BobbinLoad.StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_FormGrprDwn) XIO(IN_GripperDwn) ,XIC(OUT_FormGrprUp) XIO(IN_GripperUp) ] TON(TmrFlt_GripperHold,?,?) XIC(TmrFlt_GripperHold.DN) OTL(Fault[1].Active) ,XIC(Fault[1].Active) XIC(\Main.FaultReset) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Fault[2].Active)XIC(\Main.FaultReset)OTU(Fault[2].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Fault[3].Active)XIC(\Main.FaultReset)OTU(Fault[3].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0)JSR(ManualControl,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Alignment Tool (also holds the Bobbin)]]>
</Comment>
<Text>
<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk5,110,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(CycleStation) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,OTL(OUT_AlignToolExt) OTU(OUT_AlignToolRet) ] ,Chassis_CamPos_Check(AOI_CamPosChk6,310,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_AlignToolExt) OTL(OUT_AlignToolRet) OTU(OUT_AlignToolExt) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Lower Bend Tool]]>
</Comment>
<Text>
<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk3,140,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIC(OUT_AlignToolExt) OTL(OUT_LowerToolUp) OTU(OUT_LowerToolDwn) ,Chassis_CamPos_Check(AOI_CamPosChk4,280,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_LowerToolUp) OTL(OUT_LowerToolDwn) OTU(OUT_LowerToolUp) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Forming Gripper Cylinder Vertical]]>
</Comment>
<Text>
<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk1,160,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIC(OUT_AlignToolExt) OTL(OUT_FormGrprDwn) OTU(OUT_FormGrprUp) ,Chassis_CamPos_Check(AOI_CamPosChk2,260,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_FormGrprDwn) [OTL(OUT_FormGrprUp) OTU(OUT_FormGrprDwn) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) [XIC(IN_GripperDwn) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,MOV(0,ConsecFails.Count) ] ,XIO(IN_GripperDwn) [OTU(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(101,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Forming Gripper Close/Open]]>
</Comment>
<Text>
<![CDATA[[XIO(\Mode.Manual) Chassis_CamPos_Check(AOI_CamPosChk7,200,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIC(OUT_FormGrprDwn) OTL(OUT_FormGrprClose) OTU(OUT_FormGrprOpen) ,Chassis_CamPos_Check(AOI_CamPosChk8,240,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(OUT_FormGrprClose) OTL(OUT_FormGrprOpen) OTU(OUT_FormGrprClose) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Check For Lower Bend And Alignment Tooling Retracted 
Extended During Cam Motion Causes The Tooling To Get Broken (Used As A Chassis Immediate Stop Condition) ]]>
</Comment>
<Text>
<![CDATA[AFI()LIM(350,\Chassis.Status.CamPosDeg,360)[XIC(\Chassis.Status.Running) ,XIC(\Chassis.Status.Jogging) ,XIC(\Chassis.Status.Stopping) ][XIO(IN_AlignToolRetracted) OTL(Fault[2].Active) ,XIO(IN_LowerBendToolDwn) OTL(Fault[3].Active) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManAlign,0,OUT_AlignToolExt,OUT_AlignToolRet,0,1,0,IN_AlignToolRetracted,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManLowerTool,0,OUT_LowerToolUp,OUT_LowerToolDwn,0,1,0,IN_LowerBendToolDwn,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManGripperVert,0,OUT_FormGrprDwn,OUT_FormGrprUp,0,1,0,IN_GripperUp,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManGripper,0,OUT_FormGrprClose,OUT_FormGrprOpen,0,0,0,0,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
