<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<Description>
<![CDATA[Logic For Fault and Warning Messages]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(MotionInstructions.MSO_Inst[0].EN) [XIC(MotionInstructions.MSO_Inst[0].ER) ,XIO(MotionInstructions.MSO_Inst[0].DN) MOV(1500,TmrFlt_ServoEnable.PRE) TON(TmrFlt_ServoEnable,?,?) XIC(TmrFlt_ServoEnable.DN) ] ONS(OneShotFlt.0) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) ]OTE(Fault[0].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(SafeOK) [XIC(ServoMotor.PhysicalAxisFault) ,XIC(ServoMotor.ModuleFault) ,XIC(ServoMotor.ConfigFault) ,XIC(ServoMotor.GroupFault) ,XIC(ServoMotor.MotionFault) ] XIO(MotionInstructions.MASR_Inst[0].EN) XIO(MotionInstructions.MAFR_Inst[0].EN) ONS(OneShotFlt.1) ,XIC(Fault[1].Active) XIO(\Main.FaultReset) ]OTE(Fault[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(SafeOK) [XIC(MotionInstructions.MAJ_Inst[0].EN) XIC(MotionInstructions.MAJ_Inst[0].ER) ,XIC(MotionInstructions.MAJ_Inst[1].EN) XIC(MotionInstructions.MAJ_Inst[1].ER) ,XIC(MotionInstructions.MAJ_Inst[2].EN) XIC(MotionInstructions.MAJ_Inst[2].ER) ,XIC(MotionInstructions.MAJ_Inst[3].EN) XIC(MotionInstructions.MAJ_Inst[3].ER) ,XIC(MotionInstructions.MAJ_Inst[4].EN) XIC(MotionInstructions.MAJ_Inst[4].ER) ,XIC(MotionInstructions.MAJ_Inst[5].EN) XIC(MotionInstructions.MAJ_Inst[5].ER) ,XIC(MotionInstructions.MAJ_Inst[6].EN) XIC(MotionInstructions.MAJ_Inst[6].ER) ,XIC(MotionInstructions.MAJ_Inst[7].EN) XIC(MotionInstructions.MAJ_Inst[7].ER) ,XIC(MotionInstructions.MAJ_Inst[8].EN) XIC(MotionInstructions.MAJ_Inst[8].ER) ,XIC(MotionInstructions.MAJ_Inst[9].EN) XIC(MotionInstructions.MAJ_Inst[9].ER) ,XIC(MotionInstructions.MAS_Inst[0].EN) XIC(MotionInstructions.MAS_Inst[0].ER) ,XIC(MotionInstructions.MAS_Inst[1].EN) XIC(MotionInstructions.MAS_Inst[1].ER) ,XIC(MotionInstructions.MAS_Inst[2].EN) XIC(MotionInstructions.MAS_Inst[2].ER) ,XIC(MotionInstructions.MAS_Inst[3].EN) XIC(MotionInstructions.MAS_Inst[3].ER) ,XIC(MotionInstructions.MAS_Inst[4].EN) XIC(MotionInstructions.MAS_Inst[4].ER) ,XIC(MotionInstructions.MAFR_Inst[0].EN) XIC(MotionInstructions.MAFR_Inst[0].ER) ,XIC(MotionInstructions.MAFR_Inst[1].EN) XIC(MotionInstructions.MAFR_Inst[1].ER) ,XIC(MotionInstructions.MCD_Inst[0].ER) ,XIC(MotionInstructions.MCD_Inst[1].ER) ,XIC(MotionInstructions.MRP_Inst[0].ER) ,XIC(MotionInstructions.MRP_Inst[1].ER) ,XIC(MotionInstructions.MAH_Inst.ER) ,[XIC(MotionInstructions.MAS_Inst[0].EN) [XIO(MotionInstructions.MAS_Inst[0].DN) ,XIO(MotionInstructions.MAS_Inst[0].PC) ] ,XIC(MotionInstructions.MAS_Inst[1].EN) [XIO(MotionInstructions.MAS_Inst[1].DN) ,XIO(MotionInstructions.MAS_Inst[1].PC) ] ,XIC(MotionInstructions.MAS_Inst[2].EN) [XIO(MotionInstructions.MAS_Inst[2].DN) ,XIO(MotionInstructions.MAS_Inst[2].PC) ] ,XIC(MotionInstructions.MAS_Inst[3].EN) [XIO(MotionInstructions.MAS_Inst[3].DN) ,XIO(MotionInstructions.MAS_Inst[3].PC) ] ,XIC(MotionInstructions.MAS_Inst[4].EN) [XIO(MotionInstructions.MAS_Inst[4].DN) ,XIO(MotionInstructions.MAS_Inst[4].PC) ] ,XIC(MotionInstructions.MAH_Inst.EN) [XIO(MotionInstructions.MAH_Inst.DN) ,XIO(MotionInstructions.MAH_Inst.PC) ] ] MOV(3000,TmrFlt_MotionInst.PRE) TON(TmrFlt_MotionInst,?,?) XIC(TmrFlt_MotionInst.DN) ] ONS(OneShotFlt.2) ,XIC(Fault[2].Active) XIO(\Main.FaultReset) ]OTE(Fault[2].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(SafeOK) [XIC(MotionInstructions.MAM_Inst[0].EN) XIC(MotionInstructions.MAM_Inst[0].ER) ,XIC(MotionInstructions.MAM_Inst[1].EN) XIC(MotionInstructions.MAM_Inst[1].ER) ,XIC(MotionInstructions.MAM_Inst[2].EN) XIC(MotionInstructions.MAM_Inst[2].ER) ,XIC(MotionInstructions.MAM_Inst[3].EN) XIC(MotionInstructions.MAM_Inst[3].ER) ,XIC(MotionInstructions.MAM_Inst[4].EN) XIC(MotionInstructions.MAM_Inst[4].ER) ,XIC(MotionInstructions.MAM_Inst[5].EN) XIC(MotionInstructions.MAM_Inst[5].ER) ,XIC(MotionInstructions.MAM_Inst[6].EN) XIC(MotionInstructions.MAM_Inst[6].ER) ,XIC(MotionInstructions.MAM_Inst[7].EN) XIC(MotionInstructions.MAM_Inst[7].ER) ,XIC(MotionInstructions.MAM_Inst[8].EN) XIC(MotionInstructions.MAM_Inst[8].ER) ,XIC(MotionInstructions.MAM_Inst[9].EN) XIC(MotionInstructions.MAM_Inst[9].ER) ,[XIC(MotionInstructions.MAM_Inst[0].EN) XIO(MotionInstructions.MAM_Inst[0].DN) ,XIC(MotionInstructions.MAM_Inst[1].EN) XIO(MotionInstructions.MAM_Inst[1].DN) ,XIC(MotionInstructions.MAM_Inst[2].EN) XIO(MotionInstructions.MAM_Inst[2].DN) ,XIC(MotionInstructions.MAM_Inst[3].EN) XIO(MotionInstructions.MAM_Inst[3].DN) ,XIC(MotionInstructions.MAM_Inst[4].EN) XIO(MotionInstructions.MAM_Inst[4].DN) ,XIC(MotionInstructions.MAM_Inst[5].EN) XIO(MotionInstructions.MAM_Inst[5].DN) ,XIC(MotionInstructions.MAM_Inst[6].EN) XIO(MotionInstructions.MAM_Inst[6].DN) ,XIC(MotionInstructions.MAM_Inst[7].EN) XIO(MotionInstructions.MAM_Inst[7].DN) ,XIC(MotionInstructions.MAM_Inst[8].EN) XIO(MotionInstructions.MAM_Inst[8].DN) ,XIC(MotionInstructions.MAM_Inst[9].EN) XIO(MotionInstructions.MAM_Inst[9].DN) ] MOV(4000,TmrFlt_MoveInst.PRE) TON(TmrFlt_MoveInst,?,?) XIC(TmrFlt_MoveInst.DN) ] ONS(OneShotFlt.3) ,XIC(Fault[3].Active) XIO(\Main.FaultReset) ]OTE(Fault[3].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(SafeOK) XIC(ServoMotor.DriveEnableStatus) XIC(ServoMotor.TorqueLimitStatus) ONS(OneShotFlt.4) OTL(Fault[4].Active) ,XIC(Fault[4].Active) XIC(\Main.FaultReset) OTU(Fault[4].Active) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Fault[5].Active)XIC(\Main.FaultReset)OTU(Fault[5].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIO(\HMI.TrayHandlingBypassed) XIC(SafeOK) [XIC(OUT_TrayClampsExt) XIC(IN_LeftTrayClampRetd) ,XIC(OUT_TrayClampsRet) XIO(IN_LeftTrayClampRetd) ] TON(TmrFlt_LftTrayClampRetFlt,?,?) XIC(TmrFlt_LftTrayClampRetFlt.DN) OTL(Fault[6].Active) ,XIC(Fault[6].Active) XIC(\Main.FaultReset) OTU(Fault[6].Active) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIO(\HMI.TrayHandlingBypassed) XIC(SafeOK) [XIC(OUT_TrayClampsExt) XIC(IN_RightTrayClampRetd) ,XIC(OUT_TrayClampsRet) XIO(IN_RightTrayClampRetd) ] TON(TmrFlt_RtTrayClampRetFlt,?,?) XIC(TmrFlt_RtTrayClampRetFlt.DN) OTL(Fault[7].Active) ,XIC(Fault[7].Active) XIC(\Main.FaultReset) OTU(Fault[7].Active) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Fault[8].Active)XIC(\Main.FaultReset)OTU(Fault[8].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ZeroServo,1,2000,0,AlwaysOff,Status.State[0],0,\Security.Level,10,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[HMI_OpnPopup(HMI_OpenZeroPopupElevator,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,55,\Safety.EStopNOK,\Security.Level,10);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_ManTrayClamps,0,OUT_TrayClampsExt,OUT_TrayClampsRet,0,1,0,IN_TrayClampLeftRetd,\Mode.Manual,0,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogUp,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManJogDwn,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[HMI_OutMom(HMI_ManMoveDown,0,0,0,AlwaysOff,\Mode.Manual,0,\Security.Level,0,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[HMI_OutTog(HMI_BrakeRelease,0,HMI_ReleaseBrake,HMI_EngageBrake,1,0,BrakeRelActive,0,1,ServoMotor.DriveEnableStatus,\Security.Level,10);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Override Mechanical Brake On Vertical Axis For Maintenance Purposes (Hide Buttons While Machine Running & Also Password Protect)]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ReleaseBrake) MOV(1,Turntable_BrakeReleaseCTRL) SSV(Axis,ServoMotor,MechanicalBrakeControl,Turntable_BrakeReleaseCTRL) OTL(BrakeRelActive) ,XIC(HMI_EngageBrake) MOV(0,Turntable_BrakeReleaseCTRL) SSV(Axis,ServoMotor,MechanicalBrakeControl,Turntable_BrakeReleaseCTRL) OTU(BrakeRelActive) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Position" Type="RLL">
<Description>
<![CDATA[Calculations For Lift Motor Position]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calculate Position For Status (In mm)
Note : The value is multiplied and divided to remove scientific notation and create a fixed number of decimal places. ]]>
</Comment>
<Text>
<![CDATA[MUL(ServoMotor.ActualPosition,1000,ServoPosDegREALTemp)TRN(ServoPosDegREALTemp,ServoPosDegREALTemp)DIV(ServoPosDegREALTemp,1000,ServoPos_mm);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CMP(ServoPos_mm < (MotionPosition.Down + MotionPosition.InPosTol))CMP(ServoPos_mm > (MotionPosition.Down - MotionPosition.InPosTol))OTE(AtDownPos);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[CMP(ServoPos_mm < (MotionPosition.TrayDropoffCalc + MotionPosition.InPosTol))CMP(ServoPos_mm > (MotionPosition.TrayDropoffCalc - MotionPosition.InPosTol))OTE(AtTrayDropoffPos);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[CMP(ServoPos_mm > MotionPosition.Top)OTE(AtTopPos);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GEQ(ServoPos_mm,LastTrayPos)OTE(LastTrayInstack);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[LEQ(ServoPos_mm,2) OTE(LimitLower) ,GEQ(ServoPos_mm,605) OTE(LimitUpper) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(AtDownPos) ,XIO(AtDownPos) CMP(ServoPos_mm <= (MotionPosition.ClearOfLoadTrayCalc + MotionPosition.InPosTol)) ]OTE(ClearOfTrayLoadArea);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(Position,0)JSR(ManualControl,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[-Increment tray count when robot places a part

-Send the next tray pick position to the robot and turn on a bit whenever the tray position is more than 48 (tray complete)

-Trigger Data Logging
-Increment Production Good Part

-Set the place select to 0 so the next picked part will overwrite it with the correct destination.]]>
</Comment>
<Text>
<![CDATA[[XIC(\RobotUnload.Inputs.UserIn[1].1) [[OTE(\RobotUnload.Outputs.UserOut[2].1) ,[COP(\Tracking.Data.Nest[NestNumRobot].PartStatus,\Logging.NewData.PartStatus,1) ,COP(\Tracking.Data.Nest[NestNumRobot].ProcessData,\Logging.NewData.ProcessData,1) ] COP(\Tracking.ZeroTrackingNest,\Tracking.Data.Nest[NestNumRobot],1) ,OTE(\Production.GoodPart) ] ,ONS(OneShot.0) ADD(TrayPosIndex,1,TrayPosIndex) MOV(0,\RobotUnload.Outputs.UserWord[1]) ] ,LEQ(TrayPosIndex,50) MOV(TrayPosArray[TrayPosIndex],\RobotUnload.Outputs.UserWord[2]) ,GRT(TrayPosIndex,48) OTE(TrayLoadComplete) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[OK To Place In Pallet signal to robot]]>
</Comment>
<Text>
<![CDATA[XIC(\Mode.Auto)[XIC(OUT_TrayClampsExt) MOV(ClampsExtendTime,Tmr_TrayClampsExtnd.PRE) TON(Tmr_TrayClampsExtnd,?,?) ,XIC(Tmr_TrayClampsExtnd.DN) XIC(TrayAtLoad) LIM(1,TrayPosIndex,48) XIO(\RobotUnload.Inputs.UserIn[1].1) OTE(\RobotUnload.Outputs.UserOut[1].1) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[TrayInPosition signal to outfeed for the pusher to extend under tray

This is seperate logic so motion can occur on the outfeed pusher while the elevator is moving (transitioning states)]]>
</Comment>
<Text>
<![CDATA[XIC(\Mode.Auto)XIC(TrayAtLoad)XIC(OUT_TrayClampsExt)OTE(TrayInPosition);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[SensorDebouncer(AOI_SensorDebouncerTraysAtElev,IN_TraysAtElevator,1,100,TraysAtElevator,0)SensorDebouncer(AOI_SensorDebouncerTrayAtLoad,IN_TrayAtLoad,100,100,TrayAtLoad,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[Servo_Capacity(AOI_MotorCapacity,ServoMotor)MOV(20,ServoMotor.TorqueLimitPositive)MOV(-50,ServoMotor.TorqueLimitNegative);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[XIC(SafeOK) [XIC(ServoMotor.AxisHomedStatus) MOV(1,Control.StateReg) ,XIO(ServoMotor.AxisHomedStatus) ONS(OneShotFlt.8) OTL(Fault[8].Active) ] ,XIO(SafeOK) XIC(HMI_ZeroServo.EnableOut) MAH(ServoMotor,MotionInstructions.MAH_Inst) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 1
Stop All Servo Drive Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIO(ServoMotor.ShutdownStatus) MAS(ServoMotor,MotionInstructions.MAS_Inst[0],All,Yes,60,% of Maximum,No,0,Units per sec3) XIC(MotionInstructions.MAS_Inst[0].DN) ,XIC(ServoMotor.ShutdownStatus) MASR(ServoMotor,MotionInstructions.MASR_Inst[0]) XIC(MotionInstructions.MASR_Inst[0].DN) ]MOV(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 2
Fault Reset Servo Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])MAFR(ServoMotor,MotionInstructions.MAFR_Inst[0])XIC(MotionInstructions.MAFR_Inst[0].DN)MOV(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 3
Enable Lift Servo Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])MSO(ServoMotor,MotionInstructions.MSO_Inst[0])XIC(MotionInstructions.MSO_Inst[0].DN)XIC(ServoMotor.DriveEnableStatus)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 10
Ready / Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(\Mode.Auto)XIO(\HMI.TrayHandlingBypassed)[XIC(TrayAtLoad) XIC(TrayLoadComplete) [XIC(OUT_TrayClampsExt) XIO(IN_LeftTrayClampRetd) XIO(IN_RightTrayClampRetd) XIC(\TrayLoadOutfeed.OKReleaseTray) XIC(\TrayLoadOutfeed.IN_TrayPusherExtd) MOV(12,Control.StateReg) ,XIC(OUT_TrayClampsRet) XIC(IN_LeftTrayClampRetd) XIC(IN_RightTrayClampRetd) OTE(OKRemoveFullTray) ] ,XIO(TrayAtLoad) [XIO(StackOnElevatorMemory) XIC(AtDownPos) XIC(TraysAtElevator) ,XIC(StackOnElevatorMemory) ] XIC(\TrayLoadOutfeed.IN_TrayPusherRetd) XIC(IN_LeftTrayClampRetd) XIC(IN_RightTrayClampRetd) MOV(14,Control.StateReg) ,XIO(AtDownPos) XIO(StackOnElevatorMemory) MOV(25,Control.StateReg) ,AFI() MOV(80,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])XIC(\Mode.Manual)[XIC(HMI_ManJogUp.EnableOut) XIO(LimitUpper) MOV(50,Control.StateReg) ,XIC(HMI_ManJogDwn.EnableOut) XIO(LimitLower) MOV(51,Control.StateReg) ,XIC(HMI_ManMoveDown.EnableOut) MOV(53,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 12
Tray Clamps Retract]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[12])[OTL(OUT_TrayClampsRet) OTU(OUT_TrayClampsExt) ,MOV(30,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_LeftTrayClampRetd) XIC(IN_RightTrayClampRetd) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 14
-First Move To Top Position
-Next Move To Tray Dropoff  (Clamp) Position

NOTE: The second MAM was added to this rung to save an extra scan of the logic
The PC bit needs cleared because its left on for the previous rung execution. Since the second MAM is not scanned right away, the PC bit doesn't get reset.
NOTE2: The ClearOfLoadTrayCalc position is calculated just in case so the ClearOfTrayLoadArea bit doesn't come on and let tray pusher extend too early (not totally sure this could happen)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[14])[ONS(OneShot.14) OTU(MotionInstructions.MAM_Inst[1].PC) OTL(StackOnElevatorMemory) ,MAM(ServoMotor,MotionInstructions.MAM_Inst[0],MotionConstants.Absolute,MotionPosition.Top,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,XIC(MotionInstructions.MAM_Inst[0].DN) [XIO(MotionInstructions.MAM_Inst[0].PC) XIC(IN_TrayAtLoad) ONS(OneShot.15) [MOV(ServoPos_mm,ElevPosTrayDetect) ADD(ServoPos_mm,MotionPosition.TrayDropoffOffset,MotionPosition.TrayDropoffCalc) SUB(MotionPosition.TrayDropoffCalc,MotionPosition.ClearOfLoadTrayOffset,MotionPosition.ClearOfLoadTrayCalc) ,MAM(ServoMotor,MotionInstructions.MAM_Inst[1],MotionConstants.Absolute,MotionPosition.TrayDropoffCalc,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Enabled,Programmed,0,None,0,0) ] ,XIC(MotionInstructions.MAM_Inst[0].PC) MOV(25,Control.StateReg) ] ,XIC(AtTopPos) MOV(24,Control.StateReg) ,[XIC(MotionInstructions.MAM_Inst[1].PC) ,XIC(AtTrayDropoffPos) AFI() ] MOV(15,Control.StateReg) ,XIO(\TrayLoadOutfeed.IN_TrayPusherRetd) OTL(Fault[5].Active) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 15
Tray Clamps Extend

-Reset Tray Load Position

OKtoPlace In Pallet Logic Is At The Top Of This Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTL(OUT_TrayClampsExt) OTU(OUT_TrayClampsRet) ,ONS(OneShot.16) MOV(1,TrayPosIndex) ,MOV(ClampsExtendTime,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) [XIO(LastTrayInstack) MOV(20,Control.StateReg) ,XIC(LastTrayInstack) MOV(25,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 20
Move Down A Little To Clear Tray Pusher
Calculte the position from the current position and then down a determined offset. If calculated is below.the down pos, then just go to the down pos. ]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[20])[ONS(OneShot.20) MOV(ServoPos_mm,ElevPosTrayDetect) SUB(ServoPos_mm,MotionPosition.ClearOfLoadTrayOffset,MotionPosition.ClearOfLoadTrayCalc) LES(MotionPosition.ClearOfLoadTrayCalc,MotionPosition.Down) MOV(MotionPosition.Down,MotionPosition.ClearOfLoadTrayCalc) ,MAM(ServoMotor,MotionInstructions.MAM_Inst[2],MotionConstants.Absolute,MotionPosition.ClearOfLoadTrayCalc,MotionParameters[2].Vel,Units per sec,MotionParameters[2].Acc,Units per sec2,MotionParameters[2].Dec,Units per sec2,Trapezoidal,MotionParameters[2].Jerk,MotionParameters[2].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,XIC(MotionInstructions.MAM_Inst[2].PC) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 24
Stop Motion
MAS]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[24])MAS(ServoMotor,MotionInstructions.MAS_Inst[3],All,No,MotionParameters[0].Dec,Units per sec2,No,MotionParameters[0].Jerk,% of Time)XIC(MotionInstructions.MAS_Inst[3].DN)XIC(MotionInstructions.MAS_Inst[3].PC)MOV(25,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 25
Move All The Way Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])[MAM(ServoMotor,MotionInstructions.MAM_Inst[3],MotionConstants.Absolute,MotionPosition.Down,MotionParameters[3].Vel,Units per sec,MotionParameters[3].Acc,Units per sec2,MotionParameters[3].Dec,Units per sec2,Trapezoidal,MotionParameters[3].Jerk,MotionParameters[3].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[3].PC) ,XIC(AtDownPos) ] OTU(StackOnElevatorMemory) XIC(debugBIT.5) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 50
Jog Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[50])MAJ(ServoMotor,MotionInstructions.MAJ_Inst[0],0,MotionParameters[1].Vel,Units per sec,MotionParameters[1].Acc,Units per sec2,MotionParameters[1].Dec,Units per sec2,Trapezoidal,MotionParameters[1].Jerk,MotionParameters[1].Jerk,% of Time,Disabled,Programmed,0,None)[XIO(HMI_ManJogUp.EnableOut) ,XIC(LimitUpper) ]MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 51
Jog Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[51])MAJ(ServoMotor,MotionInstructions.MAJ_Inst[1],1,MotionParameters[1].Vel,Units per sec,MotionParameters[1].Acc,Units per sec2,MotionParameters[1].Dec,Units per sec2,Trapezoidal,MotionParameters[1].Jerk,MotionParameters[1].Jerk,% of Time,Disabled,Programmed,0,None)[XIO(HMI_ManJogDwn.EnableOut) ,XIC(LimitLower) ]MOV(52,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 52
Stop Jog
MAS]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[52])MAS(ServoMotor,MotionInstructions.MAS_Inst[2],Jog,No,MotionParameters[0].Dec,Units per sec2,No,80,% of Time)XIC(MotionInstructions.MAS_Inst[2].DN)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 53
Manual Move To Down Position]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[53])[MAM(ServoMotor,MotionInstructions.MAM_Inst[4],MotionConstants.Absolute,MotionPosition.Down,MotionParameters[0].Vel,Units per sec,MotionParameters[0].Acc,Units per sec2,MotionParameters[0].Dec,Units per sec2,Trapezoidal,MotionParameters[0].Jerk,MotionParameters[0].Jerk,% of Time,Disabled,Programmed,0,None,0,0) ,[XIC(MotionInstructions.MAM_Inst[0].PC) ,XIC(AtDownPos) ] OTU(StackOnElevatorMemory) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[STATE 125
--Faulted--
Stop All Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])[MAS(ServoMotor,MotionInstructions.MAS_Inst[1],All,Yes,80,% of Maximum,No,0,Units per sec3) ,[XIC(MotionInstructions.MAS_Inst[1].ER) ,XIC(MotionInstructions.MAS_Inst[1].PC) ,XIC(MotionInstructions.MAS_Inst[1].DN) ] XIO(ServoMotor.MoveStatus) MOV(126,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 126
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[126])[XIC(ServoMotor.DriveEnableStatus) MSF(ServoMotor,MotionInstructions.MSF_Inst[0]) ,[XIC(MotionInstructions.MSF_Inst[0].DN) ,XIC(MotionInstructions.MSF_Inst[0].ER) ,XIC(AlwaysOn) ] XIO(ServoMotor.DriveEnableStatus) MOV(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 127
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[127])XIO(FaultActive)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(FaultActive)XIO(Status.State[125])XIO(Status.State[126])XIO(Status.State[127])MOV(125,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Axis is stopped]]>
</Comment>
<Text>
<![CDATA[XIO(ServoMotor.MoveStatus)XIO(ServoMotor.JogStatus)XIO(MotionInstructions.MAM_Inst[1].IP)XIO(MotionInstructions.MAM_Inst[2].IP)XIO(MotionInstructions.MAM_Inst[3].IP)XIO(MotionInstructions.MAJ_Inst[4].IP)XIO(MotionInstructions.MAS_Inst[4].IP)OTE(out_Elev_Stopped);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Idle and initialized logic]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])OTE(out_IC_Elev_Idle);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Need to add Servo ready status bit]]>
</Comment>
<Text>
<![CDATA[XIO(FaultActive)OTE(out_Elev_Initd);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[XIC(Status.State[16])ONS(OneShot.2)[GRT(ServoMotor.ActualPosition,HMI_Elev_HiPos) MOV(HMI_Tray3_DropOff,MotionPosition.TrayDropoffCalc) OTL(out_LastTrayInStack) ,LIM(HMI_Elev_LowPos,ServoMotor.ActualPosition,HMI_Elev_HiPos) MOV(HMI_Tray2_DropOff,MotionPosition.TrayDropoffCalc) OTU(out_LastTrayInStack) ,LES(ServoMotor.ActualPosition,HMI_Elev_LowPos) MOV(HMI_Tray1_DropOff,MotionPosition.TrayDropoffCalc) OTU(out_LastTrayInStack) ];]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[Signal the unload that the elevator is clear of the tray to be unloaded]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[12]) ,XIC(Status.State[13]) ,XIC(Status.State[14]) ,[XIC(Status.State[21]) XIC(MotionInstructions.MAM_Inst[2].IP) ,XIC(Status.State[26]) XIC(MotionInstructions.MAM_Inst[1].IP) ] ,XIC(Status.State[22]) ,XIC(Status.State[27]) ]OTE(out_Elev_Clear);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
