<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Fault[1].Active)XIC(\Main.FaultReset)OTU(Fault[1].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines In The Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.PartLoaded) ,XIC(AlwaysOff) XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Permissive For Robot To Pick Part From Dial Nest

NOTE: When the part is picked from the dial the tracking data for the nest is copied to special tracking data for the robot position. For this robot holding position the nest number and station number are the same (Station 21 and Nest 21). See "Tracking" program notes for more information.

\
NOTE: Low limit doesn't really matter since the attempt bit need set by the CamPosChk1, but it should at least be when the dial is approx on station  at 155 Deg.]]>
</Comment>
<Text>
<![CDATA[[[XIO(\Mode.Manual) [Chassis_CamPos_Check(AOI_CamPosChk1,165,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(CycleStation) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) [LIM(155,\Chassis.Status.CamPosDeg,330) ,[XIC(\Mode.CycleStoppingPauseStartup) ,XIC(\Mode.CyclePaused) ] [LIM(155,\Chassis.Status.CamPosDeg,360) ,LIM(0,\Chassis.Status.CamPosDeg,9) ] ] [OTE(\RobotUnload.Outputs.UserOut[1].0) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Good) MOV(1,\RobotUnload.Outputs.UserWord[1]) ,XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Good) MOV(2,\RobotUnload.Outputs.UserWord[1]) ,XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Sample) MOV(3,\RobotUnload.Outputs.UserWord[1]) ] ] ,XIC(\RobotUnload.Inputs.UserIn[1].0) [OTE(\RobotUnload.Outputs.UserOut[2].0) ,ONS(OneShot.1) [XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,AFI() OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.PartLoaded) ,MOV(\Chassis.Status.CamPosDeg,SavedCamPosAtPick) ] ,COP(\Tracking.Data.Nest[NestNumCurrent].PartStatus,\Tracking.Data.Nest[NestNumRobot].PartStatus,1) COP(\Tracking.Data.Nest[NestNumCurrent].ProcessData,\Tracking.Data.Nest[NestNumRobot].ProcessData,1) COP(\Tracking.Data.Nest[NestNumCurrent].ProductData,\Tracking.Data.Nest[NestNumRobot].ProductData,1) ] ] ] ,Chassis_CamPos_Check(AOI_CamPosChk2,8,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(171,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,XIC(AlwaysOn) OTL(Fault[1].Active) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
