<Text>
<![CDATA[[XIC(CHAS_MSO_DialInst.EN) [XIC(CHAS_MSO_DialInst.ER) ,XIO(CHAS_MSO_DialInst.DN) MOV(1000,TmrFlt_DialEnable.PRE) TON(TmrFlt_DialEnable,?,?) XIC(TmrFlt_DialEnable.DN) ] ONS(OneShotFault.1) ,XIC(Fault[1].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[1].Active);]]>
