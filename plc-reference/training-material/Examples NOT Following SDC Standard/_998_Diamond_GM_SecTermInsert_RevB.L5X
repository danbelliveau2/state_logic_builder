<Text>
<![CDATA[[[XIC(MAM_CamFwdUnlkInst.ER) ,XIC(MAM_CamRevUnlkInst.ER) ,XIC(MAM_CamRevToStartInst.ER) ,XIC(MAM_CamFwdToEndInst.ER) ,XIC(MAM_CamStartupInst.ER) ,[XIC(MAM_CamFwdUnlkInst.EN) XIO(MAM_CamFwdUnlkInst.PC) ,XIC(MAM_CamRevUnlkInst.EN) XIO(MAM_CamRevUnlkInst.PC) ,XIC(MAM_CamRevToStartInst.EN) XIO(MAM_CamRevToStartInst.PC) ,XIC(MAM_CamFwdToEndInst.EN) XIO(MAM_CamFwdToEndInst.PC) ,XIC(MAM_CamStartupInst.EN) XIO(MAM_CamStartupInst.PC) ] MOV(16000,TmrFlt_CamResync.PRE) TON(TmrFlt_CamResync,?,?) XIC(TmrFlt_CamResync.DN) ] ONS(OneShotFault.2) ,XIC(Fault[2].Active) XIO(Setup_FaultResetPulse) ]OTE(Fault[2].Active);]]>
</Text>
</Rung>
