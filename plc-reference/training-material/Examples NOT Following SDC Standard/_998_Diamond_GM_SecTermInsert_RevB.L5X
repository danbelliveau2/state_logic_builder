<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[GEQ(ConsecFails.Count,ConsecFails.Setpoint) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIO(\Main.FaultReset) MOV(0,ConsecFails.Count) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_NumericDispEntry(HMI_ConsecFails,AlwaysOn,\Security.Level,5,1,ConsecFails.Setpoint,0,DummyREAL,1,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Fault[1].Active)[[XIC(\Safety.GuardNOK) OTL(GuardOpenedMemory.1) ,XIC(AlwaysOff) XIC(\Main.FaultReset) XIC(GuardOpenedMemory.1) [OTU(Fault[1].Active) ,OTU(GuardOpenedMemory.1) ] ] ,XIC(\Main.FaultReset) XIC(NestClear) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[SensorDebouncer(AOI_SensorDebouncer,IN_NestClear,50,50,NestClear,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(SafeOK)XIC(\Mode.Auto)[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIO(\Tracking.Data.Nest[NestNumCurrent].OpStatus.LockedOut) [[XIC(AlwaysOff) Chassis_PartStatChk_V2_0(AOI_PartStatChk,\Tracking.Data,StaNum,NestNumCurrent,19) ,XIC(AlwaysOn) ] ,XIC(\Tracking.Data.Station[StaNum].OpStatus.ForcedOn) ] XIO(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStation) ,XIC(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Bypass) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Check For Nest Clear]]>
</Comment>
<Text>
<![CDATA[Chassis_CamPos_Check(AOI_CamPosChk1,160,\Chassis.Status.CamPosDeg,0,\Chassis.Status.ActualVelocity)[XIO(\Mode.Manual) XIC(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) [XIC(NestClear) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,MOV(0,ConsecFails.Count) ] ,XIO(NestClear) [OTL(\Tracking.Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOV(2001,\Tracking.Data.Nest[NestNumCurrent].PartStatus.FailureType) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ] ] ,XIO(NestClear) XIC(AlwaysOn) OTL(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Calc and clear data for nests that aren't  going to be recycled. If they are going to be recycled you must clear the attempt/success/failre bits for this station so it will check again next time around

NOTE: This position must be chosen carefully!!.  This position must be a cam position that happens prior to any cam position that the first station needs to start its cycle ("Look ahead" or IncomingNestNum)]]>
</Comment>
<Text>
<![CDATA[Chassis_CamPos_Check(AOI_CamPosChk,300,\Chassis.Status.CamPosDeg,0,\Chassis.Status.ActualVelocity)OTE(\Tracking.CalcAndClearDataBit);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
