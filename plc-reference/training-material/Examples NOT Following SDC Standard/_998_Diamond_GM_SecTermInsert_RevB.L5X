</LocalTag>
<LocalTag Name="BaselineRecordingDone" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Recording Done
Fill in blanks]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ONS_02" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Enable Baseline Test Off ONS]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Keep a running average of the Axis CurrentFeedback
The larger the AVE LEN the more smoothed out the CurrentFeedback will be.
The AVE instruction runs every other scan because it must see an Off-On transition.]]>
</Comment>
<Text>
<![CDATA[LEQ(BaselineAveragingNumOfSamples,200)ADD(CurrentSampleCounter,1,CurrentSampleCounter)MOD(CurrentSampleCounter,BaselineAveragingNumOfSamples,CurrentSampleCounter)MOV(Axis.CurrentFeedback,CurrentSampling[CurrentSampleCounter])MOV(BaselineAveragingNumOfSamples,Baseline_AVE_Control.LEN)XIO(Baseline_AVE_Control.DN)AVE(CurrentSampling,0,AvgCurrent,Baseline_AVE_Control,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Clear the
Baseline Samples Array]]>
</Comment>
<Text>
<![CDATA[XIC(EnableBaselineTestTag)ONS(ONS_01)[COP(Zero[0],BaselineSamples[0],360) ,COP(Zero[0],TorquePositiveLimits[0],360) ,OTU(BaselineTestCompletedTag) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Get a DINT position that can be used as an array index.]]>
</Comment>
<Text>
<![CDATA[TRN(AxisPosDeg,AxisPosDeg_DINT);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Record the Axis Actual Current to the Baseline Samples array.
BaselineSampleValue and BaselineSampleDeg are for exposing those values to the outside for trending.]]>
</Comment>
<Text>
<![CDATA[XIC(EnableBaselineTestTag)[MOV(AvgCurrent,BaselineSamples[AxisPosDeg_DINT]) ,MOV(BaselineSamples[AxisPosDeg_DINT],BaselineSampleValue) ,MOV(AxisPosDeg_DINT,BaselineSampleDeg) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Initialized the BaselineCounter for traversing the BaselineSamples array.]]>
</Comment>
<Text>
<![CDATA[XIO(EnableBaselineTestTag)ONS(ONS_02)[OTL(BaselineRecordingDone) ,MOV(1,BaselineCounter) ,ADD(BaselineSamples[0],LimitPercent_Adder,TorquePositiveLimits[0]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BaselineRecordingDone)[SUB(BaselineCounter,1,BaselineCounterMinus1) NEQ(BaselineSamples[BaselineCounterMinus1],0) EQU(BaselineSamples[BaselineCounter],0) MOV(BaselineSamples[BaselineCounterMinus1],BaselineSamples[BaselineCounter]) ,ADD(BaselineSamples[BaselineCounter],LimitPercent_Adder,TorquePositiveLimits[BaselineCounter]) ,ADD(BaselineCounter,1,BaselineCounter) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(BaselineRecordingDone)EQU(BaselineCounter,360)[OTU(BaselineRecordingDone) ,OTL(BaselineTestCompletedTag) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Set the Positive Torque Limit]]>
</Comment>
<Text>
<![CDATA[[XIC(EnableTorqueLimitingTag) XIC(BaselineTestCompletedTag) MOV(TorquePositiveLimits[AxisPosDeg_DINT],Axis.TorqueLimitPositive) ,[XIO(EnableTorqueLimitingTag) ,XIO(BaselineTestCompletedTag) ] MOV(AdaptiveLimitingOff_TorqueLimit,Axis.TorqueLimitPositive) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Servo_Capacity" Class="Standard" Revision="1.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-01-20T15:55:09.819Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2021-03-29T19:23:58.445Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.02">
<Description>
<![CDATA[Displays Servo Motor/Drive/Converter Capacity for a Kinetix 350 System
NOTE: Set Drive Paramters to Be Read in Axis Properties]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="MotorCapacityPercent" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="ConverterCapacityPercent" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="InverterCapacityPercent" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Servo_Axis" TagType="Base" DataType="AXIS_CIP_DRIVE" Usage="InOut" Required="true" Visible="true"/>
</Parameters>
<LocalTags>
<LocalTag Name="TempREAL" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(EnableIn)GSV(Axis,Servo_Axis,MotorCapacity,TempREAL)MUL(TempREAL,1000,TempREAL)TRN(TempREAL,TempREAL)DIV(TempREAL,1000,MotorCapacityPercent);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(EnableIn)GSV(Axis,Servo_Axis,ConverterCapacity,TempREAL)MUL(TempREAL,1000,TempREAL)TRN(TempREAL,TempREAL)DIV(TempREAL,1000,ConverterCapacityPercent);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(EnableIn)GSV(Axis,Servo_Axis,InverterCapacity,TempREAL)MUL(TempREAL,1000,TempREAL)TRN(TempREAL,TempREAL)DIV(TempREAL,1000,InverterCapacityPercent);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Servo_ManualBrakeToggle_V1_0" Class="Standard" Revision="1.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-09-11T17:38:56.392Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2016-11-07T18:42:59.875Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v29.00">
<Description>
<![CDATA[Use to release and engage brake For Kinextix 350 5500 Drive. Drive must be disabled before trying to release.]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="HMIControlButtonTag" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
