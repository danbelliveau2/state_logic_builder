<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Fault[0].Active)XIC(DoorOpenedMemory)XIC(\Main.FaultReset)OTU(Fault[0].Active)OTU(DoorOpenedMemory)AFI()[COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[14].PartStatus,1) ,COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[15].PartStatus,1) ,COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[16].PartStatus,1) ,COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[17].PartStatus,1) ,COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[18].PartStatus,1) ,COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[19].PartStatus,1) ,COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[20].PartStatus,1) ,COP(\Tracking.ZeroPartAssyStat,\Tracking.Data.Nest[21].PartStatus,1) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Fault[1].Active)XIC(\Main.FaultReset)OTU(Fault[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OKToEnter" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[OK To Enter Logic]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(SafeOK) XIC(Auto) [XIO(CycleRunning) [XIC(CycleStoppingPauseStartup) ,AFI() ] ,XIC(CycleStopping) ] OTE(NOKToEnter) MOV(1,HMI_EnterStatus) ,[XIC(SafeOK) XIC(Auto) XIO(CycleRunning) XIO(CycleStopping) XIO(CycleStoppingPauseStartup) [XIC(AlwaysOn) XIC(AlwaysOn) XIC(AlwaysOn) ,AFI() ] ,XIO(SafeOK) ] OTE(OKToEnter) MOV(2,HMI_EnterStatus) ,XIO(OKToEnter) XIO(NOKToEnter) MOV(0,HMI_EnterStatus) ,[XIC(OKToEnter) ,XIC(NOKToEnter) XIC(\Main.FlashSlow) ] OTE(HMI_EnterVisibility) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PauseCycleLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(CycleStoppingPauseStartup) ,XIC(CycleStopPauseImmed) ,XIC(CyclePaused) ][XIC(\Main.FlashSlow) OTE(HMI_PausedVisibility) ,ONS(OneShot.1) MOV(0,HMI_PausedStatus) ,XIC(PauseCondition1) MOV(1,HMI_PausedStatus) ,XIC(PauseCondition2) MOV(2,HMI_PausedStatus) ,XIC(PauseCondition3) MOV(3,HMI_PausedStatus) ,XIC(PauseCondition4) MOV(4,HMI_PausedStatus) ,XIC(PauseCondition5) MOV(5,HMI_PausedStatus) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Pause For Wire Insert (feeder bowl or robot)]]>
</Comment>
<Text>
<![CDATA[XIC(Auto)XIC(\HMI.ProductionEnable)XIC(\Tracking.Data.Nest[NestNumBobbin].PartStatus.Station[1].Attempt)XIO(\Tracking.Data.Nest[NestNumBobbin].PartStatus.Station[1].Failure)XIO(\Tracking.Data.Nest[NestNumBobbin].PartStatus.Station[1].Success)AFI()OTE(PauseCondition1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Pause For Unload Robot (Tray stacker not ready)]]>
</Comment>
<Text>
<![CDATA[XIC(Auto)XIC(\Tracking.Data.Nest[NestNumUnld].PartStatus.Station[17].Attempt)XIO(\Tracking.Data.Nest[NestNumUnld].PartStatus.Station[17].Failure)XIO(\Tracking.Data.Nest[NestNumUnld].PartStatus.Station[17].Success)OTE(PauseCondition2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Pause For xxxxxxxx]]>
</Comment>
<Text>
<![CDATA[XIC(Auto)XIC(AlwaysOff)OTE(PauseCondition3);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Pause For xxxxxxxx]]>
</Comment>
<Text>
<![CDATA[XIC(Auto)XIC(AlwaysOff)OTE(PauseCondition4);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Pause For xxxxxxxxx]]>
</Comment>
<Text>
<![CDATA[XIC(Auto)XIC(AlwaysOff)OTE(PauseCondition5);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(CyclePaused)XIC(Auto)[XIC(PauseCondition1) ,XIC(PauseCondition2) ,XIC(PauseCondition3) ,XIC(PauseCondition4) ,XIC(PauseCondition5) ]MOV(240000,TmrFlt_ExcessivePause.PRE)TON(TmrFlt_ExcessivePause,?,?)XIC(TmrFlt_ExcessivePause.DN)OTL(Fault[1].Active);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines Within The Current Program]]>
</Comment>
<Text>
<![CDATA[JSR(FaultsWarnings,0)JSR(PauseCycleLogic,0)JSR(OKToEnter,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[[XIC(CycleRunning) ,XIC(CycleStopPauseImmed) ,XIC(CycleStoppingPauseStartup) ,XIC(CyclePaused) ] ,XIC(CycleStarting) XIC(\Main.FlashFast) ,[XIC(AutoJoggingReady) ,XIC(CycleLatchIn) ] XIC(\Main.FlashVeryFast) ,XIC(AutoJogging) ]OTE(OUT_CycleStartPBL);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(CycleLatchIn)XIO(IN_CycleStopPB)OTU(CycleLatchIn);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off
(Clear HMI Auto/Manual Mode Button)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[OTU(Auto) OTU(CycleRunning) OTU(CycleLatchIn) ,XIC(SafeOK) [XIO(AutoModeMemory) MOV(4,Control.StateReg) ,XIC(AutoModeMemory) XIO(\Chassis.Status.ReadyHandCrank) XIO(\Chassis.Status.ResyncRequired) XIO(\Chassis.Status.ResyncInProgress) MOV(5,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 4
Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[OTE(Manual) OTU(Auto) OTU(CycleRunning) OTU(CycleLatchIn) OTU(AutoModeMemory) OTU(HMI_EnableCycleStartJog) ,ONS(ManualOS) OTE(ManualPulse) ,XIC(HMI_AutoMode) XIO(\Chassis.Status.ReadyHandCrank) XIO(\Main.FaultActive) XIO(\Chassis.Status.ResyncRequired) XIO(\Chassis.Status.ResyncInProgress) MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 5
Auto Mode
-Clear Manual Mode Bits]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])[OTE(CycleStopped) OTU(CycleRunning) OTL(Auto) OTL(AutoModeMemory) ,ONS(AutoOS) OTE(AutoPulse) ,XIO(\Chassis.Status.ResyncRequired) XIC(\Alarms.NoMachineFaults) [XIC(\Chassis.Status.ReadyCycleStart) OTE(CycleLatchCapable) OTU(Warning[4].Active) [XIO(HMI_EnableCycleStartJog) [XIC(IN_CycleStartPB) ,XIC(CycleLatchIn) ] MOV(6,Control.StateReg) ,XIC(HMI_EnableCycleStartJog) OTE(AutoJoggingReady) OTU(CycleLatchIn) XIC(IN_CycleStartPB) MOV(15,Control.StateReg) ] ,XIO(\Chassis.Status.ReadyCycleStart) XIO(HMI_EnableCycleStartJog) XIC(IN_CycleStartPB) OTL(Warning[4].Active) ] ,[XIO(HMI_AutoMode) ,XIC(\Main.FaultActive) ,XIC(\Chassis.Status.ResyncRequired) ,[XIC(\Chassis.Status.ReadyHandCrank) ,XIC(AlwaysOn) AFI() TON(AutoTimeoutTmr,?,?) XIC(AutoTimeoutTmr.DN) OTE(SwitchManOS) ] OTU(HMI_AutoMode) ] MOV(4,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 6
Cycle Starting
-Stack Light Flashing Green]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])[OTE(CycleStarting) OTU(CycleLatchIn) ,MOV(PresetCycleStarting,CycleStartTmr.PRE) TON(CycleStartTmr,?,?) XIC(CycleStartTmr.DN) MOV(7,Control.StateReg) ,XIC(\Chassis.Status.AtStartStopPos) [XIC(PauseCondition1) ,XIC(PauseCondition2) ,XIC(PauseCondition3) ,XIC(PauseCondition4) ,XIC(PauseCondition5) ] MOV(10,Control.StateReg) ,[XIO(HMI_AutoMode) ,XIO(\Alarms.NoMachineFaults) ,XIO(IN_CycleStopPB) ] MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 7
Cycle Running

NOTE: Make sure the check position for pausing is before the position you check to stop the chassis at its programmed Startup position (\Chassis.StartupPosLL)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])[OTL(CycleRunning) ,[XIO(HMI_AutoMode) ,XIO(\Alarms.NoMachineFaults) ,XIO(IN_CycleStopPB) ,XIC(\HMI.PurgeComplete) ] MOV(8,Control.StateReg) ,Chassis_CamPos_Check(AOI_CamPosChk1,345,\Chassis.Status.CamPosDeg,1,\Chassis.Status.ActualVelocity) [XIC(\HMI.ProductionEnable) XIC(PauseCondition1) ,XIC(PauseCondition2) ,XIC(PauseCondition3) ,XIC(PauseCondition4) ,XIC(PauseCondition5) ] MOV(9,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 8
Cycle Stopping]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])OTE(CycleStopping)MOV(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 9
Cycle Stopping At Startup Position For Cycle Pause

NOTE: Turning Off CycleRunning will cause the Chassis to stop at Cycle Startup Position (\Chassis.Setup_CamStartupPosDeg)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[9])OTU(CycleRunning)[OTE(CycleStoppingPauseStartup) XIO(\Chassis.Status.MovingStartStopPos) XIO(\Chassis.Status.Running) XIO(\Chassis.Status.Stopping) XIO(\Chassis.Status.Jogging) MOV(10,Control.StateReg) ,[XIO(HMI_AutoMode) ,XIO(\Alarms.NoMachineFaults) ,XIO(IN_CycleStopPB) ,XIC(\HMI.PurgeComplete) ] MOV(8,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 10
Cycle Paused (At Machine Startup Position)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])OTU(CycleRunning)[OTE(Warning[1].Active) OTE(CyclePaused) XIO(PauseCondition1) XIO(PauseCondition2) XIO(PauseCondition3) XIO(PauseCondition4) XIO(PauseCondition5) XIC(\RobotBobbin.ClearOfMainDial) XIC(\RobotUnload.ClearOfMainDial) MOV(6,Control.StateReg) ,[XIO(HMI_AutoMode) ,XIO(\Alarms.NoMachineFaults) ,XIO(IN_CycleStopPB) ,XIC(\HMI.PurgeComplete) ] MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 11
Cycle Pause - Stop Immediately

NOTE: Chassis Immediately Stops]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[11])OTU(CycleRunning)OTE(\Chassis.Control.ImmedPause)[OTE(CycleStopPauseImmed) XIO(\Chassis.Status.Running) XIO(\Chassis.Status.Stopping) XIO(\Chassis.Status.Jogging) MOV(6,Control.StateReg) ,[XIO(HMI_AutoMode) ,XIO(\Alarms.NoMachineFaults) ,XIO(IN_CycleStopPB) ,XIC(\HMI.PurgeComplete) ] MOV(8,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 15
Auto Jogging]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTE(AutoJogging) OTE(\Chassis.Control.AutoJogChassis) OTU(CycleLatchIn) ,[XIO(\Chassis.Control.JogChassis) XIO(IN_CycleStartPB) ,XIO(\Alarms.NoMachineFaults) ,XIO(\Alarms.NoCriticalMachineFaults) ] MOV(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
