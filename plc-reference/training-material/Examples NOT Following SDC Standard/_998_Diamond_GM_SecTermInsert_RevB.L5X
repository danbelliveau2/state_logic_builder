<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<Description>
<![CDATA[Logic For Fault and Warning Messages]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_StripAdvanceExt) XIO(IN_StripAdvanceExtd) ,XIC(OUT_StripAdvanceRet) XIC(IN_StripAdvanceExtd) ] TON(TmrFlt_StripAdvance,?,?) XIC(TmrFlt_StripAdvance.DN) OTL(Fault[0].Active) ,XIC(Fault[0].Active) XIC(\Main.FaultReset) OTU(Fault[0].Active) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_ShearCylsUp) XIO(IN_Shear1Up) ,XIC(OUT_ShearCylsDwn) XIO(IN_Shear1Dn) ] TON(TmrFlt_Shear1,?,?) XIC(TmrFlt_Shear1.DN) OTL(Fault[1].Active) ,XIC(Fault[1].Active) XIC(\Main.FaultReset) OTU(Fault[1].Active) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_ShearCylsUp) XIO(IN_Shear2Up) ,XIC(OUT_ShearCylsDwn) XIO(IN_Shear2Dn) ] TON(TmrFlt_Shear2,?,?) XIC(TmrFlt_Shear2.DN) OTL(Fault[2].Active) ,XIC(Fault[2].Active) XIC(\Main.FaultReset) OTU(Fault[2].Active) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_StripHoldCylsDwn) XIC(IN_StripHold1Up) ,XIC(OUT_StripHoldCylsUp) XIO(IN_StripHold1Up) ] TON(TmrFlt_Hold1,?,?) XIC(TmrFlt_Hold1.DN) OTL(Fault[3].Active) ,XIC(Fault[3].Active) XIC(\Main.FaultReset) OTU(Fault[3].Active) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) XIC(SafeOK) [XIC(OUT_StripHoldCylsDwn) XIC(IN_StripHold2Up) ,XIC(OUT_StripHoldCylsUp) XIO(IN_StripHold2Up) ] TON(TmrFlt_Hold2,?,?) XIC(TmrFlt_Hold2.DN) OTL(Fault[4].Active) ,XIC(Fault[4].Active) XIC(\Main.FaultReset) OTU(Fault[4].Active) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Fault[5].Active)[XIC(\Main.FaultReset) ,XIC(HMI_OpenReelChange.Trigger) ]OTU(Fault[5].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Fault[6].Active)XIC(\Main.FaultReset)OTU(Fault[6].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed) GEQ(DieMaint.Count,DieMaint.Setpoint) OTE(Warning[0].Active) [XIC(\Main.FlashFast) MOV(2,DieMaint.HMIColorStatus) ,XIO(\Main.FlashFast) MOV(1,DieMaint.HMIColorStatus) ] ,LES(DieMaint.Count,DieMaint.Setpoint) MOV(4,DieMaint.HMIColorStatus) ,HMI_NumDispEntryCountGen(HMI_DieMaint,DieMaint,1,1,1,2000,\Security.Level,5) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,\Main.CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ManualControl" Type="RLL">
<Description>
<![CDATA[Logic For Manual Control From HMI Buttons]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Manual Control Logic]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_ManStripAdvance,0,OUT_StripAdvanceExt,OUT_StripAdvanceRet,1,0,IN_StripAdvanceExtd,0,\Mode.Manual,0,\Security.Level,0) ,XIC(\DiodeTransfer.AtCutPos) XIC(\DiodeTransfer.OUT_GripperUp) OTE(HMI_ManStripAdvance.InterlockActive) ][HMI_OutTog(HMI_ManHold,0,OUT_StripHoldCylsDwn,OUT_StripHoldCylsUp,0,1,0,PosBInputHold,\Mode.Manual,0,\Security.Level,0) ,XIC(IN_StripHold1Up) XIC(IN_StripHold2Up) OTE(PosBInputHold) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[HMI_OutTog(HMI_ManShear,0,OUT_ShearCylsDwn,OUT_ShearCylsUp,1,1,PosAInputShear,PosBInputShear,\Mode.Manual,0,\Security.Level,0) ,XIC(IN_Shear1Up) XIC(IN_Shear1Up) OTE(PosBInputShear) ,XIC(IN_Shear1Dn) XIC(IN_Shear2Dn) OTE(PosAInputShear) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ReelChange" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[For some reason, the reel change button is not visible when on the main screen. Even though ButtonVisibility is true. This needs figured out. W.E.H. 11/9/2022]]>
</Comment>
<Text>
<![CDATA[[[XIC(Fault[5].Active) ,XIO(Fault[5].Active) EQU(\HMI.CurrentScreenNum,1) ] OTE(ButtonVisibility) ,HMI_OpnPopup(HMI_OpenReelChange,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,57,ButtonVisibility,\Security.Level,0) ,XIC(HMI_OpenReelChange.Trigger) [ONS(OneShot.3) OTL(ReelChangeActive) ,XIC(Fault[5].Active) OTU(Fault[5].Active) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(HMI_NewReelLoaded)ONS(OneShot.4)OTL(NewReelLoadedStatus);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[HMI_OutMom(HMI_MakeDiodes,0,1,0,0,\Mode.Manual,GreyoutMakeDiodes,\Security.Level,0,1) OTL(MakeDiodesActive) ,[XIC(ReelChangeActive) ,XIC(NewReelLoadedStatus) ] OTE(GreyoutMakeDiodes) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Calls To Other Routines]]>
</Comment>
<Text>
<![CDATA[JSR(ManualControl,0)JSR(FaultsWarnings,0)JSR(ReelChange,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[****MISCELLANEOUS LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[HMI_OpnPopup(HMI_OpenReelChange,\HMI.ReplaceScreenNum,\HMI.CurrentPopupNum,57,Fault[5].Active,\Security.Level,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[SensorDebouncer(AOI_SensorDebouncerStrip,IN_StripBluePresent,50,50,StripBluePresent,0)SensorDebouncer(AOI_SensorDebouncerDiode,IN_DiodePresent,50,50,DiodePresent,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])XIC(SafeOK)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 10
Ready / Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIO(ReelChangeActive)XIC(\Mode.Auto)XIO(\Tracking.Data.Station[StaNum].OpStatus.Bypassed)[XIC(IN_Shear1Up) XIC(IN_Shear2Up) [XIC(OUT_StripHoldCylsDwn) ,XIC(AlwaysOn) ] [XIC(IN_StripBluePresent) [XIC(DiodePresent) [XIC(IN_StripAdvanceExtd) ,XIC(OUT_StripAdvanceRet) ] [OTE(ReadyToCut) ,XIC(\DiodeTransfer.GrippedAtCut) MOV(11,Control.StateReg) ] ,XIO(DiodePresent) XIC(\DiodeTransfer.ClearOfICutter) [XIC(OUT_StripAdvanceRet) MOV(15,Control.StateReg) ,XIC(IN_StripAdvanceExtd) TON(TmrFlt_DiodeNotPresent,?,?) XIC(TmrFlt_DiodeNotPresent.DN) [OTL(Fault[6].Active) ,OTL(OUT_StripHoldCylsUp) OTU(OUT_StripHoldCylsDwn) ] ] ,XIO(IN_StripAdvanceExtd) XIO(OUT_StripAdvanceRet) MOV(41,Control.StateReg) ] ,XIO(IN_StripBluePresent) OTL(Fault[5].Active) ] ,[XIO(IN_Shear1Up) ,XIO(IN_Shear2Up) ,XIC(AlwaysOff) XIO(OUT_StripHoldCylsDwn) ] MOV(40,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])[XIC(\Mode.Manual) XIC(\DiodeTransfer.ClearOfICutter) XIO(NewReelLoadedStatus) XIC(MakeDiodesActive) [XIC(OUT_StripAdvanceRet) MOV(15,Control.StateReg) ,XIC(IN_StripAdvanceExtd) [XIC(IN_StripHold1Up) XIC(IN_StripHold2Up) MOV(11,Control.StateReg) ,[XIO(IN_StripHold1Up) ,XIO(IN_StripHold2Up) ] MOV(44,Control.StateReg) ] ] ,XIC(ReelChangeActive) XIC(NewReelLoadedStatus) XIC(DiodePresent) XIC(IN_StripAdvanceExtd) XIC(IN_StripHold1Up) XIC(IN_StripHold2Up) MOV(53,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 11
-Strip Hold 1 & 2 Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[11])[OTL(OUT_StripHoldCylsDwn) OTU(OUT_StripHoldCylsUp) ,MOV(80,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIO(IN_StripHold1Up) XIO(IN_StripHold2Up) MOV(12,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 12
-Shear Cylinders Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[12])[OTL(OUT_ShearCylsDwn) OTU(OUT_ShearCylsUp) ,ONS(OneShot.11) ADD(DieMaint.Count,1,DieMaint.Count) ,MOV(150,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_Shear1Dn) XIC(IN_Shear2Dn) MOV(13,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 13
-Shear Cylinder 1 & 2 Up
-Diode Cut Handshake Bit]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])[OTE(DiodeCutFromStrip) ,OTL(OUT_ShearCylsUp) OTU(OUT_ShearCylsDwn) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_Shear1Up) XIC(IN_Shear2Up) MOV(14,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 14
-Strip Advance Retract]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[14])[OTL(OUT_StripAdvanceRet) OTU(OUT_StripAdvanceExt) ,MOV(300,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIO(IN_StripAdvanceExtd) MOV(15,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 15
-Strip Hold 1 & 2 Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[OTL(OUT_StripHoldCylsUp) OTU(OUT_StripHoldCylsDwn) ,MOV(80,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_StripHold1Up) XIC(IN_StripHold2Up) MOV(16,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 16
Strip Advance Extend]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])[OTL(OUT_StripAdvanceExt) OTU(OUT_StripAdvanceRet) ,MOV(300,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_StripAdvanceExtd) OTU(MakeDiodesActive) [XIC(DiodePresent) MOV(10,Control.StateReg) ,XIO(DiodePresent) TON(TmrFlt_DiodeNotPresent2,?,?) XIC(TmrFlt_DiodeNotPresent2.DN) OTL(Fault[6].Active) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATE 40
--Recovery--

-Shear Cylinder 1 & 2 Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[40])[OTL(OUT_ShearCylsUp) OTU(OUT_ShearCylsDwn) ,MOV(100,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_Shear1Up) XIC(IN_Shear2Up) MOV(43,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 41
--Recovery--

-Strip Hold 1 & 2 Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[41])[OTL(OUT_StripHoldCylsUp) OTU(OUT_StripHoldCylsDwn) ,MOV(80,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_StripHold1Up) XIC(IN_StripHold2Up) MOV(42,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 42
--Recovery--
Strip Advance Extend]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[42])[OTL(OUT_StripAdvanceExt) OTU(OUT_StripAdvanceRet) ,MOV(180,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_StripAdvanceExtd) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 43   (Currently Not Used 4/28/2023   W.E.H.)
--Recovery--
-Strip Hold 1 & 2 Down]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[43])[OTL(OUT_StripHoldCylsDwn) OTU(OUT_StripHoldCylsUp) ,MOV(40,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIO(IN_StripHold1Up) XIO(IN_StripHold2Up) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 44
--Recovery--
-Strip Hold 1 & 2 Up]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[44])[OTL(OUT_StripHoldCylsUp) OTU(OUT_StripHoldCylsDwn) ,MOV(80,Control.TransitionTime) ,XIC(Status.TransitionTimerDone) XIC(IN_StripHold1Up) XIC(IN_StripHold2Up) MOV(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 53
--Reel Change--

Clear Reel Change Bits]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[53])OTU(ReelChangeActive)OTU(NewReelLoadedStatus)MOV(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 125
--Faulted--
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[125])XIO(FaultActive)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(FaultActive)MOV(125,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIO(SafeOK)MOV(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[****STATE LOGIC ENGINE****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[State_Engine_128Max(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
