<Structure DataType="AMP_Status_Word">
<DataValueMember Name="Enabled" DataType="BOOL" Value="0"/>
<DataValueMember Name="Sampling" DataType="BOOL" Value="0"/>
<DataValueMember Name="Drive_Fault" DataType="BOOL" Value="0"/>
<DataValueMember Name="In_Position" DataType="BOOL" Value="0"/>
