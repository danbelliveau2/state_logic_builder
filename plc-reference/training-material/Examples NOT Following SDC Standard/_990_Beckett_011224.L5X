<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(BoxShift_SM.Status.State[2])XIC(CycleStartLatch)XIC(PackoutLockout)MOV(61,BoxShift_SM.Control.StateReg);]]>
