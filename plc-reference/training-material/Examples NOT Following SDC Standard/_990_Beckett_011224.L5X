</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIC(TfrConveyor_MAM.IP)XIC(TfrConvCount1_PE)[CTU(TfrConveyor_SM.Control.Counter[0],?,?) ,XIC(BinSelected) [LIM(0.1,AOI_TfrConveyorPosition.Fraction,0.2) OTL(TfrConveyor_SM.Control.Bit[8]) ,LIM(0.72,AOI_TfrConveyorPosition.Fraction,0.82) OTL(TfrConveyor_SM.Control.Bit[9]) ] ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(TfrConveyor_SM.Status.State[9])XIC(UnloadStatus[3].S1Attempt)XIO(TfrConveyor_SM.Control.Bit[5])[[NEQ(TfrConveyor_SM.Control.Counter[0].ACC,1) ,XIO(TfrConveyor_SM.Control.Bit[8]) ,XIO(TfrConveyor_SM.Control.Bit[9]) ] CTU(TfrConveyor_SM.Control.Counter[1],?,?) ,EQU(TfrConveyor_SM.Control.Counter[0].ACC,1) XIC(TfrConveyor_SM.Control.Bit[8]) XIC(TfrConveyor_SM.Control.Bit[9]) RES(TfrConveyor_SM.Control.Counter[1]) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Shift All Tracking Data]]>
