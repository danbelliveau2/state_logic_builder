<Routine Name="ComFaults_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[EIP Communication Faults]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.MotionUpCP)[XIO(AOI_s01Indexer_EIP.ComOK) ALMD(Com_1,0,FaultReset_PB,0,1) ,XIO(AOI_s02S17XAxis_EIP.ComOK) ALMD(Com_2,0,FaultReset_PB,0,1) ,XIO(AOI_s03S17YAxis_EIP.ComOK) ALMD(Com_3,0,FaultReset_PB,0,1) ,XIO(AOI_s04Conveyor_EIP.ComOK) ALMD(Com_4,0,FaultReset_PB,0,1) ,XIO(AOI_s05BSXAxis_EIP.ComOK) ALMD(Com_5,0,FaultReset_PB,0,1) ,XIO(AOI_s06BSYAxis_EIP.ComOK) ALMD(Com_6,0,FaultReset_PB,0,1) ,XIO(AOI_s07TSXAxis_EIP.ComOK) ALMD(Com_7,0,FaultReset_PB,0,1) ,XIO(AOI_s08TSYAxis_EIP.ComOK) ALMD(Com_8,0,FaultReset_PB,0,1) ,XIO(AOI_v01BSConv_EIP.ComOK) ALMD(Com_9,0,FaultReset_PB,0,1) ,XIO(AOI_v02TSConv_EIP.ComOK) ALMD(Com_10,0,FaultReset_PB,0,1) ,XIO(AOI_v03InsertIncline_EIP.ComOK) ALMD(Com_11,0,FaultReset_PB,0,1) ,XIO(AOI_v04InsertConv_EIP.ComOK) ALMD(Com_12,0,FaultReset_PB,0,1) ,XIO(AOI_r01BS_EIP.ComOK) ALMD(Com_13,0,FaultReset_PB,0,1) ,XIO(AOI_r02TS_EIP.ComOK) ALMD(Com_14,0,FaultReset_PB,0,1) ,XIO(AOI_r03Insert_EIP.ComOK) ALMD(Com_15,0,FaultReset_PB,0,1) ,XIO(AOI_r04Unload_EIP.ComOK) ALMD(Com_16,0,FaultReset_PB,0,1) ,XIO(AOI_r05Packaging_EIP.ComOK) ALMD(Com_17,0,FaultReset_PB,0,1) ,XIO(AOI_io01BS_EIP.ComOK) ALMD(Com_18,0,FaultReset_PB,0,1) ,XIO(AOI_io02TS_EIP.ComOK) ALMD(Com_19,0,FaultReset_PB,0,1) ,XIO(AOI_KeyenceProbes_EIP.ComOK) ALMD(Com_20,0,FaultReset_PB,0,1) ,XIO(AOI_ValveBank_EIP.ComOK) ALMD(Com_21,0,FaultReset_PB,0,1) ,XIO(AOI_InsertStepper_EIP.ComOK) ALMD(Com_22,0,FaultReset_PB,0,1) ,XIO(AOI_TelesisLaser_EIP.ComOK) ALMD(Com_23,0,FaultReset_PB,0,1) ,XIO(AOI_c01InsertInspect_EIP.ComOK) ALMD(Com_24,0,FaultReset_PB,0,1) ,XIO(AOI_s09ShotPin_EIP.ComOK) ALMD(Com_25,0,FaultReset_PB,0,1) ,XIO(AOI_c02LaserInspect_EIP.ComOK) ALMD(Com_26,0,FaultReset_PB,0,1) ,XIO(AOI_c03OrificeInspect_EIP.ComOK) ALMD(Com_27,0,FaultReset_PB,0,1) ,XIO(AOI_c04PressInspect_EIP.ComOK) ALMD(Com_28,0,FaultReset_PB,0,1) ,XIO(AOI_KeyenceLaser_EIP.ComOK) ALMD(Com_29,0,FaultReset_PB,0,1) ,XIO(AOI_sc01BannerMC_EIP.ComOK) ALMD(Com_30,0,FaultReset_PB,0,1) ,XIO(AOI_sc02BannerBS_EIP.ComOK) ALMD(Com_31,0,FaultReset_PB,0,1) ,XIO(AOI_sc03BannerTS_EIP.ComOK) ALMD(Com_32,0,FaultReset_PB,0,1) ];]]>
</Text>
</Rung>
