<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Input Assembly
Take the cyclic data collected from the drive and breaks it down into variable to be used in the program
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Create readable local copy of the input assembly and status]]>
</Comment>
<Text>
<![CDATA[COP(Input[0],Output,1)COP(Loc_Input_Assembly.Status_Code,Loc_StatusCode,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Status Word]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Status_Code,Status_Code);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Alarm Word]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Alarm_Code,Alarm_Code);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Supply Voltage]]>
</Comment>
<Text>
<![CDATA[DIV(Output.Voltage,10.0,Voltage);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Actual Current]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Current,Current);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Drive Temp]]>
</Comment>
<Text>
<![CDATA[DIV(Output.Temp,10.0,Temp);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Encoder Position]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Encoder_Position,Encoder_Position);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Absolute Position]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Absolute_Position,Absolute_Position);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Position Error]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Position_Error,Position_Error);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Velocity]]>
</Comment>
<Text>
<![CDATA[DIV(Output.Actual_Velocity,240.0,Actual_Velocity);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Input Status Extended]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Extended_Inputs,Extended_Inputs);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Input Status Main]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Main_Board_Inputs,Main_Board_Inputs);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Analog Input 1]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Analog_Input_1,Analog_Input_1);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Analog Input 2]]>
</Comment>
<Text>
<![CDATA[MOV(Output.Analog_Input_2,Analog_Input_2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AMP_Motor_Disable" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-11-16T21:13:24.555Z" CreatedBy="VM-RS2015-W7XX\Grantek" EditedDate="2018-03-21T18:42:08.461Z" EditedBy="VM-RS2015-W7XX\Grantek" SoftwareRevision="v20.04"
