</DefaultData>
</Parameter>
<Parameter Name="HD" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Hard Stop Fault Delay (ms)]]>
</Description>
<DefaultData Format="L5K">
