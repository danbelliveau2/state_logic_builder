</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.0)XIC(Axis.ServoActionStatus)MOV(1,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(TorqueHome_SW.1) MSF(Axis,Axis_MSF) ,XIC(TorqueHome_SW.0) ]XIO(Axis.ServoActionStatus)MOV(2,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.2)[SSV(Axis,Axis,TorqueLimitNegative,HomingTorque) ,SSV(Axis,Axis,OvertorqueLimit,OvertorqueLimit) ,MOV(0.1,OvertorqueLimitTime) SSV(Axis,Axis,OvertorqueLimitTime,OvertorqueLimitTime) ,MOV(0,SoftOTCheck) SSV(Axis,Axis,SoftTravelLimitChecking,SoftOTCheck) ]MOV(100,TorqueHome_ST2_TMR.PRE)TON(TorqueHome_ST2_TMR,?,?)XIC(TorqueHome_ST2_TMR.DN)MOV(3,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.3)MSO(Axis,Axis_MSO)XIC(Axis.ServoActionStatus)MOV(4,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.4)MAJ(Axis,Axis_MAJ,HomeDirection,HomingSpeed,Units per sec,50,Units per sec2,50,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None)XIC(Axis_MAJ.IP)MOV(5,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.5)[XIC(Axis.OvertorqueLimitFault) ,XIC(Axis.ExcessivePositionErrorFault) ]XIO(Axis.ServoActionStatus)MOV(6,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.6)MAFR(Axis,Axis_MAFR)EQU(Axis.AxisFault,0)[SSV(Axis,Axis,TorqueLimitNegative,RunTorque) ,MOV(0,OvertorqueLimitTime) SSV(Axis,Axis,OvertorqueLimitTime,OvertorqueLimitTime) ,MOV(1,SoftOTCheck) SSV(Axis,Axis,SoftTravelLimitChecking,SoftOTCheck) ]MOV(1000,TorqueHome_ST6A_TMR.PRE)TON(TorqueHome_ST6A_TMR,?,?)XIC(TorqueHome_ST6A_TMR.DN)MOV(7,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.7)MSO(Axis,Axis_MSO)XIC(Axis.ServoActionStatus)MOV(8,TorqueHome_CS)GSV(Axis,Axis,PositionScalingNumerator,AxisScalingNumerator);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.8)[EQU(AxisScalingNumerator,360.0) MOV(15.0,OffsetMoveSpeed) ,NEQ(AxisScalingNumerator,360.0) MOV(1.0,OffsetMoveSpeed) ]MAM(Axis,Axis_MAM,1,HomeOffsetDist,OffsetMoveSpeed,Units per sec,150,Units per sec2,150,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0)XIC(Axis_MAM.PC)MOV(250,PosSettleTimer.PRE)TON(PosSettleTimer,?,?)XIC(PosSettleTimer.DN)MOV(10,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[AFI()XIC(TorqueHome_SW.9)MSF(Axis,Axis_MSF)XIO(Axis.ServoActionStatus)MOV(10,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.10)MAH(Axis,Axis_MAH)XIC(Axis_MAH.PC)MOV(11,TorqueHome_CS)OTL(PC);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(TorqueHomeSC)[[XIC(TorqueHome_SW.1) ,XIC(TorqueHome_SW.2) ,XIC(TorqueHome_SW.3) ,XIC(TorqueHome_SW.4) ,XIC(TorqueHome_SW.6) ,XIC(TorqueHome_SW.7) ,XIC(TorqueHome_SW.9) ,XIC(TorqueHome_SW.10) ] MOV(2000,FaultTimer.PRE) ,XIC(TorqueHome_SW.5) MOV(60000,FaultTimer.PRE) ,XIC(TorqueHome_SW.8) MOV(5000,FaultTimer.PRE) ]TON(FaultTimer,?,?)XIC(FaultTimer.DN)[SSV(Axis,Axis,TorqueLimitNegative,RunTorque) ,MOV(0,OvertorqueLimitTime) SSV(Axis,Axis,OvertorqueLimitTime,OvertorqueLimitTime) ,MOV(1,SoftOTCheck) SSV(Axis,Axis,SoftTravelLimitChecking,SoftOTCheck) ]MOV(31,TorqueHome_CS)[OTL(Error) ,MAS(Axis,Axis_MAS,All,Yes,150,Units per sec2,No,0,Units per sec3) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[CLR(TorqueHome_SW) ,OTE(TorqueHome_SW.[TorqueHome_CS]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[NEQ(TorqueHome_CS,TorqueHome_CS_Pre)MOV(TorqueHome_CS,TorqueHome_CS_Pre)OTE(TorqueHomeSC);]]>
</Text>
</Rung>
