<![CDATA[COP(StationData[14],StationData[15],1);]]>
</Line>
<Line Number="97">
<![CDATA[COP(StationData[13],StationData[14],1);]]>
</Line>
<Line Number="98">
<![CDATA[COP(StationData[12],StationData[13],1);]]>
</Line>
<Line Number="99">
<![CDATA[COP(StationData[11],StationData[12],1);]]>
</Line>
<Line Number="100">
<![CDATA[COP(StationData[10],StationData[11],1);]]>
</Line>
<Line Number="101">
<![CDATA[COP(StationData[9],StationData[10],1);]]>
</Line>
<Line Number="102">
<![CDATA[COP(StationData[8],StationData[9],1);]]>
</Line>
