</DefaultData>
</Parameter>
<Parameter Name="HA3" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Accel when searching for encoder index if desired (rev/s/s)]]>
</Description>
<DefaultData Format="L5K">
