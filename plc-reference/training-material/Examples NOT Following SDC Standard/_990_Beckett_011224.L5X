<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(TfrConveyor_SM.Status.State[10])MOV(11,TfrConveyor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(TfrConveyor_SM.Status.State[2]) XIC(CycleStartLatch) [XIC(UnloadStatus[5].S1Success) XIC(UnloadStatus[5].S5Attempt) ,XIO(UnloadStatus[5].S1Success) ] ,XIC(TfrConveyor_SM.Status.State[40]) XIC(PackRobot_SM.Control.Bit[2]) ][NEQ(UnloadRobot_SM.Control.Counter[0].ACC,0) NEQ(UnloadRobot_SM.Control.Counter[0].ACC,5) [XIC(TfrConveyor_SM.Control.Bit[0]) MOV(9,TfrConveyor_SM.Control.StateReg) ,XIO(TfrConveyor_SM.Control.Bit[0]) MOV(18,TfrConveyor_SM.Control.StateReg) OTL(UnloadRobot_Index_Shift_Fix) ] ,[EQU(UnloadRobot_SM.Control.Counter[0].ACC,0) ,EQU(UnloadRobot_SM.Control.Counter[0].ACC,5) ] MOV(18,TfrConveyor_SM.Control.StateReg) ];]]>
