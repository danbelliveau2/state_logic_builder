<DataValue DataType="DINT" Radix="Decimal" Value="10"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Loc_StatusCode" DataType="AMP_Status_Word" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[[0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="AMP_Status_Word">
<DataValueMember Name="Enabled" DataType="BOOL" Value="0"/>
<DataValueMember Name="Sampling" DataType="BOOL" Value="0"/>
<DataValueMember Name="Drive_Fault" DataType="BOOL" Value="0"/>
<DataValueMember Name="In_Position" DataType="BOOL" Value="0"/>
<DataValueMember Name="Moving" DataType="BOOL" Value="0"/>
<DataValueMember Name="Jogging" DataType="BOOL" Value="0"/>
<DataValueMember Name="Stopping" DataType="BOOL" Value="0"/>
<DataValueMember Name="Waiting" DataType="BOOL" Value="0"/>
<DataValueMember Name="Saving" DataType="BOOL" Value="0"/>
