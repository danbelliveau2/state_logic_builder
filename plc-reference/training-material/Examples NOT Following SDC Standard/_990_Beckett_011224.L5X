<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(IP)OTU(IP);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(EnableIn)XIO(IP)[CLR(Recipe_CS) ,OTL(IP) ,OTU(PC) ,OTU(Error) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.0)XIC(Ready)MOV(1,Recipe_CS)MOV(8,Command);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.1)EQU(Echo,8)XIO(Ready)MOV(2,Recipe_CS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.2)XIC(Ready)MOV(3,Recipe_CS)MOV(RecipeNumber,Command);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.3)EQU(Echo,RecipeNumber)XIO(Ready)MOV(4,Recipe_CS);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.4)XIC(Success)MOV(5,Recipe_CS)OTL(PC)OTU(IP);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(IP) XIC(FaultTimer.DN) ,[XIC(Recipe_SW.1) ,XIC(Recipe_SW.2) ,XIC(Recipe_SW.3) ,XIC(Recipe_SW.4) ] [XIC(Failure) ,XIC(ProgramError) ] ]MOV(31,Recipe_CS)OTL(Error)OTU(IP);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[CLR(Recipe_SW) ,OTE(Recipe_SW.[Recipe_CS]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(Recipe_SW.0) ,XIC(Recipe_SW.1) ,XIC(Recipe_SW.2) ,XIC(Recipe_SW.3) ,XIC(Recipe_SW.4) ][OTE(StartProgram) ,MOV(10000,FaultTimer.PRE) TON(FaultTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Recipe_SW.1) ,XIC(Recipe_SW.3) ]OTE(PLCAck);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
