<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(DataStructure.AlwaysOn)[MOV(2000,PowerUp_TMR.PRE) TON(PowerUp_TMR,?,?) XIC(PowerUp_TMR.DN) OTE(DataStructure.PowerUpCP) ,MOV(60000,MotionUp_TMR.PRE) TON(MotionUp_TMR,?,?) XIC(MotionUp_TMR.DN) OTE(DataStructure.MotionUpCP) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(RunStatus) MOV(3600000,HourTimer.PRE) RTO(HourTimer,?,?) ,XIC(HourTimer.DN) ADD(HourRuntime,1,HourRuntime) RES(HourTimer) ];]]>
