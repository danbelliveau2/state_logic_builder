<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(BoxShift_SM.Status.State[60]) ,XIC(BoxShift_SM.Status.State[61]) ][XIC(PackRobot_SM.Status.State[62]) ,XIC(PackRobot_SM.Status.State[63]) ]MOV(62,BoxShift_SM.Control.StateReg);]]>
