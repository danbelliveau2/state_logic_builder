<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(BoxShift_SM.Status.State[14]) ,XIO(MachineRunning) ]OTU(BoxShift_SM.Control.Bit[2]);]]>
