</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(TfrConveyor_SM.Status.State[2])XIC(CycleStartLatch)XIC(MachineBasic.AlwaysOff)MOV(61,TfrConveyor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
