</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="State_Engine_64Max_v3_5" Class="Standard" Revision="3.5" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-06-25T13:55:13.933Z" CreatedBy="BillHambyLaptop\Bill" EditedDate="2015-01-22T15:26:16.801Z" EditedBy="Jason-PC\Jason"
 SoftwareRevision="v21.00">
<Description>
<![CDATA[State Logic Engine For 64 States]]>
</Description>
<RevisionNote>
<![CDATA[Added separate fault timer]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="StateLogicData" TagType="Base" DataType="State_Logic_Data" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="StateDurationTimer" DataType="FBD_TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[1,0,0,0,0,0,0,0,0,4,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="FBD_TIMER">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="TimerEnable" DataType="BOOL" Value="0"/>
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
<DataValueMember Name="Status" DataType="DINT" Radix="Hex" Value="16#0000_0000"/>
<DataValueMember Name="InstructFault" DataType="BOOL" Value="0"/>
<DataValueMember Name="PresetInv" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="i" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="StateReg_Prev" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="FaultTimer" DataType="FBD_TIMER" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[1,0,0,0,0,0,0,0,0,4,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="FBD_TIMER">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="TimerEnable" DataType="BOOL" Value="0"/>
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
<DataValueMember Name="Status" DataType="DINT" Radix="Hex" Value="16#0000_0000"/>
<DataValueMember Name="InstructFault" DataType="BOOL" Value="0"/>
<DataValueMember Name="PresetInv" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[StateDurationTimer.Reset := 0;]]>
</Line>
<Line Number="1">
<![CDATA[StateDurationTimer.PRE := 2147483647;]]>
</Line>
<Line Number="2">
<![CDATA[FaultTimer.Reset := 0;]]>
</Line>
<Line Number="3">
<![CDATA[FaultTimer.PRE := 2147483647;]]>
</Line>
<Line Number="4">
<![CDATA[TONR(StateDurationTimer);]]>
</Line>
<Line Number="5">
<![CDATA[TONR(FaultTimer);]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[If (StateLogicData.Control.StateReg = StateReg_Prev) THEN]]>
</Line>
<Line Number="8">
<![CDATA[	StateLogicData.Status.StateChangeOccurred_OS := 0;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[	//State Duration Timer]]>
</Line>
<Line Number="11">
<![CDATA[	StateDurationTimer.TimerEnable := 1;]]>
</Line>
<Line Number="12">
<![CDATA[	StateLogicData.Status.StateDuration[StateLogicData.Control.StateReg] := StateDurationTimer.ACC;]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[	//State Fault Timer]]>
</Line>
<Line Number="15">
<![CDATA[	IF (StateLogicData.Control.EnaFaultDetect) THEN]]>
</Line>
<Line Number="16">
<![CDATA[		FaultTimer.TimerEnable := 1;]]>
</Line>
<Line Number="17">
<![CDATA[		IF (FaultTimer.ACC >= StateLogicData.Control.FaultTime) THEN]]>
</Line>
<Line Number="18">
<![CDATA[			StateLogicData.Status.TimeoutFlt := 1;]]>
</Line>
<Line Number="19">
<![CDATA[		ELSE]]>
</Line>
<Line Number="20">
<![CDATA[			StateLogicData.Status.TimeoutFlt := 0;]]>
</Line>
<Line Number="21">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[	ELSE]]>
</Line>
<Line Number="23">
<![CDATA[		FaultTimer.Reset := 1;]]>
</Line>
<Line Number="24">
<![CDATA[		FaultTimer.TimerEnable := 0;]]>
</Line>
<Line Number="25">
<![CDATA[		StateLogicData.Status.TimeoutFlt := 0;]]>
</Line>
<Line Number="26">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[	//State Transition Timer]]>
</Line>
<Line Number="29">
<![CDATA[	IF (StateLogicData.Control.EnaTransitionTimer) THEN]]>
</Line>
<Line Number="30">
<![CDATA[		IF (StateDurationTimer.ACC >= StateLogicData.Control.TransitionTime) THEN]]>
</Line>
<Line Number="31">
<![CDATA[			StateLogicData.Status.TransitionTimerDone := 1;]]>
</Line>
<Line Number="32">
<![CDATA[		ELSE]]>
</Line>
<Line Number="33">
<![CDATA[			StateLogicData.Status.TransitionTimerDone := 0;]]>
</Line>
<Line Number="34">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="35">
<![CDATA[	ELSE]]>
</Line>
<Line Number="36">
<![CDATA[		StateLogicData.Status.TransitionTimerDone := 0;]]>
</Line>
<Line Number="37">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="38">
<![CDATA[ELSE]]>
</Line>
<Line Number="39">
<![CDATA[	//Previous State not Current State: State Change Occurred.]]>
</Line>
<Line Number="40">
<![CDATA[	StateLogicData.Status.StateChangeOccurred_OS := 1;]]>
</Line>
<Line Number="41">
<![CDATA[	StateLogicData.Status.PreviousState := StateReg_Prev;]]>
</Line>
<Line Number="42">
<![CDATA[	StateReg_Prev := StateLogicData.Control.StateReg;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[	StateDurationTimer.Reset := 1;]]>
</Line>
<Line Number="45">
<![CDATA[	StateDurationTimer.TimerEnable := 0;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[	FaultTimer.Reset := 1;]]>
</Line>
<Line Number="48">
<![CDATA[	FaultTimer.TimerEnable := 0;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[	StateLogicData.Status.TimeoutFlt := 0;]]>
</Line>
<Line Number="51">
<![CDATA[	StateLogicData.Status.TransitionTimerDone := 0;]]>
</Line>
<Line Number="52">
<![CDATA[END_IF;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[//Set the State Bit, clear all other bits.]]>
</Line>
<Line Number="56">
<![CDATA[FOR i := 0 TO (StateLogicData.Control.StateReg - 1) DO]]>
</Line>
<Line Number="57">
<![CDATA[	StateLogicData.Status.State[i] := 0;]]>
</Line>
<Line Number="58">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="59">
<![CDATA[StateLogicData.Status.State[i] := 1;]]>
</Line>
<Line Number="60">
<![CDATA[FOR i := (StateLogicData.Control.StateReg + 1) TO 63 DO]]>
</Line>
<Line Number="61">
<![CDATA[	StateLogicData.Status.State[i] := 0;]]>
</Line>
<Line Number="62">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
