<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(TfrConveyor_SM.Status.State[18]) [XIC(r04Unload_IN.Input[0].2) ,XIC(UnloadRobot_SM.Status.State[61]) ] [XIC(r05Packaging_IN.Input[0].2) ,XIC(PackRobot_SM.Status.State[61]) ] TON(TfrConveyor_SM.Control.Timer[5],?,?) XIC(TfrConveyor_SM.Control.Timer[5].DN) ,XIC(TfrConveyor_SM.Status.State[9]) XIC(TfrConveyor_SM.Control.Bit[1]) ]MOV(20,TfrConveyor_SM.Control.StateReg);]]>
</Text>
