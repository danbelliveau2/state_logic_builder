<Comment>
<![CDATA[Servo Drives]]>
</Comment>
<Text>
<![CDATA[[AOI_EIPStatus(AOI_s01Indexer_EIP,s01Indexer) ,AOI_EIPStatus(AOI_s02S17XAxis_EIP,s02S17XAxis) ,AOI_EIPStatus(AOI_s03S17YAxis_EIP,s03S17YAxis) ,AOI_EIPStatus(AOI_s04Conveyor_EIP,s04Conveyor) ,AOI_EIPStatus(AOI_s05BSXAxis_EIP,s05BSXAxis) ,AOI_EIPStatus(AOI_s06BSYAxis_EIP,s06BSYAxis) ,AOI_EIPStatus(AOI_s07TSXAxis_EIP,s07TSXAxis) ,AOI_EIPStatus(AOI_s08TSYAxis_EIP,s08TSYAxis) ,AOI_EIPStatus(AOI_s09ShotPin_EIP,s09ShotPin) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[VFDs]]>
</Comment>
<Text>
<![CDATA[[AOI_EIPStatus(AOI_v01BSConv_EIP,v01BSConv) ,AOI_EIPStatus(AOI_v02TSConv_EIP,v02TSConv) ,AOI_EIPStatus(AOI_v03InsertIncline_EIP,v03InsertIncline) ,AOI_EIPStatus(AOI_v04InsertConv_EIP,v04InsertConv) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Robots]]>
</Comment>
<Text>
<![CDATA[[AOI_EIPStatus(AOI_r01BS_EIP,r01BS) ,AOI_EIPStatus(AOI_r02TS_EIP,r02TS) ,AOI_EIPStatus(AOI_r03Insert_EIP,r03Insert) ,AOI_EIPStatus(AOI_r04Unload_EIP,r04Unload) ,AOI_EIPStatus(AOI_r05Packaging_EIP,r05Packaging) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Machine I/O Devices]]>
</Comment>
<Text>
<![CDATA[[AOI_EIPStatus(AOI_io01BS_EIP,io01BS) ,AOI_EIPStatus(AOI_io02TS_EIP,io02TS) ,AOI_EIPStatus(AOI_io3Press_EIP,io03Press) ,AOI_EIPStatus(AOI_KeyenceProbes_EIP,KeyenceProbes) ,AOI_EIPStatus(AOI_ValveBank_EIP,ValveBank) ,AOI_EIPStatus(AOI_InsertStepper_EIP,InsertStepper) ,AOI_EIPStatus(AOI_TelesisLaser_EIP,TelesisLaser) ,AOI_EIPStatus(AOI_c01InsertInspect_EIP,c01InsertInspect) ,AOI_EIPStatus(AOI_c02LaserInspect_EIP,c02LaserInspect) ,AOI_EIPStatus(AOI_c03OrificeInspect_EIP,c03OrificeInspect) ,AOI_EIPStatus(AOI_c04PressInspect_EIP,c04PressInspect) ,AOI_EIPStatus(AOI_KeyenceLaser_EIP,KeyenceLaser) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Banner Safety Controllers]]>
</Comment>
<Text>
<![CDATA[[AOI_EIPStatus(AOI_sc01BannerMC_EIP,sc01BannerMC) ,AOI_EIPStatus(AOI_sc02BannerBS_EIP,sc02BannerBS) ,AOI_EIPStatus(AOI_sc03BannerTS_EIP,sc03BannerTS) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(HeadEfficiency_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HeadEfficiency_SUB" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Calculate Head Efficiency]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[For a:=1 to 20 do]]>
</Line>
<Line Number="3">
<![CDATA[	]]>
</Line>
<Line Number="4">
<![CDATA[HMI_Data.HeadData[a].Station1.Efficiency:=(HMI_Data.HeadData[a].Station1.Successes/HMI_Data.HeadData[a].Station1.Attempts)*100;]]>
</Line>
<Line Number="5">
<![CDATA[HMI_Data.HeadData[a].Station5.Efficiency:=(HMI_Data.HeadData[a].Station5.Successes/HMI_Data.HeadData[a].Station5.Attempts)*100;]]>
</Line>
<Line Number="6">
<![CDATA[HMI_Data.HeadData[a].Station7.Efficiency:=(HMI_Data.HeadData[a].Station7.Successes/HMI_Data.HeadData[a].Station7.Attempts)*100;]]>
</Line>
<Line Number="7">
<![CDATA[HMI_Data.HeadData[a].Station10.Efficiency:=(HMI_Data.HeadData[a].Station10.Successes/HMI_Data.HeadData[a].Station10.Attempts)*100;]]>
</Line>
<Line Number="8">
<![CDATA[HMI_Data.HeadData[a].Station11.Efficiency:=(HMI_Data.HeadData[a].Station11.Successes/HMI_Data.HeadData[a].Station11.Attempts)*100;]]>
</Line>
<Line Number="9">
<![CDATA[HMI_Data.HeadData[a].Station14.Efficiency:=(HMI_Data.HeadData[a].Station14.Successes/HMI_Data.HeadData[a].Station14.Attempts)*100;]]>
</Line>
<Line Number="10">
<![CDATA[HMI_Data.HeadData[a].Station15.Efficiency:=(HMI_Data.HeadData[a].Station15.Successes/HMI_Data.HeadData[a].Station15.Attempts)*100;]]>
</Line>
<Line Number="11">
<![CDATA[HMI_Data.HeadData[a].Station16.Efficiency:=(HMI_Data.HeadData[a].Station16.Successes/HMI_Data.HeadData[a].Station16.Attempts)*100;]]>
</Line>
<Line Number="12">
<![CDATA[HMI_Data.HeadData[a].Station17.Efficiency:=(HMI_Data.HeadData[a].Station17.Successes/HMI_Data.HeadData[a].Station17.Attempts)*100;]]>
</Line>
<Line Number="13">
<![CDATA[HMI_Data.HeadData[a].Station18.Efficiency:=(HMI_Data.HeadData[a].Station18.Successes/HMI_Data.HeadData[a].Station18.Attempts)*100;]]>
</Line>
<Line Number="14">
<![CDATA[HMI_Data.HeadData[a].Overall.Efficiency:=(HMI_Data.HeadData[a].Overall.Successes/HMI_Data.HeadData[a].Overall.Attempts)*100;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
