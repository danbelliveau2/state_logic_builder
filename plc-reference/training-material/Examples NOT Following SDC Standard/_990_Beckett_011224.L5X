<Routines>
<Routine Name="Create" Type="ST">
<Description>
<![CDATA[Find the first available slot in the Saved list and use that for a new part.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Find the first empty Save slot]]>
</Line>
<Line Number="1">
<![CDATA[IF NOT (HMIStatusReplaceScreenTag = NewRecipeScreenNum) THEN]]>
</Line>
<Line Number="2">
<![CDATA[	FOR SavedIter := 0 TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="3">
<![CDATA[		IF (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="4">
<![CDATA[			//Copy the editing Recipe to the found Saved slot]]>
</Line>
<Line Number="5">
<![CDATA[			COP(HMIControlRecipeTag.Editing, HMIStatusRecipeTag.Saved[SavedIter], 1);]]>
</Line>
<Line Number="6">
<![CDATA[			//Clear the PartNumber field]]>
</Line>
<Line Number="7">
<![CDATA[			COP(NewPartString30, HMIStatusRecipeTag.Saved[SavedIter].Name, 1);]]>
</Line>
<Line Number="8">
<![CDATA[			COP(NewPartString30, HMIControlRecipeTag.Editing.Name, 1);]]>
</Line>
<Line Number="9">
<![CDATA[			SavedPointer := SavedIter;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[			COP(NewPartString30, HMIControlRecipeTag.FilterPartNumber, 1);]]>
</Line>
<Line Number="12">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="13">
<![CDATA[			FilterListStartPos := SavedIter;]]>
</Line>
<Line Number="14">
<![CDATA[			RefreshFilterList := 1;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="17">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="18">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="19">
<![CDATA[	HMIStatusReplaceScreenTag := NewRecipeScreenNum;]]>
</Line>
<Line Number="20">
<![CDATA[	HMIStatusCloseScreenTag := 0;]]>
</Line>
<Line Number="21">
<![CDATA[END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="FilterStartPos" Type="ST">
<Description>
<![CDATA[Manage initializing, Incrementing, and Decrementing the Filter List Start Position]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[IF (FilterListStartPos < 0 OR FilterListStartPos >= SavedRecipeArrayLength) THEN]]>
</Line>
<Line Number="1">
<![CDATA[	FilterListStartPos := 0;]]>
</Line>
<Line Number="2">
<![CDATA[END_IF;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[IF (FilterListQty = 0) THEN]]>
</Line>
<Line Number="5">
<![CDATA[	//No Results]]>
</Line>
<Line Number="6">
<![CDATA[	HMIStatusRecipeTag.IndexNumNavi := -1;]]>
</Line>
<Line Number="7">
<![CDATA[ELSE]]>
</Line>
<Line Number="8">
<![CDATA[	//HMI Scroll Home button]]>
</Line>
<Line Number="9">
<![CDATA[	IF (HMIControlRecipeTag.ScrollHome AND NOT OneShot[0]) THEN]]>
</Line>
<Line Number="10">
<![CDATA[		OneShot[0] := 1;]]>
</Line>
<Line Number="11">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="12">
<![CDATA[		FilterListStartPos := 0;]]>
</Line>
<Line Number="13">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="14">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollHome AND OneShot[0]) THEN]]>
</Line>
<Line Number="15">
<![CDATA[		OneShot[0] := 0;]]>
</Line>
<Line Number="16">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[	//HMI Page Up button]]>
</Line>
<Line Number="19">
<![CDATA[	IF (HMIControlRecipeTag.PageUp AND NOT OneShot[1]) THEN]]>
</Line>
<Line Number="20">
<![CDATA[		OneShot[1] := 1;]]>
</Line>
<Line Number="21">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - DisplayListSize;]]>
</Line>
<Line Number="22">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.PageUp AND OneShot[1]) THEN]]>
</Line>
<Line Number="23">
<![CDATA[		OneShot[1] := 0;]]>
</Line>
<Line Number="24">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[	//HMI Scroll Up button]]>
</Line>
<Line Number="27">
<![CDATA[	IF (HMIControlRecipeTag.ScrollUp AND NOT OneShot[2]) THEN]]>
</Line>
<Line Number="28">
<![CDATA[		OneShot[2] := 1;]]>
</Line>
<Line Number="29">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - 1;]]>
</Line>
<Line Number="30">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollUp AND OneShot[2]) THEN]]>
</Line>
<Line Number="31">
<![CDATA[		OneShot[2] := 0;]]>
</Line>
<Line Number="32">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	//HMI Scroll Down button]]>
</Line>
<Line Number="35">
<![CDATA[	IF (HMIControlRecipeTag.ScrollDown AND NOT OneShot[3]) THEN]]>
</Line>
<Line Number="36">
<![CDATA[		OneShot[3] := 1;]]>
</Line>
<Line Number="37">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi + 1;]]>
</Line>
<Line Number="38">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollDown AND OneShot[3]) THEN]]>
</Line>
<Line Number="39">
<![CDATA[		OneShot[3] := 0;]]>
</Line>
<Line Number="40">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[	//HMI Page Down button]]>
</Line>
<Line Number="43">
<![CDATA[	IF (HMIControlRecipeTag.PageDown AND NOT OneShot[4]) THEN]]>
</Line>
<Line Number="44">
<![CDATA[		OneShot[4] := 1;]]>
</Line>
<Line Number="45">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi + DisplayListSize;]]>
</Line>
<Line Number="46">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.PageDown AND OneShot[4]) THEN]]>
</Line>
<Line Number="47">
<![CDATA[		OneShot[4] := 0;]]>
</Line>
<Line Number="48">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[	//HMI Scroll End button]]>
</Line>
<Line Number="51">
<![CDATA[	IF (HMIControlRecipeTag.ScrollEnd AND NOT OneShot[5]) THEN]]>
</Line>
<Line Number="52">
<![CDATA[		OneShot[5] := 1;]]>
</Line>
<Line Number="53">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := SavedRecipeArrayLength - 1;]]>
</Line>
<Line Number="54">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollEnd AND OneShot[5]) THEN]]>
</Line>
<Line Number="55">
<![CDATA[		OneShot[5] := 0;]]>
</Line>
<Line Number="56">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[	IF (HMIStatusRecipeTag.IndexNumNavi >= DisplayListSize) THEN]]>
</Line>
<Line Number="60">
<![CDATA[			//Below the bottom of the Listbox]]>
</Line>
<Line Number="61">
<![CDATA[ 		IF (HMIStatusRecipeTag.IndexNumNavi < (FilterListQty - FilterListStartPos)) THEN]]>
</Line>
<Line Number="62">
<![CDATA[			//There are records to display below the navigation row]]>
</Line>
<Line Number="63">
<![CDATA[			FilterListStartPos := FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[			IF (FilterListStartPos >= FilterListQty) THEN]]>
</Line>
<Line Number="66">
<![CDATA[				//Start position is outside the Filter List]]>
</Line>
<Line Number="67">
<![CDATA[				IF (FilterListQty >= DisplayListSize) THEN]]>
</Line>
<Line Number="68">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := DisplayListSize - 1; //Navigation on the last row]]>
</Line>
<Line Number="69">
<![CDATA[					FilterListStartPos := FilterListQty - DisplayListSize;]]>
</Line>
<Line Number="70">
<![CDATA[				ELSE]]>
</Line>
<Line Number="71">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := FilterListQty - 1; //Navigation on the last row]]>
</Line>
<Line Number="72">
<![CDATA[					FilterListStartPos := 0;]]>
</Line>
<Line Number="73">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="74">
<![CDATA[			ELSE]]>
</Line>
<Line Number="75">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - DisplayListSize;]]>
</Line>
<Line Number="76">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="77">
<![CDATA[		ELSE]]>
</Line>
<Line Number="78">
<![CDATA[			//No more records below the navigation row]]>
</Line>
<Line Number="79">
<![CDATA[			IF (FilterListQty >= DisplayListSize) THEN]]>
</Line>
<Line Number="80">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := DisplayListSize - 1; //Navigation on the last row]]>
</Line>
<Line Number="81">
<![CDATA[				FilterListStartPos := FilterListQty - DisplayListSize;]]>
</Line>
<Line Number="82">
<![CDATA[			ELSE]]>
</Line>
<Line Number="83">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := FilterListQty - 1; //Navigation on the last row]]>
</Line>
<Line Number="84">
<![CDATA[				FilterListStartPos := 0;]]>
</Line>
<Line Number="85">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="87">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="88">
<![CDATA[	ElSIF (HMIStatusRecipeTag.IndexNumNavi >= (FilterListQty - FilterListStartPos)) THEN]]>
</Line>
<Line Number="89">
<![CDATA[		//Below the bottom of the filtered list but above the bottom of the Listbox]]>
</Line>
<Line Number="90">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="91">
<![CDATA[		FilterListStartPos := 0;]]>
</Line>
<Line Number="92">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="93">
<![CDATA[	ELSIF (HMIStatusRecipeTag.IndexNumNavi < 0) THEN]]>
</Line>
<Line Number="94">
<![CDATA[		//Above the Listbox]]>
</Line>
<Line Number="95">
<![CDATA[		IF ((FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi) >= 0) THEN]]>
</Line>
<Line Number="96">
<![CDATA[			//The first value is at or less than the first part in the Saved list]]>
</Line>
<Line Number="97">
<![CDATA[			FilterListStartPos := (FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi);]]>
</Line>
<Line Number="98">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="99">
<![CDATA[		ELSE]]>
</Line>
<Line Number="100">
<![CDATA[			FilterListStartPos := 0;]]>
</Line>
<Line Number="101">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="102">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="103">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="104">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="105">
<![CDATA[END_IF;]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
<![CDATA[]]>
</Line>
<Line Number="108">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<Description>
<![CDATA[Recipe HMI interactions]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Manage the up/down functionality]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(FilterStartPos,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Initialize the SD card.

Calculate values for variables and array index sizes.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[MUL(RecipeStructureUDTSizeBytes,SavedRecipeArrayLength,SavedRecipeArraySize) ,DIV(SavedRecipeArraySize,442,calcSD_REAL[0]) Ceiling(Ceiling1_AOI,calcSD_REAL[0],calcSD_DINT[0]) MUL(calcSD_DINT[0],8,calcSD_DINT[1]) ADD(SavedRecipeArraySize,calcSD_DINT[1],calcSD_DINT[2]) ,DIV(calcSD_DINT[2],450,calcSD_REAL[1]) Ceiling(Ceiling2_AOI,calcSD_REAL[1],calcSD_DINT[3]) MUL(calcSD_DINT[3],450,CF_StorageArraysSize) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Its amazing that it works, but it in fact does!
In order to compare two UDT's you have to copy the data to two DINT arrays so that you can compare them with the FSC instruction.

Compare the Editing Recipe to its corresponding Saved Recipe Array.
Blink the Save button on the HMI if they're different.]]>
</Comment>
<Text>
<![CDATA[[GRT(FilterListQty,0) GEQ(SavedPointer,0) LES(SavedPointer,SavedRecipeArrayLength) DIV(RecipeStructureUDTSizeBytes,4,RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Saved[SavedPointer],Recipe_Structure_Array_Saved[0],RecipeStructureSizeDINTs) COP(HMIControlRecipeTag.Editing,Recipe_Structure_Array_Editing[0],RecipeStructureSizeDINTs) MOV(RecipeStructureSizeDINTs,ArrayCompareEdit_C.LEN) [XIO(ArrayCompareEdit_C.EN) FSC(ArrayCompareEdit_C,?,?,INC,Recipe_Structure_Array_Saved[ArrayCompareEdit_C.POS]<>Recipe_Structure_Array_Editing[ArrayCompareEdit_C.POS]) ,[XIC(ArrayCompareEdit_C.DN) OTL(Editing_Equal_Array) ,XIC(ArrayCompareEdit_C.FD) OTU(Editing_Equal_Array) ,[XIC(ArrayCompareEdit_C.FD) ,XIC(ArrayCompareEdit_C.DN) ] OTU(ArrayCompareEdit_C.FD) OTU(ArrayCompareEdit_C.IN) RES(ArrayCompareEdit_C) MOV(0,ArrayCompareEdit_C.POS) ] ] ,[LEQ(FilterListQty,0) ,LES(SavedPointer,0) ] OTL(Editing_Equal_Array) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Editing_Equal_Array)OTE(HMIIndicatorEditingEqualTag);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Compare the Running Recipe to its corresponding Saved Recipe Array.
Blink the Download button on the HMI if they're different.]]>
</Comment>
<Text>
<![CDATA[[GRT(FilterListQty,0) GEQ(HMIStatusRecipeTag.Running_ID,0) LES(HMIStatusRecipeTag.Running_ID,SavedRecipeArrayLength) DIV(RecipeStructureUDTSizeBytes,4,RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Saved[HMIStatusRecipeTag.Running_ID],Recipe_Structure_Array_Saved[0],RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Running,Recipe_Structure_Array_Running[0],RecipeStructureSizeDINTs) MOV(RecipeStructureSizeDINTs,ArrayCompareRun_C.LEN) [XIO(ArrayCompareRun_C.EN) FSC(ArrayCompareRun_C,?,?,INC,Recipe_Structure_Array_Saved[ArrayCompareRun_C.POS]<>Recipe_Structure_Array_Running[ArrayCompareRun_C.POS]) ,[XIC(ArrayCompareRun_C.DN) OTL(Running_Equal_Array) ,XIC(ArrayCompareRun_C.FD) OTU(Running_Equal_Array) ,[XIC(ArrayCompareRun_C.FD) ,XIC(ArrayCompareRun_C.DN) ] OTU(ArrayCompareRun_C.FD) OTU(ArrayCompareRun_C.IN) RES(ArrayCompareRun_C) MOV(0,ArrayCompareRun_C.POS) ] ] ,[LEQ(FilterListQty,0) ,LES(HMIStatusRecipeTag.Running_ID,0) ] OTL(Running_Equal_Array) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Running_Equal_Array)OTE(HMIIndicatorSavedRunningEqualTag);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(UpdateSavedPointer)[OTU(UpdateSavedPointer) ,GEQ(HMIStatusRecipeTag.IndexNumNavi,0) LES(HMIStatusRecipeTag.IndexNumNavi,DisplayListSize) [MOV(HMIStatusRecipeTag.PartID[HMIStatusRecipeTag.IndexNumNavi],SavedPointer) ,OTL(UpdateEditingRecipe) ] ,LES(HMIStatusRecipeTag.IndexNumNavi,0) [MOV(-1,SavedPointer) ,COP(EmptyRecipe,HMIControlRecipeTag.Editing,1) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(RefreshFilterList)[OTU(RefreshFilterList) ,JSR(PopulateFilterList,0) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(RefreshDisplayList)[OTU(RefreshDisplayList) ,JSR(PopulateDisplayList,0) ,OTL(UpdateSavedPointer) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(UpdateEditingRecipe)[OTU(UpdateEditingRecipe) ,GEQ(SavedPointer,0) LES(SavedPointer,SavedRecipeArrayLength) COP(HMIStatusRecipeTag.Saved[SavedPointer],HMIControlRecipeTag.Editing,1) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[****HMI Recipe Control****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[NEQ(HMIControlRecipeTag.FilterPartNumber,FilterPartNumberPrev)[COP(HMIControlRecipeTag.FilterPartNumber,FilterPartNumberPrev,1) ,MOV(0,FilterListStartPos) ,OTL(RefreshFilterList) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[NEQ(HMIStatusRecipeTag.IndexNumNavi,IndexNumNaviPrev)[MOV(HMIStatusRecipeTag.IndexNumNavi,IndexNumNaviPrev) ,OTL(UpdateSavedPointer) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(PreventRecipeDownload)GEQ(SavedPointer,0)LES(SavedPointer,SavedRecipeArrayLength)[XIC(HMIControlRecipeTag.Download) MOV(100,Timer[1].PRE) TON(Timer[1],?,?) XIC(Timer[1].DN) ONS(OneShot[10]) COP(HMIStatusRecipeTag.Running,PreviousRunningRecipe,1) ,XIC(MachineBasic.AlwaysOff) XIC(HMIAutoDownloadPart) EQU(HMIControlRecipeTag.FilterPartNumber,HMIStatusRecipeTag.Saved[SavedPointer].Name) TON(Timer[9],?,?) XIC(Timer[9].DN) ONS(OneShot[19]) ][COP(HMIStatusRecipeTag.Saved[SavedPointer],HMIStatusRecipeTag.Running,1) ,[MOV(SavedPointer,HMIStatusRecipeTag.Running_ID) ,OTE(DownloadPulse) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[[LES(SavedPointer,0) ,GEQ(SavedPointer,SavedRecipeArrayLength) ] [XIC(HMIControlRecipeTag.Download) ,XIC(MachineBasic.AlwaysOff) XIC(HMIAutoDownloadPart) ] ,XIC(MachineBasic.AlwaysOff) GEQ(SavedPointer,0) LES(SavedPointer,SavedRecipeArrayLength) NEQ(HMIControlRecipeTag.FilterPartNumber,HMIStatusRecipeTag.Saved[SavedPointer].Name) XIC(HMIAutoDownloadPart) ]ONS(OneShot[21])[COP(EmptyRecipe,HMIStatusRecipeTag.Running,1) ,OTE(EmptyRecipeDownloaded) ]OTL(EmptyTestLatch);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Delete)MOV(2000,Timer[2].PRE)TON(Timer[2],?,?)XIC(Timer[2].DN)ONS(OneShot[11])[GEQ(SavedPointer,0) LES(SavedPointer,SavedRecipeArrayLength) COP(EmptyRecipe,HMIStatusRecipeTag.Saved[SavedPointer],1) ,OTL(RefreshFilterList) ,OTL(Delete_Recipe) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Save)MOV(100,Timer[0].PRE)TON(Timer[0],?,?)XIC(Timer[0].DN)ONS(OneShot[12])[GEQ(SavedPointer,0) LES(SavedPointer,SavedRecipeArrayLength) COP(HMIControlRecipeTag.Editing,HMIStatusRecipeTag.Saved[SavedPointer],1) ,OTL(RefreshFilterList) ,OTL(Save_Recipe) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Sort)MOV(2000,Timer[3].PRE)TON(Timer[3],?,?)XIC(Timer[3].DN)ONS(OneShot[13])[JSR(Sort,0) ,OTL(RefreshFilterList) ,OTL(Write_MirrorData) ,OTL(Write_SortData) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Backup)MOV(2000,Timer[4].PRE)TON(Timer[4],?,?)XIC(Timer[4].DN)ONS(OneShot[14])OTL(Write_BackupData);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.UploadAndCreate)MOV(100,Timer[5].PRE)TON(Timer[5],?,?)XIC(Timer[5].DN)ONS(OneShot[15])JSR(Create,0);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(HMIControlRecipeTag.RecoverMirror) MOV(2000,Timer[6].PRE) TON(Timer[6],?,?) XIC(Timer[6].DN) ONS(OneShot[16]) OTL(Read_MirrorData) ,XIO(recover_mirror) ONS(OneShot[26]) OTL(RefreshFilterList) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIC(HMIControlRecipeTag.RecoverBackup) MOV(2000,Timer[7].PRE) TON(Timer[7],?,?) XIC(Timer[7].DN) ONS(OneShot[17]) OTL(Read_BackupData) ,XIO(recover_backup) ONS(OneShot[27]) OTL(RefreshFilterList) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.DeleteFiles)MOV(2000,Timer[8].PRE)TON(Timer[8],?,?)XIC(Timer[8].DN)ONS(OneShot[18])OTL(Delete_Files);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(HMIControlRecipeTag.CreateFiles)MOV(2000,Timer[10].PRE)TON(Timer[10],?,?)XIC(Timer[10].DN)ONS(OneShot[20])OTL(Create_Files1);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[****RECIPE POP-UP SCREEN LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[NEQ(HMIStatusCloseScreenTag,0)TON(Timer[11],?,?)XIC(Timer[11].DN)MOV(0,HMIStatusCloseScreenTag);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[NEQ(Running_IDPrev,HMIStatusRecipeTag.Running_ID)[[MOV(HMIStatusRecipeTag.Running_ID,Running_IDPrev) ,OTE(NewRecipeSelectedPulse) ] ,XIC(EnableChangeoverScreenPopup) [MOV(ChangeoverScreenNum,HMIStatusReplaceScreenTag) ,MOV(0,HMIStatusCloseScreenTag) ] ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(EnableChangeoverScreenPopup)XIC(HMIControlRecipeTag.CloseChangeoverPopup)[MOV(ChangeoverScreenNum,HMIStatusCloseScreenTag) ,MOV(0,HMIStatusReplaceScreenTag) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[EQU(HMIStatusReplaceScreenTag,NewRecipeScreenNum)[NEQ(HMIControlRecipeTag.Editing.Name,EmptyString30) NEQ(HMIControlRecipeTag.Editing.Name,NewPartString30) ,XIC(HMIControlRecipeTag.Cancel) ][MOV(NewRecipeScreenNum,HMIStatusCloseScreenTag) ,MOV(0,HMIStatusReplaceScreenTag) ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(Timer[0].DN)EQU(HMIControlRecipeTag.FilterPartNumber,NewPartString30)COP(HMIControlRecipeTag.Editing.Name,HMIControlRecipeTag.FilterPartNumber,1);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[JSR(Recipe_SaveLoad,0);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Clear the faults.]]>
</Comment>
<Text>
<![CDATA[XIC(FaultReset_PB)[MOV(0,Fault) ,MOV(0,Warning) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PopulateDisplayList" Type="ST">
<Description>
<![CDATA[Filtered List Display on HMI]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Populate the Displayed Part Number List]]>
</Line>
<Line Number="1">
<![CDATA[FilteredIter := 0;]]>
</Line>
<Line Number="2">
<![CDATA[SavedIter := 0;]]>
</Line>
<Line Number="3">
<![CDATA[ResultCount := 0;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[FOR FilteredIter := FilterListStartPos TO FilterListQty - 1 DO]]>
</Line>
<Line Number="6">
<![CDATA[	IF ((FilteredIter < 0) OR (FilteredIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="7">
<![CDATA[		Fault.0 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="8">
<![CDATA[		EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="9">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[	IF (ResultCount < DisplayListSize) THEN]]>
</Line>
<Line Number="12">
<![CDATA[		//The HMI display list is not full so continue to populate it.]]>
</Line>
<Line Number="13">
<![CDATA[		SavedIter := HMIStatusRecipeTag.FilteredList[FilteredIter];]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="16">
<![CDATA[			IF (SavedIter = -1) THEN //No more records in the Filtered list]]>
</Line>
<Line Number="17">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="18">
<![CDATA[			ELSE]]>
</Line>
<Line Number="19">
<![CDATA[				Fault.1 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="20">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="21">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[		IF ((ResultCount < 0) OR (ResultCount >= DisplayListSize)) THEN]]>
</Line>
<Line Number="25">
<![CDATA[			Fault.2 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="26">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="27">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[		//Set the DisplayListID and DisplayListName.]]>
</Line>
<Line Number="30">
<![CDATA[		HMIStatusRecipeTag.PartID[ResultCount] := SavedIter;]]>
</Line>
<Line Number="31">
<![CDATA[		COP(HMIStatusRecipeTag.Saved[SavedIter].Name, HMIStatusRecipeTag.PartNumber[ResultCount], 1);]]>
</Line>
<Line Number="32">
<![CDATA[	ELSE]]>
</Line>
<Line Number="33">
<![CDATA[		//The HMI display list is full so this routine is done.]]>
</Line>
<Line Number="34">
<![CDATA[		EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="35">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="36">
<![CDATA[	ResultCount := ResultCount + 1;]]>
</Line>
<Line Number="37">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="38">
<![CDATA[DisplayResultsQty := ResultCount;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[//Clear the rest of the display list if it wasn't filled]]>
</Line>
<Line Number="41">
<![CDATA[FOR ResultCount := DisplayResultsQty TO DisplayListSize - 1 DO]]>
</Line>
<Line Number="42">
<![CDATA[	IF ((ResultCount < 0) OR (ResultCount >= DisplayListSize)) THEN]]>
</Line>
<Line Number="43">
<![CDATA[		Fault.3 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="44">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="45">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[	//Set the DisplayListID and DisplayListName to empty.]]>
</Line>
<Line Number="48">
<![CDATA[	HMIStatusRecipeTag.PartID[ResultCount] := -1;]]>
</Line>
<Line Number="49">
<![CDATA[	COP(EmptyString30,HMIStatusRecipeTag.PartNumber[ResultCount],1);]]>
</Line>
<Line Number="50">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="PopulateFilterList" Type="ST">
<Description>
<![CDATA[Create Filtered List]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Populate the Filtered Part Number List]]>
</Line>
<Line Number="1">
<![CDATA[FilteredIter := 0;]]>
</Line>
<Line Number="2">
<![CDATA[FilterListQty :=  0;]]>
</Line>
<Line Number="3">
<![CDATA[LOWER(HMIControlRecipeTag.FilterPartNumber, filter); //So the comparison is case in-sensitive]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[IF (HMIControlRecipeTag.FilterPartNumber = EmptyString30) THEN]]>
</Line>
<Line Number="6">
<![CDATA[	//There is no filter.]]>
</Line>
<Line Number="7">
<![CDATA[	//Filter string is empty so populate with all non-empty recipes]]>
</Line>
<Line Number="8">
<![CDATA[	]]>
</Line>
<Line Number="9">
<![CDATA[	FOR SavedIter := 0 TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="10">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="11">
<![CDATA[			Fault.4 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="12">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="13">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[		IF ((HMIStatusRecipeTag.Saved[SavedIter].Name.LEN < 0) OR (HMIStatusRecipeTag.Saved[SavedIter].Name.LEN >= 30)) THEN]]>
</Line>
<Line Number="16">
<![CDATA[			Fault.9 := 1; //failed string length sanity check]]>
</Line>
<Line Number="17">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="18">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[		//Only if Saved string is NOT empty]]>
</Line>
<Line Number="21">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="22">
<![CDATA[			IF ((FilteredIter < 0) OR (FilteredIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="23">
<![CDATA[				Fault.5 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="24">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="25">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[			HMIStatusRecipeTag.FilteredList[FilteredIter] := SavedIter;]]>
</Line>
<Line Number="28">
<![CDATA[			FilteredIter := FilteredIter + 1;]]>
</Line>
<Line Number="29">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="30">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="31">
<![CDATA[ELSE]]>
</Line>
<Line Number="32">
<![CDATA[	//There is a filter.]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	FOR SavedIter := 0 TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="35">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="36">
<![CDATA[			Fault.6 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="37">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="38">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[		//Only if Saved string is NOT empty]]>
</Line>
<Line Number="41">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="42">
<![CDATA[			LOWER(HMIStatusRecipeTag.Saved[SavedIter].Name, saved); //So the comparison is case in-sensitive]]>
</Line>
<Line Number="43">
<![CDATA[				//Exact match! Move the start position here and place the "cursor" on this part.]]>
</Line>
<Line Number="44">
<![CDATA[				IF (saved = filter) THEN]]>
</Line>
<Line Number="45">
<![CDATA[					FilterListStartPos := FilteredIter;]]>
</Line>
<Line Number="46">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="47">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[				IF ((FilteredIter < 0) OR (FilteredIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="50">
<![CDATA[					Fault.7 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="51">
<![CDATA[					EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="52">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[				FIND(saved,filter,1,FindResult);]]>
</Line>
<Line Number="55">
<![CDATA[				IF (FindResult > 0) THEN]]>
</Line>
<Line Number="56">
<![CDATA[					//Exact or Partial Match! Add the matching saved array index to the FilterList]]>
</Line>
<Line Number="57">
<![CDATA[					HMIStatusRecipeTag.FilteredList[FilteredIter] := SavedIter;]]>
</Line>
<Line Number="58">
<![CDATA[					FilteredIter := FilteredIter + 1;]]>
</Line>
<Line Number="59">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="62">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="63">
<![CDATA[END_IF;]]>
</Line>
<Line Number="64">
<![CDATA[FilterListQty := FilteredIter;]]>
</Line>
<Line Number="65">
<![CDATA[]]>
</Line>
<Line Number="66">
<![CDATA[//Clear the rest of the filtered list if it wasn't filled]]>
</Line>
<Line Number="67">
<![CDATA[FOR FilteredIter := FilterListQty TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="68">
<![CDATA[	IF ((FilteredIter < 0) OR (FilteredIter >= SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="69">
<![CDATA[		Fault.8 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="70">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="71">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="72">
<![CDATA[	HMIStatusRecipeTag.FilteredList[FilteredIter] := -1;]]>
</Line>
<Line Number="73">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[RefreshDisplayList := 1;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Recipe_SaveLoad" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Save Edited/Deleted Recipe]]>
</Comment>
<Text>
<![CDATA[[XIC(Save_Recipe) ,XIC(Delete_Recipe) ]EQU(CF_RW_functions.command,0)ONS(Recipe_SaveLoad_ONS[0])[OTL(store_recipe) ,GEQ(SavedPointer,0) MOV(SavedPointer,Recipe_SaveIndex) ,MOV(0,Recipe_SD_Error) ,OTU(Save_Recipe) ,OTU(Delete_Recipe) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Backup All Recipes to Names Starting at 500]]>
</Comment>
<Text>
<![CDATA[XIC(backup_recipe)EQU(CF_RW_functions.command,0)XIO(store_recipe)ONS(Recipe_SaveLoad_ONS[2])[[ADD(1,Recipe_SaveIndex,Recipe_SaveIndex) ,ADD(1,Recipe_SaveIndex_Backup,Recipe_SaveIndex_Backup) ] ,OTL(store_recipe) ,ADD(Recipe_SaveIndex,1,Recipe_SaveIndexLength) GEQ(Recipe_SaveIndexLength,SavedRecipeArrayLength) OTU(backup_recipe) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Write_BackupData) ,XIC(Create_Files1) ]ONS(Recipe_SaveLoad_ONS[1])[OTL(backup_recipe) ,OTL(store_recipe) ,MOV(0,Recipe_SaveIndex) ,MOV(500,Recipe_SaveIndex_Backup) ,MOV(0,Recipe_SD_Error) ,OTU(Write_BackupData) ,XIC(Create_Files1) [OTU(Create_Files1) ,OTL(Create_Files2) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Save All Recipes to Names Starting at 0]]>
</Comment>
<Text>
<![CDATA[XIC(mirror_recipe)EQU(CF_RW_functions.command,0)XIO(store_recipe)ONS(Recipe_SaveLoad_ONS[4])[ADD(1,Recipe_SaveIndex,Recipe_SaveIndex) ,OTL(store_recipe) ,ADD(Recipe_SaveIndex,1,Recipe_SaveIndexLength) GEQ(Recipe_SaveIndexLength,SavedRecipeArrayLength) [OTU(mirror_recipe) ,OTU(Create_Files3) ,OTU(Write_SortData) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[XIC(Write_MirrorData) ,XIC(HMIControlRecipeTag.Mirror) TON(Timer[12],?,?) XIC(Timer[12].DN) ] ,XIC(Create_Files2) XIO(backup_recipe) ]XIO(mirror_recipe)ONS(Recipe_SaveLoad_ONS[3])[OTL(mirror_recipe) ,OTL(store_recipe) ,MOV(0,Recipe_SaveIndex) ,MOV(0,Recipe_SD_Error) ,OTU(Write_MirrorData) ,XIC(Create_Files2) OTL(Create_Files3) ,OTU(Create_Files2) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Set values in the 'Saved' tag.
Then trigger this rung to store this to a file called the value of Recipe_SaveIndex on the CompactFlash card.]]>
</Comment>
<Text>
<![CDATA[XIC(store_recipe)EQU(CF_RW_functions.command,0)ONS(Recipe_SaveLoad_ONS[5])[COP(HMIStatusRecipeTag.Saved[Recipe_SaveIndex],CF_RW_functions.data[0],RecipeStructureUDTSizeBytes) [XIO(backup_recipe) DTOS(Recipe_SaveIndex,Recipe_SaveIndex_Str) COP(Recipe_SaveIndex_Str,CF_RW_functions.name.LEN,20) ,XIC(backup_recipe) DTOS(Recipe_SaveIndex_Backup,Recipe_SaveIndex_Str) COP(Recipe_SaveIndex_Str,CF_RW_functions.name.LEN,20) ] ,CLR(CF_RW_functions.offset) MOV(RecipeStructureUDTSizeBytes,CF_RW_functions.REQ_length) ,MOV(3,CF_RW_functions.command) [OTU(store_recipe) ,OTL(storing_recipe) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(CF_RW_functions.command,0)XIC(storing_recipe)XIO(Recipe_SaveLoad_ONS[5])[NEQ(CF_RW_functions.result,RecipeStructureUDTSizeBytes) [XIC(Recipe_SD_Error.0) OTL(Recipe_SD_Error.1) ,MOV(Recipe_SaveIndex,HMI_Data.Status.Recipe.StatusMessageNum) OTL(Recipe_SD_Error.0) ] ,OTU(storing_recipe) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Recover the mirror]]>
</Comment>
<Text>
<![CDATA[XIC(recover_mirror)EQU(CF_RW_functions.command,0)XIO(load_recipe)ONS(Recipe_SaveLoad_ONS[8])[ADD(1,Recipe_LoadIndex,Recipe_LoadIndex) ,OTL(load_recipe) ,ADD(Recipe_LoadIndex,1,Recipe_LoadIndexLength) GEQ(Recipe_LoadIndexLength,SavedRecipeArrayLength) OTU(recover_mirror) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Read_MirrorData)ONS(Recipe_SaveLoad_ONS[9])[OTL(recover_mirror) ,OTL(load_recipe) ,MOV(0,Recipe_LoadIndex) ,MOV(0,Recipe_SD_Error) ,OTU(Read_MirrorData) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Recover the backup]]>
</Comment>
<Text>
<![CDATA[XIC(recover_backup)EQU(CF_RW_functions.command,0)XIO(load_recipe)ONS(Recipe_SaveLoad_ONS[10])[[ADD(1,Recipe_LoadIndex,Recipe_LoadIndex) ,ADD(1,Recipe_LoadIndex_Backup,Recipe_LoadIndex_Backup) ] ,OTL(load_recipe) ,ADD(Recipe_LoadIndex,1,Recipe_LoadIndexLength) GEQ(Recipe_LoadIndexLength,SavedRecipeArrayLength) OTU(recover_backup) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Read_BackupData)ONS(Recipe_SaveLoad_ONS[11])[OTL(recover_backup) ,OTL(load_recipe) ,MOV(0,Recipe_LoadIndex) ,MOV(500,Recipe_LoadIndex_Backup) ,MOV(0,Recipe_SD_Error) ,OTU(Read_BackupData) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Trigger this rung to load the data from the 'recipe1' file on the card to the 'active_recipe' tag.
Use the tag monitor to see the values.]]>
</Comment>
<Text>
<![CDATA[XIC(load_recipe)EQU(CF_RW_functions.command,0)[XIO(loading_recipe) ONS(Recipe_SaveLoad_ONS[12]) [[XIO(recover_backup) DTOS(Recipe_LoadIndex,Recipe_LoadIndex_Str) COP(Recipe_LoadIndex_Str,CF_RW_functions.name.LEN,20) ,XIC(recover_backup) DTOS(Recipe_LoadIndex_Backup,Recipe_LoadIndex_Str) COP(Recipe_LoadIndex_Str,CF_RW_functions.name.LEN,20) ] ,CLR(CF_RW_functions.offset) MOV(RecipeStructureUDTSizeBytes,CF_RW_functions.REQ_length) ,MOV(2,CF_RW_functions.command) OTL(loading_recipe) ] ,XIC(loading_recipe) XIO(Recipe_SaveLoad_ONS[12]) [OTU(loading_recipe) OTU(load_recipe) ,EQU(CF_RW_functions.result,0) COP(CF_RW_functions.data[0],HMIStatusRecipeTag.Saved[Recipe_LoadIndex],1) ,NEQ(CF_RW_functions.result,0) [XIC(Recipe_SD_Error.2) OTL(Recipe_SD_Error.3) ,MOV(Recipe_LoadIndex,HMI_Data.Status.Recipe.StatusMessageNum) OTL(Recipe_SD_Error.2) ] ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Set controller tags for HMI animations]]>
</Comment>
<Text>
<![CDATA[XIC(mirror_recipe)XIO(Write_SortData)OTE(RecipeBusy_mirror_recipe);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Write_SortData)OTE(RecipeBusy_sort_mirror);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(recover_mirror)OTE(RecipeBusy_recover_mirror);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(backup_recipe)OTE(RecipeBusy_backup_recipe);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(recover_backup)OTE(RecipeBusy_recover_backup);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(Create_Files1) ,XIC(Create_Files2) ,XIC(Create_Files3) ]OTE(RecipeBusy_create_files);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Sort" Type="ST">
<Description>
<![CDATA[Sort the Saved Recipes List]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Selection Sort the Recipe Array]]>
</Line>
<Line Number="1">
<![CDATA[FOR SortPtr_Main := 0 TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="2">
<![CDATA[	SortPtr_Smallest := -1;]]>
</Line>
<Line Number="3">
<![CDATA[	FOR SortPtr_Remain := SortPtr_Main TO SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="4">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SortPtr_Remain].Name = EmptyString30) THEN]]>
</Line>
<Line Number="5">
<![CDATA[			IF (SortPtr_Smallest = -1) THEN]]>
</Line>
<Line Number="6">
<![CDATA[				SortPtr_Smallest := SortPtr_Remain;]]>
</Line>
<Line Number="7">
<![CDATA[			ELSE]]>
</Line>
<Line Number="8">
<![CDATA[				IF (HMIStatusRecipeTag.Saved[SortPtr_Remain].Name < HMIStatusRecipeTag.Saved[SortPtr_Smallest].Name) THEN]]>
</Line>
<Line Number="9">
<![CDATA[					SortPtr_Smallest := SortPtr_Remain;]]>
</Line>
<Line Number="10">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="11">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="12">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="13">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="14">
<![CDATA[	IF (SortPtr_Smallest = -1) THEN]]>
</Line>
<Line Number="15">
<![CDATA[		//Didn't find a non-empty value which means the rest of the array is empty, so we're done]]>
</Line>
<Line Number="16">
<![CDATA[		EXIT; //Quits the FOR loop only]]>
</Line>
<Line Number="17">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[	//Swap the Main with the smallest value found.]]>
</Line>
<Line Number="20">
<![CDATA[	COP(HMIStatusRecipeTag.Saved[SortPtr_Main], SortSwapRecipe, 1);]]>
</Line>
<Line Number="21">
<![CDATA[	COP(HMIStatusRecipeTag.Saved[SortPtr_Smallest], HMIStatusRecipeTag.Saved[SortPtr_Main], 1);]]>
</Line>
<Line Number="22">
<![CDATA[	COP(SortSwapRecipe, HMIStatusRecipeTag.Saved[SortPtr_Smallest], 1);]]>
</Line>
<Line Number="23">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
<Program Name="S01BottomShell" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" Class="Standard" UseAsFolder="false">
<Tags>
<Tag Name="a05BSXAxis_MSF" TagType="Base" DataType="MOTION_INSTRUCTION" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[[536870912,0,2,1,0,0,0,0,0]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="MOTION_INSTRUCTION">
<DataValueMember Name="FLAGS" DataType="DINT" Radix="Decimal" Value="536870912"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="1"/>
<DataValueMember Name="ER" DataType="BOOL" Value="0"/>
<DataValueMember Name="PC" DataType="BOOL" Value="0"/>
<DataValueMember Name="IP" DataType="BOOL" Value="0"/>
<DataValueMember Name="AC" DataType="BOOL" Value="0"/>
<DataValueMember Name="ACCEL" DataType="BOOL" Value="0"/>
<DataValueMember Name="DECEL" DataType="BOOL" Value="0"/>
<DataValueMember Name="TrackingMaster" DataType="BOOL" Value="0"/>
