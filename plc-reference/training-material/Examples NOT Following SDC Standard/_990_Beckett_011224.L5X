<DataValueMember Name="Actual_Velocity" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Extended_Inputs" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Main_Board_Inputs" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Word11" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Analog_Input_1" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Analog_Input_2" DataType="DINT" Radix="Decimal" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Loc_Start_ONS" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Loc_AlarmCode" DataType="AMP_Alarm_Word" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="AMP_Alarm_Word">
<DataValueMember Name="Position_Limit" DataType="BOOL" Value="0"/>
<DataValueMember Name="CCW_Limit" DataType="BOOL" Value="0"/>
<DataValueMember Name="CW_Limit" DataType="BOOL" Value="0"/>
<DataValueMember Name="Over_Temp" DataType="BOOL" Value="0"/>
<DataValueMember Name="Excess_Regen_or_Internal_Voltage" DataType="BOOL" Value="0"/>
<DataValueMember Name="Over_Voltage" DataType="BOOL" Value="0"/>
<DataValueMember Name="Under_Voltage" DataType="BOOL" Value="0"/>
<DataValueMember Name="Over_Current" DataType="BOOL" Value="0"/>
<DataValueMember Name="Open_Motor_Windings" DataType="BOOL" Value="0"/>
<DataValueMember Name="Bad_Encoder" DataType="BOOL" Value="0"/>
<DataValueMember Name="Comm_Error" DataType="BOOL" Value="0"/>
<DataValueMember Name="Bad_Flash" DataType="BOOL" Value="0"/>
<DataValueMember Name="No_Move" DataType="BOOL" Value="0"/>
<DataValueMember Name="NA_1" DataType="BOOL" Value="0"/>
<DataValueMember Name="Blank_Q_Segment" DataType="BOOL" Value="0"/>
<DataValueMember Name="NA_2" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Create readable local copy of the input assembly and status]]>
</Comment>
<Text>
<![CDATA[COP(Input[0],Loc_Input_Assembly,1)COP(Loc_Input_Assembly.Status_Code,Loc_StatusCode,1)COP(Loc_Input_Assembly.Alarm_Code,Loc_AlarmCode,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Make sure the ethernet/ip commands are maintained long enough to catch at least one RPI cycle 
(we maintain signals 30% longer than nominal RPI).]]>
</Comment>
<Text>
<![CDATA[MUL(RPI,1.3,Loc_CommandOff_Timer.PRE)MUL(RPI,1.3,Loc_CommandOn_Timer.PRE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Wait for command word to be zero for a long enough time (to ensure command value is idle)]]>
</Comment>
<Text>
<![CDATA[EQU(Output[0],0)TON(Loc_CommandOff_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[When command trigger is received, set state=20 if motor was not faulted, otherwise go to the error state=10
(Clear the output assembly command word, in case it wasn't already zero = idle)
]]>
</Comment>
<Text>
<![CDATA[XIC(Start)ONS(Loc_Start_ONS)[XIO(Loc_StatusCode.Drive_Fault) [CLR(Output[0]) ,MOV(20,State) ] ,XIC(Loc_StatusCode.Drive_Fault) MOV(10,State) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 20 - Make sure the command word is idle, then set state=30]]>
</Comment>
<Text>
<![CDATA[EQU(State,20)XIC(Loc_CommandOff_Timer.DN)MOV(30,State);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 30 - Scale input parameters and set appropriate registers for this command

Distance in motor steps, no conversion required
Speed in rev/s, converted to 0.25 rev/min
Acceleration in rev/s/s, converted to 10 rev/min/s
Deceleration in rev/s/s, converted to 10 rev/min/s]]>
</Comment>
<Text>
<![CDATA[EQU(State,30)[MOV(Position,Output[7]) ,MUL(Speed,240.0,Output[4]) ,MUL(Acc,6.0,Output[5]) ,MUL(Dec,6.0,Output[6]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 30 - Set output command bit for the set hold time 
(if timer preset is zero, then command is maintained for one full scan)]]>
</Comment>
<Text>
<![CDATA[EQU(State,30)[MOV(16#0010,Output[0]) ,TON(Loc_CommandOn_Timer,?,?) ,XIC(Loc_CommandOn_Timer.DN) MOV(40,State) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 40 - When the command has been held high long enough, clear the command]]>
</Comment>
<Text>
<![CDATA[EQU(State,40)[CLR(Output[0]) ,MOV(50,State) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 50 - Hold the idle command value (0) for a set time long enough to reach the next RPI cycle]]>
</Comment>
<Text>
<![CDATA[EQU(State,50)XIC(Loc_CommandOff_Timer.DN)MOV(60,State);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 60 - Wait for the status to indicate that the command was successful, then move to final state=70
If an error is detected, set the error state=80]]>
</Comment>
<Text>
<![CDATA[EQU(State,60)[XIO(Loc_StatusCode.Moving) XIC(Loc_StatusCode.Enabled) XIO(Loc_StatusCode.Drive_Fault) MOV(70,State) ,[XIC(Loc_StatusCode.Drive_Fault) ,XIO(Loc_StatusCode.Moving) XIO(Loc_StatusCode.Enabled) ] MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 70 - Final state. Hold Done output until the next execution of this AOI instance.]]>
</Comment>
<Text>
<![CDATA[EQU(State,70)OTE(Done);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Exception: if a problem is detected either during before or during execution of the command, set the Error output bit]]>
</Comment>
<Text>
<![CDATA[[EQU(State,10) ,EQU(State,80) ]OTE(Error);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[If sequence is started and has not yet reached a final state, then indicate "In Progress"]]>
</Comment>
<Text>
<![CDATA[LIM(20,State,60)OTE(In_Progress);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[If sequence is passed the state where the command has been sent, then indicate "Sent"]]>
</Comment>
<Text>
<![CDATA[LIM(60,State,80)OTE(Sent);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AMP_Alarm_Code" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2012-03-28T13:25:24.614Z" CreatedBy="MATT-F3A979C4EF\Administrator" EditedDate="2018-03-29T21:18:44.454Z" EditedBy="VM-RS2015-W7XX\Grantek" SoftwareRevision="v20.04"
>
<Description>
<![CDATA[Applied Motion - Alarm Code - AOI]]>
