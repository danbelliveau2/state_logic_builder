<Routine Name="BoxShift_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Box Shift Control State Machine]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(BoxShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BoxShift_SM.Status.State[0])XIC(MainAssemblyOK)MOV(1,BoxShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOV(2,BoxShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOV(3,BoxShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(BoxShift_SM.Status.State[2]) XIC(CycleStartLatch) XIC(r05Packaging_IN.Input[7].4) XIO(r05Packaging_IN.Input[7].3) XIC(AOI_PackBoxAtIn_DB.On) ,XIC(BoxShift_SM.Status.State[18]) XIC(r05Packaging_IN.Input[8].7) ]XIC(AOI_PackBoxAtOut_DB.Off)MOV(4,BoxShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(BoxShift_SM.Status.State[4])XIC(r05Packaging_IN.Input[8].3)XIO(r05Packaging_IN.Input[7].7)XIC(BoxShift_SM.Control.Timer[1].DN)MOV(6,BoxShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[[XIC(BoxShift_SM.Status.State[60]) XIC(BoxShift_SM.Control.Bit[0]) ,XIC(BoxShift_SM.Status.State[6]) XIC(BoxShift_SM.Control.Timer[0].DN) XIC(BinSelected) XIC(r05Packaging_IN.Input[8].4) ] XIO(r05Packaging_IN.Input[5].3) XIC(AOI_PackBoxAtOut_DB.Off) ,XIC(BoxShift_SM.Status.State[2]) XIC(CycleStartLatch) [XIO(r05Packaging_IN.Input[7].4) ,XIC(r05Packaging_IN.Input[7].3) ,XIO(AOI_PackBoxAtIn_DB.On) ,XIO(AOI_PackBoxAtOut_DB.Off) ] OTL(BoxShift_SM.Control.Bit[2]) ]MOV(8,BoxShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(BoxShift_SM.Status.State[8])XIC(r05Packaging_IN.Input[8].1)MOV(10,BoxShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(BoxShift_SM.Status.State[10])XIC(r05Packaging_IN.Input[7].7)XIO(r05Packaging_IN.Input[8].3)[XIO(BoxShift_SM.Control.Bit[2]) MOV(12,BoxShift_SM.Control.StateReg) ,XIC(BoxShift_SM.Control.Bit[2]) MOV(14,BoxShift_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(BoxShift_SM.Status.State[12])[XIC(r05Packaging_IN.Input[7].3) ,XIC(AOI_PackBoxAtOut_DB.On) ]XIO(r05Packaging_IN.Input[7].4)XIC(AOI_PackBoxAtIn_DB.Off)XIC(AOI_PackBoxAtOut_DB.On)MOV(14,BoxShift_SM.Control.StateReg);]]>
</Text>
