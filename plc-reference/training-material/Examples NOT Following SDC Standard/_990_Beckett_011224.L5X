<Routine Name="Tag_Import" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//*********************************]]>
</Line>
<Line Number="1">
<![CDATA[//BECKETT ADDED CODE By Mike Gibel*]]>
</Line>
<Line Number="2">
<![CDATA[//*********************************]]>
</Line>
<Line Number="3">
<![CDATA[// Purpose: Best way to import    *]]>
</Line>
<Line Number="4">
<![CDATA[//          tags in mass. At the  *]]>
</Line>
<Line Number="5">
<![CDATA[//          end bit turns off to  *]]>
</Line>
<Line Number="6">
<![CDATA[//          prevent reload.       *]]>
</Line>
<Line Number="7">
<![CDATA[//*********************************]]>
</Line>
<Line Number="8">
<![CDATA[// To Prevent accidently running  *]]>
</Line>
<Line Number="9">
<![CDATA[// TND command was added to end   *]]>
</Line>
<Line Number="10">
<![CDATA[// the routine before it starts.  *]]>
</Line>
<Line Number="11">
<![CDATA[// If you intended to use it, then*]]>
</Line>
<Line Number="12">
<![CDATA[// just comment it out and run it.*]]>
</Line>
<Line Number="13">
<![CDATA[//*********************************]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[TND( );]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
