<Routine Name="unic2ascii" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(next_file_response.name[0],CF_RW_functions.strings[f_nr].LEN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[RES(falctrl01)FAL(falctrl01,?,?,ALL,CF_RW_functions.strings[f_nr].DATA[falctrl01.POS],next_file_response.name[falctrl01.POS+1]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Stop when extra info is not required]]>
</Comment>
<Text>
<![CDATA[XIO(extra_info)TND();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[add spaces]]>
</Comment>
<Text>
<![CDATA[LES(CF_RW_functions.strings[f_nr].LEN,20)[SUB(20,CF_RW_functions.strings[f_nr].LEN,spacestring.LEN) ,CONCAT(CF_RW_functions.strings[f_nr],spacestring,CF_RW_functions.strings[f_nr]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[MOV(8,tempstring.LEN) MOV(32,tempstring.DATA[0]) ,XIC(next_file_response.fflags.0) MOV(82,tempstring.DATA[1]) ,XIO(next_file_response.fflags.0) MOV(45,tempstring.DATA[1]) ,XIC(next_file_response.fflags.1) MOV(72,tempstring.DATA[2]) ,XIO(next_file_response.fflags.1) MOV(45,tempstring.DATA[2]) ,XIC(next_file_response.fflags.2) MOV(83,tempstring.DATA[3]) ,XIO(next_file_response.fflags.2) MOV(45,tempstring.DATA[3]) ,XIC(next_file_response.fflags.4) MOV(68,tempstring.DATA[4]) ,XIO(next_file_response.fflags.4) MOV(45,tempstring.DATA[4]) ,XIC(next_file_response.fflags.5) MOV(65,tempstring.DATA[5]) ,XIO(next_file_response.fflags.5) MOV(45,tempstring.DATA[5]) ,XIC(next_file_response.fflags.3) MOV(86,tempstring.DATA[6]) ,XIO(next_file_response.fflags.3) MOV(45,tempstring.DATA[6]) ,MOV(32,tempstring.DATA[7]) ,CONCAT(CF_RW_functions.strings[f_nr],tempstring,CF_RW_functions.strings[f_nr]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[COP(next_file_response.size,tempDINTAR[0],2) ,BTD(tempDINTAR[0],10,tempDINT,0,22) ,BTD(tempDINTAR[1],0,tempDINT,22,10) ,DTOS(tempDINT,tempstring) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[LES(tempstring.LEN,10)[SUB(10,tempstring.LEN,spacestring.LEN) ,CONCAT(spacestring,tempstring,tempstring) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[CONCAT(CF_RW_functions.strings[f_nr],tempstring,CF_RW_functions.strings[f_nr]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[CONCAT(CF_RW_functions.strings[f_nr],bytestring,CF_RW_functions.strings[f_nr]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
