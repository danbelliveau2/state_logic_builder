<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(MachineRunning)XIC(TfrConveyor_SM.Status.Faulted)MOV(63,TfrConveyor_SM.Control.StateReg);]]>
</Text>
</Rung>
