<Routine Name="Indexer_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[TfrConveyor Control State Machine

State 0: Not Running
State 1: First Scan
State 2: Automatic Mode
State 3: Manual Mode
State 4: Index One Position
State 8: Index Complete
State 9: Wait All Stations Complete
State 20: Check All Actuators In Safe Position
State 62: Cycle Stop
State 63: Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(TfrConveyor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQU(Recipe.Running.DINTSpares[0],1)OTE(BinSelected);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(TfrConveyor_SM.Status.State[0])XIC(MainAssemblyOK)MOV(1,TfrConveyor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOV(2,TfrConveyor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOV(3,TfrConveyor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(TfrConveyor_SM.Status.State[20])XIC(TfrConveyor_SM.Control.Bit[2])[XIC(TfrConvHeadEmpty_PE) ,XIC(Supervisor_SM.Control.Bit[6]) ,XIO(TfrConveyor_SM.Control.Bit[0]) ,XIO(UnloadStatus[5].S1Success) ]MOV(4,TfrConveyor_SM.Control.StateReg)[RES(TfrConveyor_SM.Control.Counter[0]) ,OTU(TfrConveyor_SM.Control.Bit[8]) ,OTU(TfrConveyor_SM.Control.Bit[9]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(TfrConveyor_SM.Status.State[4])XIO(TfrConveyor_MAM.PC)XIO(TfrConveyor_SM.Control.Bit[0])[[XIO(TfrConveyor_SM.Control.Bit[7]) ,XIC(MachineBasic.AlwaysOn) ] MOV(6,TfrConveyor_SM.Control.StateReg) ,XIC(MachineBasic.AlwaysOff) XIC(TfrConveyor_SM.Control.Bit[7]) MOV(11,TfrConveyor_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(TfrConveyor_SM.Status.State[6])XIO(TfrConveyor_SM.Control.Bit[7])XIC(TfrConveyor_MAM.PC)XIC(TfrConveyor_SM.Control.Bit[0])[XIC(BinSelected) EQU(TCModulusS1,1) ,XIO(BinSelected) ]MOV(8,TfrConveyor_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(TfrConveyor_SM.Status.State[6])XIC(TfrConveyor_SM.Control.Bit[7])XIC(TfrConveyor_MAS.PC)[XIC(TfrConveyor_SM.Control.Bit[0]) [XIC(BinSelected) EQU(TCModulusS1,1) ,XIO(BinSelected) ] MOV(10,TfrConveyor_SM.Control.StateReg) ,[XIO(TfrConveyor_SM.Control.Bit[0]) ,XIC(TfrConveyor_SM.Control.Bit[0]) XIC(BinSelected) EQU(TCModulusS1,0) ] MOV(11,TfrConveyor_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(TfrConveyor_SM.Status.State[8])MOV(9,TfrConveyor_SM.Control.StateReg);]]>
