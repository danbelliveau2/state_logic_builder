<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(EnableIn)XIO(IP)[MOV(0,TorqueHome_CS) ,OTL(IP) ,OTU(Error) ,OTU(PC) ];]]>
