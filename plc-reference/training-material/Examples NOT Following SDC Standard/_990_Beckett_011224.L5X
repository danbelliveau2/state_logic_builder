<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[When the command trigger is received and start conditions are deemed ok, set state=12
if trigger is received when start conditions indicate that failure is inevitable, set state=10
(Clear the output assembly command word, in case it wasn't already zero = idle)]]>
</Comment>
<Text>
<![CDATA[XIC(Configure)ONS(Loc_Start_ONS)[XIO(SendMsg.EN) MOV(12,State) ,XIC(SendMsg.EN) MOV(10,State) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 12 - KP - Proportional Constant

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KP" parameter (operand =16#07) with data = Global Gain Value]]>
</Comment>
<Text>
<![CDATA[EQU(State,12)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#07,MSG_Write[3])BTD(KP,8,MSG_Write[4],0,8)BTD(KP,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(13,State);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(State,13)XIC(SendMsg.EN)MOV(14,State);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(State,14)[XIC(SendMsg.DN) MOV(15,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 15 - KF - Velocity Feedforward Constant

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KF" parameter (operand =16#0A) with data = Velocity Damping / Proportional Gain]]>
</Comment>
<Text>
<![CDATA[EQU(State,15)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#0A,MSG_Write[3])BTD(KF,8,MSG_Write[4],0,8)BTD(KF,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(16,State);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(State,16)XIC(SendMsg.EN)MOV(17,State);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(State,17)[XIC(SendMsg.DN) MOV(18,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 18 - KD - Differential Constant 

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KD" parameter (operand =16#0D) with data = provided damping gain value]]>
</Comment>
<Text>
<![CDATA[EQU(State,18)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#0D,MSG_Write[3])BTD(KD,8,MSG_Write[4],0,8)BTD(KD,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(19,State);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQU(State,19)XIC(SendMsg.EN)MOV(20,State);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(State,20)[XIC(SendMsg.DN) MOV(21,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 21 - KV - Velocity Feedback Constant

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KV" parameter (operand =16#09) with data = provided velocity gain value]]>
</Comment>
<Text>
<![CDATA[EQU(State,21)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#09,MSG_Write[3])BTD(KV,8,MSG_Write[4],0,8)BTD(KV,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(22,State);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[EQU(State,22)XIC(SendMsg.EN)MOV(23,State);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[EQU(State,23)[XIC(SendMsg.DN) MOV(24,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 24 - KI - Integrator Constant

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KI" parameter (operand =16#08) with data = provided integral gain value]]>
</Comment>
<Text>
<![CDATA[EQU(State,24)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#08,MSG_Write[3])BTD(KI,8,MSG_Write[4],0,8)BTD(KI,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(25,State);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[EQU(State,25)XIC(SendMsg.EN)MOV(26,State);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[EQU(State,26)[XIC(SendMsg.DN) MOV(27,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 27 - KK - Inertia Feedforward Constant

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KK" parameter (operand =16#0C) with data = Inertia Feedforward Gain]]>
</Comment>
<Text>
<![CDATA[EQU(State,27)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#0C,MSG_Write[3])BTD(KK,8,MSG_Write[4],0,8)BTD(KK,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(28,State);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[EQU(State,28)XIC(SendMsg.EN)MOV(29,State);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[EQU(State,29)[XIC(SendMsg.DN) MOV(30,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 30 - KE - Differential Filter

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KE" parameter (operand =16#4F) with data = provided Damping filter gain value. Filter value = (72090 / (1400/F + 2.2), where F = desired filter Frequency in Hz.]]>
</Comment>
<Text>
<![CDATA[EQU(State,30)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#4F,MSG_Write[3])BTD(KE,8,MSG_Write[4],0,8)BTD(KE,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(31,State);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[EQU(State,31)XIC(SendMsg.EN)MOV(32,State);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[EQU(State,32)[XIC(SendMsg.DN) MOV(33,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[State 33 - KC - Overall Servo Filter

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KC" parameter (operand =16#51) with 
data = provided current filter gain value. Filter value = (72090 / (1400/F + 2.2), where F = desired filter Frequency in Hz.]]>
</Comment>
<Text>
<![CDATA[EQU(State,33)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#51,MSG_Write[3])BTD(KC,8,MSG_Write[4],0,8)BTD(KC,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(34,State);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[EQU(State,34)XIC(SendMsg.EN)MOV(35,State);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[EQU(State,35)[XIC(SendMsg.DN) MOV(36,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[[EQU(State,13) ,EQU(State,16) ,EQU(State,19) ,EQU(State,22) ,EQU(State,25) ,EQU(State,28) ,EQU(State,31) ,EQU(State,34) ]MSG(SendMsg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Last Configuration setting is complete. Wait for Message instruction to be non-enabled]]>
</Comment>
<Text>
<![CDATA[EQU(State,36)XIO(SendMsg.EN)MOV(60,State);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[State 60 - Wait for the status to indicate that the command was successful, then move to final state=70
If an error is detected, set the error state=80
[The command was successful when all parameters have been sent]]]>
</Comment>
<Text>
<![CDATA[EQU(State,60)MOV(70,State);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[State 70 - Final state. Hold Done output until the next execution of this AOI instance.]]>
</Comment>
<Text>
<![CDATA[EQU(State,70)OTE(Done);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Exception: if a problem is detected either during before or during execution of the command, set the Error output bit]]>
</Comment>
<Text>
<![CDATA[[EQU(State,10) ,EQU(State,80) ]OTE(Error);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[If sequence is started and has not yet reached a final state, then indicate "In Progress"]]>
</Comment>
<Text>
<![CDATA[LIM(12,State,60)OTE(In_Progress);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[If sequence is passed the state where the command has been sent, then indicate "Sent"]]>
</Comment>
<Text>
<![CDATA[LIM(60,State,80)OTE(Sent);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AMP_Tuning_Params_StepSERVO" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-11-16T21:13:24.555Z" CreatedBy="VM-RS2015-W7XX\Grantek" EditedDate="2018-03-21T21:08:37.613Z" EditedBy="VM-RS2015-W7XX\Grantek" SoftwareRevision="v20.04"
>
<Description>
<![CDATA[Applied Motion - Tuning Parameters StepSERVO AOI]]>
</Description>
<AdditionalHelpText>
<![CDATA[The Tuning Parameters for StepSERVO AOI accepts all the required parameters for SCL commands VP, VI, KK, KC, KP, KD and KE, and then scales and issues these to the drive, one at a time.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="MSG_Write" TagType="Base" DataType="SINT" Dimensions="8" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Message Write data tag]]>
</Description>
<Comments>
<Comment Operand="[0]">
<![CDATA[Message Reserved = 0]]>
</Comment>
<Comment Operand="[1]">
<![CDATA[Message Type (16#01 or 16#02)]]>
</Comment>
<Comment Operand="[2]">
<![CDATA[Type 1: Register
Type 2: Opcode]]>
</Comment>
<Comment Operand="[3]">
<![CDATA[Type 1: Opcode
Type 2: Operand]]>
</Comment>
<Comment Operand="[4]">
<![CDATA[Type 1: Parameter 1
Type 2: data MSB]]>
</Comment>
<Comment Operand="[5]">
<![CDATA[Type 1: Parameter 2
Type 2: data LSB]]>
</Comment>
<Comment Operand="[6]">
<![CDATA[Type 1: Parameter 3
Type 2: not used]]>
</Comment>
<Comment Operand="[7]">
<![CDATA[Type 1: Parameter 4
Type 2: not used]]>
</Comment>
</Comments>
</Parameter>
<Parameter Name="SendMsg" TagType="Base" DataType="MESSAGE" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Message tag]]>
</Description>
</Parameter>
<Parameter Name="MSG_Response" TagType="Base" DataType="SINT" Dimensions="8" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Message Response data tag]]>
</Description>
<Comments>
<Comment Operand="[0]">
<![CDATA[Command Word]]>
</Comment>
<Comment Operand="[1]">
<![CDATA[Jog Speed (0.25 rev/min)]]>
</Comment>
<Comment Operand="[2]">
<![CDATA[Jog Acceleration (10 rev/s/s)]]>
</Comment>
<Comment Operand="[3]">
<![CDATA[Jog Deceleration (10 rev/s/s)]]>
</Comment>
<Comment Operand="[4]">
<![CDATA[Point-to-Point Velocity (0.25 rev/min)]]>
</Comment>
<Comment Operand="[5]">
<![CDATA[Point-to-Point Acceleration (10 rev/s/s)]]>
</Comment>
<Comment Operand="[6]">
<![CDATA[Point-to-Point Deceleration (10 rev/s/s)]]>
</Comment>
<Comment Operand="[7]">
<![CDATA[Point-to-Point Distance (Motor steps)]]>
</Comment>
</Comments>
</Parameter>
<Parameter Name="Configure" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Start the Configuration]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="VP" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Velocity Mode Proportional Constant]]>
</Description>
<DefaultData Format="L5K">
