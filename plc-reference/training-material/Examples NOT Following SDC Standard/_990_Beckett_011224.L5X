<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(TfrConveyor_SM.Status.State[9]) ,XIC(TfrConveyor_SM.Status.State[40]) ,XIC(TfrConveyor_SM.Status.State[61]) ]XIO(CycleStartLatch)TON(TfrConveyor_SM.Control.Timer[4],?,?)XIC(TfrConveyor_SM.Control.Timer[4].DN)MOV(62,TfrConveyor_SM.Control.StateReg);]]>
