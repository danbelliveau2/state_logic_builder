<Routines>
<Routine Name="Gantry_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Top Shell Gantry Control State Machine]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(TSGantry_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(TSGantry_SM.Status.State[0])XIC(TSSafetyOK)MOV(1,TSGantry_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOV(2,TSGantry_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOV(3,TSGantry_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CPT(TSGantryLocation,(((TSGantryRow-1)*3)+TSGantryColumn));]]>
</Text>
</Rung>
