<Routine Name="StationDataCount_SUB" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FOR i:=169 TO 2 BY -1 DO]]>
</Line>
<Line Number="1">
<![CDATA[	COP(StationDataCounts[i-1],StationDataCounts[i],1);]]>
</Line>
<Line Number="2">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[COP(StationDataCountsEmpty,StationDataCounts[1],1);]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[StationDataCounts[1].Date[0]:= WallClockTime[1];]]>
</Line>
<Line Number="7">
<![CDATA[StationDataCounts[1].Date[1]:= WallClockTime[2];]]>
</Line>
<Line Number="8">
<![CDATA[StationDataCounts[1].Date[2]:= WallClockTime[0];]]>
</Line>
<Line Number="9">
<![CDATA[StationDataCounts[1].Hour:=WallClockTime[3];]]>
</Line>
<Line Number="10">
<![CDATA[StationDataCounts[1].Recipe := Recipe.Running.Name;]]>
</Line>
</STContent>
</Routine>
<Routine Name="StationDataLoadCount_SUB" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[IF StationDataCountsSelect < 1 THEN]]>
</Line>
<Line Number="1">
<![CDATA[	StationDataCountsSelect:= 1;]]>
</Line>
<Line Number="2">
<![CDATA[ELSIF StationDataCountsSelect > 169 THEN]]>
</Line>
<Line Number="3">
<![CDATA[	StationDataCountsSelect:= 169;]]>
</Line>
<Line Number="4">
<![CDATA[END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[COP(StationDataCounts[StationDataCountsSelect],StationDataCounts[0],1);]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[StationDataCountsSelectPrevious:=StationDataCountsSelect;]]>
</Line>
</STContent>
</Routine>
