</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sts_PC" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[It is set when the axis input AtReference bit is true.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sts_ERR" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Instruction error codes:
100 – Drive not ready.
101 – Drive faulted.
103 – MSF executing.
105 – Drive disabled.
107 – MAS executing.
108 – Other motion AOI sending the command.
111 – SpeedReference out of range.
112 – AccelReference out of range.
113 – DecelReference out of range.
117 – NonCyclicMoveType out of range.
118 – CyclicMoveType out of range.
119 – TravelMode either 2 or 10.
126 – Homing not completed.
127 – Previous motion not completed.
129 – Motor not connected.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
