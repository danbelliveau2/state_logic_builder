<![CDATA[[XIC(Supervisor_SM.Control.Bit[22]) [MOV(1,S01Control_SM.Control.Counter[0].PRE) ,MOV(1,S05Control_SM.Control.Counter[0].PRE) ,MOV(1,S07Control_SM.Control.Counter[0].PRE) ,MOV(1,S08Control_SM.Control.Counter[0].PRE) ] ,XIO(Supervisor_SM.Control.Bit[22]) [MOV(3,S01Control_SM.Control.Counter[0].PRE) ,MOV(3,S05Control_SM.Control.Counter[0].PRE) ,MOV(3,S07Control_SM.Control.Counter[0].PRE) ,MOV(3,S08Control_SM.Control.Counter[0].PRE) ] ];]]>
</Text>
</Rung>
