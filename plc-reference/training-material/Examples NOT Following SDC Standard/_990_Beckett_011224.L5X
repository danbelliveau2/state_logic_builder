<![CDATA[COP(StationData[2],StationData[3],1);]]>
</Line>
<Line Number="109">
<![CDATA[COP(StationData[1],StationData[2],1);]]>
</Line>
<Line Number="110">
<![CDATA[]]>
</Line>
<Line Number="111">
<![CDATA[//*********************************]]>
</Line>
<Line Number="112">
<![CDATA[//     Save the recipe name       *]]>
</Line>
<Line Number="113">
<![CDATA[//*********************************]]>
</Line>
<Line Number="114">
<![CDATA[StationData[1].Recipe := Recipe.Running.Name;]]>
</Line>
<Line Number="115">
<![CDATA[]]>
</Line>
<Line Number="116">
<![CDATA[//*********************************]]>
</Line>
<Line Number="117">
<![CDATA[// Steal Station Status for my own*]]>
</Line>
<Line Number="118">
<![CDATA[// nefarious purposes.            *]]>
</Line>
<Line Number="119">
<![CDATA[//*********************************]]>
</Line>
<Line Number="120">
<![CDATA[COP(StationStatus[1],StationData[1].StationStatus,1);]]>
</Line>
<Line Number="121">
<![CDATA[COP(StationStatus[20],StationData[20].StationStatus,1);]]>
</Line>
<Line Number="122">
<![CDATA[//*********************************]]>
</Line>
<Line Number="123">
<![CDATA[//Reset probe and blade data and  *]]>
</Line>
<Line Number="124">
<![CDATA[//and the state of S17.           *]]>
</Line>
<Line Number="125">
<![CDATA[//*********************************]]>
</Line>
<Line Number="126">
<![CDATA[StationData[1].S15.TopRight := 0;]]>
</Line>
<Line Number="127">
<![CDATA[StationData[1].S15.TopLeft := 0;]]>
</Line>
<Line Number="128">
<![CDATA[StationData[1].S15.BotRight := 0;]]>
</Line>
<Line Number="129">
<![CDATA[StationData[1].S15.BotLeft := 0;]]>
</Line>
<Line Number="130">
<![CDATA[StationData[1].S15.RightSide := 0;]]>
</Line>
<Line Number="131">
<![CDATA[StationData[1].S15.LeftSide := 0;]]>
</Line>
<Line Number="132">
<![CDATA[]]>
</Line>
<Line Number="133">
<![CDATA[StationData[1].S16.RightBlock := 0;]]>
</Line>
<Line Number="134">
<![CDATA[StationData[1].S16.RightOpen := 1;]]>
</Line>
<Line Number="135">
<![CDATA[StationData[1].S16.LeftBlock := 0;]]>
</Line>
<Line Number="136">
<![CDATA[StationData[1].S16.LeftOpen := 1;]]>
</Line>
<Line Number="137">
<![CDATA[]]>
</Line>
<Line Number="138">
<![CDATA[StationData[1].S17State := 0;]]>
</Line>
<Line Number="139">
<![CDATA[//*********************************]]>
</Line>
<Line Number="140">
<![CDATA[//Probe Data happens at station 15*]]>
</Line>
<Line Number="141">
<![CDATA[//but we have already indexed our *]]>
</Line>
<Line Number="142">
<![CDATA[//tracking data, so we store it in*]]>
</Line>
<Line Number="143">
<![CDATA[//station 16 slot.                *]]>
</Line>
<Line Number="144">
<![CDATA[//*********************************]]>
</Line>
<Line Number="145">
<![CDATA[StationData[16].S15.TopRight := S15ProbeTopRightPre;]]>
</Line>
<Line Number="146">
<![CDATA[StationData[16].S15.TopLeft := S15ProbeTopLeftPre;]]>
</Line>
<Line Number="147">
<![CDATA[StationData[16].S15.BotRight := S15ProbeBotRightPre;]]>
</Line>
<Line Number="148">
<![CDATA[StationData[16].S15.BotLeft := S15ProbeBotLeftPre;]]>
</Line>
<Line Number="149">
<![CDATA[StationData[16].S15.RightSide := S15ProbeRightSideTopPre-S15ProbeRightSideBotPre;]]>
</Line>
<Line Number="150">
<![CDATA[StationData[16].S15.LeftSide := S15ProbeLeftSideTopPre-S15ProbeLeftSideBotPre;]]>
</Line>
<Line Number="151">
<![CDATA[//*********************************]]>
</Line>
<Line Number="152">
<![CDATA[//    Same for the blade check.   *]]>
</Line>
<Line Number="153">
<![CDATA[//*********************************]]>
</Line>
<Line Number="154">
<![CDATA[StationData[17].S16.RightBlock := S16Control_SM.Control.Bit[2];]]>
</Line>
<Line Number="155">
<![CDATA[StationData[17].S16.RightOpen := S16Control_SM.Control.Bit[3];]]>
</Line>
<Line Number="156">
<![CDATA[StationData[17].S16.LeftBlock := S16Control_SM.Control.Bit[4];]]>
</Line>
<Line Number="157">
<![CDATA[StationData[17].S16.LeftOpen := S16Control_SM.Control.Bit[5];]]>
</Line>
<Line Number="158">
<![CDATA[//*********************************]]>
</Line>
<Line Number="159">
<![CDATA[//Tracking cycle time of each part*]]>
</Line>
<Line Number="160">
<![CDATA[//*********************************]]>
</Line>
<Line Number="161">
<![CDATA[FOR i:=3 TO 20 BY 1 DO]]>
</Line>
<Line Number="162">
<![CDATA[	StationData[i].CycleTimeTotal := StationData[i-1].CycleTimeTotal + HMI_Data.Status.CycleTime;]]>
</Line>
<Line Number="163">
<![CDATA[	StationData[i].CycleTimeAverage := StationData[i].CycleTimeTotal/(i-2);]]>
</Line>
<Line Number="164">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="165">
<![CDATA[StationData[2].CycleTimeTotal := HMI_Data.Status.CycleTime;]]>
</Line>
<Line Number="166">
<![CDATA[StationData[2].CycleTimeAverage := HMI_Data.Status.CycleTime;]]>
</Line>
<Line Number="167">
<![CDATA[StationData[1].CycleTimeTotal := 0;]]>
</Line>
<Line Number="168">
<![CDATA[StationData[1].CycleTimeAverage := 0;]]>
</Line>
<Line Number="169">
<![CDATA[//*********************************]]>
</Line>
<Line Number="170">
<![CDATA[//     Timestamp for failures.    *]]>
</Line>
<Line Number="171">
<![CDATA[//*********************************]]>
</Line>
<Line Number="172">
<![CDATA[COP(WallClockTime[0],StationData[20].Timestamp[0],7);]]>
</Line>
<Line Number="173">
<![CDATA[//*********************************]]>
</Line>
<Line Number="174">
<![CDATA[// This giant IF/ELSEIF statement *]]>
</Line>
<Line Number="175">
<![CDATA[// is to determine if we had a    *]]>
</Line>
<Line Number="176">
<![CDATA[// failure and if so we want to   *]]>
</Line>
<Line Number="177">
<![CDATA[// store the information about it *]]>
</Line>
<Line Number="178">
<![CDATA[// in the appropriate array.      *]]>
</Line>
<Line Number="179">
<![CDATA[//*********************************]]>
</Line>
<Line Number="180">
<![CDATA[IF (NOT StationData[20].StationStatus.S15Success) AND (StationData[20].StationStatus.S14Success) then]]>
</Line>
<Line Number="181">
<![CDATA[	FOR i:=50 TO 1 BY -1 DO]]>
</Line>
<Line Number="182">
<![CDATA[	COP(S15FailureSaved[i-1],S15FailureSaved[i],1);]]>
</Line>
<Line Number="183">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="184">
<![CDATA[	S15FailureSaved[1].Head := StationData[20].StationStatus.HeadNumber;]]>
</Line>
<Line Number="185">
<![CDATA[	S15FailureSaved[1].Recipe := StationData[20].Recipe;]]>
</Line>
<Line Number="186">
<![CDATA[	COP(StationData[20].S15,S15FailureSaved[1].S15,1);]]>
</Line>
<Line Number="187">
<![CDATA[	COP(StationData[20].Timestamp[0],S15FailureSaved[1].Timestamp[0],7);]]>
</Line>
<Line Number="188">
<![CDATA[ELSIF (NOT StationData[20].StationStatus.S16Success) AND (StationData[20].StationStatus.S15Success) then]]>
</Line>
<Line Number="189">
<![CDATA[	FOR i:=50 TO 1 BY -1 DO]]>
</Line>
<Line Number="190">
<![CDATA[	COP(S16FailureSaved[i-1],S16FailureSaved[i],1);]]>
</Line>
<Line Number="191">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="192">
<![CDATA[	S16FailureSaved[1].Head := StationData[20].StationStatus.HeadNumber;]]>
</Line>
<Line Number="193">
<![CDATA[	S16FailureSaved[1].Recipe := StationData[20].Recipe;]]>
</Line>
<Line Number="194">
<![CDATA[	COP(StationData[20].S16,S16FailureSaved[1].S16,1);]]>
</Line>
<Line Number="195">
<![CDATA[	COP(StationData[20].Timestamp[0],S16FailureSaved[1].Timestamp[0],7);]]>
</Line>
<Line Number="196">
<![CDATA[ELSIF (NOT StationData[20].StationStatus.S17Success) AND (StationData[20].StationStatus.S16Success) then]]>
</Line>
<Line Number="197">
<![CDATA[	FOR i:=50 TO 1 BY -1 DO]]>
</Line>
<Line Number="198">
<![CDATA[	COP(S17FailureSaved[i-1],S17FailureSaved[i],1);]]>
</Line>
<Line Number="199">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="200">
<![CDATA[	S17FailureSaved[1].Head := StationData[20].StationStatus.HeadNumber;]]>
</Line>
<Line Number="201">
<![CDATA[	S17FailureSaved[1].Recipe := StationData[20].Recipe;]]>
</Line>
<Line Number="202">
<![CDATA[	S17FailureSaved[1].S17State := StationData[20].S17State;]]>
</Line>
<Line Number="203">
<![CDATA[	COP(StationData[20].Timestamp[0],S17FailureSaved[1].Timestamp[0],7);]]>
</Line>
<Line Number="204">
<![CDATA[END_IF;]]>
</Line>
<Line Number="205">
<![CDATA[//*********************************]]>
</Line>
<Line Number="206">
<![CDATA[// We are also tracking the cycle *]]>
</Line>
<Line Number="207">
<![CDATA[// time from the last 1000 parts  *]]>
</Line>
<Line Number="208">
<![CDATA[// so we can track the change in  *]]>
</Line>
<Line Number="209">
<![CDATA[// rate over time a little better *]]>
</Line>
<Line Number="210">
<![CDATA[//*********************************]]>
</Line>
<Line Number="211">
<![CDATA[CycleTimeArray[0]:= HMI_Data.Status.CycleTime;]]>
</Line>
<Line Number="212">
<![CDATA[IF CycleTimeMakePerfect then]]>
</Line>
<Line Number="213">
<![CDATA[	For i:=1 to 1000 By 1 do]]>
</Line>
<Line Number="214">
<![CDATA[		CycleTimeArray[i] := 2;]]>
</Line>
<Line Number="215">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="216">
<![CDATA[	CycleTimeMakePerfect := 0;]]>
</Line>
<Line Number="217">
<![CDATA[END_IF;]]>
</Line>
<Line Number="218">
<![CDATA[FOR i:=1000 to 1 BY -1 DO]]>
</Line>
<Line Number="219">
<![CDATA[	COP(CycleTimeArray[i-1],CycleTimeArray[i],1);]]>
</Line>
<Line Number="220">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="221">
<![CDATA[CycleTimeLast10 := 0;]]>
</Line>
<Line Number="222">
<![CDATA[FOR i:=1 to 10 BY 1 do]]>
</Line>
<Line Number="223">
<![CDATA[	CycleTimeLast10 := CycleTimeArray[i] + CycleTimeLast10;]]>
</Line>
<Line Number="224">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="225">
<![CDATA[CycleTimeLast100 := 0;]]>
</Line>
<Line Number="226">
<![CDATA[FOR i:=1 to 100 BY 1 do]]>
</Line>
<Line Number="227">
<![CDATA[	CycleTimeLast100 := CycleTimeArray[i] + CycleTimeLast100;]]>
</Line>
<Line Number="228">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="229">
<![CDATA[CycleTimeLast500 := 0;]]>
</Line>
<Line Number="230">
<![CDATA[FOR i:=1 to 500 BY 1 do]]>
</Line>
<Line Number="231">
<![CDATA[	CycleTimeLast500 := CycleTimeArray[i] + CycleTimeLast500;]]>
</Line>
<Line Number="232">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="233">
<![CDATA[CycleTimeLast1000 := 0;]]>
</Line>
<Line Number="234">
<![CDATA[FOR i:=1 to 1000 BY 1 do]]>
</Line>
<Line Number="235">
<![CDATA[	CycleTimeLast1000 := CycleTimeArray[i] + CycleTimeLast1000;]]>
</Line>
<Line Number="236">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="237">
<![CDATA[CycleTimeAverageLast10 := CycleTimeLast10 / 10;]]>
</Line>
<Line Number="238">
<![CDATA[CycleTimeAverageLast100 := CycleTimeLast100 / 100;]]>
</Line>
<Line Number="239">
<![CDATA[CycleTimeAverageLast500 := CycleTimeLast500 / 500;]]>
</Line>
<Line Number="240">
<![CDATA[CycleTimeAverageLast1000 := CycleTimeLast1000 / 1000;]]>
</Line>
<Line Number="241">
<![CDATA[//*********************************]]>
</Line>
<Line Number="242">
<![CDATA[// Once the average cycle time of *]]>
</Line>
<Line Number="243">
<![CDATA[// the last 25 parts reaches a    *]]>
</Line>
<Line Number="244">
<![CDATA[// certain number warning will pop*]]>
</Line>
<Line Number="245">
<![CDATA[// up.                            *]]>
</Line>
<Line Number="246">
<![CDATA[//*********************************]]>
</Line>
<Line Number="247">
<![CDATA[IF CycleTimeS01Reset THEN]]>
</Line>
<Line Number="248">
<![CDATA[	FOR i:=0 to 50 By 1 DO]]>
</Line>
<Line Number="249">
<![CDATA[		CycleTimeS01Last50[i] := 0;]]>
</Line>
<Line Number="250">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="251">
<![CDATA[	CycleTimeS01Reset := 0;]]>
</Line>
<Line Number="252">
<![CDATA[	HMI_Debug[0] := 0;]]>
</Line>
<Line Number="253">
<![CDATA[END_IF;]]>
</Line>
<Line Number="254">
<![CDATA[]]>
</Line>
<Line Number="255">
<![CDATA[IF CycleTimeS05Reset THEN]]>
</Line>
<Line Number="256">
<![CDATA[	FOR i:=0 to 50 By 1 DO]]>
</Line>
<Line Number="257">
<![CDATA[		CycleTimeS05Last50[i] := 0;]]>
</Line>
<Line Number="258">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="259">
<![CDATA[	CycleTimeS05Reset := 0;]]>
</Line>
<Line Number="260">
<![CDATA[	HMI_Debug[0] := 0;]]>
</Line>
<Line Number="261">
<![CDATA[END_IF;]]>
</Line>
<Line Number="262">
<![CDATA[]]>
</Line>
<Line Number="263">
<![CDATA[IF CycleTimeS07Reset THEN]]>
</Line>
<Line Number="264">
<![CDATA[	FOR i:=0 to 50 By 1 DO]]>
</Line>
<Line Number="265">
<![CDATA[		CycleTimeS07Last50[i] := 0;]]>
</Line>
<Line Number="266">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="267">
<![CDATA[	CycleTimeS07Reset := 0;]]>
</Line>
<Line Number="268">
<![CDATA[	HMI_Debug[0] := 0;]]>
</Line>
<Line Number="269">
<![CDATA[END_IF;]]>
</Line>
<Line Number="270">
<![CDATA[]]>
</Line>
<Line Number="271">
<![CDATA[CycleTimeS01Last50[0]:= CycleTimeStorage[1]/1000;]]>
</Line>
<Line Number="272">
<![CDATA[CycleTimeS05Last50[0]:= CycleTimeStorage[5]/1000;]]>
</Line>
<Line Number="273">
<![CDATA[CycleTimeS07Last50[0]:= CycleTimeStorage[7]/1000;]]>
</Line>
<Line Number="274">
<![CDATA[]]>
</Line>
<Line Number="275">
<![CDATA[FOR i:=50 to 1 BY -1 do]]>
</Line>
<Line Number="276">
<![CDATA[	COP(CycleTimeS01Last50[i-1],CycleTimeS01Last50[i],1);]]>
</Line>
<Line Number="277">
<![CDATA[	COP(CycleTimeS05Last50[i-1],CycleTimeS05Last50[i],1);]]>
</Line>
<Line Number="278">
<![CDATA[	COP(CycleTimeS07Last50[i-1],CycleTimeS07Last50[i],1);]]>
</Line>
<Line Number="279">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="280">
<![CDATA[]]>
</Line>
<Line Number="281">
<![CDATA[CycleTimeS01 := 0;]]>
</Line>
<Line Number="282">
<![CDATA[CycleTimeS05 := 0;]]>
</Line>
<Line Number="283">
<![CDATA[CycleTimeS07 := 0;]]>
</Line>
<Line Number="284">
<![CDATA[]]>
</Line>
<Line Number="285">
<![CDATA[FOR i:=1 to 25 BY 1 do]]>
</Line>
<Line Number="286">
<![CDATA[	CycleTimeS01 := CycleTimeS01 + CycleTimeS01Last50[i];]]>
</Line>
<Line Number="287">
<![CDATA[	CycleTimeS05 := CycleTimeS05 + CycleTimeS05Last50[i];]]>
</Line>
<Line Number="288">
<![CDATA[	CycleTimeS07 := CycleTimeS07 + CycleTimeS07Last50[i];]]>
</Line>
<Line Number="289">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="290">
<![CDATA[]]>
</Line>
<Line Number="291">
<![CDATA[CycleTimeS01Average := CycleTimeS01/25;]]>
</Line>
<Line Number="292">
<![CDATA[CycleTimeS05Average := CycleTimeS05/25;]]>
</Line>
<Line Number="293">
<![CDATA[CycleTimeS07Average := CycleTimeS07/25;]]>
</Line>
<Line Number="294">
<![CDATA[]]>
</Line>
<Line Number="295">
<![CDATA[CycleTimeIndex := Indexer_SM.Control.Timer[3].ACC - CycleTimeStorage[0];]]>
</Line>
<Line Number="296">
<![CDATA[]]>
</Line>
<Line Number="297">
<![CDATA[//*********************************]]>
</Line>
<Line Number="298">
<![CDATA[//   Stack Light State for S01    *]]>
</Line>
<Line Number="299">
<![CDATA[//*********************************]]>
</Line>
<Line Number="300">
<![CDATA[IF ((CycleTimeS01Average < S01_StackLight_Cycle[0]) AND (CycleTimeStorage[1] < S01_StackLight_Pick[0])) THEN]]>
</Line>
<Line Number="301">
<![CDATA[	S01_StackLight_State := 0;]]>
</Line>
<Line Number="302">
<![CDATA[END_IF;]]>
</Line>
<Line Number="303">
<![CDATA[IF (((S01_StackLight_Cycle[0] <= CycleTimeS01Average) AND (CycleTimeS01Average < S01_StackLight_Cycle[1])) OR ((S01_StackLight_Pick[0] <= CycleTimeStorage[1]) AND (CycleTimeStorage[1] < S01_StackLight_Pick[1]))) THEN]]>
</Line>
<Line Number="304">
<![CDATA[	S01_StackLight_State := 1;]]>
</Line>
<Line Number="305">
<![CDATA[END_IF;]]>
</Line>
<Line Number="306">
<![CDATA[IF ((CycleTimeS01Average > S01_StackLight_Cycle[1]) OR (CycleTimeStorage[1] > S01_StackLight_Pick[1])) THEN]]>
</Line>
<Line Number="307">
<![CDATA[	S01_StackLight_State := 2;]]>
</Line>
<Line Number="308">
<![CDATA[END_IF;	]]>
</Line>
<Line Number="309">
<![CDATA[//*********************************]]>
</Line>
<Line Number="310">
<![CDATA[//   Stack Light State for S05    *]]>
</Line>
<Line Number="311">
<![CDATA[//*********************************]]>
</Line>
<Line Number="312">
<![CDATA[IF ((CycleTimeS05Average < S05_StackLight_Cycle[0]) AND (CycleTimeStorage[1] < S05_StackLight_Pick[0])) THEN]]>
</Line>
<Line Number="313">
<![CDATA[	S05_StackLight_State := 0;]]>
</Line>
<Line Number="314">
<![CDATA[END_IF;]]>
</Line>
<Line Number="315">
<![CDATA[IF (((S05_StackLight_Cycle[0] <= CycleTimeS05Average) AND (CycleTimeS05Average < S05_StackLight_Cycle[1])) OR ((S05_StackLight_Pick[0] <= CycleTimeStorage[1]) AND (CycleTimeStorage[1] < S05_StackLight_Pick[1]))) THEN]]>
</Line>
<Line Number="316">
<![CDATA[	S05_StackLight_State := 1;]]>
</Line>
<Line Number="317">
<![CDATA[END_IF;]]>
</Line>
<Line Number="318">
<![CDATA[IF ((CycleTimeS05Average > S05_StackLight_Cycle[1]) OR (CycleTimeStorage[1] > S05_StackLight_Pick[1])) THEN]]>
</Line>
<Line Number="319">
<![CDATA[	S05_StackLight_State := 2;]]>
</Line>
<Line Number="320">
<![CDATA[END_IF;	]]>
</Line>
<Line Number="321">
<![CDATA[//*********************************]]>
</Line>
<Line Number="322">
<![CDATA[//   Stack Light State for S07    *]]>
</Line>
<Line Number="323">
<![CDATA[//*********************************]]>
</Line>
<Line Number="324">
<![CDATA[IF ((CycleTimeS07Average < S07_StackLight_Cycle[0]) AND (CycleTimeStorage[1] < S07_StackLight_Pick[0])) THEN]]>
</Line>
<Line Number="325">
<![CDATA[	S07_StackLight_State := 0;]]>
</Line>
<Line Number="326">
<![CDATA[END_IF;]]>
</Line>
<Line Number="327">
<![CDATA[IF (((S07_StackLight_Cycle[0] <= CycleTimeS07Average) AND (CycleTimeS07Average < S07_StackLight_Cycle[1])) OR ((S07_StackLight_Pick[0] <= CycleTimeStorage[1]) AND (CycleTimeStorage[1] < S07_StackLight_Pick[1]))) THEN]]>
</Line>
<Line Number="328">
<![CDATA[	S07_StackLight_State := 1;]]>
</Line>
<Line Number="329">
<![CDATA[END_IF;]]>
</Line>
<Line Number="330">
<![CDATA[IF ((CycleTimeS07Average > S07_StackLight_Cycle[1]) OR (CycleTimeStorage[1] > S07_StackLight_Pick[1])) THEN]]>
</Line>
<Line Number="331">
<![CDATA[	S07_StackLight_State := 2;]]>
</Line>
<Line Number="332">
<![CDATA[END_IF;	]]>
</Line>
<Line Number="333">
<![CDATA[]]>
</Line>
<Line Number="334">
<![CDATA[FOR i := 1 to 11 BY 1 DO]]>
</Line>
<Line Number="335">
<![CDATA[	FOR j := 100 to 1 BY -1 DO]]>
</Line>
<Line Number="336">
<![CDATA[		COP(CycleTimeStorageArray[i,j-1],CycleTimeStorageArray[i,j],1);]]>
</Line>
<Line Number="337">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="338">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="339">
<![CDATA[]]>
</Line>
<Line Number="340">
<![CDATA[CycleTimeStorageArray[1,0] := CycleTimeStorage[1];]]>
</Line>
<Line Number="341">
<![CDATA[CycleTimeStorageArray[2,0] := CycleTimeStorage[5];]]>
</Line>
<Line Number="342">
<![CDATA[CycleTimeStorageArray[3,0] := CycleTimeStorage[7];]]>
</Line>
<Line Number="343">
<![CDATA[CycleTimeStorageArray[4,0] := CycleTimeStorage[11];]]>
</Line>
<Line Number="344">
<![CDATA[CycleTimeStorageArray[5,0] := CycleTimeStorage[14];]]>
</Line>
<Line Number="345">
<![CDATA[CycleTimeStorageArray[6,0] := CycleTimeStorage[15];]]>
</Line>
<Line Number="346">
<![CDATA[CycleTimeStorageArray[7,0] := CycleTimeStorage[16];]]>
</Line>
<Line Number="347">
<![CDATA[CycleTimeStorageArray[8,0] := CycleTimeStorage[17];]]>
</Line>
<Line Number="348">
<![CDATA[CycleTimeStorageArray[9,0] := CycleTimeStorage[18];]]>
</Line>
<Line Number="349">
<![CDATA[CycleTimeStorageArray[10,0] := CycleTimeStorage[19];]]>
</Line>
<Line Number="350">
<![CDATA[CycleTimeStorageArray[11,0] := CycleTimeIndex;]]>
</Line>
<Line Number="351">
<![CDATA[]]>
</Line>
<Line Number="352">
<![CDATA[IF CycleTimeStorageHMI_Option < 1 THEN ]]>
</Line>
<Line Number="353">
<![CDATA[	CycleTimeStorageHMI_Option := 1;]]>
</Line>
<Line Number="354">
<![CDATA[ELSIF CycleTimeStorageHMI_Option > 100 then]]>
</Line>
<Line Number="355">
<![CDATA[	CycleTimeStorageHMI_Option := 100;]]>
</Line>
<Line Number="356">
<![CDATA[END_IF;]]>
</Line>
<Line Number="357">
<![CDATA[]]>
</Line>
<Line Number="358">
<![CDATA[FOR i := 1 to 11 BY 1 DO ]]>
</Line>
<Line Number="359">
<![CDATA[	CycleTimeStorageHMI[i] := 0;]]>
</Line>
<Line Number="360">
<![CDATA[	FOR j := 1 to CycleTimeStorageHMI_Option BY 1 DO]]>
</Line>
<Line Number="361">
<![CDATA[		CycleTimeStorageHMI[i] := CycleTimeStorageHMI[i]+CycleTimeStorageArray[i,j];]]>
</Line>
<Line Number="362">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="363">
<![CDATA[	CycleTimeStorageHMI[i] := CycleTimeStorageHMI[i]/CycleTimeStorageHMI_Option;]]>
</Line>
<Line Number="364">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="StatusClear_SUB" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Clear All Station Status Data]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[FOR i:=1 TO 20 DO]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[StationStatus[i].S1Attempt:=0;]]>
</Line>
<Line Number="5">
<![CDATA[StationStatus[i].S1Success:=0;]]>
</Line>
<Line Number="6">
<![CDATA[StationStatus[i].S5Attempt:=0;]]>
</Line>
<Line Number="7">
<![CDATA[StationStatus[i].S5Success:=0;]]>
</Line>
<Line Number="8">
<![CDATA[StationStatus[i].S7InsertAttempt:=0;]]>
</Line>
<Line Number="9">
<![CDATA[StationStatus[i].S7Attempt:=0;]]>
</Line>
<Line Number="10">
<![CDATA[StationStatus[i].S7Success:=0;]]>
</Line>
<Line Number="11">
<![CDATA[StationStatus[i].S8Attempt:=0;]]>
</Line>
<Line Number="12">
<![CDATA[StationStatus[i].S8Success:=0;]]>
</Line>
<Line Number="13">
<![CDATA[StationStatus[i].S9Attempt:=0;]]>
</Line>
<Line Number="14">
<![CDATA[StationStatus[i].S10Attempt:=0;]]>
</Line>
<Line Number="15">
<![CDATA[StationStatus[i].S10Success:=0;]]>
</Line>
<Line Number="16">
<![CDATA[StationStatus[i].S11Attempt:=0;]]>
</Line>
<Line Number="17">
<![CDATA[StationStatus[i].S11Success:=0;]]>
</Line>
<Line Number="18">
<![CDATA[StationStatus[i].S14Attempt:=0;]]>
</Line>
<Line Number="19">
<![CDATA[StationStatus[i].S14Success:=0;]]>
</Line>
<Line Number="20">
<![CDATA[StationStatus[i].S15Attempt:=0;]]>
</Line>
<Line Number="21">
<![CDATA[StationStatus[i].S15Success:=0;]]>
</Line>
<Line Number="22">
<![CDATA[StationStatus[i].S16Attempt:=0;]]>
</Line>
<Line Number="23">
<![CDATA[StationStatus[i].S16Success:=0;]]>
</Line>
<Line Number="24">
<![CDATA[StationStatus[i].S17Attempt:=0;]]>
</Line>
<Line Number="25">
<![CDATA[StationStatus[i].S17Success:=0;]]>
</Line>
<Line Number="26">
<![CDATA[StationStatus[i].S18Attempt:=0;]]>
</Line>
<Line Number="27">
<![CDATA[StationStatus[i].S18Success:=0;]]>
</Line>
<Line Number="28">
<![CDATA[StationStatus[i].S19Attempt:=0;]]>
</Line>
<Line Number="29">
<![CDATA[StationStatus[i].S19VisionAtt:=0;]]>
</Line>
<Line Number="30">
<![CDATA[StationStatus[i].S19VisionCmp:=0;]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
</STContent>
