</DefaultData>
</Parameter>
<Parameter Name="Acc" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Acceleration of Move (rev/s/s)]]>
</Description>
<DefaultData Format="L5K">
