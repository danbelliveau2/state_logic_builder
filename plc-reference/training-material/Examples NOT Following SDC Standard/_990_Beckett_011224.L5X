<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[When the command trigger is received and start conditions are deemed ok, set state=12
if trigger is received when start conditions indicate that failure is inevitable, set state=10
(Clear the output assembly command word, in case it wasn't already zero = idle)]]>
</Comment>
<Text>
<![CDATA[XIC(Configure)ONS(Loc_Start_ONS)[XIO(SendMsg.EN) MOV(12,State) ,XIC(SendMsg.EN) MOV(10,State) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 12 - PF - Position Fault (counts)

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "PF" parameter (operand =16#21) with data = Position Fault Limit (counts)]]>
</Comment>
<Text>
<![CDATA[EQU(State,12)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#21,MSG_Write[3])BTD(PF,8,MSG_Write[4],0,8)BTD(PF,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(13,State);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(State,13)XIC(SendMsg.EN)MOV(14,State);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(State,14)[XIC(SendMsg.DN) MOV(15,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 14 - CM - Control Mode

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "CM" parameter (operand =16#10) with data = control mode]]>
</Comment>
<Text>
<![CDATA[EQU(State,15)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#10,MSG_Write[3])BTD(CM,8,MSG_Write[4],0,8)BTD(CM,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(16,State);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(State,16)XIC(SendMsg.EN)MOV(17,State);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(State,17)[XIC(SendMsg.DN) MOV(18,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 17 - CN - Control Mode

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "CN" parameter (operand =16#27) with data = secondary control mode]]>
</Comment>
<Text>
<![CDATA[EQU(State,18)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#27,MSG_Write[3])BTD(CN,8,MSG_Write[4],0,8)BTD(CN,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(19,State);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQU(State,19)XIC(SendMsg.EN)MOV(20,State);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(State,20)[XIC(SendMsg.DN) MOV(21,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 20 - EG - Electronic Gearing

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "EG" parameter (operand =16#26) with data = steps/rev divided by 2]]>
</Comment>
<Text>
<![CDATA[EQU(State,21)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#26,MSG_Write[3])DIV(EG,2,loc_Steps_per_Rev_div_by_2)BTD(loc_Steps_per_Rev_div_by_2,8,MSG_Write[4],0,8)BTD(loc_Steps_per_Rev_div_by_2,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(22,State);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[EQU(State,22)XIC(SendMsg.EN)MOV(23,State);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[EQU(State,23)[XIC(SendMsg.DN) MOV(24,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 27 - EI - Input Noise Filter Constant

Send explicit Type 2 message "Parameter write" (opcode 16#43) for setting "EI" parameter (operand =16#10) with data = Filter Value (0..255, Frequency = <max freq.>/<Filter Value>)]]>
</Comment>
<Text>
<![CDATA[EQU(State,24)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#43,MSG_Write[3])BTD(EI,8,MSG_Write[4],0,8)BTD(EI,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(25,State);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[EQU(State,25)XIC(SendMsg.EN)MOV(26,State);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[EQU(State,26)[XIC(SendMsg.DN) MOV(27,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 24 - KJ - Jerk Filter

Send explicit Type 2 message "Parameter write" (opcode 16#83) for setting "KJ" parameter (operand =16#0B) with data = frequency (Hz)]]>
</Comment>
<Text>
<![CDATA[EQU(State,27)XIO(SendMsg.EN)MOV(16#00,MSG_Write[0])MOV(16#02,MSG_Write[1])MOV(16#83,MSG_Write[2])MOV(16#0B,MSG_Write[3])BTD(KJ,8,MSG_Write[4],0,8)BTD(KJ,0,MSG_Write[5],0,8)CLR(MSG_Write[6])CLR(MSG_Write[7])MOV(28,State);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[EQU(State,28)XIC(SendMsg.EN)MOV(29,State);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[EQU(State,29)[XIC(SendMsg.DN) MOV(30,State) ,XIC(SendMsg.ER) MOV(80,State) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[EQU(State,13) ,EQU(State,16) ,EQU(State,19) ,EQU(State,22) ,EQU(State,25) ,EQU(State,28) ]MSG(SendMsg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Last Configuration setting is complete. Wait for Message instruction to be non-enabled]]>
</Comment>
<Text>
<![CDATA[EQU(State,30)XIO(SendMsg.EN)MOV(60,State);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[State 60 - Wait for the status to indicate that the command was successful, then move to final state=70
If an error is detected, set the error state=80
[The command was successful when all parameters have been sent]]]>
</Comment>
<Text>
<![CDATA[EQU(State,60)MOV(70,State);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[State 70 - Final state. Hold Done output until the next execution of this AOI instance.]]>
</Comment>
<Text>
<![CDATA[EQU(State,70)OTE(Done);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Exception: if a problem is detected either during before or during execution of the command, set the Error output bit]]>
</Comment>
<Text>
<![CDATA[[EQU(State,10) ,EQU(State,80) ]OTE(Error);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[If sequence is started and has not yet reached a final state, then indicate "In Progress"]]>
</Comment>
<Text>
<![CDATA[LIM(12,State,60)OTE(In_Progress);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[If sequence is passed the state where the command has been sent, then indicate "Sent"]]>
</Comment>
<Text>
<![CDATA[LIM(60,State,80)OTE(Sent);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AMP_Crash_Stop" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-11-16T21:13:24.555Z" CreatedBy="VM-RS2015-W7XX\Grantek" EditedDate="2018-03-21T20:00:52.656Z" EditedBy="VM-RS2015-W7XX\Grantek" SoftwareRevision="v20.04"
>
<Description>
<![CDATA[Applied Motion - Stop/Kill using Maximum Deceleration - AOI]]>
</Description>
<AdditionalHelpText>
<![CDATA[The Crash Stop AOI is used to stop and kill the drive using the maximum deceleration as set by the AM command.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Input" TagType="Base" DataType="DINT" Dimensions="14" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Drive Input Assembly]]>
</Description>
</Parameter>
<Parameter Name="Output" TagType="Base" DataType="DINT" Dimensions="16" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Drive Output Assembly]]>
</Description>
<Comments>
<Comment Operand="[0]">
<![CDATA[Command Word]]>
</Comment>
<Comment Operand="[1]">
<![CDATA[Jog Speed (0.25 rev/min)]]>
</Comment>
<Comment Operand="[2]">
<![CDATA[Jog Acceleration (10 rev/s/s)]]>
</Comment>
<Comment Operand="[3]">
<![CDATA[Jog Deceleration (10 rev/s/s)]]>
</Comment>
<Comment Operand="[4]">
<![CDATA[Point-to-Point Velocity (0.25 rev/min)]]>
</Comment>
<Comment Operand="[5]">
<![CDATA[Point-to-Point Acceleration (10 rev/s/s)]]>
</Comment>
<Comment Operand="[6]">
<![CDATA[Point-to-Point Deceleration (10 rev/s/s)]]>
</Comment>
<Comment Operand="[7]">
<![CDATA[Point-to-Point Distance (Motor steps)]]>
</Comment>
<Comment Operand="[9]">
<![CDATA[(2x ASCII Letters in 16 lower word)]]>
</Comment>
<Comment Operand="[10]">
<![CDATA[Data/Register 1]]>
</Comment>
<Comment Operand="[11]">
<![CDATA[Data/Register 2]]>
</Comment>
</Comments>
</Parameter>
<Parameter Name="RPI" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Drive Connection Request Packet Interval (milliseconds)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[100]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="100"/>
</DefaultData>
</Parameter>
<Parameter Name="Stop" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Stop the drive axis]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sent" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Stop has been sent to drive]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="In_Progress" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Stop in progress]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Done" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Stop completed without errors - Servo is not moving]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Error" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Stop failed - drive not ready or faulted]]>
