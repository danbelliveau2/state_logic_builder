</Routine>
<Routine Name="Indexer_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Indexer Control State Machine

State 0: Not Running
State 1: First Scan
State 2: Automatic Mode
State 3: Manual Mode
State 4: Index One Position
State 8: Index Complete
State 9: Wait All Stations Complete
State 20: Check All Actuators In Safe Position
State 62: Cycle Stop
State 63: Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Indexer_SM.Status.State[0])XIC(MainAssemblyOK)MOV(1,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(Indexer_SM.Status.State[8]) ,XIC(Indexer_SM.Status.Faulted) ] ]MOV(2,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOV(3,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[20])XIC(Indexer_SM.Control.Bit[2])MOV(4,Indexer_SM.Control.StateReg)[OTU(Indexer_SM.Control.Bit[11]) ,OTU(Indexer_SM.Control.Bit[12]) ,OTU(Indexer_SM.Control.Bit[13]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[4])XIO(Indexer_MAM.PC)XIO(Indexer_SM.Control.Bit[0])[[XIO(Indexer_SM.Control.Bit[7]) ,XIC(MachineBasic.AlwaysOn) ] MOV(6,Indexer_SM.Control.StateReg) ,XIC(MachineBasic.AlwaysOff) XIC(Indexer_SM.Control.Bit[7]) MOV(11,Indexer_SM.Control.StateReg) OTL(Indexer_SM.Control.Bit[11]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[32])XIC(Indexer_SM.Control.Timer[5].DN)[XIC(a09ShotPin.Input.AtReference) XIC(a09ShotPin.Input.Stopped) ,XIC(MachineBasic.AlwaysOn) ]XIC(AOI_a09ShotPinExt_RC.In_Range)MOV(8,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[6])XIC(Indexer_SM.Control.Bit[7])XIC(Indexer_MAS.PC)[XIC(Indexer_SM.Control.Bit[0]) MOV(10,Indexer_SM.Control.StateReg) OTL(Indexer_SM.Control.Bit[12]) ,XIO(Indexer_SM.Control.Bit[0]) MOV(11,Indexer_SM.Control.StateReg) OTL(Indexer_SM.Control.Bit[13]) ];]]>
</Text>
</Rung>
