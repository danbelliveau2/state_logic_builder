<Text>
<![CDATA[[XIC(Com_1.InAlarm) ,XIC(Com_2.InAlarm) ,XIC(Com_3.InAlarm) ,XIC(Com_4.InAlarm) ,XIC(Com_5.InAlarm) ,XIC(Com_6.InAlarm) ,XIC(Com_7.InAlarm) ,XIC(Com_8.InAlarm) ,XIC(Com_9.InAlarm) ,XIC(Com_10.InAlarm) ,XIC(Com_11.InAlarm) ,XIC(Com_12.InAlarm) ,XIC(Com_13.InAlarm) ,XIC(Com_14.InAlarm) ,XIC(Com_15.InAlarm) ,XIC(Com_16.InAlarm) ,XIC(Com_17.InAlarm) ,XIC(Com_18.InAlarm) ,XIC(Com_19.InAlarm) ,XIC(Com_20.InAlarm) ,XIC(Com_21.InAlarm) ,XIC(Com_22.InAlarm) ,XIC(Com_23.InAlarm) ,XIC(Com_24.InAlarm) ,XIC(Com_25.InAlarm) ,XIC(Com_26.InAlarm) ,XIC(Com_27.InAlarm) ,XIC(Com_28.InAlarm) ,XIC(Com_29.InAlarm) ,XIC(Com_30.InAlarm) ,XIC(Com_31.InAlarm) ,XIC(Com_32.InAlarm) ]OTE(Supervisor_SM.Control.Bit[20]);]]>
