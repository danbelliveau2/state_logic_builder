<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(searchstring.LEN,intsource[0])RES(falctrl01)FAL(falctrl01,?,?,ALL,intsource[falctrl01.POS+1],searchstring.DATA[falctrl01.POS]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ 
 
 
 

First scan: generate message path, based on slot number (has to be set correctly) and copy to all messages
 
 
 
Important!
Set 'CF_del.PRE' and 'slot_number' to the appropriate values before downloading! (top branch)

Otherwise, nothing in this code needs to be changed!]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[MOV(CF_del.PRE,CF_del.PRE) MOV(slot_number,tempstring.DATA[1]) ,MOV(2,tempstring.LEN) MOV(1,tempstring.DATA[0]) ,COP(tempstring,CF0x4fMSG.Path,1) COP(tempstring,CF0x50MSG.Path,1) ,COP(tempstring,CF0x52MSG.Path,1) COP(tempstring,CF0x53MSG.Path,1) ,COP(tempstring,CF0x54MSG.Path,1) COP(tempstring,CF0x55MSG.Path,1) ,COP(tempstring,CF0x56MSG.Path,1) COP(tempstring,CF0x57MSG.Path,1) ,COP(tempstring,CF0x58MSG.Path,1) COP(tempstring,CF0x59MSG.Path,1) ,COP(tempstring,CF0x5aMSG.Path,1) COP(tempstring,CF0x3MSG.Path,1) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Detect 'stuck' command or step value]]>
</Comment>
<Text>
<![CDATA[[NEQ(CF_RW_functions.command,0) ,EQU(CF_RW_functions.command,0) NEQ(step,0) ][TON(cmd_timeout,?,?) ,NEQ(step,step_copy) [RES(cmd_timeout) ,MOV(step,step_copy) ] ,GRT(cmd_timeout.ACC,2000) OTE(cmdto) ,XIC(cmd_timeout.DN) CLR(CF_RW_functions.command) CLR(step) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Command 1: clear all data from CF UDT]]>
</Comment>
<Text>
<![CDATA[EQU(CF_RW_functions.command,1)FLL(0,CF_RW_functions.command,2365);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[read,
write /w offset
write append]]>
</Comment>
<Text>
<![CDATA[EQU(step,0)[EQU(CF_RW_functions.command,2) OTU(extra_info) OTU(dir_only) [MOV(100,step) ,CLR(CF_RW_functions.result) ] ,EQU(CF_RW_functions.command,3) OTU(extra_info) OTU(dir_only) OTU(append) [MOV(200,step) ,CLR(CF_RW_functions.result) ] ,EQU(CF_RW_functions.command,4) OTU(extra_info) OTU(dir_only) OTL(append) [MOV(200,step) ,CLR(CF_RW_functions.result) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[delete file,
reaname/move file
create directory]]>
</Comment>
<Text>
<![CDATA[EQU(step,0)[EQU(CF_RW_functions.command,5) OTU(extra_info) OTU(dir_only) [MOV(300,step) ,CLR(CF_RW_functions.result) ] ,EQU(CF_RW_functions.command,6) OTU(extra_info) OTU(dir_only) [MOV(400,step) ,CLR(CF_RW_functions.result) ] ,EQU(CF_RW_functions.command,7) OTU(extra_info) OTU(dir_only) [MOV(500,step) ,CLR(CF_RW_functions.result) ] ,EQU(CF_RW_functions.command,11) OTU(extra_info) OTU(dir_only) [MOV(600,step) ,CLR(CF_RW_functions.result) ] ,EQU(CF_RW_functions.command,12) OTU(extra_info) OTU(dir_only) [MOV(70,step) ,CLR(CF_RW_functions.result) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[list/search files'
list/search files /w extra info,
list/search directories]]>
</Comment>
<Text>
<![CDATA[EQU(step,0)[EQU(CF_RW_functions.command,8) OTU(extra_info) OTU(dir_only) ,EQU(CF_RW_functions.command,9) OTL(extra_info) OTU(dir_only) ,EQU(CF_RW_functions.command,10) OTU(extra_info) OTL(dir_only) ][MOV(10,step) ,CLR(CF_RW_functions.result) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[ 
 
 
 
Start of list/search file sequence
 
 
 
 
 Set search string to '*' when none was given.
Clear strings.
Set up message to find first file]]>
</Comment>
<Text>
<![CDATA[EQU(step,10)[NEQ(CF_RW_functions.name.LEN,0) COP(CF_RW_functions.name,searchstring,1) ,EQU(CF_RW_functions.name.LEN,0) [MOV(1,searchstring.LEN) ,MOV(42,searchstring.DATA[0]) ] ,FLL(0,CF_RW_functions.strings[0],100) JSR(ascii2uni,0) ,COP(intsource[0],CF_data[0],100) ,CPT(CF0x58MSG.REQ_LEN,2+2*intsource[0]) ,OTL(MSGtriggers.9) ,MOV(20,step) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Determine succes or failure on first file
Store 'potholder' to search for next match]]>
</Comment>
<Text>
<![CDATA[EQU(step,20)XIO(MSGtriggers.9)XIO(CF_del.TT)[XIC(CF0x58MSG.DN) [CLR(f_nr) ,COP(CF_data[100],next_file_response,1) ,COP(next_file_response.size,CF_RW_functions.DN_length,1) ,[XIC(dir_only) XIC(next_file_response.fflags.4) ,XIO(dir_only) ] [JSR(unic2ascii,0) ,MOV(1,f_nr) ] ,JSR(unic2ascii,0) ,COP(next_file_response.pot_holder,CF_data[0],4) ,MOV(30,step) ] ,XIC(CF0x58MSG.ER) [MOV(50,step) ,SUB(0,CF0x58MSG.ERR,CF_RW_functions.result) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Trigger find-next-file message]]>
</Comment>
<Text>
<![CDATA[EQU(step,30)[OTL(MSGtriggers.10) ,MOV(40,step) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[If found, search again, if not, continue]]>
</Comment>
<Text>
<![CDATA[EQU(step,40)XIO(CF_del.TT)XIO(MSGtriggers.10)[XIC(CF0x59MSG.DN) [COP(CF_data[100],next_file_response.fflags,63) ,[XIC(dir_only) XIC(next_file_response.fflags.4) ,XIO(dir_only) ] [JSR(unic2ascii,0) ,ADD(f_nr,1,f_nr) ] ,RES(CF_del) ,MOV(30,step) ] ,[XIC(CF0x59MSG.ER) ,GEQ(f_nr,100) ] [MOV(50,step) ,MOV(f_nr,CF_RW_functions.result) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Send message to free resources used for searching]]>
</Comment>
<Text>
<![CDATA[EQU(step,50)[OTL(MSGtriggers.11) ,MOV(60,step) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[EQU(step,60)XIO(CF_del.TT)CLR(CF_RW_functions.command)MOV(99,step);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[ 
 
 
 
Start of get file timestamp sequence
 
 
 
 
 Set search string, stop when none was given.
Set up message to find file]]>
</Comment>
<Text>
<![CDATA[EQU(step,70)[EQU(CF_RW_functions.name.LEN,0) [MOV(-1,CF_RW_functions.result) ,CLR(CF_RW_functions.command) ,MOV(99,step) ,TND() ] ,NEQ(CF_RW_functions.name.LEN,0) COP(CF_RW_functions.name,searchstring,1) ,JSR(ascii2uni,0) ,COP(intsource[0],CF_data[0],100) ,CPT(CF0x58MSG.REQ_LEN,2+2*intsource[0]) ,OTL(MSGtriggers.9) ,MOV(80,step) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Determine succes or failure on first file
extract partial timestamp
Store 'potholder' for close service]]>
</Comment>
<Text>
<![CDATA[EQU(step,80)XIO(MSGtriggers.9)XIO(CF_del.TT)[XIC(CF0x58MSG.DN) [COP(CF_data[100],next_file_response,1) ,COP(next_file_response.create_TS,tempDINTAR[0],2) ,CLR(tDINT[0]) BTD(tempDINTAR[0],30,tDINT[0],0,2) BTD(tempDINTAR[1],0,tDINT[0],2,26) ,MOV(tDINT[0],CF_RW_functions.result) ,COP(CF_data[100],CF_data[0],4) ,MOV(50,step) ] ,XIC(CF0x58MSG.ER) [COP(CF_data[100],CF_data[0],4) ,MOV(50,step) ,SUB(0,CF0x58MSG.ERR,CF_RW_functions.result) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[ 
 
 
Start of read from file sequence
 
 
 
 
Set up and trigger message to open file]]>
</Comment>
<Text>
<![CDATA[EQU(step,100)[LEQ(CF_RW_functions.name.LEN,0) CLR(step) TND() ,CLR(CF_RW_functions.DN_length) CLR(CF_RW_functions.index) CLR(prev_index) ,COP(CF_RW_functions.name,searchstring,1) JSR(ascii2uni,0) ,MOV(16#80000000,tempDINTAR[0]) CLR(tempDINTAR[1]) ,CLR(tempDINTAR[2]) MOV(3,tempDINTAR[3]) ,MOV(16#80,tempDINTAR[4]) CLR(tempDINTAR[5]) ,ADD(CF_RW_functions.name.LEN,1,tDINT[1]) MUL(tDINT[1],2,tDINT[1]) ,COP(intsource[0],CF_data[0],tDINT[1]) MOV(tDINT[1],tDINT_IA) COP(tempDINTAR[0],CF_data[tDINT_IA],24) ,ADD(tDINT[1],24,CF0x52MSG.REQ_LEN) ,OTL(MSGtriggers.3) MOV(110,step) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[file is open, pointer is @ start-of-file
when an offset is requested, change file pointer
otherwise, start reading data]]>
</Comment>
<Text>
<![CDATA[EQU(step,110)XIO(MSGtriggers.3)XIO(CF_del.TT)[XIC(CF0x52MSG.DN) [COP(CF_data[400],filehandle,1) ,EQU(CF_RW_functions.offset,0) MOV(120,step) ,NEQ(CF_RW_functions.offset,0) MOV(112,step) ] ,XIC(CF0x52MSG.ER) [SUB(0,CF0x52MSG.ERR,CF_RW_functions.result) ,CLR(CF_RW_functions.command) MOV(99,step) ] ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Set up and trigger message to set file pointer in opened file]]>
</Comment>
<Text>
<![CDATA[EQU(step,112)[COP(filehandle,CF_data[0],4) COP(CF_RW_functions.offset,CF_data[4],4) ,FLL(0,CF_data[8],8) ,OTL(MSGtriggers.4) MOV(114,step) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[When file pointer is set, start reading data
When file pointer is wrong (outside of file), close file]]>
</Comment>
<Text>
<![CDATA[EQU(step,114)XIO(MSGtriggers.4)XIO(CF_del.TT)[XIC(CF0x53MSG.DN) [COP(CF_data[100],tempDINTAR[8],1) ,EQU(tempDINTAR[8],CF_RW_functions.offset) MOV(120,step) ,NEQ(tempDINTAR[8],CF_RW_functions.offset) [MOV(150,step) ,MOV(-99,CF_RW_functions.result) ] ] ,XIC(CF0x53MSG.ER) [SUB(-100,CF0x53MSG.ERR,CF_RW_functions.result) ,MOV(150,step) ] ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Detect amount of data read.
When not zero, process
When zero, stop]]>
</Comment>
<Text>
<![CDATA[EQU(step,120)[COP(filehandle,CF_data[0],4) ,EQU(CF_RW_functions.REQ_length,0) MOV(460,tDINT[2]) ,NEQ(CF_RW_functions.REQ_length,0) GEQ(CF_RW_functions.REQ_length,CF_RW_functions.DN_length) [SUB(CF_RW_functions.REQ_length,CF_RW_functions.DN_length,tDINT[2]) ,GRT(tDINT[2],460) MOV(460,tDINT[2]) ] ,COP(tDINT[2],CF_data[4],2) ,GRT(tDINT[2],0) OTL(MSGtriggers.0) MOV(130,step) ,LEQ(tDINT[2],0) MOV(150,step) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Copy read data to UDT]]>
</Comment>
<Text>
<![CDATA[EQU(step,130)XIO(MSGtriggers.0)XIO(CF_del.TT)[XIC(CF0x4fMSG.DN) [COP(CF_data[20],tDINT[3],1) ,AND(tDINT[3],16#FFFF,tDINT[3]) ,COP(CF_data[22],CF_RW_functions.data[0],tDINT[3]) ,ADD(CF_RW_functions.DN_length,tDINT[3],CF_RW_functions.DN_length) ,MOV(140,step) ] ,XIC(CF0x4fMSG.ER) [SUB(-200,CF0x4fMSG.ERR,CF_RW_functions.result) ,MOV(150,step) ] ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Wait for other code to signal that the data from the UDT has been processed, or stop reading when done.]]>
</Comment>
<Text>
<![CDATA[EQU(step,140)XIO(CF_del.TT)[EQU(tDINT[3],460) NEQ(CF_RW_functions.index,prev_index) [MOV(120,step) ,MOV(CF_RW_functions.index,prev_index) ] ,[LES(tDINT[3],460) ,GEQ(CF_RW_functions.DN_length,40000) ,XIC(cmdto) MOV(-200,CF_RW_functions.result) ] MOV(150,step) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Done, close file]]>
</Comment>
<Text>
<![CDATA[EQU(step,150)OTL(MSGtriggers.5)MOV(160,step);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[EQU(step,160)XIO(CF_del.TT)[XIC(CF0x54MSG.DN) ,XIC(CF0x54MSG.ER) ]CLR(CF_RW_functions.command)MOV(99,step);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[ 
 
 
Start of write to file sequence
 
 
 
 
]]>
</Comment>
<Text>
<![CDATA[EQU(step,200)[LEQ(CF_RW_functions.name.LEN,0) CLR(step) TND() ,CLR(CF_RW_functions.DN_length) CLR(CF_RW_functions.index) CLR(prev_index) ,CLR(tempDINTAR[8]) COP(CF_RW_functions.name,searchstring,1) JSR(ascii2uni,0) ,MOV(16#40000000,tempDINTAR[0]) CLR(tempDINTAR[1]) ,CLR(tempDINTAR[2]) MOV(4,tempDINTAR[3]) ,MOV(16#80,tempDINTAR[4]) CLR(tempDINTAR[5]) ,ADD(CF_RW_functions.name.LEN,1,tDINT[5]) MUL(tDINT[5],2,tDINT[5]) ,COP(intsource[0],CF_data[0],tDINT[5]) MOV(tDINT[5],tDINT_IA) COP(tempDINTAR[0],CF_data[tDINT_IA],24) ,ADD(tDINT[5],24,CF0x52MSG.REQ_LEN) ,OTL(MSGtriggers.3) MOV(210,step) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[file is open, pointer is @ start-of-file
when an offset is requested, change file pointer
otherwise, start writing data
File not open: stop]]>
</Comment>
<Text>
<![CDATA[EQU(step,210)XIO(MSGtriggers.3)XIO(CF_del.TT)[XIC(CF0x52MSG.DN) [COP(CF_data[400],filehandle,1) ,EQU(CF_RW_functions.offset,0) MOV(220,step) ,[NEQ(CF_RW_functions.offset,0) ,XIC(append) ] MOV(212,step) ] ,XIC(CF0x52MSG.ER) [SUB(0,CF0x52MSG.ERR,CF_RW_functions.result) ,CLR(CF_RW_functions.command) MOV(99,step) ] ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[EQU(step,212)[COP(filehandle,CF_data[0],4) ,XIO(append) [COP(CF_RW_functions.offset,CF_data[4],4) ,FLL(0,CF_data[8],8) ] ,XIC(append) [FLL(0,CF_data[4],12) ,MOV(2,CF_data[12]) ] ,OTL(MSGtriggers.4) MOV(214,step) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[When file pointer is set, start writing data
When file pointer is wrong (outside of file), close file]]>
</Comment>
<Text>
<![CDATA[EQU(step,214)XIO(MSGtriggers.4)XIO(CF_del.TT)[XIC(CF0x53MSG.DN) [COP(CF_data[100],tempDINTAR[8],1) ,[EQU(tempDINTAR[8],CF_RW_functions.offset) ,XIC(append) ] MOV(220,step) ,XIO(append) NEQ(tempDINTAR[8],CF_RW_functions.offset) [MOV(-99,CF_RW_functions.result) ,MOV(250,step) ] ] ,XIC(CF0x53MSG.ER) [SUB(-100,CF0x53MSG.ERR,CF_RW_functions.result) ,MOV(250,step) ] ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[EQU(step,220)[COP(filehandle,CF_data[0],4) ,EQU(CF_RW_functions.REQ_length,0) MOV(460,tDINT[6]) ,NEQ(CF_RW_functions.REQ_length,0) GEQ(CF_RW_functions.REQ_length,CF_RW_functions.DN_length) [SUB(CF_RW_functions.REQ_length,CF_RW_functions.DN_length,tDINT[6]) ,GRT(tDINT[6],460) MOV(460,tDINT[6]) ] ,COP(tDINT[6],CF_data[4],2) ,COP(CF_RW_functions.data[0],CF_data[6],tDINT[6]) ADD(tDINT[6],6,CF0x50MSG.REQ_LEN) ,GRT(tDINT[6],0) OTL(MSGtriggers.1) MOV(230,step) ,LEQ(tDINT[6],0) MOV(250,step) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[EQU(step,230)XIO(MSGtriggers.1)XIO(CF_del.TT)[XIC(CF0x50MSG.DN) [COP(CF_data[500],tDINT[7],1) ,AND(tDINT[7],16#FFFF,tDINT[7]) ,ADD(CF_RW_functions.DN_length,tDINT[7],CF_RW_functions.DN_length) ,MOV(240,step) ] ,XIC(CF0x50MSG.ER) [SUB(-200,CF0x50MSG.ERR,CF_RW_functions.result) ,MOV(250,step) ] ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[EQU(step,240)XIO(CF_del.TT)[EQU(tDINT[7],460) NEQ(CF_RW_functions.index,prev_index) [MOV(220,step) ,MOV(CF_RW_functions.index,prev_index) ] ,[GEQ(CF_RW_functions.DN_length,40000) ,EQU(CF_RW_functions.DN_length,CF_RW_functions.REQ_length) ] [MOV(250,step) ,ADD(tempDINTAR[8],CF_RW_functions.DN_length,CF_RW_functions.result) ] ,XIC(cmdto) [MOV(250,step) ,MOV(-200,CF_RW_functions.result) ] ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[EQU(step,250)OTL(MSGtriggers.5)MOV(260,step);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[EQU(step,260)XIO(CF_del.TT)[XIC(CF0x54MSG.DN) ,XIC(CF0x54MSG.ER) ]CLR(CF_RW_functions.command)MOV(99,step);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Start of file delete sequence]]>
</Comment>
<Text>
<![CDATA[EQU(step,300)[CLR(CF_RW_functions.result) ,LEQ(CF_RW_functions.name.LEN,0) CLR(step) CLR(CF_RW_functions.command) TND() ,COP(CF_RW_functions.name,searchstring,1) JSR(ascii2uni,0) ,ADD(CF_RW_functions.name.LEN,1,tDINT[8]) MUL(tDINT[8],2,tDINT[8]) ,COP(intsource[0],CF_data[0],tDINT[8]) MOV(tDINT[8],CF0x55MSG.REQ_LEN) ,OTL(MSGtriggers.6) MOV(310,step) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[EQU(step,310)XIO(MSGtriggers.6)XIO(CF_del.TT)[XIC(CF0x55MSG.DN) [MOV(1,CF_RW_functions.result) ,CLR(step) CLR(CF_RW_functions.command) ] ,XIC(CF0x55MSG.ER) [SUB(0,CF0x55MSG.ERR,CF_RW_functions.result) ,MOV(99,step) CLR(CF_RW_functions.command) ] ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Start of file move/rename sequence]]>
</Comment>
<Text>
<![CDATA[EQU(step,400)[CLR(CF_RW_functions.result) ,[LEQ(CF_RW_functions.name.LEN,0) ,LEQ(CF_RW_functions.newname.LEN,0) ] CLR(step) CLR(CF_RW_functions.command) TND() ,COP(CF_RW_functions.name,searchstring,1) JSR(ascii2uni,0) ,ADD(CF_RW_functions.name.LEN,1,tDINT[9]) MUL(tDINT[9],2,tDINT[9]) ,COP(intsource[0],CF_data[0],tDINT[9]) ,COP(CF_RW_functions.newname,searchstring,1) JSR(ascii2uni,0) ,ADD(CF_RW_functions.newname.LEN,1,tempDINTAR[7]) MUL(tempDINTAR[7],2,tempDINTAR[7]) ,MOV(tDINT[9],tDINT_IA) COP(intsource[0],CF_data[tDINT_IA],tempDINTAR[7]) ,ADD(tDINT[9],tempDINTAR[7],tDINT[9]) MOV(tDINT[9],CF0x57MSG.REQ_LEN) ,OTL(MSGtriggers.8) MOV(410,step) ];]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[EQU(step,410)XIO(MSGtriggers.8)XIO(CF_del.TT)[XIC(CF0x57MSG.DN) [MOV(1,CF_RW_functions.result) ,CLR(step) CLR(CF_RW_functions.command) ] ,XIC(CF0x57MSG.ER) [SUB(0,CF0x57MSG.ERR,CF_RW_functions.result) ,MOV(99,step) CLR(CF_RW_functions.command) ] ];]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[Start of create directory sequence]]>
</Comment>
<Text>
<![CDATA[EQU(step,500)[CLR(CF_RW_functions.result) ,LEQ(CF_RW_functions.name.LEN,0) CLR(step) CLR(CF_RW_functions.command) TND() ,COP(CF_RW_functions.name,searchstring,1) JSR(ascii2uni,0) ,ADD(CF_RW_functions.name.LEN,1,tDINT[10]) MUL(tDINT[10],2,tDINT[10]) ,COP(intsource[0],CF_data[0],tDINT[10]) MOV(tDINT[10],tDINT_IA) FLL(0,CF_data[tDINT_IA],4) ,ADD(tDINT[10],4,CF0x56MSG.REQ_LEN) ,OTL(MSGtriggers.7) MOV(510,step) ];]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[EQU(step,510)XIO(MSGtriggers.7)XIO(CF_del.TT)[XIC(CF0x56MSG.DN) [MOV(1,CF_RW_functions.result) ,CLR(step) CLR(CF_RW_functions.command) ] ,XIC(CF0x56MSG.ER) [SUB(0,CF0x56MSG.ERR,CF_RW_functions.result) ,MOV(99,step) CLR(CF_RW_functions.command) ] ];]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[Start of detect card sequence]]>
</Comment>
<Text>
<![CDATA[EQU(step,600)[CLR(CF_RW_functions.result) ,FLL(0,CF_data[0],10) MOV(1,CF_data[0]) ,MOV(3,CF_data[2]) ,OTL(MSGtriggers.12) MOV(610,step) ];]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[EQU(step,610)XIO(MSGtriggers.12)XIO(CF_del.TT)[XIC(CF0x3MSG.DN) [MOV(CF_data[16],CF_RW_functions.result) ,MOV(99,step) CLR(CF_RW_functions.command) ] ,XIC(CF0x3MSG.ER) [SUB(0,CF0x3MSG.ERR,CF_RW_functions.result) ,MOV(99,step) CLR(CF_RW_functions.command) ] ];]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
<![CDATA[Prevent overloading the FileManager/CF controller.
Allow 500ms to flush cache, clear buffers, etc.]]>
</Comment>
<Text>
<![CDATA[EQU(step,99)TON(flush_delay,?,?)XIC(flush_delay.DN)CLR(step);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[ 
 
 
 
file action delay timer - reduces load on CPU comms subsystem
 
 
 
 
]]>
</Comment>
<Text>
<![CDATA[[NEQ(MSGtriggers,0) ,XIC(CF_del.TT) ]TON(CF_del,?,?);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[ 
 
 
 
Start of messaging - all messages can be used by several different sequences
 
 
 
 
]]>
</Comment>
<Text>
<![CDATA[XIC(MSGtriggers.0)[MSG(CF0x4fMSG) ,[XIC(CF0x4fMSG.DN) ,XIC(CF0x4fMSG.ER) ] OTU(MSGtriggers.0) ];]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[XIC(MSGtriggers.1)[MSG(CF0x50MSG) ,[XIC(CF0x50MSG.DN) ,XIC(CF0x50MSG.ER) ] OTU(MSGtriggers.1) ];]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[XIC(MSGtriggers.3)[MSG(CF0x52MSG) ,[XIC(CF0x52MSG.DN) ,XIC(CF0x52MSG.ER) ] OTU(MSGtriggers.3) ];]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Text>
<![CDATA[XIC(MSGtriggers.4)[MSG(CF0x53MSG) ,[XIC(CF0x53MSG.DN) ,XIC(CF0x53MSG.ER) ] OTU(MSGtriggers.4) ];]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Text>
<![CDATA[XIC(MSGtriggers.5)[MSG(CF0x54MSG) ,[XIC(CF0x54MSG.DN) ,XIC(CF0x54MSG.ER) ] OTU(MSGtriggers.5) ];]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Text>
<![CDATA[XIC(MSGtriggers.6)[MSG(CF0x55MSG) ,[XIC(CF0x55MSG.DN) ,XIC(CF0x55MSG.ER) ] OTU(MSGtriggers.6) ];]]>
</Text>
