</Line>
<Line Number="48">
<![CDATA[StationStatus[1].S18Attempt:=0;]]>
</Line>
<Line Number="49">
<![CDATA[StationStatus[1].S18Success:=0;]]>
</Line>
<Line Number="50">
<![CDATA[StationStatus[1].S19Attempt:=0;]]>
</Line>
<Line Number="51">
<![CDATA[StationStatus[1].S19VisionAtt:=0;]]>
</Line>
<Line Number="52">
<![CDATA[StationStatus[1].S19VisionCmp:=0;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[FOR StationNumber:=1 TO 20 DO]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[StationStatus[StationNumber].HeadNumber:= (HeadAtStation1 + (21-StationNumber)) MOD 20;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[IF StationStatus[StationNumber].HeadNumber = 0 THEN]]>
</Line>
<Line Number="59">
<![CDATA[StationStatus[StationNumber].HeadNumber:=20;]]>
</Line>
<Line Number="60">
<![CDATA[END_IF;]]>
</Line>
<Line Number="61">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="62">
<![CDATA[]]>
</Line>
<Line Number="63">
<![CDATA[S1HeadNumber:=StationStatus[1].HeadNumber;]]>
</Line>
<Line Number="64">
<![CDATA[S2HeadNumber:=StationStatus[2].HeadNumber;]]>
</Line>
<Line Number="65">
<![CDATA[S3HeadNumber:=StationStatus[3].HeadNumber;]]>
</Line>
<Line Number="66">
<![CDATA[S4HeadNumber:=StationStatus[4].HeadNumber;]]>
</Line>
<Line Number="67">
<![CDATA[S5HeadNumber:=StationStatus[5].HeadNumber;]]>
</Line>
<Line Number="68">
<![CDATA[S6HeadNumber:=StationStatus[6].HeadNumber;]]>
</Line>
<Line Number="69">
<![CDATA[S7HeadNumber:=StationStatus[7].HeadNumber;]]>
</Line>
<Line Number="70">
<![CDATA[S8HeadNumber:=StationStatus[8].HeadNumber;]]>
</Line>
<Line Number="71">
<![CDATA[S9HeadNumber:=StationStatus[9].HeadNumber;]]>
</Line>
<Line Number="72">
<![CDATA[S10HeadNumber:=StationStatus[10].HeadNumber;]]>
</Line>
<Line Number="73">
<![CDATA[S11HeadNumber:=StationStatus[11].HeadNumber;]]>
</Line>
<Line Number="74">
<![CDATA[S12HeadNumber:=StationStatus[12].HeadNumber;]]>
</Line>
<Line Number="75">
<![CDATA[S13HeadNumber:=StationStatus[13].HeadNumber;]]>
</Line>
<Line Number="76">
<![CDATA[S14HeadNumber:=StationStatus[14].HeadNumber;]]>
</Line>
<Line Number="77">
<![CDATA[S15HeadNumber:=StationStatus[15].HeadNumber;]]>
</Line>
<Line Number="78">
<![CDATA[S16HeadNumber:=StationStatus[16].HeadNumber;]]>
</Line>
<Line Number="79">
<![CDATA[S17HeadNumber:=StationStatus[17].HeadNumber;]]>
</Line>
<Line Number="80">
<![CDATA[S18HeadNumber:=StationStatus[18].HeadNumber;]]>
</Line>
<Line Number="81">
<![CDATA[S19HeadNumber:=StationStatus[19].HeadNumber;]]>
</Line>
<Line Number="82">
<![CDATA[S20HeadNumber:=StationStatus[20].HeadNumber;]]>
</Line>
<Line Number="83">
<![CDATA[]]>
</Line>
<Line Number="84">
<![CDATA[//*********************************]]>
</Line>
<Line Number="85">
<![CDATA[//BECKETT ADDED CODE By Mike Gibel*]]>
</Line>
<Line Number="86">
<![CDATA[//*********************************]]>
</Line>
<Line Number="87">
<![CDATA[// Purpose: Copy station data for *]]>
</Line>
<Line Number="88">
<![CDATA[//          tracking failures and *]]>
</Line>
<Line Number="89">
<![CDATA[//          cycle time.           *]]>
</Line>
<Line Number="90">
<![CDATA[//*********************************]]>
</Line>
<Line Number="91">
<![CDATA[COP(StationData[19],StationData[20],1);]]>
</Line>
<Line Number="92">
<![CDATA[COP(StationData[18],StationData[19],1);]]>
</Line>
<Line Number="93">
<![CDATA[COP(StationData[17],StationData[18],1);]]>
</Line>
<Line Number="94">
<![CDATA[COP(StationData[16],StationData[17],1);]]>
</Line>
