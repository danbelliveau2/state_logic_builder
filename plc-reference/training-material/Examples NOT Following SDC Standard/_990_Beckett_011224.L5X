<Rung Number="48" Type="N">
<Text>
<![CDATA[XIC(MSGtriggers.7)[MSG(CF0x56MSG) ,[XIC(CF0x56MSG.DN) ,XIC(CF0x56MSG.ER) ] OTU(MSGtriggers.7) ];]]>
</Text>
