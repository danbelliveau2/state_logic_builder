</Line>
<Line Number="15">
<![CDATA[	HMI_Data.HeadData[x].Station14.Successes:=0;]]>
</Line>
<Line Number="16">
<![CDATA[	HMI_Data.HeadData[x].Station15.Attempts:=0;]]>
</Line>
<Line Number="17">
<![CDATA[	HMI_Data.HeadData[x].Station15.Successes:=0;]]>
