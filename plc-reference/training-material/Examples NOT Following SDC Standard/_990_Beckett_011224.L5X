<Routine Name="OEESaved_SUB" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[For i:=30 to 2 by -1 do]]>
</Line>
<Line Number="1">
<![CDATA[	COP(OEEDataBlockSaved[i-1],OEEDataBlockSaved[i],1);]]>
</Line>
<Line Number="2">
<![CDATA[End_for;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[OEEDataBlockSaved[1].Date[0]:= WallClockTime[1];]]>
</Line>
<Line Number="5">
<![CDATA[OEEDataBlockSaved[1].Date[1]:= WallClockTime[2];]]>
</Line>
<Line Number="6">
<![CDATA[OEEDataBlockSaved[1].Date[2]:= WallClockTime[0];]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[For i:=1 to 24 by 1 do]]>
</Line>
<Line Number="9">
<![CDATA[	COP(OEEDataBlockEmpty, OEEDataBlockSaved[1].OEEDataBlock[i],1);]]>
</Line>
<Line Number="10">
<![CDATA[End_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="OEE_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Get Time From PLC]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)GSV(WallClockTime,,LocalDateTime,WallClockTime[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[NEQ(WallClockTime[3],HourPrevious)[LES(HourPrevious,24) COP(OEEDataBlock[1],OEEDataBlockSaved[1].OEEDataBlock[HourPrevious+1],1) ,GEQ(HourPrevious,24) ]MOV(WallClockTime[3],HourPrevious)OTE(OEEBoolean.0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(WallClockTime[3],0)NEQ(WallClockTime[2],OEEDataBlockSaved[1].Date[1])JSR(OEESaved_SUB,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[NEQ(OEESaveDay,OEESaveDayPrevious) ,NEQ(OEESaveHour,OEESaveHourPrevious) ,XIC(HMI_Data.Control.Button[97]) ]JSR(OEELoadSaved_SM,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[NEQ(StationDataCountsSelect,StationDataCountsSelectPrevious)JSR(StationDataLoadCount_SUB,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Shift Data]]>
</Comment>
<Text>
<![CDATA[XIC(OEEBoolean.0)COP(OEEDataBlock[23],OEEDataBlock[24],1)COP(OEEDataBlock[22],OEEDataBlock[23],1)COP(OEEDataBlock[21],OEEDataBlock[22],1)COP(OEEDataBlock[20],OEEDataBlock[21],1)COP(OEEDataBlock[19],OEEDataBlock[20],1)COP(OEEDataBlock[18],OEEDataBlock[19],1)COP(OEEDataBlock[17],OEEDataBlock[18],1)COP(OEEDataBlock[16],OEEDataBlock[17],1)COP(OEEDataBlock[15],OEEDataBlock[16],1)COP(OEEDataBlock[14],OEEDataBlock[15],1)COP(OEEDataBlock[13],OEEDataBlock[14],1)COP(OEEDataBlock[12],OEEDataBlock[13],1)COP(OEEDataBlock[11],OEEDataBlock[12],1)COP(OEEDataBlock[10],OEEDataBlock[11],1)COP(OEEDataBlock[9],OEEDataBlock[10],1)COP(OEEDataBlock[8],OEEDataBlock[9],1)COP(OEEDataBlock[7],OEEDataBlock[8],1)COP(OEEDataBlock[6],OEEDataBlock[7],1)COP(OEEDataBlock[5],OEEDataBlock[6],1)COP(OEEDataBlock[4],OEEDataBlock[5],1)COP(OEEDataBlock[3],OEEDataBlock[4],1)COP(OEEDataBlock[2],OEEDataBlock[3],1)COP(OEEDataBlock[1],OEEDataBlock[2],1)COP(OEEDataBlockEmpty,OEEDataBlock[1],1)RES(OEETimer[0])RES(OEETimer[1])RES(OEETimer[2])JSR(StationDataCount_SUB,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Uptime/Downtime]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[[XIC(MachineRunning) RTO(OEETimer[0],?,?) ,XIO(MachineRunning) [XIO(OEEBoolean.3) RTO(OEETimer[1],?,?) ,XIC(OEEBoolean.3) RTO(OEETimer[2],?,?) ] ] ,[DIV(OEETimer[0].ACC,60000,OEEDataBlock[1].Uptime) ,DIV(OEETimer[1].ACC,60000,OEEDataBlock[1].UnplannedDT) ,DIV(OEETimer[2].ACC,60000,OEEDataBlock[1].PlannedDT) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Counts]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[XIC(UnloadRobot_SM.Control.Bit[6]) ONS(OEEBoolean.1) [ADD(OEEDataBlock[1].TotalParts,1,OEEDataBlock[1].TotalParts) ,ADD(OEEDataBlock[1].GoodParts,1,OEEDataBlock[1].GoodParts) ] ,XIC(UnloadRobot_SM.Control.Bit[7]) ONS(OEEBoolean.2) ADD(OEEDataBlock[1].TotalParts,1,OEEDataBlock[1].TotalParts) ,CPT(OEEDataBlock[1].FPY,(OEEDataBlock[1].GoodParts/OEEDataBlock[1].TotalParts)*100) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[OEE]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[DIV(OEETimer[0].ACC,1,OEERunTimeSeconds) ,CPT(OEEDowntimeSeconds,OEETimer[1].ACC+OEETimer[2].ACC) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[AOI_OEE(AOI_OEE,30,OEEDataBlock[1].TotalParts,OEEDataBlock[1].GoodParts,480.0,480.0,OEERunTimeSeconds,OEEDowntimeSeconds) ,MOV(AOI_OEE.OEE,OEEDataBlock[1].OEE) ,MOV(AOI_OEE.Performance,OEEDataBlock[1].SpareREAL[0]) ,MOV(AOI_OEE.Availability,OEEDataBlock[1].SpareREAL[1]) ,NEQ(OEEDataBlock[1].SpareREAL[0],0) DIV(2,OEEDataBlock[1].SpareREAL[0],OEEDataBlock[1].SpareREAL[2]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PressControl_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Press (Station 10 & Station 11) Control State Machine]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(PressControl_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)XIO(StationStatus[11].S7Success)OTE(PressControl_SM.Control.Bit[9]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
