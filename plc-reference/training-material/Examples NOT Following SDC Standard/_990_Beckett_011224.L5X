<Comment Operand=".STATUS.STATE[0]">
<![CDATA[Conveyor Control Not Running]]>
</Comment>
<Comment Operand=".STATUS.STATE[1]">
<![CDATA[Conveyor Control First Scan]]>
</Comment>
<Comment Operand=".STATUS.STATE[2]">
<![CDATA[Conveyor Control Automatic Mode]]>
</Comment>
<Comment Operand=".STATUS.STATE[3]">
<![CDATA[Conveyor Control Manual Mode]]>
</Comment>
<Comment Operand=".STATUS.STATE[4]">
<![CDATA[Conveyor Control Start Conveyor Motor]]>
</Comment>
<Comment Operand=".STATUS.STATE[5]">
<![CDATA[Conveyor Control
Turn On Feeder Bowl]]>
</Comment>
<Comment Operand=".STATUS.STATE[6]">
<![CDATA[Conveyor Control Run At Base Speed]]>
</Comment>
<Comment Operand=".STATUS.STATE[10]">
<![CDATA[Conveyor Control Run At Slow Speed]]>
</Comment>
<Comment Operand=".STATUS.STATE[12]">
<![CDATA[Conveyor Control Run At Fast Speed]]>
</Comment>
<Comment Operand=".STATUS.STATE[14]">
<![CDATA[Conveyor Control Change Back To Base Speed]]>
</Comment>
<Comment Operand=".STATUS.STATE[20]">
<![CDATA[Conveyor Control Wait Robot Running]]>
</Comment>
<Comment Operand=".STATUS.STATE[35]">
<![CDATA[Conveyor Control Turn Off Feeder Bowl]]>
</Comment>
<Comment Operand=".STATUS.STATE[40]">
<![CDATA[Conveyor Control Stop Conveyor Motor]]>
</Comment>
<Comment Operand=".STATUS.STATE[50]">
<![CDATA[Conveyor Control Wait For Pick Tool Ready]]>
</Comment>
<Comment Operand=".STATUS.STATE[61]">
<![CDATA[Conveyor Control Lock Out]]>
</Comment>
<Comment Operand=".STATUS.STATE[62]">
<![CDATA[Conveyor Control Cycle Stop]]>
</Comment>
<Comment Operand=".STATUS.STATE[63]">
