<DefaultData Format="L5K">
<![CDATA[17989]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="ASCII" Value="'FE'"/>
</DefaultData>
</Parameter>
<Parameter Name="IO1_Number" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Main Input/Output Number (0 = Encoder index, 1-8 = In/Out 1-8)]]>
