<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Robot Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor) [XIC(StateMachine[5]) ,XIC(StateMachine[6]) ] ,XIC(Alarm1.InAlarm) XIO(FaultReset) ]ALMD(Alarm1,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Robot Program To Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor) [XIC(StateMachine[30]) ,XIC(StateMachine[45]) ] ,XIC(Alarm2.InAlarm) XIO(FaultReset) ]ALMD(Alarm2,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Not Part Dropoff Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor) XIC(StateMachine[8]) ,XIC(Alarm3.InAlarm) XIO(FaultReset) ]ALMD(Alarm3,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Part Dropoff Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor) XIC(StateMachine[10]) ,XIC(Alarm4.InAlarm) XIO(FaultReset) ]ALMD(Alarm4,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(RobotInputs.InAutoMode)XIC(SafetyTimer)XIC(RobotInputs.Fault)[XIO(FeederType) XIO(RobotInputs.CollisionGuard) XIO(StateMachine[45]) XIO(StateMachine[46]) ,XIC(FeederType) ]ALMD(Alarm5,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Part On Conveyor]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor) XIC(StateMachine[7]) ,XIC(Alarm6.InAlarm) XIO(FaultReset) ]ALMD(Alarm6,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Program Wrong State]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor) XIC(StateMachine[4]) ,XIC(Alarm7.InAlarm) XIO(FaultReset) ]ALMD(Alarm7,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Recipe Load Failure]]>
</Comment>
<Text>
<![CDATA[XIC(RecipeError)ALMD(Alarm8,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Tool Unload Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor) XIC(StateMachine[20]) XIO(RobotInputs.ToolUnload) ,XIC(Alarm9.InAlarm) XIO(FaultReset) ]ALMD(Alarm9,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Tool Load Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor) XIC(StateMachine[20]) XIO(RobotInputs.ToolLoad) ,XIC(Alarm10.InAlarm) XIO(FaultReset) ]ALMD(Alarm10,0,FaultReset,0,1);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Alarm1.InAlarm)OTE(ProgStart);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Alarm2.InAlarm)OTE(ProgStop);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Alarm3.InAlarm)OTE(NOTDropoff);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Alarm4.InAlarm)OTE(Dropoff);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Alarm5.InAlarm)OTE(RobotFault);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Alarm6.InAlarm)OTE(PartConveyor);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Alarm7.InAlarm)OTE(WrongState);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Alarm8.InAlarm)OTE(RecipeFailure);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Alarm9.InAlarm)OTE(ToolUnload);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Alarm10.InAlarm)OTE(ToolLoad);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(Alarm1.InAlarm) ,XIC(Alarm2.InAlarm) ,XIC(Alarm3.InAlarm) ,XIC(Alarm4.InAlarm) ,XIC(Alarm5.InAlarm) ,XIC(Alarm6.InAlarm) ,XIC(Alarm7.InAlarm) ,XIC(Alarm8.InAlarm) ,XIC(Alarm9.InAlarm) ,XIC(Alarm10.InAlarm) ]OTE(AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
