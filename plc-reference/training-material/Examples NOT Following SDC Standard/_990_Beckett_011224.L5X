<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(BoxShift_SM.Status.State[6])XIC(BoxShift_SM.Control.Timer[0].DN)[XIO(r05Packaging_IN.Input[8].4) ,XIO(BinSelected) ]MOV(60,BoxShift_SM.Control.StateReg);]]>
