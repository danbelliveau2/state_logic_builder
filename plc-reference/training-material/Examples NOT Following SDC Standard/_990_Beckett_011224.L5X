<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Misc. Logic]]>
</Comment>
<Text>
<![CDATA[EQU(SupervisorState,3)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Status]]>
</Comment>
<Text>
<![CDATA[[DIV(Axis.Input.ActualPosition,PosScaling,HMI_ServoData.Status.ActualPosition) ,DIV(Axis.Input.ActualSpeed,VelScaling,HMI_ServoData.Status.ActualVelocity) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Control]]>
</Comment>
<Text>
<![CDATA[[MUL(HMI_ServoData.Control.Accel,VelScaling,Accel) ,MUL(HMI_ServoData.Control.Decel,VelScaling,Decel) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyStatus)XIC(Axis.Input.Ready)TON(AutoEnable_TMR,?,?)XIC(AutoEnable_TMR.DN)ONS(AutoEnable_ONS)OTE(Axis_AutoEnable);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(ManualMode) XIC(HMI_ServoData.Control.Enable) XIC(Axis.Input.Ready) ,XIC(Axis_AutoEnable) ]XIO(Axis.Input.Active)raC_Dvc_K5100_MSO(Axis_MSO,Axis);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Axis.Input.Ready)XIC(Axis.Input.Active)OTE(HMI_ServoData.Status.MotionEnable);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Disable Axis]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(HMI_ServoData.Control.Disable)XIC(Axis.Input.Active)raC_Dvc_K5100_MSF(Axis_MSF,Axis);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Home Axis]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)[XIC(HMI_ServoData.Control.HomeRequest) ,XIC(HMI_ServoData.Status.HomeRequested) ]XIC(Axis.Input.Ready)XIO(HomeRequest_TMR.DN)OTE(HMI_ServoData.Status.HomeRequested);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(HMI_ServoData.Status.HomeRequested)[TON(HomeRequest_TMR,?,?) ,XIC(HMI_ServoData.Control.HomeConfirm) raC_Dvc_K5100_MAH(Axis_MAH,Axis,HomeMethod,HomePosRef,HomeSpeedStart,HomeSpeedFinish,Accel,Decel) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Axis_MAH.Sts_IP) OTE(HMI_ServoData.Status.HomeIP) ,XIC(Axis_MAH.Sts_PC) OTE(HMI_ServoData.Status.HomePC) ,XIC(Axis_MAH.Sts_ER) OTE(HMI_ServoData.Status.HomeError) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(Axis.Input.Fault)[XIC(FaultReset) ,XIC(AutoEnable_TMR.TT) LIM(250,AutoEnable_TMR.ACC,500) ]raC_Dvc_K5100_MAFR(Axis_MAFR,Axis);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Jog]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(Axis.Input.Active)[XIC(HMI_ServoData.Control.JogPositive) XIO(HMI_ServoData.Control.JogNegative) MUL(HMI_ServoData.Control.JogSpeed,VelScaling,JogSpeed) ,XIC(HMI_ServoData.Control.JogNegative) XIO(HMI_ServoData.Control.JogPositive) CPT(JogSpeed,HMI_ServoData.Control.JogSpeed*VelScaling*-1) ]raC_Dvc_K5100_MAJ(Axis_MAJ,Axis,JogSpeed,Accel,Decel);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(Axis_MAJ.Sts_IP) XIO(HMI_ServoData.Control.JogPositive) XIO(HMI_ServoData.Control.JogNegative) ,XIO(SafetyStatus) ]raC_Dvc_K5100_MAS(Axis_MAS,Axis,Decel);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Inch Move]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(Axis.Input.Active)[XIC(HMI_ServoData.Control.InchPos) MUL(HMI_ServoData.Control.InchAmount,PosScaling,InchAmount) ,XIC(HMI_ServoData.Control.InchNeg) CPT(InchAmount,HMI_ServoData.Control.InchAmount*PosScaling*-1) ]ONS(Inch_ONS)MUL(HMI_ServoData.Control.ManualSpeed,VelScaling,ManSpeed)raC_Dvc_K5100_MAM(Axis_MAM,Axis,InchAmount,ManSpeed,Accel,Decel,2,1,0,0,0,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
