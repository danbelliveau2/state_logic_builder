<Routine Name="StationStatus_SUB" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Shift all station data after index complete]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[IF NOT BinSelected THEN]]>
</Line>
<Line Number="3">
<![CDATA[	COP(UnloadStatus[4],UnloadStatus[5],1);]]>
</Line>
<Line Number="4">
<![CDATA[	COP(UnloadStatus[3],UnloadStatus[4],1);]]>
</Line>
<Line Number="5">
<![CDATA[	COP(UnloadStatus[2],UnloadStatus[3],1);]]>
</Line>
<Line Number="6">
<![CDATA[	COP(UnloadStatus[1],UnloadStatus[2],1);]]>
</Line>
<Line Number="7">
<![CDATA[else]]>
</Line>
<Line Number="8">
<![CDATA[	COP(UnloadStatus[3],UnloadStatus[5],1);]]>
</Line>
<Line Number="9">
<![CDATA[	COP(UnloadStatus[1],UnloadStatus[3],1);]]>
</Line>
<Line Number="10">
<![CDATA[END_IF;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[UnloadStatus[1].S1Attempt:=0;]]>
</Line>
<Line Number="14">
<![CDATA[UnloadStatus[1].S1Success:=0;]]>
</Line>
<Line Number="15">
<![CDATA[UnloadStatus[1].S5Attempt:=0;]]>
</Line>
<Line Number="16">
<![CDATA[UnloadStatus[1].S5Success:=0;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[FOR StationNumber:=1 TO 5 DO]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[UnloadStatus[StationNumber].HeadNumber:= (TCAtStation1 + (13-StationNumber)) MOD 12;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[IF UnloadStatus[StationNumber].HeadNumber = 0 THEN]]>
</Line>
<Line Number="23">
<![CDATA[UnloadStatus[StationNumber].HeadNumber:=12;]]>
</Line>
<Line Number="24">
<![CDATA[END_IF;]]>
</Line>
<Line Number="25">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[S1HeadNumber:=UnloadStatus[1].HeadNumber;]]>
</Line>
<Line Number="28">
<![CDATA[S2HeadNumber:=UnloadStatus[2].HeadNumber;]]>
</Line>
<Line Number="29">
<![CDATA[S3HeadNumber:=UnloadStatus[3].HeadNumber;]]>
</Line>
<Line Number="30">
<![CDATA[S4HeadNumber:=UnloadStatus[4].HeadNumber;]]>
</Line>
<Line Number="31">
<![CDATA[S5HeadNumber:=UnloadStatus[5].HeadNumber;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="StatusClear_SUB" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Clear All Station Status Data]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[FOR i:=1 TO 5 DO]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[UnloadStatus[i].S1Attempt:=0;]]>
</Line>
<Line Number="5">
<![CDATA[UnloadStatus[i].S1Success:=0;]]>
</Line>
<Line Number="6">
<![CDATA[UnloadStatus[i].S5Attempt:=0;]]>
</Line>
<Line Number="7">
<![CDATA[UnloadStatus[i].S5Success:=0;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
