<DataType Name="raC_UDT_Dvc_K5100_AssmOutIOM" Family="NoFamily" Class="User">
<Description>
<![CDATA[K5100 Assembly Output Data (IO mode).]]>
</Description>
<Members>
<Member Name="OperatingMode" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Determines the drive operating mode when “Start Motion” has a zero-to-one transition (1 - Position mode; 2 - Speed mode; 3 - Home mode; 4 - Torque mode; 5 - Gear mode; 6 - Index mode)]]>
</Description>
</Member>
<Member Name="Control1" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="ServoOn" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="Control1" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[A zero-to-one transition will servo on the drive.]]>
</Description>
</Member>
<Member Name="ServoOff" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="Control1" BitNumber="1" ExternalAccess="Read/Write">
<Description>
<![CDATA[A zero-to-one transition will servo off the drive.]]>
</Description>
</Member>
<Member Name="StopMotion" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="Control1" BitNumber="2" ExternalAccess="Read/Write">
<Description>
<![CDATA[A zero-to-one transition will stop the drive.]]>
</Description>
</Member>
<Member Name="FaultReset" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="Control1" BitNumber="3" ExternalAccess="Read/Write">
<Description>
<![CDATA[A zero-to-one transition will try to clear the fault of the drive.]]>
</Description>
</Member>
<Member Name="StartMotion" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="Control1" BitNumber="4" ExternalAccess="Read/Write">
<Description>
<![CDATA[A zero-to-one transition means the motion command is issued from the external controller.]]>
</Description>
</Member>
<Member Name="Pad0" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="None"/>
<Member Name="HomingMethod" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Homing Method.]]>
</Description>
</Member>
<Member Name="SpeedReference" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Determines the command speed.]]>
</Description>
</Member>
<Member Name="AccelReference" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Determines the command acceleration.]]>
</Description>
</Member>
<Member Name="DecelReference" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Determines the command deceleration.]]>
</Description>
</Member>
<Member Name="PositionReference" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Determines the command position.]]>
</Description>
</Member>
<Member Name="HomeReturnSpeed" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Determines the command home return speed.]]>
</Description>
</Member>
<Member Name="NonCyclicMoveType" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Non cyclic move type (Absolute, Relative, Incremental, or Capture).]]>
</Description>
</Member>
<Member Name="CyclicMoveType" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Cyclic move type(Rotary Positive, Rotary Negative, or Rotary Shortest Path).]]>
</Description>
</Member>
<Member Name="TravelMode" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Position travel mode (NonCyclicMoveType or CyclicMoveType).]]>
</Description>
</Member>
<Member Name="Control2" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="PositionCommandOverride" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="Control2" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[Allows interruption of current movement, replacing it with a new movement.]]>
</Description>
</Member>
<Member Name="PositionCommandOverlap" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="Control2" BitNumber="1" ExternalAccess="Read/Write">
<Description>
<![CDATA[Allows overlapping of successive movements.]]>
</Description>
</Member>
<Member Name="CapturedPositionSelect" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="Control2" BitNumber="2" ExternalAccess="Read/Write">
<Description>
<![CDATA[Capture position selection (First captrue or second capture).]]>
