<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[AOI_MachineBasic(AOI_MachineBasic,MachineRunning,MachineBasic);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[NEQ(Recipe.Running.Name,RecipeNamePrevious)MOV(Recipe.Running.Name,RecipeNamePrevious)OTE(NewPartSelected);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[We want part pusher to lockout automatically when a 3'' part is loaded and unlockout automatically for other sizes.]]>
</Comment>
<Text>
<![CDATA[XIC(NewPartSelected)[EQU(Recipe.Running.BS,'11810') OTL(HMI_Data.StationStatus[4].Lockout) ,NEQ(Recipe.Running.BS,'11810') OTU(HMI_Data.StationStatus[4].Lockout) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(MainAssemblyOK)TON(RobotSafety_TMR,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Map Inputs]]>
</Comment>
<Text>
