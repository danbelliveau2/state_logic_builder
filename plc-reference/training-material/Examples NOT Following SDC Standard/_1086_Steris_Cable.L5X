<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Momentary input produces momentary output or pulse.

"Out" replaces EnableOut which has issues because it updates based on EnableIn
Not exactly sure if the only consequence may be visual in trends, but even if it's just that it can cause confusion while debugging. (D.E.S. 2021-05-26)]]>
</Comment>
<Text>
<![CDATA[XIC(Trigger)XIO(Invisible)XIO(Inactive)[XIO(UsePressHoldFeature) ,XIC(UsePressHoldFeature) MOVE(PressHoldTimeMsec,HoldTimer.PRE) TON(HoldTimer,?,?) XIC(HoldTimer.DN) ][XIO(PulseOutput) ,XIC(PulseOutput) ONS(OutputPulseOneShot) ]OTE(Out);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ButtonStatus is used to display the color and text on the indicator light ON THE BUTTON

When Indicator Status Equals:
0 - Indicator Is Invisible, Not Used
1 - Input Condition Off
2 - Input Condition ON]]>
</Comment>
<Text>
<![CDATA[[XIO(UseButtonIndicator) MOVE(0,IndicatorStatus) ,XIC(UseButtonIndicator) [XIO(IndicatorInput) MOVE(1,IndicatorStatus) ,XIC(IndicatorInput) MOVE(2,IndicatorStatus) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(InterlockActive) LT(SecurityCurrentLevelTag,MinAccessLevel) ,XIC(InterlockActive) ]OTE(Inactive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(VisibilityCondition)OTE(Invisible);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="OGDxxx_8PORT_IOL" Class="Standard" Revision="2.1" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2022-05-13T19:57:08.674Z" CreatedBy="INTRAIFM\ushoopla" EditedDate="2024-05-28T19:53:50.582Z" EditedBy="INTRAIFM\ushoopla" SoftwareRevision="v35.00"
>
<RevisionNote>
<![CDATA[5/2022:updated to current AOI standards:LH
5/2024: Added Device ID's 1581(OGD550) and 1582(OGD551)]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="PLC_Input" TagType="Base" DataType="INT" Dimensions="223" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Reference the Input Controller tag <IOLinkMasterName>:I1.Data]]>
</Description>
</Parameter>
<Parameter Name="Port_Process_Data_Size" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[User Input Value from the Configuration Controller tag <IOLinkMasterName>:C.Port_Process_Data_Size]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[4]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="4"/>
</DefaultData>
</Parameter>
<Parameter Name="Port_Number" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[User Input Value = Port number of the IO-Link Master]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Vendor_ID" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Read only value indicating the manufacturer of the IO-Link Device. ifm=310 dec]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Device_ID" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Read only value set by the manufacturer of the device. Varies by product family]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="IOL_Mode" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[True: Port is configured for IO-Link Communication. False: Port is not configured for IO-Link Communication]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Device_Not_Connected" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[True: No IO-Link Device is connected
False: IO-Link Device is connected]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
