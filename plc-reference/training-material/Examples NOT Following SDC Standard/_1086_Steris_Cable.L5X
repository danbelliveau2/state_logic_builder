<Parameter Name="LocalAlarmsArrayTag" TagType="Base" DataType="AlarmData" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Local array tag.
Faults,
Warnings]]>
</Description>
</Parameter>
