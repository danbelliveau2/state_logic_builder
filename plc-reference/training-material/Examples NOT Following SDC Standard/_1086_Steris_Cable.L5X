<Rung Number="7" Type="N">
<Text>
<![CDATA[[[XIC(Infeed_Puller.ExcessivePositionErrorFault) ,XIC(Infeed_Puller.TorqueLimitStatus) ] MOVE(10,TmrFlt_CamTorq_Servo_InfeedPuller.PRE) TON(TmrFlt_CamTorq_Servo_InfeedPuller,?,?) XIC(TmrFlt_CamTorq_Servo_InfeedPuller.DN) ONS(OneShotFlt.8) ,XIC(Fault[8].Active) XIO(\Main.FaultReset) ]OTE(Fault[8].Active)OTE(HMI_Data.Status.Alarms.Fault[8]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[[XIC(Outfeed_Puller.ExcessivePositionErrorFault) ,XIC(Outfeed_Puller.TorqueLimitStatus) ] MOVE(10,TmrFlt_CamTorq_Servo_OutfeedPuller.PRE) TON(TmrFlt_CamTorq_Servo_OutfeedPuller,?,?) XIC(TmrFlt_CamTorq_Servo_OutfeedPuller.DN) ONS(OneShotFlt.9) ,XIC(Fault[9].Active) XIO(\Main.FaultReset) ]OTE(Fault[9].Active)OTE(HMI_Data.Status.Alarms.Fault[9]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Status.State[5]) XIO(Infeed_Puller.DriveEnableStatus) ,XIC(Fault[10].Active) XIO(\Main.FaultReset) ]OTE(Fault[10].Active)OTE(HMI_Data.Status.Alarms.Fault[10]);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(Status.State[5]) XIO(Outfeed_Puller.DriveEnableStatus) ,XIC(Fault[11].Active) XIO(\Main.FaultReset) ]OTE(Fault[11].Active)OTE(HMI_Data.Status.Alarms.Fault[11]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(MODE_Auto)[XIC(Part_Ready) [AFI() CPT(Pullers_Detected_Slip,HMI_Status.Infeed_Puller.ActualPos-HMI_Data.Status.External_Encoder) ,SUB(HMI_Status.Infeed_Puller.ActualPos,HMI_Data.Status.External_Encoder,Pullers_Detected_Slip) ] [LT(Pullers_Detected_Slip,Pullers_Detected_Slip_Low_Limit) ,GT(Pullers_Detected_Slip,Pullers_Detected_Slip_High_Limit) ] ,XIC(Fault[12].Active) XIO(\Main.FaultReset) ]OTE(Fault[12].Active)OTE(HMI_Data.Status.Alarms.Fault[12]);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Part_Ready)[TON(MotionTimers[9],?,?) ,XIC(MotionTimers[9].DN) OTE(HMI_Data.Control.Button[25]) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(MODE_Auto)[XIC(Laser_Cut_1) XIO(Laser_Cut_1_DONE) TON(Laser_did_not_fire_FAULT,?,?) XIC(Laser_did_not_fire_FAULT.DN) ONS(OneShot.0) ,XIC(Fault[13].Active) XIO(\Main.FaultReset) ]OTE(Fault[13].Active)OTE(HMI_Data.Status.Alarms.Fault[13]);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Pneumatic actuators faults]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Sensors_Bypass[0])[XIC(OUT_Infeed_Gripper_ON_EXT) XIO(IN_Infeed_Gripper_ON) TON(TmrFltArray[0],?,?) XIC(TmrFltArray[0].DN) ,XIC(Fault[20].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[20].Active)OTE(HMI_Data.Status.Alarms.Fault[20]);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Sensors_Bypass[1])[XIC(OUT_Infeed_Gripper_OFF_RET) XIO(IN_Infeed_Gripper_OFF) TON(TmrFltArray[1],?,?) XIC(TmrFltArray[1].DN) ,XIC(Fault[21].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[21].Active)OTE(HMI_Data.Status.Alarms.Fault[21]);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Sensors_Bypass[2])[XIC(OUT_Outfeed_Gripper_ON_EXT) XIO(IN_Outfeed_Gripper_ON) TON(TmrFltArray[2],?,?) XIC(TmrFltArray[2].DN) ,XIC(Fault[22].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[22].Active)OTE(HMI_Data.Status.Alarms.Fault[22]);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Sensors_Bypass[3])[XIC(OUT_Outfeed_Gripper_OFF_RET) XIO(IN_Outfeed_Gripper_OFF) TON(TmrFltArray[3],?,?) XIC(TmrFltArray[3].DN) ,XIC(Fault[23].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[23].Active)OTE(HMI_Data.Status.Alarms.Fault[23]);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[XIC(OUT_Rotary_Actuator_EXT_DOWN) XIO(IN_Rotary_Payout_DOWN) TON(TmrFltArray[4],?,?) XIC(TmrFltArray[4].DN) ,XIC(Fault[24].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[24].Active)OTE(HMI_Data.Status.Alarms.Fault[24]);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(OUT_Rotary_Actuator_RET_UP) XIO(IN_Rotary_Payout_UP) TON(TmrFltArray[5],?,?) XIC(TmrFltArray[5].DN) ,XIC(Fault[25].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[25].Active)OTE(HMI_Data.Status.Alarms.Fault[25]);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[AFI()[XIC(OUT_Shift_Cylinder_EXT) XIO(IN_Shift_Cylinder_EXT) TON(TmrFltArray[6],?,?) XIC(TmrFltArray[6].DN) ,XIC(Fault[26].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[26].Active)OTE(HMI_Data.Status.Alarms.Fault[26]);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIC(MotionInstructions[1].MAM_Inst[1].EN) XIC(IN_Payout_Part_Present) TON(TmrFltArray[7],?,?) XIC(TmrFltArray[7].DN) ONS(OneShot.1) ,XIC(Fault[27].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[27].Active)OTE(HMI_Data.Status.Alarms.Fault[27]);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[[XIC(MotionInstructions[1].MAM_Inst[0].EN) XIO(IN_Payout_Part_Present) TON(TmrFltArray[8],?,?) XIC(TmrFltArray[8].DN) ONS(OneShot.1) ,XIC(Fault[28].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(Fault[28].Active)OTE(HMI_Data.Status.Alarms.Fault[28]);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Verify that the Part Present sensor goes On and Off
at least a couple times during the cycle]]>
</Comment>
<Text>
<![CDATA[XIC(MotionInstructions[1].MAM_Inst[0].EN)ONS(OneShot.3)OTE(GearedMove_StartPLS);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(MODE_Cycle_Running)XIC(MotionInstructions[1].MAM_Inst[0].EN)ONS(OneShot.4)CTU(Cycle_CTR,?,?);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIO(MODE_Cycle_Running)RES(Cycle_CTR);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(IN_Payout_Part_Present)[TON(MotionTimers[5],?,?) ,XIC(MotionTimers[5].DN) CTU(PartPresent_OnOff_CTR,?,?) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[[XIC(GearedMove_StartPLS) LT(PartPresent_OnOff_CTR.ACC,3) GT(Cycle_CTR.ACC,2) ,XIC(Fault[28].Active) XIO(MAIN_Flt_Reset_Pulse) ]OTE(HMI_Data.Status.Alarms.Fault[28])OTE(HMI_Data.Status.Alarms.Fault[28]);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIC(GearedMove_StartPLS)RES(PartPresent_OnOff_CTR);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Running Geared Move with Reel Program NOT in State 5 (Running)]]>
</Comment>
<Text>
<![CDATA[XIC(MotionInstructions[1].MAM_Inst[0].EN)XIO(Reel_Running)OTE(Fault[29].Active)OTE(HMI_Data.Status.Alarms.Fault[29]);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_FaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_WarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Pullers" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Set torque limits to the drives]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[HMI Status]]>
</Comment>
<Text>
<![CDATA[MOVE(Infeed_Puller.ActualVelocity,HMI_Status.Infeed_Puller.ActualSpd)MOVE(Outfeed_Puller.ActualVelocity,HMI_Status.Outfeed_Puller.ActualSpd)MOVE(Outfeed_Puller.ActualPosition,HMI_Status.Outfeed_Puller.ActualPos);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Calculating the Encoder increment over one cycle]]>
</Comment>
<Text>
<![CDATA[XIC(MotionInstructions[1].MAM_Inst[0].EN)ONS(motiononeshots[0])[MOVE(Standalone_Encoder_Count,standalone_Encoder_Count_Last) ,MOVE(0,Standalone_Encoder_Count_Payout) ,MOVE(0,Standalone_Encoder_Count_Revs) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(MotionTimers[1].EN)[LT(Standalone_Encoder_Count,Standalone_Encoder_Count_Temp) SUB(Standalone_Encoder_Count_Temp,Standalone_Encoder_Count,Standalone_Encoder_Count_Delta) GT(Standalone_Encoder_Count_Delta,100) CPT(Standalone_Encoder_Count_Revs,(Standalone_Encoder_Count_Revs+1)) ,MOVE(Standalone_Encoder_Count,Standalone_Encoder_Count_Temp) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CPT(HMI_Data.Status.External_Encoder,(((Standalone_Encoder_Count_Revs-1)*1024)+(1024-standalone_Encoder_Count_Last)+Standalone_Encoder_Count)/130.048);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[AFI()CPT(HMI_Data.Status.External_Encoder,((Standalone_Encoder_Count_Revs*1024)+(1024-standalone_Encoder_Count_Last)+Standalone_Encoder_Count)/141.2);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Motion Parameter from HMI]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Data.Control.Button[27])[MOVE(HMI_ServoParams.Auto_Speed,MotionParameters[4].Vel) ,MOVE(UngearedVelocity,MotionParameters[5].Vel) ,MOVE(HMI_ServoParams.Acceleration,MotionParameters[4].Acc) ,MOVE(UngearedAcceleration,MotionParameters[5].Acc) ,MOVE(HMI_ServoParams.Deceleration,MotionParameters[4].Dec) ,MOVE(UngearedDeceleration,MotionParameters[5].Dec) ,MOVE(HMI_ServoParams.Geared_Increment,MotionParameters[4].GearInc) ,MOVE(HMI_ServoParams.UnGeared_Incremental,MotionParameters[4].UnGearInc) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[MOVE(Pullers_Detected_Slip_Limit,Pullers_Detected_Slip_High_Limit)CPT(Pullers_Detected_Slip_Low_Limit,Pullers_Detected_Slip_Limit*-1);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Outfeed_Puller.GearingStatus)OTE(HMI_Status.GearingActive);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Pullers.GroupSynced)XIO(Infeed_Puller.SafeTorqueOffInhibit)XIC(Infeed_Puller.DriveEnableStatus)OTE(HMI_Status.Infeed_Puller.Enabled);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Pullers.GroupSynced)XIO(Outfeed_Puller.SafeTorqueOffInhibit)XIC(Outfeed_Puller.DriveEnableStatus)OTE(HMI_Status.Outfeed_Puller.Enabled);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(Infeed_Puller.MoveStatus)XIO(Infeed_Puller.JogStatus)XIO(MotionInstructions[1].MSO_Inst[0].IP)XIO(MotionInstructions[1].MSF_Inst[0].IP)OTE(INfeed_puller_MotionStopped);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(Outfeed_Puller.MoveStatus)XIO(Outfeed_Puller.JogStatus)XIO(MotionInstructions[1].MSO_Inst[0].IP)XIO(MotionInstructions[1].MSF_Inst[0].IP)OTE(Outfeed_puller_MotionStopped);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 0
E-Stop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[XIC(\Safety.SafeOKMain) MOVE(1,Control.StateReg) ,XIC(HMI_Control.Button[10]) MOVE(40,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 1
Stop All Servo Drive Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])[XIO(Infeed_Puller.ShutdownStatus) MAS(Infeed_Puller,MotionInstructions[1].MAS_Inst[0],All,No,0,Units per sec2,No,0,Units per sec3) XIC(MotionInstructions[1].MAS_Inst[0].DN) ,XIC(Infeed_Puller.ShutdownStatus) MASR(Infeed_Puller,MotionInstructions[1].MASR_Inst[0]) XIC(MotionInstructions[1].MASR_Inst[0].DN) ][XIO(Outfeed_Puller.ShutdownStatus) MAS(Outfeed_Puller,MotionInstructions[2].MAS_Inst[0],All,No,0,Units per sec2,No,0,Units per sec3) XIC(MotionInstructions[2].MAS_Inst[0].DN) ,XIC(Outfeed_Puller.ShutdownStatus) MASR(Outfeed_Puller,MotionInstructions[2].MASR_Inst[0]) XIC(MotionInstructions[2].MASR_Inst[0].DN) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 2
Fault Reset Servo Drives]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])MAFR(Infeed_Puller,MotionInstructions[1].MAFR_Inst[0])MAFR(Outfeed_Puller,MotionInstructions[1].MAFR_Inst[1])XIC(MotionInstructions[1].MAFR_Inst[0].DN)XIC(MotionInstructions[1].MAFR_Inst[1].DN)MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 3
Enable Servo]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])TON(Delay1sec,?,?)XIC(Delay1sec.DN)[XIC(Infeed_Puller.AxisHomedStatus) MSO(Infeed_Puller,MotionInstructions[1].MSO_Inst[0]) ,XIC(Outfeed_Puller.AxisHomedStatus) MSO(Outfeed_Puller,MotionInstructions[1].MSO_Inst[1]) ,XIC(Infeed_Puller.AxisHomedStatus) XIC(Outfeed_Puller.AxisHomedStatus) XIC(Infeed_Puller.DriveEnableStatus) XIC(Outfeed_Puller.DriveEnableStatus) MOVE(5,Control.StateReg) ,[XIO(Infeed_Puller.AxisHomedStatus) ,XIO(Outfeed_Puller.AxisHomedStatus) ] MOVE(40,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 5
Ready / Idle / Start Gearing]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])[[XIC(MODE_Auto) ,XIO(MODE_Auto) ] XIO(Part_Ready) XIC(Infeed_Puller.DriveEnableStatus) XIC(Outfeed_Puller.DriveEnableStatus) [XIO(MotionInstructions[1].MAG_Inst[1].IP) ,XIO(MotionInstructions[1].MAG_Inst[1].DN) ] MAG(Outfeed_Puller,Infeed_Puller,MotionInstructions[1].MAG_Inst[0],0,1.0,0,0,Actual,Real,Disabled,0,Units per sec2) XIC(Outfeed_Puller.GearingStatus) MOVE(6,Control.StateReg) ,XIC(MODE_Cycle_Starting) XIC(MODE_Auto) XIC(Infeed_Puller.GearingStatus) MOVE(11,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 6
Gearing in Process]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])XIC(MotionInstructions[1].MAG_Inst[0].IP)XIC(MotionInstructions[1].MAG_Inst[0].DN)XIC(Outfeed_Puller.GearingStatus)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 7
Pullers Geared
System Ready

Gripper OFF]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])[XIC(MODE_Auto) [XIC(MODE_Cycle_Running) ,XIC(HMI_Data.Control.Button[5]) ] XIC(OUT_Infeed_Gripper_OFF_RET) XIC(OUT_Outfeed_Gripper_OFF_RET) TON(TmrFltArray[10],?,?) XIC(TmrFltArray[10].DN) MOVE(11,Control.StateReg) ,XIO(MODE_Auto) MAS(Infeed_Puller,MotionInstructions[1].MAS_Inst[5],Move,Yes,MotionParameters[4].Dec,Units per sec2,No,0,Units per sec3) XIC(MotionInstructions[1].MAS_Inst[5].DN) MAS(Outfeed_Puller,MotionInstructions[1].MAS_Inst[6],Move,Yes,MotionParameters[4].Dec,Units per sec2,No,0,Units per sec3) XIC(MotionInstructions[1].MAS_Inst[6].DN) [XIC(HMI_Data.Control.Button[19]) ONS(motiononeshots[1]) MOVE(11,Control.StateReg) ,XIC(HMI_Data.Control.Button[22]) ONS(motiononeshots[2]) MOVE(20,Control.StateReg) ] ,XIC(Outfeed_Puller.GearingStatus) OTE(AxisGeared) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 10
Geared Pullers
Incremental Move to 
Geared Setpoint]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])XIC(OUT_Infeed_Gripper_OFF_RET)XIC(OUT_Outfeed_Gripper_OFF_RET)TON(TmrFltArray[11],?,?)XIC(TmrFltArray[11].DN)[SSV(Axis,Infeed_Puller,TorqueLimitPositive,Infeed_PosTorqueLimHi) MUL(Infeed_PosTorqueLimHi,-1,Infeed_NegTorqueLimHi) SSV(Axis,Infeed_Puller,TorqueLimitNegative,Infeed_NegTorqueLimHi) MAM(Infeed_Puller,MotionInstructions[1].MAM_Inst[0],0,MotionParameters[4].GearInc,MotionParameters[4].Vel,Units per sec,MotionParameters[4].Acc,Units per sec2,MotionParameters[4].Dec,Units per sec2,S-Curve,10,10,% of Time,Disabled,0,0,None,0,0) ,XIC(MotionInstructions[1].MAM_Inst[0].ER) MOVE(40,Control.StateReg) ,XIC(MotionInstructions[1].MAM_Inst[0].PC) [MOVE(Infeed_Puller.ActualPosition,HMI_Status.Infeed_Puller.ActualPos) ,MOVE(MotionTimers[1].ACC,MotionTimersLast[1]) ,MOVE(12,Control.StateReg) ] ,TON(MotionTimers[1],?,?) ,LIMIT(0,MotionTimers[1].ACC,1000) OTU(Laser_Cut_1) ,LIMIT(2600,MotionTimers[1].ACC,2700) OTL(Laser_Cut_1) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[State 11
Infeed Puller
Set Home (Zero Pos)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[11])[XIC(MotionInstructions[1].MAH_Inst[1].EN) XIC(Infeed_Puller.AxisHomedStatus) XIC(MotionInstructions[1].MAH_Inst[1].DN) MOVE(10,Control.StateReg) ,MAH(Infeed_Puller,MotionInstructions[1].MAH_Inst[1]) ,XIC(MotionInstructions[1].MAH_Inst[1].ER) OTL(Infeed_Puller_Homing_Error) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[State 12
OutfeedPuller
Set Home (Zero Pos)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[12])[XIC(Outfeed_Puller.AxisHomedStatus) XIC(MotionInstructions[1].MAH_Inst[2].EN) XIC(MotionInstructions[1].MAH_Inst[2].DN) [XIC(MODE_Auto) MOVE(15,Control.StateReg) ,XIO(MODE_Auto) MOVE(7,Control.StateReg) ] ,MAH(Outfeed_Puller,MotionInstructions[1].MAH_Inst[2]) ,XIC(MotionInstructions[1].MAH_Inst[2].ER) OTL(Outfeed_Puller_Homing_Error) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[STATE 13
Disable Gearing]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])[MAS(Infeed_Puller,MotionInstructions[2].MAS_Inst[3],Gear,Yes,MotionParameters[4].Dec,Units per sec2,No,0,Units per sec3) ,XIC(MotionInstructions[2].MAS_Inst[3].DN) MOVE(14,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[STATE 14
Gearing Disabled]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[14])XIO(Infeed_Puller.GearingStatus)MOVE(15,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[STATE 15
GRIPPER ON and LASER CUT
WHILE shifting OUTFEED ]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[15])[XIC(AlwaysOff) MAM(Outfeed_Puller,MotionInstructions[1].MAM_Inst[2],0,Outfeed_Puller_Shift,outfeed_Puller_Shift_Velocity,Units per sec,Outfeed_Puller_Shift_Acceleration,Units per sec2,Outfeed_Puller_Shift_Deceleration,Units per sec2,Trapezoidal,1,1,% of Time,Disabled,0,0,None,0,0) ,XIC(MotionInstructions[1].MAM_Inst[2].ER) MOVE(40,Control.StateReg) ,TON(Laser_Cut_Timer,?,?) ,[XIC(MotionInstructions[1].MAM_Inst[2].PC) ,XIO(AlwaysOff) ] XIO(IPG_YLR_Laser:I.Input_Data1.1) XIC(Laser_Cut_Timer.DN) MOVE(16,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[STATE 16
SHIFT Cylinder MOVE
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])MOVE(17,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[STATE 17
LASER WELD]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[17])MOVE(18,Control.StateReg);]]>
</Text>
</Rung>
