<Tag Name="Setup_AutoLogoutTimeInSec" TagType="Base" DataType="DINT" Radix="Decimal" Constant="true" ExternalAccess="None" OpcUaAccess="None">
<Description>
<![CDATA[Auto Logout Time in Seconds]]>
</Description>
<Data Format="L5K">
<![CDATA[600]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="600"/>
</Data>
