<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(\Safety.SafeOKMain)MOVE(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])XIC(\Safety.SafeOKMain)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[STATE 1
EStop Reset
 Check Laser Keyswitch ON, Laser Start from Safety]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(LaserRemoteKey_OUT)XIC(LaserRemoteStart_OUT)MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STATE 2
Check Power Supply Active]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(IN_Laser_PS_Active)MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STATE 3
Check Communications Active]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])XIC(PowerUPCompleted)XIO(IPG_YLR_Laser:I.Input_Data5.4)XIO(IPG_YLR_Laser:I.Input_Data5.5)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 4
Check Communications Active]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(PowerUPCompleted)XIO(IPG_YLR_Laser:I.ConnectionFaulted)MOVE(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 5
Check if Laser Error]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])XIO(IPG_YLR_Laser:I.Input_Data1.2)MOVE(6,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 6
Ready
]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])XIO(IPG_YLR_Laser:I.Input_Data1.1)[OTE(Laser_Ready) ,OTL(OUT_to_Laser_Enable) OTL(OUT_to_Laser_Start) ,[XIC(MODE_Auto) ,XIO(MODE_Auto) ] MOVE(7,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 7
Set GroupID
Bit0 to select GroupID:0
Strobe to take effect]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])[OTU(IPG_YLR_Laser:O.Output_Data4.0) ,XIO(IPG_YLR_Laser:I.Input_Data1.2) MOVE(8,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 8
Set JobID
Bit0 to select JobID:0
Strobe to take effect]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])[OTU(IPG_YLR_Laser:O.Output_Data4.8) ,XIO(IPG_YLR_Laser:I.Input_Data1.2) MOVE(9,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 9
Set Process Control Data
Strobe to take effect]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[9])[OTU(IPG_YLR_Laser:O.Output_Data4.13) ,XIO(IPG_YLR_Laser:I.Input_Data1.2) MOVE(10,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 10
Laser Cut 1
]]>
</Comment>
<Text>
