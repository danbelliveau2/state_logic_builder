<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[NOTES: 
The *.Status Bit signifies that the point has been confirgured to be used. (Module Config --> Points Tab). Thats why the status needs to be included in the check to see if a particular point has a fault.]]>
</Comment>
<Text>
<![CDATA[[XIC(ControllerModuleTag_Inputs.Pt00.Status) [XIC(ControllerModuleTag_Inputs.Pt00.Fault) ,XIC(ControllerModuleTag_Inputs.Pt00.ShortCircuit) ] ,XIC(ControllerModuleTag_Inputs.Pt01.Status) [XIC(ControllerModuleTag_Inputs.Pt01.Fault) ,XIC(ControllerModuleTag_Inputs.Pt01.ShortCircuit) ] ,XIC(ControllerModuleTag_Inputs.Pt02.Status) [XIC(ControllerModuleTag_Inputs.Pt02.Fault) ,XIC(ControllerModuleTag_Inputs.Pt02.ShortCircuit) ] ,XIC(ControllerModuleTag_Inputs.Pt03.Status) [XIC(ControllerModuleTag_Inputs.Pt03.Fault) ,XIC(ControllerModuleTag_Inputs.Pt03.ShortCircuit) ] ,XIC(ControllerModuleTag_Inputs.Pt04.Status) [XIC(ControllerModuleTag_Inputs.Pt04.Fault) ,XIC(ControllerModuleTag_Inputs.Pt04.ShortCircuit) ] ,XIC(ControllerModuleTag_Inputs.Pt05.Status) [XIC(ControllerModuleTag_Inputs.Pt05.Fault) ,XIC(ControllerModuleTag_Inputs.Pt05.ShortCircuit) ] ,XIC(ControllerModuleTag_Inputs.Pt06.Status) [XIC(ControllerModuleTag_Inputs.Pt06.Fault) ,XIC(ControllerModuleTag_Inputs.Pt06.ShortCircuit) ] ,XIC(ControllerModuleTag_Inputs.Pt07.Status) [XIC(ControllerModuleTag_Inputs.Pt07.Fault) ,XIC(ControllerModuleTag_Inputs.Pt07.ShortCircuit) ] ]OTE(PointFaulted);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(ControllerModuleTag_Inputs.RunMode) ,XIC(ControllerModuleTag_Inputs.ConnectionFaulted) ]XIO(PointFaulted)OTE(ModuleFaulted);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(ModuleFaulted)XIO(PointFaulted)OTE(OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
