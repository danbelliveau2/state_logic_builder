<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="AlarmFilter" Class="Standard" Revision="3.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-08-23T18:02:02.410Z" CreatedBy="STEVENDOUGLAS\dshaner" EditedDate="2022-06-16T21:12:04.198Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v34.00">
<Description>
<![CDATA[Creates an array with alarms from only the selected groups]]>
</Description>
<RevisionNote>
<![CDATA[v3.0 : 2022-06-16 D.E.S. ]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="ActiveArrayTag" TagType="Base" DataType="AlarmData" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Active array tag. \Alarms.Active]]>
</Description>
</Parameter>
<Parameter Name="FilteredArrayTag" TagType="Base" DataType="AlarmData" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Filter array tag. \Alarms.Filter]]>
</Description>
</Parameter>
<Parameter Name="FilterMaskTag" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<Description>
<![CDATA[Bitmask for alarms you want to see.
(-1 to see all groups)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="ActiveIndex" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="FilterIndex" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="FilterResult" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Active_size" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Filtered_size" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="EmptyAlarmData" DataType="AlarmData" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0,0,[0,'$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'],0,0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="AlarmData">
<DataValueMember Name="ProgramID" DataType="INT" Radix="Decimal" Value="0"/>
<DataValueMember Name="AlarmID" DataType="INT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Severity" DataType="INT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Group" DataType="INT" Radix="Decimal" Value="0"/>
<StructureMember Name="Message" DataType="STRING100">
<DataValueMember Name="LEN" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="DATA" DataType="STRING100" Radix="ASCII">
<![CDATA[]]>
</DataValueMember>
</StructureMember>
<DataValueMember Name="TimeStamp" DataType="LINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Count" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Duration" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Active" DataType="BOOL" Value="0"/>
<DataValueMember Name="DoNotSaveToHistory" DataType="BOOL" Value="0"/>
<DataValueMember Name="HMI_ResetCount" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="FilterCheck" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[SIZE(ActiveArrayTag, 0, Active_size);]]>
</Line>
<Line Number="1">
<![CDATA[SIZE(FilteredArrayTag, 0, Filtered_size);]]>
</Line>
<Line Number="2">
<![CDATA[FilterIndex := 0;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[//Put the alarms from the Active Array that match the Filter into the Filtered array]]>
</Line>
<Line Number="5">
<![CDATA[for ActiveIndex := 0 to Active_size - 1 by 1 do]]>
</Line>
<Line Number="6">
<![CDATA[	FilterResult := 2**ActiveArrayTag[ActiveIndex].Group;]]>
</Line>
<Line Number="7">
<![CDATA[	FilterCheck := FilterMaskTag AND FilterResult;]]>
</Line>
<Line Number="8">
<![CDATA[	if (FilterCheck > 0) then]]>
</Line>
<Line Number="9">
<![CDATA[		COP(ActiveArrayTag[ActiveIndex], FilteredArrayTag[FilterIndex], 1);]]>
</Line>
<Line Number="10">
<![CDATA[		FilterIndex := FilterIndex + 1;]]>
</Line>
<Line Number="11">
<![CDATA[	end_if;]]>
</Line>
<Line Number="12">
<![CDATA[	if (FilterIndex >= Filtered_size) then exit; end_if;]]>
</Line>
<Line Number="13">
<![CDATA[end_for;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[while (FilterIndex < Filtered_size) do]]>
</Line>
<Line Number="16">
<![CDATA[	//Clear the remaining Filtered Array items]]>
</Line>
<Line Number="17">
<![CDATA[	COP(EmptyAlarmData, FilteredArrayTag[FilterIndex], 1);]]>
</Line>
<Line Number="18">
<![CDATA[	FilterIndex := FilterIndex + 1;]]>
</Line>
<Line Number="19">
<![CDATA[end_while;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Alarm_Handler_96Max_V1_2" Class="Standard" Revision="1.2" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-08-15T19:36:50.295Z" CreatedBy="EELaptop5\David Shaner" EditedDate="2013-10-28T13:30:15.478Z" EditedBy="EELaptop5\David Shaner" SoftwareRevision="v21.00"
>
<Description>
<![CDATA[Uses Arrays Of Fault And Warning Messages, and Places Highest Priority Alarm Number In A Word. Also, Assigns a Number For Color. ]]>
</Description>
<RevisionNote>
<![CDATA[Updated so AlarmNumber and Color don't flicker on HMI or in PLC monitor.]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="AlarmDataTag" TagType="Base" DataType="Alarms" Usage="InOut" Required="true" Visible="true" Constant="false">
<Comments>
<Comment Operand=".ALARMNUMBER">
<![CDATA[Alarm Banner
Number Of Highest Priority Alarm Active 
(Smallest Number)]]>
</Comment>
<Comment Operand=".ALARMCOLOR">
<![CDATA[Alarm Banner 
Color
1=Red
2=Yellow
3=Green]]>
</Comment>
</Comments>
</Parameter>
<Parameter Name="NumFaultBits" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number Of Fault BIts]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="NumWarnBits" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number Of Warning Bits]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="AlarmIter" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="WarningSize" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="FaultSize" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="TotalArraySize" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//SIZE(Alarm_Tag.Faults, 0, FaultSize); //SIZE function does not work on BOOL arrays!]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[/*Be carefult making changes. The code sequence and manner of setting and clearing bits]]>
</Line>
<Line Number="3">
<![CDATA[  is necessary to ensure HMI & PLC Monitor do not catch tag values]]>
</Line>
<Line Number="4">
<![CDATA[  that are actively being changed by this code. */]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[/*****STATUS DISPLAY COLOR LOGIC****]]>
</Line>
<Line Number="7">
<![CDATA[  0=Grey]]>
</Line>
<Line Number="8">
<![CDATA[  1=Red (Fault)]]>
</Line>
<Line Number="9">
<![CDATA[  2=Yellow (Warning)]]>
</Line>
<Line Number="10">
<![CDATA[  3=Green (OK)*/]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[//Fault[0] cannot be used. HMI refuses to use a trigger of zero.]]>
</Line>
<Line Number="13">
<![CDATA[//NumFaultBits and NumWarnBits cannot exceed 95.]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[//Faults]]>
</Line>
<Line Number="16">
<![CDATA[FOR AlarmIter := 1 TO NumFaultBits DO]]>
</Line>
<Line Number="17">
<![CDATA[	IF (AlarmDataTag.Fault[AlarmIter]) THEN]]>
</Line>
<Line Number="18">
<![CDATA[		AlarmDataTag.AlarmNumber := AlarmIter;]]>
</Line>
<Line Number="19">
<![CDATA[		AlarmDataTag.AlarmColor := 1;]]>
</Line>
<Line Number="20">
<![CDATA[		AlarmDataTag.NoFaults := 0;]]>
</Line>
<Line Number="21">
<![CDATA[		EXIT; //Exits the FOR loop only]]>
</Line>
<Line Number="22">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="23">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="24">
<![CDATA[IF (AlarmIter = NumFaultBits + 1) THEN //No Fault active]]>
</Line>
<Line Number="25">
<![CDATA[	AlarmDataTag.NoFaults := 1;]]>
</Line>
<Line Number="26">
<![CDATA[END_IF;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[//Warnings]]>
</Line>
<Line Number="29">
<![CDATA[FOR AlarmIter := 0 TO NumWarnBits DO]]>
</Line>
<Line Number="30">
<![CDATA[	IF (AlarmDataTag.Warning[AlarmIter]) THEN]]>
</Line>
<Line Number="31">
<![CDATA[		IF (AlarmDataTag.NoFaults) THEN]]>
</Line>
<Line Number="32">
<![CDATA[			AlarmDataTag.AlarmNumber := AlarmIter + 96;]]>
</Line>
<Line Number="33">
<![CDATA[			AlarmDataTag.AlarmColor := 2;]]>
</Line>
<Line Number="34">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="35">
<![CDATA[		AlarmDataTag.NoWarnings := 0;]]>
</Line>
<Line Number="36">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="37">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="38">
<![CDATA[END_FOR;	]]>
</Line>
<Line Number="39">
<![CDATA[IF (AlarmIter = NumWarnBits + 1) THEN //No Warnings active]]>
</Line>
<Line Number="40">
<![CDATA[	AlarmDataTag.NoWarnings := 1;]]>
</Line>
<Line Number="41">
<![CDATA[END_IF;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[//No Faults or Warnings.]]>
</Line>
<Line Number="44">
<![CDATA[IF (AlarmDataTag.NoFaults AND AlarmDataTag.NoWarnings) THEN]]>
</Line>
<Line Number="45">
<![CDATA[	AlarmDataTag.AlarmNumber := 192;]]>
</Line>
<Line Number="46">
<![CDATA[	AlarmDataTag.AlarmColor := 3;]]>
</Line>
<Line Number="47">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_RangeCheck" Class="Standard" Revision="0.1" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2010-03-29T16:58:02.278Z" CreatedBy="SEED\Yoakum" EditedDate="2010-04-22T18:34:44.438Z" EditedBy="SEED\Yoakum" SoftwareRevision="v17.00"
>
