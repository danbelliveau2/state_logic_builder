<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[First scan and always on/off bits]]>
</Comment>
<Text>
<![CDATA[XIC(s:fs)OTE(FirstScan);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CPU_TimeDate_wJulian(AOI_CPUTimeDate,CPUTimeDate);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[TON(TMR_PowerUpComplete,?,?)XIC(TMR_PowerUpComplete.DN)OTE(PowerUpComplete);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Air pressure ok status]]>
</Comment>
<Text>
<![CDATA[XIC(\Safety.SafeOKMain)TON(TMR_AirUpOK,?,?)XIC(TMR_AirUpOK.DN)XIC(IN_AIR_PRESS_OK)OTE(AirOK);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(OUT_SafetyResetPBL)OTE(OUT_SafetyResetLight);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(MODE_St_Ctrl.State[3])XIO(MODE_St_Ctrl.State[4])XIO(MODE_St_Ctrl.State[5])OTE(Door_OK_to_Unlock);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(FirstScan)MOVE(0,HMI_Status.Production.BatchSize);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****

STATE 0
EStop / Power Off
(Clear HMI Auto/Manual Mode Button)]]>
</Comment>
<Text>
<![CDATA[XIC(MODE_St_Ctrl.State[0])OTU(MODE_Cycle_Running)OTU(OUT_Cycle_Start_PBL)OTU(MODE_Auto)XIC(\Safety.SafeOKMain)[XIO(HMI_Data.Control.AutoMode) MOVE(1,MODE_St_Reg) ,XIC(HMI_Data.Control.AutoMode) MOVE(2,MODE_St_Reg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 1
Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(MODE_St_Ctrl.State[1])OTE(MODE_Manual)OTU(MODE_Cycle_Running)OTU(OUT_Cycle_Start_PBL)OTU(MODE_Auto)OTU(MODE_Auto)XIC(HMI_Data.Control.AutoMode)MOVE(2,MODE_St_Reg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 2
Auto Mode
-Clear Manual Mode Bits]]>
</Comment>
<Text>
<![CDATA[XIC(MODE_St_Ctrl.State[2])OTU(MODE_Cycle_Running)OTU(OUT_Cycle_Start_PBL)OTL(MODE_Auto)XIC(IN_Laser_PS_Active)[ONS(MODE_OneShot_Array_Seq[0]) OTE(MODE_Auto_Pulse) ,XIC(HMI_Data.Status.Alarms.NoFaults) XIC(Local:4:O.Pt01.Data) XIC(Local:4:O.Pt03.Data) TON(Timer_Gripper,?,?) XIC(Timer_Gripper.DN) OTE(HMI_Data.Status.Indicator[2]) XIC(HMI_Data.Control.Button[27]) MOVE(3,MODE_St_Reg) ,[XIO(HMI_Data.Control.AutoMode) ,XIC(_Always_OFF) TON(MODE_Tmr_Array_Seq[0],?,?) XIC(MODE_Tmr_Array_Seq[0].DN) OTU(HMI_Data.Control.AutoMode) ] MOVE(1,MODE_St_Reg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 3
Cycle Starting
-Stack Light Flashing Green]]>
</Comment>
<Text>
<![CDATA[XIC(MODE_St_Ctrl.State[3])OTE(MODE_Cycle_Starting)[TON(MODE_Tmr_Array_Seq[1],?,?) XIC(MODE_Tmr_Array_Seq[1].DN) MOVE(4,MODE_St_Reg) ,[XIO(HMI_Data.Control.AutoMode) ,XIO(HMI_Data.Status.Alarms.NoFaults) ,[XIO(IN_Cycle_Stop_PB_NC) ,EQ(HMI_Status.Production.BatchSize,0) ] ] MOVE(2,MODE_St_Reg) OTU(HMI_Data.Control.Button[27]) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 4
Cycle Running
Stack Light Solid Green]]>
</Comment>
<Text>
<![CDATA[XIC(MODE_St_Ctrl.State[4])OTL(MODE_Cycle_Running)OTL(OUT_Cycle_Start_PBL)[XIO(HMI_Data.Control.AutoMode) ,XIO(HMI_Data.Status.Alarms.NoFaults) ,XIO(IN_Cycle_Stop_PB_NC) ,EQ(HMI_Status.Production.BatchSize,0) ]MOVE(5,MODE_St_Reg)OTU(HMI_Data.Control.Button[27]);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 5
Cycle Stopping]]>
</Comment>
<Text>
<![CDATA[XIC(MODE_St_Ctrl.State[5])OTE(MODE_Cycle_Stopping)MOVE(2,MODE_St_Reg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[****IMMEDIATE TRANSITIONS****]]>
</Comment>
<Text>
<![CDATA[XIO(\Safety.SafeOKMain)MOVE(0,MODE_St_Reg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[This Instruction Controls The State Logic Engine. 
When a number is placed into the tag associated with "State_Reg", the subroutine will set that bit number of the tag associated with the "State_Bit_Array " boolean array.]]>
</Comment>
<Text>
<![CDATA[State_Engine_64(MODE_State_Logic_Inst,MODE_St_Reg,MODE_St_Ctrl);]]>
</Text>
</Rung>
