<LocalTags>
<LocalTag Name="NodeStatusMask" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="NodeStatus" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ProgramID" DataType="INT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Local Program ID]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="OneShot" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[ADD(PublicProgramIDTag,1,PublicProgramIDTag)MOVE(PublicProgramIDTag,ProgramID);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ANDing the NodeStatus with 61440 Strips the first four binary digits out of the status dint

Note: 24576 is 16#6000 in Hex. This means the module is Inhibited]]>
</Comment>
<Text>
<![CDATA[XIC(PowerUpCmpltTag)[EQ(DeviceNumTag,ProgramID) ONS(OneShot) GSV(Module,NodeName,EntryStatus,NodeStatus) ,[AND(NodeStatus,61440,NodeStatusMask) EQ(NodeStatusMask,16384) OTE(ComOK) ,AND(NodeStatus,61440,NodeStatusMask) EQ(NodeStatusMask,24576) OTE(Inhibited) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(PowerUpCmpltTag)[XIO(ComOK) XIO(Inhibited) ,XIC(FaultActiveTag) XIO(FaultResetTag) ]OTE(FaultActiveTag);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(PowerUpCmpltTag)XIC(UseWarning)XIO(FaultActiveTag)XIC(Inhibited)OTE(WarningActiveTag);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
