<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[**Input Status Data of the Module Output Point**

NOTE: This is also checked in the Safety Module Status AOI.

NOTE: The OutputPoint.Status is set when the point is selected to be used in the Module Configuration (Module Config --> Points tab)]]>
</Comment>
<Text>
<![CDATA[[XIC(OutputPointInput.Status) XIO(OutputPointInput.Fault) XIO(OutputPointInput.Uncertain) XIO(OutputPointInput.NoLoad) XIO(OutputPointInput.ShortCircuit) XIO(OutputPointInput.FieldPowerOff) OTE(OutputPointStatusOK) ,XIO(OutputPointStatusOK) OTE(OMF) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[**Input Point Status Of The Monitoring Input From The External Device **

NOTE: This is also checked in the Safety Module Status AOI.

NOTE: EDM InputPoint.Status bit is set when the point is selected to be used in the Module Configuration (Module Config --> Points tab)]]>
</Comment>
<Text>
<![CDATA[[XIC(EDMInputPoint.Status) XIO(EDMInputPoint.ShortCircuit) XIO(EDMInputPoint.Uncertain) XIO(EDMInputPoint.Fault) OTE(EDMInputPointStatusOK) ,XIC(EDMInputPointStatusOK) XIC(EDMInputPoint.Data) OTE(EDMInput) ,XIO(EDMInputPointStatusOK) OTE(IMF) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Valid reaction time is 5-1000 msec]]>
</Comment>
<Text>
<![CDATA[CROUT(OutputWithEDM,NEGATIVE,200,Actuate,EDMInputPoint.Data,EDMInputPoint.Data,EDMInputPointStatusOK,OutputPointStatusOK,FaultResetTag);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(EnableIn)XIC(OutputPointStatusOK)XIC(EDMInputPointStatusOK)XIC(OutputWithEDM.O1)OTE(OutputPoint.Data)OTE(OUT);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(IMF) ,XIC(OMF) ,XIC(OutputWithEDM.FP) ]OTE(FP);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
