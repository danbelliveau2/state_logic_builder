<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[This Subroutine Controls The State Logic Engine. 
When a number is placed into the "State Register" tag, the subroutine will set that bit number of the "State Logic Control Bits " Tag ]]>
</Comment>
<Text>
<![CDATA[COP(_Zero_Bit_Array,State_Bit_Array,1)OTE(State_Bit_Array.State[State_Reg]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="RLL">
<Description>
<![CDATA[Zero Register and Array]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(0,State_Reg);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
