<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Handles security for an HMI]]>
</Line>
<Line Number="1">
<![CDATA[//HMI_Data.Status.Security_Password[0] must be an empty string.]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[AutoLogoutTimer.PRE := Setup_AutoLogoutTimeInSec * 1000;]]>
</Line>
<Line Number="4">
<![CDATA[If (Level > 0) THEN]]>
</Line>
<Line Number="5">
<![CDATA[	AutoLogoutTimer.TimerEnable := 1;]]>
</Line>
<Line Number="6">
<![CDATA[ELSE]]>
</Line>
<Line Number="7">
<![CDATA[	AutoLogoutTimer.TimerEnable := 0;]]>
</Line>
<Line Number="8">
<![CDATA[END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[TONR(AutoLogoutTimer);]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[IF (AutoLogoutTimer.DN OR Logout) THEN]]>
</Line>
<Line Number="13">
<![CDATA[	//Logout. Clear the password.]]>
</Line>
<Line Number="14">
<![CDATA[	CONCAT(Password[0], Password[0], Login);]]>
</Line>
<Line Number="15">
<![CDATA[END_IF;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[If (0 = Login.LEN) THEN]]>
</Line>
<Line Number="18">
<![CDATA[	//No Password.]]>
</Line>
<Line Number="19">
<![CDATA[	Level := 0;]]>
</Line>
<Line Number="20">
<![CDATA[ELSE]]>
</Line>
<Line Number="21">
<![CDATA[	For SecurityLevelIter := 1 to 15 do]]>
</Line>
<Line Number="22">
<![CDATA[		//Loop through the stored passwords to determine what the security level is.]]>
</Line>
<Line Number="23">
<![CDATA[		IF (Login = Password[SecurityLevelIter]) THEN]]>
</Line>
<Line Number="24">
<![CDATA[			//Password matched. Exit.]]>
</Line>
<Line Number="25">
<![CDATA[			Level := SecurityLevelIter;]]>
</Line>
<Line Number="26">
<![CDATA[			IF \HMI.CurrentPopupNum = 80 THEN]]>
</Line>
<Line Number="27">
<![CDATA[				\HMI.ReplaceScreenNum :=9999;  //Close the Login popup display on the HMI]]>
</Line>
<Line Number="28">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="29">
<![CDATA[			EXIT;]]>
</Line>
<Line Number="30">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="31">
<![CDATA[	End_for;]]>
</Line>
<Line Number="32">
<![CDATA[	IF (16 = SecurityLevelIter) THEN]]>
</Line>
<Line Number="33">
<![CDATA[		//Password did not match any in the list]]>
</Line>
<Line Number="34">
<![CDATA[		Level := 0;]]>
</Line>
<Line Number="35">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="36">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
