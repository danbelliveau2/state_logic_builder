<Routines>
<Routine Name="EthernetCommStatus" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Monitor Ethernet IP device comms.

*********************************************************************************************************

From Rockwell Knowledgebase 47624 (created 12/19/2007 so info may no longer apply?):
"It is strongly suggested to avoid flooding the controller with status requests from GSV instructions. [This] code should be in a periodic task with a time base as long as your application can tolerate; ideally 1,000 ms or greater."
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(\Main.FlashVeryFast) ONS(OneShot.0) ,XIO(\Main.FlashVeryFast) ONS(OneShot.1) ]CPT(NodeSelect,(NodeSelect+1)MOD 15);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(0,ProgramID);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(AOI_EthernetNodeStat[0].ComOK) XIO(AOI_EthernetNodeStat[0].Inhibited) OTE(MainPLCActive) ,XIC(AlwaysOff) EIPCommStatus(AOI_EthernetNodeStat[1],Infeed_Puller,\Main.PowerUpComplete,\Main.FaultReset,1,Fault[1].Active,Warning[1].Active,NodeSelect,ProgramID) EIPCommStatus(AOI_EthernetNodeStat[2],Outfeed_Puller,\Main.PowerUpComplete,\Main.FaultReset,1,Fault[2].Active,Warning[2].Active,NodeSelect,ProgramID) EIPCommStatus(AOI_EthernetNodeStat[3],Reel_Drive,\Main.PowerUpComplete,\Main.FaultReset,1,Fault[3].Active,Warning[3].Active,NodeSelect,ProgramID) EIPCommStatus(AOI_EthernetNodeStat[4],AL1x2x_IOLink,\Main.PowerUpComplete,\Main.FaultReset,1,Fault[4].Active,Warning[4].Active,NodeSelect,ProgramID) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Tensioner Position Range = 49 - 805]]>
</Comment>
<Text>
<![CDATA[[LE(IN_Tensioner_Position,200) ,XIC(Latch_TensionerHigh) ]XIO(Fault[6].Active)OTE(Latch_TensionerHigh);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Fault if :
Tensioner bottoms out when wire runs out 
or if
Tensioner gets to high]]>
</Comment>
<Text>
<![CDATA[[[GE(IN_Tensioner_Position,800) ,XIC(Latch_TensionerHigh) ] XIC(Part_Ready) ,XIC(Fault[6].Active) XIO(\Main.FaultReset) ]OTE(Fault[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Reel_Drive:I.Faulted) ,XIC(Fault[8].Active) XIO(\Main.FaultReset) ]OTE(Fault[8].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_FaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_WarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[JSR(IOLink,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="IOLink" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[OGDxxx_8PORT_IOL(OGD551_Reel_Radius,AL1x2x_IOLink:I1.Data) ,XIC(OGD551_Reel_Radius.IOL_Mode) XIO(OGD551_Reel_Radius.Device_Not_Connected) [CPT(IN_Reel_Radius,OGD551_Reel_Radius.Distance*1) ,GT(IN_Reel_Radius,In_Reel_Radius_min) LT(IN_Reel_Radius_max,IN_Reel_Radius) OTE(Reel_Radius_Sensor_OK) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[OGDxxx_8PORT_IOL(OGD551_Tensioner_Position,AL1x2x_IOLink:I1.Data) ,XIC(OGD551_Tensioner_Position.IOL_Mode) [CPT(IN_Tensioner_Position,OGD551_Tensioner_Position.Distance - Tensioner_Offset) ,LIMIT(IN_Tensioner_Position_min,IN_Tensioner_Position,IN_Tensioner_Position_max) [OTE(Tensioner_Position_Sensor_OK) ,LIMIT(Tensioner_Position_HOME_min,IN_Tensioner_Position,Tensioner_Position_HOME_max) OTE(Tensioner_is_HOME) ,GE(IN_Tensioner_Position,Tensioner_Position_HOME) OTE(Tensioner_is_past_HOME) ] ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[RA_RB_RO_RU_RV_8PORT_IOL(RA3102_Encoder,AL1x2x_IOLink:I1.Data) ,XIC(RA3102_Encoder.IOL_Mode) XIO(RA3102_Encoder.Device_Not_Connected) MOVE(RA3102_Encoder.Counter,Standalone_Encoder_Count) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
