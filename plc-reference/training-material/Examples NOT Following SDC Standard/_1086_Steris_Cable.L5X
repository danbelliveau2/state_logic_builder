<Text>
<![CDATA[XIC(Active[6].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Active[7].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Active[8].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Active[9].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Active[10].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Active[11].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
