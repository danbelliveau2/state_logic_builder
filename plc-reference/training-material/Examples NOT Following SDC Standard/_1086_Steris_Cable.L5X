<Routine Name="Flashers" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Flash TImer]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[TON(FlashTimer,?,?)GT(FlashTimer.ACC,2000000000)SUB(FlashTimer.ACC,2000000000,FlashTimer.ACC);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 180<80)OTE(FlashVeryFast);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 400<300)OTE(FlashFast);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 1100<800)OTE(FlashSlow);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 3000<100)OTE(FlashVerySlow);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 250<125)OTE(Flash125_On);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 500<250)OTE(Flash250_On);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 1000<500)OTE(Flash500_On);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 2000<1000)OTE(Flash1000_On);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 5000<2500)OTE(Flash2500_On);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[CMP(FlashTimer.ACC MOD 10000<5000)OTE(Flash5000_On);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(MAIN_Slow_Flash_Off_Timer.DN)TON(MAIN_Slow_Flash_On_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(MAIN_Slow_Flash_On_Timer.DN)TON(MAIN_Slow_Flash_Off_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIO(MAIN_Fast_Flash_Off_Timer.DN)TON(MAIN_Fast_Flash_On_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(MAIN_Fast_Flash_On_Timer.DN)TON(MAIN_Fast_Flash_Off_Timer,?,?);]]>
</Text>
</Rung>
