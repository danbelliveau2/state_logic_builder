<Routines>
<Routine Name="ActiveCount" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(0,ActiveCountTEMP);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Active[0].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Active[1].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Active[2].Active)ADD(ActiveCountTEMP,1,ActiveCountTEMP);]]>
</Text>
</Rung>
