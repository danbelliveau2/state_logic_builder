<Routines>
<Routine Name="DATA" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(\Safety.SafeOKMain)OTE(MAIN_Safe_OK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Total Shots (Loads)]]>
</Comment>
<Text>
<![CDATA[XIC(Part_Ready)ONS(DATA_TotalShotsOS)XIC(MODE_Cycle_Running)[ADD(HMI_Data.Status.Production.TotalShots,1,HMI_Data.Status.Production.TotalShots) ,ADD(HMI_Data.Status.Production.GoodParts,1,HMI_Data.Status.Production.GoodParts) SUB(HMI_Status.Production.BatchSize,1,HMI_Status.Production.BatchSize) ,GT(HMI_Data.Status.Production.BatchSize,0) CPT(HMI_Data.Status.Production.PercentBatchComplete,(HMI_Data.Status.Production.BatchSize-HMI_Data.Status.Production.GoodParts)/HMI_Data.Status.Production.BatchSize*100) ,EQ(HMI_Data.Status.Production.BatchSize,0) MOVE(0,HMI_Data.Status.Production.PercentBatchComplete) ]OTE(DATA_Cycle_Pulse);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Shots Per Hour]]>
</Comment>
<Text>
<![CDATA[XIC(MODE_Cycle_Running)[XIC(DATA_Cycle_Pulse) DIV(DATA_Cycle_Tmr.ACC,60000,DATA_CycleTimeHrs) NE(DATA_CycleTimeHrs,0) DIV(3600000,DATA_Cycle_Tmr.ACC,HMI_Data.Status.Production.ShotsPerHour) CPT(Cycle_Time_in_s,DATA_Cycle_Tmr.ACC/1000) ,XIO(DATA_Cycle_Pulse) TON(DATA_Cycle_Tmr,?,?) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Reset Production Data]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Data.Control.ResetProductionData)TON(DATA_ResetProductionTmr,?,?)XIC(DATA_ResetProductionTmr.DN)ONS(DATA_ClearProductionOS)MOVE(0,HMI_Data.Status.Production.TotalShots)MOVE(0,HMI_Data.Status.Production.RejectParts)MOVE(0,HMI_Data.Status.Production.BatchSize)MOVE(0,HMI_Data.Status.Production.GoodParts)MOVE(100.0,HMI_Data.Status.Production.Efficiency)MOVE(0,HMI_Data.Status.Production.RuntimeHours)MOVE(0,HMI_Data.Status.Production.ShotsPerHour);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
