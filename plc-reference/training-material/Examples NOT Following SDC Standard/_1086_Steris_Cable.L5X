<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(8,ProgramID);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Pneumatic actuators faults]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_FaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,CPUTimeDate,FaultActive)ProgramAlarmHandler(AOI_WarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUTimeDate,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Tensioner" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****START OF STATE LOGIC****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(MAIN_Flt_Reset_Pulse) ,XIC(Status.State[2]) ]OTE(Reel_Drive:O.ClearFaults);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(IN_Tensioner_Position,HMI_Data.Status.Production.TensionerPos);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(IN_Reel_Radius,HMI_Data.Status.Production.ReelFill)CPT(HMI_Data.Status.Production.ReelFillPercent,100-4*(IN_Reel_Radius-56 ));]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CPT(ReelFill_Percent,(Reel_Dist_EMPTY - IN_Reel_Radius)/(Reel_Dist_EMPTY - Reel_Dist_FULL))CPT(WireCirc,((Reel_Radius_FULL - Reel_Radius_EMPTY)*ReelFill_Percent + Reel_Radius_EMPTY)*2*3.14159);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CPT(ReelRPM_Reqd,Infeed_Puller.AverageVelocity*60*GB_Ratio/WireCirc)CPT(ReelFreq_Reqd,ReelRPM_Reqd*4/120)GT(Infeed_Puller.AverageVelocity,5)OTE(InfeedPuller_Moving);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STATE 0
EStop / Power Off]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])[XIC(\Safety.SafeOKMain) MOVE(1,Control.StateReg) ,XIC(HMI_Control.Button[10]) MOVE(6,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STATE 1
Stop All Servo Drive Motion]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(Reel_Drive:I.Ready)XIO(Reel_Drive:I.Active)MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 2
Fault Reset Servo Drives]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(Reel_Drive:I.Ready)XIO(Reel_Drive:I.Active)MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 3
Check Sensors and set Zero Speed ]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])XIC(Reel_Drive:I.Ready)XIO(Reel_Drive:I.Active)XIC(Reel_Radius_Sensor_OK)XIC(Tensioner_Position_Sensor_OK)MOVE(0,Reel_Drive:O.FreqCommand)MOVE(5,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 5
Process]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[5])[OTE(Reel_Running) ,XIC(MODE_Auto) MOVE(ReelFreq_Default,Reel_Drive:O.FreqCommand) [[XIO(Tensioner_is_HOME) ,XIC(InfeedPuller_Moving) ] XIO(Tensioner_is_past_HOME) OTE(Reverse_Start_In_Auto) ,XIO(Reverse_Start_In_Auto) OTE(Stop_In_Auto) ] ,XIO(MODE_Auto) MOVE(7,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 6
Stop]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])XIC(Reel_Drive:I.Decelerating)MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 7
Manual Jog]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])[XIC(MODE_Auto) MOVE(1,Control.StateReg) ,XIO(MODE_Auto) [[XIC(HMI_Data.Control.Button[16]) MOVE(1000,Reel_Drive:O.FreqCommand) OTE(Forward_Jog_In_Man) ,XIC(HMI_Data.Control.Button[17]) MOVE(1000,Reel_Drive:O.FreqCommand) OTE(Reverse_Jog_In_Man) ] ,XIO(HMI_Data.Control.Button[16]) XIO(HMI_Data.Control.Button[17]) OTE(Stop_In_Jog) ,[XIC(HMI_Data.Control.Button[19]) ,XIO(Tensioner_is_HOME) XIO(Tensioner_is_past_HOME) ] MOVE(8,Control.StateReg) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 8
Manual ]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])MOVE(2500,Reel_Drive:O.FreqCommand)[XIO(Tensioner_is_HOME) XIO(Tensioner_is_past_HOME) OTE(Reverse_Start_In_Man) ,[XIC(Tensioner_is_HOME) ,XIC(Tensioner_is_past_HOME) ] [OTE(Stop_In_Man) ,LT(Reel_Drive:I.OutputFreq,1) MOVE(7,Control.StateReg) ] ,XIC(MODE_Auto) MOVE(5,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(\Safety.SafeOKMain)[[XIC(Reverse_Start_In_Auto) ,XIC(Reverse_Start_In_Man) ,XIC(Reverse_Jog_In_Man) ] OTE(Reel_Drive:O.Reverse) ,[XIC(Forward_Start_In_Man) ,XIC(Forward_Jog_In_Man) ] OTE(Reel_Drive:O.Forward) ]OTE(Reel_Drive:O.Start);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(Stop_In_Auto) ,XIC(Stop_In_Man) ,XIC(Stop_In_Jog) ]OTE(Reel_Drive:O.Stop);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[State_Engine_128Max_V4_3(AOI_StateEngine,Control,Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
