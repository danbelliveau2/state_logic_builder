<AddOnInstructionDefinition Name="CPU_TimeDate_wJulian_V2_0" Class="Standard" Revision="2.0" Vendor="SDC" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-05-01T14:06:05.139Z" CreatedBy="RA-INT\anabuto" EditedDate="2017-09-27T12:07:49.981Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v30.00">
<Description>
<![CDATA[Get CPU Time And Date. Calculates Day number from Jan 1 for Julian Day. Get UTC in microseconds.]]>
</Description>
<RevisionNote>
<![CDATA[Added UTC functionality]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="JulianDate" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[ordinal date]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="TimeDateTag" TagType="Base" DataType="CPU_TimeDate" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="Leap_Calc" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Month" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="LookUp" DataType="DINT" Dimensions="13" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,31,59,90,120,151,181,212,243,273,304,334]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Array DataType="DINT" Dimensions="13" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
<Element Index="[2]" Value="31"/>
<Element Index="[3]" Value="59"/>
<Element Index="[4]" Value="90"/>
<Element Index="[5]" Value="120"/>
<Element Index="[6]" Value="151"/>
<Element Index="[7]" Value="181"/>
<Element Index="[8]" Value="212"/>
<Element Index="[9]" Value="243"/>
<Element Index="[10]" Value="273"/>
<Element Index="[11]" Value="304"/>
<Element Index="[12]" Value="334"/>
</Array>
</DefaultData>
</LocalTag>
<LocalTag Name="TimeDateArray" DataType="DINT" Dimensions="7" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,0,0,0,0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Array DataType="DINT" Dimensions="7" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
<Element Index="[2]" Value="0"/>
<Element Index="[3]" Value="0"/>
<Element Index="[4]" Value="0"/>
<Element Index="[5]" Value="0"/>
<Element Index="[6]" Value="0"/>
</Array>
</DefaultData>
</LocalTag>
<LocalTag Name="UTC" DataType="LINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="LINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[GSV(WallClockTime,,LocalDateTime,TimeDateArray[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CLR(JulianDate)MOVE(TimeDateArray[1],Month);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LIMIT(1,Month,12)ADD(LookUp[Month],TimeDateArray[2],JulianDate);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GT(TimeDateArray[1],2)CMP(((TimeDateArray[0] MOD 4) = 0))[CMP(((TimeDateArray[0] MOD 100) > 0)) ,CMP(((TimeDateArray[0] MOD 400) = 0)) ]ADD(JulianDate,1,JulianDate);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOVE(TimeDateArray[0],TimeDateTag.Year)MOVE(TimeDateArray[1],TimeDateTag.Month)MOVE(TimeDateArray[2],TimeDateTag.Day)MOVE(TimeDateArray[3],TimeDateTag.Hour)MOVE(TimeDateArray[4],TimeDateTag.Minutes)MOVE(TimeDateArray[5],TimeDateTag.Seconds);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[GSV(TimeSynchronize,,CurrentTimeMicroseconds,UTC);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[COP(UTC,TimeDateTag.UTCmicroseconds,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Epson_Robot_V2_0" Class="Standard" Revision="2.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2018-07-09T12:46:46.278Z" CreatedBy="STEVENDOUGLAS\wehamby" EditedDate="2021-03-23T11:06:50.490Z" EditedBy="STEVENDOUGLAS\jperry"
 SoftwareRevision="v32.00">
<Description>
<![CDATA[Epson Robot I/O Mapping to Local Tags For Ease Of Communications.]]>
</Description>
<RevisionNote>
<![CDATA[Changed Data size to 64 bytes]]>
</RevisionNote>
