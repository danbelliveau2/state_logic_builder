</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Supervisor_SM.Status.State[5])EQ(HMI_Data.StationData.Station35.Status,1)MOVE(0,HMI_Data.StationData.Station35.Status);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A05Control_SM.Status.State[2]) [XIC(CycleStartLatch) ,XIC(HMI_Data.Status.MachineInSC) [EQ(HMI_Data.Control.DINT_SP[0],35) XIC(Supervisor_SM.Control.Bit[3]) ,XIC(HMI_Data.Control.Button[101]) XIC(HMI_Data.A05.TriggerCycle) ] ] XIC(A05_ProbesRet_PRX) XIO(A05_ProbesExt_PRX) XIC(A05_ZAxisRet_SOL) XIO(A05_ZAxisExt_SOL) ,XIC(A05Control_SM.Status.State[50]) ][EQ(A05Control_SM.Control.Timer[2].ACC,0) MOVE(4,A05Control_SM.Control.StateReg) ,NE(A05Control_SM.Control.Timer[2].ACC,0) MOVE(6,A05Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A05Control_SM.Status.State[4]) [XIO(StationStatus[35].S13Attempt) [XIC(StationStatus[35].S1Success) ,XIC(HMI_Data.StationData.Station35.ForceOn) ] ,XIC(HMI_Data.Status.MachineInSC) ] ,XIC(A05Control_SM.Status.State[48]) XIO(StationStatus[35].S13Success) XIO(A05Control_SM.Control.Counter[1].DN) ][MOVE(6,A05Control_SM.Control.StateReg) ,MOVE(5,StationStatus[35].AgingPosition) ,MOVE(0,StationStatus[35].FailureType) ,MOVE(1,HMI_Data.StationData.Station35.Status) ]OTL(StationStatus[35].S13Attempt);]]>
</Text>
