<Routines>
<Routine Name="A10Aging_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Aging Test Position 10 State Machine

**StationStatus[31] - StatusStation[40] being used for Aging stations 1-10 tracking]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(A10Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(A10Control_SM.Status.State[36]) XIC(A10Control_SM.Status.TransitionTimerDone) ,XIC(A10Control_SM.Status.State[63]) XIO(AlarmActive) ] ]MOVE(2,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Supervisor_SM.Status.State[5])EQ(HMI_Data.StationData.Station40.Status,1)MOVE(0,HMI_Data.StationData.Station40.Status);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A10Control_SM.Status.State[2]) [XIC(CycleStartLatch) ,XIC(HMI_Data.Status.MachineInSC) [EQ(HMI_Data.Control.DINT_SP[0],40) XIC(Supervisor_SM.Control.Bit[3]) ,XIC(HMI_Data.Control.Button[101]) XIC(HMI_Data.A10.TriggerCycle) ] ] XIC(A10_ProbesRet_PRX) XIO(A10_ProbesExt_PRX) XIC(A10_ZAxisRet_SOL) XIO(A10_ZAxisExt_SOL) ,XIC(A10Control_SM.Status.State[50]) ][EQ(A10Control_SM.Control.Timer[2].ACC,0) MOVE(4,A10Control_SM.Control.StateReg) ,NE(A10Control_SM.Control.Timer[2].ACC,0) MOVE(6,A10Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A10Control_SM.Status.State[4]) [XIO(StationStatus[40].S13Attempt) [XIC(StationStatus[40].S1Success) ,XIC(HMI_Data.StationData.Station40.ForceOn) ] ,XIC(HMI_Data.Status.MachineInSC) ] ,XIC(A10Control_SM.Status.State[48]) XIO(StationStatus[40].S13Success) XIO(A10Control_SM.Control.Counter[1].DN) ][MOVE(6,A10Control_SM.Control.StateReg) ,MOVE(10,StationStatus[40].AgingPosition) ,MOVE(0,StationStatus[40].FailureType) ,MOVE(1,HMI_Data.StationData.Station40.Status) ]OTL(StationStatus[40].S13Attempt);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[6])XIO(A10_14VHigh_IN)XIO(A10_14VLow_IN)XIO(A10_5V_IN)XIO(A10_ArcPresent_PE)[XIC(AOI_A10_PartPresent_PE.On) ,XIC(Bypass_AgingPartPresent) ]MOVE(8,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[8])XIC(A10Control_SM.Status.TransitionTimerDone)XIC(Supervisor_SM.Control.Bit[4])MOVE(10,A10Control_SM.Control.StateReg);]]>
</Text>
