<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[2])XIC(CycleStartLatch)[XIC(HMI_Data.StationData.Station40.Lockout) ,XIC(HMI_Data.Control.Button[145]) ,XIC(HMI_Data.StationData.Station16.Lockout) ]MOVE(61,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A10Control_SM.Status.State[4]) ,XIC(A10Control_SM.Status.State[61]) ][XIC(Indexer_SM.Status.State[62]) ,XIC(Indexer_SM.Status.State[63]) ]MOVE(62,A10Control_SM.Control.StateReg);]]>
</Text>
