<Routine Name="HeadEfficiency_SUB" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Calculate Head Efficiency]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[For a:=1 to 30 do]]>
</Line>
<Line Number="3">
<![CDATA[	]]>
</Line>
<Line Number="4">
<![CDATA[HMI_Data.HeadData[a].Station1.Efficiency:=(HMI_Data.HeadData[a].Station1.Successes/HMI_Data.HeadData[a].Station1.Attempts)*100;]]>
</Line>
<Line Number="5">
<![CDATA[HMI_Data.HeadData[a].Station3Resistor.Efficiency:=(HMI_Data.HeadData[a].Station3Resistor.Successes/HMI_Data.HeadData[a].Station3Resistor.Attempts)*100;]]>
</Line>
<Line Number="6">
<![CDATA[HMI_Data.HeadData[a].Station4.Efficiency:=(HMI_Data.HeadData[a].Station4.Successes/HMI_Data.HeadData[a].Station4.Attempts)*100;]]>
</Line>
<Line Number="7">
<![CDATA[HMI_Data.HeadData[a].Station6.Efficiency:=(HMI_Data.HeadData[a].Station6.Successes/HMI_Data.HeadData[a].Station6.Attempts)*100;]]>
</Line>
<Line Number="8">
<![CDATA[HMI_Data.HeadData[a].Station8.Efficiency:=(HMI_Data.HeadData[a].Station8.Successes/HMI_Data.HeadData[a].Station8.Attempts)*100;]]>
</Line>
<Line Number="9">
<![CDATA[HMI_Data.HeadData[a].Station10.Efficiency:=(HMI_Data.HeadData[a].Station10.Successes/HMI_Data.HeadData[a].Station10.Attempts)*100;]]>
</Line>
<Line Number="10">
<![CDATA[HMI_Data.HeadData[a].Station11.Efficiency:=(HMI_Data.HeadData[a].Station11.Successes/HMI_Data.HeadData[a].Station11.Attempts)*100;]]>
</Line>
<Line Number="11">
<![CDATA[HMI_Data.HeadData[a].Station16.Efficiency:=(HMI_Data.HeadData[a].Station16.Successes/HMI_Data.HeadData[a].Station16.Attempts)*100;]]>
</Line>
<Line Number="12">
<![CDATA[HMI_Data.HeadData[a].Station11Continuity.Efficiency:=(HMI_Data.HeadData[a].Station11Continuity.Successes/HMI_Data.HeadData[a].Station11Continuity.Attempts)*100;]]>
</Line>
<Line Number="13">
<![CDATA[HMI_Data.HeadData[a].Station18.Efficiency:=(HMI_Data.HeadData[a].Station18.Successes/HMI_Data.HeadData[a].Station18.Attempts)*100;]]>
</Line>
<Line Number="14">
<![CDATA[HMI_Data.HeadData[a].Station19.Efficiency:=(HMI_Data.HeadData[a].Station19.Successes/HMI_Data.HeadData[a].Station19.Attempts)*100;]]>
</Line>
<Line Number="15">
<![CDATA[HMI_Data.HeadData[a].Station20.Efficiency:=(HMI_Data.HeadData[a].Station20.Successes/HMI_Data.HeadData[a].Station20.Attempts)*100;]]>
</Line>
<Line Number="16">
<![CDATA[HMI_Data.HeadData[a].Station22.Efficiency:=(HMI_Data.HeadData[a].Station22.Successes/HMI_Data.HeadData[a].Station22.Attempts)*100;]]>
</Line>
<Line Number="17">
<![CDATA[HMI_Data.HeadData[a].Station23.Efficiency:=(HMI_Data.HeadData[a].Station23.Successes/HMI_Data.HeadData[a].Station23.Attempts)*100;]]>
</Line>
<Line Number="18">
<![CDATA[HMI_Data.HeadData[a].Station24.Efficiency:=(HMI_Data.HeadData[a].Station24.Successes/HMI_Data.HeadData[a].Station24.Attempts)*100;]]>
</Line>
<Line Number="19">
<![CDATA[HMI_Data.HeadData[a].Station27.Efficiency:=(HMI_Data.HeadData[a].Station27.Successes/HMI_Data.HeadData[a].Station27.Attempts)*100;]]>
</Line>
<Line Number="20">
<![CDATA[HMI_Data.HeadControl[a].Efficiency:=(HMI_Data.HeadControl[a].Successes/HMI_Data.HeadControl[a].Attempts)*100;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
