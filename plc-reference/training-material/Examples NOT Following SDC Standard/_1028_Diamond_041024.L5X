<Routines>
<Routine Name="A01Aging_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Aging Test Position 1 State Machine

**StationStatus[31] - StatusStation[40] being used for Aging stations 1-10 tracking]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(A01Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(A01Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,A01Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(A01Control_SM.Status.State[36]) XIC(A01Control_SM.Status.TransitionTimerDone) ,XIC(A01Control_SM.Status.State[63]) XIO(AlarmActive) ] ]MOVE(2,A01Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,A01Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Supervisor_SM.Status.State[5])EQ(HMI_Data.StationData.Station31.Status,1)MOVE(0,HMI_Data.StationData.Station31.Status);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
