<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[59])XIC(A10Control_SM.Status.TransitionTimerDone)[MOVE(63,A10Control_SM.Control.StateReg) ,EQ(StationStatus[40].FailureType,0) MOVE(140,StationStatus[40].FailureType) ,MOVE(3,HMI_Data.StationData.Station40.Status) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_A10Control_SM,A10Control_SM);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[If Safety Stop During Operation Then Load Fault Code]]>
</Comment>
<Text>
<![CDATA[[XIO(MainAssemblyOK) ,XIO(AgingOK) ]XIC(StationStatus[40].S13Attempt)XIO(StationStatus[40].S13Success)EQ(StationStatus[40].FailureType,0)EQ(A10Control_SM.Control.Timer[2].ACC,0)MOVE(140,StationStatus[40].FailureType);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Clear Tracking If Part Removed Manually From Machine]]>
</Comment>
<Text>
<![CDATA[XIO(MachineRunning)XIC(StationStatus[40].S13Attempt)XIC(AOI_A10_PartPresent_PE.Off)COP(EmptyTracking,StationStatus[40],1)MOVE(0,HMI_Data.StationData.Station40.Status)RES(A10Control_SM.Control.Timer[2]);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Sensor Timers]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)AOI_Debounce(AOI_A10_PartPresent_PE,A10_PartPresent_PE,50,50);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Test Running]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])LIMIT(8,A10Control_SM.Control.StateReg,36)OTE(A10Control_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Locked Out]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.StationData.Station40.Lockout) MOVE(4,HMI_Data.StationData.Station40.Status) ,XIO(HMI_Data.StationData.Station40.Lockout) EQ(HMI_Data.StationData.Station40.Status,4) MOVE(0,HMI_Data.StationData.Station40.Status) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Load Robot Interface]]>
