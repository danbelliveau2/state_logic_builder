<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[LIMIT(4,S24Control_SM.Control.StateReg,39) RTO(S24Control_SM.Control.Timer[20],?,?) ,XIC(S24Control_SM.Status.State[50]) DIV(S24Control_SM.Control.Timer[20].ACC,1000,HMI_Data.StationData.Station24.CycleTime) RES(S24Control_SM.Control.Timer[20]) ];]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Comment>
