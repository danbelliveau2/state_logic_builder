<Routines>
<Routine Name="A06Aging_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Aging Test Position 6 State Machine

**StationStatus[31] - StatusStation[40] being used for Aging stations 1-10 tracking]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(A06Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(A06Control_SM.Status.State[36]) XIC(A06Control_SM.Status.TransitionTimerDone) ,XIC(A06Control_SM.Status.State[63]) XIO(AlarmActive) ] ]MOVE(2,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Supervisor_SM.Status.State[5])EQ(HMI_Data.StationData.Station36.Status,1)MOVE(0,HMI_Data.StationData.Station36.Status);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A06Control_SM.Status.State[2]) [XIC(CycleStartLatch) ,XIC(HMI_Data.Status.MachineInSC) [EQ(HMI_Data.Control.DINT_SP[0],36) XIC(Supervisor_SM.Control.Bit[3]) ,XIC(HMI_Data.Control.Button[101]) XIC(HMI_Data.A06.TriggerCycle) ] ] XIC(A06_ProbesRet_PRX) XIO(A06_ProbesExt_PRX) XIC(A06_ZAxisRet_SOL) XIO(A06_ZAxisExt_SOL) ,XIC(A06Control_SM.Status.State[50]) ][EQ(A06Control_SM.Control.Timer[2].ACC,0) MOVE(4,A06Control_SM.Control.StateReg) ,NE(A06Control_SM.Control.Timer[2].ACC,0) MOVE(6,A06Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A06Control_SM.Status.State[4]) [XIO(StationStatus[36].S13Attempt) [XIC(StationStatus[36].S1Success) ,XIC(HMI_Data.StationData.Station36.ForceOn) ] ,XIC(HMI_Data.Status.MachineInSC) ] ,XIC(A06Control_SM.Status.State[48]) XIO(StationStatus[36].S13Success) XIO(A06Control_SM.Control.Counter[1].DN) ][MOVE(6,A06Control_SM.Control.StateReg) ,MOVE(6,StationStatus[36].AgingPosition) ,MOVE(0,StationStatus[36].FailureType) ,MOVE(1,HMI_Data.StationData.Station36.Status) ]OTL(StationStatus[36].S13Attempt);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A06Control_SM.Status.State[6])XIO(A06_14VHigh_IN)XIO(A06_14VLow_IN)XIO(A06_5V_IN)XIO(A06_ArcPresent_PE)[XIC(AOI_A06_PartPresent_PE.On) ,XIC(Bypass_AgingPartPresent) ]MOVE(8,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A06Control_SM.Status.State[8])XIC(A06Control_SM.Status.TransitionTimerDone)XIC(Supervisor_SM.Control.Bit[4])MOVE(10,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A06Control_SM.Status.State[10])XIC(A06_ProbesExt_PRX)XIO(A06_ProbesRet_PRX)XIC(Supervisor_SM.Control.Bit[4])MOVE(12,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A06Control_SM.Status.State[12])XIC(A06Control_SM.Status.TransitionTimerDone)MOVE(14,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A06Control_SM.Status.State[14])XIC(A06Control_SM.Status.TransitionTimerDone)MOVE(16,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A06Control_SM.Status.State[16])XIC(A06Control_SM.Status.TransitionTimerDone)[[XIO(A06_5V_IN) ,XIC(HMI_Data.StationData.Station36.BypassA) ] [XIO(A06_14VHigh_IN) ,XIC(HMI_Data.StationData.Station36.BypassB) ] MOVE(18,A06Control_SM.Control.StateReg) ,[XIO(HMI_Data.StationData.Station36.BypassA) XIC(A06_5V_IN) ,XIO(HMI_Data.StationData.Station36.BypassB) XIC(A06_14VHigh_IN) ] [MOVE(3,HMI_Data.StationData.Station36.Status) ,MOVE(141,StationStatus[36].FailureType) ] MOVE(30,A06Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A06Control_SM.Status.State[18])XIC(A06Control_SM.Status.TransitionTimerDone)MOVE(20,A06Control_SM.Control.StateReg);]]>
</Text>
</Rung>
