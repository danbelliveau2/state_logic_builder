<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Coil Lift To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S03Control_SM.Status.State[5]) XIC(S03Control_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Coil Lift To Retract]]>
</Comment>
<Text>
