</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A08Control_SM.Status.State[8]) MOVE(AgingTimerPresets[0],A08Control_SM.Control.TransitionTime) ,XIC(A08Control_SM.Status.State[12]) MOVE(AgingTimerPresets[2],A08Control_SM.Control.TransitionTime) ,XIC(A08Control_SM.Status.State[14]) MOVE(AgingTimerPresets[3],A08Control_SM.Control.TransitionTime) ,XIC(A08Control_SM.Status.State[16]) MOVE(AgingTimerPresets[4],A08Control_SM.Control.TransitionTime) ,XIC(A08Control_SM.Status.State[18]) MOVE(AgingTimerPresets[5],A08Control_SM.Control.TransitionTime) ,[XIC(A08Control_SM.Status.State[30]) ,XIC(A08Control_SM.Status.State[57]) ] MOVE(AgingTimerPresets[10],A08Control_SM.Control.TransitionTime) ,XIC(A08Control_SM.Status.State[35]) MOVE(AgingTimerPresets[12],A08Control_SM.Control.TransitionTime) ,[XIC(A08Control_SM.Status.State[32]) ,XIC(A08Control_SM.Status.State[58]) ,XIC(A08Control_SM.Status.State[59]) ] MOVE(AgingTimerPresets[11],A08Control_SM.Control.TransitionTime) ,XIC(A08Control_SM.Status.State[36]) MOVE(AgingTimerPresets[1],A08Control_SM.Control.TransitionTime) ]OTE(A08Control_SM.Control.EnaTransitionTimer);]]>
