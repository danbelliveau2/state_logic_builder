<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(r05Packout_IN.Error)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Robot Motors To Turn On]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r05Packout_SM.Status.State[56]) XIC(r05Packout_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Robot Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r05Packout_SM.Status.State[58]) XIC(r05Packout_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Robot Move To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r05Packout_SM.Status.State[8]) ,XIC(r05Packout_SM.Status.State[16]) ,XIC(r05Packout_SM.Status.State[20]) ,XIC(r05Packout_SM.Status.State[24]) ,XIC(r05Packout_SM.Status.State[30]) ] XIC(r05Packout_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Robot Move To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r05Packout_SM.Status.State[12]) ,XIC(r05Packout_SM.Status.State[18]) ,XIC(r05Packout_SM.Status.State[22]) ,XIC(r05Packout_SM.Status.State[26]) ,XIC(r05Packout_SM.Status.State[32]) ] XIC(r05Packout_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Loss Of Robot Run Signal]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)XIC(MachineRunning)XIO(r05Packout_IN.Error)XIO(r05Packout_IN.Running)OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Unable To Verify Robot Status]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r05Packout_SM.Status.State[45]) XIC(r05Packout_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="r05Packout_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Packout Robot Control State Machine]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)Epson_Robot_V2_0(AOI_r05Packout_Mapping,r05Packout:I,r05Packout:O,r05Packout_IN,r05Packout_OUT);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(S:FS)CLR(r05Packout_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(r05Packout_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,r05Packout_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOVE(2,r05Packout_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,r05Packout_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[9])XIO(StationStatus[27].r05Attempt)XIC(StationStatus[27].S13Attempt)OTE(r05Packout_SM.Control.Bit[1]);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r05Packout_SM.Status.State[60])[XIC(Indexer_SM.Status.State[9]) ,XIC(S27_RotAxisRet_PRX) XIO(S27_RotAxisExt_PRX) XIC(S27_ZAxisExt_PRX) XIO(S27_ZAxisRet_PRX) XIC(S27_GripperClose_SOL) ]XIO(StationStatus[27].r05Attempt)[XIO(HMI_Data.Control.Button[147]) XIC(StationStatus[27].S13Attempt) ,XIC(HMI_Data.Control.Button[147]) LIMIT(7,StationStatus[27].PreOpSelect,21) ,XIC(HMI_Data.StationData.Station27.ForceOn) ]MOVE(4,r05Packout_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r05Packout_SM.Status.State[4])XIC(MachineBasic.AlwaysOn)MOVE(6,r05Packout_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r05Packout_SM.Status.State[6])[XIO(S27Control_SM.Control.Bit[1]) [XIO(HMI_Data.Control.Button[147]) XIC(StationStatus[27].S13Attempt) XIO(StationStatus[27].S27Success) [XIC(S27Control_SM.Status.State[60]) XIO(StationStatus[27].S24Success) MOVE(StationStatus[27].FailureType,r05Packout_FailureTypeStored) ,XIC(S27Control_SM.Status.State[49]) XIC(StationStatus[27].S24Success) MOVE(133,r05Packout_FailureTypeStored) ] MOVE(2,r05Packout_OUT.UserWord[0]) ,XIC(HMI_Data.Control.Button[147]) [XIC(S27Control_SM.Status.State[49]) [EQ(StationStatus[27].PreOpSelect,16) ,EQ(StationStatus[27].PreOpSelect,17) ,EQ(StationStatus[27].PreOpSelect,20) ,EQ(StationStatus[27].PreOpSelect,21) ] ,XIC(S27Control_SM.Status.State[60]) [LIMIT(7,StationStatus[27].PreOpSelect,15) ,EQ(StationStatus[27].PreOpSelect,18) ,EQ(StationStatus[27].PreOpSelect,19) ] ] MOVE(StationStatus[27].PreOpSelect,r05Packout_FailureTypeStored) MOVE(2,r05Packout_OUT.UserWord[0]) ] ,[XIC(S27Control_SM.Status.State[20]) XIO(HMI_Data.Control.Button[147]) [XIC(StationStatus[27].S27Success) ,XIC(S27Control_SM.Control.Bit[1]) ] MOVE(1,r05Packout_OUT.UserWord[0]) ,XIC(MachineBasic.AlwaysOff) XIC(S27Control_SM.Status.State[49]) [XIO(HMI_Data.Control.Button[147]) MOVE(StationStatus[27].FailureType,r05Packout_FailureTypeStored) ,XIC(HMI_Data.Control.Button[147]) MOVE(StationStatus[27].PreOpSelect,r05Packout_FailureTypeStored) ] MOVE(2,r05Packout_OUT.UserWord[0]) ] ]MOVE(8,r05Packout_SM.Control.StateReg)OTL(StationStatus[27].r05Attempt);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r05Packout_SM.Status.State[8])XIO(r05Packout_IN.UserIn[0].5)XIC(r05Packout_IN.UserIn[0].0)[XIC(r05Packout_IN.InsideBox4) ,XIC(r05Packout_IN.InsideBox5) ]XIC(r05Packout_IN.UserIn[1].0)TON(r05Packout_SM.Control.Timer[2],?,?)XIC(r05Packout_SM.Control.Timer[2].DN)MOVE(10,r05Packout_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r05Packout_SM.Status.State[10])[EQ(r05Packout_OUT.UserWord[0],1) XIC(S27Control_SM.Status.State[24]) ,EQ(r05Packout_OUT.UserWord[0],2) [XIC(S27Control_SM.Status.State[60]) ,XIC(S27Control_SM.Status.State[62]) ] ]MOVE(12,r05Packout_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r05Packout_SM.Status.State[12])XIO(r05Packout_IN.UserIn[0].0)XIC(r05Packout_IN.InsideBox2)[[XIC(r05Packout_IN.InsideBox3) ,EQ(r05Packout_OUT.UserWord[0],2) XIO(r05Packout_SM.Control.Bit[0]) ] XIC(r05Packout_IN.UserIn[0].5) MOVE(14,r05Packout_SM.Control.StateReg) ,XIC(r05Packout_IN.UserIn[0].1) MOVE(18,r05Packout_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r05Packout_SM.Status.State[32])XIO(r05Packout_IN.UserIn[0].2)XIC(r05Packout_IN.UserIn[1].0)XIC(r05Packout_IN.InsideBox3)XIC(r05Packout_IN.UserIn[0].5)MOVE(14,r05Packout_SM.Control.StateReg);]]>
