<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Command Trigger]]>
</Comment>
<Text>
<![CDATA[XIC(Cmd_Reset)OTL(Reset_Run);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Determine Path For MSG - from IO_ModRef]]>
</Comment>
<Text>
<![CDATA[XIC(Reset_Run)ONS(ONS.0)[GSV(Module,IO_ModRef,Path,ModulePath[0]) ,BTD(ModulePath[0],0,MSG_Module_Reset.Path.LEN,0,8) COP(ModulePath[2],MSG_Module_Reset.Path.DATA[0],82) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[SSV Inhibit
MSG Reset - after module is inhibitted
SSV UnInhibit Module - after MSG Reset
MSG Error Out
]]>
</Comment>
<Text>
<![CDATA[XIC(Reset_Run)[ONS(ONS.1) MOVE(4,CardInhibit) SSV(Module,IO_ModRef,Mode,CardInhibit) ,XIC(Mod_Inhibitted) [ONS(ONS.2) MSG(MSG_Module_Reset) ,XIO(MSG_Module_Reset.EN) XIC(MSG_Module_Reset.DN) MOVE(0,CardUnInhibit) SSV(Module,IO_ModRef,Mode,CardUnInhibit) ] ,XIC(MSG_Module_Reset.ER) OTE(MSG_Err) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[GSV Entry Status - send output bits]]>
</Comment>
<Text>
<![CDATA[XIC(Reset_Run)[GSV(Module,IO_ModRef,EntryStatus,Module_EntryStatus) ,EQ(Module_EntryStatus,16#0000_1000) OTE(Mod_Flt) ,EQ(Module_EntryStatus,16#0000_3000) OTE(Mod_Con) ,EQ(Module_EntryStatus,16#0000_4000) OTE(Mod_Run) ,EQ(Module_EntryStatus,16#0000_6000) OTE(Mod_Inhibitted) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Unlatch if Running, time enough to visually see Mod_Run on AOI output]]>
</Comment>
<Text>
<![CDATA[XIC(Reset_Run)XIC(Mod_Run)[TON(ModRun_TMR,?,?) ,XIC(ModRun_TMR.DN) OTU(Reset_Run) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
