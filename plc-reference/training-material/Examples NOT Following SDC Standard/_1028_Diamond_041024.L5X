<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A09Control_SM.Status.State[50])[EQ(StationStatus[39].FailureType,140) ADD(HMI_Data.StationData.Station39.FCCounts[0],1,HMI_Data.StationData.Station39.FCCounts[0]) ,EQ(StationStatus[39].FailureType,141) ADD(HMI_Data.StationData.Station39.FCCounts[1],1,HMI_Data.StationData.Station39.FCCounts[1]) ,EQ(StationStatus[39].FailureType,142) ADD(HMI_Data.StationData.Station39.FCCounts[2],1,HMI_Data.StationData.Station39.FCCounts[2]) ,EQ(StationStatus[39].FailureType,143) ADD(HMI_Data.StationData.Station39.FCCounts[3],1,HMI_Data.StationData.Station39.FCCounts[3]) ,EQ(StationStatus[39].FailureType,144) ADD(HMI_Data.StationData.Station39.FCCounts[4],1,HMI_Data.StationData.Station39.FCCounts[4]) ];]]>
