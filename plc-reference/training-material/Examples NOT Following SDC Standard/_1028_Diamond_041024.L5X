<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Servo Drive Fault]]>
</Comment>
<Text>
<![CDATA[NE(a01Indexer.AxisFault,0)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Index Move To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[4]) TON(Indexer_SM.Control.Timer[20],?,?) XIC(Indexer_SM.Control.Timer[20].DN) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Actuators NOT In Safe Position For Index Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[20]) XIO(Indexer_SM.Control.Bit[2]) TON(Indexer_SM.Control.Timer[21],?,?) XIC(Indexer_SM.Control.Timer[21].DN) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Actuators NOT In Safe Position During Index]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(Indexer_SM.Status.State[4]) ,XIC(Indexer_SM.Status.State[6]) ]XIC(Indexer_SM.Control.Timer[2].DN)OTL(Indexer_SM.Control.Bit[7]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Control.Bit[7]) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(Alarm[3].Active) ,XIO(MachineRunning) ]OTU(Indexer_SM.Control.Bit[7]);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For Index Move To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[6]) TON(Indexer_SM.Control.Timer[22],?,?) XIC(Indexer_SM.Control.Timer[22].DN) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_s01Indexer_EIP.ComOK)XIO(a01Indexer.AxisHomedStatus)OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Shot Pin Servo Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(a04ShotPin.Input.Fault)XIC(MainAssemblyOK)OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Shot Pin Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_s04ShotPin_EIP.ComOK)XIO(a04ShotPin.Input.HomedStatus)OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Waiting For Shot Pin Servo To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[30]) [XIO(a04ShotPin_MAM.Sts_PC) ,XIO(AOI_a04ShotPinRet_RC.In_Range) ] TON(Indexer_SM.Control.Timer[23],?,?) XIC(Indexer_SM.Control.Timer[23].DN) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Waiting For Shot Pin Servo To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[32]) [XIO(a04ShotPin_MAM.Sts_PC) ,XIO(AOI_a04ShotPinExt_RC.In_Range) ] TON(Indexer_SM.Control.Timer[24],?,?) XIC(Indexer_SM.Control.Timer[24].DN) ,XIC(Alarm[9].Active) XIO(FaultReset_PB) ]OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Waiting For Indexer Lock 1 To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[30]) XIO(IndexerLockRet_PRX) TON(Indexer_SM.Control.Timer[25],?,?) XIC(Indexer_SM.Control.Timer[25].DN) ,XIC(Alarm[10].Active) XIO(FaultReset_PB) ]OTE(Alarm[10].Active);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Station 30 Boot Present When Index Needed]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[28]) XIO(S30_BootEmpty_PE) TON(Indexer_SM.Control.Timer[30],?,?) XIC(Indexer_SM.Control.Timer[30].DN) ,XIC(Alarm[11].Active) XIO(FaultReset_PB) ]OTE(Alarm[11].Active);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Waiting For Indexer Lock 1 To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[32]) XIO(Indexer_SM.Control.Timer[10].DN) TON(Indexer_SM.Control.Timer[27],?,?) XIC(Indexer_SM.Control.Timer[27].DN) ,XIC(Alarm[12].Active) XIO(FaultReset_PB) ]OTE(Alarm[12].Active);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Station 30 Coil Present When Index Needed]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[28]) XIO(S30_CoilEmpty_PE) TON(Indexer_SM.Control.Timer[31],?,?) XIC(Indexer_SM.Control.Timer[31].DN) ,XIC(Alarm[13].Active) XIO(FaultReset_PB) ]OTE(Alarm[13].Active);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Station 2 Top Of Coil Blocked When Index Needed]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(Indexer_SM.Status.State[28]) XIO(S02_CoilClear_PE) TON(Indexer_SM.Control.Timer[29],?,?) XIC(Indexer_SM.Control.Timer[29].DN) ,XIC(Alarm[14].Active) XIO(FaultReset_PB) ]OTE(Alarm[14].Active);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Indexer_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Indexer Control State Machine

State 0: Not Running
State 1: First Scan
State 2: Automatic Mode
State 3: Manual Mode
State 4: Index One Position
State 8: Index Complete
State 9: Wait All Stations Complete
State 20: Check All Actuators In Safe Position
State 62: Cycle Stop
State 63: Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Indexer_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(Indexer_SM.Status.State[8]) ,XIC(AlarmActive) ] ]MOVE(2,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[20])XIC(Indexer_SM.Control.Bit[2])MOVE(4,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[4])XIO(Indexer_MAM.PC)XIO(Indexer_SM.Control.Bit[0])MOVE(6,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[32])XIC(Indexer_SM.Control.Timer[10].DN)[XIC(a04ShotPin.Input.AtReference) XIC(a04ShotPin.Input.Stopped) ,XIC(MachineBasic.AlwaysOn) ]XIC(AOI_a04ShotPinExt_RC.In_Range)MOVE(8,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[8])XIO(HMI_Data.Status.MachineInSC)MOVE(9,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[6])XIC(Indexer_SM.Control.Bit[7])XIC(Indexer_MAS.PC)[XIC(Indexer_SM.Control.Bit[0]) MOVE(10,Indexer_SM.Control.StateReg) ,XIO(Indexer_SM.Control.Bit[0]) MOVE(11,Indexer_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[10])MOVE(11,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[30])XIC(IndexerLockRet_PRX)[XIC(a04ShotPin.Input.AtReference) XIC(a04ShotPin.Input.Stopped) ,XIC(MachineBasic.AlwaysOn) ]XIC(AOI_a04ShotPinRet_RC.In_Range)XIC(Supervisor_SM.Control.Bit[4])MOVE(20,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[[XIC(Indexer_SM.Status.State[2]) ,XIC(Indexer_SM.Status.State[9]) XIC(Indexer_SM.Control.Bit[1]) ] XIC(CycleStartLatch) ,XIC(Indexer_SM.Status.State[2]) EQ(HMI_Data.Control.DINT_SP[0],50) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) XIC(Indexer_SM.Control.Timer[10].DN) XIC(a04ShotPin.Input.AtReference) XIC(a04ShotPin.Input.Stopped) XIC(AOI_a04ShotPinExt_RC.In_Range) ]MOVE(28,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[28])[XIC(S02_CoilClear_PE) XIC(S30_BootEmpty_PE) XIC(S30_CoilEmpty_PE) ,XIO(Indexer_SM.Control.Bit[0]) ]MOVE(30,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[6])XIO(Indexer_SM.Control.Bit[7])XIC(Indexer_MAM.PC)XIC(Indexer_SM.Control.Bit[0])XIC(Supervisor_SM.Control.Bit[4])MOVE(32,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[9])XIO(CycleStartLatch)TON(Indexer_SM.Control.Timer[4],?,?)XIC(Indexer_SM.Control.Timer[4].DN)MOVE(62,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(MachineRunning)XIC(AlarmActive)MOVE(63,Indexer_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_Indexer_SM,Indexer_SM);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.a01Indexer.Status.MotionEnable)XIC(a01Indexer.AxisHomedStatus)XIC(HMI_Data.a04ShotPin.Status.MotionEnable)XIC(a04ShotPin.Input.HomedStatus)OTE(Indexer_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Sensor Monitor]]>
</Comment>
<Text>
<![CDATA[XIO(IndexerLockRet_PRX)TON(Indexer_SM.Control.Timer[10],?,?);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Shift All Tracking Data]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(Indexer_SM.Status.State[8]) ,XIC(Indexer_SM.Status.State[10]) ]JSR(StationStatus_SUB,0)OTU(S16PlaceAttempt);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Clear Main Indexer Part Tracking Data]]>
</Comment>
<Text>
<![CDATA[XIO(MachineRunning)XIO(CycleStop_PB)TON(Indexer_SM.Control.Timer[1],?,?)XIC(Indexer_SM.Control.Timer[1].DN)ONS(Indexer_SM.Control.OS[3])JSR(StatusClear_SUB,0)OTU(S16PlaceAttempt);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Check If All Stations Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(Indexer_SM.Status.State[9])TON(Indexer_SM.Control.Timer[0],?,?)XIC(Indexer_SM.Control.Timer[0].DN)XIC(S01Control_SM.Status.OKToIndex)XIC(S02Control_SM.Status.OKToIndex)XIC(S03Control_SM.Status.OKToIndex)XIC(S04Control_SM.Status.OKToIndex)XIC(r04BootLoad_SM.Status.OKToIndex)XIC(S06Control_SM.Status.OKToIndex)XIC(S08Inside_SM.Status.OKToIndex)XIC(S08Outside_SM.Status.OKToIndex)XIC(S09Control_SM.Status.OKToIndex)XIC(S10Control_SM.Status.OKToIndex)XIC(S11Control_SM.Status.OKToIndex)XIC(S18Control_SM.Status.OKToIndex)XIC(S19Control_SM.Status.OKToIndex)XIC(S20Control_SM.Status.OKToIndex)XIC(S22Control_SM.Status.OKToIndex)XIC(S23Control_SM.Status.OKToIndex)XIC(S24Control_SM.Status.OKToIndex)XIC(S27Control_SM.Status.OKToIndex)XIC(r01AgingLoad_SM.Status.OKToIndex)XIC(r02AgingUnload_SM.Status.OKToIndex)XIC(r05Packout_SM.Status.OKToIndex)ONS(Indexer_SM.Control.OS[0])OTE(Indexer_SM.Control.Bit[1]);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Move All Actuators To Home Position (Safe For Index)]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[3]) ,XIC(Supervisor_SM.Status.State[5]) ,XIC(Supervisor_SM.Status.State[6]) ]XIC(HMI_Data.Control.Button[185])TON(Indexer_SM.Control.Timer[12],?,?);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Boot/Spring Robot OK To Index]]>
</Comment>
<Text>
<![CDATA[XIC(r04BootLoad_IN.Running)XIC(r04BootLoad_IN.AutoMode)XIC(r04BootLoad_IN.InsideBox1)XIO(r04BootLoad_IN.InsideBox7)OTE(Indexer_SM.Control.Bit[8]);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Aging Load Robot OK To Index]]>
</Comment>
<Text>
<![CDATA[XIC(r01AgingLoad_IN.Running)XIC(r01AgingLoad_IN.AutoMode)XIC(r01AgingLoad_IN.InsideBox1)XIO(r01AgingLoad_IN.InsideBox4)XIO(r01AgingLoad_IN.UserIn[0].3)OTE(Indexer_SM.Control.Bit[9]);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Aging Unload Robot OK To Index]]>
</Comment>
<Text>
<![CDATA[XIC(r02AgingUnload_IN.Running)XIC(r02AgingUnload_IN.AutoMode)XIC(r02AgingUnload_IN.InsideBox1)XIO(r02AgingUnload_IN.InsideBox4)XIO(r02AgingUnload_IN.UserIn[0].3)OTE(Indexer_SM.Control.Bit[10]);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Packout Robot OK To Index]]>
</Comment>
<Text>
<![CDATA[XIC(r05Packout_IN.Running)XIC(r05Packout_IN.AutoMode)XIC(r05Packout_IN.InsideBox1)XIO(r05Packout_IN.InsideBox4)[EQ(r05Packout_OUT.UserWord[0],2) XIO(r05Packout_IN.UserIn[0].0) ,EQ(r05Packout_OUT.UserWord[0],1) ]OTE(Indexer_SM.Control.Bit[11]);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Check If Actuators In Safe Position For Index

**Need to populate all probe values at startup]]>
</Comment>
<Text>
<![CDATA[XIC(IndexerLockRet_PRX)XIC(a04ShotPin.Input.HomedStatus)XIC(AOI_a04ShotPinRet_RC.In_Range)XIC(Indexer_SM.Control.Bit[8])XIC(Indexer_SM.Control.Bit[9])XIC(Indexer_SM.Control.Bit[10])XIC(Indexer_SM.Control.Bit[11])XIC(S01_XAxisRet_PRX)XIO(S01_XAxisExt_PRX)XIC(AOI_a03S02ZAxis_RC1.In_Range)XIC(S03_ResistorCheckZRet_PRX)XIO(S03_ResistorCheckZExt_PRX)GE(S03_ResistorCheck_IN,S03_ResistorCheck_Safe)XIC(S03_CoilLiftRet_PRX)XIC(S03_HoldDownRet_PRX)XIC(S03_MPCBushingIDRet_PRX)XIO(S03_MPCBushingIDExt_PRX)XIC(S03_FoxBushingIDRet_PRX)XIO(S03_FoxBushingIDExt_PRX)XIC(S03_MPCSurfaceCheckRet_SOL)XIC(S03_FoxSurfaceCheckRet_SOL)GE(S03_MPCSurfaceCheck_IN,S03_SurfaceCheck_Safe)GE(S03_FoxSurfaceCheck_IN,S03_SurfaceCheck_Safe)XIO(S03_ResinCheckExt_SOL)LE(S03_ResinCheck_IN,S03_ResinCheck_Safe)XIC(S04_BootHolderOpen_PRX)XIC(S06_BootHolderOpen_PRX)XIC(S06_PressRet_PRX)XIO(S06_PressExt_PRX)XIC(S08_InsideXRet_PRX)XIO(S08_InsideXExt_PRX)XIC(S08_OutsideXRet_PRX)XIO(S08_OutsideXExt_PRX)XIC(S08_OutsideRotRet_PRX)XIO(S08_OutsideRotExt_PRX)XIC(S10_GripperOpen_PRX)XIC(AOI_S10AMStepperHome_RC.In_Range)XIC(S11_BootHolderOpen_PRX)XIO(S11_HeightCheckExt_SOL)GE(S11_BootHeight_IN,S11_BootHeight_Safe)XIC(S11_XAxisRet_PRX)XIC(S11_ZAxisRet_PRX)XIC(S18_XAxisRet_PRX)XIC(S18_ZAxisRet_PRX)XIC(S19_XAxisRet_PRX)XIO(S19_XAxisExt_PRX)XIC(S20_XAxisRet_PRX)XIO(S20_XAxisExt_PRX)XIC(S20_ZAxisRet_PRX)XIC(S20_BootHolderOpen_PRX)XIC(S24_ZAxisRet_PRX)XIO(S24_ZAxisExt_PRX)XIC(S24_BootHolderOpen_PRX)XIC(S24_XAxisRet_PRX)XIO(S24_XAxisExt_PRX)XIC(S27_RotAxisRet_PRX)XIO(S27_RotAxisExt_PRX)[XIC(MachineRunning) XIC(S27_ZAxisRet_PRX) XIO(S27_ZAxisExt_PRX) ,XIO(MachineRunning) ]XIC(S29_HeadAlignmentRet_PRX)OTE(Indexer_SM.Control.Bit[2]);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Determine If Indexer In Position & Next Head To Move To
.02 was .001
.997 was .999]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[AOI_TruncateReal(AOI_IndexerPosition,a01Indexer.ActualPosition) ,XIO(a01Indexer.MoveStatus) XIO(a01Indexer.JogStatus) [GE(AOI_IndexerPosition.Fraction,0.999) ADD(AOI_IndexerPosition.Whole,1.0,HeadAtStation1) ,LIMIT(0.0,AOI_IndexerPosition.Fraction,0.999) MOVE(AOI_IndexerPosition.Whole,HeadAtStation1) ] ,XIO(a01Indexer.MoveStatus) XIO(a01Indexer.JogStatus) [GE(AOI_IndexerPosition.Fraction,0.999) ,LE(AOI_IndexerPosition.Fraction,0.001) ] [XIC(a01Indexer.AxisHomedStatus) ,XIC(Indexer_SM.Control.Bit[31]) ] OTE(Indexer_SM.Control.Bit[0]) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Cleanout Mode Control]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)SUB(HMI_Data.Control.BatchSetpoint,20,BatchCleanout);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(MachineRunning)[XIC(HMI_Data.Control.Button[102]) ,EQ(HMI_Data.Status.BatchCount,BatchCleanout) ,XIC(Supervisor_SM.Control.Bit[5]) ]OTE(Supervisor_SM.Control.Bit[5]);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Control.Bit[5])[XIC(Indexer_SM.Status.State[8]) ,XIC(Supervisor_SM.Control.Bit[6]) ]OTL(Supervisor_SM.Control.Bit[6]);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(MachineRunning)XIC(Supervisor_SM.Control.Bit[6])XIO(StationStatus[1].S1Attempt)XIO(StationStatus[2].S1Attempt)XIO(StationStatus[3].S1Attempt)XIO(StationStatus[4].S1Attempt)XIO(StationStatus[5].S1Attempt)XIO(StationStatus[6].S1Attempt)XIO(StationStatus[7].S1Attempt)XIO(StationStatus[8].S1Attempt)XIO(StationStatus[9].S1Attempt)XIO(StationStatus[10].S1Attempt)XIO(StationStatus[11].S1Attempt)XIO(StationStatus[12].S1Attempt)XIO(StationStatus[13].S1Attempt)XIO(StationStatus[14].S1Attempt)XIO(StationStatus[15].S1Attempt)XIO(StationStatus[16].S1Attempt)XIO(StationStatus[17].S1Attempt)XIO(StationStatus[18].S1Attempt)XIO(StationStatus[19].S1Attempt)XIO(StationStatus[20].S1Attempt)XIO(StationStatus[21].S1Attempt)XIO(StationStatus[22].S1Attempt)XIO(StationStatus[23].S1Attempt)XIO(StationStatus[24].S1Attempt)XIO(StationStatus[25].S1Attempt)XIO(StationStatus[26].S1Attempt)XIO(StationStatus[27].S1Attempt)XIO(StationStatus[28].S1Attempt)XIO(StationStatus[29].S1Attempt)XIO(StationStatus[30].S1Attempt)XIO(StationStatus[31].S1Attempt)XIO(StationStatus[32].S1Attempt)XIO(StationStatus[33].S1Attempt)XIO(StationStatus[34].S1Attempt)XIO(StationStatus[35].S1Attempt)XIO(StationStatus[36].S1Attempt)XIO(StationStatus[37].S1Attempt)XIO(StationStatus[38].S1Attempt)XIO(StationStatus[39].S1Attempt)XIO(StationStatus[40].S1Attempt)TON(Indexer_SM.Control.Timer[5],?,?)XIC(Indexer_SM.Control.Timer[5].DN)ONS(Supervisor_SM.Control.OS[2])OTL(Supervisor_SM.Control.Bit[7]);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIO(MachineRunning)[[XIC(Supervisor_SM.Control.Bit[6]) TON(Indexer_SM.Control.Timer[6],?,?) XIC(Indexer_SM.Control.Timer[6].DN) ,XIC(Supervisor_SM.Control.Bit[7]) ] OTU(Supervisor_SM.Control.Bit[6]) ,OTU(Supervisor_SM.Control.Bit[7]) ];]]>
