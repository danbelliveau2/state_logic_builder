<AddOnInstructionDefinition Name="GetFTPFilename" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2021-04-26T20:17:42.883Z" CreatedBy="EE-VM-001\Local Administrator" EditedDate="2021-04-27T13:17:59.097Z" EditedBy="EE-VM-001\Local Administrator" SoftwareRevision="v32.02"
>
<Description>
<![CDATA[Get the FTP filename from the FTP path sent to the PLC by a Cognex camera via an array of REAL.]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="REAL_Array" TagType="Base" DataType="REAL" Dimensions="1" Usage="InOut" Radix="Float" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[REAL array tag]]>
</Description>
</Parameter>
<Parameter Name="FilePathArrayStartIndex" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[2]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="2"/>
</DefaultData>
</Parameter>
<Parameter Name="FileName" TagType="Base" DataType="STRING30" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="posJPG" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="posSeparator" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ascJPG_lc" DataType="STRING3" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[3,'jpg']]]>
</DefaultData>
<DefaultData Format="String" Length="3">
<![CDATA['jpg']]>
</DefaultData>
</LocalTag>
<LocalTag Name="ascJPG_UC" DataType="STRING3" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[3,'JPG']]]>
</DefaultData>
<DefaultData Format="String" Length="3">
<![CDATA['JPG']]>
</DefaultData>
</LocalTag>
<LocalTag Name="ascSeparator" DataType="STRING3" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[1,'/$00$00']]]>
</DefaultData>
<DefaultData Format="String" Length="1">
<![CDATA['/']]>
</DefaultData>
</LocalTag>
<LocalTag Name="FilePath" DataType="STRING" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,'$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00']]]>
</DefaultData>
<DefaultData Format="String" Length="0">
<![CDATA['']]>
</DefaultData>
</LocalTag>
<LocalTag Name="ArrayByteSize" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ArraySize" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[MOVE(0,FileName.LEN) MOVE(0,posSeparator) MOVE(0,posJPG) ,SIZE(REAL_Array,0,ArraySize) [MUL(ArraySize,4,ArrayByteSize) ,CMP(ArrayByteSize - (FilePathArrayStartIndex * 4) > 82) CPT(ArrayByteSize,82 + (FilePathArrayStartIndex * 4)) ] ,CPT(FilePath.LEN,ArrayByteSize - (FilePathArrayStartIndex * 4)) COP(REAL_Array[FilePathArrayStartIndex],FilePath.DATA[0],FilePath.LEN) ,[FIND(FilePath,ascSeparator,10,posSeparator) ,[GT(posSeparator,1) [FIND(FilePath,ascJPG_lc,posSeparator,posJPG) ,EQ(posJPG,0) FIND(FilePath,ascJPG_UC,posSeparator,posJPG) ] ,GT(posJPG,posSeparator) CPT(FileName.LEN,posJPG - posSeparator + 2) COP(FilePath.DATA[posSeparator],FileName.DATA[0],FileName.LEN) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="ProgramAlarmHandler" Class="Standard" Revision="2.0" Vendor="Steven Douglas Corp." ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-08-23T18:02:02.410Z" CreatedBy="STEVENDOUGLAS\dshaner" EditedDate="2020-01-03T20:30:35.687Z" EditedBy="STEVENDOUGLAS\wehamby"
 SoftwareRevision="v32.01">
<Description>
<![CDATA[Creates a shared Alarm History array and a shared Active Alarms array.]]>
</Description>
<RevisionNote>
<![CDATA[v1.0 : 2017-08-24 D.E.S.
v1.1:2017-09-12 W.E.H.
v1.2 : 2018-06-03 W.E.H.- Changed NoFault to Faulted
v2.0 : 2019-12-12 D.E.S. variable array lengths!]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This AOI works in conjuction with the Alarms Porgram. This AOI then uses that tag to uniquely identify each instance of the AOI in your project. ControllerProgramIDTag needs to be the exact same tag for all instances of this AOI in your project.

LocalAlarmsArrayTag is where you define each alarm for this AOI. Type in your Message and set the Severity when you create a new alarm. Severity is used on the HMI for coloring. If you set DoNotSaveToHistory it will prevent the alarm from being put in the Alarm History array.
Use output coils or latches on the Active bit to trigger the alarm.

HMIActiveArrayTag and HMIHistoryArrayTag are arrays of the AlarmData UDT. They are shared by all instances of this AOI.

Alarm History is updated when an alarm becomes inactive so the Duration can be saved.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
