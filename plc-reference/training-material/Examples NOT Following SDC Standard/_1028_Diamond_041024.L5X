<Line Number="26">
<![CDATA[	HMI_Data.HeadData[x].Station20.Attempts:=0;]]>
</Line>
<Line Number="27">
<![CDATA[	HMI_Data.HeadData[x].Station20.Successes:=0;]]>
</Line>
<Line Number="28">
<![CDATA[	HMI_Data.HeadData[x].Station22.Attempts:=0;]]>
</Line>
<Line Number="29">
<![CDATA[	HMI_Data.HeadData[x].Station22.Successes:=0;]]>
