<Routine Name="S03Control_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station 3 Control

**Populate All Probe Comparison Instructions In State Machine At Start Up]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(S03Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(S03Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,S03Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(S03Control_SM.Status.State[22]) XIC(S03_CoilLiftRet_PRX) ,XIC(AlarmActive) ] ]MOVE(2,S03Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
