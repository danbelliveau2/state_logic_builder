<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S20Control_SM.Status.State[5]) EQ(MachinePartType,MachinePartTypeList[1]) XIC(S20Control_SM.Status.TimeoutFlt) ,XIC(Alarm[13].Active) XIO(FaultReset_PB) ]OTE(Alarm[13].Active);]]>
