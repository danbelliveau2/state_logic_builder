<![CDATA[XIC(MachineBasic.AlwaysOff)[XIC(Supervisor_SM.Status.State[5]) XIC(r05VisionReject_SM.Status.State[60]) XIC(AOI_r05_VisionRejectHL_PE.Off) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
