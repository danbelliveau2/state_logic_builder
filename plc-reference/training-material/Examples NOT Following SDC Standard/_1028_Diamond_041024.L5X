<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S19Control_SM.Status.State[8]) [XIO(S19_XAxisRet_PRX) ,XIC(S19_XAxisExt_PRX) ] XIC(S19Control_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
