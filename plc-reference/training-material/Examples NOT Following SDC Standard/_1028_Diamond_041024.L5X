<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r02AgingUnload_SM.Status.State[8])[EQ(StationStatus[16].FailureType,140) ADD(HMI_Data.StationData.Station16.FCCounts[0],1,HMI_Data.StationData.Station16.FCCounts[0]) ,EQ(StationStatus[16].FailureType,141) ADD(HMI_Data.StationData.Station16.FCCounts[1],1,HMI_Data.StationData.Station16.FCCounts[1]) ,EQ(StationStatus[16].FailureType,142) ADD(HMI_Data.StationData.Station16.FCCounts[2],1,HMI_Data.StationData.Station16.FCCounts[2]) ,EQ(StationStatus[16].FailureType,143) ADD(HMI_Data.StationData.Station16.FCCounts[3],1,HMI_Data.StationData.Station16.FCCounts[3]) ,EQ(StationStatus[16].FailureType,144) ADD(HMI_Data.StationData.Station16.FCCounts[4],1,HMI_Data.StationData.Station16.FCCounts[4]) ];]]>
