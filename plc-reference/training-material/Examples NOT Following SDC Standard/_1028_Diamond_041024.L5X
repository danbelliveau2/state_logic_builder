<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S09Control_SM.Status.State[2]) XIC(CycleStartLatch) ,XIC(S09Control_SM.Status.State[50]) ]MOVE(60,S09Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S09Control_SM.Status.State[2])XIC(CycleStartLatch)[XIC(HMI_Data.StationData.Station10.Lockout) ,XIC(HMI_Data.Control.Button[146]) ,XIC(HMI_Data.Control.Button[147]) ,EQ(MachinePartTypeList[0],MachinePartType) ]MOVE(61,S09Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S09Control_SM.Status.State[60]) ,XIC(S09Control_SM.Status.State[61]) ][XIC(Indexer_SM.Status.State[62]) ,XIC(Indexer_SM.Status.State[63]) ]MOVE(62,S09Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(MachineRunning)XIC(AlarmActive)[MOVE(63,S09Control_SM.Control.StateReg) ,EQ(StationStatus[9].FailureType,0) MOVE(110,StationStatus[9].FailureType) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_S09Control_SM,S09Control_SM);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(c07S10Camera_IN.Status.Online)OTE(S09Control_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[If Safety Stop During Operation Then Load Fault Code]]>
</Comment>
<Text>
<![CDATA[XIO(MainAssemblyOK)XIC(StationStatus[9].S9Attempt)XIO(StationStatus[9].S9Success)EQ(StationStatus[9].FailureType,0)MOVE(110,StationStatus[9].FailureType);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
