<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r05Packout_SM.Status.State[14]) EQ(r05Packout_OUT.UserWord[0],1) ,XIC(r05Packout_SM.Status.State[45]) XIC(r05BoxShift_SM.Control.Bit[0]) ]MOVE(15,r05Packout_SM.Control.StateReg);]]>
