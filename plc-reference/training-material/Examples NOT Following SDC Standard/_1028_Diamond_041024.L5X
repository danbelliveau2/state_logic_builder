<DefaultData Format="L5K">
<![CDATA[32767]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Binary" Value="2#0111_1111_1111_1111"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Map The Input Bits.
Robot Controller Outputs To PLC Inputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].0)OTE(RobotInputsTag.Ready);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].1)OTE(RobotInputsTag.Running);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].2)OTE(RobotInputsTag.Paused);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].3)OTE(RobotInputsTag.Error);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].4)OTE(RobotInputsTag.EStopOn);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].5)OTE(RobotInputsTag.SafeguardOn);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].6)OTE(RobotInputsTag.SafeError);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].7)OTE(RobotInputsTag.Warning);]]>
