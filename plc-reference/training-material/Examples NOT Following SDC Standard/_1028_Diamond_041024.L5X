<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Part Present Sensor NOT On When Mark Needed]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S22Control_SM.Status.State[4]) [XIO(AOI_S22_PartPresent1_PE.On) ,XIO(AOI_S22_PartPresent2_PE.On) ] ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Shutter NOT Open When Mark Needed]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S22Control_SM.Status.State[4]) [XIO(AOI_S22_ShutterClosed1_IN.Off) ,XIO(AOI_S22_ShutterClosed2_IN.Off) ] ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Serial Number NOT Correct When Index Needed]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S22Control_SM.Status.State[4]) NE(StationStatus[22].S20SerialNumber.LEN,5) XIO(S22Control_SM.Control.Bit[1]) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Telesis Message Acknowledge]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S22Control_SM.Status.State[8]) ,XIC(S22Control_SM.Status.State[12]) ,XIC(S22Control_SM.Status.State[16]) ,XIC(S22Control_SM.Status.State[41]) ,XIC(S22Control_SM.Status.State[44]) ,XIC(S22Control_SM.Status.State[47]) ] XIC(S22Control_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Laser Trigger Acknowledge]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S22Control_SM.Status.State[18]) XIC(S22Control_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Laser Sequence Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S22Control_SM.Status.State[20]) XIC(S22Control_SM.Status.TimeoutFlt) ,XIC(Alarm[5].Active) XIO(FaultReset_PB) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Data Retry Send Failure]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S22Control_SM.Status.State[42]) ,XIC(S22Control_SM.Status.State[45]) ,XIC(S22Control_SM.Status.State[48]) ] XIC(S22Control_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Alarm[6].Active)OTU(S22Control_SM.Control.Bit[3]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting Laser Controller Fault To Clear During Startup Sequence]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S22Control_SM.Status.State[53]) XIC(S22Control_SM.Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting Laser Controller Emission To Turn On]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S22Control_SM.Status.State[55]) XIO(r01AgingLoad_IN.UserIn[0].10) XIC(S22Control_SM.Status.TimeoutFlt) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Waiting Laser Controller Ready To Turn On]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S22Control_SM.Status.State[55]) XIO(r01AgingLoad_IN.UserIn[0].12) XIC(S22Control_SM.Status.TimeoutFlt) ,XIC(Alarm[9].Active) XIO(FaultReset_PB) ]OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="S22Control_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Message ID executes the message commands. The laser loooks for this word to change for the command to be processed.

NOTE: the message type and the data for that type needs to be filled in prior to changing the ID (executing) ]]>
</Comment>
<Text>
<![CDATA[XIC(S22Control_SM.Control.Bit[0])[OTU(S22Control_SM.Control.Bit[0]) ,CPT(S22TelesisLaser_OUT.Data[3],(S22TelesisLaser_OUT.Data[3] + 1) MOD 10) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Station 22 Control]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(S22Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(S22Control_SM.Status.State[20]) XIC(S22TelesisLaser_IN.Data[8].1) ,XIC(AlarmActive) ] ]MOVE(2,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[60])[XIC(Indexer_SM.Status.State[9]) XIO(StationStatus[22].S22Attempt) [XIC(StationStatus[22].S20Success) ,XIC(HMI_Data.StationData.Station22.ForceOn) ] ,XIC(HMI_Data.Status.MachineInSC) ]MOVE(4,S22Control_SM.Control.StateReg)OTL(StationStatus[22].S22Attempt);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(HMI_Data.StationData.Station20.Lockout)OTE(S22Control_SM.Control.Bit[1]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[4])XIC(AOI_S22_PartPresent1_PE.On)XIC(AOI_S22_PartPresent2_PE.On)XIC(AOI_S22_ShutterClosed1_IN.Off)XIC(AOI_S22_ShutterClosed2_IN.Off)[EQ(StationStatus[22].S20SerialNumber.LEN,5) ,XIC(S22Control_SM.Control.Bit[1]) ]MOVE(6,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STATE 6
Line 1 - Part Number
Setup MessageType "V" - Send Variable Data To Pattern File
-Toggle MessageID (Execute Message).]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[6])[XIC(MachineBasic.AlwaysOff) [XIO(S22TelesisLaser_IN.Data[8].0) ,XIC(S22TelesisLaser_IN.Data[8].0) OTL(S22Control_SM.Control.Bit[2]) ] ,XIC(MachineBasic.AlwaysOn) ]MOVE(8,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATE 8
Line 1 - Part Number
Check For Message Response ID To Match  and Message Response ACK/NAK]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[8])EQ(S22TelesisLaser_OUT.Data[3],S22TelesisLaser_IN.Data[10])EQ(S22TelesisLaser_IN.Data[12],asc.ACK)[XIO(S22Control_SM.Control.Bit[2]) XIO(S22Control_SM.Control.Bit[3]) MOVE(10,S22Control_SM.Control.StateReg) ,[XIC(S22Control_SM.Control.Bit[2]) ,XIC(S22Control_SM.Control.Bit[3]) ] TON(S22Control_SM.Control.Timer[0],?,?) XIC(S22Control_SM.Control.Timer[0].DN) OTU(S22Control_SM.Control.Bit[2]) MOVE(40,S22Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATE 10
Line 2 - Data Matrix
Setup MessageType "V" - Send Variable Data To Pattern File
-Toggle MessageID (Execute Message).]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[10])[XIC(MachineBasic.AlwaysOff) [XIO(S22TelesisLaser_IN.Data[8].0) ,XIC(S22TelesisLaser_IN.Data[8].0) OTL(S22Control_SM.Control.Bit[2]) ] ,XIC(MachineBasic.AlwaysOn) ]MOVE(12,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATE 12
Line 2 - Data Matrix
Check For Message Response ID To Match  and Message Response ACK/NAK]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[12])EQ(S22TelesisLaser_OUT.Data[3],S22TelesisLaser_IN.Data[10])EQ(S22TelesisLaser_IN.Data[12],asc.ACK)[XIO(S22Control_SM.Control.Bit[2]) XIO(S22Control_SM.Control.Bit[3]) MOVE(14,S22Control_SM.Control.StateReg) ,[XIC(S22Control_SM.Control.Bit[2]) ,XIC(S22Control_SM.Control.Bit[3]) ] TON(S22Control_SM.Control.Timer[1],?,?) XIC(S22Control_SM.Control.Timer[1].DN) OTU(S22Control_SM.Control.Bit[2]) MOVE(43,S22Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATE 14
Line 3 - Date Code
Setup MessageType "V" - Send Variable Data To Pattern File
-Toggle MessageID (Execute Message).]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[14])[XIC(MachineBasic.AlwaysOff) [XIO(S22TelesisLaser_IN.Data[8].0) ,XIC(S22TelesisLaser_IN.Data[8].0) OTL(S22Control_SM.Control.Bit[2]) ] ,XIC(MachineBasic.AlwaysOn) ]MOVE(16,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATE 16
Line 3 - Date Code
Check For Message Response ID To Match  and Message Response ACK/NAK]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[16])EQ(S22TelesisLaser_OUT.Data[3],S22TelesisLaser_IN.Data[10])EQ(S22TelesisLaser_IN.Data[12],asc.ACK)[XIO(S22Control_SM.Control.Bit[2]) XIO(S22Control_SM.Control.Bit[3]) MOVE(18,S22Control_SM.Control.StateReg) ,[XIC(S22Control_SM.Control.Bit[2]) ,XIC(S22Control_SM.Control.Bit[3]) ] TON(S22Control_SM.Control.Timer[2],?,?) XIC(S22Control_SM.Control.Timer[2].DN) OTU(S22Control_SM.Control.Bit[2]) MOVE(46,S22Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[18])XIO(S22TelesisLaser_IN.Data[8].1)MOVE(20,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATE 40
Line 1 - Part Number
Setup MessageType "V?" - Request Variable Data From Pattern File
-Change MessageID (Execute Message)
]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[40])MOVE(41,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATE 41
Line 1 - Part Number
Check For Message Response ID To Match  and Message Response ACK/NAK]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[41])EQ(S22TelesisLaser_OUT.Data[3],S22TelesisLaser_IN.Data[10])EQ(S22TelesisLaser_IN.Data[12],asc.ACK)MOVE(42,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STATE 42
Line 1 - Part Number
Compare Requested Data With Sent Data. They should match before triggering the mark.]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[42])COP(S22TelesisLaser_IN.Data[13],ackMessageResponse,30)MOVE(15,ackMessageResponse.LEN)[EQ(ackMessageResponse,ascPartNumber) MOVE(18,S22Control_SM.Control.StateReg) ,NE(ackMessageResponse,ascPartNumber) XIO(S22Control_SM.Control.Bit[3]) OTL(S22Control_SM.Control.Bit[3]) MOVE(6,S22Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[STATE 43
Line 2 - Data Matrix
Setup MessageType "V?" - Request Variable Data From Pattern File
-Change MessageID (Execute Message)
]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[43])MOVE(44,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[STATE 44
Line 2 - Data Matrix
Check For Message Response ID To Match  and Message Response ACK/NAK]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[44])EQ(S22TelesisLaser_OUT.Data[3],S22TelesisLaser_IN.Data[10])EQ(S22TelesisLaser_IN.Data[12],asc.ACK)MOVE(45,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[STATE 45
Line 2 - Data Matrix
Compare Requested Data With Sent Data. They should match before triggering the mark.]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[45])COP(S22TelesisLaser_IN.Data[13],ackMessageResponse,30)MOVE(26,ackMessageResponse.LEN)[EQ(ackMessageResponse,ascFormattedCode) MOVE(18,S22Control_SM.Control.StateReg) ,NE(ackMessageResponse,ascFormattedCode) XIO(S22Control_SM.Control.Bit[3]) OTL(S22Control_SM.Control.Bit[3]) MOVE(10,S22Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[STATE 46
Line 3 - Date Code
Setup MessageType "V?" - Request Variable Data From Pattern File
-Change MessageID (Execute Message)
]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[46])MOVE(47,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[STATE 47
Line 3 - Date Code
Check For Message Response ID To Match  and Message Response ACK/NAK]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[47])EQ(S22TelesisLaser_OUT.Data[3],S22TelesisLaser_IN.Data[10])EQ(S22TelesisLaser_IN.Data[12],asc.ACK)MOVE(48,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[STATE 48
Line 3 - Date Code
Compare Requested Data With Sent Data. They should match before triggering the mark.]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[48])COP(S22TelesisLaser_IN.Data[13],ackMessageResponse,30)MOVE(11,ackMessageResponse.LEN)[EQ(ackMessageResponse,ascFormattedCode) MOVE(18,S22Control_SM.Control.StateReg) ,NE(ackMessageResponse,ascFormattedCode) XIO(S22Control_SM.Control.Bit[3]) OTL(S22Control_SM.Control.Bit[3]) MOVE(14,S22Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[20])XIC(S22TelesisLaser_IN.Data[8].1)XIO(HMI_Data.Status.MachineInSC)MOVE(50,S22Control_SM.Control.StateReg)OTL(StationStatus[22].S22Success);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[State 52 - Laser stop = OFF, laser key switch = OFF, laser start = OFF, laser shutter = OFF]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[2])XIC(CycleStartLatch)XIC(MachineBasic.AlwaysOff)[XIO(r01AgingLoad_IN.UserIn[0].10) ,XIO(r01AgingLoad_IN.UserIn[0].12) ,XIC(r01AgingLoad_IN.UserIn[0].11) ]MOVE(52,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[State 53 - Laser stop = ON, laser key switch = OFF, laser start = OFF, laser shutter = OFF]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[52])XIC(S22Control_SM.Status.TransitionTimerDone)MOVE(53,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[State 54 - Laser stop = ON, laser key switch = ON, laser start = OFF, laser shutter = OFF]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[53])XIO(r01AgingLoad_IN.UserIn[0].11)XIC(S22Control_SM.Status.TransitionTimerDone)MOVE(54,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[State 55 - Laser stop = ON, laser key switch = ON, laser start = ON, laser shutter = OFF]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[54])XIC(S22Control_SM.Status.TransitionTimerDone)MOVE(55,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[State 56 - Laser stop = ON, laser key switch = ON, laser start = ON, laser shutter = ON]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S22Control_SM.Status.State[55])XIC(r01AgingLoad_IN.UserIn[0].10)XIC(r01AgingLoad_IN.UserIn[0].12)XIC(S22Control_SM.Status.TransitionTimerDone)MOVE(56,S22Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[[[XIC(S22Control_SM.Status.State[2]) XIC(CycleStartLatch) ,XIC(S22Control_SM.Status.State[56]) ] [XIC(r01AgingLoad_IN.UserIn[0].10) XIC(r01AgingLoad_IN.UserIn[0].12) XIO(r01AgingLoad_IN.UserIn[0].11) ,XIC(MachineBasic.AlwaysOn) ] ,XIC(S22Control_SM.Status.State[2]) EQ(HMI_Data.Control.DINT_SP[0],22) XIC(HMI_Data.Status.MachineInSC) XIC(Supervisor_SM.Control.Bit[3]) ] ,XIC(S22Control_SM.Status.State[50]) ]MOVE(60,S22Control_SM.Control.StateReg);]]>
