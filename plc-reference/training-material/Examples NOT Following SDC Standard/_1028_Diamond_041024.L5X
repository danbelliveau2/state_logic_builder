<Routines>
<Routine Name="A07Aging_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Aging Test Position 7 State Machine

**StationStatus[31] - StatusStation[40] being used for Aging stations 1-10 tracking]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(A07Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(A07Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,A07Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(A07Control_SM.Status.State[36]) XIC(A07Control_SM.Status.TransitionTimerDone) ,XIC(A07Control_SM.Status.State[63]) XIO(AlarmActive) ] ]MOVE(2,A07Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,A07Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Supervisor_SM.Status.State[5])EQ(HMI_Data.StationData.Station37.Status,1)MOVE(0,HMI_Data.StationData.Station37.Status);]]>
</Text>
</Rung>
