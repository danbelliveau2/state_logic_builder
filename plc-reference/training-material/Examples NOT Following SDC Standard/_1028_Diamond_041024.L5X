<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Ready Signal To Turn On]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03RFID_SM.Status.State[4]) XIC(r03RFID_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Command Execution To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03RFID_SM.Status.State[8]) XIC(r03RFID_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Command Execution To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03RFID_SM.Status.State[10]) XIC(r03RFID_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Pass/Fail Response]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03RFID_SM.Status.State[12]) XIC(r03RFID_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Handshake Signals To Turn Off]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r03RFID_SM.Status.State[16]) ,XIC(r03RFID_SM.Status.State[24]) ] XIC(r03RFID_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Consecutive Read Failures]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03RFID_SM.Status.State[24]) XIC(r03RFID_SM.Control.Counter[0].DN) ,XIC(Alarm[5].Active) XIO(FaultReset_PB) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Alarm[5].Active)RES(r03RFID_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="r03RFID_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Coil Load RFID Control State Machine]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(r03RFID_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOVE(2,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03RFID_SM.Status.State[60]) XIO(r03RFID_SM.Control.Bit[0]) XIC(r03BoxShift_SM.Status.State[60]) ,XIC(r03RFID_SM.Status.State[26]) XIC(r03RFID_SM.Status.TransitionTimerDone) ]MOVE(4,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[4])XIC(OmronRFID_IN.Data[0].0)MOVE(6,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[6])XIC(r03RFID_SM.Status.TransitionTimerDone)MOVE(8,r03RFID_SM.Control.StateReg)MOVE(OmronRFID_IN.Data[5],r03RFID_CountPrevious);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[8])XIO(OmronRFID_IN.Data[0].0)XIC(OmronRFID_IN.Data[0].1)MOVE(10,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[10])NE(OmronRFID_IN.Data[5],r03RFID_CountPrevious)XIO(OmronRFID_IN.Data[0].1)MOVE(12,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[12])[XIC(OmronRFID_IN.Data[0].2) MOVE(14,r03RFID_SM.Control.StateReg) RES(r03RFID_SM.Control.Counter[0]) ,XIC(OmronRFID_IN.Data[0].3) MOVE(24,r03RFID_SM.Control.StateReg) CTU(r03RFID_SM.Control.Counter[0],?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[14])MOVE(16,r03RFID_SM.Control.StateReg)OTL(r03RFID_SM.Control.Bit[0]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[24])XIO(OmronRFID_IN.Data[0].3)XIO(r03RFID_SM.Control.Counter[0].DN)MOVE(26,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03RFID_SM.Status.State[2]) XIC(CycleStartLatch) ,XIC(r03RFID_SM.Status.State[16]) XIO(OmronRFID_IN.Data[0].2) ]MOVE(60,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[2])XIC(CycleStartLatch)[XIC(HMI_Data.StationData.Station1.Lockout) ,XIC(HMI_Data.Control.Button[170]) ,XIC(MachineBasic.AlwaysOn) ]MOVE(61,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03RFID_SM.Status.State[60]) ,XIC(r03RFID_SM.Status.State[61]) ][XIC(r03BoxShift_SM.Status.State[62]) ,XIC(r03BoxShift_SM.Status.State[63]) ]MOVE(62,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(MachineRunning)XIC(AlarmActive)MOVE(63,r03RFID_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_r03RFID_SM,r03RFID_SM);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Set Data Block]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[6])[MOVE(3,OmronRFID_OUT.Data[1]) ,MOVE(16#3000,OmronRFID_OUT.Data[2]) ,MOVE(14,OmronRFID_OUT.Data[3]) ,MOVE(0,OmronRFID_OUT.Data[4]) ,MOVE(0,OmronRFID_OUT.Data[5]) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Execute Command]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03RFID_SM.Status.State[8]) ,XIC(r03RFID_SM.Status.State[10]) ,XIC(r03RFID_SM.Status.State[12]) ,XIC(r03RFID_SM.Status.State[14]) ]OTE(OmronRFID_OUT.Data[0].0);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Results]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03RFID_SM.Status.State[14])COP(OmronRFID_IN.Data[6],S01_PottingPallet_RFID.DATA[0],28)MOVE(28,S01_PottingPallet_RFID.LEN);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Stop Execution]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03RFID_SM.Status.State[16]) ,XIC(r03RFID_SM.Status.State[24]) ]MOVE(OmronRFID_IN.Data[5],OmronRFID_OUT.Data[5]);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03RFID_SM.Status.State[6]) MOVE(50,r03RFID_SM.Control.TransitionTime) ,XIC(r03RFID_SM.Status.State[26]) MOVE(100,r03RFID_SM.Control.TransitionTime) ]OTE(r03RFID_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])LIMIT(4,r03RFID_SM.Control.StateReg,40)MOVE(3000,r03RFID_SM.Control.FaultTime)OTE(r03RFID_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
