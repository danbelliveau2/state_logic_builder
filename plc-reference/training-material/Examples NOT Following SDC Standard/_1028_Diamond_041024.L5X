<Routine Name="A04Aging_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Aging Test Position 4 State Machine

**StationStatus[31] - StatusStation[40] being used for Aging stations 1-10 tracking]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(A04Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(A04Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,A04Control_SM.Control.StateReg);]]>
