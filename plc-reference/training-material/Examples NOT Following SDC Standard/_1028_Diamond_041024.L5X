<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S23Control_SM.Status.State[50]) ,[XIC(S23Control_SM.Status.State[60]) XIO(HMI_Data.StationData.Station23.ForceOn) XIO(StationStatus[23].S23Attempt) [XIO(HMI_Data.Control.Button[147]) XIO(StationStatus[23].S22Success) ,XIC(HMI_Data.Control.Button[147]) [LT(StationStatus[23].PreOpSelect,13) ,GT(StationStatus[23].PreOpSelect,18) ,EQ(StationStatus[23].PreOpSelect,16) ,EQ(StationStatus[23].PreOpSelect,17) ] ] ,XIC(S23Control_SM.Status.State[61]) ] XIC(Indexer_SM.Status.State[8]) ,XIC(S23Control_SM.Status.OKToIndex) ]XIO(Indexer_SM.Control.Bit[1])OTE(S23Control_SM.Status.OKToIndex);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
