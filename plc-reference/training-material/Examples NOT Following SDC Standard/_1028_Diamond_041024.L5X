</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S09Control_SM.Status.State[4])MOVE(150,S09Control_SM.Control.TransitionTime)OTE(S09Control_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])LIMIT(4,S09Control_SM.Control.StateReg,42)MOVE(3000,S09Control_SM.Control.FaultTime)OTE(S09Control_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
