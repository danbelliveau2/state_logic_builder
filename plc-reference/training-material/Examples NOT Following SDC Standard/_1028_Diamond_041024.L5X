</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S02StepFeeder_SM.Status.State[4])XIC(S02_CylinderExt_PRX)XIO(S02_CylinderRet_PRX)MOVE(6,S02StepFeeder_SM.Control.StateReg);]]>
