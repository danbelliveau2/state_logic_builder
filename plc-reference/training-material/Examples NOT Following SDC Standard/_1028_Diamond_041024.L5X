<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[OTE(DataStructure.AlwaysOn) ,XIO(DataStructure.AlwaysOn) OTE(DataStructure.AlwaysOff) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(DataStructure.AlwaysOn)[MOVE(2000,PowerUp_TMR.PRE) TON(PowerUp_TMR,?,?) XIC(PowerUp_TMR.DN) OTE(DataStructure.PowerUpCP) ,MOVE(60000,MotionUp_TMR.PRE) TON(MotionUp_TMR,?,?) XIC(MotionUp_TMR.DN) OTE(DataStructure.MotionUpCP) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(RunStatus) MOVE(3600000,HourTimer.PRE) RTO(HourTimer,?,?) ,XIC(HourTimer.DN) ADD(HourRuntime,1,HourRuntime) RES(HourTimer) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Flasher Control]]>
</Comment>
<Text>
<![CDATA[[XIO(FlasherB_250ms.DN) MOVE(250,FlasherA_250ms.PRE) TON(FlasherA_250ms,?,?) ,XIC(FlasherA_250ms.DN) MOVE(250,FlasherB_250ms.PRE) TON(FlasherB_250ms,?,?) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIO(FlasherB_500ms.DN) MOVE(500,FlasherA_500ms.PRE) TON(FlasherA_500ms,?,?) ,XIC(FlasherA_500ms.DN) MOVE(500,FlasherB_500ms.PRE) TON(FlasherB_500ms,?,?) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIO(FlasherB_1s.DN) MOVE(1000,FlasherA_1s.PRE) TON(FlasherA_1s,?,?) ,XIC(FlasherA_1s.DN) MOVE(1000,FlasherB_1s.PRE) TON(FlasherB_1s,?,?) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(FlasherB_250ms.TT) OTE(DataStructure.Flash250msPD) ,XIC(FlasherB_500ms.TT) OTE(DataStructure.Flash500msPD) ,XIC(FlasherB_1s.TT) OTE(DataStructure.Flash1sPD) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
