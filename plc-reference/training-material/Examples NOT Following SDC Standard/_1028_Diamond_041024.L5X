<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Conveyor Clear Sensor To Turn On]]>
</Comment>
<Text>
<![CDATA[XIO(Supervisor_SM.Control.Bit[6])[XIC(Supervisor_SM.Status.State[5]) XIC(r03Flipper_SM.Status.State[8]) XIC(r03Flipper_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Rotation Axis To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03Flipper_SM.Status.State[10]) XIC(r03Flipper_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Rotation Axis To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r03Flipper_SM.Status.State[14]) ,XIC(r03Flipper_SM.Status.State[40]) ] XIC(r03Flipper_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Coil To Clear Gripper]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03Flipper_SM.Status.State[16]) XIC(r03Flipper_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
