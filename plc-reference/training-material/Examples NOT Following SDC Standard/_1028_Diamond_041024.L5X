<Rung Number="23" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[3]) ,XIC(Supervisor_SM.Status.State[5]) ]XIC(S09Control_SM.Control.Bit[5])XIC(c07S10Camera_OUT.Control.Trigger)OTU(S09Control_SM.Control.Bit[5]);]]>
