<![CDATA[XIC(Supervisor_SM.Status.State[5])LIMIT(4,r02AgingUnload_SM.Control.StateReg,59)[XIO(r02AgingUnload_SM.Status.State[6]) XIO(r02AgingUnload_SM.Status.State[10]) XIO(r02AgingUnload_SM.Status.State[22]) XIO(r02AgingUnload_SM.Status.State[32]) MOVE(10000,r02AgingUnload_SM.Control.FaultTime) ,[XIC(r02AgingUnload_SM.Status.State[6]) ,XIC(r02AgingUnload_SM.Status.State[10]) ,XIC(r02AgingUnload_SM.Status.State[22]) ,XIC(r02AgingUnload_SM.Status.State[32]) ] MOVE(15000,r02AgingUnload_SM.Control.FaultTime) ]OTE(r02AgingUnload_SM.Control.EnaFaultDetect);]]>
