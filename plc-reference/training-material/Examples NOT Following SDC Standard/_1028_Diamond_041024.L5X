<![CDATA[[XIC(HMI_Data.StationData.Station34.Lockout) MOVE(4,HMI_Data.StationData.Station34.Status) ,XIO(HMI_Data.StationData.Station34.Lockout) EQ(HMI_Data.StationData.Station34.Status,4) MOVE(0,HMI_Data.StationData.Station34.Status) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Load Robot Interface]]>
