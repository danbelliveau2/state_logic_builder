<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S23Control_SM.Status.State[61])XIC(Indexer_SM.Status.State[8])XIC(StationStatus[23].S22Success)OTL(StationStatus[23].S23Success);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
