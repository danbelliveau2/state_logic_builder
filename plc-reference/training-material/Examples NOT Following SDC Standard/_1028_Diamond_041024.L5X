<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S06Control_SM.Status.State[50]) ,[XIC(S06Control_SM.Status.State[60]) XIO(HMI_Data.StationData.Station6.ForceOn) XIO(StationStatus[6].S6Attempt) XIO(StationStatus[6].S4Success) ,XIC(S06Control_SM.Status.State[61]) ] XIC(Indexer_SM.Status.State[8]) ,XIC(S06Control_SM.Status.OKToIndex) ]XIO(Indexer_SM.Control.Bit[1])OTE(S06Control_SM.Status.OKToIndex);]]>
</Text>
