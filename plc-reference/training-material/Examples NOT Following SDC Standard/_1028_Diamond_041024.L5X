<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A08Control_SM.Status.State[50])[EQ(StationStatus[38].FailureType,140) ADD(HMI_Data.StationData.Station38.FCCounts[0],1,HMI_Data.StationData.Station38.FCCounts[0]) ,EQ(StationStatus[38].FailureType,141) ADD(HMI_Data.StationData.Station38.FCCounts[1],1,HMI_Data.StationData.Station38.FCCounts[1]) ,EQ(StationStatus[38].FailureType,142) ADD(HMI_Data.StationData.Station38.FCCounts[2],1,HMI_Data.StationData.Station38.FCCounts[2]) ,EQ(StationStatus[38].FailureType,143) ADD(HMI_Data.StationData.Station38.FCCounts[3],1,HMI_Data.StationData.Station38.FCCounts[3]) ,EQ(StationStatus[38].FailureType,144) ADD(HMI_Data.StationData.Station38.FCCounts[4],1,HMI_Data.StationData.Station38.FCCounts[4]) ];]]>
</Text>
</Rung>
<Rung Number="49" Type="N">
<Text>
<![CDATA[XIC(ResetFCCounts)[MOVE(0,HMI_Data.StationData.Station38.FCCounts[0]) ,MOVE(0,HMI_Data.StationData.Station38.FCCounts[1]) ,MOVE(0,HMI_Data.StationData.Station38.FCCounts[2]) ,MOVE(0,HMI_Data.StationData.Station38.FCCounts[3]) ,MOVE(0,HMI_Data.StationData.Station38.FCCounts[4]) ];]]>
