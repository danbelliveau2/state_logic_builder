<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[14V High Current Stuck On High]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[6]) XIC(A07_14VHigh_IN) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[14V Low Current Stuck On High]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[6]) XIC(A07_14VLow_IN) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[5V Signal Stuck On High]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[6]) XIC(A07_5V_IN) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[No Part Detected After Load]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[6]) XIO(Bypass_AgingPartPresent) XIO(AOI_A07_PartPresent_PE.On) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Test Probes To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[10]) XIC(A07Control_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Test Probes To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[34]) XIC(A07Control_SM.Status.TimeoutFlt) ,XIC(Alarm[5].Active) XIO(FaultReset_PB) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[3 Failures In A Row]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[50]) EQ(ConsecFails,HMI_Data.StationData.Station37.ConsecFail) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Alarm[6].Active)MOVE(0,ConsecFails);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Part Present Stuck On High]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[4]) XIO(HMI_Data.Status.MachineInSC) XIO(StationStatus[37].S13Attempt) XIO(StationStatus[37].S1Success) XIO(AOI_A07_PartPresent_PE.Off) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Arc Present Stuck On High]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(A07Control_SM.Status.State[6]) XIC(A07_ArcPresent_PE) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
