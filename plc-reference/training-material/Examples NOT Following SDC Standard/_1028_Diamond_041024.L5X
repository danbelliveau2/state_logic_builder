<Routine Name="S02StepFeeder_SM" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station 2 Step Feeder Control]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(S02StepFeeder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(S02StepFeeder_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,S02StepFeeder_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOVE(2,S02StepFeeder_SM.Control.StateReg);]]>
</Text>
</Rung>
