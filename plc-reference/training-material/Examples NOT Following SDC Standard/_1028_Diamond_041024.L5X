<Text>
<![CDATA[XIO(MachineRunning)XIC(StationStatus[34].S13Attempt)XIC(AOI_A04_PartPresent_PE.Off)COP(EmptyTracking,StationStatus[34],1)MOVE(0,HMI_Data.StationData.Station34.Status)RES(A04Control_SM.Control.Timer[2]);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
