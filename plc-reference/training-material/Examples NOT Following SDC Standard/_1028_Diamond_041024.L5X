<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Screen Change]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[NE(CurrentScreenNum,PreviousScreenNum)[MOVE(CurrentScreenNum,PreviousScreenNum) ,OTE(ScreenChangedOneShot) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Main screen handshaking]]>
</Comment>
<Text>
<![CDATA[EQ(ReplaceScreenNum,CurrentScreenNum)MOVE(0,ReplaceScreenNum);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[popup handshaking]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[NE(ReplaceScreenNum,0)ONS(OneShot.0)EQ(ReplaceScreenNum,CurrentPopupNum)OTE(PopupHidden);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Popup request to open but there's already one open.
Save the screen number and open it when the current popup closes.]]>
</Comment>
<Text>
<![CDATA[NE(ReplaceScreenNum,0)ONS(OneShot.1)LIMIT(80,ReplaceScreenNum,90)NE(ReplaceScreenNum,CurrentPopupNum)NE(CurrentPopupNum,0)[MOVE(ReplaceScreenNum,QueuedPopupNum) ,MOVE(0,ReplaceScreenNum) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQ(ReplaceScreenNum,CurrentPopupNum)MOVE(0,ReplaceScreenNum);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Current popup isn't being shown if the screen changes.
 (assuming only 1 HMI screen)
So force the popup back up by
closing it and resending it.]]>
</Comment>
<Text>
<![CDATA[[[XIC(ScreenChangedOneShot) ,XIC(PopupHidden) ] NE(CurrentPopupNum,0) [MOVE(CurrentPopupNum,SavedPopupNum) ,MOVE(9999,ReplaceScreenNum) ] ,XIC(ResendCurrentPopup_tmr.TT) XIO(ResendCurrentPopup_tmr.DN) ]TON(ResendCurrentPopup_tmr,?,?)XIC(ResendCurrentPopup_tmr.DN)MOVE(SavedPopupNum,ReplaceScreenNum);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[GT(QueuedPopupNum,0)EQ(CurrentPopupNum,0)[MOVE(QueuedPopupNum,ReplaceScreenNum) ,MOVE(0,QueuedPopupNum) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Prevent replace screen num from getting stuck.]]>
</Comment>
<Text>
<![CDATA[[EQ(ReplaceScreenNum,9999) ,EQ(ReplaceScreenNum,8888) ]TON(ResetReplaceScreen_tmr,?,?)XIC(ResetReplaceScreen_tmr.DN)MOVE(0,ReplaceScreenNum);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[JSR(HeadColor,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
