<Rung Number="7" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S27Control_SM.Status.State[50]) XIC(S27Control_SM.Control.Counter[0].DN) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Alarm[7].Active)RES(S27Control_SM.Control.Counter[0]);]]>
</Text>
