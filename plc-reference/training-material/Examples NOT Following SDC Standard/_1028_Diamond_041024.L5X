</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)OTE(c07S10Camera_OUT.Control.TriggerEnable);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S09Control_SM.Status.State[8]) ,XIC(Supervisor_SM.Status.State[3]) XIC(HMI_Data.Control.Button[182]) [ONS(S09Control_SM.Control.OS[2]) XIC(c07S10Camera_IN.Status.TriggerReady) ,XIC(c07S10Camera_OUT.Control.Trigger) XIO(c07S10Camera_IN.Status.TriggerAck) ] ]OTE(c07S10Camera_OUT.Control.Trigger);]]>
