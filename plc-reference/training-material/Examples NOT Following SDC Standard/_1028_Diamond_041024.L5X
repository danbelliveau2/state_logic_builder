</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Press To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S06Control_SM.Status.State[10]) ,XIC(S06Control_SM.Status.State[40]) ] [XIO(S06_PressRet_PRX) ,XIC(S06_PressExt_PRX) ] XIC(S06Control_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
