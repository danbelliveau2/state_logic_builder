-8 was -6.9]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S03Control_SM.Status.State[19]) ,XIC(S03Control_SM.Status.State[40]) ] GT(S03_ResinCheck_IN,-6.9) XIC(S03Control_SM.Status.TimeoutFlt) ,XIC(Alarm[9].Active) XIO(FaultReset_PB) ]OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S03Control_SM.Status.State[50]) XIC(S03Control_SM.Control.Counter[0].DN) ,XIC(Alarm[10].Active) XIO(FaultReset_PB) ]OTE(Alarm[10].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Alarm[10].Active)RES(S03Control_SM.Control.Counter[0]);]]>
</Text>
</Rung>
