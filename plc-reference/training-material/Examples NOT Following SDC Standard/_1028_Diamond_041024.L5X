<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(A04Control_SM.Status.State[36]) XIC(A04Control_SM.Status.TransitionTimerDone) ,XIC(A04Control_SM.Status.State[63]) XIO(AlarmActive) ] ]MOVE(2,A04Control_SM.Control.StateReg);]]>
