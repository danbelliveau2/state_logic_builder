<Text>
<![CDATA[[XIO(StationStatus[8].S1Attempt) MOVE(0,HeadColor[8]) ,XIC(StationStatus[8].S1Attempt) [XIO(S08Outside_SM.Control.Bit[20]) [XIC(StationStatus[8].S8OutAttempt) MOVE(1,HeadColor[8]) ,XIO(StationStatus[8].S8OutAttempt) MOVE(2,HeadColor[8]) ] ,XIC(S08Outside_SM.Control.Bit[20]) MOVE(4,HeadColor[8]) ] ,XIC(HMI_Data.HeadControl[S8HeadNumber].Lockout) MOVE(3,HeadColor[8]) ];]]>
