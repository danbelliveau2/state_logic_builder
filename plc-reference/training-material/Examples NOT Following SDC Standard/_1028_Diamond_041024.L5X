<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(Alarm[6].Active) ,XIC(Alarm[7].Active) ,XIC(Alarm[8].Active) ,XIC(Alarm[9].Active) ,XIC(Alarm[10].Active) ]OTE(S20Control_SM.Control.Bit[3]);]]>
