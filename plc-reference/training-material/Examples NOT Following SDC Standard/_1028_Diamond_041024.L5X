<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(r02AgingUnload_IN.Error)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Robot Motors To Turn On]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r02AgingUnload_SM.Status.State[56]) XIC(r02AgingUnload_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Robot Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r02AgingUnload_SM.Status.State[58]) XIC(r02AgingUnload_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Robot Move To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r02AgingUnload_SM.Status.TimeoutFlt) [XIC(r02AgingUnload_SM.Status.State[5]) OTL(r02AgingUnload_SM.Control.Bit[5]) ,XIC(r02AgingUnload_SM.Status.State[20]) OTL(r02AgingUnload_SM.Control.Bit[6]) ,XIC(r02AgingUnload_SM.Status.State[30]) OTL(r02AgingUnload_SM.Control.Bit[7]) ] ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Robot Move To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r02AgingUnload_SM.Status.State[6]) ,XIC(MachineBasic.AlwaysOff) XIC(r02AgingUnload_SM.Status.State[10]) ,XIC(r02AgingUnload_SM.Status.State[22]) ,XIC(r02AgingUnload_SM.Status.State[32]) ] XIC(r02AgingUnload_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Loss Of Robot Run Signal]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)XIC(MachineRunning)XIO(r02AgingUnload_IN.Error)XIO(r02AgingUnload_IN.Running)OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Unable To Verify Robot Status]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r02AgingUnload_SM.Status.State[45]) XIC(r02AgingUnload_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Nest NOT Empty When Robot Place Needed]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r02AgingUnload_SM.Status.State[60]) XIC(Indexer_SM.Status.State[9]) XIO(S16PlaceAttempt) XIO(S16_EmptyNestConfirm_PE) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
