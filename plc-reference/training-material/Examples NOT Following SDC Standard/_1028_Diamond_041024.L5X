<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(r01AgingLoad_IN.Error)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Robot Motors To Turn On]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r01AgingLoad_SM.Status.State[56]) XIC(r01AgingLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Robot Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r01AgingLoad_SM.Status.State[58]) XIC(r01AgingLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Robot Move To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r01AgingLoad_SM.Status.State[4]) ,XIC(r01AgingLoad_SM.Status.State[22]) ,XIC(r01AgingLoad_SM.Status.State[30]) ] XIC(r01AgingLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Robot Move To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r01AgingLoad_SM.Status.State[6]) ,XIC(MachineBasic.AlwaysOff) XIC(r01AgingLoad_SM.Status.State[10]) ,XIC(r01AgingLoad_SM.Status.State[24]) ,XIC(r01AgingLoad_SM.Status.State[32]) ] XIC(r01AgingLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Loss Of Robot Run Signal]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)XIC(MachineRunning)XIO(r01AgingLoad_IN.Error)XIO(r01AgingLoad_IN.Running)OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Unable To Verify Robot Status]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r01AgingLoad_SM.Status.State[45]) XIC(r01AgingLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Probes NOT In Correct State For Rotation]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r01AgingLoad_SM.Status.State[51]) XIC(r01AgingLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Left Rotation Cylinder To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r01AgingLoad_SM.Status.State[52]) EQ(MachinePartType,MachinePartTypeList[0]) [XIO(Aging_LeftRotationExt_PRX) ,XIC(Aging_LeftRotationRet_PRX) ] XIC(r01AgingLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Left Rotation Cylinder To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r01AgingLoad_SM.Status.State[52]) EQ(MachinePartType,MachinePartTypeList[1]) [XIC(Aging_LeftRotationExt_PRX) ,XIO(Aging_LeftRotationRet_PRX) ] XIC(r01AgingLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[9].Active) XIO(FaultReset_PB) ]OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
