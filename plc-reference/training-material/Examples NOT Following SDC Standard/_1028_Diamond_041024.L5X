<Rung Number="19" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S02StepFeeder_SM.Status.State[6]) ,XIC(S02StepFeeder_SM.Status.State[9]) ]MOVE(100,S02StepFeeder_SM.Control.TransitionTime)OTE(S02StepFeeder_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])LIMIT(4,S02StepFeeder_SM.Control.StateReg,48)MOVE(3000,S02StepFeeder_SM.Control.FaultTime)OTE(S02StepFeeder_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
