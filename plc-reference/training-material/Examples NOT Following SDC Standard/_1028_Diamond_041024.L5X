<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S27Control_SM.Status.State[26]) ,XIC(S27Control_SM.Status.State[30]) ,XIC(S27Control_SM.Status.State[33]) ,XIC(S27Control_SM.Status.State[42]) ] [XIO(S27_ZAxisRet_PRX) ,XIC(S27_ZAxisExt_PRX) ] XIC(S27Control_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
