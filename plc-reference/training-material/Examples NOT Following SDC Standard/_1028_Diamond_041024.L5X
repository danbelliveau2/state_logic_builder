<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S09Control_SM.Status.State[50]) ,[XIC(S09Control_SM.Status.State[60]) XIO(StationStatus[9].S9Attempt) XIO(StationStatus[9].S8OutAttempt) ,XIC(S09Control_SM.Status.State[61]) ] XIC(Indexer_SM.Status.State[8]) ,XIC(S09Control_SM.Status.OKToIndex) ]XIO(Indexer_SM.Control.Bit[1])OTE(S09Control_SM.Status.OKToIndex);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Station Result/Retry Count]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S09Control_SM.Status.State[48])ADD(HMI_Data.StationData.Station9.Retry,1,S09Control_SM.Control.Counter[1].PRE)[[XIC(c07S10Camera_IN.Status.JobPass) ,XIC(HMI_Data.StationData.Station9.BypassA) ] [OTL(StationStatus[9].S9Success) ,MOVE(c07S10Camera_IN.InspectionResults[0],StationStatus[9].S9Angle) ,MOVE(2,HMI_Data.StationData.Station9.Status) ] ,XIO(c07S10Camera_IN.Status.JobPass) XIO(HMI_Data.StationData.Station9.BypassA) [CTU(S09Control_SM.Control.Counter[1],?,?) ,MOVE(3,HMI_Data.StationData.Station9.Status) ] ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S09Control_SM.Status.State[50])MOVE(HMI_Data.StationData.Station9.ConsecFail,S09Control_SM.Control.Counter[0].PRE)[XIC(StationStatus[9].S9Success) RES(S09Control_SM.Control.Counter[0]) ,XIO(StationStatus[9].S9Success) [CTU(S09Control_SM.Control.Counter[0],?,?) ,MOVE(151,StationStatus[9].FailureType) ] ,RES(S09Control_SM.Control.Counter[1]) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Station Running]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])LIMIT(4,S09Control_SM.Control.StateReg,48)OTE(S09Control_SM.Control.Bit[20]);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
