<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Outside System Ready]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)[XIC(Supervisor_SM.Status.State[5]) [XIC(S08Inside_SM.Status.State[4]) ,XIC(S08Inside_SM.Status.State[14]) ] XIC(S08Inside_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S08Inside_SM.Status.State[6]) XIC(S08Inside_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Retract]]>
