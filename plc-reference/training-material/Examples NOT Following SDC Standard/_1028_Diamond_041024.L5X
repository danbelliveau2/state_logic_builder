</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])LIMIT(4,S23Control_SM.Control.StateReg,48)OTE(S23Control_SM.Control.Bit[20]);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Rotation Cylinder Control]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S23Control_SM.Status.State[5])[EQ(MachinePartType,MachinePartTypeList[0]) OTE(S23Control_SM.Control.Bit[6]) ,EQ(MachinePartType,MachinePartTypeList[1]) OTE(S23Control_SM.Control.Bit[7]) ];]]>
