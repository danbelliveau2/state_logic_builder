<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[16])XIC(A10Control_SM.Status.TransitionTimerDone)[[XIO(A10_5V_IN) ,XIC(HMI_Data.StationData.Station40.BypassA) ] [XIO(A10_14VHigh_IN) ,XIC(HMI_Data.StationData.Station40.BypassB) ] MOVE(18,A10Control_SM.Control.StateReg) ,[XIO(HMI_Data.StationData.Station40.BypassA) XIC(A10_5V_IN) ,XIO(HMI_Data.StationData.Station40.BypassB) XIC(A10_14VHigh_IN) ] [MOVE(3,HMI_Data.StationData.Station40.Status) ,MOVE(141,StationStatus[40].FailureType) ] MOVE(30,A10Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[18])XIC(A10Control_SM.Status.TransitionTimerDone)MOVE(20,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[20])[MUL(HMI_Data.Control.REAL_SP[0],1000,A10Control_SM.Control.Timer[2].PRE) RTO(A10Control_SM.Control.Timer[2],?,?) ,[XIC(A10Control_SM.Control.Timer[2].DN) [XIC(A10_5V_IN) ,XIC(HMI_Data.StationData.Station40.BypassA) ] [XIC(A10_14VHigh_IN) ,XIC(HMI_Data.StationData.Station40.BypassB) ] [XIC(A10_ArcPresent_PE) ,XIC(HMI_Data.StationData.Station40.BypassC) ] [MOVE(2,HMI_Data.StationData.Station40.Status) ,OTL(StationStatus[40].S13Success) ] ,[XIO(HMI_Data.StationData.Station40.BypassC) XIC(A10Control_SM.Control.Timer[5].DN) MOVE(142,StationStatus[40].FailureType) ,XIO(HMI_Data.StationData.Station40.BypassA) XIC(A10Control_SM.Control.Timer[3].DN) MOVE(143,StationStatus[40].FailureType) ,XIO(HMI_Data.StationData.Station40.BypassB) XIC(A10Control_SM.Control.Timer[4].DN) MOVE(144,StationStatus[40].FailureType) ] MOVE(3,HMI_Data.StationData.Station40.Status) ] [MOVE(30,A10Control_SM.Control.StateReg) ,RES(A10Control_SM.Control.Timer[2]) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A10Control_SM.Status.State[2]) XIC(CycleStartLatch) [XIO(A10_ProbesRet_PRX) ,XIC(A10_ProbesExt_PRX) ,XIO(A10_ZAxisRet_SOL) ,XIC(A10_ZAxisExt_SOL) ] ,XIC(A10Control_SM.Status.State[20]) [XIC(Indexer_SM.Status.State[62]) ,XIC(Indexer_SM.Status.State[63]) ] ]MOVE(30,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[30])XIC(A10Control_SM.Status.TransitionTimerDone)MOVE(32,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[32])XIC(A10Control_SM.Status.TransitionTimerDone)MOVE(34,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[34])XIC(A10_ProbesRet_PRX)XIO(A10_ProbesExt_PRX)XIC(Supervisor_SM.Control.Bit[4])MOVE(35,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[35])XIC(A10Control_SM.Status.TransitionTimerDone)MOVE(36,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[36])XIC(A10Control_SM.Status.TransitionTimerDone)XIO(HMI_Data.Status.MachineInSC)[EQ(A10Control_SM.Control.Timer[2].ACC,0) MOVE(48,A10Control_SM.Control.StateReg) ,NE(A10Control_SM.Control.Timer[2].ACC,0) MOVE(62,A10Control_SM.Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[48])[XIC(StationStatus[40].S13Success) ,XIC(A10Control_SM.Control.Counter[1].DN) ]MOVE(50,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(MachineRunning) ,XIC(HMI_Data.Status.MachineInSC) ]XIC(AlarmActive)ONS(A10Control_SM.Control.OS[0])MOVE(57,A10Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(A10Control_SM.Status.State[57])XIC(A10Control_SM.Status.TransitionTimerDone)MOVE(58,A10Control_SM.Control.StateReg);]]>
