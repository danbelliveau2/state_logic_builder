<![CDATA[End_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Machine Basic - Flashers, Always On, ect.]]>
</Comment>
<Text>
<![CDATA[AOI_MachineBasic(AOI_MachineBasic,MachineRunning,MachineBasic);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Get Date & Time]]>
</Comment>
<Text>
<![CDATA[CPU_TimeDate_wJulian_V2_0(AOI_DateTime,CPUDateTime);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Part Type Select]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.Control.Button[197]) TON(PartSelect_TMR1,?,?) XIC(PartSelect_TMR1.DN) MOVE(MachinePartTypeList[0],MachinePartType) ,XIC(HMI_Data.Control.Button[243]) TON(PartSelect_TMR2,?,?) XIC(PartSelect_TMR2.DN) MOVE(MachinePartTypeList[1],MachinePartType) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NE(MachinePartType,MachinePartTypePre)MOVE(MachinePartType,MachinePartTypePre)OTE(PartTypeChanged);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Reset ALL Counts]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Data.Control.Button[178])TON(CountHoldTimers[8],?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(CountHoldTimers[8].DN)OTE(ResetALL);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[JSR(Supervisor_SM_SUB,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[JSR(StationData_SUB,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[JSR(AgingData_SUB,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[JSR(ProductionData_SUB,0);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[JSR(ShiftData_SUB,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ProductionData_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Production Data - Uses Array Index 0

Good Counts]]>
</Comment>
<Text>
<![CDATA[XIC(r05Packout_OUT.UserOut[0].1)ONS(MainCounts_ONS_B.0)[ADD(ProductionData[0].Good,1,ProductionData[0].Good) ,ADD(HMI_Data.HeadControl[S27HeadNumber].Attempts,1,HMI_Data.HeadControl[S27HeadNumber].Attempts) ,ADD(HMI_Data.HeadControl[S27HeadNumber].Successes,1,HMI_Data.HeadControl[S27HeadNumber].Successes) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Reject Counts - Added Separately In Case Sequences Called At Same Time]]>
</Comment>
<Text>
<![CDATA[[XIC(r05Packout_OUT.UserOut[0].3) ,XIC(r05Packout_OUT.UserOut[0].4) ]ONS(MainCounts_ONS_B.1)[ADD(ProductionData[0].Reject,1,ProductionData[0].Reject) ,ADD(HMI_Data.HeadControl[S27HeadNumber].Attempts,1,HMI_Data.HeadControl[S27HeadNumber].Attempts) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(r01AgingLoad_OUT.UserOut[1].3)ONS(MainCounts_ONS_B.4)ADD(ProductionData[0].Reject,1,ProductionData[0].Reject);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Total Counts]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ADD(ProductionData[0].Good,ProductionData[0].Reject,ProductionData[0].Total);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[0].GoodPercent,(ProductionData[0].Good/ProductionData[0].Total)*100);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[0].RejectPercent,(ProductionData[0].Reject/ProductionData[0].Total)*100);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)[RTO(CycleRuntime_TMR,?,?) ,XIC(CycleRuntime_TMR.DN) ADD(ProductionData[0].RuntimeSec,1,ProductionData[0].RuntimeSec) DIV(ProductionData[0].RuntimeSec,60,ProductionData[0].RuntimeMin) RES(CycleRuntime_TMR) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[MUL(ProductionData[0].RuntimeSec,1000,RuntimeSecScaledA);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(MachineRunning)[RTO(CycleDowntime_TMR,?,?) ,XIC(CycleDowntime_TMR.DN) ADD(ProductionData[0].DowntimeSec,1,ProductionData[0].DowntimeSec) DIV(ProductionData[0].DowntimeSec,60,ProductionData[0].DowntimeMin) RES(CycleDowntime_TMR) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[MUL(ProductionData[0].DowntimeSec,1000,DowntimeSecScaledA);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ADD(ProductionData[0].RuntimeMin,ProductionData[0].DowntimeMin,ProductionData[0].ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[0].GoodRate,(ProductionData[0].Good/ProductionData[0].RuntimeMin));]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[OEE AOI]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[AOI_OEE(AOI_Production_OEE,10.0,ProductionData[0].Total,ProductionData[0].Good,480.0,480.0,RuntimeSecScaledA,DowntimeSecScaledA) ,MOVE(AOI_Production_OEE.Availability,ProductionData[0].RuntimeEff) ,MOVE(AOI_Production_OEE.Performance,ProductionData[0].CycleEff) ,MOVE(AOI_Production_OEE.OEE,ProductionData[0].OEE) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIC(MachineFaultActive)ONS(MainCounts_ONS_B.11)ADD(ProductionData[0].TotalFaults,1,ProductionData[0].TotalFaults);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Reset Total Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.Control.ResetPartCounts) TON(CountHoldTimers[1],?,?) XIC(CountHoldTimers[1].DN) ,XIC(CountHoldTimers[8].DN) ]COP(EmptyProductionData,ProductionData[0],1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ShiftData_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Shift Data - Uses Array Indexes 1,2,3

Calculate Shift Number]]>
</Comment>
<Text>
<![CDATA[[EQ(CPUDateTime.Hour,7) EQ(CPUDateTime.Minutes,0) ONS(MainCounts_ONS_B.5) MOVE(1,CurrentShift) MOVE(3,PreviousShift) ,EQ(CPUDateTime.Hour,15) EQ(CPUDateTime.Minutes,0) ONS(MainCounts_ONS_B.6) MOVE(2,CurrentShift) MOVE(1,PreviousShift) ,EQ(CPUDateTime.Hour,23) EQ(CPUDateTime.Minutes,0) ONS(MainCounts_ONS_B.7) MOVE(3,CurrentShift) MOVE(2,PreviousShift) ]OTE(ShiftChangedPulse);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(ShiftChangedPulse)COP(EmptyProductionData,ProductionData[CurrentShift],1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Good Counts]]>
</Comment>
<Text>
<![CDATA[XIC(r05Packout_OUT.UserOut[0].1)ONS(MainCounts_ONS_B.8)ADD(ProductionData[CurrentShift].Good,1,ProductionData[CurrentShift].Good);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Reject Counts - Added Separately In Case Sequences Called At Same Time]]>
</Comment>
<Text>
<![CDATA[[XIC(r05Packout_OUT.UserOut[0].3) ,XIC(r05Packout_OUT.UserOut[0].4) ]ONS(MainCounts_ONS_B.9)ADD(ProductionData[CurrentShift].Reject,1,ProductionData[CurrentShift].Reject);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(r01AgingLoad_OUT.UserOut[1].3)ONS(MainCounts_ONS_B.10)ADD(ProductionData[CurrentShift].Reject,1,ProductionData[CurrentShift].Reject);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Total Counts]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ADD(ProductionData[CurrentShift].Good,ProductionData[CurrentShift].Reject,ProductionData[CurrentShift].Total);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[CurrentShift].GoodPercent,(ProductionData[CurrentShift].Good/ProductionData[CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[CurrentShift].RejectPercent,(ProductionData[CurrentShift].Reject/ProductionData[CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)[RTO(ShiftRuntime_TMR,?,?) ,XIC(ShiftRuntime_TMR.DN) ADD(ProductionData[CurrentShift].RuntimeSec,1,ProductionData[CurrentShift].RuntimeSec) DIV(ProductionData[CurrentShift].RuntimeSec,60,ProductionData[CurrentShift].RuntimeMin) RES(ShiftRuntime_TMR) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[MUL(ProductionData[CurrentShift].RuntimeSec,1000,RunTimeSecScaled);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(MachineRunning)[RTO(ShiftDowntime_TMR,?,?) ,XIC(ShiftDowntime_TMR.DN) ADD(ProductionData[CurrentShift].DowntimeSec,1,ProductionData[CurrentShift].DowntimeSec) DIV(ProductionData[CurrentShift].DowntimeSec,60,ProductionData[CurrentShift].DowntimeMin) RES(ShiftDowntime_TMR) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[MUL(ProductionData[CurrentShift].DowntimeSec,1000,DowntimeSecScaled);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ADD(ProductionData[CurrentShift].RuntimeMin,ProductionData[CurrentShift].DowntimeMin,ProductionData[CurrentShift].ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)CPT(ProductionData[CurrentShift].GoodRate,(ProductionData[CurrentShift].Good/ProductionData[CurrentShift].RuntimeMin));]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[OEE AOI]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[AOI_OEE(AOI_Shift_OEE,10.0,ProductionData[CurrentShift].Total,ProductionData[CurrentShift].Good,480.0,480.0,RunTimeSecScaled,DowntimeSecScaled) ,MOVE(AOI_Shift_OEE.Availability,ProductionData[CurrentShift].RuntimeEff) ,MOVE(AOI_Shift_OEE.Performance,ProductionData[CurrentShift].CycleEff) ,MOVE(AOI_Shift_OEE.OEE,ProductionData[CurrentShift].OEE) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIC(MachineFaultActive)ONS(MainCounts_ONS_B.12)ADD(ProductionData[CurrentShift].TotalFaults,1,ProductionData[CurrentShift].TotalFaults);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Reset Current Shift Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.Control.ResetCurrentShift) TON(CountHoldTimers[6],?,?) XIC(CountHoldTimers[6].DN) ,XIC(CountHoldTimers[8].DN) ]COP(EmptyProductionData,ProductionData[CurrentShift],1);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Reset All Shift Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Data.Control.ResetAllShift) TON(CountHoldTimers[7],?,?) XIC(CountHoldTimers[7].DN) ,XIC(CountHoldTimers[8].DN) ]COP(EmptyProductionData,ProductionData[1],1)COP(EmptyProductionData,ProductionData[2],1)COP(EmptyProductionData,ProductionData[3],1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="StationData_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Machine Counts
Station 1]]>
</Comment>
<Text>
<![CDATA[[XIC(Indexer_SM.Status.State[9]) XIC(StationStatus[1].S1Attempt) ONS(MainCounts_ONS_A.0) [ADD(HMI_Data.StationData.Station1.Attempts,1,HMI_Data.StationData.Station1.Attempts) ,ADD(HMI_Data.HeadData[S1HeadNumber].Station1.Attempts,1,HMI_Data.HeadData[S1HeadNumber].Station1.Attempts) ] ,XIC(Indexer_SM.Status.State[9]) XIC(StationStatus[2].S1Attempt) XIC(StationStatus[2].S1Success) ONS(MainCounts_ONS_A.1) [ADD(HMI_Data.StationData.Station1.Successes,1,HMI_Data.StationData.Station1.Successes) ,ADD(HMI_Data.HeadData[S2HeadNumber].Station1.Successes,1,HMI_Data.HeadData[S2HeadNumber].Station1.Successes) ] ,CPT(HMI_Data.StationData.Station1.Efficiency,(HMI_Data.StationData.Station1.Successes/HMI_Data.StationData.Station1.Attempts)*100) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Station 2]]>
</Comment>
<Text>
<![CDATA[[XIC(StationStatus[2].S2Attempt) ONS(MainCounts_ONS_B.15) [ADD(HMI_Data.StationData.Station2.Attempts,1,HMI_Data.StationData.Station2.Attempts) ,ADD(HMI_Data.HeadData[S2HeadNumber].Station2.Attempts,1,HMI_Data.HeadData[S2HeadNumber].Station2.Attempts) ] ,XIC(StationStatus[2].S2Attempt) XIC(StationStatus[2].S2Success) ONS(MainCounts_ONS_B.16) [ADD(HMI_Data.StationData.Station2.Successes,1,HMI_Data.StationData.Station2.Successes) ,ADD(HMI_Data.HeadData[S2HeadNumber].Station2.Successes,1,HMI_Data.HeadData[S2HeadNumber].Station2.Successes) ] ,CPT(HMI_Data.StationData.Station2.Efficiency,(HMI_Data.StationData.Station2.Successes/HMI_Data.StationData.Station2.Attempts)*100) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Station 3 Resistor]]>
</Comment>
<Text>
<![CDATA[[XIC(StationStatus[3].S3Attempt) ONS(MainCounts_ONS_A.2) [ADD(HMI_Data.StationData.Station3Resistor.Attempts,1,HMI_Data.StationData.Station3Resistor.Attempts) ,ADD(HMI_Data.HeadData[S3HeadNumber].Station3Resistor.Attempts,1,HMI_Data.HeadData[S3HeadNumber].Station3Resistor.Attempts) ] ,XIC(StationStatus[3].S3Attempt) XIC(StationStatus[3].S3Resistor) ONS(MainCounts_ONS_A.3) [ADD(HMI_Data.StationData.Station3Resistor.Successes,1,HMI_Data.StationData.Station3Resistor.Successes) ,ADD(HMI_Data.HeadData[S3HeadNumber].Station3Resistor.Successes,1,HMI_Data.HeadData[S3HeadNumber].Station3Resistor.Successes) ] ,CPT(HMI_Data.StationData.Station3Resistor.Efficiency,(HMI_Data.StationData.Station3Resistor.Successes/HMI_Data.StationData.Station3Resistor.Attempts)*100) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Station 3 Surface]]>
</Comment>
<Text>
<![CDATA[[XIC(StationStatus[3].S3Attempt) ONS(MainCounts_ONS_B.17) [ADD(HMI_Data.StationData.Station3Surface.Attempts,1,HMI_Data.StationData.Station3Surface.Attempts) ,ADD(HMI_Data.HeadData[S3HeadNumber].Station3Surface.Attempts,1,HMI_Data.HeadData[S3HeadNumber].Station3Surface.Attempts) ] ,XIC(StationStatus[3].S3Attempt) XIC(StationStatus[3].S3Surface) ONS(MainCounts_ONS_B.18) [ADD(HMI_Data.StationData.Station3Surface.Successes,1,HMI_Data.StationData.Station3Surface.Successes) ,ADD(HMI_Data.HeadData[S3HeadNumber].Station3Surface.Successes,1,HMI_Data.HeadData[S3HeadNumber].Station3Surface.Successes) ] ,CPT(HMI_Data.StationData.Station3Surface.Efficiency,(HMI_Data.StationData.Station3Surface.Successes/HMI_Data.StationData.Station3Surface.Attempts)*100) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Station 3 Resin]]>
</Comment>
<Text>
<![CDATA[[XIC(StationStatus[3].S3Attempt) ONS(MainCounts_ONS_B.19) [ADD(HMI_Data.StationData.Station3Resin.Attempts,1,HMI_Data.StationData.Station3Resin.Attempts) ,ADD(HMI_Data.HeadData[S3HeadNumber].Station3Resin.Attempts,1,HMI_Data.HeadData[S3HeadNumber].Station3Resin.Attempts) ] ,XIC(StationStatus[3].S3Attempt) XIC(StationStatus[3].S3Resin) ONS(MainCounts_ONS_B.20) [ADD(HMI_Data.StationData.Station3Resin.Successes,1,HMI_Data.StationData.Station3Resin.Successes) ,ADD(HMI_Data.HeadData[S3HeadNumber].Station3Resin.Successes,1,HMI_Data.HeadData[S3HeadNumber].Station3Resin.Successes) ] ,CPT(HMI_Data.StationData.Station3Resin.Efficiency,(HMI_Data.StationData.Station3Resin.Successes/HMI_Data.StationData.Station3Resin.Attempts)*100) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Station 3 Bushing ID]]>
