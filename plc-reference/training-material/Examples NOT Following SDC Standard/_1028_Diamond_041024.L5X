<Routine Name="HeadColor" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[0-Not Running
1-Good
2-Reject
3-Locked Out
4-Running

Station 1]]>
</Comment>
<Text>
<![CDATA[[XIO(StationStatus[1].S1Attempt) MOVE(0,HeadColor[1]) ,XIC(StationStatus[1].S1Attempt) [XIO(S01Control_SM.Control.Bit[20]) MOVE(1,HeadColor[1]) ,XIC(S01Control_SM.Control.Bit[20]) MOVE(4,HeadColor[1]) ] ,XIC(HMI_Data.HeadControl[S1HeadNumber].Lockout) MOVE(3,HeadColor[1]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Station 2]]>
</Comment>
<Text>
<![CDATA[[XIO(StationStatus[2].S1Attempt) MOVE(0,HeadColor[2]) ,XIC(StationStatus[2].S1Attempt) [XIO(S02Control_SM.Control.Bit[20]) [XIC(StationStatus[2].S1Success) MOVE(1,HeadColor[2]) ,XIO(StationStatus[2].S1Success) MOVE(2,HeadColor[2]) ] ,XIC(S02Control_SM.Control.Bit[20]) MOVE(4,HeadColor[2]) ] ,XIC(HMI_Data.HeadControl[S2HeadNumber].Lockout) MOVE(3,HeadColor[2]) ];]]>
