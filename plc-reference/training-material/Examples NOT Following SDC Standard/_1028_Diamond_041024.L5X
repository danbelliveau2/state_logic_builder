<Text>
<![CDATA[XIC(ManualMode)XIC(Permissive)XIC(HMI_ServoData.Status.MotionEnable)[XIC(HMI_ServoData.Control.InchPos) ONS(ONS_Word.3) MOVE(HMI_ServoData.Control.InchAmount,InchAmount) ,XIC(HMI_ServoData.Control.InchNeg) ONS(ONS_Word.4) NEG(HMI_ServoData.Control.InchAmount,InchAmount) ]XIO(Axis.MoveStatus)XIO(Axis.JogStatus)[EQ(SpeedUnits,0) MAM(Axis,Axis_MAM,1,InchAmount,HMI_ServoData.Control.ManualSpeed,Units per sec,HMI_ServoData.Control.Accel,Units per sec2,HMI_ServoData.Control.Decel,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0) ,EQ(SpeedUnits,1) MAM(Axis,Axis_MAM,1,InchAmount,HMI_ServoData.Control.ManualSpeed,% of Maximum,HMI_ServoData.Control.Accel,% of Maximum,HMI_ServoData.Control.Decel,% of Maximum,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None,0,0) ];]]>
</Text>
</Rung>
