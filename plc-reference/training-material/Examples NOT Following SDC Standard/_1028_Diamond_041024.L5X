<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Stepper Motor Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_S10AMStepper_SC.Drive_Fault)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Gripper To Close]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S10Control_SM.Status.State[6]) XIC(S10Control_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Gripper To Open]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S10Control_SM.Status.State[16]) ,XIC(S10Control_SM.Status.State[40]) ] XIC(S10Control_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Camera Ready]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)[XIC(Supervisor_SM.Status.State[5]) XIC(S10Control_SM.Status.State[7]) XIC(S10Control_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Camera Trigger Acknowledge]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)[XIC(Supervisor_SM.Status.State[5]) XIC(S10Control_SM.Status.State[8]) XIC(S10Control_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Stepper Move To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S10Control_SM.Status.State[10]) ,XIC(S10Control_SM.Status.State[18]) ,XIC(S10Control_SM.Status.State[42]) ] XIC(S10Control_SM.Status.TimeoutFlt) ,XIC(Alarm[5].Active) XIO(FaultReset_PB) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For Stepper Move To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S10Control_SM.Status.State[12]) ,XIC(S10Control_SM.Status.State[20]) ,XIC(S10Control_SM.Status.State[44]) ] XIC(S10Control_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Stepper Move To Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S10Control_SM.Status.State[14]) XIC(S10Control_SM.Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)[XIC(Supervisor_SM.Status.State[5]) XIC(S10Control_SM.Status.State[50]) XIC(S10Control_SM.Control.Counter[0].DN) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Alarm[8].Active)RES(S10Control_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
