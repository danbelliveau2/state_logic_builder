		],[2023,11,28,14,58,1,0,1701197881443375],191164950,118,2],[3,5,0,[32,'Loss Of Shot Pin Servo Drive EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[2023,11,28,14,58,1,0,1701197881443375],191138754,118,2],[3,6,0,[32,'Loss Of Indexer Valve Bank 1 EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[2023,10,3,11,16,0,0,1696346160228435],168565159,76,2],[3,7,0,[32,'Loss Of Indexer Valve Bank 2 EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[2023,10,3,11,16,0,0,1696346160228435],168568921,76,2],[3,8,0,[40,'Loss Of Aging Test System Valve Bank EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[2023,12,5,12,58,47,0,1701795527809405],72903701,106,2],[3,9,0,[39,'Loss Of Coil Load System Valve Bank EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[1998,1,8,23,59,0,0,884303940436911],186493987,0,2],[3,10,0,[37,'Loss Of Packout System Valve Bank EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[1998,1,8,23,59,0,0,884303940436911],186501720,0,2],[3,11,0,[40,'Loss Of Aging Test Cabinet Point I/O EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[2023,12,5,12,58,47,0,1701795527858440],72991905,106,2],[3,12,0,[48,'Loss Of Aging Driver Board Cabinet Point I/O EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
		],[2023,12,5,12,58,47,0,1701795527906595],75385782,106,2],[3,13,0,[28,'Loss Of Aging Load Robot EIP$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00'
