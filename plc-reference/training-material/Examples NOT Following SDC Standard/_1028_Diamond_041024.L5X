</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S03Control_SM.Status.State[19]) ,XIC(S03Control_SM.Status.State[40]) ] LT(S03_MPCSurfaceCheck_IN,44) XIC(S03Control_SM.Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Resin Check To Extend
0 was -2]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S03Control_SM.Status.State[12]) LT(S03_ResinCheck_IN,0) XIC(S03Control_SM.Status.TimeoutFlt) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
