<Comments>
<Comment Operand=".STATUS.STATE[0]">
<![CDATA[Station 2 Bushing Load Not Running]]>
</Comment>
<Comment Operand=".STATUS.STATE[2]">
<![CDATA[Station 2 Bushing Load Automatic Mode]]>
</Comment>
<Comment Operand=".STATUS.STATE[4]">
<![CDATA[Station 2 Bushing Load Wait For Part At Escapement]]>
</Comment>
<Comment Operand=".STATUS.STATE[6]">
<![CDATA[Station 2 Bushing Load Extend Rotation Cylinder]]>
</Comment>
<Comment Operand=".STATUS.STATE[7]">
<![CDATA[Station 2 Bushing Load Check Bushing In Sleeve Off]]>
</Comment>
<Comment Operand=".STATUS.STATE[8]">
<![CDATA[Station 2 Bushing Load Check Sleeve]]>
</Comment>
<Comment Operand=".STATUS.STATE[10]">
<![CDATA[Station 2 Bushing Load Extend X Axis]]>
</Comment>
<Comment Operand=".STATUS.STATE[12]">
<![CDATA[Station 2 Bushing Load Retract Escapement]]>
</Comment>
<Comment Operand=".STATUS.STATE[14]">
<![CDATA[Station 2 Bushing Load Extend Escapement]]>
</Comment>
<Comment Operand=".STATUS.STATE[15]">
<![CDATA[Station 2 Check If Bushing Fell Correctly]]>
</Comment>
<Comment Operand=".STATUS.STATE[16]">
<![CDATA[Station 2 Bushing Load Retract X Axis & Rotation Cylinder]]>
</Comment>
<Comment Operand=".STATUS.STATE[18]">
<![CDATA[Station 2 Bushing Load Check Bushing Status & Escapement Sensor Off]]>
</Comment>
<Comment Operand=".STATUS.STATE[40]">
<![CDATA[Station 2 Bushing Load Initialize All Cylinders]]>
</Comment>
<Comment Operand=".STATUS.STATE[50]">
<![CDATA[Station 2 Bushing Load Cycle Complete]]>
</Comment>
<Comment Operand=".STATUS.STATE[60]">
<![CDATA[Station 2 Bushing Load Wait For Station 2 Ready]]>
</Comment>
<Comment Operand=".STATUS.STATE[61]">
<![CDATA[Station 2 Bushing Load Locked Out]]>
</Comment>
<Comment Operand=".STATUS.STATE[62]">
<![CDATA[Station 2 Bushing Load Cycle Stop]]>
</Comment>
<Comment Operand=".STATUS.STATE[63]">
<![CDATA[Station 2 Bushing Load Faulted]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[0]">
<![CDATA[Bushing Escapement Retracted Delay Timer]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[1]">
<![CDATA[State 14 Delay Timer]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[2]">
<![CDATA[Warning Timer]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[3]">
<![CDATA[State 6 Delay Timer]]>
</Comment>
<Comment Operand=".CONTROL.BIT[0]">
<![CDATA[Bushing Ready In Escapement]]>
</Comment>
<Comment Operand=".CONTROL.BIT[1]">
<![CDATA[Bushing Fell On Pin Correctly]]>
</Comment>
<Comment Operand=".CONTROL.BIT[2]">
<![CDATA[Bushing Ready For Press Operation]]>
</Comment>
<Comment Operand=".CONTROL.BIT[3]">
<![CDATA[Rotation Initialize Retract]]>
</Comment>
<Comment Operand=".CONTROL.BIT[4]">
<![CDATA[Rotation Initialize Extend]]>
</Comment>
<Comment Operand=".CONTROL.BIT[5]">
<![CDATA[Bushing X Axis Manual Extend Permissive]]>
</Comment>
