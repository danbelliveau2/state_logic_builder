<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[XIC(r04BootLoad_IN.Error)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Robot Motors To Turn On]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r04BootLoad_SM.Status.State[56]) XIC(r04BootLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Robot Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r04BootLoad_SM.Status.State[58]) XIC(r04BootLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Robot Move To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r04BootLoad_SM.Status.State[8]) ,XIC(r04BootLoad_SM.Status.State[14]) ,XIC(r04BootLoad_SM.Status.State[18]) ,XIC(r04BootLoad_SM.Status.State[22]) ,XIC(r04BootLoad_SM.Status.State[34]) ,XIC(r04BootLoad_SM.Status.State[30]) ,XIC(r04BootLoad_SM.Status.State[40]) ] XIC(r04BootLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Robot Move To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(r04BootLoad_SM.Status.State[10]) ,XIC(r04BootLoad_SM.Status.State[16]) ,XIC(r04BootLoad_SM.Status.State[20]) ,XIC(r04BootLoad_SM.Status.State[24]) ,XIC(r04BootLoad_SM.Status.State[32]) ,XIC(r04BootLoad_SM.Status.State[42]) ] XIC(r04BootLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Loss Of Robot Run Signal]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)XIC(MachineRunning)XIO(r04BootLoad_IN.Error)XIO(r04BootLoad_IN.Running)OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For Boot Present]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r04BootLoad_SM.Status.State[4]) XIC(r04BootLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Spring Present]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r04BootLoad_SM.Status.State[12]) XIC(r04BootLoad_SM.Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Hopper Low Level To Turn Off]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r04BootLoad_OUT.UserOut[1].3) XIO(AOI_r04HopperLowLevel_IN.Off) TON(r04BootLoad_SM.Control.Timer[2],?,?) XIC(r04BootLoad_SM.Control.Timer[2].DN) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Boot Conveyor Warning]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r04BootLoad_SM.Status.State[4])TON(r04BootLoad_SM.Control.Timer[4],?,?)XIC(r04BootLoad_SM.Control.Timer[4].DN)OTE(Warning[0].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Waiting For Spring Conveyor Warning]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r04BootLoad_SM.Status.State[12])TON(r04BootLoad_SM.Control.Timer[5],?,?)XIC(r04BootLoad_SM.Control.Timer[5].DN)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive) ,ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive) ];]]>
</Text>
</Rung>
