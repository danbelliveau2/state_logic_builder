</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].8)OTE(RobotInputsTag.MotorOn);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].9)OTE(RobotInputsTag.AtHome);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(ControllerModuleTag_Inputs.Data[0].10) OTE(RobotInputsTag.ErrorCode.0) ,XIC(ControllerModuleTag_Inputs.Data[0].11) OTE(RobotInputsTag.ErrorCode.1) ,XIC(ControllerModuleTag_Inputs.Data[0].12) OTE(RobotInputsTag.ErrorCode.2) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(ControllerModuleTag_Inputs.Data[0].13)OTE(RobotInputsTag.AutoMode);]]>
