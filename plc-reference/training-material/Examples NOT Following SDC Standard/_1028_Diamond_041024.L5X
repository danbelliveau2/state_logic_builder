<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Barcode Scanner Trigger Ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[4]) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Barcode Scanner Results Valid]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[6]) XIO(c02S23Camera_IN.Status.ResultsValid) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Barcode Scanner Decode Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[6]) XIO(S23Control_SM.Control.Bit[0]) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Barcode Scanner Results Ack]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[8]) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Camera Trigger Ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[12]) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Camera Results Valid]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[14]) XIO(c03S23Camera_IN.Status.ResultsValid) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[5].Active) XIO(FaultReset_PB) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For Camera Inspection Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[14]) XIO(S23Control_SM.Control.Bit[3]) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[50]) XIC(S23Control_SM.Control.Counter[0].DN) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Alarm[7].Active)RES(S23Control_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Rotation Cylinder To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[5]) EQ(MachinePartType,MachinePartTypeList[1]) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Waiting For Rotation Cylinder To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S23Control_SM.Status.State[5]) EQ(MachinePartType,MachinePartTypeList[0]) XIC(S23Control_SM.Status.TimeoutFlt) ,XIC(Alarm[9].Active) XIO(FaultReset_PB) ]OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="S23Control_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station 23 Control]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(S23Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOVE(2,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S23Control_SM.Status.State[5])[EQ(MachinePartType,MachinePartTypeList[1]) XIC(S23_RotationRet_PRX) XIO(S23_RotationExt_PRX) ,EQ(MachinePartType,MachinePartTypeList[0]) XIC(S23_RotationExt_PRX) XIO(S23_RotationRet_PRX) ]MOVE(4,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S23Control_SM.Status.State[60]) XIC(Indexer_SM.Status.State[9]) XIO(StationStatus[23].S23Attempt) [XIO(HMI_Data.Control.Button[147]) XIC(StationStatus[23].S22Success) ,XIC(HMI_Data.Control.Button[147]) LIMIT(13,StationStatus[23].PreOpSelect,18) NE(StationStatus[23].PreOpSelect,16) NE(StationStatus[23].PreOpSelect,17) ,XIC(HMI_Data.StationData.Station23.ForceOn) ] ,XIC(S23Control_SM.Status.State[10]) XIO(S23Control_SM.Control.Bit[2]) XIO(S23Control_SM.Control.Counter[1].DN) XIO(HMI_Data.Control.Button[147]) ]MOVE(5,S23Control_SM.Control.StateReg)OTL(StationStatus[23].S23Attempt);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S23Control_SM.Status.State[4])XIC(S23Control_SM.Status.TransitionTimerDone)XIC(c02S23Camera_IN.Status.TriggerReady)MOVE(6,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S23Control_SM.Status.State[6])XIC(c02S23Camera_IN.Status.ResultsValid)XIC(S23Control_SM.Control.Bit[0])MOVE(10,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S23Control_SM.Status.State[10]) [XIC(S23Control_SM.Control.Bit[2]) XIO(S23Control_SM.Control.Counter[1].DN) ,XIC(HMI_Data.Control.Button[147]) ] ,XIC(S23Control_SM.Status.State[48]) XIO(S23Control_SM.Control.Bit[4]) XIO(S23Control_SM.Control.Counter[2].DN) XIO(HMI_Data.Control.Button[147]) ]MOVE(12,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S23Control_SM.Status.State[12])XIC(c03S23Camera_IN.Status.TriggerReady)MOVE(14,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S23Control_SM.Status.State[14])XIC(c03S23Camera_IN.Status.ResultsValid)XIC(S23Control_SM.Control.Bit[3])MOVE(48,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S23Control_SM.Status.State[48]) [XIC(S23Control_SM.Control.Bit[4]) ,XIC(S23Control_SM.Control.Counter[2].DN) ,XIC(HMI_Data.Control.Button[147]) ] ,XIC(S23Control_SM.Status.State[10]) XIO(S23Control_SM.Control.Bit[2]) XIC(S23Control_SM.Control.Counter[1].DN) XIO(HMI_Data.Control.Button[147]) ]MOVE(50,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S23Control_SM.Status.State[2]) XIC(CycleStartLatch) ,XIC(S23Control_SM.Status.State[50]) ]MOVE(60,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S23Control_SM.Status.State[2])XIC(CycleStartLatch)XIC(HMI_Data.StationData.Station23.Lockout)MOVE(61,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S23Control_SM.Status.State[60]) ,XIC(S23Control_SM.Status.State[61]) ][XIC(Indexer_SM.Status.State[62]) ,XIC(Indexer_SM.Status.State[63]) ]MOVE(62,S23Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(MachineRunning)XIC(AlarmActive)[MOVE(63,S23Control_SM.Control.StateReg) ,EQ(StationStatus[23].FailureType,0) MOVE(121,StationStatus[23].FailureType) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_S23Control_SM,S23Control_SM);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(c02S23Camera_IN.Status.Online)EQ(c02S23Camera_JN,c02S23Camera_IN.Status.CurrentJobID)XIC(c03S23Camera_IN.Status.Online)EQ(c03S23Camera_JN,c03S23Camera_IN.Status.CurrentJobID)OTE(S23Control_SM.Status.AutoPreOK);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[If Safety Stop During Operation Then Load Fault Code]]>
</Comment>
<Text>
<![CDATA[XIO(MainAssemblyOK)XIC(StationStatus[23].S23Attempt)XIO(StationStatus[23].S23Success)EQ(StationStatus[23].FailureType,0)MOVE(121,StationStatus[23].FailureType);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
