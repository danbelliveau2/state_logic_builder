</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,S09Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S09Control_SM.Status.State[30])[XIC(S09_BootLoadVerify_PE) MOVE(4,S09Control_SM.Control.StateReg) RES(S09Control_SM.Control.Counter[2]) ,XIO(S09_BootLoadVerify_PE) MOVE(50,S09Control_SM.Control.StateReg) CTU(S09Control_SM.Control.Counter[2],?,?) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S09Control_SM.Status.State[4])XIC(S09Control_SM.Status.TransitionTimerDone)XIC(c07S10Camera_IN.Status.TriggerReady)MOVE(8,S09Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S09Control_SM.Status.State[60]) XIC(Indexer_SM.Status.State[9]) XIO(StationStatus[9].S9Attempt) XIC(StationStatus[9].S8OutAttempt) ,XIC(S09Control_SM.Status.State[48]) XIO(StationStatus[9].S9Success) XIO(S09Control_SM.Control.Counter[1].DN) ]MOVE(30,S09Control_SM.Control.StateReg)OTL(StationStatus[9].S9Attempt);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S09Control_SM.Status.State[8])XIC(c07S10Camera_IN.Status.ResultsValid)XIC(S09Control_SM.Control.Bit[5])MOVE(48,S09Control_SM.Control.StateReg);]]>
