<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S02StepFeeder_SM.Status.State[60]) ,XIC(S02StepFeeder_SM.Status.State[61]) ][XIC(S02Control_SM.Status.State[62]) ,XIC(S02Control_SM.Status.State[63]) ]MOVE(62,S02StepFeeder_SM.Control.StateReg);]]>
