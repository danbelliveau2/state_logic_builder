<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S24Control_SM.Status.State[10]) MOVE(250,S24Control_SM.Control.TransitionTime) ,XIC(S24Control_SM.Status.State[11]) MOVE(1000,S24Control_SM.Control.TransitionTime) ]OTE(S24Control_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="56" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])LIMIT(4,S24Control_SM.Control.StateReg,42)MOVE(3000,S24Control_SM.Control.FaultTime)OTE(S24Control_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="57" Type="N">
<Text>
