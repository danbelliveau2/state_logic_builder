</Rung>
<Rung Number="50" Type="N">
<Comment>
<![CDATA[State Transition Timer]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A02Control_SM.Status.State[8]) MOVE(AgingTimerPresets[0],A02Control_SM.Control.TransitionTime) ,XIC(A02Control_SM.Status.State[12]) MOVE(AgingTimerPresets[2],A02Control_SM.Control.TransitionTime) ,XIC(A02Control_SM.Status.State[14]) MOVE(AgingTimerPresets[3],A02Control_SM.Control.TransitionTime) ,XIC(A02Control_SM.Status.State[16]) MOVE(AgingTimerPresets[4],A02Control_SM.Control.TransitionTime) ,XIC(A02Control_SM.Status.State[18]) MOVE(AgingTimerPresets[5],A02Control_SM.Control.TransitionTime) ,[XIC(A02Control_SM.Status.State[30]) ,XIC(A02Control_SM.Status.State[57]) ] MOVE(AgingTimerPresets[10],A02Control_SM.Control.TransitionTime) ,XIC(A02Control_SM.Status.State[35]) MOVE(AgingTimerPresets[12],A02Control_SM.Control.TransitionTime) ,[XIC(A02Control_SM.Status.State[32]) ,XIC(A02Control_SM.Status.State[58]) ,XIC(A02Control_SM.Status.State[59]) ] MOVE(AgingTimerPresets[11],A02Control_SM.Control.TransitionTime) ,XIC(A02Control_SM.Status.State[36]) MOVE(AgingTimerPresets[1],A02Control_SM.Control.TransitionTime) ]OTE(A02Control_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Comment>
<![CDATA[Fault Transition Timer]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A02Control_SM.Status.State[10]) ,XIC(A02Control_SM.Status.State[34]) ]MOVE(2000,A02Control_SM.Control.FaultTime)OTE(A02Control_SM.Control.EnaFaultDetect);]]>
