<Rung Number="46" Type="N">
<Text>
<![CDATA[XIC(ResetFCCounts)[MOVE(0,HMI_Data.StationData.Station16.FCCounts[0]) ,MOVE(0,HMI_Data.StationData.Station16.FCCounts[1]) ,MOVE(0,HMI_Data.StationData.Station16.FCCounts[2]) ,MOVE(0,HMI_Data.StationData.Station16.FCCounts[3]) ,MOVE(0,HMI_Data.StationData.Station16.FCCounts[4]) ];]]>
