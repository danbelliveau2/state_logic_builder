<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Boot Holder To Close]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[4]) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Boot Holder To Open]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S11Control_SM.Status.State[14]) ,XIC(S11Control_SM.Status.State[42]) ] XIO(S11_BootHolderOpen_PRX) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Probe To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[6]) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Probe To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[12]) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[50]) XIC(S11Control_SM.Control.Counter[0].DN) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Alarm[4].Active)RES(S11Control_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For Rotation Cylinder To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[5]) EQ(MachinePartType,MachinePartTypeList[1]) [XIO(S11_RotationExt_PRX) ,XIC(S11_RotationRet_PRX) ] XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[5].Active) XIO(FaultReset_PB) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Rotation Cylinder To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[5]) EQ(MachinePartType,MachinePartTypeList[0]) [XIO(S11_RotationRet_PRX) ,XIC(S11_RotationExt_PRX) ] XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Test Cylinder To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[5]) EQ(MachinePartType,MachinePartTypeList[0]) XIO(S11Control_SM.Control.Timer[3].DN) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Test Cylinder To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[5]) EQ(MachinePartType,MachinePartTypeList[1]) XIO(S11_TestRet_PRX) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[8].Active) XIO(FaultReset_PB) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[7]) XIO(S11Control_SM.Control.Timer[1].DN) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[9].Active) XIO(FaultReset_PB) ]OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S11Control_SM.Status.State[14]) ,XIC(S11Control_SM.Status.State[42]) ] XIO(S11_XAxisRet_PRX) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[10].Active) XIO(FaultReset_PB) ]OTE(Alarm[10].Active);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Waiting For Z Axis To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S11Control_SM.Status.State[7]) XIO(S11Control_SM.Control.Timer[2].DN) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[11].Active) XIO(FaultReset_PB) ]OTE(Alarm[11].Active);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Waiting For Z Axis To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S11Control_SM.Status.State[14]) ,XIC(S11Control_SM.Status.State[42]) ] XIO(S11_ZAxisRet_PRX) XIC(S11Control_SM.Status.TimeoutFlt) ,XIC(Alarm[12].Active) XIO(FaultReset_PB) ]OTE(Alarm[12].Active);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="S11Control_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station 11 Control

**Populate All Probe Comparison Instructions In State Machine At Start Up]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(S11Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(S11Control_SM.Status.State[14]) XIC(S11_BootHolderOpen_PRX) XIC(S11_XAxisRet_PRX) XIC(S11_ZAxisRet_PRX) ,XIC(AlarmActive) ] ]MOVE(2,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Supervisor_SM.Status.State[5])EQ(HMI_Data.StationData.Station11.Status,1)MOVE(0,HMI_Data.StationData.Station11.Status);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S11Control_SM.Status.State[5])[EQ(MachinePartType,MachinePartTypeList[0]) XIC(S11_RotationRet_PRX) XIO(S11_RotationExt_PRX) XIC(S11Control_SM.Control.Timer[3].DN) ,EQ(MachinePartType,MachinePartTypeList[1]) XIC(S11_RotationExt_PRX) XIO(S11_RotationRet_PRX) XIC(S11_TestRet_PRX) ]MOVE(4,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S11Control_SM.Status.State[60]) [XIC(Indexer_SM.Status.State[9]) XIO(StationStatus[11].S11Attempt) [XIO(HMI_Data.Control.Button[147]) XIC(StationStatus[11].S10Success) ,XIC(HMI_Data.Control.Button[147]) [EQ(StationStatus[11].PreOpSelect,4) ,EQ(StationStatus[11].PreOpSelect,5) ,EQ(StationStatus[11].PreOpSelect,6) ,EQ(StationStatus[11].PreOpSelect,9) ] ,XIC(HMI_Data.StationData.Station11.ForceOn) ] ,XIC(HMI_Data.Status.MachineInSC) ] ,XIC(S11Control_SM.Status.State[48]) XIO(StationStatus[11].S11Boot) XIO(S11Control_SM.Control.Counter[1].DN) XIO(HMI_Data.Control.Button[147]) ][MOVE(5,S11Control_SM.Control.StateReg) ,MOVE(1,HMI_Data.StationData.Station11.Status) ,MOVE(0,StationStatus[11].FailureType) ]OTL(StationStatus[11].S11Attempt);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S11Control_SM.Status.State[7])XIC(S11Control_SM.Control.Timer[1].DN)XIC(S11Control_SM.Control.Timer[2].DN)MOVE(6,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S11Control_SM.Status.State[4])XIC(S11Control_SM.Control.Timer[0].DN)XIC(Supervisor_SM.Control.Bit[4])MOVE(7,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S11Control_SM.Status.State[6])LT(S11_BootHeight_IN,162)MOVE(8,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S11Control_SM.Status.State[8])XIC(S11Control_SM.Status.TransitionTimerDone)MOVE(10,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S11Control_SM.Status.State[10])MOVE(12,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S11Control_SM.Status.State[12])GE(S11_BootHeight_IN,S11_BootHeight_Safe)XIC(Supervisor_SM.Control.Bit[4])MOVE(14,S11Control_SM.Control.StateReg);]]>
</Text>
</Rung>
