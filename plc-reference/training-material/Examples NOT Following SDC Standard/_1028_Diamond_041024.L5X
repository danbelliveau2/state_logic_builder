<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Absolute Homing]]>
</Comment>
<Text>
<![CDATA[XIC(Trigger)ONS(Trigger_ONS)MOVE(30,State);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[EP0 Command]]>
</Comment>
<Text>
<![CDATA[EQ(State,30)MOVE(17744,Command)MOVE(40,State);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQ(State,40)XIC(AOI_SCLCommand.In_Progress)MOVE(50,State);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[SP0 Command]]>
</Comment>
<Text>
<![CDATA[EQ(State,50)XIC(AOI_SCLCommand.Done)MOVE(21328,Command)MOVE(60,State);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQ(State,60)XIC(AOI_SCLCommand.In_Progress)MOVE(70,State);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[SA2 Command]]>
</Comment>
<Text>
<![CDATA[EQ(State,70)XIC(AOI_SCLCommand.Done)[EQ(SaveEEPROM,1) MOVE(21313,Command) MOVE(80,State) ,NE(SaveEEPROM,1) MOVE(100,State) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQ(State,80)XIC(AOI_SCLCommand.In_Progress)MOVE(90,State);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQ(State,90)XIC(AOI_SCLCommand.Done)MOVE(100,State);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[NE(State,0)NE(State,100)MOVE(5000,FaultTimer.PRE)TON(FaultTimer,?,?)XIC(FaultTimer.DN)MOVE(110,State);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Done Bit]]>
</Comment>
<Text>
<![CDATA[EQ(State,100)OTE(Done);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Error Bit]]>
</Comment>
<Text>
<![CDATA[EQ(State,110)OTE(Error);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[EQ(Command,21313) MOVE(2,Reg1) ,NE(Command,21313) MOVE(0,Reg1) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Trigger]]>
</Comment>
<Text>
<![CDATA[[EQ(State,20) ,EQ(State,40) ,EQ(State,60) ,EQ(State,80) ]OTE(Execute);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[AMP_SCL_Command_Execute(AOI_SCLCommand,Input,Output,Execute,Command,Reg1,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
