<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Servo Axis Fault]]>
</Comment>
<Text>
<![CDATA[NE(a03S02ZAxis.AxisFault,0)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Loss Of Absolute Position Reference]]>
</Comment>
<Text>
<![CDATA[XIC(AOI_s03S02ZAxis_EIP.ComOK)XIO(a03S02ZAxis.AxisHomedStatus)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Z Axis Move To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S02Control_SM.Status.State[4]) ,XIC(S02Control_SM.Status.State[8]) ,XIC(S02Control_SM.Status.State[14]) ,XIC(S02Control_SM.Status.State[18]) ,XIC(S02Control_SM.Status.State[22]) ,XIC(S02Control_SM.Status.State[26]) ,XIC(S02Control_SM.Status.State[40]) ,XIC(S02Control_SM.Status.State[46]) ] XIC(S02Control_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Gripper Closed On Startup - Remove Part]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S02Control_SM.Status.State[2]) XIC(CycleStartLatch) ,XIC(S02Control_SM.Status.State[42]) ] XIC(S02Control_SM.Control.Timer[1].DN) TON(S02Control_SM.Control.Timer[2],?,?) XIC(S02Control_SM.Control.Timer[2].DN) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S02Control_SM.Status.State[12]) ,XIC(S02Control_SM.Status.State[49]) ] XIC(S02Control_SM.Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S02Control_SM.Status.State[20]) ,XIC(S02Control_SM.Status.State[42]) ] XIC(S02Control_SM.Status.TimeoutFlt) ,XIC(Alarm[5].Active) XIO(FaultReset_PB) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Sleeve Extended Sensor NOT Off]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S02Control_SM.Status.State[18])ONS(S02Control_SM.Control.OS[0])XIC(S02_BushingSleeveExt_PRX)OTL(S02Control_SM.Control.Bit[4]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S02Control_SM.Status.State[50]) XIC(S02Control_SM.Control.Bit[4]) ,XIC(Alarm[6].Active) XIO(FaultReset_PB) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Alarm[6].Active)OTU(S02Control_SM.Control.Bit[4]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Bushing X Axis NOT In Safe Position]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S02Control_SM.Status.State[47]) XIC(S02Control_SM.Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="S02Control_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station 2 Control]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(S02Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(S02Control_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,S02Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[4]) ,XIC(Supervisor_SM.Status.State[5]) XIC(HMI_Data.Status.MachineInSC) [XIC(S02Control_SM.Status.State[26]) XIC(a03S02ZAxis_MAM.PC) XIC(AOI_a03S02ZAxis_RC1.In_Range) ,XIC(AlarmActive) ] ]MOVE(2,S02Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,S02Control_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Supervisor_SM.Status.State[5])EQ(HMI_Data.StationData.Station2.Status,1)MOVE(0,HMI_Data.StationData.Station2.Status);]]>
</Text>
</Rung>
