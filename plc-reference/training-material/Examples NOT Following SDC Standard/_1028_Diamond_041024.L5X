<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S02StepFeeder_SM.Status.State[2])XIC(CycleStartLatch)[XIC(HMI_Data.StationData.Station2.Lockout) ,XIC(HMI_Data.Control.Button[146]) ,XIC(HMI_Data.Control.Button[147]) ,NE(MachinePartType,MachinePartTypeList[1]) ]MOVE(61,S02StepFeeder_SM.Control.StateReg);]]>
