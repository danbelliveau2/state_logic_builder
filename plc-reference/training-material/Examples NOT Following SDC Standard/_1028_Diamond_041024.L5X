<![CDATA[XIC(MachineBasic.AlwaysOff)[XIC(Supervisor_SM.Status.State[5]) XIC(A04Control_SM.Status.State[4]) XIO(HMI_Data.Status.MachineInSC) XIO(StationStatus[34].S13Attempt) XIO(StationStatus[34].S1Success) XIO(AOI_A04_PartPresent_PE.Off) ,XIC(Alarm[7].Active) XIO(FaultReset_PB) ]OTE(Alarm[7].Active);]]>
