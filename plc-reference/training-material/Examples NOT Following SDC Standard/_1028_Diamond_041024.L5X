<Comments>
<Comment Operand=".STATUS.STATE[0]">
<![CDATA[Station 11 Control Not Running]]>
</Comment>
<Comment Operand=".STATUS.STATE[2]">
<![CDATA[Station 11 Control Automatic Mode]]>
</Comment>
<Comment Operand=".STATUS.STATE[4]">
<![CDATA[Station 11 Control Close Boot Holder]]>
</Comment>
<Comment Operand=".STATUS.STATE[5]">
<![CDATA[Station 11 Check Rotation & Test Select Cylinders]]>
</Comment>
<Comment Operand=".STATUS.STATE[6]">
<![CDATA[Station 11 Extend Height Check Probe]]>
</Comment>
<Comment Operand=".STATUS.STATE[7]">
<![CDATA[Station 11 Extend X & Z Axes]]>
</Comment>
<Comment Operand=".STATUS.STATE[8]">
<![CDATA[Station 11 Delay To Check Height]]>
</Comment>
<Comment Operand=".STATUS.STATE[10]">
<![CDATA[Station 11 Control Check Height & Continuity]]>
</Comment>
<Comment Operand=".STATUS.STATE[12]">
<![CDATA[Station 11 Retract Height Check Probe]]>
</Comment>
<Comment Operand=".STATUS.STATE[14]">
<![CDATA[Station 11 Open Boot Holder & Retract X & Z Axes]]>
</Comment>
<Comment Operand=".STATUS.STATE[40]">
<![CDATA[Station 11 Initialize Retract Probe]]>
</Comment>
<Comment Operand=".STATUS.STATE[42]">
<![CDATA[Station 11 Initialize Retract All Cylinders]]>
</Comment>
<Comment Operand=".STATUS.STATE[48]">
<![CDATA[Station 11 Retry Decision]]>
</Comment>
<Comment Operand=".STATUS.STATE[50]">
<![CDATA[Station 11 Control Cycle Complete]]>
</Comment>
<Comment Operand=".STATUS.STATE[60]">
<![CDATA[Station 11 Control Wait For Index Complete]]>
</Comment>
<Comment Operand=".STATUS.STATE[61]">
<![CDATA[Station 11 Control Lock Out]]>
</Comment>
<Comment Operand=".STATUS.STATE[62]">
<![CDATA[Station 11 Control Cycle Stop]]>
</Comment>
<Comment Operand=".STATUS.STATE[63]">
<![CDATA[Station 11 Control Faulted]]>
</Comment>
<Comment Operand=".CONTROL.COUNTER[0]">
<![CDATA[Consecutive Counter]]>
</Comment>
<Comment Operand=".CONTROL.COUNTER[1]">
<![CDATA[Retry Counter]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[0]">
<![CDATA[Boot Holder Closed Delay Timer]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[1]">
<![CDATA[X Axis Extended Delay Timer]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[2]">
<![CDATA[Z Axis Extended Delay Timer]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[3]">
<![CDATA[Test Cylinder Extended Delay Timer]]>
</Comment>
<Comment Operand=".CONTROL.TIMER[20]">
<![CDATA[Cycle Timer]]>
</Comment>
<Comment Operand=".CONTROL.BIT[0]">
<![CDATA[Manual Interlock]]>
</Comment>
<Comment Operand=".CONTROL.BIT[1]">
<![CDATA[Rotation Cylinder Manual Extend Interlock]]>
</Comment>
<Comment Operand=".CONTROL.BIT[2]">
<![CDATA[Rotation Cylinder Manual Retract Interlock]]>
</Comment>
<Comment Operand=".CONTROL.BIT[3]">
<![CDATA[Rotation Cylinder Auto Extend]]>
</Comment>
<Comment Operand=".CONTROL.BIT[4]">
<![CDATA[Rotation Cylinder Auto Retract]]>
</Comment>
<Comment Operand=".CONTROL.BIT[5]">
<![CDATA[X Axis Manual Extend Interlock]]>
</Comment>
<Comment Operand=".CONTROL.BIT[6]">
<![CDATA[Z Axis Manual Extend Interlock]]>
</Comment>
<Comment Operand=".CONTROL.BIT[7]">
<![CDATA[Test Cylinder Manual Extend Interlock]]>
</Comment>
<Comment Operand=".CONTROL.BIT[8]">
<![CDATA[Test Cylinder Manual Retract Interlock]]>
</Comment>
<Comment Operand=".CONTROL.BIT[9]">
<![CDATA[Test Cylinder Auto Extend]]>
</Comment>
<Comment Operand=".CONTROL.BIT[10]">
<![CDATA[Test Cylinder Auto Retract]]>
</Comment>
<Comment Operand=".CONTROL.BIT[20]">
<![CDATA[Station Running]]>
</Comment>
</Comments>
