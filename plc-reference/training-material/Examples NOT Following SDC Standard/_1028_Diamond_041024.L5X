<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Trigger Ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S01Barcode_SM.Status.State[4]) XIC(S01Barcode_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Results Valid]]>
</Comment>
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOff)[XIC(Supervisor_SM.Status.State[5]) XIC(S01Barcode_SM.Status.State[6]) XIC(S01Barcode_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Decode Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S01Barcode_SM.Status.State[6]) XIC(S01Barcode_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Waiting For Results Ack]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S01Barcode_SM.Status.State[8]) XIC(S01Barcode_SM.Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset_PB) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[3 Failures In A Row]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S01Barcode_SM.Status.State[50]) XIC(S01Barcode_SM.Control.Counter[0].DN) ,XIC(Alarm[4].Active) XIO(FaultReset_PB) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Alarm[4].Active)RES(S01Barcode_SM.Control.Counter[0]);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="S01Barcode_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Station 2 Control]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(S01Barcode_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOVE(2,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S01Barcode_SM.Status.State[60]) XIC(S01Control_SM.Status.State[13]) ,XIC(S01Barcode_SM.Status.State[48]) XIO(StationStatus[1].S1Success) XIO(S01Barcode_SM.Control.Counter[1].DN) ]MOVE(4,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[4])XIC(S01Barcode_SM.Status.TransitionTimerDone)XIO(c01S01Barcode_IN.Data[0].0)XIO(c01S01Barcode_IN.Data[1].0)MOVE(6,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[6])XIC(c01S01Barcode_IN.Data[2].0)MOVE(7,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[7])XIC(S01Barcode_SM.Status.TransitionTimerDone)MOVE(8,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S01Barcode_SM.Status.State[8]) XIO(c01S01Barcode_IN.Data[2].0) ,XIC(S01Barcode_SM.Status.State[6]) TON(S01Barcode_SM.Control.Timer[1],?,?) XIC(S01Barcode_SM.Control.Timer[1].DN) ]MOVE(48,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[48])[XIC(StationStatus[1].S1Success) ,XIC(S01Barcode_SM.Control.Counter[1].DN) ]MOVE(50,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S01Barcode_SM.Status.State[2]) XIC(CycleStartLatch) ,XIC(S01Barcode_SM.Status.State[50]) ]MOVE(60,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[2])XIC(CycleStartLatch)[XIC(HMI_Data.StationData.Station1.BypassA) ,XIC(HMI_Data.Control.Button[147]) ]MOVE(61,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S01Barcode_SM.Status.State[60]) ,XIC(S01Barcode_SM.Status.State[61]) ][XIC(S01Control_SM.Status.State[62]) ,XIC(S01Control_SM.Status.State[63]) ]MOVE(62,S01Barcode_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(MachineRunning)XIC(AlarmActive)[MOVE(63,S01Barcode_SM.Control.StateReg) ,EQ(StationStatus[1].FailureType,0) MOVE(100,StationStatus[1].FailureType) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_S01Barcode_SM,S01Barcode_SM);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Station Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[61])XIC(StationStatus[1].S1Attempt)OTL(StationStatus[1].S1Success);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Camera Control]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S01Barcode_SM.Status.State[6]) ,XIC(Supervisor_SM.Status.State[3]) XIC(HMI_Data.Control.Button[154]) [ONS(S01Barcode_SM.Control.OS[0]) ,XIC(c01S01Barcode_OUT.Data[1].0) XIO(c01S01Barcode_IN.Data[2].0) XIO(c01S01Barcode_IN.Data[3].0) ] ]OTE(c01S01Barcode_OUT.Data[1].0);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S01Barcode_SM.Status.State[8]) ,XIC(S01Barcode_SM.Status.State[4]) XIC(c01S01Barcode_IN.Data[2].0) ] ,XIC(Supervisor_SM.Status.State[3]) XIC(c01S01Barcode_IN.Data[2].0) TON(S01Barcode_SM.Control.Timer[0],?,?) LIMIT(250,S01Barcode_SM.Control.Timer[0].ACC,1000) ]OTE(c01S01Barcode_OUT.Data[2].0);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Store Results]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S01Barcode_SM.Status.State[7]) ,XIC(c01S01Barcode_IN.Data[2].0) ONS(S01Barcode_SM.Control.OS[3]) XIC(Supervisor_SM.Status.State[3]) ]MOVE(c01S01Barcode_IN.Data[42],c01S01Result.LEN)COP(c01S01Barcode_IN.Data[44],c01S01Result.DATA[0],c01S01Barcode_IN.Data[42]);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Check Results/Retry Count

**If read string is not empty then barcode was read]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[48])ADD(HMI_Data.StationData.Station1.Retry,1,S01Barcode_SM.Control.Counter[1].PRE)[GT(c01S01Barcode_IN.Data[42],20) MOVE(c01S01Result,StationStatus[1].S01DataMatrix) OTL(StationStatus[1].S1Success) ,LE(c01S01Barcode_IN.Data[42],20) CTU(S01Barcode_SM.Control.Counter[1],?,?) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[50])MOVE(HMI_Data.StationData.Station1.ConsecFail,S01Barcode_SM.Control.Counter[0].PRE)[XIC(StationStatus[1].S1Success) RES(S01Barcode_SM.Control.Counter[0]) ,XIO(StationStatus[1].S1Success) [CTU(S01Barcode_SM.Control.Counter[0],?,?) ,MOVE(101,StationStatus[1].FailureType) ] ,RES(S01Barcode_SM.Control.Counter[1]) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Failure Type Counts]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S01Barcode_SM.Status.State[50])[EQ(StationStatus[1].FailureType,100) ADD(HMI_Data.StationData.Station1.FCCounts[0],1,HMI_Data.StationData.Station1.FCCounts[0]) ,EQ(StationStatus[1].FailureType,101) ADD(HMI_Data.StationData.Station1.FCCounts[1],1,HMI_Data.StationData.Station1.FCCounts[1]) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(ResetFCCounts)[MOVE(0,HMI_Data.StationData.Station1.FCCounts[0]) ,MOVE(0,HMI_Data.StationData.Station1.FCCounts[1]) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S01Barcode_SM.Status.State[4]) MOVE(250,S01Barcode_SM.Control.TransitionTime) ,XIC(S01Barcode_SM.Status.State[7]) MOVE(100,S01Barcode_SM.Control.TransitionTime) ]OTE(S01Barcode_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(S01Barcode_SM.Status.State[4]) ,XIC(S01Barcode_SM.Status.State[8]) ]MOVE(1000,S01Barcode_SM.Control.FaultTime)OTE(S01Barcode_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
