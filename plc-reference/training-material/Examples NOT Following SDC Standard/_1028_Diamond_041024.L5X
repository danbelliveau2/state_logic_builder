<Routines>
<Routine Name="FaultsWarnings" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FAULT LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[GE(ConsecutiveFailures,4) ,XIC(Fault[0].Active) XIO(FaultReset_PB) ]XIO(Bypass)[OTE(Fault[0].Active) ,MOVE(0,ConsecutiveFailures) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WARNING LOGIC]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(Handshake.HeartbeatTimeout) XIO(Bypass) OTE(Warning[0].Active) ,XIC(Warning[0].Active) XIO(FaultReset_PB) [MOVE(0,Handshake.HeartbeatRetryCount) ,OTU(Handshake.HeartbeatTimeout) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Handshake.ResultTimeout)XIO(Bypass)OTE(Warning[1].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Handshake.FailureResult)XIO(Bypass)OTE(Warning[2].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[ALARM HANDLERS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Fault,\Alarms.Active,\Alarms.History,CPUDateTime,FaultActive);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramWarningHandler,\Alarms.ProgramID,Warning,\Alarms.Active,\Alarms.History,CPUDateTime,WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Handshake" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Copy Data For Data Logging]]>
</Comment>
<Text>
<![CDATA[[XIC(r05Packout_OUT.UserOut[0].1) ,XIC(r05Packout_OUT.UserOut[0].3) ,XIC(r05Packout_OUT.UserOut[0].4) ]ONS(r05Packout_SM.Control.OS[4])COP(StationStatus[27],NewData,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Logic,0)JSR(FaultsWarnings,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Data logging handshaking with Ignition.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Bypass)ONS(OneShot.0)[[MOVE(0,ConsecutiveFailures) ,MOVE(0,Handshake.HeartbeatRetryCount) ] ,[OTU(Handshake.ResultTimeout) ,OTU(Handshake.HeartbeatTimeout) ,OTU(Handshake.SuccessResult) ,OTU(Handshake.FailureResult) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[New trigger sets up timers, set the trigger for Ignition to see, and resets all results.

If the echo tag isn't on, something's wrong.
Ignition won't trigger logging without a false-to-true transition
so the trigger must be confirmed to be off before we turn in back on.]]>
</Comment>
<Text>
<![CDATA[XIC(Handshake.Trigger)ONS(OneShot.1)[MOVE(Handshake.TransactionID,Handshake.TransactionIDSaved) ,MOVE(Handshake.ResultTimeoutPreset,Handshake.ResultTimer.PRE) ,[OTU(Handshake.ResultTimeout) ,OTU(Handshake.HeartbeatTimeout) ,OTU(Handshake.SuccessResult) ,OTU(Handshake.FailureResult) ,OTL(Handshake.WaitingForResult) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
Heartbeat and timeouts]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(Handshake.HeartbeatIgnition)ONS(OneShot.3)[OTL(Handshake.HeartbeatPLC) ,MOVE(0,Handshake.HeartbeatRetryCount) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Handshake.HeartbeatIgnition)ONS(OneShot.4)[OTU(Handshake.HeartbeatPLC) ,MOVE(0,Handshake.HeartbeatRetryCount) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Handshake.HeartbeatPLC)[TON(Handshake.HeartbeatOnTImer,?,?) ,XIC(Handshake.HeartbeatOnTImer.DN) [XIO(Handshake.HeartbeatTimeout) ADD(Handshake.HeartbeatRetryCount,1,Handshake.HeartbeatRetryCount) ,[GE(Handshake.HeartbeatRetryCount,4) OTL(Handshake.HeartbeatTimeout) ,LT(Handshake.HeartbeatRetryCount,4) OTU(Handshake.HeartbeatPLC) ] ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(Handshake.HeartbeatPLC)[TON(Handshake.HeartbeatOffTimer,?,?) ,XIC(Handshake.HeartbeatOffTimer.DN) [XIO(Handshake.HeartbeatTimeout) ADD(Handshake.HeartbeatRetryCount,1,Handshake.HeartbeatRetryCount) ,[GE(Handshake.HeartbeatRetryCount,4) OTL(Handshake.HeartbeatTimeout) ,LT(Handshake.HeartbeatRetryCount,4) OTL(Handshake.HeartbeatPLC) ] ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Handshake.Trigger)[TON(Handshake.ResultTimer,?,?) ,XIC(Handshake.ResultTimer.DN) [OTL(Handshake.ResultTimeout) ,OTU(Handshake.Trigger) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Result or timeout]]>
</Comment>
<Text>
<![CDATA[[XIC(Handshake.SuccessResult) ,XIC(Handshake.FailureResult) ,XIC(Handshake.HeartbeatTimeout) ,XIC(Handshake.ResultTimeout) ]ONS(OneShot.2)OTU(Handshake.Trigger);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Busy signal can be stuck on if code faulted.]]>
</Comment>
<Text>
<![CDATA[XIC(Handshake.ResultTimeout)ONS(OneShot.5)OTU(Handshake.IgnitionBusy);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//This routine handles keeping a FIFO Buffer (Queue) of data if the network is down and logging is not occurring.]]>
</Line>
<Line Number="1">
<![CDATA[//The buffer also handles simultaneous data in the case of reject and good stations.]]>
</Line>
<Line Number="2">
<![CDATA[//In that case, good should write to NewData and a NewDataReject# tag should be created for each]]>
</Line>
<Line Number="3">
<![CDATA[//reject station to write to.]]>
</Line>
<Line Number="4">
<![CDATA[SIZE(Buffer,0,BufferArraySize);]]>
</Line>
<Line Number="5">
<![CDATA[ArraySizeMinusOne := BufferArraySize - 1; //COP instruction length parameter can't be an expression, so math is done here.]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[if (FaultReset_PB OR CalcDequeueReq) then]]>
</Line>
<Line Number="9">
<![CDATA[	//Handle initializing BufferDequeuPos and occasionally brute-force making sure it's accurate.]]>
</Line>
<Line Number="10">
<![CDATA[	//This is here striclty for special cases like code download.]]>
</Line>
<Line Number="11">
<![CDATA[	//Other code that adds or removes from Buffer[] must update BufferDequeuPos]]>
</Line>
<Line Number="12">
<![CDATA[	CalcDequeueReq := 0;]]>
</Line>
<Line Number="13">
<![CDATA[	BufferDequeuPos := ArraySizeMinusOne;]]>
</Line>
<Line Number="14">
<![CDATA[	for i := 0 to ArraySizeMinusOne by 1 do]]>
</Line>
<Line Number="15">
<![CDATA[		if (Buffer[i].S1Attempt) then]]>
</Line>
<Line Number="16">
<![CDATA[			exit; //exit for loop]]>
</Line>
<Line Number="17">
<![CDATA[		end_if;]]>
</Line>
<Line Number="18">
<![CDATA[	end_for;]]>
</Line>
<Line Number="19">
<![CDATA[	BufferDequeuPos := i; //Either position has data and i is 0 to ArraySizeMinusOne or no data and i is BufferArraySize.]]>
</Line>
<Line Number="20">
<![CDATA[end_if;]]>
</Line>
<Line Number="21">
<![CDATA[			]]>
</Line>
<Line Number="22">
<![CDATA[//Move new data into the Buffer.]]>
</Line>
<Line Number="23">
<![CDATA[//Add one of these code blocks for each NewData tag.]]>
</Line>
<Line Number="24">
<![CDATA[//i.e. NewDataReject1, NewDataReject2, etc.]]>
</Line>
<Line Number="25">
<![CDATA[NewData_Exists := (NewData.S1Attempt AND (NewData.FailureType > 0 OR NewData.VisionResults.S23BotFileName.LEN > 0 OR NewData.VisionResults.S23SideFileName.LEN > 0 OR NewData.VisionResults.S24FileName.LEN > 0 OR NewData.VisionResults.S27FileName.LEN > 0 OR NewData.VisionResults.r05FileName.LEN > 0));]]>
</Line>
<Line Number="26">
<![CDATA[if (NewData_Exists) then]]>
</Line>
<Line Number="27">
<![CDATA[	//New data detected]]>
</Line>
<Line Number="28">
<![CDATA[	COP(Buffer[1],Buffer[0],ArraySizeMinusOne); //Shift]]>
</Line>
<Line Number="29">
<![CDATA[	COP(NewData,Buffer[ArraySizeMinusOne],1); //Enqueue]]>
</Line>
<Line Number="30">
<![CDATA[	COP(ZeroLoggingData,NewData,1);]]>
</Line>
<Line Number="31">
<![CDATA[	if (BufferDequeuPos > 0) then]]>
</Line>
<Line Number="32">
<![CDATA[		//Dequeue position moves if the queue isn't already full]]>
</Line>
<Line Number="33">
<![CDATA[		BufferDequeuPos := BufferDequeuPos - 1;]]>
</Line>
<Line Number="34">
<![CDATA[	end_if;]]>
</Line>
<Line Number="35">
<![CDATA[else]]>
</Line>
<Line Number="36">
<![CDATA[	//Data was empty ]]>
</Line>
<Line Number="37">
<![CDATA[	COP(ZeroLoggingData,NewData,1);]]>
</Line>
<Line Number="38">
<![CDATA[end_if;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[//Move data from the Buffer to the Data Logging UDT]]>
</Line>
<Line Number="41">
<![CDATA[Data_Exists := (Data.S1Attempt AND (Data.FailureType > 0 OR Data.VisionResults.S23BotFileName.LEN > 0 OR Data.VisionResults.S23SideFileName.LEN > 0 OR Data.VisionResults.S24FileName.LEN > 0 OR Data.VisionResults.S27FileName.LEN > 0 OR Data.VisionResults.r05FileName.LEN > 0));]]>
</Line>
<Line Number="42">
<![CDATA[if (NOT Data_Exists AND Handshake.IgnitionReady AND NOT Handshake.IgnitionBusy AND NOT Handshake.HeartbeatTimeout AND NOT Fault[0].Active AND NOT Bypass) then]]>
</Line>
<Line Number="43">
<![CDATA[	//Data logging UDT is available and no faults.]]>
</Line>
<Line Number="44">
<![CDATA[	if ((BufferDequeuPos >= 0) AND (BufferDequeuPos < BufferArraySize)) then]]>
</Line>
<Line Number="45">
<![CDATA[		//There's something waiting in the buffer to log]]>
</Line>
<Line Number="46">
<![CDATA[		Buffer_Exists := (Buffer[BufferDequeuPos].S1Attempt AND (Buffer[BufferDequeuPos].FailureType > 0 OR Buffer[BufferDequeuPos].VisionResults.S23BotFileName.LEN > 0 OR Buffer[BufferDequeuPos].VisionResults.S23SideFileName.LEN > 0 OR Buffer[BufferDequeuPos].VisionResults.S24FileName.LEN > 0 OR Buffer[BufferDequeuPos].VisionResults.S27FileName.LEN > 0 OR Buffer[BufferDequeuPos].VisionResults.r05FileName.LEN > 0));]]>
</Line>
<Line Number="47">
<![CDATA[		if (Buffer_Exists) then]]>
</Line>
<Line Number="48">
<![CDATA[			Echo_IsEmpty := (Echo.FailureType = 0 AND Echo.VisionResults.S23BotFileName.LEN = 0 AND Echo.VisionResults.S23SideFileName.LEN = 0 AND Echo.VisionResults.S24FileName.LEN = 0 AND Echo.VisionResults.S27FileName.LEN = 0 AND Echo.VisionResults.r05FileName.LEN = 0);]]>
</Line>
<Line Number="49">
<![CDATA[			if (Echo_IsEmpty) then]]>
</Line>
<Line Number="50">
<![CDATA[				//Ignition may be ready for new data if it's seen the Trigger turn off and echoes are clear.]]>
</Line>
<Line Number="51">
<![CDATA[				COP(Buffer[BufferDequeuPos],Data,1); //Dequeue]]>
</Line>
<Line Number="52">
<![CDATA[				COP(ZeroLoggingData,Buffer[BufferDequeuPos],1);]]>
</Line>
<Line Number="53">
<![CDATA[				BufferDequeuPos := BufferDequeuPos + 1;]]>
</Line>
<Line Number="54">
<![CDATA[			else]]>
</Line>
<Line Number="55">
<![CDATA[				//Trigger was left on?]]>
</Line>
<Line Number="56">
<![CDATA[				//because Ignition isn't running, network problem, it's broken, crap code, etc....]]>
</Line>
<Line Number="57">
<![CDATA[				Handshake.Trigger := 0;]]>
</Line>
<Line Number="58">
<![CDATA[				//TODO: Fault?]]>
</Line>
<Line Number="59">
<![CDATA[			end_if;]]>
</Line>
<Line Number="60">
<![CDATA[		else]]>
</Line>
<Line Number="61">
<![CDATA[			//TODO: Figure out why I'm dequeuing empty data when I shouldn't be.]]>
</Line>
<Line Number="62">
<![CDATA[			//Could be parts with a FailureType but no Filenames. <- added FailureType 2022-03-24]]>
</Line>
<Line Number="63">
<![CDATA[			CountEmptyDequeueAttempts := CountEmptyDequeueAttempts + 1;]]>
</Line>
<Line Number="64">
<![CDATA[			CalcDequeueReq := 1;]]>
</Line>
<Line Number="65">
<![CDATA[		end_if;]]>
</Line>
<Line Number="66">
<![CDATA[	end_if;]]>
</Line>
<Line Number="67">
<![CDATA[end_if;	]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[Data_Exists := (Data.S1Attempt AND (Data.FailureType > 0 OR Data.VisionResults.S23BotFileName.LEN > 0 OR Data.VisionResults.S23SideFileName.LEN > 0 OR Data.VisionResults.S24FileName.LEN > 0 OR Data.VisionResults.S27FileName.LEN > 0 OR Data.VisionResults.r05FileName.LEN > 0));]]>
</Line>
<Line Number="70">
<![CDATA[if (Data_Exists AND Handshake.IgnitionReady AND NOT Handshake.IgnitionBusy AND NOT Handshake.HeartbeatTimeout AND NOT Handshake.Trigger) then]]>
</Line>
<Line Number="71">
<![CDATA[	//Waiting for echo confirmation that Ignition has up-to-date data.]]>
</Line>
<Line Number="72">
<![CDATA[	Echo_Updated := (Data.FailureType = Echo.FailureType AND Data.VisionResults.S23BotFileName = Echo.VisionResults.S23BotFileName AND Data.VisionResults.S23SideFileName = Echo.VisionResults.S23SideFileName AND Data.VisionResults.S24FileName = Echo.VisionResults.S24FileName AND Data.VisionResults.S27FileName = Echo.VisionResults.S27FileName AND Data.VisionResults.r05FileName = Echo.VisionResults.r05FileName);]]>
</Line>
<Line Number="73">
<![CDATA[	if (Echo_Updated) then]]>
</Line>
<Line Number="74">
<![CDATA[		//Confirmed Ignition has up-to-date data.]]>
</Line>
<Line Number="75">
<![CDATA[		Handshake.Trigger := 1; //Trigger Ignition data logging.]]>
</Line>
<Line Number="76">
<![CDATA[		Handshake.WaitingForResult := 0; //Handshake routine will set THIS. Resetting it here ensures the following "if" statement doesn't scan prematurely.]]>
</Line>
<Line Number="77">
<![CDATA[	else]]>
</Line>
<Line Number="78">
<![CDATA[		//TODO: Timeout fault?]]>
</Line>
<Line Number="79">
<![CDATA[		CountEchoDataNotSync := CountEchoDataNotSync + 1;]]>
</Line>
<Line Number="80">
<![CDATA[	end_if;]]>
</Line>
<Line Number="81">
<![CDATA[end_if;]]>
</Line>
<Line Number="82">
<![CDATA[]]>
</Line>
<Line Number="83">
<![CDATA[//Check results.]]>
</Line>
<Line Number="84">
<![CDATA[Data_Exists := (Data.S1Attempt AND (Data.FailureType > 0 OR Data.VisionResults.S23BotFileName.LEN > 0 OR Data.VisionResults.S23SideFileName.LEN > 0 OR Data.VisionResults.S24FileName.LEN > 0 OR Data.VisionResults.S27FileName.LEN > 0 OR Data.VisionResults.r05FileName.LEN > 0));]]>
</Line>
<Line Number="85">
<![CDATA[if (Data_Exists AND Handshake.WaitingForResult) then]]>
</Line>
<Line Number="86">
<![CDATA[	if (Handshake.SuccessResult) then]]>
</Line>
<Line Number="87">
<![CDATA[		Handshake.WaitingForResult := 0;]]>
</Line>
<Line Number="88">
<![CDATA[		ConsecutiveFailures := 0;]]>
</Line>
<Line Number="89">
<![CDATA[		COP(ZeroLoggingData,Data,1);]]>
</Line>
<Line Number="90">
<![CDATA[	elsif (Handshake.HeartbeatTimeout OR Handshake.ResultTimeout OR Handshake.FailureResult) then]]>
</Line>
<Line Number="91">
<![CDATA[		//Data is returned to the buffer if the buffer isn't full.]]>
</Line>
<Line Number="92">
<![CDATA[		//ConsecutiveFailures is used to prevent retrying too many times.]]>
</Line>
<Line Number="93">
<![CDATA[		Handshake.WaitingForResult := 0;]]>
</Line>
<Line Number="94">
<![CDATA[		ConsecutiveFailures := ConsecutiveFailures + 1;]]>
</Line>
<Line Number="95">
<![CDATA[		if ((BufferDequeuPos > 0) AND (BufferDequeuPos <= BufferArraySize)) then]]>
</Line>
<Line Number="96">
<![CDATA[			//If dequeue position is 0, buffer is now full. This data is lost.]]>
</Line>
<Line Number="97">
<![CDATA[			BufferDequeuPos := BufferDequeuPos - 1;]]>
</Line>
<Line Number="98">
<![CDATA[			COP(Data,Buffer[BufferDequeuPos],1); //Put data back in the buffer]]>
</Line>
<Line Number="99">
<![CDATA[		end_if;]]>
</Line>
<Line Number="100">
<![CDATA[]]>
</Line>
<Line Number="101">
<![CDATA[		//Clear the Data tag. This will cause the next data to dequeue from the buffer and trigger logging again.]]>
</Line>
<Line Number="102">
<![CDATA[		COP(ZeroLoggingData,Data,1);]]>
</Line>
<Line Number="103">
<![CDATA[	end_if;]]>
</Line>
<Line Number="104">
<![CDATA[end_if;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
