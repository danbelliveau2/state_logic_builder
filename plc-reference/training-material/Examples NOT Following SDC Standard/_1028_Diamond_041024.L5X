<Routines>
<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Pallet Shift To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03OutShift_SM.Status.State[4]) [XIO(r03_OutPalletShiftExt_PRX) ,XIC(r03_OutPalletShiftRet_PRX) ] XIC(r03OutShift_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Pallet At Outgoing To Turn Off]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03OutShift_SM.Status.State[4]) XIO(AOI_r03_PalletAtOut_PE.Off) XIC(r03OutShift_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Pallet Shift To Retract]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r03OutShift_SM.Status.State[6]) XIC(r03OutShift_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(MachineBasic.AlwaysOn)ProgramAlarmHandler(AOI_ProgramFaultHandler,\Alarms.ProgramID,Alarm,\Alarms.Active,\Alarms.History,CPUDateTime,AlarmActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="r03OutShift_SM_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Coil Load Outgoing Box Shift Control State Machine]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(r03OutShift_SM.Status.State[0])XIC(MainAssemblyOK)MOVE(1,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[4])MOVE(2,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[3])MOVE(3,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03OutShift_SM.Status.State[60])XIC(r03BoxShift_SM.Status.State[60])XIC(AOI_r03_PalletAtOut_PE.On)MOVE(4,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03OutShift_SM.Status.State[4]) XIC(r03_OutPalletShiftExt_PRX) XIO(r03_OutPalletShiftRet_PRX) XIC(AOI_r03_PalletAtOut_PE.Off) ,XIC(r03OutShift_SM.Status.State[2]) XIC(CycleStartLatch) [XIO(r03_OutPalletShiftRet_PRX) ,XIC(r03_OutPalletShiftExt_PRX) ] ]MOVE(6,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03OutShift_SM.Status.State[6])XIC(r03_OutPalletShiftRet_PRX)XIO(r03_OutPalletShiftExt_PRX)MOVE(8,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03OutShift_SM.Status.State[2]) XIC(CycleStartLatch) XIC(r03_OutPalletShiftRet_PRX) XIO(r03_OutPalletShiftExt_PRX) ,XIC(r03OutShift_SM.Status.State[8]) XIC(r03OutShift_SM.Status.TransitionTimerDone) ]MOVE(60,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03OutShift_SM.Status.State[2])XIC(CycleStartLatch)[XIC(HMI_Data.StationData.Station1.Lockout) ,XIC(HMI_Data.Control.Button[170]) ]MOVE(61,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03OutShift_SM.Status.State[60]) ,XIC(r03OutShift_SM.Status.State[61]) ][XIC(r03CoilLoad_SM.Status.State[62]) ,XIC(r03CoilLoad_SM.Status.State[63]) ]MOVE(62,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(MachineRunning)XIC(AlarmActive)MOVE(63,r03OutShift_SM.Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[State_Engine_64Max_v3_5(AOI_r03OutShift_SM,r03OutShift_SM);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Cylinder Control]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[3]) XIC(HMI_Data.Control.Button[113]) ,XIC(Supervisor_SM.Status.State[5]) XIC(r03OutShift_SM.Status.State[4]) ,XIC(r03_OutPalletShiftExt_SOL) [XIC(Supervisor_SM.Status.State[3]) XIO(HMI_Data.Control.Button[114]) ,XIO(Supervisor_SM.Status.State[3]) XIO(r03OutShift_SM.Status.State[6]) ] ]OTE(r03_OutPalletShiftExt_SOL);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[3]) XIC(HMI_Data.Control.Button[114]) ,XIC(Supervisor_SM.Status.State[5]) XIC(r03OutShift_SM.Status.State[6]) ,XIC(r03_OutPalletShiftRet_SOL) [XIC(Supervisor_SM.Status.State[3]) XIO(HMI_Data.Control.Button[113]) ,XIO(Supervisor_SM.Status.State[3]) XIO(r03OutShift_SM.Status.State[4]) ] ]OTE(r03_OutPalletShiftRet_SOL);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Conveyor]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[3]) [XIC(HMI_Data.Control.Button[115]) ,XIC(r03CoilLoad_OUT.UserOut[1].2) XIO(HMI_Data.Control.Button[116]) ] ,XIC(Supervisor_SM.Status.State[5]) XIC(r03OutShift_SM.Status.State[8]) ]OTE(r03CoilLoad_OUT.UserOut[1].2);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(r03OutShift_SM.Status.State[8])MOVE(5000,r03OutShift_SM.Control.TransitionTime)OTE(r03OutShift_SM.Control.EnaTransitionTimer);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Fault Timers]]>
</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(r03OutShift_SM.Status.State[4]) ,XIC(r03OutShift_SM.Status.State[6]) ]MOVE(3000,r03OutShift_SM.Control.FaultTime)OTE(r03OutShift_SM.Control.EnaFaultDetect);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[JSR(Alarms_SUB,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
