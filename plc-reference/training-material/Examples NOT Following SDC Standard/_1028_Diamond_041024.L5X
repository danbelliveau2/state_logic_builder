<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S24Control_SM.Status.State[50])[EQ(StationStatus[24].FailureType,130) ADD(HMI_Data.StationData.Station24.FCCounts[0],1,HMI_Data.StationData.Station24.FCCounts[0]) ,EQ(StationStatus[24].FailureType,131) ADD(HMI_Data.StationData.Station24.FCCounts[1],1,HMI_Data.StationData.Station24.FCCounts[1]) ];]]>
