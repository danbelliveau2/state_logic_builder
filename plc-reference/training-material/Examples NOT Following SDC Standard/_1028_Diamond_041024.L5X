</Comment>
<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S18Control_SM.Status.State[50])[MOVE(HMI_Data.StationData.Station18.ConsecFail,S18Control_SM.Control.Counter[0].PRE) [XIC(StationStatus[18].S18Success) RES(S18Control_SM.Control.Counter[0]) ,XIO(HMI_Data.Control.Button[147]) XIO(StationStatus[18].S18Success) [CTU(S18Control_SM.Control.Counter[0],?,?) ,MOVE(116,StationStatus[18].FailureType) ] ,RES(S18Control_SM.Control.Counter[1]) ] ,XIC(HMI_Data.Control.Button[147]) XIO(StationStatus[18].S18Success) OTL(PreOpStatus[7]) ];]]>
</Text>
