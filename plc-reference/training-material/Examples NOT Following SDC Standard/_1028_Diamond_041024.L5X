<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(MachineRunning) NE(JobNumber,JobNumberPre) ,XIC(Error) XIC(FaultReset) MOVE(2000,Timer3.PRE) TON(Timer3,?,?) XIC(Timer3.DN) ONS(ONS_4) ,XIC(PowerUp) XIC(NodeStatus) MOVE(10000,Timer1.PRE) TON(Timer1,?,?) XIC(Timer1.DN) ONS(ONS_1) ]XIO(Status.CommandExecuting)[MOVE(JobNumber,JobNumberPre) ,OTL(Control.SetOffline) ,OTL(IP) OTU(PC) OTU(Error) ,MOVE(JobNumber,Control.Command) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Control.SetOffline)XIO(Status.Online)ONS(ONS_2)OTL(Control.ExecuteCommand);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Status.CommandCompleted)ONS(ONS_3)OTL(PC)OTU(IP);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Control.SetOffline)[XIC(PC) ,XIO(PC) MOVE(10000,Timer2.PRE) TON(Timer2,?,?) XIC(Timer2.DN) OTL(Error) ][OTU(Control.SetOffline) ,OTU(Control.ExecuteCommand) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
