</Line>
<Line Number="17">
<![CDATA[	HMI_Data.HeadData[x].Station11.Successes:=0;]]>
</Line>
<Line Number="18">
<![CDATA[	HMI_Data.HeadData[x].Station16.Attempts:=0;]]>
</Line>
<Line Number="19">
<![CDATA[	HMI_Data.HeadData[x].Station16.Successes:=0;]]>
</Line>
<Line Number="20">
<![CDATA[	HMI_Data.HeadData[x].Station11Continuity.Attempts:=0;]]>
</Line>
<Line Number="21">
<![CDATA[	HMI_Data.HeadData[x].Station11Continuity.Successes:=0;]]>
</Line>
<Line Number="22">
<![CDATA[	HMI_Data.HeadData[x].Station18.Attempts:=0;]]>
</Line>
<Line Number="23">
<![CDATA[	HMI_Data.HeadData[x].Station18.Successes:=0;]]>
