<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])[XIC(A08Control_SM.Status.State[10]) ,XIC(A08Control_SM.Status.State[34]) ]MOVE(2000,A08Control_SM.Control.FaultTime)OTE(A08Control_SM.Control.EnaFaultDetect);]]>
