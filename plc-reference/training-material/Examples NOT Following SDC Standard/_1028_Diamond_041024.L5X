<Routine Name="Alarms_SUB" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Incoming Conveyor Is Overloaded]]>
</Comment>
<Text>
<![CDATA[XIC(r05_IncomingConveyor_OL)OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Outgoing Conveyor Is Overloaded]]>
</Comment>
<Text>
<![CDATA[XIC(r05_OutgoingConveyor_OL)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For Process Z Axis To Extend]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(r05BoxShift_SM.Status.State[4]) [XIO(r05_ProcessZExt_PRX) ,XIC(r05_ProcessZRet_PRX) ] XIC(r05BoxShift_SM.Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset_PB) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
