<Text>
<![CDATA[XIC(Supervisor_SM.Status.State[5])XIC(S18Control_SM.Status.State[12])ONS(S18Control_SM.Control.OS[0])ADD(HMI_Data.StationData.Station18.Retry,1,S18Control_SM.Control.Counter[1].PRE)[[XIC(S18Control_SM.Control.Bit[2]) XIC(S18Control_SM.Control.Bit[3]) ,XIC(HMI_Data.StationData.Station18.BypassA) ] [OTL(StationStatus[18].S18Success) ,MOVE(2,HMI_Data.StationData.Station18.Status) ] ,[XIO(S18Control_SM.Control.Bit[2]) ,XIO(S18Control_SM.Control.Bit[3]) ] XIO(HMI_Data.StationData.Station18.BypassA) [CTU(S18Control_SM.Control.Counter[1],?,?) ,MOVE(3,HMI_Data.StationData.Station18.Status) ] ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
