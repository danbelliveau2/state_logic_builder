<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Boot Holder To Close]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) XIC(S06Control_SM.Status.State[4]) XIC(S06Control_SM.Status.TimeoutFlt) ,XIC(Alarm[0].Active) XIO(FaultReset_PB) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For Boot Holder To Open]]>
</Comment>
<Text>
<![CDATA[[XIC(Supervisor_SM.Status.State[5]) [XIC(S06Control_SM.Status.State[12]) ,XIC(S06Control_SM.Status.State[40]) ] XIO(S06_BootHolderOpen_PRX) XIC(S06Control_SM.Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset_PB) ]OTE(Alarm[1].Active);]]>
