<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[EQ(SupervisorState,3)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Units Conversion]]>
</Comment>
<Text>
<![CDATA[[DIV(HMI_AMPData.Control.Accel,Scaling,AOI_JogMove.Acc) DIV(HMI_AMPData.Control.Decel,Scaling,AOI_JogMove.Dec) ,CPT(HMI_AMPData.Status.ActualPosition,Input[6]*(Scaling/20000)) ,CPT(HMI_AMPData.Status.ActualVelocity,Input[8]*(Scaling/240)) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Enable]]>
</Comment>
<Text>
<![CDATA[XIC(EIP)XIC(SafetyStatus)MOVE(1000,AutoEnable_TMR.PRE)TON(AutoEnable_TMR,?,?)XIC(AutoEnable_TMR.DN)[XIO(ManualMode) ,XIC(ManualMode) [XIC(HMI_AMPData.Control.Enable) ,XIC(Enable) XIO(HMI_AMPData.Control.Disable) ] ]OTE(Enable);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(EIP)AMP_Alarm_Reset(AOI_AlarmReset,Input,Output,FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Jog Control]]>
</Comment>
<Text>
<![CDATA[XIC(EIP)XIC(SafetyStatus)XIC(ManualMode)XIC(Permissive)[XIC(HMI_AMPData.Control.JogPositive) DIV(HMI_AMPData.Control.JogSpeed,Scaling,AOI_JogMove.Speed) ,XIC(HMI_AMPData.Control.JogNegative) CPT(AOI_JogMove.Speed,(HMI_AMPData.Control.JogSpeed/Scaling)*-1) ]OTE(Jog);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(HMI_AMPData.Control.JogPositive)XIO(HMI_AMPData.Control.JogNegative)MOVE(250,JogStop.PRE)TON(JogStop,?,?)XIC(JogStop.TT)OTE(StopJog);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[AMP_Jog_Move(AOI_JogMove,Input,Output,Jog,AOI_JogMove.Speed,AOI_JogMove.Acc,AOI_JogMove.Dec)AMP_Normal_Stop(AOI_NormalStop,Input,Output,StopJog);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Inch Control]]>
</Comment>
<Text>
<![CDATA[XIC(EIP)XIC(SafetyStatus)XIC(ManualMode)XIC(Permissive)[XIC(HMI_AMPData.Control.InchPos) CPT(AOI_RelativeMove.Distance,HMI_AMPData.Control.InchAmount*(20000/Scaling)) ,XIC(HMI_AMPData.Control.InchNeg) CPT(AOI_RelativeMove.Distance,(HMI_AMPData.Control.InchAmount*(20000/Scaling))*-1) ][DIV(HMI_AMPData.Control.ManualSpeed,Scaling,AOI_RelativeMove.Speed) ,MOVE(AOI_JogMove.Acc,AOI_RelativeMove.Acc) MOVE(AOI_JogMove.Dec,AOI_RelativeMove.Dec) ]OTE(InchMove);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[AMP_Relative_Move(AOI_RelativeMove,Input,Output,InchMove,AOI_RelativeMove.Distance,AOI_RelativeMove.Speed,AOI_RelativeMove.Acc,AOI_RelativeMove.Dec);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AMP_Input_Assembly" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2012-03-27T18:09:00.023Z" CreatedBy="MATT-F3A979C4EF\Administrator" EditedDate="2018-03-21T20:01:40.018Z" EditedBy="VM-RS2015-W7XX\Grantek" SoftwareRevision="v20.04"
>
<Description>
<![CDATA[Applied Motion - Input Assembly AOI]]>
</Description>
<AdditionalHelpText>
<![CDATA[The Input Assembly AOI takes raw input data from the drive and re-interprets the data, using either scaling or copying, to appropriately named outputs.]]>
</AdditionalHelpText>
