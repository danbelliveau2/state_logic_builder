<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Logic,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_FilterStartPos,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Logic" Type="RLL">
<Description>
<![CDATA[Recipe HMI interactions]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Compare the Editing Recipe to its corresponding Saved Recipe Array.
Blink the Save button on the HMI if they're different.]]>
</Comment>
<Text>
<![CDATA[[GT(FilterListQty,0) GE(SavedPointer,0) LT(SavedPointer,i_SavedRecipeArrayLength) DIV(i_RecipeStructureUDTSizeBytes,4,RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Saved[SavedPointer],Recipe_Structure_Array_Saved[0],RecipeStructureSizeDINTs) COP(HMIControlRecipeTag.Editing,Recipe_Structure_Array_Editing[0],RecipeStructureSizeDINTs) MOVE(RecipeStructureSizeDINTs,ArrayCompareEdit_C.LEN) [XIO(ArrayCompareEdit_C.EN) FSC(ArrayCompareEdit_C,?,?,INC,Recipe_Structure_Array_Saved[ArrayCompareEdit_C.POS]<>Recipe_Structure_Array_Editing[ArrayCompareEdit_C.POS]) ,[XIC(ArrayCompareEdit_C.DN) OTL(Editing_Equal_Array) ,XIC(ArrayCompareEdit_C.FD) OTU(Editing_Equal_Array) ,[XIC(ArrayCompareEdit_C.FD) ,XIC(ArrayCompareEdit_C.DN) ] OTU(ArrayCompareEdit_C.FD) OTU(ArrayCompareEdit_C.IN) RES(ArrayCompareEdit_C) MOVE(0,ArrayCompareEdit_C.POS) ] ] ,[LE(FilterListQty,0) ,LT(SavedPointer,0) ] OTL(Editing_Equal_Array) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Editing_Equal_Array)OTE(HMIIndicatorEditingEqualTag);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Compare the Running Recipe to its corresponding Saved Recipe Array.
Blink the Download button on the HMI if they're different.]]>
</Comment>
<Text>
<![CDATA[[GT(FilterListQty,0) GE(HMIStatusRecipeTag.Running_ID,0) LT(HMIStatusRecipeTag.Running_ID,i_SavedRecipeArrayLength) DIV(i_RecipeStructureUDTSizeBytes,4,RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Saved[HMIStatusRecipeTag.Running_ID],Recipe_Structure_Array_Saved[0],RecipeStructureSizeDINTs) COP(HMIStatusRecipeTag.Running,Recipe_Structure_Array_Running[0],RecipeStructureSizeDINTs) MOVE(RecipeStructureSizeDINTs,ArrayCompareRun_C.LEN) [XIO(ArrayCompareRun_C.EN) FSC(ArrayCompareRun_C,?,?,INC,Recipe_Structure_Array_Saved[ArrayCompareRun_C.POS]<>Recipe_Structure_Array_Running[ArrayCompareRun_C.POS]) ,[XIC(ArrayCompareRun_C.DN) OTL(Running_Equal_Array) ,XIC(ArrayCompareRun_C.FD) OTU(Running_Equal_Array) ,[XIC(ArrayCompareRun_C.FD) ,XIC(ArrayCompareRun_C.DN) ] OTU(ArrayCompareRun_C.FD) OTU(ArrayCompareRun_C.IN) RES(ArrayCompareRun_C) MOVE(0,ArrayCompareRun_C.POS) ] ] ,[LE(FilterListQty,0) ,LT(HMIStatusRecipeTag.Running_ID,0) ] OTL(Running_Equal_Array) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Running_Equal_Array)OTE(HMIIndicatorSavedRunningEqualTag);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Update the saved pointer when the list changes or navigation pointer changed]]>
</Comment>
<Text>
<![CDATA[XIC(UpdateSavedPointer)[OTU(UpdateSavedPointer) ,GE(HMIStatusRecipeTag.IndexNumNavi,0) LT(HMIStatusRecipeTag.IndexNumNavi,i_DisplayListSize) [MOVE(HMIStatusRecipeTag.PartID[HMIStatusRecipeTag.IndexNumNavi],SavedPointer) ,OTL(UpdateEditingRecipe) ] ,LT(HMIStatusRecipeTag.IndexNumNavi,0) [MOVE(-1,SavedPointer) ,COP(EmptyRecipe,HMIControlRecipeTag.Editing,1) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Populate the filter list]]>
</Comment>
<Text>
<![CDATA[XIC(RefreshFilterList)[OTU(RefreshFilterList) ,JSR(R05_PopulateFilterList,0) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Populate the display list]]>
</Comment>
<Text>
<![CDATA[XIC(RefreshDisplayList)[OTU(RefreshDisplayList) ,JSR(R04_PopulateDisplayList,0) ,OTL(UpdateSavedPointer) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Update the recipe being edited]]>
</Comment>
<Text>
<![CDATA[XIC(UpdateEditingRecipe)[OTU(UpdateEditingRecipe) ,GE(SavedPointer,0) LT(SavedPointer,i_SavedRecipeArrayLength) COP(HMIStatusRecipeTag.Saved[SavedPointer],HMIControlRecipeTag.Editing,1) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[****HMI Recipe Control****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[NE(HMIControlRecipeTag.FilterPartNumber,FilterPartNumberPrev)[COP(HMIControlRecipeTag.FilterPartNumber,FilterPartNumberPrev,1) ,MOVE(0,FilterListStartPos) ,OTL(RefreshFilterList) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[NE(HMIStatusRecipeTag.IndexNumNavi,IndexNumNaviPrev)[MOVE(HMIStatusRecipeTag.IndexNumNavi,IndexNumNaviPrev) ,OTL(UpdateSavedPointer) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Download Recipe]]>
</Comment>
<Text>
<![CDATA[GE(SavedPointer,0)LT(SavedPointer,i_SavedRecipeArrayLength)XIC(HMIControlRecipeTag.Download)TON(DownloadDelay,?,?)XIC(DownloadDelay.DN)ONS(ONS.0)[COP(HMIStatusRecipeTag.Saved[SavedPointer],HMIStatusRecipeTag.Running,1) ,[MOVE(SavedPointer,HMIStatusRecipeTag.Running_ID) ,OTE(q_DownloadPulse) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[LT(SavedPointer,0) ,GE(SavedPointer,i_SavedRecipeArrayLength) ]XIC(HMIControlRecipeTag.Download)ONS(ONS.1)COP(EmptyRecipe,HMIStatusRecipeTag.Running,1);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Delete Recipe]]>
</Comment>
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Delete)TON(DeleteDelay,?,?)XIC(DeleteDelay.DN)ONS(ONS.2)[GE(SavedPointer,0) LT(SavedPointer,i_SavedRecipeArrayLength) COP(EmptyRecipe,HMIStatusRecipeTag.Saved[SavedPointer],1) ,OTL(RefreshFilterList) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Save Recipe]]>
</Comment>
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Save)TON(SaveDelay,?,?)XIC(SaveDelay.DN)ONS(ONS.3)[GE(SavedPointer,0) LT(SavedPointer,i_SavedRecipeArrayLength) COP(HMIControlRecipeTag.Editing,HMIStatusRecipeTag.Saved[SavedPointer],1) ,OTL(RefreshFilterList) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Sort Recipe Array]]>
</Comment>
<Text>
<![CDATA[XIC(HMIControlRecipeTag.Sort)TON(SortDelay,?,?)XIC(SortDelay.DN)ONS(ONS.4)[JSR(R06_Sort,0) ,OTL(RefreshFilterList) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Upload Current Recipe & Create New Recipe]]>
</Comment>
<Text>
<![CDATA[XIC(HMIControlRecipeTag.UploadAndCreate)TON(UploadCreateDelay,?,?)XIC(UploadCreateDelay.DN)ONS(ONS.5)JSR(R03_Create,0);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Copy to controller recipe tag]]>
</Comment>
<Text>
<![CDATA[COP(HMIStatusRecipeTag.Running,Recipe,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_FilterStartPos" Type="ST">
<Description>
<![CDATA[Manage initializing, Incrementing, and Decrementing the Filter List Start Position]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[IF (FilterListStartPos < 0 OR FilterListStartPos >= i_SavedRecipeArrayLength) THEN]]>
</Line>
<Line Number="1">
<![CDATA[	FilterListStartPos := 0;]]>
</Line>
<Line Number="2">
<![CDATA[END_IF;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[IF (FilterListQty = 0) THEN]]>
</Line>
<Line Number="5">
<![CDATA[	//No Results]]>
</Line>
<Line Number="6">
<![CDATA[	HMIStatusRecipeTag.IndexNumNavi := -1;]]>
</Line>
<Line Number="7">
<![CDATA[ELSE]]>
</Line>
<Line Number="8">
<![CDATA[	//HMI Scroll Home button]]>
</Line>
<Line Number="9">
<![CDATA[	IF (HMIControlRecipeTag.ScrollHome AND NOT ONS.10) THEN]]>
</Line>
<Line Number="10">
<![CDATA[		ONS.10 := 1;]]>
</Line>
<Line Number="11">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="12">
<![CDATA[		FilterListStartPos := 0;]]>
</Line>
<Line Number="13">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="14">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollHome AND ONS.10) THEN]]>
</Line>
<Line Number="15">
<![CDATA[		ONS.10 := 0;]]>
</Line>
<Line Number="16">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[	//HMI Page Up button]]>
</Line>
<Line Number="19">
<![CDATA[	IF (HMIControlRecipeTag.PageUp AND NOT ONS.11) THEN]]>
</Line>
<Line Number="20">
<![CDATA[		ONS.11 := 1;]]>
</Line>
<Line Number="21">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - i_DisplayListSize;]]>
</Line>
<Line Number="22">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.PageUp AND ONS.11) THEN]]>
</Line>
<Line Number="23">
<![CDATA[		ONS.11 := 0;]]>
</Line>
<Line Number="24">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[	//HMI Scroll Up button]]>
</Line>
<Line Number="27">
<![CDATA[	IF (HMIControlRecipeTag.ScrollUp AND NOT ONS.12) THEN]]>
</Line>
<Line Number="28">
<![CDATA[		ONS.12 := 1;]]>
</Line>
<Line Number="29">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - 1;]]>
</Line>
<Line Number="30">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollUp AND ONS.12) THEN]]>
</Line>
<Line Number="31">
<![CDATA[		ONS.12 := 0;]]>
</Line>
<Line Number="32">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	//HMI Scroll Down button]]>
</Line>
<Line Number="35">
<![CDATA[	IF (HMIControlRecipeTag.ScrollDown AND NOT ONS.13) THEN]]>
</Line>
<Line Number="36">
<![CDATA[		ONS.13 := 1;]]>
</Line>
<Line Number="37">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi + 1;]]>
</Line>
<Line Number="38">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollDown AND ONS.13) THEN]]>
</Line>
<Line Number="39">
<![CDATA[		ONS.13 := 0;]]>
</Line>
<Line Number="40">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[	//HMI Page Down button]]>
</Line>
<Line Number="43">
<![CDATA[	IF (HMIControlRecipeTag.PageDown AND NOT ONS.14) THEN]]>
</Line>
<Line Number="44">
<![CDATA[		ONS.14 := 1;]]>
</Line>
<Line Number="45">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi + i_DisplayListSize;]]>
</Line>
<Line Number="46">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.PageDown AND ONS.14) THEN]]>
</Line>
<Line Number="47">
<![CDATA[		ONS.14 := 0;]]>
</Line>
<Line Number="48">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[	//HMI Scroll End button]]>
</Line>
<Line Number="51">
<![CDATA[	IF (HMIControlRecipeTag.ScrollEnd AND NOT ONS.15) THEN]]>
</Line>
<Line Number="52">
<![CDATA[		ONS.15 := 1;]]>
</Line>
<Line Number="53">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := i_SavedRecipeArrayLength - 1;]]>
</Line>
<Line Number="54">
<![CDATA[	ELSIF (NOT HMIControlRecipeTag.ScrollEnd AND ONS.15) THEN]]>
</Line>
<Line Number="55">
<![CDATA[		ONS.15 := 0;]]>
</Line>
<Line Number="56">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[	IF (HMIStatusRecipeTag.IndexNumNavi >= i_DisplayListSize) THEN]]>
</Line>
<Line Number="60">
<![CDATA[			//Below the bottom of the Listbox]]>
</Line>
<Line Number="61">
<![CDATA[ 		IF (HMIStatusRecipeTag.IndexNumNavi < (FilterListQty - FilterListStartPos)) THEN]]>
</Line>
<Line Number="62">
<![CDATA[			//There are records to display below the navigation row]]>
</Line>
<Line Number="63">
<![CDATA[			FilterListStartPos := FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi;]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[			IF (FilterListStartPos >= FilterListQty) THEN]]>
</Line>
<Line Number="66">
<![CDATA[				//Start position is outside the Filter List]]>
</Line>
<Line Number="67">
<![CDATA[				IF (FilterListQty >= i_DisplayListSize) THEN]]>
</Line>
<Line Number="68">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := i_DisplayListSize - 1; //Navigation on the last row]]>
</Line>
<Line Number="69">
<![CDATA[					FilterListStartPos := FilterListQty - i_DisplayListSize;]]>
</Line>
<Line Number="70">
<![CDATA[				ELSE]]>
</Line>
<Line Number="71">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := FilterListQty - 1; //Navigation on the last row]]>
</Line>
<Line Number="72">
<![CDATA[					FilterListStartPos := 0;]]>
</Line>
<Line Number="73">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="74">
<![CDATA[			ELSE]]>
</Line>
<Line Number="75">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := HMIStatusRecipeTag.IndexNumNavi - i_DisplayListSize;]]>
</Line>
<Line Number="76">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="77">
<![CDATA[		ELSE]]>
</Line>
<Line Number="78">
<![CDATA[			//No more records below the navigation row]]>
</Line>
<Line Number="79">
<![CDATA[			IF (FilterListQty >= i_DisplayListSize) THEN]]>
</Line>
<Line Number="80">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := i_DisplayListSize - 1; //Navigation on the last row]]>
</Line>
<Line Number="81">
<![CDATA[				FilterListStartPos := FilterListQty - i_DisplayListSize;]]>
</Line>
<Line Number="82">
<![CDATA[			ELSE]]>
</Line>
<Line Number="83">
<![CDATA[				HMIStatusRecipeTag.IndexNumNavi := FilterListQty - 1; //Navigation on the last row]]>
</Line>
<Line Number="84">
<![CDATA[				FilterListStartPos := 0;]]>
</Line>
<Line Number="85">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="87">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="88">
<![CDATA[	ElSIF (HMIStatusRecipeTag.IndexNumNavi >= (FilterListQty - FilterListStartPos)) THEN]]>
</Line>
<Line Number="89">
<![CDATA[		//Below the bottom of the filtered list but above the bottom of the Listbox]]>
</Line>
<Line Number="90">
<![CDATA[		HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="91">
<![CDATA[		FilterListStartPos := 0;]]>
</Line>
<Line Number="92">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="93">
<![CDATA[	ELSIF (HMIStatusRecipeTag.IndexNumNavi < 0) THEN]]>
</Line>
<Line Number="94">
<![CDATA[		//Above the Listbox]]>
</Line>
<Line Number="95">
<![CDATA[		IF ((FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi) >= 0) THEN]]>
</Line>
<Line Number="96">
<![CDATA[			//The first value is at or less than the first part in the Saved list]]>
</Line>
<Line Number="97">
<![CDATA[			FilterListStartPos := (FilterListStartPos + HMIStatusRecipeTag.IndexNumNavi);]]>
</Line>
<Line Number="98">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="99">
<![CDATA[		ELSE]]>
</Line>
<Line Number="100">
<![CDATA[			FilterListStartPos := 0;]]>
</Line>
<Line Number="101">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="102">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="103">
<![CDATA[		RefreshDisplayList := 1;]]>
</Line>
<Line Number="104">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="105">
<![CDATA[END_IF;]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
<![CDATA[]]>
</Line>
<Line Number="108">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="R03_Create" Type="ST">
<Description>
<![CDATA[Find the first available slot in the Saved list and use that for a new part.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Find the first empty Save slot]]>
</Line>
<Line Number="1">
<![CDATA[	FOR SavedIter := 0 TO i_SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="2">
<![CDATA[		IF (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="3">
<![CDATA[			//Copy the editing Recipe to the found Saved slot]]>
</Line>
<Line Number="4">
<![CDATA[			COP(HMIControlRecipeTag.Editing, HMIStatusRecipeTag.Saved[SavedIter], 1);]]>
</Line>
<Line Number="5">
<![CDATA[			//Clear the PartNumber field]]>
</Line>
<Line Number="6">
<![CDATA[			COP(NewPartString30, HMIStatusRecipeTag.Saved[SavedIter].Name, 1);]]>
</Line>
<Line Number="7">
<![CDATA[			COP(NewPartString30, HMIControlRecipeTag.Editing.Name, 1);]]>
</Line>
<Line Number="8">
<![CDATA[			SavedPointer := SavedIter;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[			COP(NewPartString30, HMIControlRecipeTag.FilterPartNumber, 1);]]>
</Line>
<Line Number="11">
<![CDATA[			HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="12">
<![CDATA[			FilterListStartPos := SavedIter;]]>
</Line>
<Line Number="13">
<![CDATA[			RefreshFilterList := 1;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="16">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="17">
<![CDATA[	END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R04_PopulateDisplayList" Type="ST">
<Description>
<![CDATA[Filtered List Display on HMI]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Populate the Displayed Part Number List]]>
</Line>
<Line Number="1">
<![CDATA[FilteredIter := 0;]]>
</Line>
<Line Number="2">
<![CDATA[SavedIter := 0;]]>
</Line>
<Line Number="3">
<![CDATA[ResultCount := 0;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[FOR FilteredIter := FilterListStartPos TO FilterListQty - 1 DO]]>
</Line>
<Line Number="6">
<![CDATA[	IF ((FilteredIter < 0) OR (FilteredIter >= i_SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="7">
<![CDATA[		Fault.0 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="8">
<![CDATA[		EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="9">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[	IF (ResultCount < i_DisplayListSize) THEN]]>
</Line>
<Line Number="12">
<![CDATA[		//The HMI display list is not full so continue to populate it.]]>
</Line>
<Line Number="13">
<![CDATA[		SavedIter := HMIStatusRecipeTag.FilteredList[FilteredIter];]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= i_SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="16">
<![CDATA[			IF (SavedIter = -1) THEN //No more records in the Filtered list]]>
</Line>
<Line Number="17">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="18">
<![CDATA[			ELSE]]>
</Line>
<Line Number="19">
<![CDATA[				Fault.1 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="20">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="21">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[		IF ((ResultCount < 0) OR (ResultCount >= i_DisplayListSize)) THEN]]>
</Line>
<Line Number="25">
<![CDATA[			Fault.2 := 1;  //failed array bounds sanity check]]>
</Line>
<Line Number="26">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="27">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[		//Set the DisplayListID and DisplayListName.]]>
</Line>
<Line Number="30">
<![CDATA[		HMIStatusRecipeTag.PartID[ResultCount] := SavedIter;]]>
</Line>
<Line Number="31">
<![CDATA[		COP(HMIStatusRecipeTag.Saved[SavedIter].Name, HMIStatusRecipeTag.PartNumber[ResultCount], 1);]]>
</Line>
<Line Number="32">
<![CDATA[	ELSE]]>
</Line>
<Line Number="33">
<![CDATA[		//The HMI display list is full so this routine is done.]]>
</Line>
<Line Number="34">
<![CDATA[		EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="35">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="36">
<![CDATA[	ResultCount := ResultCount + 1;]]>
</Line>
<Line Number="37">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="38">
<![CDATA[DisplayResultsQty := ResultCount;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[//Clear the rest of the display list if it wasn't filled]]>
</Line>
<Line Number="41">
<![CDATA[FOR ResultCount := DisplayResultsQty TO i_DisplayListSize - 1 DO]]>
</Line>
<Line Number="42">
<![CDATA[	IF ((ResultCount < 0) OR (ResultCount >= i_DisplayListSize)) THEN]]>
</Line>
<Line Number="43">
<![CDATA[		Fault.3 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="44">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="45">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[	//Set the DisplayListID and DisplayListName to empty.]]>
</Line>
<Line Number="48">
<![CDATA[	HMIStatusRecipeTag.PartID[ResultCount] := -1;]]>
</Line>
<Line Number="49">
<![CDATA[	COP(EmptyString30,HMIStatusRecipeTag.PartNumber[ResultCount],1);]]>
</Line>
<Line Number="50">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R05_PopulateFilterList" Type="ST">
<Description>
<![CDATA[Create Filtered List]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Populate the Filtered Part Number List]]>
</Line>
<Line Number="1">
<![CDATA[FilteredIter := 0;]]>
</Line>
<Line Number="2">
<![CDATA[FilterListQty :=  0;]]>
</Line>
<Line Number="3">
<![CDATA[LOWER(HMIControlRecipeTag.FilterPartNumber, filter); //So the comparison is case in-sensitive]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[IF (HMIControlRecipeTag.FilterPartNumber = EmptyString30) THEN]]>
</Line>
<Line Number="6">
<![CDATA[	//There is no filter.]]>
</Line>
<Line Number="7">
<![CDATA[	//Filter string is empty so populate with all non-empty recipes]]>
</Line>
<Line Number="8">
<![CDATA[	]]>
</Line>
<Line Number="9">
<![CDATA[	FOR SavedIter := 0 TO i_SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="10">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= i_SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="11">
<![CDATA[			Fault.4 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="12">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="13">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[		IF ((HMIStatusRecipeTag.Saved[SavedIter].Name.LEN < 0) OR (HMIStatusRecipeTag.Saved[SavedIter].Name.LEN >= 30)) THEN]]>
</Line>
<Line Number="16">
<![CDATA[			Fault.9 := 1; //failed string length sanity check]]>
</Line>
<Line Number="17">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="18">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[		//Only if Saved string is NOT empty]]>
</Line>
<Line Number="21">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="22">
<![CDATA[			IF ((FilteredIter < 0) OR (FilteredIter >= i_SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="23">
<![CDATA[				Fault.5 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="24">
<![CDATA[				EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="25">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[			HMIStatusRecipeTag.FilteredList[FilteredIter] := SavedIter;]]>
</Line>
<Line Number="28">
<![CDATA[			FilteredIter := FilteredIter + 1;]]>
</Line>
<Line Number="29">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="30">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="31">
<![CDATA[ELSE]]>
</Line>
<Line Number="32">
<![CDATA[	//There is a filter.]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	FOR SavedIter := 0 TO i_SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="35">
<![CDATA[		IF ((SavedIter < 0) OR (SavedIter >= i_SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="36">
<![CDATA[			Fault.6 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="37">
<![CDATA[			EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="38">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[		//Only if Saved string is NOT empty]]>
</Line>
<Line Number="41">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SavedIter].Name = EmptyString30) THEN]]>
</Line>
<Line Number="42">
<![CDATA[			LOWER(HMIStatusRecipeTag.Saved[SavedIter].Name, saved); //So the comparison is case in-sensitive]]>
</Line>
<Line Number="43">
<![CDATA[				//Exact match! Move the start position here and place the "cursor" on this part.]]>
</Line>
<Line Number="44">
<![CDATA[				IF (saved = filter) THEN]]>
</Line>
<Line Number="45">
<![CDATA[					FilterListStartPos := FilteredIter;]]>
</Line>
<Line Number="46">
<![CDATA[					HMIStatusRecipeTag.IndexNumNavi := 0;]]>
</Line>
<Line Number="47">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[				IF ((FilteredIter < 0) OR (FilteredIter >= i_SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="50">
<![CDATA[					Fault.7 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="51">
<![CDATA[					EXIT; //only exits the FOR loop]]>
</Line>
<Line Number="52">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[				FIND(saved,filter,1,FindResult);]]>
</Line>
<Line Number="55">
<![CDATA[				IF (FindResult > 0) THEN]]>
</Line>
<Line Number="56">
<![CDATA[					//Exact or Partial Match! Add the matching saved array index to the FilterList]]>
</Line>
<Line Number="57">
<![CDATA[					HMIStatusRecipeTag.FilteredList[FilteredIter] := SavedIter;]]>
</Line>
<Line Number="58">
<![CDATA[					FilteredIter := FilteredIter + 1;]]>
</Line>
<Line Number="59">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="62">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="63">
<![CDATA[END_IF;]]>
</Line>
<Line Number="64">
<![CDATA[FilterListQty := FilteredIter;]]>
</Line>
<Line Number="65">
<![CDATA[]]>
</Line>
<Line Number="66">
<![CDATA[//Clear the rest of the filtered list if it wasn't filled]]>
</Line>
<Line Number="67">
<![CDATA[FOR FilteredIter := FilterListQty TO i_SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="68">
<![CDATA[	IF ((FilteredIter < 0) OR (FilteredIter >= i_SavedRecipeArrayLength)) THEN]]>
</Line>
<Line Number="69">
<![CDATA[		Fault.8 := 1; //failed array bounds sanity check]]>
</Line>
<Line Number="70">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="71">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="72">
<![CDATA[	HMIStatusRecipeTag.FilteredList[FilteredIter] := -1;]]>
</Line>
<Line Number="73">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[RefreshDisplayList := 1;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R06_Sort" Type="ST">
<Description>
<![CDATA[Sort the Saved Recipes List]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Selection Sort the Recipe Array]]>
</Line>
<Line Number="1">
<![CDATA[FOR SortPtr_Main := 0 TO i_SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="2">
<![CDATA[	SortPtr_Smallest := -1;]]>
</Line>
<Line Number="3">
<![CDATA[	FOR SortPtr_Remain := SortPtr_Main TO i_SavedRecipeArrayLength - 1 DO]]>
</Line>
<Line Number="4">
<![CDATA[		IF NOT (HMIStatusRecipeTag.Saved[SortPtr_Remain].Name = EmptyString30) THEN]]>
</Line>
<Line Number="5">
<![CDATA[			IF (SortPtr_Smallest = -1) THEN]]>
</Line>
<Line Number="6">
<![CDATA[				SortPtr_Smallest := SortPtr_Remain;]]>
</Line>
<Line Number="7">
<![CDATA[			ELSE]]>
</Line>
<Line Number="8">
<![CDATA[				IF (HMIStatusRecipeTag.Saved[SortPtr_Remain].Name < HMIStatusRecipeTag.Saved[SortPtr_Smallest].Name) THEN]]>
</Line>
<Line Number="9">
<![CDATA[					SortPtr_Smallest := SortPtr_Remain;]]>
</Line>
<Line Number="10">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="11">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="12">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="13">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="14">
<![CDATA[	IF (SortPtr_Smallest = -1) THEN]]>
</Line>
<Line Number="15">
<![CDATA[		//Didn't find a non-empty value which means the rest of the array is empty, so we're done]]>
</Line>
<Line Number="16">
<![CDATA[		EXIT; //Quits the FOR loop only]]>
</Line>
<Line Number="17">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[	//Swap the Main with the smallest value found.]]>
</Line>
<Line Number="20">
<![CDATA[	COP(HMIStatusRecipeTag.Saved[SortPtr_Main], SortSwapRecipe, 1);]]>
</Line>
<Line Number="21">
<![CDATA[	COP(HMIStatusRecipeTag.Saved[SortPtr_Smallest], HMIStatusRecipeTag.Saved[SortPtr_Main], 1);]]>
</Line>
<Line Number="22">
<![CDATA[	COP(SortSwapRecipe, HMIStatusRecipeTag.Saved[SortPtr_Smallest], 1);]]>
</Line>
<Line Number="23">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
