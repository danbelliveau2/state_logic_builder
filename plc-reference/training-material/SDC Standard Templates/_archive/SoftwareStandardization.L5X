<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_Logic,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_Outputs,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Status Monitoring - Kinetix 5500 Drive Using CIP Safety]]>
</Comment>
<Text>
<![CDATA[XIC(sd01_Indexer:SI.RunMode)XIO(sd01_Indexer:SI.ConnectionFaulted)XIO(sd01_Indexer:SI.SafetyFault)OTE(IndexerOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Status Monitoring - Compact I/O Safety Modules]]>
</Comment>
<Text>
<![CDATA[[XIC(Local:1:I.RunMode) XIO(Local:1:I.ConnectionFaulted) OTE(SIN1OK) ,XIC(Local:2:I.RunMode) XIO(Local:2:I.ConnectionFaulted) OTE(SOUT1OK) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Status Monitoring - Point I/O Safety Modules]]>
</Comment>
<Text>
<![CDATA[[XIC(io01_MainMachine:1:I.RunMode) XIO(io01_MainMachine:1:I.ConnectionFaulted) OTE(SIN2OK) ,XIC(io01_MainMachine:2:I.RunMode) XIO(io01_MainMachine:2:I.ConnectionFaulted) OTE(SOUT2OK) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Map Compact Safety Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(SIN1OK)[XIC(Local:1:I.Pt00.Status) XIC(Local:1:I.Pt00.Data) XIC(Local:1:I.Pt01.Status) XIC(Local:1:I.Pt01.Data) OTE(EmergencyStopInput) ,XIC(Local:1:I.Pt02.Status) XIC(Local:1:I.Pt02.Data) XIC(Local:1:I.Pt03.Status) XIC(Local:1:I.Pt03.Data) OTE(GuardDoorZ1Input) ,XIC(Local:1:I.Pt04.Status) XIC(Local:1:I.Pt04.Data) OTE(EmergencyStopEDM) ,XIC(Local:1:I.Pt05.Status) XIC(Local:1:I.Pt05.Data) OTE(GuardDoorZ1EDM) ,XIC(Local:1:I.Pt06.Status) XIC(Local:1:I.Pt06.Data) OTE(MachineResetPB) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Map Point I/O Safety Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(SIN2OK)[XIC(io01_MainMachine:1:I.Pt00Status) XIC(io01_MainMachine:1:I.Pt00Data) XIC(io01_MainMachine:1:I.Pt01Status) XIC(io01_MainMachine:1:I.Pt01Data) OTE(GuardDoorZ2Input) ,XIC(io01_MainMachine:1:I.Pt02Status) XIC(io01_MainMachine:1:I.Pt02Data) OTE(GuardDoorZ2EDM) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Emergency Stop Reset - Falling Edge]]>
</Comment>
<Text>
<![CDATA[XIC(MachineResetPB)OSF(MachineResetSB,MachineResetOB);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Emergency Stop - Manual Reset Required]]>
</Comment>
<Text>
<![CDATA[[XIC(MachineResetOB) XIC(EmergencyStopEDM) XIC(GuardDoorZ1EDM) XIC(GuardDoorZ2EDM) ,XIC(EmergencyStopOutput) ]XIC(EmergencyStopInput)OTE(EmergencyStopOutput);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Guard Door Z1 Debounce]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorZ1Input)TOF(GuardDoorZ1OffDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Guard Door Z2 Debounce]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorZ2Input)TOF(GuardDoorZ2OffDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Guard Door Z1 - Automatic Restart

***NOTE - Risk Assessment May Determine That Manual Reset Is Required]]>
</Comment>
<Text>
<![CDATA[XIC(EmergencyStopOutput)XIC(GuardDoorZ1OffDelay.DN)OTE(GuardDoorZ1Output);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Guard Door Z2 - Automatic Restart

***NOTE - Risk Assessment May Determine That Manual Reset Is Required]]>
</Comment>
<Text>
<![CDATA[XIC(EmergencyStopOutput)XIC(GuardDoorZ2OffDelay.DN)OTE(GuardDoorZ2Output);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Safety Status To Supervisor]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorZ1Output)XIC(GuardDoorZ2Output)OTE(Safe_q_Status);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(EmergencyStopOutput)XIC(EmergencyStopEDM)XIC(GuardDoorZ1EDM)XIC(GuardDoorZ2EDM)XIC(EmergencyStopInput)OTE(Safe_q_Reset);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Safety Output - Kinetix 5500 Drive Using CIP Safety]]>
</Comment>
<Text>
<![CDATA[XIC(sd01_Indexer:SO.SafeTorqueOff)XIC(sd01_Indexer:SI.TorqueDisabled)XIC(sd01_Indexer:SI.ResetRequired)OTE(sd01_Indexer:SO.Reset);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IndexerOK)XIC(GuardDoorZ1Output)XIC(GuardDoorZ2Output)OTE(sd01_Indexer:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Emergency Stop Output]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt00.Status)OTE(EmergencyStopOutputStatus);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[CROUT(EmergencyStopCROUT,NEGATIVE,200,EmergencyStopOutput,EmergencyStopEDM,EmergencyStopEDM,Local:1:I.Pt04.Status,EmergencyStopOutputStatus,MachineResetOB) ,XIC(EmergencyStopCROUT.O1) XIC(EmergencyStopCROUT.O2) OTE(Local:2:O.Pt00.Data) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Guard Door Z1 Output]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt01.Status)OTE(GuardDoorZ1OutputStatus);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[CROUT(GuardDoorZ1CROUT,NEGATIVE,200,GuardDoorZ1Output,GuardDoorZ1EDM,GuardDoorZ1EDM,Local:1:I.Pt05.Status,GuardDoorZ1OutputStatus,MachineResetOB) ,XIC(GuardDoorZ1CROUT.O1) XIC(GuardDoorZ1CROUT.O2) OTE(Local:2:O.Pt01.Data) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Guard Door Z2 Output]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT2OK)XIC(io01_MainMachine:2:I.Pt00OutputStatus)XIC(io01_MainMachine:2:I.Pt01OutputStatus)OTE(GuardDoorZ2OutputStatus);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[CROUT(GuardDoorZ2CROUT,NEGATIVE,200,GuardDoorZ2Output,GuardDoorZ2EDM,GuardDoorZ2EDM,io01_MainMachine:1:I.Pt02Status,GuardDoorZ2OutputStatus,MachineResetOB) ,XIC(GuardDoorZ2CROUT.O1) OTE(io01_MainMachine:2:O.Pt00Data) ,XIC(GuardDoorZ2CROUT.O2) OTE(io01_MainMachine:2:O.Pt01Data) ];]]>
</Text>
</Rung>
