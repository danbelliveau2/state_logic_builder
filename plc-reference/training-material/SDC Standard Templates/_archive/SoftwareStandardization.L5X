<ParameterConnection EndPoint1="\S00_IndexerSP.iq_IndexerAxis" EndPoint2="a01_Indexer"/>
<ParameterConnection EndPoint1="\S00_IndexerSP.iq_ShotPinAxis" EndPoint2="a02_ShotPin"/>
<ParameterConnection EndPoint1="\S05_ServoPNP.iq_XAxis" EndPoint2="a03_S01PNPXAxis"/>
<ParameterConnection EndPoint1="\S05_ServoPNP.iq_ZAxis" EndPoint2="a04_S01PNPZAxis"/>
</ParameterConnections>
