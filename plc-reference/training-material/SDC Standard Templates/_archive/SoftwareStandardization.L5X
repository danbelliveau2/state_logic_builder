<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_ProductionData,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_ShiftData,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_ProductionData" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Production Data

Good Parts

***NOTE - Replace MachineBasic.AlwaysOff With Good Part Trigger***]]>
</Comment>
<Text>
<![CDATA[XIC(\S19_GoodUnload.q_PartUnloaded)ONS(ONS.0)[ADD(ProductionData.Good,1,ProductionData.Good) ,XIC(\Supervisor.EnableBatchCount) ADD(\Supervisor.BatchCount,1,\Supervisor.BatchCount) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Reject Parts

***NOTE - Replace MachineBasic.AlwaysOff With Reject Part Trigger***
***NOTE - Station 18 Is Reject Station For This Example***]]>
</Comment>
<Text>
<![CDATA[XIC(\S18_RejectUnload.q_PartUnloaded)ONS(ONS.1)[ADD(ProductionData.Reject,1,ProductionData.Reject) ,MOVE(\Tracking.p_Data.Station[18].NestNum,RejectNestNum) MOVE(\Tracking.p_Data.Nest[RejectNestNum].PartStatus.FailureType,ProductionRejectFailureType) SIZE(ProductionData.FailureTypeCounts[0],0,ProductionArraySize) ,LT(ProductionRejectFailureType,ProductionArraySize) ADD(ProductionData.FailureTypeCounts[ProductionRejectFailureType],1,ProductionData.FailureTypeCounts[ProductionRejectFailureType]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Total Parts]]>
</Comment>
<Text>
<![CDATA[ADD(ProductionData.Good,ProductionData.Reject,ProductionData.Total);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.GoodPercent,(ProductionData.Good/ProductionData.Total)*100);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.RejectPercent,(ProductionData.Reject/ProductionData.Total)*100);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)[RTO(CycleRuntime,?,?) ,XIC(CycleRuntime.DN) ADD(ProductionData.RuntimeSec,1,ProductionData.RuntimeSec) DIV(ProductionData.RuntimeSec,60,ProductionData.RuntimeMin) RES(CycleRuntime) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Fault Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)NE(\Supervisor.q_MachineStopReason,0)[RTO(CycleDowntime,?,?) ,XIC(CycleDowntime.DN) ADD(ProductionData.DowntimeSec,1,ProductionData.DowntimeSec) DIV(ProductionData.DowntimeSec,60,ProductionData.DowntimeMin) RES(CycleDowntime) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Elapsed Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)[RTO(CycleElapsed,?,?) ,XIC(CycleElapsed.DN) ADD(ProductionData.ElapsedSec,1,ProductionData.ElapsedSec) DIV(ProductionData.ElapsedSec,60,ProductionData.ElapsedMin) RES(CycleElapsed) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Time Paused (min) - One Of Machine Stations Waiting For Parts]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_Paused)[RTO(CyclePaused,?,?) ,XIC(CyclePaused.DN) ADD(ProductionData.PauseSec,1,ProductionData.PauseSec) DIV(ProductionData.PauseSec,60,ProductionData.PauseMin) RES(CyclePaused) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[ADD(ProductionData.RuntimeMin,ProductionData.ElapsedMin,ProductionData.ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.GoodRate,(ProductionData.Good/(ProductionData.RuntimeSec/60)));]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[PPM]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.PPM,(ProductionData.Total/(ProductionData.RuntimeSec/60)));]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Perfect Run Total]]>
</Comment>
<Text>
<![CDATA[DIV(ProductionData.RuntimeSec,IdealCycleTime,ProductionData.PerfectRunTotal);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[OEE

***NOTE - PlannedProductionTime Input Must Equal Total Shift Time (480 Minutes) - Planned Downtime (Breaks, Lunches, ect.) In Minutes***
***NOTE - IdealCycleTime Input Must Equal Cycle Time Of Machine In Seconds***]]>
</Comment>
<Text>
<![CDATA[OEE(ProductionDataOEE,480,ProductionData.RuntimeSec,ProductionData.DowntimeSec,IdealCycleTime,ProductionData.Total,ProductionData.Good,ProductionData.Availability,ProductionData.Performance,ProductionData.Quality,ProductionData.OEE);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)XIC(\Supervisor.q_MachineFaultActive)ONS(ONS.2)ADD(ProductionData.TotalFaults,1,ProductionData.TotalFaults);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Reset Total Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ResetPartCounts) ,XIC(p_HMI_ResetAllCounts) ]TON(HoldTimerA,?,?)XIC(HoldTimerA.DN)COP(EmptyData,ProductionData,1);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Reset Failure Type Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ResetProdFailureCounts) ,XIC(p_HMI_ResetAllCounts) ]TON(HoldTimerB,?,?)XIC(HoldTimerB.DN)JSR(R03_ResetProdCounts,0);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Reset Batch Count]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_ResetBatchCount)TON(HoldTimerF,?,?)XIC(HoldTimerF.DN)MOVE(0,\Supervisor.BatchCount);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_ShiftData" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Shift Data - Uses Array Indexes 1,2,3

Calculate Shift Number]]>
</Comment>
<Text>
<![CDATA[[EQ(g_CPUDateTime.Hour,7) EQ(g_CPUDateTime.Minutes,30) ONS(ONS.3) MOVE(1,p_CurrentShift) MOVE(3,PreviousShift) ,EQ(g_CPUDateTime.Hour,15) EQ(g_CPUDateTime.Minutes,30) ONS(ONS.4) MOVE(2,p_CurrentShift) MOVE(1,PreviousShift) ,EQ(g_CPUDateTime.Hour,23) EQ(g_CPUDateTime.Minutes,30) ONS(ONS.5) MOVE(3,p_CurrentShift) MOVE(2,PreviousShift) ]OTE(ShiftChangedPulse);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQ(p_CurrentShift,0)[LIMIT(7,g_CPUDateTime.Hour,14) MOVE(1,p_CurrentShift) ,LIMIT(15,g_CPUDateTime.Hour,22) MOVE(2,p_CurrentShift) ,LIMIT(23,g_CPUDateTime.Hour,6) MOVE(3,p_CurrentShift) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(ShiftChangedPulse)COP(EmptyData,ShiftData[p_CurrentShift],1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Good Parts

***NOTE - Replace MachineBasic.AlwaysOff With Good Part Trigger***]]>
</Comment>
<Text>
<![CDATA[XIC(\S19_GoodUnload.q_PartUnloaded)ONS(ONS.6)ADD(ShiftData[p_CurrentShift].Good,1,ShiftData[p_CurrentShift].Good);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Reject Parts

***NOTE - Replace MachineBasic.AlwaysOff With Reject Part Trigger***]]>
</Comment>
<Text>
<![CDATA[XIC(\S18_RejectUnload.q_PartUnloaded)ONS(ONS.7)[ADD(ShiftData[p_CurrentShift].Reject,1,ShiftData[p_CurrentShift].Reject) ,MOVE(\Tracking.p_Data.Nest[RejectNestNum].PartStatus.FailureType,ShiftRejectFailureType) SIZE(ShiftData[p_CurrentShift].FailureTypeCounts[0],0,ShiftArraySize) ,LT(ShiftRejectFailureType,ShiftArraySize) ADD(ShiftData[p_CurrentShift].FailureTypeCounts[ShiftRejectFailureType],1,ShiftData[p_CurrentShift].FailureTypeCounts[ShiftRejectFailureType]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Total Parts]]>
</Comment>
<Text>
<![CDATA[ADD(ShiftData[p_CurrentShift].Good,ShiftData[p_CurrentShift].Reject,ShiftData[p_CurrentShift].Total);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[p_CurrentShift].GoodPercent,(ShiftData[p_CurrentShift].Good/ShiftData[p_CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[p_CurrentShift].RejectPercent,(ShiftData[p_CurrentShift].Reject/ShiftData[p_CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)[RTO(ShiftRuntime,?,?) ,XIC(ShiftRuntime.DN) ADD(ShiftData[p_CurrentShift].RuntimeSec,1,ShiftData[p_CurrentShift].RuntimeSec) DIV(ShiftData[p_CurrentShift].RuntimeSec,60,ShiftData[p_CurrentShift].RuntimeMin) RES(ShiftRuntime) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Fault Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)NE(\Supervisor.q_MachineStopReason,0)[RTO(ShiftDowntime,?,?) ,XIC(ShiftDowntime.DN) ADD(ShiftData[p_CurrentShift].DowntimeSec,1,ShiftData[p_CurrentShift].DowntimeSec) DIV(ShiftData[p_CurrentShift].DowntimeSec,60,ShiftData[p_CurrentShift].DowntimeMin) RES(ShiftDowntime) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Elapsed Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)[RTO(ShiftElapsed,?,?) ,XIC(ShiftElapsed.DN) ADD(ShiftData[p_CurrentShift].ElapsedSec,1,ShiftData[p_CurrentShift].ElapsedSec) DIV(ShiftData[p_CurrentShift].ElapsedSec,60,ShiftData[p_CurrentShift].DowntimeMin) RES(ShiftElapsed) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Time Paused (min) - One Of Machine Stations Waiting For Parts]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_Paused)[RTO(ShiftPaused,?,?) ,XIC(ShiftPaused.DN) ADD(ShiftData[p_CurrentShift].PauseSec,1,ShiftData[p_CurrentShift].PauseSec) DIV(ShiftData[p_CurrentShift].PauseSec,60,ShiftData[p_CurrentShift].PauseMin) RES(ShiftPaused) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[ADD(ShiftData[p_CurrentShift].RuntimeMin,ShiftData[p_CurrentShift].ElapsedMin,ShiftData[p_CurrentShift].ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[p_CurrentShift].GoodRate,(ShiftData[p_CurrentShift].Good/(ShiftData[p_CurrentShift].RuntimeSec/60)));]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[PPM]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[p_CurrentShift].PPM,(ShiftData[p_CurrentShift].Total/(ShiftData[p_CurrentShift].RuntimeSec/60)));]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Perfect Run Total]]>
</Comment>
<Text>
<![CDATA[DIV(ShiftData[p_CurrentShift].RuntimeSec,IdealCycleTime,ShiftData[p_CurrentShift].PerfectRunTotal);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[OEE

***NOTE - PlannedProductionTime Input Must Equal Total Shift Time (480 Minutes) - Planned Downtime (Breaks, Lunches, ect.) In Minutes***
***NOTE - IdealCycleTime Input Must Equal Cycle Time Of Machine In Seconds***]]>
</Comment>
<Text>
<![CDATA[OEE(ShiftDataOEE,480,ShiftData[p_CurrentShift].RuntimeSec,ShiftData[p_CurrentShift].DowntimeSec,IdealCycleTime,ShiftData[p_CurrentShift].Total,ShiftData[p_CurrentShift].Good,ShiftData[p_CurrentShift].Availability,ShiftData[p_CurrentShift].Performance,ShiftData[p_CurrentShift].Quality,ShiftData[p_CurrentShift].OEE);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)XIC(\Supervisor.q_MachineFaultActive)ONS(ONS.8)ADD(ShiftData[p_CurrentShift].TotalFaults,1,ShiftData[p_CurrentShift].TotalFaults);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Reset Current Shift Count]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_ResetCurrentShift)TON(HoldTimerC,?,?)XIC(HoldTimerC.DN)COP(EmptyData,ShiftData[p_CurrentShift],1);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Reset All Shift Count]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ResetAllShift) ,XIC(p_HMI_ResetAllCounts) ]TON(HoldTimerD,?,?)XIC(HoldTimerD.DN)COP(EmptyData,ShiftData[1],1)COP(EmptyData,ShiftData[2],1)COP(EmptyData,ShiftData[3],1);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Reset Failure Type Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ResetShiftFailureCounts) ,XIC(p_HMI_ResetAllCounts) ]TON(HoldTimerE,?,?)XIC(HoldTimerE.DN)JSR(R04_ResetShiftCounts,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_ResetProdCounts" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Reset Production Counts]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[SIZE(ProductionData.FailureTypeCounts,0,ResetProdArrayCount);]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[FOR ProdFailure := 0 TO ResetProdArrayCount-1 BY 1 DO]]>
</Line>
<Line Number="5">
<![CDATA[	ProductionData.FailureTypeCounts[ProdFailure]:=0;]]>
</Line>
<Line Number="6">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R04_ResetShiftCounts" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Reset Production Counts]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[FOR ShiftNumber:=1 TO 3 BY 1 DO]]>
</Line>
<Line Number="3">
<![CDATA[	SIZE(ShiftData[ShiftNumber].FailureTypeCounts,0,ResetShiftArrayCount);]]>
</Line>
<Line Number="4">
<![CDATA[	FOR ShiftFailure := 0 TO ResetShiftArrayCount-1 BY 1 DO]]>
</Line>
<Line Number="5">
<![CDATA[		ShiftData[ShiftNumber].FailureTypeCounts[ShiftFailure]:=0;]]>
</Line>
<Line Number="6">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="7">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
