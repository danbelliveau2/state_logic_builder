<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)XIC(q_CleanoutModeEnabled)XIO(\Tracking.p_Data.Nest[1].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[2].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[3].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[4].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[5].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[6].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[7].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[8].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[9].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[10].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[11].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[12].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[13].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[14].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[15].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[16].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[17].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[18].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[19].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[20].PartStatus.PartLoaded)ONS(ONS.2)OTL(q_CleanoutModeStopTrig);]]>
</Text>
