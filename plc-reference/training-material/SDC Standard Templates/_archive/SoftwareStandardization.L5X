<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(* Ensure WindowSize is within buffer range *)]]>
</Line>
<Line Number="1">
<![CDATA[IF WindowSize > 100 THEN]]>
</Line>
<Line Number="2">
<![CDATA[    WindowSize := 100;]]>
</Line>
<Line Number="3">
<![CDATA[ELSIF WindowSize < 1 THEN]]>
</Line>
<Line Number="4">
<![CDATA[    WindowSize := 1;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[(* Remove the oldest value *)]]>
</Line>
<Line Number="8">
<![CDATA[Sum := Sum - Buffer[Index];]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[(* Store new value in buffer *)]]>
</Line>
<Line Number="11">
<![CDATA[Buffer[Index] := Input;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[(* Add new value to sum *)]]>
</Line>
<Line Number="14">
<![CDATA[Sum := Sum + Input;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[(* Update sample count (until full) *)]]>
</Line>
<Line Number="17">
<![CDATA[IF Count < WindowSize THEN]]>
</Line>
<Line Number="18">
<![CDATA[    Count := Count + 1;]]>
</Line>
<Line Number="19">
<![CDATA[END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[(* Compute average *)]]>
</Line>
<Line Number="22">
<![CDATA[Average := Sum / Count;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[(* Increment and wrap buffer index *)]]>
</Line>
<Line Number="25">
<![CDATA[Index := (Index + 1) MOD WindowSize;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="NestPerformance" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-03-30T17:01:03.851Z" CreatedBy="STEVENDOUGLAS\jperry" EditedDate="2026-04-28T18:27:53.270Z" EditedBy="STEVENDOUGLAS\jperry" SoftwareRevision="v37.00"
>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Success" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Failure" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Attempts" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Successes" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Failures" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Efficiency" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="rEfficiencyTemp" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Successes]]>
</Line>
<Line Number="1">
<![CDATA[IF Success THEN]]>
</Line>
<Line Number="2">
<![CDATA[	Attempts:=Attempts + 1;]]>
</Line>
<Line Number="3">
<![CDATA[	Successes:=Successes + 1;]]>
</Line>
<Line Number="4">
<![CDATA[END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[//Failures]]>
</Line>
<Line Number="7">
<![CDATA[IF Failure THEN]]>
</Line>
<Line Number="8">
<![CDATA[	Attempts:=Attempts + 1;]]>
</Line>
<Line Number="9">
<![CDATA[	Failures:=Failures + 1;]]>
</Line>
<Line Number="10">
<![CDATA[END_IF;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[//Calculate Nest Efficiency]]>
</Line>
<Line Number="13">
<![CDATA[IF (Attempts > 0) THEN]]>
</Line>
<Line Number="14">
<![CDATA[	rEfficiencyTemp := (Successes * 10000) / Attempts;]]>
</Line>
<Line Number="15">
<![CDATA[	Efficiency := rEfficiencyTemp / 100;]]>
</Line>
<Line Number="16">
<![CDATA[ELSE]]>
</Line>
<Line Number="17">
<![CDATA[	Efficiency := 0;]]>
</Line>
<Line Number="18">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="OEE" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2025-07-08T12:58:20.286Z" CreatedBy="STEVENDOUGLAS\jperry" EditedDate="2025-07-14T13:28:01.219Z" EditedBy="STEVENDOUGLAS\jperry" SoftwareRevision="v37.00"
>
<Parameters>
