<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Part Present]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(10000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[0].Active) ,ONS(ONS.5) MOVE(1,Alarm[0].Severity) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Extend]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_ExtendXAxis) XIO(XAxisExtended) TON(AlarmTimerXAxisExtended,?,?) XIC(AlarmTimerXAxisExtended.DN) ,XIC(Alarm[1].Active) XIO(FaultReset) ][OTE(Alarm[1].Active) ,ONS(ONS.6) CONCAT(g_StationList[StaNum],AlarmList[1],Alarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Retract]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractXAxis) XIO(XAxisRetracted) TON(AlarmTimerXAxisRetracted,?,?) XIC(AlarmTimerXAxisRetracted.DN) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,ONS(ONS.7) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[X Axis Sensors/Outputs Misconfigured]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[[XIC(q_RetractXAxis) XIC(q_ExtendXAxis) ,XIC(i_XAxisExtended) XIC(i_XAxisRetracted) ] TON(AlarmTimerXAxisMisconfigured,?,?) XIC(AlarmTimerXAxisMisconfigured.DN) ,XIC(Alarm[3].Active) XIO(FaultReset) ][OTE(Alarm[3].Active) ,ONS(ONS.8) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Z Axis To Extend]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_ExtendZAxis) XIO(ZAxisExtended) TON(AlarmTimerZAxisExtended,?,?) XIC(AlarmTimerZAxisExtended.DN) ,XIC(Alarm[4].Active) XIO(FaultReset) ][OTE(Alarm[4].Active) ,ONS(ONS.9) CONCAT(g_StationList[StaNum],AlarmList[4],Alarm[4].Message) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Z Axis To Retract]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractZAxis) XIO(ZAxisRetracted) TON(AlarmTimerZAxisRetracted,?,?) XIC(AlarmTimerZAxisRetracted.DN) ,XIC(Alarm[5].Active) XIO(FaultReset) ][OTE(Alarm[5].Active) ,ONS(ONS.10) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Z Axis Sensors/Outputs Misconfigured]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractZAxis) XIC(q_ExtendZAxis) TON(AlarmTimerZAxisMisconfigured,?,?) XIC(AlarmTimerZAxisMisconfigured.DN) ,XIC(Alarm[6].Active) XIO(FaultReset) ][OTE(Alarm[6].Active) ,ONS(ONS.11) CONCAT(g_StationList[StaNum],AlarmList[6],Alarm[6].Message) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
