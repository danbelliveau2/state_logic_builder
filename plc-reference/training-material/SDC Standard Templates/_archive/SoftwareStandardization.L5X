<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_Logic,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Nest & Station Numbers]]>
</Comment>
<Text>
<![CDATA[[MOVE(4,StaNum) MOVE(3,StaNumPre) ,MOVE(\Tracking.p_Data.Station[StaNum].NestNum,NestNumCurrent) MOVE(\Tracking.p_Data.Station[StaNumPre].NestNum,NestNumIncoming) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SDC standard two sensor verify station.  One sensor for top of part clear, one sensor for part present

Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[[AOI_Debounce(PartPresentDebounce,i_PartPresent,50,50) ,AOI_Debounce(PartClearDebounce,i_PartClear,50,50) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Bypass)OTE(Bypass);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Cycle Station]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded)[XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNumPre].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNumPre].Lockout) ][XIO(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStationA) ,OTE(CycleStationB) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Verify logic

Examples of ready to read - indexer waiting for stations complete

Adjust timer preset based upon application]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)TON(VerifyDelay,?,?)XIC(VerifyDelay.DN)ONS(ONS.0)XIC(CycleStationA)[OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,[XIC(PartPresentDebounce.On) XIC(PartClearDebounce.On) ,XIC(Bypass) ] [OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,OTU(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,MOVE(0,ConsecFails.Count) ] ,XIO(Bypass) [XIO(PartPresentDebounce.On) ,XIO(PartClearDebounce.On) ] [OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,OTU(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Actuators Safe For Index]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)OTE(q_ActuatorsSafe);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Station Complete]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)[XIC(CycleStationB) [XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout) ] ,XIO(CycleStationB) ]OTE(q_StationComplete);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Station Performance]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)StationPerformance(StationPerformance,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success,g_PresetStationPerformLow,g_PresetStationPerformHigh,\Tracking.p_Data.Station[StaNum].PerformData.Attempts,\Tracking.p_Data.Station[StaNum].PerformData.Successes,\Tracking.p_Data.Station[StaNum].PerformData.Failures,\Tracking.p_Data.Station[StaNum].PerformData.Efficiency,\Tracking.p_Data.Station[StaNum].PerformData.HMIColorStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[[GE(ConsecFails.Count,ConsecFails.Setpoint) ,XIC(Alarm[0].Active) XIO(FaultReset) ][OTE(Alarm[0].Active) ,ONS(ONS.2) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Alarm[0].Active)MOVE(0,ConsecFails.Count);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Bypass Active Warning]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Bypass)OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
