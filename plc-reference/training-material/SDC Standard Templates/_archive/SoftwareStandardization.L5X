<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(Pulse_250ms_TMR.DN)MOVE(250,Pulse_250ms_TMR.PRE)TON(Pulse_250ms_TMR,?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Pulse_100ms_TMR.DN) OTE(DataStructure.Flash100msPS) ,XIC(Pulse_250ms_TMR.DN) OTE(DataStructure.Flash250msPS) ,XIC(FlasherB_250ms.DN) OTE(DataStructure.Flash500msPS) ,XIC(FlasherB_500ms.DN) OTE(DataStructure.Flash1sPS) ];]]>
</Text>
</Rung>
