<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StackLight,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R10_Global,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R15_EIPMonitor,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[For small machines with no safety controller, replace g_MachineBasic.AlwaysOff with digital inputs tied to safety circuit status.

For machines using a non AB safety controller, replace g_MachineBasic.AlwaysOff with digital inputs tied to safety circuit status, or Ethernet IP safety circuit status, if available.

For machines using an AB safety PLC, replace g_MachineBasic.AlwaysOff with safety output parameters from the SafetyProgram.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SafetyCircuitReady must turn on when the safety circuit has not been energized and all safety devices are in their safe states.]]>
</Comment>
<Text>
<![CDATA[XIC(\SafetyProgram.Safe_q_Reset)OTE(SafetyCircuitReady);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[q_SafetyOK must turn on when the safety circuit has been energized.

]]>
</Comment>
<Text>
<![CDATA[XIC(\SafetyProgram.Safe_q_Status)OTE(q_SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[All State Machines In Automatic Mode]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_AutoMode)XIC(\S01_PartLoad.q_AutoMode)XIC(\S03_PartLoad.q_AutoMode)XIC(\S05_ServoPNP.q_AutoMode)XIC(\S18_RejectUnload.q_AutoMode)XIC(\S19_GoodUnload.q_AutoMode)OTE(AllSMInAuto);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[All State Machines In Cycle Stop]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_AutoStopped)XIC(\S01_PartLoad.q_AutoStopped)XIC(\S03_PartLoad.q_AutoStopped)XIC(\S05_ServoPNP.q_AutoStopped)XIC(\S18_RejectUnload.q_AutoStopped)XIC(\S19_GoodUnload.q_AutoStopped)OTE(MachineStopped);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Automatic Mode Start OK]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_StartOK)XIC(\S01_PartLoad.q_StartOK)XIC(\S03_PartLoad.q_StartOK)XIC(\S05_ServoPNP.q_StartOK)XIC(\S18_RejectUnload.q_StartOK)XIC(\S19_GoodUnload.q_StartOK)[XIC(EnableBatchCount) NE(BatchCount,HMI_BatchSetpoint) ,XIO(EnableBatchCount) ]XIO(q_MachineFaultActive)OTE(StartOK);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Light Stack Horn Override]]>
</Comment>
<Text>
<![CDATA[[XIC(\S00_IndexerSP.q_PauseRestart) ,XIC(\S00_IndexerNoSP.q_PauseRestart) ]OTE(HornOverride);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Supervisor State Machine

State 1: Safety Resetting]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[0])XIC(q_SafetyOK)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 3: Manual Mode]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) ,XIC(Status.State[6]) ,XIC(Status.State[12]) XIC(MachineStopped) ]XIO(HMI_ModeSelect)MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 4: Auto Initialize]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[1]) ,XIC(Status.State[3]) ,XIC(Status.State[12]) XIC(MachineStopped) XIO(q_MachineFaultActive) ]XIC(HMI_ModeSelect)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 6: Auto Idle]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIC(AllSMInAuto)MOVE(6,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 8: Auto Running]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])XIC(q_CycleStartLatch)MOVE(8,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Cycle Stopping]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[8])XIO(q_CycleStartLatch)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 12: Cycle Stopped]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[10])[XIC(MachineStopped) ,MOVE(10000,Control.TransitionTime) XIC(Status.TransitionTimerDone) ]MOVE(12,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(S:FS) ,XIO(q_SafetyOK) ]MOVE(0,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Cycle Start]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[6])[XIC(i_CycleStart) XIC(i_CycleStop) XIC(StartOK) ,XIC(CycleStartDelay.EN) ]TON(CycleStartDelay,?,?)XIC(CycleStartDelay.DN)[OTL(q_CycleStartLatch) ,OTL(q_MachineRunning) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(CycleStartDelay.TT)OTE(CycleStarting);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Cycle Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) ,XIC(Status.State[8]) [XIO(i_CycleStop) ,XIC(q_MachineFaultActive) ,XIC(\HMI.q_CleanoutModeStopTrig) ,XIC(EnableBatchCount) EQ(BatchCount,HMI_BatchSetpoint) ] ]OTU(q_CycleStartLatch);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(Status.State[0]) ,XIC(Status.State[12]) ]OTU(q_MachineRunning);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Machine Stop Reason]]>
</Comment>
<Text>
<![CDATA[XIC(q_CycleStartLatch)ONS(ONS.0)MOVE(0,q_MachineStopReason);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Status.State[10])ONS(ONS.1)[[XIO(i_CycleStop) ,XIC(\HMI.q_CleanoutModeStopTrig) ] MOVE(0,q_MachineStopReason) ,XIC(q_MachineFaultActive) MOVE(1,q_MachineStopReason) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Machine In Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[3])OTE(q_ManualMode);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Machine In Cycle Stopped]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[12])OTE(q_CycleStopped);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Machine Fault Active]]>
</Comment>
<Text>
<![CDATA[XIO(\Alarms.p_NoMachineFaults)OTE(q_MachineFaultActive);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Machine Warning Active]]>
</Comment>
<Text>
<![CDATA[XIO(\Alarms.p_NoMachineWarnings)OTE(MachineWarningActive);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(i_FaultReset)OTE(q_FaultReset);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StackLight" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Standard Light Control

Cycle Start Light, Machine Reset Light, Stack Light

***Must Set Parameter Connections For q_MachineResetLight, q_CycleStartLight, q_AlarmHorn, q_RedStackLight, q_AmberStackLight, q_GreenStackLight***]]>
</Comment>
<Text>
<![CDATA[LightControl(LightControl,Control.StateReg,SafetyCircuitReady,StartOK,CycleStarting,q_MachineFaultActive,MachineWarningActive,HornOverride,q_MachineResetLight,q_CycleStartLight,q_AlarmHorn,q_RedStackLight,q_AmberStackLight,q_GreenStackLight);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R10_Global" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Machine Basic - Flashers, Always On, ect.]]>
</Comment>
<Text>
<![CDATA[AOI_MachineBasic(MachineBasic,q_MachineRunning,g_MachineBasic);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Get Date & Time]]>
</Comment>
<Text>
<![CDATA[CPU_TimeDate_wJulian(CPUDateTime,g_CPUDateTime);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R15_EIPMonitor" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[EIP Status Counter - Checks One EIP Node Status Every 100ms]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.Flash100msPS)ADD(EIPStatusCount,1,EIPStatusCount);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[***NOTE - Set Source B To EIP Node Quantity]]>
</Comment>
<Text>
<![CDATA[GE(EIPStatusCount,7)MOVE(0,EIPStatusCount);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Loss Of Indexer Servo EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(g_MachineBasic.PowerUpCP) EQ(EIPStatusCount,0) AOI_EIPStatus(sd01_IndexerEIP,sd01_Indexer) XIO(sd01_IndexerEIP.ComOK) ,XIC(Alarm[0].Active) XIO(q_FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Loss Of Shot Pin Servo EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(g_MachineBasic.PowerUpCP) EQ(EIPStatusCount,1) AOI_EIPStatus(sd02_ShotPinEIP,sd02_ShotPin) XIO(sd02_ShotPinEIP.ComOK) ,XIC(Alarm[1].Active) XIO(q_FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Loss Of S05 PNP X Axis Servo EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(g_MachineBasic.PowerUpCP) EQ(EIPStatusCount,2) AOI_EIPStatus(sd03_S01PNPXAxisEIP,sd03_S01PNPXAxis) XIO(sd03_S01PNPXAxisEIP.ComOK) ,XIC(Alarm[2].Active) XIO(q_FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Loss Of S05 PNP X Axis Servo EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(g_MachineBasic.PowerUpCP) EQ(EIPStatusCount,3) AOI_EIPStatus(sd04_S01PNPZAxisEIP,sd04_S01PNPZAxis) XIO(sd04_S01PNPZAxisEIP.ComOK) ,XIC(Alarm[3].Active) XIO(q_FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Loss Of Main Machine Point I/O EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(g_MachineBasic.PowerUpCP) EQ(EIPStatusCount,4) AOI_EIPStatus(io01_MainMachineEIP,io01_MainMachine) XIO(io01_MainMachineEIP.ComOK) ,XIC(Alarm[4].Active) XIO(q_FaultReset) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Loss Of Main Machine Valve Bank EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(g_MachineBasic.PowerUpCP) EQ(EIPStatusCount,5) AOI_EIPStatus(vb01_MainMachineEIP,vb01_MainMachine) XIO(vb01_MainMachineEIP.ComOK) ,XIC(Alarm[5].Active) XIO(q_FaultReset) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Loss Of Camera 1 EIP]]>
</Comment>
<Text>
<![CDATA[[XIC(g_MachineBasic.PowerUpCP) EQ(EIPStatusCount,6) AOI_EIPStatus(cam01_InspectionEIP,cam01_Inspection) XIO(cam01_InspectionEIP.ComOK) ,XIC(Alarm[6].Active) XIO(q_FaultReset) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Batch Counter Complete]]>
</Comment>
<Text>
<![CDATA[XIC(EnableBatchCount)EQ(BatchCount,HMI_BatchSetpoint)[OTE(Alarm[7].Active) ,MOVE(1,Alarm[7].Severity) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
