<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Nest & Station Numbers]]>
</Comment>
<Text>
<![CDATA[[MOVE(1,StaNum) MOVE(20,StaNumPre) ,MOVE(\Tracking.p_Data.Station[StaNum].NestNum,NestNumCurrent) MOVE(\Tracking.p_Data.Station[StaNumPre].NestNum,NestNumIncoming) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Mapped/debounced inputs]]>
</Comment>
<Text>
<![CDATA[XIO(i_ZAxisRetracted)XIC(q_ExtendZAxis)XIO(q_RetractZAxis)TON(ZAxisExtendedDelay,?,?)XIC(ZAxisExtendedDelay.DN)OTE(ZAxisExtended);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(i_ZAxisRetracted)XIC(q_RetractZAxis)XIO(q_ExtendZAxis)OTE(ZAxisRetracted);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(i_XAxisExtended)XIO(i_XAxisRetracted)XIC(q_ExtendXAxis)XIO(q_RetractXAxis)OTE(XAxisExtended);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(i_XAxisRetracted)XIO(i_XAxisExtended)XIC(q_RetractXAxis)XIO(q_ExtendXAxis)OTE(XAxisRetracted);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[AOI_Debounce(PartPresentDebounce,i_PartPresent,100,100);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(q_OpenGripper)XIO(q_CloseGripper)TON(OpenGripperDelay,?,?)XIC(OpenGripperDelay.DN)OTE(GripperOpened);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(q_CloseGripper)XIO(q_OpenGripper)TON(CloseGripperDelay,?,?)XIC(CloseGripperDelay.DN)OTE(GripperClosed);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStartLatch)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(PartStarted)XIC(i_ZAxisRetracted)[XIC(GripperOpened) XIC(i_XAxisRetracted) XIO(i_XAxisExtended) ,XIC(GripperClosed) XIC(i_XAxisExtended) XIO(i_XAxisRetracted) ]OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)XIO(ManualMode)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Dry run logic (can add supervisor dry run condition if needed as parallel branch)]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.DryRun)OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.SingleStep)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Cycle Station]]>
</Comment>
<Text>
<![CDATA[XIO(\Tracking.p_Data.Nest[NestNumCurrent].OpStatus.Lockout)XIO(\HMI.q_CleanoutModeEnabled)[XIO(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) OTE(CycleStationA) ,OTE(CycleStationB) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[99]) XIO(CycleRunning) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[4]) ,XIC(Status.State[19]) ,XIC(Status.State[31]) XIC(XAxisRetracted) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Start of sequence, wait for part present]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ] XIC(GripperOpened) ,XIC(Status.State[31]) XIC(XAxisRetracted) ]XIC(CycleRunning)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Extend z axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])[XIC(PartPresentDebounce.On) ,XIC(DryRun) ]XIC(SS_OK)MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Close gripper]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[7])XIC(ZAxisExtended)XIC(SS_OK)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: Retract z axis]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) ,XIC(Status.State[2]) XIO(Initialized) XIC(PartStarted) XIC(CycleRunning) ]XIC(GripperClosed)XIC(SS_OK)MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 16: Extend x axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])XIC(ZAxisRetracted)XIC(SS_OK)MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 19: Wait for index complete]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ] XIC(GripperClosed) XIC(CycleRunning) ,XIC(Status.State[16]) XIC(XAxisExtended) ]MOVE(19,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 22: Extend z axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[19])XIC(\S00_IndexerSP.q_WaitStationsComplete)XIC(CycleStationA)XIC(SS_OK)MOVE(22,Control.StateReg)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 25: Open gripper]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[22])XIC(ZAxisExtended)XIC(SS_OK)MOVE(25,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 28: Retract z axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])XIC(GripperOpened)XIC(SS_OK)MOVE(28,Control.StateReg)[OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded) ,OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 31: Retract x axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[28])XIC(ZAxisRetracted)XIC(SS_OK)MOVE(31,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 99: Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(Lockout)MOVE(99,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 100:Start of initialization sequence, retract z axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIO(PartStarted)XIC(CycleRunning)XIC(SS_OK)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 103: Initialization retract x axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(ZAxisRetracted)XIC(GripperOpened)XIC(SS_OK)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 106: Initialization extend x axis]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(ZAxisRetracted)XIC(GripperClosed)XIC(SS_OK)MOVE(106,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 124: Initialization complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[103]) XIC(XAxisRetracted) ,XIC(Status.State[106]) XIC(XAxisExtended) ]MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)XIC(g_MachineBasic.AlwaysOff)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,98) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,98) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Actuators Safe For Index]]>
</Comment>
<Text>
<![CDATA[[XIC(XAxisRetracted) ,XIC(ZAxisRetracted) ]OTE(q_ActuatorsSafe);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Pause Request To Indexer]]>
</Comment>
<Text>
<![CDATA[XIC(Alarm[0].Active)OTE(q_Pause);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Set the part started bit once the process gets to a point where if interrupted you want to resume or perform some other operation upon restart. Use states and/or part tracking to set this bit. Fill in additional conditions to clear this bit if necessary.]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) ,XIC(PartStarted) XIO(Status.State[28]) XIO(g_MachineBasic.PowerUpCP) XIO(GripperClosed) ]OTE(PartStarted);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Set Part Tracking If Station Is Locked Out]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)XIC(Status.State[99])XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Station Complete]]>
</Comment>
<Text>
<![CDATA[XIC(\S00_IndexerSP.q_WaitStationsComplete)[XIC(CycleStationB) [XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout) ] ,XIO(CycleStationB) ]OTE(q_StationComplete);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[X Axis Control]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[1])XIC(ZAxisRetracted)[XIC(HMI_Momentary.0) OTE(OkManExtendX) ,XIC(HMI_Momentary.1) OTE(OkManRetractX) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[16]) ,XIC(Status.State[106]) ,XIC(q_ExtendXAxis) XIO(Status.State[31]) XIO(Status.State[103]) ] ,XIC(Status.State[1]) [XIC(OkManExtendX) ,XIC(q_ExtendXAxis) XIO(OkManRetractX) ] ]OTE(q_ExtendXAxis);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[31]) ,XIC(Status.State[103]) ,XIC(q_RetractXAxis) XIO(Status.State[16]) XIO(Status.State[106]) ] ,XIC(Status.State[1]) [XIC(OkManRetractX) ,XIC(q_RetractXAxis) XIO(OkManExtendX) ] ]OTE(q_RetractXAxis);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Z Axis Control]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[7]) ,XIC(Status.State[22]) ,XIC(q_ExtendZAxis) XIO(Status.State[13]) XIO(Status.State[28]) XIO(Status.State[100]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.2) [XIC(XAxisExtended) ,XIC(XAxisRetracted) ] ,XIC(q_ExtendZAxis) XIO(HMI_Momentary.3) ] ]OTE(q_ExtendZAxis);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[13]) ,XIC(Status.State[28]) ,XIC(Status.State[100]) ,XIC(q_RetractZAxis) XIO(Status.State[7]) XIO(Status.State[22]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.3) ,XIC(q_RetractZAxis) [XIO(HMI_Momentary.2) ,XIO(XAxisExtended) ,XIO(XAxisRetracted) ] ] ]OTE(q_RetractZAxis);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Gripper Control]]>
</Comment>
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[10]) ,XIC(q_CloseGripper) XIO(Status.State[25]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.4) ,XIC(q_CloseGripper) XIO(HMI_Momentary.5) ] ]OTE(q_CloseGripper);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIO(Status.State[1]) [XIC(Status.State[25]) ,XIC(q_OpenGripper) XIO(Status.State[10]) ] ,XIC(Status.State[1]) [XIC(HMI_Momentary.5) ,XIC(q_OpenGripper) XIO(HMI_Momentary.4) ] ]OTE(q_OpenGripper);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Station Performance]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)StationPerformance(StationPerformance,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success,g_PresetStationPerformLow,g_PresetStationPerformHigh,\Tracking.p_Data.Station[StaNum].PerformData.Attempts,\Tracking.p_Data.Station[StaNum].PerformData.Successes,\Tracking.p_Data.Station[StaNum].PerformData.Failures,\Tracking.p_Data.Station[StaNum].PerformData.Efficiency,\Tracking.p_Data.Station[StaNum].PerformData.HMIColorStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Waiting For Part Present]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])MOVE(10000,Control.FaultTime)XIC(Status.TimeoutFlt)[OTE(Alarm[0].Active) ,ONS(ONS.5) MOVE(1,Alarm[0].Severity) CONCAT(g_StationList[StaNum],AlarmList[0],Alarm[0].Message) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Extend]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_ExtendXAxis) XIO(XAxisExtended) TON(AlarmTimerXAxisExtended,?,?) XIC(AlarmTimerXAxisExtended.DN) ,XIC(Alarm[1].Active) XIO(FaultReset) ][OTE(Alarm[1].Active) ,ONS(ONS.6) CONCAT(g_StationList[StaNum],AlarmList[1],Alarm[1].Message) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Waiting For X Axis To Retract]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractXAxis) XIO(XAxisRetracted) TON(AlarmTimerXAxisRetracted,?,?) XIC(AlarmTimerXAxisRetracted.DN) ,XIC(Alarm[2].Active) XIO(FaultReset) ][OTE(Alarm[2].Active) ,ONS(ONS.7) CONCAT(g_StationList[StaNum],AlarmList[2],Alarm[2].Message) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[X Axis Sensors/Outputs Misconfigured]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[[XIC(q_RetractXAxis) XIC(q_ExtendXAxis) ,XIC(i_XAxisExtended) XIC(i_XAxisRetracted) ] TON(AlarmTimerXAxisMisconfigured,?,?) XIC(AlarmTimerXAxisMisconfigured.DN) ,XIC(Alarm[3].Active) XIO(FaultReset) ][OTE(Alarm[3].Active) ,ONS(ONS.8) CONCAT(g_StationList[StaNum],AlarmList[3],Alarm[3].Message) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For Z Axis To Extend]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_ExtendZAxis) XIO(ZAxisExtended) TON(AlarmTimerZAxisExtended,?,?) XIC(AlarmTimerZAxisExtended.DN) ,XIC(Alarm[4].Active) XIO(FaultReset) ][OTE(Alarm[4].Active) ,ONS(ONS.9) CONCAT(g_StationList[StaNum],AlarmList[4],Alarm[4].Message) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Z Axis To Retract]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractZAxis) XIO(ZAxisRetracted) TON(AlarmTimerZAxisRetracted,?,?) XIC(AlarmTimerZAxisRetracted.DN) ,XIC(Alarm[5].Active) XIO(FaultReset) ][OTE(Alarm[5].Active) ,ONS(ONS.10) CONCAT(g_StationList[StaNum],AlarmList[5],Alarm[5].Message) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Z Axis Sensors/Outputs Misconfigured]]>
</Comment>
<Text>
<![CDATA[XIO(Lockout)[XIC(q_RetractZAxis) XIC(q_ExtendZAxis) TON(AlarmTimerZAxisMisconfigured,?,?) XIC(AlarmTimerZAxisMisconfigured.DN) ,XIC(Alarm[6].Active) XIO(FaultReset) ][OTE(Alarm[6].Active) ,ONS(ONS.11) CONCAT(g_StationList[StaNum],AlarmList[6],Alarm[6].Message) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
