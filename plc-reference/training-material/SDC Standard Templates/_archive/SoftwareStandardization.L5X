<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.4)MAJ(Axis,Axis_MAJ,HomeDirection,HomingSpeed,Units per sec,50,Units per sec2,50,Units per sec2,Trapezoidal,0,0,Units per sec3,Disabled,0,0,None)XIC(Axis_MAJ.IP)MOVE(5,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.5)[XIC(Axis.OvertorqueLimitFault) ,XIC(Axis.ExcessivePositionErrorFault) ]XIO(Axis.ServoActionStatus)MOVE(6,TorqueHome_CS);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.6)MAFR(Axis,Axis_MAFR)EQ(Axis.AxisFault,0)[SSV(Axis,Axis,TorqueLimitNegative,RunTorque) ,MOVE(0,OvertorqueLimitTime) SSV(Axis,Axis,OvertorqueLimitTime,OvertorqueLimitTime) ,MOVE(1,SoftOTCheck) SSV(Axis,Axis,SoftTravelLimitChecking,SoftOTCheck) ]MOVE(1000,TorqueHome_ST6A_TMR.PRE)TON(TorqueHome_ST6A_TMR,?,?)XIC(TorqueHome_ST6A_TMR.DN)MOVE(7,TorqueHome_CS);]]>
