<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(TorqueHome_SW.6)MAFR(Axis,Axis_MAFR)EQ(Axis.AxisFault,0)[SSV(Axis,Axis,TorqueLimitNegative,RunTorque) ,MOVE(0,OvertorqueLimitTime) SSV(Axis,Axis,OvertorqueLimitTime,OvertorqueLimitTime) ,MOVE(1,SoftOTCheck) SSV(Axis,Axis,SoftTravelLimitChecking,SoftOTCheck) ]MOVE(1000,TorqueHome_ST6A_TMR.PRE)TON(TorqueHome_ST6A_TMR,?,?)XIC(TorqueHome_ST6A_TMR.DN)MOVE(7,TorqueHome_CS);]]>
