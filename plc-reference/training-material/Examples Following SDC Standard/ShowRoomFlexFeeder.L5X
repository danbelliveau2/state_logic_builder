<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Flasher Control]]>
</Comment>
<Text>
<![CDATA[[XIO(FlasherB_250ms.DN) MOVE(250,FlasherA_250ms.PRE) TON(FlasherA_250ms,?,?) ,XIC(FlasherA_250ms.DN) MOVE(250,FlasherB_250ms.PRE) TON(FlasherB_250ms,?,?) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(FlasherB_500ms.DN) MOVE(500,FlasherA_500ms.PRE) TON(FlasherA_500ms,?,?) ,XIC(FlasherA_500ms.DN) MOVE(500,FlasherB_500ms.PRE) TON(FlasherB_500ms,?,?) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(FlasherB_1s.DN) MOVE(1000,FlasherA_1s.PRE) TON(FlasherA_1s,?,?) ,XIC(FlasherA_1s.DN) MOVE(1000,FlasherB_1s.PRE) TON(FlasherB_1s,?,?) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Machine Reset]]>
</Comment>
<Text>
<![CDATA[[NE(SupervisorState,0) ,EQ(SupervisorState,0) XIC(SafetyResetReady) XIC(FlasherB_500ms.TT) ]OTE(MachineResetLight);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Cycle Start Light & Green Stack Light]]>
</Comment>
<Text>
<![CDATA[[EQ(SupervisorState,8) ,EQ(SupervisorState,6) [XIO(CycleStarting) XIC(AutoPreOK) XIC(FlasherB_500ms.TT) ,XIC(CycleStarting) XIC(FlasherB_250ms.TT) ] ][OTE(CycleStartLight) ,OTE(GreenStackLight) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Amber Stack Light]]>
</Comment>
<Text>
<![CDATA[[EQ(SupervisorState,3) ,[EQ(SupervisorState,5) ,EQ(SupervisorState,6) ] XIC(WarningActive) XIC(FlasherB_500ms.TT) ]OTE(AmberStackLight);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Red Stack Light]]>
</Comment>
<Text>
<![CDATA[[EQ(SupervisorState,0) ,NE(SupervisorState,0) XIC(FaultActive) XIC(FlasherB_500ms.TT) ]OTE(RedStackLight);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Horn Chirp]]>
</Comment>
<Text>
<![CDATA[EQ(SupervisorState,6)XIC(WarningActive)[XIO(ChirpTimerA.DN) MOVE(10000,ChirpTimerA.PRE) TON(ChirpTimerA,?,?) ,XIC(ChirpTimerA.DN) OTL(ChirpLatch) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(ChirpLatch)MOVE(100,ChirpTimerB.PRE)TON(ChirpTimerB,?,?)OTU(ChirpLatch);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Alarm Horn]]>
</Comment>
<Text>
<![CDATA[[XIC(FaultActive) MOVE(500,HornDelayOn.PRE) TON(HornDelayOn,?,?) XIC(HornDelayOn.DN) XIC(FlasherB_1s.TT) MOVE(3,AlarmCounter.PRE) CTU(AlarmCounter,?,?) XIO(AlarmCounter.DN) ,XIC(CycleStarting) ,XIC(ChirpLatch) ]OTE(AlarmHorn);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
