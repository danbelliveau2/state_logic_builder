<ScheduledPrograms>
<ScheduledProgram Name="MapInputs"/>
<ScheduledProgram Name="Supervisor"/>
<ScheduledProgram Name="P01_Robot"/>
<ScheduledProgram Name="P02_Conveyor"/>
<ScheduledProgram Name="Production"/>
<ScheduledProgram Name="Alarms"/>
<ScheduledProgram Name="HMI"/>
<ScheduledProgram Name="MapOutputs"/>
</ScheduledPrograms>
</Task>
<Task Name="SafetyTask" Type="PERIODIC" Rate="20" Priority="10" Watchdog="20" DisableUpdateOutputs="false" InhibitTask="false" Class="Safety">
<ScheduledPrograms>
<ScheduledProgram Name="SafetyProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
