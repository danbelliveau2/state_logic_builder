<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_StateTransitions,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_StateLogic,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Logic inputs]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_FaultReset) ,XIC(Debud_DINT.0) ]OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(\Supervisor.q_CycleStartLatch) ,XIC(debug_Cyclerunning) ]OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)OTE(MachineRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIO(Status.State[2])XIO(Status.State[3])OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(i_RobotStatus.UserIn1.3) ,XIC(i_RobotStatus.Paused) XIC(i_RobotStatus.UserIn1.4) ]OTE(Initialized);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[In Conveyor Pick Window

***Low & High Limits Must Be Populated At Startup***]]>
</Comment>
<Text>
<![CDATA[LIMIT(-480,i_RobotEDAIn.CURPOS_G1.X,185)LIMIT(-460,i_RobotEDAIn.CURPOS_G1.Y,-225)OTE(InConvPickWindow);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Lockout]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Toggle.0)OTE(Lockout);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Dry run logic (can add supervisor dry run condition if needed as parallel branch)]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Toggle.1)OTE(DryRun);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[AOI_EIPStatus(EIP_Robot,rob01_FlexFeeder);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Single Step Logic]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Toggle.2)OTE(SS);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIO(SS) ,XIC(LocalSSONS) ONS(ONS.1) ]OTE(SS_OK);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Clear HMI Manual Triggers]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_MomentaryOnPrevScan)TON(hmitimer,?,?)XIC(hmitimer.DN)MOVE(0,HMI_Momentary);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[NE(HMI_Momentary,0)OTE(HMI_MomentaryOnPrevScan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_StateTransitions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start Of State Machine]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State 2: Auto mode idle not ready]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[0]) XIC(SafetyOK) ,XIC(Status.State[1]) XIO(ManualMode) ,[XIC(Status.State[3]) ,XIC(CycleStopped) ] XIO(Initialized) ,XIC(Status.State[127]) XIO(q_AlarmActive) ]MOVE(2,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State 3: Auto mode idle ready]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[2]) ,XIC(CycleStopped) ] XIC(Initialized) ,[XIC(Status.State[40]) ,XIC(Status.State[124]) ] XIO(CycleRunning) ]MOVE(3,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State 4: Check If Program Running]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[3]) XIC(Initialized) ,XIC(Status.State[124]) ]XIC(CycleRunning)MOVE(4,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State 7: Start Program (Not Paused)]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) XIO(i_RobotStatus.Running) [XIO(i_RobotStatus.Paused) ,XIO(i_RobotStatus.UserIn1.4) ] ,XIC(Status.State[31]) MOVE(150,Control.TransitionTime) XIC(Status.TransitionTimerDone) ]MOVE(7,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State 10: Start Program (Paused)]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[4])XIO(i_RobotStatus.Running)XIC(i_RobotStatus.Paused)XIC(i_RobotStatus.UserIn1.4)MOVE(10,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State 13: Trigger PK Main Program]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) XIC(i_RobotStatus.Running) EQ(i_RobotEDAIn.R60,0) XIC(i_RobotStatus.UserIn1.0) ,XIC(Status.State[4]) XIC(i_RobotStatus.Running) ]MOVE(13,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State 16: PK Main Running]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[10]) XIC(i_RobotStatus.Running) ,XIC(Status.State[13]) ]EQ(i_RobotEDAIn.R60,4)XIO(i_RobotStatus.UserIn1.0)MOVE(16,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State 25: Abort Program After Collision Guard Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])XIC(i_RobotStatus.UserIn1.5)XIO(i_RobotStatus.Running)XIC(InConvPickWindow)MOVE(25,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State 28: Reset Collision Guard Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[25])XIO(i_RobotStatus.Paused)TON(StateTimer[25],?,?)XIC(StateTimer[25].DN)MOVE(28,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State 31: Delay To Restart Program After Collision Guard Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[28])XIO(i_RobotStatus.Fault)TON(StateTimer[28],?,?)XIC(StateTimer[28].DN)MOVE(31,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State 34: Stop Robot Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])XIO(CycleRunning)[XIO(i_RobotStatus.UserIn5.6) ,XIC(i_RobotStatus.UserIn5.6) XIO(i_RobotStatus.UserIn1.4) ]TON(StateTimer[16],?,?)XIC(StateTimer[16].DN)MOVE(34,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[State 37: Pause Robot Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[16])XIO(CycleRunning)XIC(i_RobotStatus.UserIn5.6)XIC(i_RobotStatus.UserIn1.4)MOVE(37,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[State 40: Stop Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[34]) XIO(i_RobotStatus.Running) ,XIC(Status.State[37]) XIC(i_RobotStatus.Paused) ]MOVE(40,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[State 100: Initialize Start Robot Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[2])XIO(Initialized)XIC(CycleRunning)MOVE(100,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[State 103: Initialize Trigger Safe Home Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[100])XIC(i_RobotStatus.Running)EQ(i_RobotEDAIn.R60,0)XIC(i_RobotStatus.UserIn1.0)MOVE(103,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[State 106: Wait For Safe Home Program Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[103])EQ(i_RobotEDAIn.R60,100)XIO(i_RobotStatus.UserIn1.0)MOVE(106,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[State 124: Initialization Complete]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[106])EQ(i_RobotEDAIn.R60,0)XIC(i_RobotStatus.UserIn1.0)XIC(i_RobotStatus.UserIn1.3)MOVE(124,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Restart Logic

*Use the part status at this station to determine a course of action here. 
For instance, no attempt made, no part present, no success or failure status at this station indicates initialization is in order. If an attempt was made with no success or failure, restart at last state may be in order.
Also, you do not always need to go into the state you left. Some cases require you to go into the prior state to restart a particular portion of the sequence.]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)XIC(Status.State[2])XIC(UseRestartLogic)XIC(CycleRunning)MOVE(RestartState,FaultState);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[State 127: Fault]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)[ONS(ONS.2) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,FaultState) MOVE(Control.StateReg,RestartState) ,MOVE(127,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[State 1: Manual Mode]]>
</Comment>
<Text>
<![CDATA[XIC(ManualMode)MOVE(1,Control.StateReg);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[State 0: Safety Stop]]>
</Comment>
<Text>
<![CDATA[[XIO(SafetyOK) ,XIC(S:FS) ][ONS(ONS.3) LIMIT(4,Control.StateReg,99) MOVE(Control.StateReg,SafetyStopState) MOVE(Control.StateReg,RestartState) ,MOVE(0,Control.StateReg) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[State_Engine_128Max(StateEngine,Control,Status,StateHistory);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Cycle Time

**Limit Instruction Low & High Limits Populated WIth Range Of States In Which Station Is Running (Example, PNP Is Picking & Placing A Part)
**Cycle Complete State Shown As Example]]>
</Comment>
<Text>
<![CDATA[[XIO(i_RobotStatus.UserIn5.6) ONS(ONS.4) DIV(CycleTimer.ACC,1000,p_CycleTime) RES(CycleTimer) ,LIMIT(4,Control.StateReg,99) RTO(CycleTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[25 Cycle Average]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIO(i_RobotStatus.UserIn5.6)ONS(ONS.7)MovingAverage(MovingAverageA,p_CycleTime,25);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[100 Cycle Average]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIO(i_RobotStatus.UserIn5.6)ONS(ONS.8)MovingAverage(MovingAverageB,p_CycleTime,100);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_StateLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Output Status to Supervisor

*Replace always off with real conditions]]>
</Comment>
<Text>
<![CDATA[XIO(i_RobotStatus.TP)XIC(i_RobotStatus.UserIn5.7)XIC(i_RobotStatus.Ready)XIO(i_RobotStatus.Fault)OTE(q_StartOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ]XIO(CycleRunning)OTE(q_AutoMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Status.State[2]) ,XIC(Status.State[3]) ,XIC(Status.State[127]) ]XIO(CycleRunning)OTE(q_AutoStopped);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Safety OK To Robot]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOn)[OTE(q_RobotControl.IMSTP) ,XIO(Status.State[37]) OTE(q_RobotControl.Hold) ,OTE(q_RobotControl.SFSPD) ,OTE(q_RobotControl.Enable) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Abort Robot Program]]>
</Comment>
<Text>
<![CDATA[[[XIC(i_RobotStatus.Fault) ,XIO(i_RobotStatus.UserIn5.6) ,XIO(MachineRunning) NE(RobotRecipeNumber,RobotRecipeNumberPre) ] XIC(i_RobotStatus.Paused) ,XIC(Status.State[25]) ,XIC(Status.State[127]) XIC(i_RobotStatus.Running) ]XIC(g_MachineBasic.Flash250msPD)OTE(q_RobotControl.CycleStop);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Start Signal To Robot]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[7]) ,XIC(Status.State[10]) ,XIC(Status.State[100]) ]XIC(g_MachineBasic.Flash250msPD)[XIC(i_RobotStatus.Paused) OTE(q_RobotControl.RemoteStart) ,XIO(i_RobotStatus.Paused) OTE(q_RobotControl.Start) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Stop Signal To Robot]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[34])OTE(q_RobotControl.UserOut5.7);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Auto Confirm]]>
</Comment>
<Text>
<![CDATA[XIC(EIP_Robot.ComOK)XIO(i_RobotStatus.TP)XIC(i_RobotStatus.UserIn5.7)TON(AutoConfirmDelay,?,?)XIC(AutoConfirmDelay.TT)OTE(q_RobotControl.UserOut5.5);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Safety Fault Reset]]>
</Comment>
<Text>
<![CDATA[XIC(SafetyOK)TON(SafetyResetDelay,?,?)XIC(SafetyResetDelay.DN)ONS(ONS.5)OTL(SafetyResetLatch);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(SafetyResetLatch)XIO(i_RobotStatus.Fault)OTU(SafetyResetLatch);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Fault Reset Signal To Robot]]>
</Comment>
<Text>
<![CDATA[[[XIC(SafetyResetLatch) ,XIC(AutoConfirmDelay.TT) ] XIO(i_RobotStatus.TP) XIC(i_RobotStatus.UserIn5.7) ,XIC(Status.State[28]) ,XIC(FaultReset) ]XIC(i_RobotStatus.Fault)XIC(g_MachineBasic.Flash250msPD)OTE(q_RobotControl.FaultReset);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Robot Running]]>
</Comment>
<Text>
<![CDATA[XIC(MachineRunning)XIC(i_RobotStatus.Running)OTE(q_RobotRunning);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Pick Tool Conveyor Stop]]>
</Comment>
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn1.2)OTE(q_ProcessConveyorStop);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Chute Drop Select]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Toggle.4)OTE(q_RobotControl.UserOut1.0);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Turn On Vision Lights]]>
</Comment>
<Text>
<![CDATA[XIC(\P02_Conveyor.q_VisionLights)OTE(q_RobotControl.UserOut1.1);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Turn On Vibratory Feeder]]>
</Comment>
<Text>
<![CDATA[XIC(\P02_Conveyor.q_VibratoryFeeder)OTE(q_RobotControl.UserOut1.3);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Puzzle Table Reset Counts
]]>
</Comment>
<Text>
<![CDATA[XIC(i_TableRetracted)[ONS(ONS.24) OTL(q_BannerState.4) ,OTE(q_RobotControl.UserOut1.5) ,XIO(ManualMode) TON(TMR_PartsDropped,?,?) ,XIC(TMR_PartsDropped.DN) OTU(RecipeChange) OTU(HMI_Toggle.13) MOVE(0,q_BannerState) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Puzzle Table Cylinder Control
]]>
</Comment>
<Text>
<![CDATA[[XIO(ManualMode) [XIC(i_RobotStatus.UserIn1.6) GT(TMR_PartsDropped.ACC,850) ,XIC(TMR_PartsDropped.DN) ,XIC(q_FlexFeederSol_Ext) ] XIO(Timer[3].DN) XIO(RecipeChange) ,XIC(ManualMode) [XIC(HMI_Momentary.0) ,XIC(q_FlexFeederSol_Ext) XIO(HMI_Momentary.4) ] ]OTE(q_FlexFeederSol_Ext);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIO(q_FlexFeederSol_Ext)XIO(i_TableRetracted)OTE(q_FlexFeederSol_Ret);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Ok To Place Puzzle Pieces On Pneumatic Shelf]]>
</Comment>
<Text>
<![CDATA[XIC(i_TableExtended)TON(Timer[0],?,?)XIC(Timer[0].DN)[OTE(q_RobotControl.UserOut1.4) ,ONS(ONS.19) OTU(q_BannerState.4) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Puzzle Animation Logic For HMI

]]>
</Comment>
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn2.0)OTE(HMI_Toggle.10);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn2.1)OTE(HMI_Toggle.11);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn2.2)OTE(HMI_Toggle.12);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn2.3)ONS(ONS.20)[OTL(HMI_Toggle.13) ,OTL(q_BannerState.3) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(q_BannerState.3)TON(Timer[3],?,?);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Banner LED Display Logic Bits From Robot Found Parts


]]>
</Comment>
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn2.4)ONS(ONS.10)OTL(q_BannerState.0);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn2.5)ONS(ONS.11)OTL(q_BannerState.1);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn2.6)ONS(ONS.12)OTL(q_BannerState.2);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(i_RobotStatus.UserIn5.6)OTE(p_RobotGripperClosed);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Trigger PK Main Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[13])MOVE(4,q_RobotEDAOut.R50);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Trigger Safe Home Program]]>
</Comment>
<Text>
<![CDATA[XIC(Status.State[103])MOVE(100,q_RobotEDAOut.R50);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Load Recipe Number:

1 - Blue Background Parts
2- White Background Parts
3- Both Blue & White Parts
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(HMI_Momentary.1)OTU(RobotRecipe_Two)OTU(RobotRecipe_Three)OTL(RobotRecipe_One);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIC(HMI_Momentary.2)OTU(RobotRecipe_One)OTU(RobotRecipe_Three)OTL(RobotRecipe_Two);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(HMI_Momentary.3)OTU(RobotRecipe_One)OTU(RobotRecipe_Two)OTL(RobotRecipe_Three);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[[XIC(RobotRecipe_One) ONS(ONS.21) MOVE(1,RobotRecipeNumber) OTL(RecipeChange) ,XIC(RobotRecipe_Two) ONS(ONS.22) MOVE(2,RobotRecipeNumber) OTL(RecipeChange) ,XIC(RobotRecipe_Three) ONS(ONS.23) MOVE(3,RobotRecipeNumber) OTL(RecipeChange) ];]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[Trigger Robot Recipe Change]]>
</Comment>
<Text>
<![CDATA[[XIO(MachineRunning) XIC(i_RobotStatus.Ready) XIO(i_RobotStatus.Fault) XIO(i_RobotStatus.Running) XIO(i_RobotStatus.Paused) NE(RobotRecipeNumber,RobotRecipeNumberPre) ,XIC(RobotRecipe.Error) [XIC(FaultReset) ,XIC(DebugRecipe) ] TON(RobotRecipeFaultDelay,?,?) XIC(RobotRecipeFaultDelay.DN) ONS(ONS.6) ,XIC(RobotRecipe.IP) ][AOI_FanucRecipe(RobotRecipe,i_RobotStatus.UserIn4.6,i_RobotStatus.UserIn4.7,i_RobotStatus.UserIn5.0,i_RobotStatus.UserIn5.1,i_RobotStatus.UserWord1,q_RobotControl.UserOut4.6,q_RobotControl.UserOut4.7,q_RobotControl.UserWord1,RobotRecipeNumber) ,MOVE(RobotRecipeNumber,RobotRecipeNumberPre) ];]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[Clear R50]]>
</Comment>
<Text>
<![CDATA[NE(i_RobotEDAIn.R60,0)MOVE(0,q_RobotEDAOut.R50);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Is Faulted]]>
</Comment>
<Text>
<![CDATA[[XIC(i_RobotStatus.Fault) XIO(i_RobotStatus.UserIn1.5) XIO(Status.State[28]) ,XIC(Alarm[0].Active) XIO(FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Robot Program In Incorrect State]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[4]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[1].Active) XIO(FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Robot Program Did Not Start]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[7]) ,XIC(Status.State[10]) ,XIC(Status.State[100]) ] XIO(i_RobotStatus.Running) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[2].Active) XIO(FaultReset) ]OTE(Alarm[2].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Robot Handshakes Incorrect]]>
</Comment>
<Text>
<![CDATA[[[XIC(Status.State[7]) [NE(i_RobotEDAIn.R60,0) ,XIO(i_RobotStatus.UserIn1.0) ] ,XIC(Status.State[10]) [NE(i_RobotEDAIn.R60,4) ,XIO(i_RobotStatus.UserIn1.0) ] ] MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[3].Active) XIO(FaultReset) ]OTE(Alarm[3].Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Waiting For PK Main Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[13]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[4].Active) XIO(FaultReset) ]OTE(Alarm[4].Active);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Waiting For Program To Abort]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[25]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[5].Active) XIO(FaultReset) ]OTE(Alarm[5].Active);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Waiting For Fault To Reset]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[28]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[6].Active) XIO(FaultReset) ]OTE(Alarm[6].Active);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Waiting For Program To Stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[34]) MOVE(5000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[7].Active) XIO(FaultReset) ]OTE(Alarm[7].Active);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Waiting For Program To Pause]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[37]) MOVE(2000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[8].Active) XIO(FaultReset) ]OTE(Alarm[8].Active);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Waiting For Safe Home Program To Start]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[103]) MOVE(1000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[9].Active) XIO(FaultReset) ]OTE(Alarm[9].Active);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Waiting For Safe Home Program To Complete]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[106]) MOVE(10000,Control.FaultTime) XIC(Status.TimeoutFlt) ,XIC(Alarm[10].Active) XIO(FaultReset) ]OTE(Alarm[10].Active);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Collision Guard Outside Of Pick Window]]>
</Comment>
<Text>
<![CDATA[[XIC(Status.State[16]) XIC(i_RobotStatus.UserIn1.5) XIO(i_RobotStatus.Running) XIO(InConvPickWindow) ,XIC(Alarm[11].Active) XIO(FaultReset) ]OTE(Alarm[11].Active);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(ProgramFaultHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
