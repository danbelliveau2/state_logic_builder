<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[OTE(DataStructure.AlwaysOn) ,XIO(DataStructure.AlwaysOn) OTE(DataStructure.AlwaysOff) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(DataStructure.AlwaysOn)[MOVE(2000,PowerUp_TMR.PRE) TON(PowerUp_TMR,?,?) XIC(PowerUp_TMR.DN) OTE(DataStructure.PowerUpCP) ,MOVE(60000,MotionUp_TMR.PRE) TON(MotionUp_TMR,?,?) XIC(MotionUp_TMR.DN) OTE(DataStructure.MotionUpCP) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(RunStatus) MOVE(3600000,HourTimer.PRE) RTO(HourTimer,?,?) ,XIC(HourTimer.DN) ADD(HourRuntime,1,HourRuntime) RES(HourTimer) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Flasher Control]]>
</Comment>
<Text>
<![CDATA[[XIO(FlasherB_250ms.DN) MOVE(250,FlasherA_250ms.PRE) TON(FlasherA_250ms,?,?) ,XIC(FlasherA_250ms.DN) MOVE(250,FlasherB_250ms.PRE) TON(FlasherB_250ms,?,?) ];]]>
