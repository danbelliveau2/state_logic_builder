<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(IP)OTU(IP);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(EnableIn)XIO(IP)[CLR(Recipe_CS) ,OTL(IP) ,OTU(PC) ,OTU(Error) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.0)XIC(Ready)MOVE(1,Recipe_CS)MOVE(8,Command);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.1)EQ(Echo,8)XIO(Ready)MOVE(2,Recipe_CS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.2)XIC(Ready)MOVE(3,Recipe_CS)MOVE(RecipeNumber,Command);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.3)EQ(Echo,RecipeNumber)XIO(Ready)MOVE(4,Recipe_CS);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Recipe_SW.4)XIC(Success)MOVE(5,Recipe_CS)OTL(PC)OTU(IP);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(IP) XIC(FaultTimer.DN) ,[XIC(Recipe_SW.1) ,XIC(Recipe_SW.2) ,XIC(Recipe_SW.3) ,XIC(Recipe_SW.4) ] [XIC(Failure) ,XIC(ProgramError) ] ]MOVE(31,Recipe_CS)OTL(Error)OTU(IP);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[CLR(Recipe_SW) ,OTE(Recipe_SW.[Recipe_CS]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(Recipe_SW.0) ,XIC(Recipe_SW.1) ,XIC(Recipe_SW.2) ,XIC(Recipe_SW.3) ,XIC(Recipe_SW.4) ][OTE(StartProgram) ,MOVE(10000,FaultTimer.PRE) TON(FaultTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Recipe_SW.1) ,XIC(Recipe_SW.3) ]OTE(PLCAck);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
