<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_Logic,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_Outputs,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Status Monitoring - Compact I/O Safety Modules]]>
</Comment>
<Text>
<![CDATA[[XIC(Local:1:I.RunMode) XIO(Local:1:I.ConnectionFaulted) OTE(SIN1OK) ,XIC(Local:2:I.RunMode) XIO(Local:2:I.ConnectionFaulted) OTE(SOUT1OK) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map Safety Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(SIN1OK)[XIC(Local:1:I.Pt00.Status) XIC(Local:1:I.Pt00.Data) XIC(Local:1:I.Pt01.Status) XIC(Local:1:I.Pt01.Data) OTE(EmergencyStopInput) ,XIC(Local:1:I.Pt02.Status) XIC(Local:1:I.Pt02.Data) XIC(Local:1:I.Pt03.Status) XIC(Local:1:I.Pt03.Data) OTE(GuardDoorInput) ,XIC(Local:1:I.Pt04.Status) XIC(Local:1:I.Pt04.Data) OTE(MachineResetPB) ,XIC(Local:1:I.Pt05.Status) XIC(Local:1:I.Pt05.Data) OTE(EmergencyStopEDM) ,XIC(Local:1:I.Pt06.Status) XIC(Local:1:I.Pt06.Data) OTE(GuardDoorEDM) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Emergency Stop Reset - Falling Edge]]>
</Comment>
<Text>
<![CDATA[XIC(MachineResetPB)OSF(MachineResetSB,MachineResetOB);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Emergency Stop - Manual Reset Required]]>
</Comment>
<Text>
<![CDATA[[XIC(MachineResetOB) XIC(EmergencyStopEDM) XIC(GuardDoorEDM) ,XIC(EmergencyStopOutput) ]XIC(EmergencyStopInput)OTE(EmergencyStopOutput);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Guard Door Debounce]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorInput)TOF(GuardDoorOffDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Guard Door - Automatic Restart

***NOTE - Risk Assessment May Determine That Manual Reset Is Required]]>
</Comment>
<Text>
<![CDATA[XIC(EmergencyStopOutput)XIC(GuardDoorOffDelay.DN)OTE(GuardDoorOutput);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Safety Status To Supervisor]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorOutput)OTE(Safe_q_Status);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(EmergencyStopOutput)XIC(EmergencyStopEDM)XIC(GuardDoorEDM)XIC(EmergencyStopInput)OTE(Safe_q_Reset);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Emergency Stop Output]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt00.Status)OTE(EmergencyStopOutputStatus);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[CROUT(EmergencyStopCROUT,NEGATIVE,200,EmergencyStopOutput,EmergencyStopEDM,EmergencyStopEDM,Local:1:I.Pt05.Status,EmergencyStopOutputStatus,MachineResetOB) ,XIC(EmergencyStopCROUT.O1) XIC(EmergencyStopCROUT.O2) OTE(Local:2:O.Pt00.Data) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Guard Door Output]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt01.Status)OTE(GuardDoorOutputStatus);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[CROUT(GuardDoorCROUT,NEGATIVE,200,GuardDoorOutput,GuardDoorEDM,GuardDoorEDM,Local:1:I.Pt06.Status,GuardDoorOutputStatus,MachineResetOB) ,XIC(GuardDoorCROUT.O1) XIC(GuardDoorCROUT.O2) OTE(Local:2:O.Pt01.Data) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Process Conveyor STO]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt02.Status)XIC(GuardDoorOutput)OTE(Local:2:O.Pt02.Data);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Incline Conveyor STO]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt03.Status)XIC(GuardDoorOutput)OTE(Local:2:O.Pt03.Data);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Incline Conveyor STO]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt04.Status)XIC(GuardDoorOutput)OTE(Local:2:O.Pt04.Data);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Air Dump Valve]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt05.Status)XIC(EmergencyStopOutput)OTE(Local:2:O.Pt05.Data);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
