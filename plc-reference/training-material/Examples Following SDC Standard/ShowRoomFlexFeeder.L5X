<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_ProductionData,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_ShiftData,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_ProductionData" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Production Data

Good Parts (Total SDC Puzzles Built)
]]>
</Comment>
<Text>
<![CDATA[XIC(\P01_Robot.q_BannerState.3)ONS(ONS.0)ADD(ProductionData.Good,1,ProductionData.Good);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Individual Parts Picked
]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(\P01_Robot.p_RobotGripperClosed)ONS(ONS.10)ADD(PartsPicked,1,PartsPicked);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Reject Parts

***NOTE - Replace MachineBasic.AlwaysOff With Reject Part Trigger***]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)ONS(ONS.1)ADD(ProductionData.Reject,1,ProductionData.Reject);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Total Parts]]>
</Comment>
<Text>
<![CDATA[ADD(ProductionData.Good,ProductionData.Reject,ProductionData.Total);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.GoodPercent,(ProductionData.Good/ProductionData.Total)*100);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.RejectPercent,(ProductionData.Reject/ProductionData.Total)*100);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)[RTO(CycleRuntime,?,?) ,XIC(CycleRuntime.DN) ADD(ProductionData.RuntimeSec,1,ProductionData.RuntimeSec) DIV(ProductionData.RuntimeSec,60,ProductionData.RuntimeMin) RES(CycleRuntime) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Fault Downtime (min)
]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)NE(\Supervisor.q_MachineStopReason,0)[RTO(CycleDowntime,?,?) ,XIC(CycleDowntime.DN) ADD(ProductionData.DowntimeSec,1,ProductionData.DowntimeSec) DIV(ProductionData.DowntimeSec,60,ProductionData.DowntimeMin) RES(CycleDowntime) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)[RTO(CycleElapsed,?,?) ,XIC(CycleElapsed.DN) ADD(ProductionData.ElapsedSec,1,ProductionData.ElapsedSec) DIV(ProductionData.ElapsedSec,60,ProductionData.ElapsedMin) RES(CycleElapsed) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[ADD(ProductionData.RuntimeMin,ProductionData.ElapsedMin,ProductionData.ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[CPT(ProductionData.GoodRate,(PartsPicked/(ProductionData.RuntimeSec/60)));]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[OEE

***NOTE - PlannedProductionTime Input Must Equal Total Shift Time (480 Minutes) - Planned Downtime (Breaks, Lunches, ect.) In Minutes***
***NOTE - IdealCycleTime Input Must Equal Cycle Time Of Machine In Seconds***]]>
</Comment>
<Text>
<![CDATA[OEE(ProductionDataOEE,480,ProductionData.RuntimeSec,ProductionData.DowntimeSec,3.0,PartsPicked,PartsPicked,ProductionData.Availability,ProductionData.Performance,ProductionData.Quality,ProductionData.OEE);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)XIC(\Supervisor.q_MachineFaultActive)ONS(ONS.2)ADD(ProductionData.TotalFaults,1,ProductionData.TotalFaults);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Reset Total Counts]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_ResetPartCounts) ,XIC(HMI_ResetAllCounts) ]TON(HoldTimerA,?,?)XIC(HoldTimerA.DN)[COP(EmptyData,ProductionData,1) ,MOVE(0,PartsPicked) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_ShiftData" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Shift Data - Uses Array Indexes 1,2,3

Calculate Shift Number]]>
</Comment>
<Text>
<![CDATA[[EQ(g_CPUDateTime.Hour,7) EQ(g_CPUDateTime.Minutes,0) ONS(ONS.3) MOVE(1,p_CurrentShift) MOVE(3,PreviousShift) ,EQ(g_CPUDateTime.Hour,15) EQ(g_CPUDateTime.Minutes,0) ONS(ONS.4) MOVE(2,p_CurrentShift) MOVE(1,PreviousShift) ,EQ(g_CPUDateTime.Hour,23) EQ(g_CPUDateTime.Minutes,0) ONS(ONS.5) MOVE(3,p_CurrentShift) MOVE(2,PreviousShift) ]OTE(ShiftChangedPulse);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQ(p_CurrentShift,0)[LIMIT(7,g_CPUDateTime.Hour,14) MOVE(1,p_CurrentShift) ,LIMIT(15,g_CPUDateTime.Hour,22) MOVE(2,p_CurrentShift) ,LIMIT(23,g_CPUDateTime.Hour,6) MOVE(3,p_CurrentShift) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(ShiftChangedPulse)[COP(EmptyData,ShiftData[p_CurrentShift],1) ,MOVE(0,ShiftPartsPicked) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Good Parts

***NOTE - Replace MachineBasic.AlwaysOff With Good Part Trigger***]]>
</Comment>
<Text>
<![CDATA[XIC(\P01_Robot.q_BannerState.3)ONS(ONS.6)ADD(ShiftData[p_CurrentShift].Good,1,ShiftData[p_CurrentShift].Good);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Individual Parts Picked
]]>
</Comment>
<Text>
<![CDATA[XIC(CycleRunning)XIC(\P01_Robot.p_RobotGripperClosed)ONS(ONS.15)ADD(ShiftPartsPicked,1,ShiftPartsPicked);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Reject Parts

***NOTE - Replace MachineBasic.AlwaysOff With Reject Part Trigger***]]>
</Comment>
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)ONS(ONS.7)ADD(ShiftData[p_CurrentShift].Reject,1,ShiftData[p_CurrentShift].Reject);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Total Parts]]>
</Comment>
<Text>
<![CDATA[ADD(ShiftData[p_CurrentShift].Good,ShiftData[p_CurrentShift].Reject,ShiftData[p_CurrentShift].Total);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Good Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[p_CurrentShift].GoodPercent,(ShiftData[p_CurrentShift].Good/ShiftData[p_CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Reject Part Efficiency]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[p_CurrentShift].RejectPercent,(ShiftData[p_CurrentShift].Reject/ShiftData[p_CurrentShift].Total)*100);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Runtime (min)]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)[RTO(ShiftRuntime,?,?) ,XIC(ShiftRuntime.DN) ADD(ShiftData[p_CurrentShift].RuntimeSec,1,ShiftData[p_CurrentShift].RuntimeSec) DIV(ShiftData[p_CurrentShift].RuntimeSec,60,ShiftData[p_CurrentShift].RuntimeMin) RES(ShiftRuntime) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Fault Downtime (min)
]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)NE(\Supervisor.q_MachineStopReason,0)[RTO(ShiftDowntime,?,?) ,XIC(ShiftDowntime.DN) ADD(ShiftData[p_CurrentShift].DowntimeSec,1,ShiftData[p_CurrentShift].DowntimeSec) DIV(ShiftData[p_CurrentShift].DowntimeSec,60,ShiftData[p_CurrentShift].DowntimeMin) RES(ShiftDowntime) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Downtime (min)]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)[RTO(ShiftElapsed,?,?) ,XIC(ShiftElapsed.DN) ADD(ShiftData[p_CurrentShift].ElapsedSec,1,ShiftData[p_CurrentShift].ElapsedSec) DIV(ShiftData[p_CurrentShift].ElapsedSec,60,ShiftData[p_CurrentShift].ElapsedMin) RES(ShiftElapsed) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Elapsed Time (min)]]>
</Comment>
<Text>
<![CDATA[ADD(ShiftData[p_CurrentShift].RuntimeMin,ShiftData[p_CurrentShift].ElapsedMin,ShiftData[p_CurrentShift].ElapsedTime);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Good Rate Per Min]]>
</Comment>
<Text>
<![CDATA[CPT(ShiftData[p_CurrentShift].GoodRate,(ShiftPartsPicked/(ShiftData[p_CurrentShift].RuntimeSec/60)));]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[OEE

***NOTE - PlannedProductionTime Input Must Equal Total Shift Time (480 Minutes) - Planned Downtime (Breaks, Lunches, ect.) In Minutes***
***NOTE - IdealCycleTime Input Must Equal Cycle Time Of Machine In Seconds***]]>
</Comment>
<Text>
<![CDATA[OEE(ShiftDataOEE,480,ShiftData[p_CurrentShift].RuntimeSec,ShiftData[p_CurrentShift].DowntimeSec,3.0,ShiftPartsPicked,ShiftPartsPicked,ShiftData[p_CurrentShift].Availability,ShiftData[p_CurrentShift].Performance,ShiftData[p_CurrentShift].Quality,ShiftData[p_CurrentShift].OEE);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Total Faults]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)XIC(\Supervisor.q_MachineFaultActive)ONS(ONS.8)ADD(ShiftData[p_CurrentShift].TotalFaults,1,ShiftData[p_CurrentShift].TotalFaults);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Reset Current Shift Count]]>
