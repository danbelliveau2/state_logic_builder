</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(FlasherB_250ms.TT) OTE(DataStructure.Flash250msPD) ,XIC(FlasherB_500ms.TT) OTE(DataStructure.Flash500msPD) ,XIC(FlasherB_1s.TT) OTE(DataStructure.Flash1sPD) ];]]>
</Text>
