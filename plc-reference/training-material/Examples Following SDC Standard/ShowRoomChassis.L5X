<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_Logic,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R05_PartOverallStatus,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R06_ResetStationPerformance,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(R07_ResetNestPerformance,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Replace AlwaysOff With Reject Unload Trigger]]>
</Comment>
<Text>
<![CDATA[XIC(\S19_PartUnload.q_IncrementReject)OTE(IncrementFailure);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Replace Source in MOVE with Nest Number At Reject Unload Station.  Station 18 Is Shown As An Example.]]>
</Comment>
<Text>
<![CDATA[MOVE(p_Data.Station[19].NestNum,FailureNestNum);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Replace AlwaysOff With Good Unload Trigger]]>
</Comment>
<Text>
<![CDATA[XIC(\S19_PartUnload.q_IncrementGood)OTE(IncrementSuccess);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Replace Source in MOVE with Nest Number At Good Unload Station.  Station 19 Is Shown As An Example.]]>
</Comment>
<Text>
<![CDATA[MOVE(p_Data.Station[19].NestNum,SuccessNestNum);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Update Nest Performance At Reject Unload Station]]>
</Comment>
<Text>
<![CDATA[XIC(IncrementFailure)ONS(ONS.0)[NestPerformance(NestPerformanceA,g_MachineBasic.AlwaysOff,IncrementFailure,p_Data.Nest[FailureNestNum].PerformData.Attempts,p_Data.Nest[FailureNestNum].PerformData.Successes,p_Data.Nest[FailureNestNum].PerformData.Failures,p_Data.Nest[FailureNestNum].PerformData.Efficiency) ,MOVE(FailureNestNum,NestNumberDeviation) JSR(R03_NestDeviationCalc,0) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Update Nest Performance At Good Unload Station]]>
</Comment>
<Text>
<![CDATA[XIC(IncrementSuccess)ONS(ONS.1)[NestPerformance(NestPerformanceB,IncrementSuccess,g_MachineBasic.AlwaysOff,p_Data.Nest[SuccessNestNum].PerformData.Attempts,p_Data.Nest[SuccessNestNum].PerformData.Successes,p_Data.Nest[SuccessNestNum].PerformData.Failures,p_Data.Nest[SuccessNestNum].PerformData.Efficiency) ,MOVE(SuccessNestNum,NestNumberDeviation) JSR(R03_NestDeviationCalc,0) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Clear All Nest Tracking]]>
</Comment>
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)XIC(HMI_Momentary.2)TON(ResetNestTrackingDelay,?,?)XIC(ResetNestTrackingDelay.DN)JSR(R04_ClearAllNestTracking,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_NestDeviationCalc" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Calculate Nest Deviation. This is a measure of how much an individual nest's efficiency deviates from the average efficiency of all the nests.]]>
</Line>
<Line Number="1">
<![CDATA[//    This shows outlier nests.]]>
</Line>
<Line Number="2">
<![CDATA[//]]>
</Line>
<Line Number="3">
<![CDATA[NestAveEfficiencyTemp := 0;]]>
</Line>
<Line Number="4">
<![CDATA[FOR StaNum := 1 TO \Chassis.p_SetupNestQty DO]]>
</Line>
<Line Number="5">
<![CDATA[	//Add up all the efficiencies of the nests ]]>
</Line>
<Line Number="6">
<![CDATA[	NestAveEfficiencyTemp := NestAveEfficiencyTemp + p_Data.Nest[StaNum].PerformData.Efficiency;]]>
</Line>
<Line Number="7">
<![CDATA[End_for;]]>
</Line>
<Line Number="8">
<![CDATA[	//divide by the number of total nests to find the total average efficiency]]>
</Line>
<Line Number="9">
<![CDATA[	NestAveEfficiency := NestAveEfficiencyTemp / \Chassis.p_SetupNestQty;]]>
</Line>
<Line Number="10">
<![CDATA[// Find the deviation from the average]]>
</Line>
<Line Number="11">
<![CDATA[IF (p_Data.Nest[NestNumberDeviation].PerformData.Efficiency <= NestAveEfficiency) THEN]]>
</Line>
<Line Number="12">
<![CDATA[	p_Data.Nest[NestNumberDeviation].PerformData.Deviation := NestAveEfficiency - p_Data.Nest[NestNumberDeviation].PerformData.Efficiency;]]>
</Line>
<Line Number="13">
<![CDATA[Else]]>
</Line>
<Line Number="14">
<![CDATA[	p_Data.Nest[NestNumberDeviation].PerformData.Deviation :=  p_Data.Nest[NestNumberDeviation].PerformData.Efficiency - NestAveEfficiency;]]>
</Line>
<Line Number="15">
<![CDATA[END_IF;]]>
</Line>
<Line Number="16">
<![CDATA[// Change the fill color of the Deviation value displayed on the HMI]]>
</Line>
<Line Number="17">
<![CDATA[IF(p_Data.Nest[NestNumberDeviation].PerformData.Deviation > g_PresetNestPerformHigh) THEN]]>
</Line>
<Line Number="18">
<![CDATA[	p_Data.Nest[NestNumberDeviation].PerformData.HMIColorStatus := 3;  //high deviation]]>
</Line>
<Line Number="19">
<![CDATA[ELSIF (p_Data.Nest[NestNumberDeviation].PerformData.Deviation < g_PresetNestPerformHigh) AND (p_Data.Nest[NestNumberDeviation].PerformData.Deviation >= g_PresetNestPerformLow)  THEN]]>
</Line>
<Line Number="20">
<![CDATA[	p_Data.Nest[NestNumberDeviation].PerformData.HMIColorStatus := 2;   //moderate deviation]]>
</Line>
<Line Number="21">
<![CDATA[Else]]>
</Line>
<Line Number="22">
<![CDATA[	p_Data.Nest[NestNumberDeviation].PerformData.HMIColorStatus := 1;   //low deviation]]>
</Line>
<Line Number="23">
<![CDATA[End_if;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R04_ClearAllNestTracking" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//]]>
</Line>
<Line Number="1">
<![CDATA[FOR StaNum := 1 TO \Chassis.p_SetupNestQty DO]]>
</Line>
<Line Number="2">
<![CDATA[	COP (ZeroPartAssyStat, p_Data.Nest[StaNum].PartStatus,1);]]>
</Line>
<Line Number="3">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R05_PartOverallStatus" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//]]>
</Line>
<Line Number="1">
<![CDATA[FOR StationNum := 0 TO  \Chassis.p_SetupNestQty BY 1 DO]]>
</Line>
<Line Number="2">
<![CDATA[	NestSuccess := 0;]]>
</Line>
<Line Number="3">
<![CDATA[	NestFailure := 0;]]>
</Line>
<Line Number="4">
<![CDATA[	NestRecycled := 0;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[	MyNestNum := p_Data.Station[StationNum].NestNum;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[	//Check Stations Before and up to the current one]]>
</Line>
<Line Number="9">
<![CDATA[	For StationNum2 := 0 to  StationNum By 1 Do]]>
</Line>
<Line Number="10">
<![CDATA[		IF p_Data.Nest[MyNestNum].PartStatus.PartLoaded THEN]]>
</Line>
<Line Number="11">
<![CDATA[			IF (p_Data.Nest[MyNestNum].PartStatus.Station[StationNum2].Recycle AND NOT p_Data.Nest[MyNestNum].PartStatus.Station[StationNum2].Lockout) THEN]]>
</Line>
<Line Number="12">
<![CDATA[				NestFailure := 0;]]>
</Line>
<Line Number="13">
<![CDATA[				NestSuccess := 0;]]>
</Line>
<Line Number="14">
<![CDATA[				NestRecycled := 1;]]>
</Line>
<Line Number="15">
<![CDATA[				Exit; //Exits the inside (station) for loop]]>
</Line>
<Line Number="16">
<![CDATA[			ELSIF (p_Data.Nest[MyNestNum].PartStatus.Station[StationNum2].Failure AND NOT p_Data.Nest[MyNestNum].PartStatus.Station[StationNum2].Lockout) THEN]]>
</Line>
<Line Number="17">
<![CDATA[				NestFailure := 1;]]>
</Line>
<Line Number="18">
<![CDATA[				NestSuccess := 0;]]>
</Line>
<Line Number="19">
<![CDATA[				NestRecycled := 0;]]>
</Line>
<Line Number="20">
<![CDATA[				EXIT; //Exits the inside (station) for loop]]>
</Line>
<Line Number="21">
<![CDATA[			ELSIF (p_Data.Nest[MyNestNum].PartStatus.Station[StationNum2].Success OR p_Data.Nest[MyNestNum].PartStatus.Station[StationNum2].Lockout) THEN]]>
</Line>
<Line Number="22">
<![CDATA[				NestFailure := 0;]]>
</Line>
<Line Number="23">
<![CDATA[				NestSuccess := 1;]]>
</Line>
<Line Number="24">
<![CDATA[				NestRecycled := 0;	]]>
</Line>
<Line Number="25">
<![CDATA[			End_if;]]>
</Line>
<Line Number="26">
<![CDATA[		End_if;]]>
</Line>
<Line Number="27">
<![CDATA[	End_for;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[	]]>
</Line>
<Line Number="30">
<![CDATA[	If (NestRecycled) Then]]>
</Line>
<Line Number="31">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Bad := 0;]]>
</Line>
<Line Number="32">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Good := 0;]]>
</Line>
<Line Number="33">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Recycled := 1;	]]>
</Line>
<Line Number="34">
<![CDATA[	ELSIf (NestSuccess) Then]]>
</Line>
<Line Number="35">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Bad := 0;]]>
</Line>
<Line Number="36">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Good := 1;]]>
</Line>
<Line Number="37">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Recycled := 0;]]>
</Line>
<Line Number="38">
<![CDATA[	ELSIf (NestFailure) Then]]>
</Line>
<Line Number="39">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Bad := 1;]]>
</Line>
<Line Number="40">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Good := 0;]]>
</Line>
<Line Number="41">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Recycled := 0;]]>
</Line>
<Line Number="42">
<![CDATA[	Else]]>
</Line>
<Line Number="43">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Bad := 0;]]>
</Line>
<Line Number="44">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Good := 0;]]>
</Line>
<Line Number="45">
<![CDATA[		p_Data.Nest[MyNestNum].PartStatus.Recycled := 0;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[	End_if;]]>
</Line>
<Line Number="48">
<![CDATA[End_for;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="R06_ResetStationPerformance" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Initialize Values]]>
</Line>
<Line Number="1">
<![CDATA[TimeStep:=100;]]>
</Line>
<Line Number="2">
<![CDATA[ResetThreshold:=2000;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[TimerC.Reset := 0;]]>
</Line>
<Line Number="5">
<![CDATA[TimerC.PRE := 100;]]>
</Line>
<Line Number="6">
<![CDATA[TimerC.TimerEnable := 1;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[TimerD.Reset := 0;]]>
</Line>
<Line Number="9">
<![CDATA[TimerD.PRE := 2000;]]>
</Line>
<Line Number="10">
<![CDATA[TimerD.TimerEnable := HMI_Momentary.1 OR \Production.p_HMI_ResetAllCounts;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[// Start the global timer for timing step (100ms in this case)]]>
</Line>
<Line Number="13">
<![CDATA[TONR(TimerC);]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[// Start the global timer for reset all station performance]]>
</Line>
<Line Number="16">
<![CDATA[TONR(TimerD);]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[IF TimerC.DN THEN]]>
</Line>
<Line Number="19">
<![CDATA[    // Once the timer elapses, reset and process the inputs]]>
</Line>
<Line Number="20">
<![CDATA[    TimerC.Reset := 1; // Restart timer in next scan]]>
</Line>
<Line Number="21">
<![CDATA[    TimerC.TimerEnable := 0;]]>
</Line>
<Line Number="22">
<![CDATA[    FOR StationReset := 1 TO \Chassis.p_SetupNestQty DO]]>
</Line>
<Line Number="23">
<![CDATA[        IF p_Data.Station[StationReset].PerformData.HMI_Reset THEN]]>
</Line>
<Line Number="24">
<![CDATA[            // Increase timer for this input]]>
</Line>
<Line Number="25">
<![CDATA[            ResetTimersB[StationReset] := ResetTimersB[StationReset] + TimeStep;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[            IF ResetTimersB[StationReset] >= ResetThreshold THEN]]>
</Line>
<Line Number="28">
<![CDATA[                // Reset action]]>
</Line>
<Line Number="29">
<![CDATA[                p_Data.Station[StationReset].PerformData.Attempts:=0;]]>
</Line>
<Line Number="30">
<![CDATA[				p_Data.Station[StationReset].PerformData.Efficiency:=0;]]>
</Line>
<Line Number="31">
<![CDATA[				p_Data.Station[StationReset].PerformData.Failures:=0;]]>
</Line>
<Line Number="32">
<![CDATA[				p_Data.Station[StationReset].PerformData.FaultCount:=0;]]>
</Line>
<Line Number="33">
<![CDATA[				p_Data.Station[StationReset].PerformData.HMIColorStatus:=0;]]>
</Line>
<Line Number="34">
<![CDATA[				p_Data.Station[StationReset].PerformData.Successes:=0;]]>
</Line>
<Line Number="35">
<![CDATA[                // Optional: Reset timer after action]]>
</Line>
<Line Number="36">
<![CDATA[                ResetTimersB[StationReset] := 0;]]>
</Line>
<Line Number="37">
<![CDATA[            END_IF;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[        ELSE]]>
</Line>
<Line Number="40">
<![CDATA[            // Reset timer if input is off]]>
</Line>
<Line Number="41">
<![CDATA[            ResetTimersB[StationReset] := 0;]]>
</Line>
<Line Number="42">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="43">
<![CDATA[    END_FOR;]]>
</Line>
<Line Number="44">
<![CDATA[END_IF;]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[IF TimerD.DN THEN]]>
</Line>
<Line Number="47">
<![CDATA[	FOR StationReset := 1 TO \Chassis.p_SetupNestQty DO]]>
</Line>
<Line Number="48">
<![CDATA[                p_Data.Station[StationReset].PerformData.Attempts:=0;]]>
</Line>
<Line Number="49">
<![CDATA[				p_Data.Station[StationReset].PerformData.Efficiency:=0;]]>
</Line>
<Line Number="50">
<![CDATA[				p_Data.Station[StationReset].PerformData.Failures:=0;]]>
</Line>
<Line Number="51">
<![CDATA[				p_Data.Station[StationReset].PerformData.FaultCount:=0;]]>
</Line>
<Line Number="52">
<![CDATA[				p_Data.Station[StationReset].PerformData.HMIColorStatus:=0;]]>
</Line>
<Line Number="53">
<![CDATA[				p_Data.Station[StationReset].PerformData.Successes:=0;]]>
</Line>
<Line Number="54">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="55">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R07_ResetNestPerformance" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Initialize Values]]>
</Line>
<Line Number="1">
<![CDATA[TimeStep:=100;]]>
</Line>
<Line Number="2">
<![CDATA[ResetThreshold:=2000;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[TimerA.Reset := 0;]]>
</Line>
<Line Number="5">
<![CDATA[TimerA.PRE := 100;]]>
</Line>
<Line Number="6">
<![CDATA[TimerA.TimerEnable := 1;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[TimerB.Reset := 0;]]>
</Line>
<Line Number="9">
<![CDATA[TimerB.PRE := 2000;]]>
</Line>
<Line Number="10">
<![CDATA[TimerB.TimerEnable := HMI_Momentary.0 OR \Production.p_HMI_ResetAllCounts;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[// Start the global timer for timing step (100ms in this case)]]>
</Line>
<Line Number="13">
<![CDATA[TONR(TimerA);]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[// Start the global timer for reset all nest performance]]>
</Line>
<Line Number="16">
<![CDATA[TONR(TimerB);]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[IF TimerA.DN THEN]]>
</Line>
<Line Number="19">
<![CDATA[    // Once the timer elapses, reset and process the inputs]]>
</Line>
<Line Number="20">
<![CDATA[    TimerA.Reset := 1; // Restart timer in next scan]]>
</Line>
<Line Number="21">
<![CDATA[    TimerA.TimerEnable := 0;]]>
</Line>
<Line Number="22">
<![CDATA[    FOR NestReset := 1 TO \Chassis.p_SetupNestQty DO]]>
</Line>
<Line Number="23">
<![CDATA[        IF p_Data.Nest[NestReset].PerformData.HMI_Reset THEN]]>
</Line>
<Line Number="24">
<![CDATA[            // Increase timer for this input]]>
</Line>
<Line Number="25">
<![CDATA[            ResetTimersA[NestReset] := ResetTimersA[NestReset] + TimeStep;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[            IF ResetTimersA[NestReset] >= ResetThreshold THEN]]>
</Line>
<Line Number="28">
<![CDATA[                // Reset action]]>
</Line>
<Line Number="29">
<![CDATA[                p_Data.Nest[NestReset].PerformData.Attempts:=0;]]>
</Line>
<Line Number="30">
<![CDATA[				p_Data.Nest[NestReset].PerformData.Efficiency:=0;]]>
</Line>
<Line Number="31">
<![CDATA[				p_Data.Nest[NestReset].PerformData.Failures:=0;]]>
</Line>
<Line Number="32">
<![CDATA[				p_Data.Nest[NestReset].PerformData.FaultCount:=0;]]>
</Line>
<Line Number="33">
<![CDATA[				p_Data.Nest[NestReset].PerformData.HMIColorStatus:=0;]]>
</Line>
<Line Number="34">
<![CDATA[				p_Data.Nest[NestReset].PerformData.Successes:=0;]]>
</Line>
<Line Number="35">
<![CDATA[                // Optional: Reset timer after action]]>
</Line>
<Line Number="36">
<![CDATA[                ResetTimersA[NestReset] := 0;]]>
</Line>
<Line Number="37">
<![CDATA[            END_IF;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[        ELSE]]>
</Line>
<Line Number="40">
<![CDATA[            // Reset timer if input is off]]>
</Line>
<Line Number="41">
<![CDATA[            ResetTimersA[NestReset] := 0;]]>
</Line>
<Line Number="42">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="43">
<![CDATA[    END_FOR;]]>
</Line>
<Line Number="44">
<![CDATA[END_IF;]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[IF TimerB.DN THEN]]>
</Line>
<Line Number="47">
<![CDATA[	FOR NestReset := 1 TO \Chassis.p_SetupNestQty DO]]>
</Line>
<Line Number="48">
<![CDATA[                p_Data.Nest[NestReset].PerformData.Attempts:=0;]]>
</Line>
<Line Number="49">
<![CDATA[				p_Data.Nest[NestReset].PerformData.Efficiency:=0;]]>
</Line>
<Line Number="50">
<![CDATA[				p_Data.Nest[NestReset].PerformData.Failures:=0;]]>
</Line>
<Line Number="51">
<![CDATA[				p_Data.Nest[NestReset].PerformData.FaultCount:=0;]]>
</Line>
<Line Number="52">
<![CDATA[				p_Data.Nest[NestReset].PerformData.HMIColorStatus:=0;]]>
</Line>
<Line Number="53">
<![CDATA[				p_Data.Nest[NestReset].PerformData.Successes:=0;]]>
</Line>
<Line Number="54">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="55">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
