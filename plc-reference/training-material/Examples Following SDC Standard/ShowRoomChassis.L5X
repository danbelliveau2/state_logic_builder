<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Logic,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_NestIndicators,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_CleanoutMode,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Screen Change]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[NE(p_CurrentScreenNum,p_PreviousScreenNum)[MOVE(p_CurrentScreenNum,p_PreviousScreenNum) ,OTE(q_ScreenChangedOneShot) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Main screen handshaking]]>
</Comment>
<Text>
<![CDATA[EQ(p_ReplaceScreenNum,p_CurrentScreenNum)MOVE(0,p_ReplaceScreenNum);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[popup handshaking]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[NE(p_ReplaceScreenNum,0)ONS(ONS.0)EQ(p_ReplaceScreenNum,p_CurrentPopupNum)OTE(PopupHidden);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Popup request to open but there's already one open.
Save the screen number and open it when the current popup closes.]]>
</Comment>
<Text>
<![CDATA[NE(p_ReplaceScreenNum,0)ONS(ONS.1)LIMIT(80,p_ReplaceScreenNum,90)NE(p_ReplaceScreenNum,p_CurrentPopupNum)NE(p_CurrentPopupNum,0)[MOVE(p_ReplaceScreenNum,QueuedPopupNum) ,MOVE(0,p_ReplaceScreenNum) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQ(p_ReplaceScreenNum,p_CurrentPopupNum)MOVE(0,p_ReplaceScreenNum);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Current popup isn't being shown if the screen changes.
 (assuming only 1 HMI screen)
So force the popup back up by
closing it and resending it.]]>
</Comment>
<Text>
<![CDATA[[[XIC(q_ScreenChangedOneShot) ,XIC(PopupHidden) ] NE(p_CurrentPopupNum,0) [MOVE(p_CurrentPopupNum,SavedPopupNum) ,MOVE(9999,p_ReplaceScreenNum) ] ,XIC(ResendCurrentPopup.TT) XIO(ResendCurrentPopup.DN) ]TON(ResendCurrentPopup,?,?)XIC(ResendCurrentPopup.DN)MOVE(SavedPopupNum,p_ReplaceScreenNum);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[GT(QueuedPopupNum,0)EQ(p_CurrentPopupNum,0)[MOVE(QueuedPopupNum,p_ReplaceScreenNum) ,MOVE(0,QueuedPopupNum) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Prevent replace screen num from getting stuck.]]>
</Comment>
<Text>
<![CDATA[[EQ(p_ReplaceScreenNum,9999) ,EQ(p_ReplaceScreenNum,8888) ]TON(ResetReplaceScreen,?,?)XIC(ResetReplaceScreen.DN)MOVE(0,p_ReplaceScreenNum);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_NestIndicators" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//This is used to display the status color for all the nests displayed on the HMI main screen display.]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[//Loop through each station and set status bits for the MAIN hmi display]]>
</Line>
<Line Number="3">
<![CDATA[NestNum := 1;]]>
</Line>
<Line Number="4">
<![CDATA[FOR NestNum := 1 TO \Chassis.p_SetupNestQty BY 1 DO]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[	//Highest priority is LockedOut, Sample, Recycle, Bad, Good]]>
</Line>
<Line Number="7">
<![CDATA[	MyNestStatus := 0;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[	IF (\Tracking.p_Data.Nest[NestNum].OpStatus.Lockout) THEN]]>
</Line>
<Line Number="11">
<![CDATA[		MyNestStatus := 1;]]>
</Line>
<Line Number="12">
<![CDATA[	ELSIF (\Tracking.p_Data.Nest[NestNum].PartStatus.Sample) THEN]]>
</Line>
<Line Number="13">
<![CDATA[		MyNestStatus := 6;]]>
</Line>
<Line Number="14">
<![CDATA[	ELSIF (\Tracking.p_Data.Nest[NestNum].PartStatus.Recycled) THEN]]>
</Line>
<Line Number="15">
<![CDATA[		MyNestStatus := 2;]]>
</Line>
<Line Number="16">
<![CDATA[	ELSIF (\Tracking.p_Data.Nest[NestNum].PartStatus.Bad) THEN]]>
</Line>
<Line Number="17">
<![CDATA[		MyNestStatus := 3;]]>
</Line>
<Line Number="18">
<![CDATA[	ELSIF (\Tracking.p_Data.Nest[NestNum].PartStatus.Good) THEN]]>
</Line>
<Line Number="19">
<![CDATA[		MyNestStatus := 4;]]>
</Line>
<Line Number="20">
<![CDATA[	ELSE]]>
</Line>
<Line Number="21">
<![CDATA[		MyNestStatus := 5;  // Nest Is Empty (Greyed Out)]]>
</Line>
<Line Number="22">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[	HMI_NestIndicator[NestNum] := MyNestStatus;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[End_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="R03_CleanoutMode" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Cleanout Mode Control]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)XIC(HMI_Momentary.0)OTL(q_CleanoutModeEnabled);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)XIC(q_CleanoutModeEnabled)XIO(\Tracking.p_Data.Nest[1].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[2].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[3].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[4].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[5].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[6].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[7].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[8].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[9].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[10].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[11].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[12].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[13].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[14].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[15].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[16].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[17].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[18].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[19].PartStatus.PartLoaded)XIO(\Tracking.p_Data.Nest[20].PartStatus.PartLoaded)ONS(ONS.2)OTL(q_CleanoutModeStopTrig);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_MachineRunning)[[XIC(q_CleanoutModeEnabled) TON(CleanoutModeStopDelay,?,?) XIC(CleanoutModeStopDelay.DN) ,XIC(q_CleanoutModeStopTrig) ] OTU(q_CleanoutModeEnabled) ,OTU(q_CleanoutModeStopTrig) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
