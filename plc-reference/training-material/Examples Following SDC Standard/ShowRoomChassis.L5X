<Text>
<![CDATA[[XIC(g_MachineBasic.PowerUpCP) EQ(EIPStatusCount,0) AOI_EIPStatus(p_sd01_CamEIP,sd01_Cam) XIO(p_sd01_CamEIP.ComOK) ,XIC(Alarm[0].Active) XIO(q_FaultReset) ]OTE(Alarm[0].Active);]]>
