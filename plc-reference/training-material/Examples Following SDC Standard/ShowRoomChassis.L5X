<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_Logic,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R20_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Sensor Debounce]]>
</Comment>
<Text>
<![CDATA[AOI_Debounce(ProbeADebounce,i_ProbeA,10,10);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Logic inputs

*Replace always off bits with real conditions]]>
</Comment>
<Text>
<![CDATA[XIC(\Supervisor.q_ManualMode)XIO(HMI_LocalManualOverride)OTE(ManualMode);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_SafetyOK)OTE(SafetyOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_FaultReset)OTE(FaultReset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_MachineRunning)OTE(CycleRunning);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(\Supervisor.q_CycleStartLatch)OTE(CycleStopping);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(\Supervisor.q_CycleStopped)ONS(ONS.0)XIC(g_MachineBasic.AlwaysOff)OTE(CycleStopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(g_MachineBasic.AlwaysOff)OTE(Initialized);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Load Station Numbers]]>
</Comment>
<Text>
<![CDATA[MOVE(3,StaNum)MOVE(2,StaNumPre);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Load Nest Numbers]]>
</Comment>
<Text>
<![CDATA[MOVE(\Tracking.p_Data.Station[StaNum].NestNum,NestNumCurrent)MOVE(\Tracking.p_Data.Station[StaNumPre].NestNum,NestNumIncoming);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Conditions For The Station To Cycle]]>
</Comment>
<Text>
<![CDATA[[XIC(SafetyOK) XIC(CycleRunning) XIO(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout) XIO(\Tracking.p_Data.Nest[NestNumCurrent].OpStatus.Lockout) ,XIC(HMI_AlwaysCycleStation) ]OTE(CycleStation);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(SafetyOK)XIC(CycleRunning)XIC(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.PartLoaded)XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Lockout);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Check Probe Process]]>
</Comment>
<Text>
<![CDATA[XIO(ManualMode)Chassis_CamPos_Check(CamPosCheckA,g_ProbeProcessAngleS03,\Chassis.ChassisStatus.CamPosDeg,0,\Chassis.ChassisStatus.ActualVelocity)XIC(CycleStation)[OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt) ,[XIC(ProbeADebounce.On) ,XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Bypass) ] [OTL(q_GreenLightON) ,OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,MOVE(0,ConsecFails.Count) ] ,XIO(\Tracking.p_Data.Station[StaNum].OpStatus.Bypass) XIO(ProbeADebounce.On) [OTL(q_RedLightON) ,OTU(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success) ,OTL(\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Failure) ,ADD(ConsecFails.Count,1,ConsecFails.Count) ,MOVE(21,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.FailureType) ,MOVE(FailureMessages[0],\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.FailureMessage) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Check Probe Off When Station Retracted]]>
</Comment>
<Text>
<![CDATA[XIO(ManualMode)Chassis_CamPos_Check(CamPosCheckB,g_ProbeOffAngleS03,\Chassis.ChassisStatus.CamPosDeg,0,\Chassis.ChassisStatus.ActualVelocity)[XIO(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout) XIO(ProbeADebounce.Off) OTL(ProbeNotOff) ,[XIC(ProbeADebounce.Off) ,XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout) ] OTU(ProbeNotOff) ,OTU(q_GreenLightON) OTU(q_RedLightON) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Station Performance]]>
</Comment>
<Text>
<![CDATA[StationPerformance(StationPerformance,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Attempt,\Tracking.p_Data.Nest[NestNumCurrent].PartStatus.Station[StaNum].Success,g_PresetStationPerformLow,g_PresetStationPerformHigh,\Tracking.p_Data.Station[StaNum].PerformData.Attempts,\Tracking.p_Data.Station[StaNum].PerformData.Successes,\Tracking.p_Data.Station[StaNum].PerformData.Failures,\Tracking.p_Data.Station[StaNum].PerformData.Efficiency,\Tracking.p_Data.Station[StaNum].PerformData.HMIColorStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R20_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Consecutive Failures]]>
</Comment>
<Text>
<![CDATA[XIC(Alarm[0].Active)XIC(FaultReset)ONS(ResetFailCount)MOVE(0,ConsecFails.Count);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(CycleRunning) XIO(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout) GE(ConsecFails.Count,ConsecFails.Setpoint) ,XIC(Alarm[0].Active) XIO(FaultReset) ]OTE(Alarm[0].Active);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Probe Not Off]]>
</Comment>
<Text>
<![CDATA[[XIC(CycleRunning) XIC(ProbeNotOff) ,XIC(Alarm[1].Active) XIO(FaultReset) ]OTE(Alarm[1].Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Alarm[1].Active)OTU(ProbeNotOff);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Station Bypassed]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Bypass)[OTE(Alarm[2].Active) ,MOVE(1,Alarm[2].Severity) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Station Locked Out]]>
</Comment>
<Text>
<![CDATA[XIC(\Tracking.p_Data.Station[StaNum].OpStatus.Lockout)[OTE(Alarm[3].Active) ,MOVE(1,Alarm[3].Severity) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[ProgramAlarmHandler(AOI_ProgramAlarmHandler,\Alarms.p_ProgramID,Alarm,\Alarms.p_Active,\Alarms.p_History,g_CPUDateTime,q_AlarmActive,q_WarningActive);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Station Fault Count]]>
</Comment>
<Text>
<![CDATA[XIC(q_AlarmActive)ONS(ONS.2)ADD(\Tracking.p_Data.Station[StaNum].PerformData.FaultCount,1,\Tracking.p_Data.Station[StaNum].PerformData.FaultCount);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
