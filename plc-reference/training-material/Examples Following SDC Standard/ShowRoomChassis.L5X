<Routines>
<Routine Name="R00_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Subroutine Calls]]>
</Comment>
<Text>
<![CDATA[JSR(R01_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(R02_Logic,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(R03_Outputs,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R01_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Status Monitoring - Kinetix 5500 Drive Using CIP Safety]]>
</Comment>
<Text>
<![CDATA[XIC(sd01_Cam:SI.RunMode)XIO(sd01_Cam:SI.ConnectionFaulted)XIO(sd01_Cam:SI.SafetyFault)OTE(CamAxisOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(sd02_Dial:SI.RunMode)XIO(sd02_Dial:SI.ConnectionFaulted)XIO(sd02_Dial:SI.SafetyFault)OTE(DialAxisOK);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Status Monitoring - Compact Safety I/O]]>
</Comment>
<Text>
<![CDATA[[XIC(Local:1:I.RunMode) XIO(Local:1:I.ConnectionFaulted) OTE(SIN1OK) ,XIC(Local:2:I.RunMode) XIO(Local:2:I.ConnectionFaulted) OTE(SOUT1OK) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Map Safety Inputs]]>
</Comment>
<Text>
<![CDATA[XIC(SIN1OK)[XIC(Local:1:I.Pt00.Status) XIC(Local:1:I.Pt00.Data) XIC(Local:1:I.Pt01.Status) XIC(Local:1:I.Pt01.Data) OTE(EmergencyStopInput) ,XIC(Local:1:I.Pt02.Status) XIC(Local:1:I.Pt02.Data) XIC(Local:1:I.Pt03.Status) XIC(Local:1:I.Pt03.Data) OTE(GuardDoorInput) ,XIC(Local:1:I.Pt04.Status) XIC(Local:1:I.Pt04.Data) OTE(MachineResetPB) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R02_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Emergency Stop Reset - Falling Edge]]>
</Comment>
<Text>
<![CDATA[XIC(MachineResetPB)OSF(MachineResetSB,MachineResetOB);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Emergency Stop - Manual Reset Required]]>
</Comment>
<Text>
<![CDATA[[XIC(MachineResetOB) ,XIC(EmergencyStopOutput) ]XIC(EmergencyStopInput)OTE(EmergencyStopOutput);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Guard Door Debounce]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorInput)TOF(GuardDoorOffDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Guard Door - Automatic Restart

***NOTE - Risk Assessment May Determine That Manual Reset Is Required]]>
</Comment>
<Text>
<![CDATA[XIC(EmergencyStopOutput)XIC(GuardDoorOffDelay.DN)OTE(GuardDoorOutput);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Safety Status To Supervisor]]>
</Comment>
<Text>
<![CDATA[XIC(GuardDoorOutput)OTE(Safe_q_Status);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(EmergencyStopOutput)XIC(EmergencyStopInput)OTE(Safe_q_Reset);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R03_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Safety Output - Kinetix 5500 Drive Using CIP Safety]]>
</Comment>
<Text>
<![CDATA[XIC(sd01_Cam:SO.SafeTorqueOff)XIC(sd01_Cam:SI.TorqueDisabled)XIC(sd01_Cam:SI.ResetRequired)OTE(sd01_Cam:SO.Reset);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(CamAxisOK)XIC(GuardDoorOutput)OTE(sd01_Cam:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(sd02_Dial:SO.SafeTorqueOff)XIC(sd02_Dial:SI.TorqueDisabled)XIC(sd02_Dial:SI.ResetRequired)OTE(sd02_Dial:SO.Reset);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(DialAxisOK)XIC(GuardDoorOutput)OTE(sd02_Dial:SO.SafeTorqueOff);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Air Dump Valve]]>
</Comment>
<Text>
<![CDATA[XIC(SOUT1OK)XIC(Local:2:I.Pt00.Status)XIC(EmergencyStopOutput)OTE(Local:2:O.Pt00.Data);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
